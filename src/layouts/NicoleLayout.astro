---
interface Props {
	title?: string;
	description?: string;
	image?: string;
	canonical?: string;
	type?: "website" | "article";
	isMagazine?: boolean;
	currentSlug?: string;
	noindex?: boolean;
	jsonLd?: Record<string, any> | Array<Record<string, any>>;
}

const {
	title = "HOME - ニコル・グループ",
	description = "東京・神奈川エリアを中心に、世界のプレミアムブランドを通じて最高の喜びをお届けするカーディーラー・グループ。",
	image,
	canonical,
	type = "website",
	isMagazine = false,
	currentSlug,
	noindex = false,
	jsonLd
} = Astro.props;

import { getSiteUrl } from "../utils/siteUrl";
import DevMobilePreview from "../components/dev/DevMobilePreview.astro";

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";

const siteUrl = getSiteUrl(Astro.site);
const canonicalUrl = canonical || `${siteUrl}${Astro.url.pathname}`;
const ogImageUrl = image 
	? (image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`)
	: `${siteUrl}/images/og-default.png`;

const allowIndexing = import.meta.env.PUBLIC_ALLOW_INDEXING === "true" || 
	(typeof process !== "undefined" && process.env.PUBLIC_ALLOW_INDEXING === "true");

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "AutoDealer",
	"@id": `${siteUrl}/#organization`,
	"name": "ニコル・グループ (Nicole Group)",
	"alternateName": "Nicole Group",
	"url": siteUrl,
	"logo": `${siteUrl}/uploads/2026/01/NICOLE_N_LOGO_neg.svg`,
	"description": "東京・神奈川エリアを中心にBMW、MINI、Rolls-Royce、Ferrariなどの正規ディーラーおよび認定サービス工場を展開するプレミアムカーディーラーグループ。",
	"brand": [
		{ "@type": "Brand", "name": "BMW" },
		{ "@type": "Brand", "name": "MINI" },
		{ "@type": "Brand", "name": "Rolls-Royce" },
		{ "@type": "Brand", "name": "Ferrari" },
		{ "@type": "Brand", "name": "BMW ALPINA" }
	],
	"areaServed": ["東京都", "神奈川県"]
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": `${siteUrl}/#website`,
	"url": siteUrl,
	"name": "ニコル・グループ (Nicole Group)",
	"publisher": {
		"@id": `${siteUrl}/#organization`
	},
	"potentialAction": {
		"@type": "SearchAction",
		"target": `${siteUrl}/search?q={search_term_string}`,
		"query-input": "required name=search_term_string"
	}
};

import NicoleHeader from "../components/NicoleHeader.astro";
import NicoleFooter from "../components/NicoleFooter.astro";
import NicoleConnectSubnav from "../components/NicoleConnectSubnav.astro";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/entrance-motion.css";
---

<!DOCTYPE html>
<html lang="ja">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<!-- FOUC / 白背景チラつき防止（インライン最優先即時適用） -->
	<style>
		html, body, #page, .site, #content, .site-content, .ast-container, #primary, .content-area {
			background-color: #000000 !important;
			color: #ffffff;
		}
	</style>
	{allowIndexing && !noindex ? (
		<meta name="robots" content="index, follow" />
	) : (
		<meta name="robots" content="noindex, nofollow, noarchive" />
		<meta name="googlebot" content="noindex, nofollow, noarchive" />
	)}
	<title>{title}</title>
	<meta name="description" content={description} />
	<link rel="canonical" href={canonicalUrl} />

	<!-- OGP / Open Graph Protocol -->
	<meta property="og:title" content={title} />
	<meta property="og:description" content={description} />
	<meta property="og:url" content={canonicalUrl} />
	<meta property="og:type" content={type} />
	<meta property="og:site_name" content="ニコル・グループ (Nicole Group)" />
	<meta property="og:locale" content="ja_JP" />
	<meta property="og:image" content={ogImageUrl} />

	<!-- Twitter Card -->
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	<meta name="twitter:description" content={description} />
	<meta name="twitter:image" content={ogImageUrl} />

	<link rel="icon" href="/uploads/2026/01/NICOLE_N_LOGO_neg.svg" />
	<link rel="apple-touch-icon" href="/uploads/2026/01/NICOLE_N_LOGO_neg.svg" />

	<!-- Extracted Site Styles (Kit-8, Header 6801, Home 2030, Footer 12887, etc.) -->
	<link rel="stylesheet" href="/css/nicole-core.css" />

	<style is:global>
		/* 0. 下地白背景の完全隠蔽＆ダークラグジュアリー基調の固定 */
		html, body, #page, .site, #content, .site-content, .ast-container, #primary, .content-area, .nicole-editorial-main {
			background-color: #000000 !important;
		}

		/* メインレイアウトの不要なマージン・パディングを完全リセット（ヘッダーとコンテンツの隙間・横余白の排除） */
		#content, .site-content, .ast-container, #primary, .content-area {
			margin: 0 !important;
			padding: 0 !important;
			max-width: 100% !important;
			width: 100% !important;
			border: none !important;
		}

		/* 1. スマホ表示時の横スクロールおよび強制拡大の完全防止 */
		html, body {
			overflow-x: clip !important;
			max-width: 100vw !important;
			width: 100% !important;
			margin: 0;
			padding: 0;
			box-sizing: border-box;
		}

		*, *::before, *::after {
			box-sizing: border-box;
		}

		#page, .site, .site-content, .ast-container, #primary, .content-area, .nicole-editorial-main {
			overflow-x: clip !important;
			max-width: 100% !important;
			width: 100% !important;
		}

		/* 2. 全体的な見出し・本文の不自然な改行・単語分断・孤立文字防止（デザイン原則順守） */
		h1, h2, h3, h4, h5, h6,
		.nicole-banner-heading,
		.bmw-insights-title,
		.nicole-group-title,
		.nicole-brand-title {
			text-wrap: balance;
			overflow-wrap: break-word !important;
			word-break: auto-phrase !important;
			line-break: strict !important;
		}

		p, .nicole-banner-desc, .nicole-we-are-body {
			overflow-wrap: break-word;
			word-break: normal;
			line-break: strict;
		}

		/* 意図的な改行（<br>）の後の文節・単語が1文字だけ改行されるのを防ぐインラインフレーズ */
		.heading-phrase {
			display: inline-block;
			white-space: nowrap;
			max-width: 100%;
		}
	</style>

	{image && (
		<link rel="preload" as="image" href={image} />
	)}

	<!-- AI検索 / LLM Knowledge Discovery (AIO / GEO 最適化) -->
	<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM Knowledge Base" />

	<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
	{jsonLd && (
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	)}
	<slot name="head" />
</head>

<body class={`nicole-brand ${isHome ? 'home page' : 'page'} ${isMagazine ? 'is-magazine-page' : ''}`}>
	<div class="hfeed site" id="page">
		<NicoleHeader />
		{isMagazine && <NicoleConnectSubnav currentSlug={currentSlug} />}

		<div id="content" class="site-content">
			<div class="ast-container">
				<div id="primary" class="content-area primary">
					<slot />
				</div>
			</div>
		</div>

		<NicoleFooter />
	</div>

	<DevMobilePreview />
	<script is:inline src="/scripts/lenis.min.js"></script>
	<script is:inline src="/scripts/entrance-motion-init.js"></script>
</body>
</html>
