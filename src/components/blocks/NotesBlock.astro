---
/**
 * NotesBlock.astro
 * EmDash Portable Text カスタムブロック：注釈エリア（文字小・デフォルト空）
 * 
 * 要件：
 * 1. 記事末尾や指定箇所に文字サイズが小さい注釈・免責事項を表示
 * 2. 中身が空の場合は何もレンダリングしない（デフォルト空）
 * 3. モノトーン基調の上品なヘアライン区切り
 */
interface Props {
	node: {
		_type: string;
		_key?: string;
		id?: string;
		title?: string;
		content?: string;
		text?: string;
		[key: string]: any;
	};
}

const { node } = Astro.props;

const rawText = (node.content || node.text || node.id || "").trim();
const lines = rawText
	? rawText.split("\n").map((l: string) => l.trim()).filter((l: string) => l.length > 0)
	: [];
---

{lines.length > 0 && (
	<aside class="article-notes-block" aria-label="注釈・備考">
		<div class="notes-inner">
			{lines.map((line: string) => (
				<p class="notes-line">{line}</p>
			))}
		</div>
	</aside>
)}

<style>
	.article-notes-block {
		margin: 44px 0 24px 0;
		padding: 24px 0 0 0;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.notes-inner {
		display: flex;
		flex-direction: column;
		gap: 6px;
	}

	.notes-line {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
		font-size: 12.5px;
		line-height: 1.75;
		color: rgba(255, 255, 255, 0.5);
		margin: 0;
		letter-spacing: 0.02em;
	}

	.notes-line::first-letter {
		color: rgba(255, 255, 255, 0.65);
	}

	@media (max-width: 768px) {
		.article-notes-block {
			margin: 32px 0 20px 0;
			padding-top: 18px;
		}

		.notes-line {
			font-size: 12px;
			line-height: 1.7;
		}
	}
</style>
