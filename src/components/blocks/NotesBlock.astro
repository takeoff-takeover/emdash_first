---
/**
 * NotesBlock.astro
 * EmDash Portable Text カスタムブロック：注釈エリア（文字小・デフォルト空）
 * 
 * 要件：
 * 1. 記事末尾や指定箇所に文字サイズが小さい注釈・免責事項を表示
 * 2. 中身が空の場合は何もレンダリングしない（デフォルト空）
 * 3. モノトーン基調の上品なヘアライン区切り
 */
interface Props {
	node: {
		_type: string;
		_key?: string;
		id?: string;
		title?: string;
		content?: string;
		text?: string;
		[key: string]: any;
	};
}

const { node } = Astro.props;

// 注釈エリアの初期設定値（標準免責文）
const DEFAULT_DISCLAIMER_LINES = [
	"※このページで使用している画像・動画は日本仕様とは異なる場合があります。また、オプション装備等を含む場合があります。",
	"※本記事に掲載されている情報は投稿日時点のものであり、予告なく変更される場合がございます。",
	"※情報の掲載にあたりましては細心の注意を払っておりますが、その正確性や完全性を保証するものではございません。予めご了承ください。"
];

let rawText = (node.content || node.text || node.id || "").trim();
let rawLines = rawText
	? rawText.split("\n").map((l: string) => l.trim()).filter((l: string) => l.length > 0)
	: [];

// すでに入っている内容とかぶる場合は入れない（重複防止）
if (rawLines.length === 0) {
	rawLines = [...DEFAULT_DISCLAIMER_LINES];
} else {
	const hasJapanSpec = rawText.includes("日本仕様とは異なる場合");
	const hasPublishDate = rawText.includes("投稿日時点のものであり") || rawText.includes("掲載されている情報は");
	const hasAccuracy = rawText.includes("正確性や完全性を保証");

	const missingDisclaimers: string[] = [];
	if (!hasJapanSpec) missingDisclaimers.push(DEFAULT_DISCLAIMER_LINES[0]);
	if (!hasPublishDate) missingDisclaimers.push(DEFAULT_DISCLAIMER_LINES[1]);
	if (!hasAccuracy) missingDisclaimers.push(DEFAULT_DISCLAIMER_LINES[2]);

	if (missingDisclaimers.length > 0) {
		rawLines = [...rawLines, ...missingDisclaimers];
	}
}

// 最初の行が「本記事について」などの見出し的タイトルの場合
const hasTitle = rawLines.length > 0 && (
	rawLines[0].includes("本記事について") ||
	rawLines[0].includes("注釈") ||
	rawLines[0].includes("免責事項") ||
	(!rawLines[0].startsWith("※") && rawLines[0].length <= 20 && rawLines.length > 1)
);

const titleText = hasTitle ? rawLines[0] : null;
const bodyLines = hasTitle ? rawLines.slice(1) : rawLines;
---

{rawLines.length > 0 && (
	<aside class="article-notes-block" aria-label="注釈・備考">
		<div class="notes-inner">
			{titleText && (
				<p class="notes-title">{titleText}</p>
			)}
			{bodyLines.map((line: string) => (
				<p class={`notes-line ${line.startsWith('※') ? 'is-bullet' : ''}`}>{line}</p>
			))}
		</div>
	</aside>
)}

<style>
	.article-notes-block {
		margin: 44px 0 24px 0;
		padding: 24px 0 0 0;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.notes-inner {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.notes-title {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
		font-size: 13px;
		font-weight: 700;
		line-height: 1.4;
		color: var(--magazine-text-title, #ffffff);
		margin: 0 0 8px 0 !important;
		padding: 0 !important;
		letter-spacing: 0.02em;
	}

	.notes-line {
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
		font-size: 12.5px;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.58);
		margin: 0 !important;
		padding: 0 !important;
		letter-spacing: 0.02em;
		word-break: break-word;
		white-space: pre-line;
	}

	.notes-line.is-bullet {
		margin-top: 6px !important;
	}

	.notes-line + .notes-line:not(.is-bullet) {
		margin-top: 3px !important;
	}

	@media (max-width: 768px) {
		.article-notes-block {
			margin: 32px 0 20px 0;
			padding-top: 18px;
		}

		.notes-title {
			font-size: 12.5px;
			margin-bottom: 6px !important;
		}

		.notes-line {
			font-size: 12px;
			line-height: 1.6;
		}

		.notes-line.is-bullet {
			margin-top: 5px !important;
		}
	}
</style>
