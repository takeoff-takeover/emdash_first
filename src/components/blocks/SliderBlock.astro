---
/**
 * SliderBlock.astro
 * EmDash Portable Text カスタムブロック：ギャラリー（フィルムストリップ）
 * 標準採用デザイン：角型サムネイル連動 ＆ グレーのミニマルキャプション
 */
interface Props {
	node: {
		_type: string;
		_key?: string;
		id?: string;
		title?: string;
		caption?: string;
		captions?: string;
		images?: string;
		[key: string]: any;
	};
}

const { node } = Astro.props;
const mainImg = (node.id || "").trim();
const extraImgsRaw = node.images || "";

// 番号付き画像スロット (image_2 〜 image_12, slide_2 〜 slide_12)
const slotImages: string[] = [];
for (let i = 2; i <= 12; i++) {
	const val = (node[`image_${i}`] || node[`slide_${i}`] || "").trim();
	if (val && (val.startsWith("http://") || val.startsWith("https://") || val.startsWith("/"))) {
		slotImages.push(val);
	}
}

// 改行またはカンマでURLを分割（後方互換・一括指定）
const extraImgs = extraImgsRaw
	.split(/[\n,]/)
	.map((url: string) => url.trim())
	.filter((url: string) => url.startsWith("http://") || url.startsWith("https://") || url.startsWith("/"));

// キャプション行の分割（改行区切り対応）
const captionsRaw = node.captions || node.caption || "";
const captionList = captionsRaw
	.split("\n")
	.map((c: string) => c.trim());

const allImages: Array<{ image: string; caption: string }> = [];
if (Array.isArray(node.items) && node.items.length > 0) {
	node.items.forEach((it: any) => {
		const rawImg = typeof it?.image === "object" ? (it.image?.src || it.image?.url || "") : String(it?.image || "").trim();
		if (rawImg && (rawImg.startsWith("http://") || rawImg.startsWith("https://") || rawImg.startsWith("/"))) {
			allImages.push({
				image: rawImg,
				caption: String(it?.caption || "").trim(),
			});
		}
	});
}
if (allImages.length === 0) {
	if (mainImg && (mainImg.startsWith("http://") || mainImg.startsWith("https://") || mainImg.startsWith("/"))) {
		allImages.push({
			image: mainImg,
			caption: captionList[0] || (node.caption && !node.captions ? node.caption : "")
		});
	}
	slotImages.forEach((url: string) => {
		if (!allImages.some(img => img.image === url)) {
			const capIdx = allImages.length;
			allImages.push({
				image: url,
				caption: captionList[capIdx] || ""
			});
		}
	});
	extraImgs.forEach((url: string) => {
		if (!allImages.some(img => img.image === url)) {
			const capIdx = allImages.length;
			allImages.push({
				image: url,
				caption: captionList[capIdx] || ""
			});
		}
	});
}

const galleryStyle = node.gallery_style || "filmstrip";
const blockId = `slider-${node._key || Math.random().toString(36).slice(2, 9)}`;
---

{allImages.length > 0 && galleryStyle === "grid" && (
	<div class="cms-photo-grid">
		{allImages.map((item, idx) => (
			<figure class="cms-photo-grid__item">
				<div class="cms-photo-grid__media">
					<img src={item.image} alt={item.caption || `写真 ${idx + 1}`} loading="lazy" onerror="this.onerror=null;this.src='/images/placeholder-replace.jpg';" />
				</div>
				{item.caption && <figcaption class="cms-photo-grid__caption">{item.caption}</figcaption>}
			</figure>
		))}
	</div>
)}

{allImages.length > 0 && galleryStyle !== "grid" && (
	<div class="cms-filmstrip-gallery" id={blockId}>
		<!-- メインビューポート -->
		<div class="filmstrip-viewport">
			<div class="filmstrip-track" id={`${blockId}-track`}>
				{allImages.map((item, idx) => (
					<div class={`filmstrip-slide ${idx === 0 ? 'is-active' : ''}`} data-index={idx}>
						<img src={item.image} alt={item.caption || `写真 ${idx + 1}`} loading={idx === 0 ? "eager" : "lazy"} onerror="this.onerror=null;this.src='/images/placeholder-replace.jpg';" />
						<span class="filmstrip-badge">{idx + 1} / {allImages.length}</span>
					</div>
				))}
			</div>

			{allImages.length > 1 && (
				<>
					<button type="button" class="filmstrip-nav filmstrip-nav--prev" id={`${blockId}-prev`} aria-label="前の写真">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
					</button>
					<button type="button" class="filmstrip-nav filmstrip-nav--next" id={`${blockId}-next`} aria-label="次の写真">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
					</button>
				</>
			)}
		</div>

		<!-- キャプション（ご指示通り：グレーの小さい文字のみ表示） -->
		<div class="filmstrip-caption-wrap">
			<p class="filmstrip-caption" id={`${blockId}-caption`}>{allImages[0]?.caption || ""}</p>
		</div>

		<!-- フィルムストリップ・サムネイル一覧（角型・楕円なし） -->
		{allImages.length > 1 && (
			<div class="filmstrip-thumbs" id={`${blockId}-thumbs`}>
				{allImages.map((item, idx) => (
					<button type="button" class={`filmstrip-thumb ${idx === 0 ? 'is-active' : ''}`} data-thumb={idx} aria-label={`写真 ${idx + 1}`}>
						<img src={item.image} alt="" onerror="this.onerror=null;this.src='/images/placeholder-replace.jpg';" />
					</button>
				))}
			</div>
		)}
	</div>
)}

<style>
	.cms-photo-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 1.25rem;
		margin: clamp(28px, 4vw, 44px) 0;
	}
	.cms-photo-grid__item {
		margin: 0 !important;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.cms-photo-grid__media {
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: var(--radius-card, 4px);
		background: #09090d;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}
	.cms-photo-grid__media img {
		width: 100% !important;
		height: 100% !important;
		object-fit: contain !important;
		margin: 0 !important;
		display: block !important;
	}
	.cms-photo-grid__caption {
		font-size: 0.8125rem;
		color: var(--cms-card-text, #a1a1aa);
		opacity: 0.85;
		line-height: 1.5;
	}

	.cms-filmstrip-gallery {
		margin: clamp(32px, 4.5vw, 48px) 0;
		background: transparent;
		border: none;
		padding: 0;
	}

	/* Reset any inherited rich-text img styles */
	.cms-filmstrip-gallery :global(img),
	.cms-filmstrip-gallery img {
		margin: 0 !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		max-width: none !important;
	}

	.filmstrip-viewport {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		background: #09090d;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: var(--radius-card, 4px);
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
	}

	.filmstrip-track {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.filmstrip-slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.35s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.filmstrip-slide.is-active {
		opacity: 1;
		visibility: visible;
		z-index: 1;
	}

	.filmstrip-slide img {
		width: 100% !important;
		height: 100% !important;
		object-fit: contain !important;
		margin: 0 !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		display: block !important;
	}

	/* 右上のカウンターバッジ（角丸・モノトーン・すりガラス） */
	.filmstrip-badge {
		position: absolute;
		top: 14px;
		right: 14px;
		background: rgba(10, 10, 14, 0.75);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: var(--radius-meta, 0);
		font-family: var(--font-body);
		font-size: 0.75rem;
		font-weight: 600;
		padding: 4px 10px;
		color: #ffffff;
		letter-spacing: 0.08em;
		z-index: 2;
	}

	/* 左右矢印（すりガラス・丸型ボタン・ホバー浮遊） */
	.filmstrip-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: rgba(10, 10, 14, 0.65);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 50%;
		width: 44px;
		height: 44px;
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		cursor: pointer;
		filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.6));
		transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease, border-color 0.2s ease;
		z-index: 5;
	}

	.filmstrip-nav:hover {
		transform: translateY(-50%) scale(1.08);
		background: rgba(22, 22, 30, 0.9);
		border-color: rgba(255, 255, 255, 0.35);
	}

	.filmstrip-nav svg {
		width: 22px;
		height: 22px;
	}

	.filmstrip-nav--prev {
		left: 14px;
	}

	.filmstrip-nav--next {
		right: 14px;
	}

	/* キャプション */
	.filmstrip-caption-wrap {
		padding: 10px 0 4px 0;
		min-height: 24px;
	}

	.filmstrip-caption {
		font-size: 0.85rem;
		color: #a1a1aa;
		line-height: 1.6;
		margin: 0;
		letter-spacing: 0.02em;
	}

	/* フィルムストリップ・サムネイルバー */
	.filmstrip-thumbs {
		display: flex;
		gap: 8px;
		margin-top: 10px;
		overflow-x: auto;
		overflow-y: hidden !important;
		padding: 4px 0 6px 0;
		scrollbar-width: thin;
		scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
		-webkit-overflow-scrolling: touch;
	}

	.filmstrip-thumbs::-webkit-scrollbar {
		height: 4px;
		display: block;
	}

	.filmstrip-thumbs::-webkit-scrollbar-track {
		background: transparent;
	}

	.filmstrip-thumbs::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.25);
		border-radius: 4px;
	}

	.filmstrip-thumb {
		width: 76px !important;
		min-width: 76px !important;
		max-width: 76px !important;
		height: 48px !important;
		border: 1.5px solid transparent !important;
		background: #09090d !important;
		border-radius: var(--radius-xs, 2px) !important;
		padding: 0 !important;
		margin: 0 !important;
		cursor: pointer;
		opacity: 0.5;
		flex-shrink: 0 !important;
		overflow: hidden !important;
		display: block !important;
		box-sizing: border-box !important;
		line-height: 0 !important;
		transition: opacity 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}

	.filmstrip-thumb:hover {
		opacity: 0.85;
		transform: translateY(-1px);
	}

	.filmstrip-thumb.is-active {
		opacity: 1;
		border-color: #ffffff !important;
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.8), 0 4px 10px rgba(0, 0, 0, 0.5);
	}

	.filmstrip-thumb img {
		width: 100% !important;
		height: 100% !important;
		object-fit: cover !important;
		margin: 0 !important;
		padding: 0 !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		display: block !important;
	}
</style>

<script define:vars={{ blockId, images: allImages }}>
	if (images.length > 1) {
		let current = 0;
		const container = document.getElementById(blockId);
		if (container) {
			const slides = container.querySelectorAll('.filmstrip-slide');
			const thumbs = container.querySelectorAll('.filmstrip-thumb');
			const captionEl = document.getElementById(`${blockId}-caption`);
			const prevBtn = document.getElementById(`${blockId}-prev`);
			const nextBtn = document.getElementById(`${blockId}-next`);
			const viewport = container.querySelector('.filmstrip-viewport');

			function goTo(idx) {
				current = (idx + images.length) % images.length;
				slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
				thumbs.forEach((t, i) => t.classList.toggle('is-active', i === current));
				if (captionEl) {
					captionEl.textContent = images[current]?.caption || '';
				}
				if (thumbs[current]) {
					thumbs[current].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
				}
			}

			if (prevBtn) prevBtn.addEventListener('click', () => goTo(current - 1));
			if (nextBtn) nextBtn.addEventListener('click', () => goTo(current + 1));
			thumbs.forEach((t, i) => t.addEventListener('click', () => goTo(i)));

			// 指でのフリック（スワイプ）操作対応
			if (viewport) {
				let startX = 0;
				let startY = 0;
				let endX = 0;
				let endY = 0;
				let isTouching = false;

				viewport.addEventListener('touchstart', (e) => {
					if (e.touches.length === 1) {
						isTouching = true;
						startX = e.touches[0].clientX;
						startY = e.touches[0].clientY;
						endX = startX;
						endY = startY;
					}
				}, { passive: true });

				viewport.addEventListener('touchmove', (e) => {
					if (!isTouching) return;
					endX = e.touches[0].clientX;
					endY = e.touches[0].clientY;
				}, { passive: true });

				viewport.addEventListener('touchend', () => {
					if (!isTouching) return;
					isTouching = false;
					const deltaX = endX - startX;
					const deltaY = endY - startY;

					// 横方向の移動量が35px以上、かつ縦移動より優位な場合にフリック実行
					if (Math.abs(deltaX) > 35 && Math.abs(deltaX) > Math.abs(deltaY) * 1.2) {
						if (deltaX < 0) {
							goTo(current + 1); // 左フリック → 次の写真
						} else {
							goTo(current - 1); // 右フリック → 前の写真
						}
					}
				}, { passive: true });
			}
		}
	}
</script>
