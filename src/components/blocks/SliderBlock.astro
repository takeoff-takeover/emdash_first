---
/**
 * SliderBlock.astro
 * EmDash Portable Text カスタムブロック：ギャラリー（フィルムストリップ）
 * 標準採用デザイン：角型サムネイル連動 ＆ グレーのミニマルキャプション
 */
interface Props {
	node: {
		_type: string;
		_key?: string;
		id?: string;
		title?: string;
		caption?: string;
		captions?: string;
		images?: string;
		[key: string]: any;
	};
}

const { node } = Astro.props;
const mainImg = (node.id || "").trim();
const extraImgsRaw = node.images || "";

// 番号付き画像スロット (image_2 〜 image_12, slide_2 〜 slide_12)
const slotImages: string[] = [];
for (let i = 2; i <= 12; i++) {
	const val = (node[`image_${i}`] || node[`slide_${i}`] || "").trim();
	if (val && (val.startsWith("http://") || val.startsWith("https://") || val.startsWith("/"))) {
		slotImages.push(val);
	}
}

// 改行またはカンマでURLを分割（後方互換・一括指定）
const extraImgs = extraImgsRaw
	.split(/[\n,]/)
	.map((url: string) => url.trim())
	.filter((url: string) => url.startsWith("http://") || url.startsWith("https://") || url.startsWith("/"));

// キャプション行の分割（改行区切り対応）
const captionsRaw = node.captions || node.caption || "";
const captionList = captionsRaw
	.split("\n")
	.map((c: string) => c.trim());

const allImages: Array<{ image: string; caption: string }> = [];
if (mainImg && (mainImg.startsWith("http://") || mainImg.startsWith("https://") || mainImg.startsWith("/"))) {
	allImages.push({
		image: mainImg,
		caption: captionList[0] || (node.caption && !node.captions ? node.caption : "")
	});
}
slotImages.forEach((url: string) => {
	if (!allImages.some(img => img.image === url)) {
		const capIdx = allImages.length;
		allImages.push({
			image: url,
			caption: captionList[capIdx] || ""
		});
	}
});
extraImgs.forEach((url: string) => {
	if (!allImages.some(img => img.image === url)) {
		const capIdx = allImages.length;
		allImages.push({
			image: url,
			caption: captionList[capIdx] || ""
		});
	}
});

const blockId = `slider-${node._key || Math.random().toString(36).slice(2, 9)}`;
---

{allImages.length > 0 && (
	<div class="cms-filmstrip-gallery" id={blockId}>
		<!-- メインビューポート -->
		<div class="filmstrip-viewport">
			<div class="filmstrip-track" id={`${blockId}-track`}>
				{allImages.map((item, idx) => (
					<div class={`filmstrip-slide ${idx === 0 ? 'is-active' : ''}`} data-index={idx}>
						<img src={item.image} alt={item.caption || `写真 ${idx + 1}`} loading={idx === 0 ? "eager" : "lazy"} />
						<span class="filmstrip-badge">{idx + 1} / {allImages.length}</span>
					</div>
				))}
			</div>

			{allImages.length > 1 && (
				<>
					<button type="button" class="filmstrip-nav filmstrip-nav--prev" id={`${blockId}-prev`} aria-label="前の写真">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
					</button>
					<button type="button" class="filmstrip-nav filmstrip-nav--next" id={`${blockId}-next`} aria-label="次の写真">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
					</button>
				</>
			)}
		</div>

		<!-- キャプション（ご指示通り：グレーの小さい文字のみ表示） -->
		<div class="filmstrip-caption-wrap">
			<p class="filmstrip-caption" id={`${blockId}-caption`}>{allImages[0]?.caption || ""}</p>
		</div>

		<!-- フィルムストリップ・サムネイル一覧（角型・楕円なし） -->
		{allImages.length > 1 && (
			<div class="filmstrip-thumbs" id={`${blockId}-thumbs`}>
				{allImages.map((item, idx) => (
					<button type="button" class={`filmstrip-thumb ${idx === 0 ? 'is-active' : ''}`} data-thumb={idx} aria-label={`写真 ${idx + 1}`}>
						<img src={item.image} alt="" />
					</button>
				))}
			</div>
		)}
	</div>
)}

<style>
	.cms-filmstrip-gallery {
		margin: 2.5rem 0;
		background: transparent;
		border: none;
		padding: 0;
	}

	.filmstrip-viewport {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		background: #000000;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.08);
	}

	.filmstrip-track {
		position: relative;
		width: 100%;
		height: 100%;
	}

	.filmstrip-slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.35s ease;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.filmstrip-slide.is-active {
		opacity: 1;
		visibility: visible;
		z-index: 1;
	}

	.filmstrip-slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* 右上のカウンターバッジ（角型・モノトーン・楕円なし） */
	.filmstrip-badge {
		position: absolute;
		top: 12px;
		right: 12px;
		background: rgba(0, 0, 0, 0.8);
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 0;
		font-family: var(--font-mono, monospace);
		font-size: 0.75rem;
		font-weight: 600;
		padding: 3px 8px;
		color: #ffffff;
		letter-spacing: 0.05em;
		z-index: 2;
	}

	/* 左右矢印（背景なし・フロートシェブロン・楕円なし） */
	.filmstrip-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		background: transparent;
		border: none;
		color: #ffffff;
		padding: 12px;
		cursor: pointer;
		filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.95));
		transition: transform 0.2s ease, opacity 0.2s;
		z-index: 5;
	}

	.filmstrip-nav:hover {
		transform: translateY(-50%) scale(1.15);
	}

	.filmstrip-nav svg {
		width: 32px;
		height: 32px;
	}

	.filmstrip-nav--prev {
		left: 8px;
	}

	.filmstrip-nav--next {
		right: 8px;
	}

	/* キャプション（グレーの小さい文字のみ・見出しなし） */
	.filmstrip-caption-wrap {
		padding: 10px 0 4px 0;
		min-height: 24px;
	}

	.filmstrip-caption {
		font-size: 0.88rem;
		color: #9ca3af;
		line-height: 1.6;
		margin: 0;
	}

	/* フィルムストリップ・サムネイルバー（角型・楕円なし） */
	.filmstrip-thumbs {
		display: flex;
		gap: 8px;
		margin-top: 10px;
		overflow-x: auto;
		overflow-y: hidden !important;
		padding: 2px 0 6px 0;
		scrollbar-width: thin;
		scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
		-webkit-overflow-scrolling: touch;
	}

	.filmstrip-thumbs::-webkit-scrollbar {
		height: 4px;
		display: block;
	}

	.filmstrip-thumbs::-webkit-scrollbar-track {
		background: transparent;
	}

	.filmstrip-thumbs::-webkit-scrollbar-thumb {
		background: rgba(255, 255, 255, 0.25);
	}

	.filmstrip-thumb {
		width: 76px;
		height: 48px;
		border: 1px solid transparent;
		background: #000000;
		border-radius: 0;
		padding: 0;
		cursor: pointer;
		opacity: 0.45;
		flex-shrink: 0;
		transition: opacity 0.2s ease, border-color 0.2s ease;
	}

	.filmstrip-thumb:hover {
		opacity: 0.8;
	}

	.filmstrip-thumb.is-active {
		opacity: 1;
		border-color: #ffffff;
	}

	.filmstrip-thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>

<script define:vars={{ blockId, images: allImages }}>
	if (images.length > 1) {
		let current = 0;
		const container = document.getElementById(blockId);
		if (container) {
			const slides = container.querySelectorAll('.filmstrip-slide');
			const thumbs = container.querySelectorAll('.filmstrip-thumb');
			const captionEl = document.getElementById(`${blockId}-caption`);
			const prevBtn = document.getElementById(`${blockId}-prev`);
			const nextBtn = document.getElementById(`${blockId}-next`);

			function goTo(idx) {
				current = (idx + images.length) % images.length;
				slides.forEach((s, i) => s.classList.toggle('is-active', i === current));
				thumbs.forEach((t, i) => t.classList.toggle('is-active', i === current));
				if (captionEl) {
					captionEl.textContent = images[current]?.caption || '';
				}
				if (thumbs[current]) {
					thumbs[current].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
				}
			}

			if (prevBtn) prevBtn.addEventListener('click', () => goTo(current - 1));
			if (nextBtn) nextBtn.addEventListener('click', () => goTo(current + 1));
			thumbs.forEach((t, i) => t.addEventListener('click', () => goTo(i)));
		}
	}
</script>
