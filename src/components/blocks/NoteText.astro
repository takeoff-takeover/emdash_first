---
/**
 * NoteText.astro
 * EmDash Portable Text 本文内「注釈」段落コンポーネント
 * 段落変換メニューで「注釈」が選ばれたブロックを他の注釈ブロックと同じスタイルでレンダリング
 * 管理画面で設定された文字揃え（左寄せ、中央揃え、右寄せ等）も確実に反映する
 */
interface Props {
	node?: any;
	index?: number;
	isInline?: boolean;
	[key: string]: any;
}

const { node, index, isInline, ...attrs } = Astro.props;

const textAlign = node?.textAlign;
const textAlignStyle = textAlign ? `text-align: ${textAlign};` : undefined;
const customStyle = [attrs.style, textAlignStyle].filter(Boolean).join(" ") || undefined;
---

<p class="article-note is-note" style={customStyle} {...attrs}><slot /></p>
