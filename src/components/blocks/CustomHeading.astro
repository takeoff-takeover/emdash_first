---
// src/components/blocks/CustomHeading.astro
// 見出し末尾の [#anchor] または {#anchor} を検出して自動的に id 属性を付与し、
// テキスト上からはタグを自然に除去するスマートアンカー見出しコンポーネント
// 大文字・小文字の表記揺れ（#FAQ / #faq）にも自動対応
interface Props {
	node: any;
	index?: number;
	isInline?: boolean;
	[key: string]: any;
}

const { node, index, isInline, ...attrs } = Astro.props;

let anchorId: string | undefined = undefined;

if (Array.isArray(node?.children)) {
	for (const child of node.children) {
		if (typeof child?.text === "string") {
			// [#xxx] または {#xxx} または ［#xxx］ を検出（全角半角両対応）
			const m = child.text.match(/(?:\[[#＃]([a-zA-Z0-9_-]+)\]|\{[#＃]([a-zA-Z0-9_-]+)\}|［[#＃]([a-zA-Z0-9_-]+)］)/);
			if (m) {
				anchorId = m[1] || m[2] || m[3];
				child.text = child.text.replace(/(?:\[[#＃]([a-zA-Z0-9_-]+)\]|\{[#＃]([a-zA-Z0-9_-]+)\}|［[#＃]([a-zA-Z0-9_-]+)］)/, "").trim();
			}
		}
	}
}

const Tag = (node?.style && ["h1", "h2", "h3", "h4", "h5", "h6"].includes(node.style)) ? node.style : "h2";

// 管理画面で指定された配置（右寄せ、中央揃え等）を反映
const textAlign = node?.textAlign;
const textAlignStyle = textAlign ? `text-align: ${textAlign};` : undefined;
const customStyle = [attrs.style, textAlignStyle].filter(Boolean).join(" ") || undefined;

const lowerAnchor = anchorId ? anchorId.toLowerCase() : undefined;
const upperAnchor = anchorId ? anchorId.toUpperCase() : undefined;
---

{anchorId && lowerAnchor && lowerAnchor !== anchorId && (
	<span id={lowerAnchor} class="anchor-alias-marker" aria-hidden="true"></span>
)}
{anchorId && upperAnchor && upperAnchor !== anchorId && (
	<span id={upperAnchor} class="anchor-alias-marker" aria-hidden="true"></span>
)}
<Tag id={anchorId} style={customStyle} data-anchor={lowerAnchor} {...attrs}>
	<slot />
</Tag>

<style>
	:global(h1[id]),
	:global(h2[id]),
	:global(h3[id]),
	:global(h4[id]),
	:global(h5[id]),
	:global(h6[id]),
	.anchor-alias-marker {
		scroll-margin-top: 95px !important;
	}
	.anchor-alias-marker {
		display: block;
		position: relative;
		height: 0;
		width: 0;
		visibility: hidden;
		pointer-events: none;
	}
</style>
