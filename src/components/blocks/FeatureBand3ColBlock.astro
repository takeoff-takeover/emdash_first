---
// src/components/blocks/FeatureBand3ColBlock.astro
// 全幅帯 × 3カラム写真カードブロック（写真＋見出し＋説明文、背景色ダーク/ライト選択可）
interface Props {
	value?: Record<string, any>;
	[key: string]: any;
}

const props = Astro.props;
const data = props.node || props.value || props;

function resolveImg(val: any): string {
	if (!val) return "";
	if (typeof val === "object") return val.src || val.url || "";
	if (typeof val === "string" && val.trim().startsWith("{")) {
		try { return JSON.parse(val).src || ""; } catch { return ""; }
	}
	return String(val);
}

const isLight = data.theme === "light";
const cards = [1, 2, 3]
	.map((i) => ({
		image: resolveImg(data[`card${i}_image`]),
		title: data[`card${i}_title`] || "",
		text: data[`card${i}_text`] || "",
	}))
	.filter((c) => c.image || c.title || c.text);
---

{cards.length > 0 && (
	<section class={`cmp-band-block ${isLight ? "is-light" : "is-dark"}`}>
		<div class="cmp-band-block__inner">
			{(data.heading || data.lead) && (
				<div class="cmp-band-block__header">
					{data.heading && <h2 class="cmp-band-block__heading">{data.heading}</h2>}
					{data.lead && <p class="cmp-band-block__lead">{data.lead}</p>}
				</div>
			)}
			<div class="cmp-band-block__grid cmp-band-block__grid--3col">
				{cards.map((c) => (
					<div class="cmp-band-card">
						{c.image && (
							<div class="cmp-band-card__media">
								<img src={c.image} alt={c.title} loading="lazy" />
							</div>
						)}
						<div class="cmp-band-card__body">
							{c.title && <h3 class="cmp-band-card__title">{c.title}</h3>}
							{c.text && <p class="cmp-band-card__text">{c.text}</p>}
						</div>
					</div>
				))}
			</div>
		</div>
	</section>
)}

<style>
	.cmp-band-block {
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
		margin-top: 3.5rem;
		margin-bottom: 3.5rem;
		padding: 4.5rem 1.5rem;
	}
	.cmp-band-block.is-dark {
		background: #121215;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		color: #ffffff;
	}
	.cmp-band-block.is-light {
		background: #f4f4f6;
		color: #111113;
	}
	.cmp-band-block__inner {
		max-width: 1200px;
		margin: 0 auto;
	}
	.cmp-band-block__header {
		margin-bottom: 2.25rem;
	}
	.cmp-band-block__heading {
		font-size: clamp(1.4rem, 2.5vw, 1.95rem);
		font-weight: 700;
		margin: 0 0 0.6rem 0;
		line-height: 1.35;
		color: inherit;
	}
	.cmp-band-block__lead {
		font-size: 0.975rem;
		opacity: 0.78;
		margin: 0;
		line-height: 1.7;
	}
	.cmp-band-block__grid--3col {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.5rem;
	}
	.cmp-band-card {
		border-radius: 12px;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		display: flex;
		flex-direction: column;
	}
	.cmp-band-block.is-light .cmp-band-card {
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.08);
	}
	.cmp-band-card__media {
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #0d0d0f;
	}
	.cmp-band-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.cmp-band-card__body {
		padding: 1.5rem;
	}
	.cmp-band-card__title {
		font-size: 1.1rem;
		font-weight: 700;
		margin: 0 0 0.65rem 0;
		line-height: 1.45;
		color: inherit;
	}
	.cmp-band-card__text {
		font-size: 0.925rem;
		line-height: 1.75;
		opacity: 0.82;
		margin: 0;
	}
	@media (max-width: 900px) {
		.cmp-band-block {
			padding: 3rem 1.25rem;
		}
		.cmp-band-block__grid--3col {
			grid-template-columns: 1fr;
		}
	}
</style>
