---
/**
 * AccordionBlock.astro
 * EmDash Portable Text カスタムブロック：アコーディオン（ミニマル・ヘアライン型）
 * 背景なし・極細線ヘアライン・ミニマルな「＋ / −」アイコン・ゆったりとした余白
 */
interface Props {
	node: {
		_type: string;
		_key?: string;
		id?: string;
		content?: string;
		[key: string]: any;
	};
}

const { node } = Astro.props;
const title = node.id || "詳細情報を開く";
const contentRaw = node.content || "";

// テキストを行ごとに分解
const lines = contentRaw
	.split("\n")
	.map((l: string) => l.trim())
	.filter((l: string) => l.length > 0);

// 「：」「:」「|」で区切られたキー・バリュー形式が含まれているかを判定
const isTableFormat = lines.length > 0 && lines.every((l: string) => l.includes(":") || l.includes("：") || l.includes("|"));

const tableRows = isTableFormat
	? lines.map((l: string) => {
			const sep = l.includes("：") ? "：" : (l.includes(":") ? ":" : "|");
			const parts = l.split(sep);
			return {
				key: parts[0].trim(),
				val: parts.slice(1).join(sep).trim()
			};
	  })
	: [];
---

<details class="cms-accordion-block acc-minimal-hairline">
	<summary class="cms-acc-summary">
		<span class="summary-title">{title}</span>
		<span class="acc-toggle-icon">
			<svg class="icon-plus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
				<line x1="12" y1="5" x2="12" y2="19"></line>
				<line x1="5" y1="12" x2="19" y2="12"></line>
			</svg>
			<svg class="icon-minus" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
				<line x1="5" y1="12" x2="19" y2="12"></line>
			</svg>
		</span>
	</summary>

	<div class="cms-acc-body">
		{isTableFormat && tableRows.length > 0 ? (
			<table class="cms-acc-table">
				<tbody>
					{tableRows.map((row) => (
						<tr>
							<th>{row.key}</th>
							<td>{row.val}</td>
						</tr>
					))}
				</tbody>
			</table>
		) : (
			<div class="cms-acc-text">
				{lines.map((p: string) => (
					<p>{p}</p>
				))}
			</div>
		)}
	</div>
</details>

<style>
	.cms-accordion-block.acc-minimal-hairline {
		margin: 2rem 0;
		background: transparent;
		border: none;
		border-top: 1px solid rgba(255, 255, 255, 0.12);
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 0;
		overflow: hidden;
		transition: border-color 0.25s ease;
	}

	.cms-accordion-block.acc-minimal-hairline:hover {
		border-top-color: rgba(255, 255, 255, 0.22);
		border-bottom-color: rgba(255, 255, 255, 0.22);
	}

	.cms-accordion-block.acc-minimal-hairline[open] {
		border-top-color: rgba(255, 255, 255, 0.35);
		border-bottom-color: rgba(255, 255, 255, 0.35);
	}

	.cms-acc-summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.35rem 0;
		background: transparent;
		cursor: pointer;
		user-select: none;
		list-style: none;
		transition: opacity 0.2s;
	}

	.cms-acc-summary::-webkit-details-marker {
		display: none;
	}

	.cms-acc-summary:hover {
		opacity: 0.9;
	}

	.summary-title {
		font-family: var(--font-heading, inherit);
		font-size: 1.05rem;
		font-weight: 600;
		color: #ffffff;
		letter-spacing: -0.01em;
		line-height: 1.45;
	}

	.acc-toggle-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		color: #a1a1aa;
		width: 24px;
		height: 24px;
		flex-shrink: 0;
		transition: color 0.2s ease, transform 0.2s ease;
	}

	.acc-toggle-icon svg {
		width: 20px;
		height: 20px;
		stroke: currentColor;
	}

	.cms-accordion-block .icon-minus {
		display: none;
	}

	.cms-accordion-block[open] .icon-plus {
		display: none;
	}

	.cms-accordion-block[open] .icon-minus {
		display: block;
		color: #ffffff;
	}

	.cms-acc-body {
		padding: 0.5rem 0 1.75rem 0;
		background: transparent;
	}

	/* アコーディオン内テーブル：文字と線が近すぎないゆったりとした美しい余白 */
	.cms-acc-table {
		width: 100%;
		border-collapse: collapse;
		margin: 0.5rem 0 0;
		font-size: 0.875rem;
	}

	.cms-acc-table tr {
		border-bottom: 1px solid rgba(255, 255, 255, 0.07);
	}

	.cms-acc-table tr:last-child {
		border-bottom: none;
	}

	.cms-acc-table th {
		width: 32%;
		padding: 1.1rem 1.5rem 1.1rem 0;
		text-align: left;
		font-weight: 600;
		color: #a1a1aa;
		font-size: 0.85rem;
		vertical-align: top;
		line-height: 1.6;
		letter-spacing: 0.02em;
	}

	.cms-acc-table td {
		padding: 1.1rem 0;
		color: #f4f4f5;
		line-height: 1.65;
		font-size: 0.9rem;
	}

	.cms-acc-text p {
		margin: 0 0 1.15rem;
		color: #d4d4d8;
		line-height: 1.8;
		font-size: 0.95rem;
	}

	.cms-acc-text p:last-child {
		margin-bottom: 0;
	}
</style>
