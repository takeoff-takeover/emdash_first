---
/**
 * TableBlock.astro
 * EmDash Portable Text カスタムブロック：レスポンシブ・テーブル
 * 
 * 要件：
 * 1. PCでは横スクロール不要で100%幅に収まる美しいエディトリアル表
 * 2. スマホ（狭小画面）では横スクロールを強要せず、各行が美しいスペックカードに自動変形
 * 3. 「← 横にスクロールしてご覧いただけます →」のような煩わしい注記を不要にする
 */
interface Props {
	node: {
		_type: string;
		_key?: string;
		title?: string;
		caption?: string;
		headers?: string[];
		rows?: any[];
		items?: any[];
		html?: string;
		[key: string]: any;
	};
}

const { node } = Astro.props;

interface ParsedRow {
	cells: {
		text: string;
		isHeader?: boolean;
	}[];
}

let headers: string[] = [];
let rows: ParsedRow[] = [];

// TSV/CSVテキストのパース補助関数
function parseCsvLine(line: string, delimiter: string): string[] {
	const result: string[] = [];
	let cur = "";
	let inQuote = false;
	for (let i = 0; i < line.length; i++) {
		const char = line[i];
		if (char === '"') {
			if (inQuote && line[i + 1] === '"') {
				cur += '"';
				i++;
			} else {
				inQuote = !inQuote;
			}
		} else if (char === delimiter && !inQuote) {
			result.push(cur.trim());
			cur = "";
		} else {
			cur += char;
		}
	}
	result.push(cur.trim());
	return result;
}

const rawCsvText = String(node.raw_csv || node.csv || node.tsv || "").trim();

if (rawCsvText) {
	// TSV/CSVからのパース
	const rawLines = rawCsvText.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
	if (rawLines.length > 0) {
		const firstLine = rawLines[0];
		const delimiter = firstLine.includes("\t") ? "\t" : ",";
		headers = parseCsvLine(firstLine, delimiter);
		for (let i = 1; i < rawLines.length; i++) {
			const cellTexts = parseCsvLine(rawLines[i], delimiter);
			rows.push({
				cells: cellTexts.map(t => ({ text: t }))
			});
		}
	}
}

if (headers.length === 0 && Array.isArray(node.headers) && node.headers.length > 0) {
	headers = node.headers.map(h => String(h || "").trim());
}

if (rows.length === 0 && Array.isArray(node.rows)) {
	node.rows.forEach((r: any, rIdx: number) => {
		const rawCells = Array.isArray(r.cells) ? r.cells : [];
		const parsedCells = rawCells.map((c: any) => {
			let text = "";
			if (typeof c === "string") {
				text = c;
			} else if (c?.text) {
				text = c.text;
			} else if (Array.isArray(c?.content)) {
				text = c.content.map((span: any) => span.text || "").join("");
			} else if (Array.isArray(c?.children)) {
				text = c.children.map((span: any) => span.text || "").join("");
			}
			return {
				text: text.trim(),
				isHeader: Boolean(c?.isHeader || r?.isHeader || rIdx === 0 && rawCells.every((cell: any) => cell?.isHeader))
			};
		});

		// 最初の行がヘッダー指定されている場合
		if (rIdx === 0 && headers.length === 0 && (r.isHeader || parsedCells.every((c: { isHeader: boolean; text: string }) => c.isHeader))) {
			headers = parsedCells.map((c: { isHeader: boolean; text: string }) => c.text);
		} else {
			rows.push({ cells: parsedCells });
		}
	});
} else if (Array.isArray(node.items)) {
	// key-value items or generic array
	node.items.forEach((it: any) => {
		if (typeof it === "object") {
			const cellList = Object.values(it).map(val => ({ text: String(val || "").trim() }));
			rows.push({ cells: cellList });
			if (headers.length === 0) {
				headers = Object.keys(it);
			}
		}
	});
}

const title = (node.title || "").trim();
const caption = (node.caption || "").trim();
---

<div class="cms-table-widget">
	{title && <h3 class="cms-table-title">{title}</h3>}

	{/* 1. PC/タブレット用：標準エディトリアル・テーブル */}
	<div class="cms-table-desktop-container">
		<table class="cms-responsive-table">
			{headers.length > 0 && (
				<thead>
					<tr>
						{headers.map((h) => (
							<th scope="col">{h}</th>
						))}
					</tr>
				</thead>
			)}
			<tbody>
				{rows.map((r) => (
					<tr>
						{r.cells.map((c) => (
							<td>
								<Fragment set:html={c.text.replace(/\n/g, "<br />")} />
							</td>
						))}
					</tr>
				))}
			</tbody>
		</table>
	</div>

	{/* 2. スマートフォン用（横スクロール完全撤廃）：洗練されたスペックカード一覧 */}
	<div class="cms-table-mobile-cards" aria-label={title || "スペック比較一覧"}>
		{rows.map((r) => {
			const titleCell = r.cells[0];
			const specCells = r.cells.slice(1);
			const specHeaders = headers.slice(1);

			return (
				<article class="cms-spec-card">
					{titleCell && (
						<h4 class="cms-spec-card__title">
							<Fragment set:html={titleCell.text.replace(/\n/g, "<br />")} />
						</h4>
					)}
					<dl class="cms-spec-card__dl">
						{specCells.map((c, idx) => (
							<div class="cms-spec-card__row">
								<dt class="cms-spec-card__label">{specHeaders[idx] || ""}</dt>
								<dd class="cms-spec-card__value">
									<Fragment set:html={c.text.replace(/\n/g, "<br />")} />
								</dd>
							</div>
						))}
					</dl>
				</article>
			);
		})}
	</div>

	{caption && <p class="cms-table-caption">{caption}</p>}
</div>

<style>
	.cms-table-widget {
		margin: 2.75rem 0;
		width: 100%;
		position: relative;
	}

	.cms-table-title {
		font-size: 1.15rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 0.85rem 0;
		line-height: 1.4;
	}

	/* -------------------------------------------------------------
	   1. PC/タブレット用テーブル表示
	   ------------------------------------------------------------- */
	.cms-table-desktop-container {
		display: block;
		width: 100%;
		border-radius: 8px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.12);
		background: #0b0c10;
	}

	.cms-responsive-table {
		width: 100% !important;
		table-layout: auto !important;
		border-collapse: collapse !important;
		text-align: left;
		font-size: 0.875rem;
		line-height: 1.6;
		margin: 0 !important;
	}

	.cms-responsive-table thead th {
		background: #14161d !important;
		color: #ffffff !important;
		font-weight: 700 !important;
		padding: 12px 14px !important;
		border-bottom: 2px solid rgba(255, 255, 255, 0.15) !important;
		border-right: 1px solid rgba(255, 255, 255, 0.08) !important;
		font-size: 0.825rem !important;
		letter-spacing: 0.02em;
		white-space: nowrap !important;
		vertical-align: middle !important;
	}
	.cms-responsive-table thead th:last-child {
		border-right: none !important;
	}

	.cms-responsive-table tbody tr {
		border-bottom: 1px solid rgba(255, 255, 255, 0.07) !important;
		transition: background-color 0.15s ease;
	}
	.cms-responsive-table tbody tr:nth-child(even) {
		background: rgba(255, 255, 255, 0.015) !important;
	}
	.cms-responsive-table tbody tr:last-child {
		border-bottom: none !important;
	}
	.cms-responsive-table tbody tr:hover {
		background: rgba(255, 255, 255, 0.04) !important;
	}

	.cms-responsive-table tbody td {
		padding: 12px 14px !important;
		vertical-align: middle !important;
		color: rgba(255, 255, 255, 0.88) !important;
		border-right: 1px solid rgba(255, 255, 255, 0.06) !important;
		line-height: 1.55 !important;
		word-break: break-word !important;
	}
	.cms-responsive-table tbody td:last-child {
		border-right: none !important;
	}

	.cms-responsive-table tbody td:first-child {
		font-weight: 700 !important;
		color: #ffffff !important;
		/* タブレットや中間幅でも不自然な突き抜けを防ぐ */
		word-break: break-word !important;
	}

	/* -------------------------------------------------------------
	   2. タブレット・スマホ用カード表示（横スクロール不要・縦スクロール完結）
	   ------------------------------------------------------------- */
	.cms-table-mobile-cards {
		display: none;
		grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
		gap: 16px;
		width: 100%;
	}

	.cms-spec-card {
		background: #0d0f14;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		padding: 18px 16px;
		box-sizing: border-box;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
	}

	.cms-spec-card__title {
		font-size: 1.05rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 12px 0;
		padding-bottom: 10px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		line-height: 1.4;
		letter-spacing: 0.01em;
	}

	.cms-spec-card__dl {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin: 0;
		padding: 0;
	}

	.cms-spec-card__row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 12px;
		padding-bottom: 8px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
	}
	.cms-spec-card__row:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.cms-spec-card__label {
		font-size: 0.8rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.5);
		margin: 0;
		flex-shrink: 0;
		max-width: 45%;
		line-height: 1.45;
	}

	.cms-spec-card__value {
		font-size: 0.875rem;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.92);
		margin: 0;
		text-align: right;
		line-height: 1.5;
		word-break: break-word;
	}

	.cms-table-caption {
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.5);
		margin: 0.75rem 0 0 0;
		line-height: 1.5;
	}

	/* ==============================================================
	   ブレークポイント（1024px以下）：
	   多列テーブルが窮屈になるタブレット縦向き（〜1024px）およびスマホにおいて、
	   横スクロールを強要せず、美しく高密度なスペックカードグリッドへ自動変形。
	   - タブレット（641px〜1024px）: 2列のスペックカード
	   - スマホ（〜640px）: 1列の縦型スペックカード
	   ============================================================== */
	@media (max-width: 1024px) {
		.cms-table-desktop-container {
			display: none !important;
		}

		.cms-table-mobile-cards {
			display: grid !important;
			grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)) !important;
			gap: 16px !important;
		}
	}

	@media (max-width: 640px) {
		.cms-table-mobile-cards {
			grid-template-columns: 1fr !important;
			gap: 12px !important;
		}
	}
</style>
