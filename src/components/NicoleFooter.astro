---
// src/components/NicoleFooter.astro
// ニコル・グループ公式フッター（シネマティック＆ミニマル・エディトリアル仕様）
---

<footer class="nicole-global-footer">
	<!-- フローティング問い合わせボタン（右下追従） -->
	<aside class="floating-inquiry-wrap" id="floating-inquiry-btn">
		<a href="https://www.nicole.co.jp/contact/?form_type=inquiry" class="floating-inquiry-btn" aria-label="お問い合わせフォームを開く">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="inquiry-icon">
				<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
			</svg>
			<span class="inquiry-text">お問い合わせ</span>
		</a>
	</aside>

	<div class="footer-container">
		<!-- 上部：ブランドロゴ ＆ 理念ステートメント -->
		<div class="footer-top-row">
			<div class="footer-brand-lockup">
				<a href="/" class="footer-logo-link">
					<span class="footer-logo-text">NICOLE GROUP</span>
				</a>
				<p class="footer-tagline">
					東京・神奈川エリアを中心に、世界のプレミアムブランドを通じて最高の喜びをお届けするカーディーラー・グループ。
				</p>
			</div>

			<!-- ナビゲーションサイトマップ -->
			<nav class="footer-nav-grid" aria-label="フッターナビゲーション">
				<div class="nav-column">
					<h4 class="nav-heading">BRANDS</h4>
					<ul class="nav-list">
						<li><a href="https://nicole.bmw.jp/" target="_blank" rel="noopener">BMW</a></li>
						<li><a href="https://nicole.mini.jp/" target="_blank" rel="noopener">MINI</a></li>
						<li><a href="https://www.nicole.co.jp/corporate/nicole-motorcars/">Rolls-Royce</a></li>
						<li><a href="https://www.nicole.co.jp/corporate/nicole-competizione/">Ferrari</a></li>
						<li><a href="https://nicole-automobiles.com/" target="_blank" rel="noopener">BMW ALPINA</a></li>
					</ul>
				</div>

				<div class="nav-column">
					<h4 class="nav-heading">MAGAZINE & MEDIA</h4>
					<ul class="nav-list">
						<li><a href="/magazine/">Nicole Connect</a></li>
						<li><a href="/magazine/?brand=BMW">BMW Stories</a></li>
						<li><a href="/magazine/?brand=MINI">MINI Culture</a></li>
						<li><a href="/magazine/?brand=Ferrari">Ferrari Competizione</a></li>
						<li><a href="/magazine/?topic=Guide">Buyer's Guide</a></li>
					</ul>
				</div>

				<div class="nav-column">
					<h4 class="nav-heading">SHOWROOMS</h4>
					<ul class="nav-list">
						<li><a href="/location/">ショールーム一覧</a></li>
						<li><a href="/location/nicole-bmw-kawasaki/">BMW 本社ショールーム（川崎）</a></li>
						<li><a href="/location/nicole-bmw-aobamiyamae/">BMW 青葉宮前支店</a></li>
						<li><a href="/location/nicole-bmw-yokohama-kohoku/">BMW 横浜港北支店</a></li>
						<li><a href="/location/nicole-bmw-ota/">BMW 大田支店</a></li>
						<li><a href="/location/nicole-bmw-shin-yurigaoka/">BMW 新百合ヶ丘支店</a></li>
					</ul>
				</div>

				<div class="nav-column">
					<h4 class="nav-heading">CORPORATE</h4>
					<ul class="nav-list">
						<li><a href="https://www.nicole.co.jp/corporate/">グループ概要</a></li>
						<li><a href="https://www.nicole.co.jp/corporate/esg_sdgs/">ESG / SDGsの取り組み</a></li>
						<li><a href="https://www.penskeautomotive.com/" target="_blank" rel="noopener">Penske Automotive Group</a></li>
						<li><a href="https://www.nicole.co.jp/contact/?form_type=inquiry">お問い合わせ</a></li>
					</ul>
				</div>
			</nav>
		</div>

		<!-- グループ法人ロゴ・一覧バー -->
		<div class="footer-affiliates-bar">
			<span class="affiliates-label">NICOLE GROUP COMPANIES</span>
			<div class="affiliates-list">
				<span>Nicole Racing Japan Co., Ltd.</span>
				<span class="sep">/</span>
				<span>Nicole Automobiles Co., Ltd.</span>
				<span class="sep">/</span>
				<span>Nicole Cars Co., Ltd.</span>
				<span class="sep">/</span>
				<span>Nicole MotorCars Co., Ltd.</span>
				<span class="sep">/</span>
				<span>Nicole Competizione Co., Ltd.</span>
				<span class="sep">/</span>
				<span>Penske Automotive Group</span>
			</div>
		</div>

		<!-- ボトムバー：ポリシー ＆ コピーライト -->
		<div class="footer-bottom-row">
			<div class="footer-legal-links">
				<a href="https://www.nicole.co.jp/corporate/privacystatement/">プライバシー・ポリシー</a>
				<span class="legal-sep">/</span>
				<a href="https://www.nicole.co.jp/corporate/customer-policy/">お客さま本位の業務運営方針（FD宣言）</a>
			</div>
			<p class="footer-copyright">
				Copyright © Nicole Group. All Rights Reserved.
			</p>
		</div>
	</div>
</footer>

<style>
	/* ============================================================== */
	/* Nicole Global Footer スタイル */
	/* ============================================================== */
	.nicole-global-footer {
		background-color: #040507;
		color: #ffffff;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		padding: 80px 0 40px 0;
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", sans-serif;
		position: relative;
		z-index: 50;
	}

	.footer-container {
		width: 100%;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 40px;
	}

	/* フローティング問い合わせボタン */
	.floating-inquiry-wrap {
		position: fixed;
		bottom: 30px;
		right: 30px;
		z-index: 800;
	}

	.floating-inquiry-btn {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 13px 22px;
		background: #dfba73;
		color: #040507;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.05em;
		text-decoration: none;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 2px 10px rgba(223, 186, 115, 0.4);
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		backdrop-filter: blur(10px);
	}

	.floating-inquiry-btn:hover {
		background: #f0cb85;
		transform: translateY(-3px) scale(1.02);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7), 0 4px 16px rgba(223, 186, 115, 0.6);
	}

	.inquiry-icon {
		width: 18px;
		height: 18px;
	}

	/* 上部行 */
	.footer-top-row {
		display: grid;
		grid-template-columns: 360px 1fr;
		gap: 60px;
		padding-bottom: 60px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.footer-brand-lockup {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.footer-logo-link {
		text-decoration: none;
		color: inherit;
	}

	.footer-logo-text {
		font-family: 'Times New Roman', 'Didot', 'Playfair Display', serif;
		font-size: 26px;
		font-weight: 700;
		letter-spacing: 0.16em;
		background: linear-gradient(135deg, #ffffff 0%, #dfba73 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.footer-tagline {
		font-size: 13.5px;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.6);
		margin: 0;
	}

	/* ナビゲーション */
	.footer-nav-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 32px;
	}

	.nav-column {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.nav-heading {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.22em;
		color: #dfba73;
		margin: 0;
		text-transform: uppercase;
	}

	.nav-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.nav-list a {
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
		font-size: 13px;
		transition: color 0.25s ease, transform 0.25s ease;
		display: inline-block;
	}

	.nav-list a:hover {
		color: #dfba73;
		transform: translateX(3px);
	}

	/* 所属法人バー */
	.footer-affiliates-bar {
		padding: 30px 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.affiliates-label {
		font-size: 10px;
		font-weight: 800;
		letter-spacing: 0.2em;
		color: rgba(255, 255, 255, 0.4);
	}

	.affiliates-list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 10px;
		font-size: 12px;
		color: rgba(255, 255, 255, 0.6);
		letter-spacing: 0.05em;
	}

	.affiliates-list .sep {
		color: rgba(255, 255, 255, 0.2);
	}

	/* ボトム行 */
	.footer-bottom-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 30px;
		flex-wrap: wrap;
		gap: 20px;
		font-size: 12px;
		color: rgba(255, 255, 255, 0.5);
	}

	.footer-legal-links {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.footer-legal-links a {
		color: rgba(255, 255, 255, 0.55);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-legal-links a:hover {
		color: #dfba73;
	}

	.legal-sep {
		color: rgba(255, 255, 255, 0.2);
	}

	.footer-copyright {
		margin: 0;
		letter-spacing: 0.06em;
	}

	/* レスポンシブ */
	@media (max-width: 1024px) {
		.footer-top-row {
			grid-template-columns: 1fr;
			gap: 40px;
		}

		.footer-nav-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 30px;
		}
	}

	@media (max-width: 768px) {
		.footer-container {
			padding: 0 20px;
		}

		.nicole-global-footer {
			padding: 60px 0 30px 0;
		}

		.footer-nav-grid {
			grid-template-columns: 1fr;
			gap: 28px;
		}

		.footer-bottom-row {
			flex-direction: column;
			align-items: flex-start;
		}

		.floating-inquiry-wrap {
			bottom: 20px;
			right: 20px;
		}

		.floating-inquiry-btn {
			padding: 10px 18px;
			font-size: 12px;
		}
	}
</style>