---
// src/components/NicoleFooter.astro
const pathname = Astro.url.pathname.replace(/\/$/, "");
const isHome = pathname === "" || pathname === "/";

// 1. 取り扱いブランド（サブメニュー）
const brands = [
	{ name: "BMW", url: "https://nicole.bmw.jp/", external: true },
	{ name: "MINI", url: "https://www.mini-yokohama.com/", external: true },
	{ name: "Rolls-Royce", url: "https://www.rolls-roycemotorcars.com/yokohama/", external: true },
	{ name: "Ferrari", url: "https://yokohama.ferraridealers.com/", external: true },
	{ name: "ALPINA", period: "［1965-2025］", url: "https://nicole-automobiles.com/", external: true }
];

// 2. 企業情報（サブメニュー：拠点一覧とFD宣言は削除）
const corporateLinks = [
	{ title: "会社概要", url: "/corporate" },
	{ title: "グループ構成", url: "/corporate#structure" },
	{ title: "企業データ", url: "/corporate#corporatedata" },
	{ title: "企業理念", url: "/philosophy" },
	{ title: "ESG / SDGs活動", url: "/esg_sdgs" }
];
---

<footer class="nicole-footer" id="nicole-footer" role="contentinfo">
