					<style is:inline>
/* 余計な干渉を完全に防ぎ、動きの制御をJSに一本化する */
#float-btn {
    transition: none !important;
    will-change: transform;
}
</style>

<script is:inline>
window.addEventListener('DOMContentLoaded', function() {
    var floatBtn = document.getElementById('float-btn');
    var footer = document.querySelector('footer, .elementor-location-footer');
    
    if (!floatBtn || !footer) return;

    var targetY = 0;
    var currentY = 0;
    var isAnimating = false;

    // サスペンションのように動きを滑らかにする魔法の関数
    function updatePosition() {
        // 現在地から目的地（targetY）に向かって、毎フレーム15%ずつ進む（Lerp処理）
        currentY += (targetY - currentY) * 0.15; 
        
        // GPUを使って描画
        floatBtn.style.transform = 'translate3d(0, -' + currentY + 'px, 0)';

        // 目的地にほぼ到着するまでアニメーションを継続
        if (Math.abs(targetY - currentY) > 0.5) {
            window.requestAnimationFrame(updatePosition);
        } else {
            // 完全に到着したらピタッと止める
            floatBtn.style.transform = 'translate3d(0, -' + targetY + 'px, 0)';
            currentY = targetY;
            isAnimating = false;
        }
    }

    // スクロール時の判定
    window.addEventListener('scroll', function() {
        var footerTop = footer.getBoundingClientRect().top;
        var windowHeight = window.innerHeight;

        // フッターが見えたら目的地（上に逃げる距離）を設定
        if (footerTop < windowHeight) {
            targetY = windowHeight - footerTop;
        } else {
            targetY = 0; // 見えなくなったら元の位置を目的地に
        }

        // アニメーションが止まっていたら再始動
        if (!isAnimating) {
            isAnimating = true;
            window.requestAnimationFrame(updatePosition);
        }
    }, { passive: true });
});
</script>				</div>
