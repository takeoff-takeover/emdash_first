    if (p.startsWith('/ferrari/')) return 'ferrari';
    return 'nicole';
  }

  function normalizeTitle(title) {
    if (!title) return '';
    let t = String(title).trim();

    // 全角スペース→半角、連続スペース→1つ
    t = t.replace(/\u3000/g, ' ');
    t = t.replace(/\s+/g, ' ').trim();

    // 「 - TEST」削除
    t = t.replace(/\s*-\s*TEST\s*$/i, '');

    // SEOタイトルの後半を落とす（最初の " - " より後ろ）
    t = t.split(' - ')[0].trim();

    // 末尾のサイト名を落とす（残っている場合）
    t = t.replace(/\s*[｜|]\s*Nicole.*$/i, '').trim();

    // 先頭に「BMW 」が付くケースは外す（必要なら）
    t = t.replace(/^BMW\s+/, '');

    return t;
  }

  function getSourceTitle() {
    const h1 = document.querySelector('h1');
    if (h1 && h1.textContent) return normalizeTitle(h1.textContent);

    const og = document.querySelector('meta[property="og:title"]');
    if (og && og.content) return normalizeTitle(og.content);

    return normalizeTitle(document.title || '');
  }

  // ★クリックされた要素(.js-contact-link)から、実際のリンク(a)を特定してhrefを取る
  function getHrefFromElement(el) {
    if (!el) return '';

    // 自身がaならそれ
    if (el.tagName && el.tagName.toLowerCase() === 'a') {
      return el.getAttribute('href') || '';
    }

    // 自身にhref属性が付いてる場合（念のため）
    const ownHref = el.getAttribute && el.getAttribute('href');
    if (ownHref) return ownHref;

    // 子孫のaを探す（Elementorで外側にクラスが付くパターン対策）
    const innerA = el.querySelector ? el.querySelector('a[href]') : null;
    if (innerA) return innerA.getAttribute('href') || '';

    return '';
  }

  // ★ form_type を “絶対に落とさない”：
  // 1) data-form-type（外側でも内側aでもOK） 2) hrefのform_type 3) 現在URLのform_type 4) デフォルトinquiry
  function resolveFormType(el, clickedHref) {
    // data-form-type（外側）
    const dataTypeOuter = (el && el.getAttribute) ? (el.getAttribute('data-form-type') || '').trim() : '';
    if (dataTypeOuter) return dataTypeOuter;

    // data-form-type（内側a）
    const innerA = el && el.querySelector ? el.querySelector('a[data-form-type]') : null;
    if (innerA) {
      const dataTypeInner = (innerA.getAttribute('data-form-type') || '').trim();
      if (dataTypeInner) return dataTypeInner;
    }

    // hrefから読む
    try {
      const original = new URL(clickedHref || '', location.origin);
      const hrefType = original.searchParams.get('form_type');
      if (hrefType) return hrefType;
    } catch (e) {}

    // 現在URLから読む（contactページ直打ちのとき等）
    const pageType = new URLSearchParams(location.search).get('form_type');
    if (pageType) return pageType;

    return 'inquiry';
  }

  function buildContactUrl(clickedHref, el) {
    const brandSlug = detectBrand(location.pathname);
    const sourceTitle = getSourceTitle();

    const formType = resolveFormType(el, clickedHref);

    const to = new URL('/contact/', location.origin);
    to.searchParams.set('brand', brandSlug);

    // ★必ず付く
    if (formType) to.searchParams.set('form_type', formType);

    if (sourceTitle) to.searchParams.set('form_title', sourceTitle);

    // 保険：sessionStorageにも保存
    sessionStorage.setItem('ng_brand', brandSlug);
    if (sourceTitle) sessionStorage.setItem('ng_form_title', sourceTitle);

    return to.toString();
  }

  // ★イベント委譲：aでもdivでもbuttonでも拾う
  document.addEventListener('click', function (e) {
    const el = e.target && e.target.closest ? e.target.closest('.js-contact-link') : null;
    if (!el) return;

    // 新規タブ等は邪魔しない（実リンクがaの時だけ）
    const href = getHrefFromElement(el);
    let linkEl = null;
    if (el.tagName && el.tagName.toLowerCase() === 'a') linkEl = el;
    else if (el.querySelector) linkEl = el.querySelector('a[href]');

    if (linkEl && (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)) return;

    const nextUrl = buildContactUrl(href, el);

    console.log('Clicked href:', href);
    console.log('Resolved form_type:', new URL(nextUrl).searchParams.get('form_type'));
    console.log('Generated contact URL:', nextUrl);

    e.preventDefault();
    location.href = nextUrl;
  }, true);

  // ついでに「見た目のhref」も差し替え（aタグだけ）
  document.querySelectorAll('a.js-contact-link').forEach((a) => {
    const href = a.getAttribute('href') || '';
    a.href = buildContactUrl(href, a);
  });

})();
</script>
