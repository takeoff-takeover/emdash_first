					<script is:inline>
(function () {

  function detectBrand(pathname) {
    const p = (pathname || '').toLowerCase();
    if (p.startsWith('/bmw/')) return 'bmw';
    if (p.startsWith('/mini/')) return 'mini';
    if (p.startsWith('/rolls-royce/')) return 'rolls-royce';
