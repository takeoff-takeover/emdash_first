---
// src/components/NicoleHomeMain.astro
// ニコル・グループ公式 トップページ（シネマティック＆ミニマル・エディトリアル新デザイン）

import { getEmDashCollection } from "emdash";

// CMS（postsコレクション）から最新記事を取得（エラー時は安全にフォールバック）
let cmsPosts: any[] = [];
try {
	const result = await getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 12,
	});
	cmsPosts = result?.entries || [];
} catch (e) {
	console.warn("Could not fetch CMS posts for home page:", e);
}

// 静的アーカイブ記事データ（フォールバックおよびベース記事カタログ）
const fallbackInsights = [
	{
		id: "2027_new_bmw_3series_neue_klasse",
		slug: "2027_new_bmw_3series_neue_klasse",
		title: "【公式発表】新型BMW 3シリーズ登場。完全電動『BMW i3』と直6搭載『M350 xDrive』が切り拓く新時代",
		category: "BMW",
		date: "2026.10.22",
		readTime: "6 MIN READ",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg",
		lead: "次世代EVプラットフォーム『ノイエ・クラッセ』を初採用。歴代最高のドライビング・ダイナミクスと革新のデジタル・キャビン。",
		url: "/magazine/2027_new_bmw_3series_neue_klasse/"
	},
	{
		id: "202610_mini_united-japan-2026",
		slug: "202610_mini_united-japan-2026",
		title: "「BIG LOVE」があふれた一日。みんなで彩ったMINIと、大盛況のガチャ抽選会",
		category: "MINI",
		date: "2026.10.15",
		readTime: "4 MIN READ",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/10/DSC6593-1-scaled.jpg",
		lead: "全国のMINIオーナーが集い、笑顔と情熱を分かち合った特別なファンミーティングの模様をレポート。",
		url: "https://www.nicole.co.jp/magazine/202610_mini_united-japan-2026/"
	},
	{
		id: "202608_ferrari_luce",
		slug: "202608_ferrari_luce",
		title: "フェラーリ初のフル電動モデル「LUCE（ルーチェ）」日本上陸",
		category: "Ferrari",
		date: "2026.08.17",
		readTime: "5 MIN READ",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC4983-3.jpg",
		lead: "跳ね馬の血統を受け継ぐエレクトリック・スーパーカー。マラネッロの情熱が宿る未踏のパフォーマンス。",
		url: "https://www.nicole.co.jp/magazine/202608_ferrari_luce/"
	},
	{
		id: "202608_bmw_kids_mechanic",
		slug: "202608_bmw_kids_mechanic",
		title: "お給料も自分で稼ぐ。小学生が体験したBMWメカニックの特別な1日",
		category: "BMW",
		date: "2026.08.20",
		readTime: "4 MIN READ",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5134.jpg",
		lead: "未来のエンジニアたちへ。整備工場の本物のツールを使って自動車の構造と安全を学ぶNicole特別体験プログラム。",
		url: "/magazine/202608_bmw_kids_mechanic/"
	},
	{
		id: "20260714_mini_jcw_track_style_edition",
		slug: "20260714_mini_jcw_track_style_edition",
		title: "【各25台限定】日本未発売仕様を纏ったエレクトリック・モンスター。「MINI JCW Track Style Edition」登場",
		category: "MINI",
		date: "2026.07.14",
		readTime: "5 MIN READ",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/07/minijcwtrack-scaled.jpg",
		lead: "ゴーカート・フィーリングの極致。モータースポーツのDNAを濃縮した特別な限定車を全国独占デリバリー。",
		url: "https://www.nicole.co.jp/magazine/20260714_mini_jcw_track_style_edition/"
	},
	{
		id: "20260707_ferrari_challenge_invitation",
		slug: "20260707_ferrari_challenge_invitation",
		title: "跳ね馬の本能を呼び覚ます。フェラーリ・チャレンジへの招待",
		category: "Ferrari",
		date: "2026.07.07",
		readTime: "4 MIN READ",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/07/DSC7756.jpg",
		lead: "サーキットを疾走する純粋な興奮。オーナー限定ワンメイクレースシリーズの世界へ。",
		url: "https://www.nicole.co.jp/magazine/20260707_ferrari_challenge_invitation/"
	},
	{
		id: "202607_new_bmw_x5",
		slug: "202607_new_bmw_x5",
		title: "新たなデザイン言語と5つの動力。第5世代、New BMW X5 誕生",
		category: "BMW",
		date: "2026.07.01",
		readTime: "5 MIN READ",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/07/DSC6630.jpg",
		lead: "プレミアムSUVのパイオニアが劇的な進化。新世代オペレーティングシステムと極上の快適性。",
		url: "https://www.nicole.co.jp/magazine/202607_new_bmw_x5/"
	},
	{
		id: "alpina-heritage-story",
		slug: "alpina-heritage-story",
		title: "アルピナとともに歩んだ半世紀。ニコル・オートモビルズが受け継ぐクラフトマンシップの真価",
		category: "ALPINA",
		date: "2026.05.15",
		readTime: "7 MIN READ",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/07/DSC7756.jpg",
		lead: "1965年から2025年まで、日本総輸入元としてアルピナの魅力を伝え続けてきた歴史と、未来へ受け継ぐメンテナンス体制。",
		url: "https://nicole-automobiles.com/"
	},
	{
		id: "rolls-royce-bespoke-world",
		slug: "rolls-royce-bespoke-world",
		title: "唯一無二を仕立てる。ロールス・ロイス・ビスポークの世界と横浜ショールームの誇り",
		category: "Rolls-Royce",
		date: "2026.04.28",
		readTime: "6 MIN READ",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/01/大田支店.jpg",
		lead: "4万4000色以上のパレットと無限の素材。オーナーの夢を形にするロールス・ロイスの最高峰クラフト。",
		url: "https://www.nicole.co.jp/corporate/nicole-motorcars/"
	}
];

// CMS記事をBMW Group Insights形式に整形
const formattedCmsArticles = (cmsPosts || []).map((p: any) => {
	const featImg = p.data?.featured_image;
	const imgUrl = typeof featImg === "object" && featImg !== null && "src" in featImg
		? featImg.src
		: (typeof featImg === "string" && featImg ? featImg : "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg");

	const contentStr = typeof p.data?.content === "string" ? p.data.content : JSON.stringify(p.data?.content || "");
	const readMinutes = Math.max(3, Math.min(12, Math.ceil(contentStr.length / 350)));
	const readTime = `${readMinutes} MIN READ`;

	const pubDate = p.data?.published_at 
		? new Date(p.data.published_at).toISOString().slice(0, 10).replace(/-/g, '.')
		: "2026.10.25";

	const brand = p.data?.related_location ? "BMW" : (p.data?.category || "INSIGHTS");

	return {
		id: p.id || p.data?.id,
		slug: p.id,
		title: p.data?.title || "Nicole Group Insights",
		category: brand,
		date: pubDate,
		readTime,
		image: imgUrl,
		lead: p.data?.excerpt || "",
		url: `/magazine/${p.id}/`
	};
});

// CMS記事を最優先し、フォールバック記事とマージ（重複除外）
const allInsights = [
	...formattedCmsArticles,
	...fallbackInsights.filter(fb => !formattedCmsArticles.some(c => c.id === fb.id || c.slug === fb.slug))
];

// スタッフストーリー・コラム
const stories = [
	{
		quote: "「お客様がステアリングを握った瞬間、日常が特別な旅へと変わる。その感動の立ち会いに妥協はありません。」",
		name: "熟練マイスター",
		role: "BMW テクニカルディレクター（勤続20年）",
		title: "BMW一筋20年。熟練マイスターのプライドと素顔",
		url: "/magazine/"
	},
	{
		quote: "「EVへの不安を『確信とワクワク』へ。航続距離や充電ライフの疑問に、実体験に基づき徹底的に寄り添います。」",
		name: "シニアコンサルタント",
		role: "MINI EV スペシャリスト（全国販売1位）",
		title: "燃料代は5分の1に。不安を「納得」へと変えるメソッド",
		url: "/magazine/"
	},
	{
		quote: "「フェラーリを所有することは、美学と情熱のコミュニティの一員になること。最高峰のクラブライフをプロデュースします。」",
		name: "ブランドアンバサダー",
		role: "Nicole Competizione マーケティング",
		title: "フェラーリスタの心を揺さぶる体験。その世界観を支える視点",
		url: "/magazine/"
	}
];

// ブランド定義
const brands = [
	{
		name: "ALPINA",
		corp: "Nicole Automobiles",
		logo: "/brands/alpina.png",
		desc: "名門BMWアルピナの日本総輸入元として培った半世紀の情熱と哲学。",
		url: "https://nicole-automobiles.com/",
		accent: "#00441b"
	},
	{
		name: "BMW",
		corp: "Nicole Cars",
		logo: "/brands/bmw.svg",
		desc: "歓びの純度を高める駆けぬける歓び。最新電動モデルからMハイパフォーマンスまで。",
		url: "https://www.nicole.co.jp/bmw/",
		accent: "#0066b1"
	},
	{
		name: "MINI",
		corp: "Nicole Cars",
		logo: "/brands/mini.svg",
		desc: "時代を切り拓くアイコニックデザインと心躍るゴーカート・フィーリング。",
		url: "https://www.nicole.co.jp/mini/",
		accent: "#e5e5e5"
	},
	{
		name: "Rolls-Royce",
		corp: "Nicole MotorCars",
		logo: "/brands/rolls-royce.svg",
		desc: "静寂と極限の美。ビスポークが紡ぎ出す、世界にただひとつの至高の移動空間。",
		url: "https://www.nicole.co.jp/corporate/nicole-motorcars/",
		accent: "#8b6cb3"
	},
	{
		name: "Ferrari",
		corp: "Nicole Competizione",
		logo: "/brands/ferrari.svg",
		desc: "サーキットの情熱とイタリアの魂。マラネッロの真価を横浜から全国へ届ける。",
		url: "https://yokohama.ferraridealers.com/ja-JP",
		accent: "#cc0000"
	}
];

// 最新インフォメーション
const newsList = [
	{
		date: "2026.07.31",
		category: "NOTICE",
		title: "ニコル・グループ 2026年 夏季休業のお知らせ",
		url: "https://www.nicole.co.jp/%e3%83%8b%e3%82%b3%e3%83%ab%e3%83%bb%e3%82%b0%e3%83%ab%e3%83%bc%e3%83%97-2026%e5%b9%b4-%e5%a4%8f%e5%ad%a3%e4%bc%91%e6%a5%ad%e3%81%ae%e3%81%8a%e7%9f%a5%e3%82%89%e3%81%9b/"
	},
	{
		date: "2026.04.30",
		category: "COMMUNITY",
		title: "新百合ヶ丘エリアマネジメントコンソーシアムの会員へ加入",
		url: "https://www.nicole.co.jp/202604_inspire_hub_shinyuri/"
	},
	{
		date: "2026.02.27",
		category: "CSR / ESG",
		title: "災害時帰宅支援ステーションの協定締結について",
		url: "https://www.nicole.co.jp/202605_emergency-home-support/"
	},
	{
		date: "2025.12.22",
		category: "SHOWROOM",
		title: "ニコル世田谷・青山ショールーム定休日変更のご案内",
		url: "https://www.nicole.co.jp/202512_setagaya_aoyama_closedday/"
	},
	{
		date: "2025.12.22",
		category: "CORPORATE",
		title: "ニコル・オートモビルズ、ドメインおよびSNSアカウント名変更のお知らせ",
		url: "https://www.nicole.co.jp/202512_web_sns_account_change/"
	}
];
---

<main id="main" class="nicole-editorial-main">
	<!-- ============================================================== -->
	<!-- 1. シネマティック・ヒーローセクション（スクロール連動フレーム） -->
	<!-- ============================================================== -->
	<section class="cinematic-hero" id="hero-section">
		<div class="cinematic-hero__viewport" id="hero-viewport">
			<!-- 背景動画レイヤー（YouTube埋め込み） -->
			<div class="cinematic-hero__video-wrapper">
				<iframe 
					src="https://www.youtube-nocookie.com/embed/1Z0CddMzQBM?autoplay=1&mute=1&controls=0&loop=1&playlist=1Z0CddMzQBM&showinfo=0&rel=0&playsinline=1" 
					title="Nicole Group Official Video"
					class="cinematic-hero__video" 
					allow="autoplay; encrypted-media"
				></iframe>
				<div class="cinematic-hero__overlay"></div>
			</div>

			<!-- エディトリアル・タイポグラフィ（静謐な浮遊感） -->
			<div class="cinematic-hero__content">
				<div class="hero-badge editorial-reveal" data-delay="100">
					<span class="hero-badge__dot"></span>
					<span class="hero-badge__text">NICOLE GROUP 1977 — PRESENT</span>
				</div>

				<h1 class="hero-title editorial-reveal" data-delay="300">
					<span class="hero-title__en">BEYOND</span>
					<span class="hero-title__en hero-title__en--sub">EXPECTATIONS</span>
				</h1>

				<div class="hero-tagline editorial-reveal" data-delay="500">
					<span class="hero-tagline__rule"></span>
					<p class="hero-tagline__text">期待を超える喜びを</p>
				</div>
			</div>

			<!-- スクロールダウンインジケーター（繊細な極細ライン） -->
			<a href="#magazine-section" class="hero-scroll-indicator" aria-label="Scroll to Content">
				<span class="hero-scroll-indicator__label">SCROLL</span>
				<div class="hero-scroll-indicator__line">
					<span class="hero-scroll-indicator__runner"></span>
				</div>
			</a>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 2. エディトリアル・ステートメント（理念・マニフェスト） -->
	<!-- ============================================================== -->
	<section class="editorial-statement">
		<div class="editorial-container">
			<div class="statement-grid">
				<div class="statement-col statement-col--label editorial-reveal">
					<span class="editorial-num">01</span>
					<h2 class="editorial-subheading">PHILOSOPHY</h2>
				</div>
				<div class="statement-col statement-col--body">
					<p class="statement-lead editorial-reveal" data-delay="200">
						最高の自動車を通じて、<br class="hidden-sp" />
						一人ひとりのお客様に最上級の歓びと感動を。
					</p>
					<div class="editorial-rule editorial-line"></div>
					<p class="statement-desc editorial-reveal" data-delay="300">
						1977年の設立以来、東京・神奈川エリアを中心にBMW、MINI、ロールス・ロイス、フェラーリの正規ディーラーとして歩み続けてきたニコル・グループ。半世紀に及ぶアルピナ総輸入元の歴史とクラフトマンシップを受け継ぎ、「One Nicole」の精神で、時代を超えて愛されるカーライフを提案いたします。
					</p>
					<div class="statement-meta editorial-reveal" data-delay="400">
						<a href="/pages/corporate" class="editorial-link-btn">
							会社案内・企業理念を見る
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-svg"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 3. 特集マガジン：The latest Nicole Group Insights.（BMW Group Insights スタイル） -->
	<!-- ============================================================== -->
	<section class="bmw-insights-section" id="magazine-section" aria-label="The latest Nicole Group Insights">
		<div class="bmw-insights-container">
			<!-- セクションヘッダー：BMW Group Insightsレイアウト（左右余白にフィット） -->
			<div class="bmw-insights-header">
				<div class="bmw-insights-header__title-group editorial-reveal">
					<div class="bmw-insights-header__meta">
						<span class="editorial-num">02</span>
						<span class="bmw-insights-eyebrow">NICOLE CONNECT • WEB MAGAZINE</span>
					</div>
					<h2 class="bmw-insights-title">The latest Nicole Group Insights.</h2>
					<p class="bmw-insights-subtitle">
						最新モデルの試乗レポートから、オーナー様との対話、熟練メカニックのクラフトマンシップまで。
					</p>
				</div>
				<div class="bmw-insights-header__actions editorial-reveal" data-delay="150">
					<a href="/magazine/" class="bmw-insights-cta">
						<span>Discover all insights</span>
						<span class="bmw-insights-cta__icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow-svg">
								<path d="M5 12h14M12 5l7 7-7 7"/>
							</svg>
						</span>
					</a>
					<div class="bmw-insights-nav">
						<button type="button" class="insights-nav-btn insights-nav-btn--prev" id="insights-prev-btn" aria-label="Previous article" disabled>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
						</button>
						<button type="button" class="insights-nav-btn insights-nav-btn--next" id="insights-next-btn" aria-label="Next article">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
						</button>
					</div>
				</div>
			</div>
		</div>

		<!-- カルーセル / スライダーコンテナ：左右いっぱいに広がるエッジ・トゥ・エッジ・スライダー -->
		<div class="bmw-insights-slider-wrapper">
			<div class="bmw-insights-slider" id="insights-slider" tabindex="0" role="region" aria-label="Insights Carousel">
				{allInsights.map((item, idx) => (
					<article class="bmw-insight-card editorial-reveal" data-delay={(idx % 6) * 80}>
						<a href={item.url} class="bmw-insight-card__link">
							<!-- メディアエリア：大判16:10 アスペクト比 ＆ 右下丸型アクションボタン -->
							<div class="bmw-insight-card__media">
								<img 
									src={item.image} 
									alt={item.title} 
									loading={idx < 3 ? "eager" : "lazy"} 
									class="bmw-insight-card__img" 
								/>
								<div class="bmw-insight-card__overlay"></div>
								<div class="bmw-insight-card__badge" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="card-arrow-svg">
										<path d="M5 12h14M12 5l7 7-7 7"/>
									</svg>
								</div>
							</div>

							<!-- メタオーバーライン：[CATEGORY] • [DATE] • [READING TIME] -->
							<div class="bmw-insight-card__overline">
								<span class="insight-overline__cat">{item.category}</span>
								<span class="insight-overline__dot">•</span>
								<time class="insight-overline__date">{item.date}</time>
								<span class="insight-overline__dot">•</span>
								<span class="insight-overline__read">{item.readTime}</span>
							</div>

							<!-- ヘッドライン（タイトル） -->
							<h3 class="bmw-insight-card__title">{item.title}</h3>

							<!-- リード文（抜粋） -->
							{item.lead && (
								<p class="bmw-insight-card__lead">{item.lead}</p>
							)}
						</a>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 4. 職人・スタッフストーリー（エディトリアル・クオート） -->
	<!-- ============================================================== -->
	<section class="editorial-stories">
		<div class="editorial-container">
			<div class="stories-header editorial-reveal">
				<span class="editorial-num">03</span>
				<span class="editorial-eyebrow">PEOPLE & PASSION</span>
