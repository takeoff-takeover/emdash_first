<!-- モーション制御スクリプト（IntersectionObserver & スライダー操作） -->
<!-- ============================================================== -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		// 1. スクロール監視による要素の順次フェードイン
		const reveals = document.querySelectorAll('.editorial-reveal');
		const observerOptions = {
			root: null,
			rootMargin: '0px 0px -60px 0px',
			threshold: 0.1
		};

		const revealObserver = new IntersectionObserver((entries, observer) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					const el = entry.target;
					const delay = el.getAttribute('data-delay') || 0;
					setTimeout(() => {
						el.classList.add('is-visible');
					}, delay);
					observer.unobserve(el);
				}
			});
		}, observerOptions);

		reveals.forEach(el => revealObserver.observe(el));

		// ブランドカードのスタッガード出現
		const brandItems = document.querySelectorAll(".brand-reveal-item");
		const brandObserver = new IntersectionObserver((entries, observer) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					const el = entry.target;
					const delay = el.getAttribute("data-delay") || 0;
					setTimeout(() => {
						el.classList.add("is-visible");
					}, delay);
					observer.unobserve(el);
				}
			});
		}, { root: null, rootMargin: "0px 0px -40px 0px", threshold: 0.15 });
		brandItems.forEach(el => brandObserver.observe(el));

		// 2. ヒーローセクションは常にフル幅を維持（縮小処理なし）

		// 3. The latest Nicole Group Insights スライダー（ボタンなし・スムーズスクロール）
		const slider = document.getElementById('insights-slider');
		if (slider) {
			// マウスホイールやタッチによる快適なネイティブスワイプスクロール
		}

		// 4. バナー画像のスクロール連動ズーム（枠サイズ維持・内部画像のみ拡大）
		const zoomWrappers = document.querySelectorAll('.nicole-banner-img-wrap');
		if (zoomWrappers.length > 0) {
			let zoomTicking = false;
			const handleScrollZoom = () => {
				const winHeight = window.innerHeight;
				zoomWrappers.forEach(wrap => {
					const rect = wrap.getBoundingClientRect();
					if (rect.bottom > 0 && rect.top < winHeight) {
						// 画面に入ってから出るまでの進行度 (0.0 〜 1.0)
						const totalRange = winHeight + rect.height;
						const currentProgress = (winHeight - rect.top) / totalRange;
						const progress = Math.max(0, Math.min(1, currentProgress));
						// 1.0から最大1.16まで滑らかに拡大
						const scale = 1.0 + progress * 0.16;
						const targetImg = wrap.querySelector('.nicole-scroll-zoom-img');
						if (targetImg) {
							targetImg.style.transform = `scale(${scale.toFixed(4)})`;
						}
					}
				});
				zoomTicking = false;
			};

			window.addEventListener('scroll', () => {
				if (!zoomTicking) {
					window.requestAnimationFrame(handleScrollZoom);
					zoomTicking = true;
				}
			}, { passive: true });
			handleScrollZoom();
		}
	});
</script>

