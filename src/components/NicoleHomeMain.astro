		url: "/magazine/"
	},
	{
		title: "2026年版 MINI全モデルの選び方｜3ドア・5ドア・エースマン・カントリーマンの違い",
		category: "MINI",
		date: "2026.06.10",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/06/mini_lineup_2026.jpg",
		url: "/magazine/"
	}
];

// スタッフストーリー・コラム
const stories = [
	{
		quote: "「お客様がステアリングを握った瞬間、日常が特別な旅へと変わる。その感動の立ち会いに妥協はありません。」",
		name: "熟練マイスター",
		role: "BMW テクニカルディレクター（勤続20年）",
		title: "BMW一筋20年。熟練マイスターのプライドと素顔",
		url: "/magazine/"
	},
	{
		quote: "「EVへの不安を『確信とワクワク』へ。航続距離や充電ライフの疑問に、実体験に基づき徹底的に寄り添います。」",
		name: "シニアコンサルタント",
		role: "MINI EV スペシャリスト（全国販売1位）",
		title: "燃料代は5分の1に。不安を「納得」へと変えるメソッド",
		url: "/magazine/"
	},
	{
		quote: "「フェラーリを所有することは、美学と情熱のコミュニティの一員になること。最高峰のクラブライフをプロデュースします。」",
		name: "ブランドアンバサダー",
		role: "Nicole Competizione マーケティング",
		title: "フェラーリスタの心を揺さぶる体験。その世界観を支える視点",
		url: "/magazine/"
	}
];

// ブランド定義
const brands = [
	{
		name: "ALPINA",
		corp: "Nicole Automobiles",
		years: "［1965-2025］",
		desc: "名門BMWアルピナの日本総輸入元として培った半世紀の情熱と哲学。",
		url: "https://nicole-automobiles.com/",
		accent: "#00441b",
		badge: "LEGACY & CRAFT"
	},
	{
		name: "BMW",
		corp: "Nicole Cars",
		years: "正規ディーラー",
		desc: "歓びの純度を高める駆けぬける歓び。最新電動モデルからMハイパフォーマンスまで。",
		url: "https://www.nicole.co.jp/bmw/",
		accent: "#0066b1",
		badge: "SHEER DRIVING PLEASURE"
	},
	{
		name: "MINI",
		corp: "Nicole Cars",
		years: "正規ディーラー",
		desc: "時代を切り拓くアイコニックデザインと心躍るゴーカート・フィーリング。",
		url: "https://www.nicole.co.jp/mini/",
		accent: "#18181b",
		badge: "BIG LOVE"
	},
	{
		name: "Rolls-Royce",
		corp: "Nicole MotorCars",
		years: "正規ディーラー",
		desc: "静寂と極限の美。ビスポークが紡ぎ出す、世界にただひとつの至高の移動空間。",
		url: "https://www.nicole.co.jp/corporate/nicole-motorcars/",
		accent: "#2d1c3a",
		badge: "INSPIRING GREATNESS"
	},
	{
		name: "Ferrari",
		corp: "Nicole Competizione",
		years: "正規ディーラー",
		desc: "サーキットの情熱とイタリアの魂。マラネッロの真価を横浜から全国へ届ける。",
		url: "https://yokohama.ferraridealers.com/ja-JP",
		accent: "#cc0000",
		badge: "ESSENCE OF RACING"
	}
];

// 最新インフォメーション
const newsList = [
	{
		date: "2026.07.31",
		category: "NOTICE",
		title: "ニコル・グループ 2026年 夏季休業のお知らせ",
		url: "https://www.nicole.co.jp/%e3%83%8b%e3%82%b3%e3%83%ab%e3%83%bb%e3%82%b0%e3%83%ab%e3%83%bc%e3%83%97-2026%e5%b9%b4-%e5%a4%8f%e5%ad%a3%e4%bc%91%e6%a5%ad%e3%81%ae%e3%81%8a%e7%9f%a5%e3%82%89%e3%81%9b/"
	},
	{
		date: "2026.04.30",
		category: "COMMUNITY",
		title: "新百合ヶ丘エリアマネジメントコンソーシアムの会員へ加入",
		url: "https://www.nicole.co.jp/202604_inspire_hub_shinyuri/"
	},
	{
		date: "2026.02.27",
		category: "CSR / ESG",
		title: "災害時帰宅支援ステーションの協定締結について",
		url: "https://www.nicole.co.jp/202605_emergency-home-support/"
	},
	{
		date: "2025.12.22",
		category: "SHOWROOM",
		title: "ニコル世田谷・青山ショールーム定休日変更のご案内",
		url: "https://www.nicole.co.jp/202512_setagaya_aoyama_closedday/"
	},
	{
		date: "2025.12.22",
		category: "CORPORATE",
		title: "ニコル・オートモビルズ、ドメインおよびSNSアカウント名変更のお知らせ",
		url: "https://www.nicole.co.jp/202512_web_sns_account_change/"
	}
];
---

<main id="main" class="nicole-editorial-main">
	<!-- ============================================================== -->
	<!-- 1. シネマティック・ヒーローセクション（スクロール連動フレーム） -->
	<!-- ============================================================== -->
	<section class="cinematic-hero" id="hero-section">
		<div class="cinematic-hero__viewport" id="hero-viewport">
			<!-- 背景動画レイヤー（YouTube埋め込み） -->
			<div class="cinematic-hero__video-wrapper">
				<iframe 
					src="https://www.youtube-nocookie.com/embed/1Z0CddMzQBM?autoplay=1&mute=1&controls=0&loop=1&playlist=1Z0CddMzQBM&showinfo=0&rel=0&playsinline=1" 
					title="Nicole Group Official Video"
					class="cinematic-hero__video" 
					allow="autoplay; encrypted-media"
				></iframe>
				<div class="cinematic-hero__overlay"></div>
			</div>

			<!-- エディトリアル・タイポグラフィ（静謐な浮遊感） -->
			<div class="cinematic-hero__content">
				<div class="hero-badge editorial-reveal" data-delay="100">
					<span class="hero-badge__dot"></span>
					<span class="hero-badge__text">NICOLE GROUP 1977 — PRESENT</span>
				</div>

				<h1 class="hero-title editorial-reveal" data-delay="300">
					<span class="hero-title__en">BEYOND</span>
					<span class="hero-title__en hero-title__en--sub">EXPECTATIONS</span>
				</h1>

				<div class="hero-tagline editorial-reveal" data-delay="500">
					<span class="hero-tagline__rule"></span>
					<p class="hero-tagline__text">期待を超える喜びを</p>
				</div>
			</div>

			<!-- スクロールダウンインジケーター（繊細な極細ライン） -->
			<a href="#magazine-section" class="hero-scroll-indicator" aria-label="Scroll to Content">
				<span class="hero-scroll-indicator__label">SCROLL</span>
				<div class="hero-scroll-indicator__line">
					<span class="hero-scroll-indicator__runner"></span>
				</div>
			</a>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 2. エディトリアル・ステートメント（理念・マニフェスト） -->
	<!-- ============================================================== -->
	<section class="editorial-statement">
		<div class="editorial-container">
			<div class="statement-grid">
				<div class="statement-col statement-col--label editorial-reveal">
					<span class="editorial-num">01</span>
					<h2 class="editorial-subheading">PHILOSOPHY</h2>
				</div>
				<div class="statement-col statement-col--body">
					<p class="statement-lead editorial-reveal" data-delay="200">
						最高の自動車を通じて、<br class="hidden-sp" />
						一人ひとりのお客様に最上級の歓びと感動を。
					</p>
					<div class="editorial-rule editorial-line"></div>
					<p class="statement-desc editorial-reveal" data-delay="300">
						1977年の設立以来、東京・神奈川エリアを中心にBMW、MINI、ロールス・ロイス、フェラーリの正規ディーラーとして歩み続けてきたニコル・グループ。半世紀に及ぶアルピナ総輸入元の歴史とクラフトマンシップを受け継ぎ、「One Nicole」の精神で、時代を超えて愛されるカーライフを提案いたします。
					</p>
					<div class="statement-meta editorial-reveal" data-delay="400">
						<a href="/pages/corporate" class="editorial-link-btn">
							会社案内・企業理念を見る
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-svg"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
						</a>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 3. 特集マガジン（エディトリアル・大判カード＆グリッド） -->
	<!-- ============================================================== -->
	<section class="editorial-magazine" id="magazine-section">
		<div class="editorial-container">
			<!-- セクションヘッダー -->
			<div class="editorial-header">
				<div class="editorial-header__left editorial-reveal">
					<span class="editorial-num">02</span>
					<span class="editorial-eyebrow">FEATURED STORIES</span>
					<h2 class="editorial-title">MAGAZINE</h2>
				</div>
				<div class="editorial-header__right editorial-reveal" data-delay="200">
					<p class="editorial-header__desc">
						最新モデルのインプレッションから、オーナー様との対話、メカニックの舞台裏まで。ニコルならではの視点で綴るエディトリアル。
					</p>
					<a href="/magazine/" class="editorial-link-btn">
						すべての記事を見る
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-svg"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
				</div>
			</div>

			<!-- メイン特集（大判フィーチャーグリッド） -->
			<div class="magazine-lead-grid">
				{featuredMagazines.map((item, idx) => (
					<article class={`mag-card mag-card--${idx === 0 ? 'lead' : 'item'} editorial-reveal`} data-delay={idx * 150}>
						<a href={item.url} class="mag-card__link">
							<div class="mag-card__media">
								<img 
									src={item.image} 
									alt={item.title} 
									loading={idx === 0 ? "eager" : "lazy"} 
									class="mag-card__img img-slow-zoom" 
								/>
								<div class="mag-card__gradient"></div>
								<span class="mag-card__category">{item.category}</span>
							</div>
							<div class="mag-card__content">
								<div class="mag-card__meta">
									<time class="mag-card__date">{item.date}</time>
									<span class="mag-card__meta-divider">/</span>
									<span class="mag-card__views">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="eye-icon"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
										{item.views}
									</span>
								</div>
								<h3 class="mag-card__title">{item.title}</h3>
								{item.lead && (
									<p class="mag-card__lead">{item.lead}</p>
								)}
								<div class="mag-card__readmore">
									<span>READ ARTICLE</span>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-svg"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
								</div>
							</div>
						</a>
					</article>
				))}
			</div>

			<!-- サブ特集のミニマルリストグリッド -->
			<div class="sub-magazine-grid">
				{subMagazines.map((sub, idx) => (
					<article class="sub-mag-card editorial-reveal" data-delay={idx * 100}>
						<a href={sub.url} class="sub-mag-card__link">
							<div class="sub-mag-card__media">
								<img src={sub.image} alt={sub.title} loading="lazy" class="sub-mag-card__img img-slow-zoom" />
							</div>
							<div class="sub-mag-card__body">
								<div class="sub-mag-card__meta">
									<span class="sub-mag-card__tag">{sub.category}</span>
									<time class="sub-mag-card__date">{sub.date}</time>
								</div>
								<h4 class="sub-mag-card__title">{sub.title}</h4>
								<span class="sub-mag-card__arrow">→</span>
							</div>
						</a>
					</article>
				))}
			</div>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 4. 職人・スタッフストーリー（エディトリアル・クオート） -->
	<!-- ============================================================== -->
	<section class="editorial-stories">
		<div class="editorial-container">
			<div class="stories-header editorial-reveal">
				<span class="editorial-num">03</span>
				<span class="editorial-eyebrow">PEOPLE & PASSION</span>
				<h2 class="editorial-title">CRAFTSMANSHIP</h2>
			</div>

			<div class="stories-grid">
				{stories.map((story, idx) => (
					<div class="story-item editorial-reveal" data-delay={idx * 150}>
						<div class="story-item__line editorial-line"></div>
						<p class="story-item__quote">{story.quote}</p>
						<div class="story-item__footer">
							<div class="story-item__person">
								<h4 class="story-item__role">{story.role}</h4>
								<span class="story-item__name">{story.name}</span>
							</div>
							<a href={story.url} class="story-item__link">インタビューを読む →</a>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 5. OUR BRANDS（5大ブランド・ショーケース） -->
	<!-- ============================================================== -->
	<section class="editorial-brands" id="brands-section">
		<div class="editorial-container">
			<div class="editorial-header">
				<div class="editorial-header__left editorial-reveal">
					<span class="editorial-num">04</span>
					<span class="editorial-eyebrow">AUTHORISED DEALERSHIPS</span>
					<h2 class="editorial-title">OUR BRANDS</h2>
				</div>
				<div class="editorial-header__right editorial-reveal" data-delay="200">
					<p class="editorial-header__desc">
						世界最高峰のモビリティブランドを正規ディーラーとして展開。それぞれのブランドが持つ哲学とクラフトマンシップを完璧にお届けします。
					</p>
				</div>
			</div>

			<div class="brands-grid">
				{brands.map((b, idx) => (
					<div class="brand-panel editorial-reveal" data-delay={idx * 100} style={`--brand-accent: ${b.accent};`}>
						<a href={b.url} class="brand-panel__link" target={b.url.startsWith('http') ? "_blank" : "_self"} rel="noopener noreferrer">
							<div class="brand-panel__top">
								<span class="brand-panel__badge">{b.badge}</span>
								<span class="brand-panel__years">{b.years}</span>
							</div>

							<div class="brand-panel__body">
								<h3 class="brand-panel__name">{b.name}</h3>
								<h4 class="brand-panel__corp">{b.corp}</h4>
								<p class="brand-panel__desc">{b.desc}</p>
							</div>

							<div class="brand-panel__action">
								<span class="brand-panel__action-label">OFFICIAL SHOWROOM</span>
								<div class="brand-panel__action-circle">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
								</div>
							</div>
						</a>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 6. INFORMATION & TOPICS（最新ニュース・リスト） -->
	<!-- ============================================================== -->
	<section class="editorial-news">
		<div class="editorial-container">
			<div class="editorial-header">
				<div class="editorial-header__left editorial-reveal">
					<span class="editorial-num">05</span>
					<span class="editorial-eyebrow">LATEST ANNOUNCEMENTS</span>
					<h2 class="editorial-title">INFORMATION</h2>
				</div>
				<div class="editorial-header__right editorial-reveal" data-delay="200">
					<span class="editorial-tagline">Nicole Group Official News & Updates</span>
				</div>
			</div>

			<div class="news-list">
				{newsList.map((news, idx) => (
					<article class="news-row editorial-reveal" data-delay={idx * 80}>
						<div class="news-row__line editorial-line"></div>
						<a href={news.url} class="news-row__link" target={news.url.startsWith('http') ? "_blank" : "_self"} rel="noopener noreferrer">
							<div class="news-row__meta">
								<time class="news-row__date">{news.date}</time>
								<span class="news-row__cat">{news.category}</span>
							</div>
							<h3 class="news-row__title">{news.title}</h3>
							<div class="news-row__arrow">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							</div>
						</a>
					</article>
				))}
				<div class="news-row__line editorial-line"></div>
			</div>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 7. SHOWROOMS & LOCATIONS CTA（インタラクティブ拠点導線） -->
