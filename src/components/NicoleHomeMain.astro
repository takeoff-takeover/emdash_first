<!-- ============================================================== -->
<!-- モーション制御スクリプト（IntersectionObserver & スクロール連動） -->
<!-- ============================================================== -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		// 1. スクロール監視による要素の順次フェードイン（スタッガーアニメーション）
		const reveals = document.querySelectorAll('.editorial-reveal');
		const lines = document.querySelectorAll('.editorial-line');

		const observerOptions = {
			root: null,
			rootMargin: '0px 0px -80px 0px',
			threshold: 0.1
		};

		const revealObserver = new IntersectionObserver((entries, observer) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					const el = entry.target;
					const delay = el.getAttribute('data-delay') || 0;
					setTimeout(() => {
						el.classList.add('is-visible');
					}, delay);
					observer.unobserve(el);
				}
			});
		}, observerOptions);

		reveals.forEach(el => revealObserver.observe(el));

		// 2. ヘアラインの描画アニメーション監視
		const lineObserver = new IntersectionObserver((entries, observer) => {
			entries.forEach(entry => {
				if (entry.isIntersecting) {
					entry.target.classList.add('is-drawn');
					observer.unobserve(entry.target);
				}
			});
		}, { rootMargin: '0px 0px -40px 0px', threshold: 0.1 });

		lines.forEach(line => lineObserver.observe(line));

		// 3. ヒーローセクションのシネマティック・スクロール連動
		const heroSection = document.getElementById('hero-section');
		const heroViewport = document.getElementById('hero-viewport');

		if (heroSection && heroViewport && window.innerWidth > 768) {
			let ticking = false;

			window.addEventListener('scroll', () => {
				if (!ticking) {
					window.requestAnimationFrame(() => {
						const scrollY = window.scrollY;
						const heroHeight = heroSection.offsetHeight;

						if (scrollY <= heroHeight) {
							const progress = Math.min(scrollY / heroHeight, 1);
							// スクロールに伴い、インセット・角丸・スケールを滑らかに縮小
							const insetPad = progress * 24; // 0px -> 24px
							const radius = progress * 24;   // 0px -> 24px
							const scale = 1 - (progress * 0.04); // 1.0 -> 0.96

							heroViewport.style.transform = `scale(${scale})`;
							heroViewport.style.borderRadius = `${radius}px`;
							heroViewport.style.margin = `${insetPad}px`;
						}
						ticking = false;
					});
					ticking = true;
				}
			}, { passive: true });
		}

		// 4. The latest Nicole Group Insights スライダー（BMW Group TeaserSlider操作）
		const slider = document.getElementById('insights-slider');
		const prevBtn = document.getElementById('insights-prev-btn');
		const nextBtn = document.getElementById('insights-next-btn');

		if (slider && prevBtn && nextBtn) {
			const updateSliderNav = () => {
				const maxScroll = slider.scrollWidth - slider.clientWidth - 8;
				prevBtn.disabled = slider.scrollLeft <= 5;
				nextBtn.disabled = slider.scrollLeft >= maxScroll;
			};

			const getCardStep = () => {
				const firstCard = slider.querySelector('.bmw-insight-card');
				if (firstCard) {
					return firstCard.offsetWidth + 36; // card width + gap
				}
				return slider.clientWidth * 0.75;
			};

			prevBtn.addEventListener('click', () => {
				slider.scrollBy({ left: -getCardStep(), behavior: 'smooth' });
			});

			nextBtn.addEventListener('click', () => {
				slider.scrollBy({ left: getCardStep(), behavior: 'smooth' });
			});

			slider.addEventListener('scroll', updateSliderNav, { passive: true });
			window.addEventListener('resize', updateSliderNav, { passive: true });
			updateSliderNav();
		}
	});
</script>

