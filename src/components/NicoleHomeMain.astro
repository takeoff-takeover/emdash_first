					title="Nicole Group Official Video"
					class="cinematic-hero__video" 
					allow="autoplay; encrypted-media"
				></iframe>
				<div class="cinematic-hero__overlay"></div>
			</div>

			<a href="#magazine-section" class="hero-scroll-indicator" aria-label="Scroll to Content">
				<span class="hero-scroll-indicator__label">SCROLL</span>
				<div class="hero-scroll-indicator__line">
					<span class="hero-scroll-indicator__runner"></span>
				</div>
			</a>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 2. 特集マガジン：The latest Nicole Group Insights.（BMW Group Insights スタイル） -->
	<!-- ============================================================== -->
	<section class="bmw-insights-section" id="magazine-section" aria-label="The latest Nicole Group Insights">
		<div class="editorial-container">
			<div class="bmw-insights-header">
				<div class="bmw-insights-header__title-group editorial-reveal">
					
					<h2 class="bmw-insights-title">The latest Nicole Group Insights.</h2>
					<p class="bmw-insights-subtitle">
						最新モデルの試乗レポートから、オーナー様との対話、熟練メカニックのクラフトマンシップまで。
					</p>
				</div>
				<div class="bmw-insights-header__actions editorial-reveal" data-delay="150">
					<a href="/magazine/" class="bmw-insights-cta">
						<span>Discover all insights</span>
						<span class="bmw-insights-cta__icon">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow-svg">
								<path d="M5 12h14M12 5l7 7-7 7"/>
							</svg>
						</span>
					</a>
					
				</div>
			</div>

			<!-- カルーセル / スライダーコンテナ -->
			<div class="bmw-insights-slider-wrapper">
				<div class="bmw-insights-slider" id="insights-slider" tabindex="0" role="region" aria-label="Insights Carousel">
					{allInsights.map((item, idx) => (
						<article class="bmw-insight-card editorial-reveal" data-delay={(idx % 6) * 80}>
							<a href={item.url} class="bmw-insight-card__link">
								<div class="bmw-insight-card__media">
									<img 
										src={item.image} 
										alt={item.title} 
										loading={idx < 3 ? "eager" : "lazy"} 
										class="bmw-insight-card__img" 
									/>
									<div class="bmw-insight-card__overlay"></div>
									<div class="bmw-insight-card__badge" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="card-arrow-svg">
											<path d="M5 12h14M12 5l7 7-7 7"/>
										</svg>
									</div>
								</div>

								<div class="bmw-insight-card__overline">
									<span class="insight-overline__cat">{item.category}</span>
									<span class="insight-overline__dot">•</span>
									<time class="insight-overline__date">{item.date}</time>
									<span class="insight-overline__dot">•</span>
									<span class="insight-overline__read">{item.readTime}</span>
								</div>

								<h3 class="bmw-insight-card__title">{item.title}</h3>

								{item.lead && (
									<p class="bmw-insight-card__lead">{item.lead}</p>
								)}
							</a>
						</article>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- ============================================================== -->
	<!-- 3. フィロソフィー ＆ OUR BRAND（洗練されたモノトーン ＆ ロゴマーク単独反応） -->
	<!-- ============================================================== -->
	<section class="nicole-philosophy-brand-section" id="philosophy-brand-section">
		<div class="editorial-container">
			<!-- Part A: We Are NICOLE GROUP -->
			<div class="nicole-we-are editorial-reveal">
				<h2 class="nicole-we-are-title">We Are</h2>
				<h2 class="nicole-group-title">NICOLE GROUP</h2>
				
				<div class="nicole-we-are-body">
					<p>
						ニコル・グループは1977年の設立以来、東京および神奈川エリアにて、BMW、MINI、ロールス・ロイス、フェラーリを取り扱う正規ディーラーとして歩んでまいりました。また、2025年末まではアルピナの日本総輸入元として、全国のお客様に感動を提供してきた実績も、私たちの誇りです。
					</p>
					<p style="margin-top: 1.6em;">
						「One Nicole」を合言葉に、社会的責任を果たしながら、革新に挑み、常に高品質なサービスを追求し続けています。 これからも、皆さまの期待を超える喜びと、豊かなカーライフをお届けしてまいります。
					</p>
