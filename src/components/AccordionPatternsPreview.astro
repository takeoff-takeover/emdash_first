</section>

<style>
	/* 全体コンテナ */
	.accordion-patterns-section {
		margin: 4rem 0 3rem;
		padding: 2.5rem 0;
		border-top: 1px solid rgba(255, 255, 255, 0.15);
	}

	.patterns-intro-banner {
		margin-bottom: 2.5rem;
		padding: 1.75rem 2rem;
		background: #0d0d12;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-left: 3px solid #ffffff;
	}

	.patterns-badge {
		font-family: var(--font-mono, monospace);
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		color: #a1a1aa;
		text-transform: uppercase;
		margin-bottom: 0.5rem;
	}

	.patterns-title {
		font-family: var(--font-heading, inherit);
		font-size: 1.35rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 0.5rem;
		letter-spacing: -0.01em;
	}

	.patterns-desc {
		font-size: 0.875rem;
		color: #a1a1aa;
		line-height: 1.6;
		margin: 0;
	}

	/* パターン個別カード */
	.pattern-card {
		margin-bottom: 2.5rem;
		background: #070709;
		border: 1px solid rgba(255, 255, 255, 0.08);
		padding: 1.75rem;
	}

	.pattern-header {
		margin-bottom: 1.25rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.pattern-tag {
		display: inline-block;
		font-family: var(--font-mono, monospace);
		font-size: 0.6875rem;
		font-weight: 700;
		color: #000000;
		background: #ffffff;
		padding: 2px 8px;
		letter-spacing: 0.05em;
		margin-bottom: 0.5rem;
	}

	.pattern-name {
		font-size: 1.1rem;
		font-weight: 700;
		color: #ffffff;
		margin-bottom: 0.35rem;
	}

	.pattern-summary {
		font-size: 0.8125rem;
		color: #71717a;
		line-height: 1.5;
	}

	.acc-demo-wrap {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	/* 共通テーブルスタイル（アコーディオン内） */
	.acc-spec-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
		margin: 0;
	}

	.acc-spec-table tr {
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.acc-spec-table tr:last-child {
		border-bottom: none;
	}

	.acc-spec-table th {
		width: 32%;
		padding: 0.75rem 1rem 0.75rem 0;
		text-align: left;
		font-weight: 600;
		color: #a1a1aa;
		font-size: 0.8125rem;
		vertical-align: top;
	}

	.acc-spec-table td {
		padding: 0.75rem 0;
		color: #f4f4f5;
		line-height: 1.5;
	}

	/* --------------------------------------------------
	   パターン A：ミニマル・ヘアライン型
	   -------------------------------------------------- */
	.acc-pattern-a {
		background: transparent;
		border: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		transition: border-color 0.2s;
	}

	.acc-pattern-a:hover {
		border-color: rgba(255, 255, 255, 0.25);
	}

	.acc-pattern-a[open] {
		border-color: rgba(255, 255, 255, 0.35);
	}

	.acc-summary-a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.1rem 0;
		background: transparent;
		cursor: pointer;
		user-select: none;
		list-style: none;
	}

	.acc-summary-a::-webkit-details-marker {
		display: none;
	}

	.acc-title-a {
		font-size: 0.98rem;
		font-weight: 600;
		color: #ffffff;
		letter-spacing: -0.01em;
	}

	.acc-toggle-icon-a {
		display: flex;
		align-items: center;
		justify-content: center;
		color: #a1a1aa;
		width: 20px;
		height: 20px;
	}

	.acc-toggle-icon-a svg {
		width: 18px;
		height: 18px;
		stroke: currentColor;
	}

	.acc-pattern-a .icon-minus {
		display: none;
	}

	.acc-pattern-a[open] .icon-plus {
		display: none;
	}

	.acc-pattern-a[open] .icon-minus {
		display: block;
		color: #ffffff;
	}

	.acc-body-a {
		padding: 0.25rem 0 1.25rem;
