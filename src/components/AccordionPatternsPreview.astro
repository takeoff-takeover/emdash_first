		border: 1px solid rgba(255, 255, 255, 0.06);
	}

	.acc-pattern-b[open] .acc-badge-b {
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.2);
	}

	.acc-body-b {
		padding: 0 1.25rem 1.25rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		margin-top: 0;
		padding-top: 1rem;
	}

	.acc-text-b {
		font-size: 0.9rem;
		color: #a1a1aa;
		line-height: 1.7;
