		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.2s, background 0.2s;
	}

	.acc-chevron-b svg {
		width: 14px;
		height: 14px;
	}

	.acc-pattern-b[open] .acc-chevron-b {
		transform: rotate(180deg);
		background: #ffffff;
		color: #000000;
	}

	.acc-title-b {
		font-size: 0.96rem;
		font-weight: 600;
		color: #ffffff;
	}

	.acc-badge-b {
		font-family: var(--font-mono, monospace);
		font-size: 0.6875rem;
		color: #71717a;
		background: rgba(255, 255, 255, 0.04);
