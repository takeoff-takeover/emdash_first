---
/**
 * GoogleRatingBadge.astro
 * Googleクチコミ評価バッジ（星・評価点・件数）
 * モノトーン基調・Helveticaフォント・枠線なし
 */
interface Props {
	rating?: number | string | null;
	reviewsCount?: number | string | null;
	href?: string;
	title?: string;
	class?: string;
}

const {
	rating,
	reviewsCount,
	href,
	title = 'Google 口コミ評価',
	class: className = '',
} = Astro.props;

// 数値の整形
const numRating = typeof rating === 'number' ? rating : parseFloat(String(rating || ''));
const validRating = !isNaN(numRating) && numRating > 0 ? numRating.toFixed(1) : null;

const numCount = typeof reviewsCount === 'number' ? reviewsCount : parseInt(String(reviewsCount || ''), 10);
const validCount = !isNaN(numCount) && numCount > 0 ? numCount : null;

// 表示するかどうかの判定
const hasData = validRating !== null;
---

{hasData && (
	href ? (
		<a href={href} class={`google-rating-badge is-link ${className}`} title={title}>
			<svg class="g-icon" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
				<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
				<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
				<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
				<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
			</svg>
			<span class="star" aria-hidden="true">★</span>
			<span class="score">{validRating}</span>
			{validCount !== null && <span class="count">({validCount})</span>}
		</a>
	) : (
		<div class={`google-rating-badge ${className}`} title={title}>
			<svg class="g-icon" viewBox="0 0 24 24" width="13" height="13" aria-hidden="true">
				<path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
				<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
				<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
				<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
			</svg>
			<span class="star" aria-hidden="true">★</span>
			<span class="score">{validRating}</span>
			{validCount !== null && <span class="count">({validCount})</span>}
		</div>
	)
)}

<style>
	.google-rating-badge {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
		font-size: 12px;
		line-height: 1;
		color: #ffffff;
		background: transparent;
		border: none;
		padding: 2px 0;
		text-decoration: none;
		white-space: nowrap;
	}

	.google-rating-badge.is-link {
		cursor: pointer;
		transition: opacity 0.2s ease;
	}

	.google-rating-badge.is-link:hover {
		opacity: 0.8;
	}

	.g-icon {
		display: block;
		flex-shrink: 0;
	}

	.star {
		color: #f59e0b;
		font-size: 11px;
		line-height: 1;
	}

	.score {
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #ffffff;
	}

	.count {
		color: rgba(255, 255, 255, 0.6);
		font-size: 11px;
		font-weight: 400;
		margin-left: 1px;
	}
</style>
