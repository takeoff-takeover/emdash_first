---
// src/components/NicoleHeader.astro
// ニコル・グループ公式 グローバルナビゲーション（シネマティック＆ミニマル・エディトリアル新デザイン）

const brands = [
	{ 
		name: "BMW", 
		corp: "Nicole Cars", 
		badge: "正規ディーラー", 
		url: "https://www.nicole.co.jp/bmw/",
		desc: "駆けぬける歓びの真価を東京・神奈川からお届けする正規ディーラー"
	},
	{ 
		name: "MINI", 
		corp: "Nicole Cars", 
		badge: "正規ディーラー", 
		url: "https://www.nicole.co.jp/mini/",
		desc: "時代を切り拓くアイコニックデザインとゴーカート・フィーリング"
	},
	{ 
		name: "Rolls-Royce", 
		corp: "Nicole MotorCars", 
		badge: "正規ディーラー", 
		url: "https://www.nicole.co.jp/corporate/nicole-motorcars/",
		desc: "静寂と至高の美。ビスポークが紡ぎ出す世界唯一のラグジュアリー"
	},
	{ 
		name: "Ferrari", 
		corp: "Nicole Competizione", 
		badge: "正規ディーラー", 
		url: "https://yokohama.ferraridealers.com/ja-JP",
		desc: "跳ね馬の情熱とレーシングスピリットを横浜から体現"
	},
	{ 
		name: "ALPINA", 
		corp: "Nicole Automobiles", 
		badge: "1965-2025", 
		url: "https://nicole-automobiles.com/",
		desc: "半世紀にわたる総輸入元としての誇りと継承される哲学"
	}
];

const corporateLinks = [
	{ title: "会社概要", desc: "ニコル・グループの沿革と概要", url: "/pages/corporate" },
	{ title: "グループ構成", desc: "各正規ディーラー法人と組織構造", url: "https://www.nicole.co.jp/corporate/#structure" },
	{ title: "企業データ", desc: "資本金、拠点数、主要役員データ", url: "https://www.nicole.co.jp/corporate/#corporatedata" },
	{ title: "企業理念", desc: "One Nicole — 期待を超える喜びを", url: "/pages/philosophy" },
	{ title: "ESG / SDGs活動", desc: "地域社会への貢献とサステナビリティ", url: "https://www.nicole.co.jp/corporate/esg_sdgs/" }
];
---

<header id="nicole-site-header" class="nicole-header">
	<div class="header-container">
		<!-- ブランドロゴ -->
		<a href="/" class="header-logo" aria-label="Nicole Group Home">
			<img 
				src="https://www.nicole.co.jp/wp/wp-content/uploads/2026/01/Nicole_Group_LOGO_neg.svg" 
				alt="Nicole Group" 
				width="168" 
				height="28" 
				class="header-logo__img"
			/>
		</a>

		<!-- デスクトップ・ナビゲーション -->
		<nav class="desktop-nav" aria-label="グローバルメニュー">
			<ul class="nav-list">
				<!-- 1. BRANDS (メガドロップダウン) -->
				<li class="nav-item nav-item--has-dropdown" id="nav-item-brands">
					<button type="button" class="nav-link nav-link--btn" aria-expanded="false" aria-controls="dropdown-brands">
						<span>BRANDS</span>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="dropdown-chevron"><path d="m6 9 6 6 6-6"/></svg>
					</button>

					<!-- メガメニュー・ドロップダウン -->
					<div class="dropdown-menu dropdown-menu--brands" id="dropdown-brands">
						<div class="dropdown-inner">
							<div class="dropdown-header">
								<span class="dropdown-eyebrow">AUTHORISED DEALERSHIPS</span>
								<h3 class="dropdown-title">取り扱いブランド</h3>
							</div>
							<div class="brands-dropdown-grid">
								{brands.map((b) => (
									<a href={b.url} class="brand-dropdown-card" target={b.url.startsWith('http') ? "_blank" : "_self"} rel="noopener noreferrer">
										<div class="brand-dropdown-card__top">
											<span class="brand-dropdown-card__name">{b.name}</span>
											<span class="brand-dropdown-card__badge">{b.badge}</span>
										</div>
										<p class="brand-dropdown-card__corp">{b.corp}</p>
										<p class="brand-dropdown-card__desc">{b.desc}</p>
										<span class="brand-dropdown-card__arrow">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
										</span>
									</a>
								))}
							</div>
						</div>
					</div>
				</li>

				<!-- 2. CORPORATE (エディトリアル・ドロップダウン) -->
				<li class="nav-item nav-item--has-dropdown" id="nav-item-corporate">
					<button type="button" class="nav-link nav-link--btn" aria-expanded="false" aria-controls="dropdown-corporate">
						<span>CORPORATE</span>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="dropdown-chevron"><path d="m6 9 6 6 6-6"/></svg>
					</button>

					<div class="dropdown-menu dropdown-menu--corporate" id="dropdown-corporate">
						<div class="dropdown-inner">
							<div class="dropdown-header">
								<span class="dropdown-eyebrow">COMPANY PROFILE</span>
								<h3 class="dropdown-title">企業情報</h3>
							</div>
							<div class="corporate-dropdown-list">
								{corporateLinks.map((item) => (
									<a href={item.url} class="corporate-dropdown-item">
										<div class="corporate-dropdown-item__text">
											<span class="corporate-dropdown-item__title">{item.title}</span>
											<span class="corporate-dropdown-item__desc">{item.desc}</span>
										</div>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
									</a>
								))}
							</div>
						</div>
					</div>
				</li>

				<!-- 3. LOCATION -->
				<li class="nav-item">
					<a href="/location/" class="nav-link">
						<span>LOCATION</span>
					</a>
				</li>

				<!-- 4. MAGAZINE -->
				<li class="nav-item">
					<a href="/magazine/" class="nav-link">
						<span>MAGAZINE</span>
					</a>
				</li>

				<!-- 5. RECRUIT -->
				<li class="nav-item">
					<a href="https://www.nicole-recruit.com/" target="_blank" rel="noopener noreferrer" class="nav-link">
						<span>RECRUIT</span>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ext-icon"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
					</a>
				</li>

				<!-- 6. CONTACT (アクセントボタン) -->
				<li class="nav-item nav-item--cta">
					<a href="https://www.nicole.co.jp/contact/?form_type=inquiry" target="_blank" rel="noopener noreferrer" class="nav-cta-btn">
						<span>CONTACT</span>
					</a>
				</li>
			</ul>
		</nav>

		<!-- モバイル・ハンバーガーボタン -->
		<button 
			type="button" 
			id="mobile-menu-toggle" 
			class="hamburger-btn" 
			aria-label="メニューを開閉する" 
			aria-expanded="false" 
			aria-controls="mobile-drawer"
		>
			<span class="hamburger-line hamburger-line--1"></span>
			<span class="hamburger-line hamburger-line--2"></span>
		</button>
	</div>

	<!-- モバイル用 フルスクリーン・オーバーレイドロワー -->
	<div id="mobile-drawer" class="mobile-drawer" aria-hidden="true">
		<div class="mobile-drawer__inner">
			<div class="mobile-drawer__section">
				<span class="drawer-eyebrow">NAVIGATION</span>
				<ul class="mobile-nav-list">
					<!-- Brands アコーディオン -->
					<li class="mobile-nav-item">
						<button type="button" class="mobile-accordion-toggle" aria-expanded="false">
							<span>BRANDS</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="accordion-arrow"><path d="m6 9 6 6 6-6"/></svg>
						</button>
						<div class="mobile-accordion-content">
							{brands.map((b) => (
								<a href={b.url} class="mobile-sub-link" target={b.url.startsWith('http') ? "_blank" : "_self"} rel="noopener noreferrer">
									<span class="brand-sub-name">{b.name}</span>
									<span class="brand-sub-corp">{b.corp}</span>
								</a>
							))}
						</div>
					</li>

					<!-- Corporate アコーディオン -->
					<li class="mobile-nav-item">
						<button type="button" class="mobile-accordion-toggle" aria-expanded="false">
							<span>CORPORATE</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="accordion-arrow"><path d="m6 9 6 6 6-6"/></svg>
						</button>
						<div class="mobile-accordion-content">
							{corporateLinks.map((item) => (
								<a href={item.url} class="mobile-sub-link">
									<span>{item.title}</span>
								</a>
							))}
						</div>
					</li>

					<li class="mobile-nav-item">
						<a href="/location/" class="mobile-main-link">
							<span>LOCATION</span>
							<span class="mobile-link-sub">ショールーム・拠点マップ</span>
						</a>
					</li>

					<li class="mobile-nav-item">
						<a href="/magazine/" class="mobile-main-link">
							<span>MAGAZINE</span>
							<span class="mobile-link-sub">特集記事・ストーリー</span>
						</a>
					</li>

					<li class="mobile-nav-item">
						<a href="https://www.nicole-recruit.com/" target="_blank" rel="noopener noreferrer" class="mobile-main-link">
							<span>RECRUIT</span>
							<span class="mobile-link-sub">採用情報 ↗</span>
						</a>
					</li>
				</ul>
			</div>

			<div class="mobile-drawer__footer">
				<a href="https://www.nicole.co.jp/contact/?form_type=inquiry" target="_blank" rel="noopener noreferrer" class="mobile-contact-btn">
					お問い合わせフォーム ↗
				</a>
				<p class="mobile-copyright">© Nicole Group. All rights reserved.</p>
			</div>
		</div>
	</div>
</header>

<!-- ヘッダー制御スクリプト（スクロール検知・メガメニュー・モバイルドロワー） -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		const header = document.getElementById('nicole-site-header');
		const toggleBtn = document.getElementById('mobile-menu-toggle');
		const drawer = document.getElementById('mobile-drawer');

		if (!header) return;

		// 1. スクロール監視（フロストガラス化 ＆ スマートハイド）
		let lastScrollY = window.scrollY;
		let ticking = false;

		const handleScroll = () => {
			const currentScrollY = window.scrollY;

			// フロストガラス背景の切り替え
			if (currentScrollY > 40) {
				header.classList.add('is-scrolled');
			} else {
				header.classList.remove('is-scrolled');
			}

			// スマートハイド（下スクロールで隠し、上スクロールで表示）
			if (currentScrollY > 180) {
				if (currentScrollY > lastScrollY && !header.classList.contains('is-menu-open')) {
					header.classList.add('is-hidden');
				} else {
					header.classList.remove('is-hidden');
				}
			} else {
				header.classList.remove('is-hidden');
			}

			lastScrollY = currentScrollY;
			ticking = false;
		};

		window.addEventListener('scroll', () => {
			if (!ticking) {
				window.requestAnimationFrame(handleScroll);
				ticking = true;
			}
		}, { passive: true });

		// 2. モバイルメニューのトグル
		if (toggleBtn && drawer) {
			toggleBtn.addEventListener('click', () => {
				const isOpen = header.classList.toggle('is-menu-open');
				toggleBtn.setAttribute('aria-expanded', String(isOpen));
				drawer.setAttribute('aria-hidden', String(!isOpen));

				if (isOpen) {
					document.body.style.overflow = 'hidden';
				} else {
					document.body.style.overflow = '';
				}
			});
		}

		// 3. モバイルアコーディオン開閉
		const accordions = document.querySelectorAll('.mobile-accordion-toggle');
		accordions.forEach(btn => {
			btn.addEventListener('click', () => {
				const isExpanded = btn.getAttribute('aria-expanded') === 'true';
				btn.setAttribute('aria-expanded', String(!isExpanded));
				const content = btn.nextElementSibling;
				if (content) {
					content.classList.toggle('is-open');
				}
			});
		});

		// 4. メガメニューのPCクリック/ホバー挙動改善
		const dropdownButtons = document.querySelectorAll('.nav-item--has-dropdown .nav-link--btn');
		dropdownButtons.forEach(btn => {
			btn.addEventListener('click', (e) => {
				e.preventDefault();
				const parent = btn.closest('.nav-item--has-dropdown');
				const isCurrentExpanded = btn.getAttribute('aria-expanded') === 'true';

				// 他を閉じる
				dropdownButtons.forEach(otherBtn => {
					otherBtn.setAttribute('aria-expanded', 'false');
					otherBtn.closest('.nav-item--has-dropdown')?.classList.remove('is-active');
				});

				if (!isCurrentExpanded) {
					btn.setAttribute('aria-expanded', 'true');
					parent?.classList.add('is-active');
				}
			});
		});

		// 外側クリックでメガメニューを閉じる
		document.addEventListener('click', (e) => {
			if (!e.target.closest('.nav-item--has-dropdown')) {
				dropdownButtons.forEach(btn => {
					btn.setAttribute('aria-expanded', 'false');
					btn.closest('.nav-item--has-dropdown')?.classList.remove('is-active');
				});
			}
		});
	});
</script>

<style>
	/* ============================================================== */
	/* グローバルヘッダー・スタイル（シネマティック＆フロストガラス） */
	/* ============================================================== */
	.nicole-header {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 10000;
		background: transparent;
		transition: background-color 0.4s ease, backdrop-filter 0.4s ease, border-color 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
		border-bottom: 1px solid transparent;
	}

	/* スクロール時のフロストガラス状態 */
	.nicole-header.is-scrolled {
		background: rgba(7, 8, 10, 0.88);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
	}

	/* スマートハイド（下スクロール時の一時退避） */
	.nicole-header.is-hidden {
		transform: translateY(-100%);
	}

	.header-container {
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		padding: 22px 40px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		transition: padding 0.3s ease;
	}

	.nicole-header.is-scrolled .header-container {
		padding: 16px 40px;
	}

	/* ロゴ */
	.header-logo {
		display: inline-flex;
		align-items: center;
		text-decoration: none;
		z-index: 10001;
	}

	.header-logo__img {
		height: 26px;
		width: auto;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.header-logo:hover .header-logo__img {
		opacity: 0.85;
	}

	/* デスクトップナビゲーション */
	.desktop-nav {
		display: flex;
		align-items: center;
	}

	.nav-list {
		display: flex;
		align-items: center;
		gap: 36px;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-item {
		position: relative;
	}

	.nav-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: 'Inter', -apple-system, sans-serif;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.16em;
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		background: none;
		border: none;
		cursor: pointer;
		padding: 8px 0;
		position: relative;
		transition: color 0.3s ease;
	}

	.nav-link::after {
		content: '';
		position: absolute;
		bottom: 2px;
		left: 0;
		width: 0%;
		height: 1.5px;
		background: #c5a059;
		transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.nav-link:hover,
	.nav-item.is-active .nav-link,
	.nav-item:hover .nav-link {
		color: #ffffff;
	}

	.nav-link:hover::after,
	.nav-item.is-active .nav-link::after,
	.nav-item:hover .nav-link::after {
		width: 100%;
	}

	.dropdown-chevron {
		width: 12px;
		height: 12px;
		transition: transform 0.3s ease;
	}

	.nav-item:hover .dropdown-chevron,
	.nav-item.is-active .dropdown-chevron {
		transform: rotate(180deg);
	}

	.ext-icon {
		width: 12px;
		height: 12px;
		opacity: 0.6;
	}

	/* CTAボタン（CONTACT） */
	.nav-cta-btn {
		display: inline-flex;
		align-items: center;
		padding: 9px 20px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		font-family: 'Inter', -apple-system, sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: #ffffff;
		text-decoration: none;
		backdrop-filter: blur(8px);
		transition: all 0.3s ease;
	}

	.nav-cta-btn:hover {
		background: #c5a059;
		border-color: #c5a059;
		color: #000000;
		box-shadow: 0 4px 16px rgba(197, 160, 89, 0.35);
		transform: translateY(-1px);
	}

	/* ============================================================== */
	/* ドロップダウン・メガメニュー（エディトリアル展開） */
	/* ============================================================== */
	.dropdown-menu {
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%) translateY(16px);
		background: rgba(11, 13, 17, 0.96);
		backdrop-filter: blur(24px);
		-webkit-backdrop-filter: blur(24px);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 16px;
		padding: 32px;
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7);
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
		transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
	}

	/* ホバーまたはアクティブで展開 */
	.nav-item:hover .dropdown-menu,
	.nav-item.is-active .dropdown-menu {
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
		transform: translateX(-50%) translateY(8px);
	}

	.dropdown-menu--brands {
		width: 820px;
	}

	.dropdown-menu--corporate {
		width: 440px;
	}

	.dropdown-header {
		margin-bottom: 20px;
		padding-bottom: 12px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.dropdown-eyebrow {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: #c5a059;
		display: block;
		margin-bottom: 4px;
	}

	.dropdown-title {
		font-size: 15px;
		font-weight: 600;
		color: #ffffff;
		margin: 0;
	}

	/* ブランドカードグリッド（ドロップダウン内） */
	.brands-dropdown-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 14px;
	}

	.brand-dropdown-card {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 10px;
		padding: 16px;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		position: relative;
		transition: all 0.3s ease;
	}

	.brand-dropdown-card:hover {
		background: rgba(255, 255, 255, 0.07);
		border-color: rgba(197, 160, 89, 0.4);
		transform: translateY(-2px);
	}

	.brand-dropdown-card__top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 4px;
	}

	.brand-dropdown-card__name {
		font-family: 'Inter', sans-serif;
		font-size: 16px;
		font-weight: 700;
		color: #ffffff;
	}

	.brand-dropdown-card__badge {
		font-size: 9px;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: #c5a059;
	}

	.brand-dropdown-card__corp {
		font-size: 11px;
		color: rgba(255, 255, 255, 0.6);
		margin: 0 0 8px 0;
	}

	.brand-dropdown-card__desc {
		font-size: 11px;
		color: rgba(255, 255, 255, 0.4);
		line-height: 1.5;
		margin: 0 0 8px 0;
		flex-grow: 1;
	}

	.brand-dropdown-card__arrow {
		align-self: flex-end;
		opacity: 0.4;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.brand-dropdown-card__arrow svg {
		width: 14px;
		height: 14px;
		stroke: #ffffff;
	}

	.brand-dropdown-card:hover .brand-dropdown-card__arrow {
		opacity: 1;
		transform: translateX(3px);
