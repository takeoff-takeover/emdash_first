---
// src/pages/contact-thanks.astro
// ニコル・グループ 公式固定ページ（WordPress/Elementor デザインレイアウト完全継承）
import NicoleLayout from "../layouts/NicoleLayout.astro";

const pageTitle = "お問い合わせ完了 | Nicole Group 公式";
const pageDescription = "お問い合わせを受け付けいたしました。担当者より順次ご連絡差し上げます。";

// Elementor 完全継承HTMLコンテンツ
const elementorHtml = "<div data-elementor-type=\"wp-page\" data-elementor-id=\"9558\" class=\"elementor elementor-9558\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-7bbf745 e-flex e-con-boxed e-con e-parent\" data-id=\"7bbf745\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-da3615b elementor-widget elementor-widget-heading\" data-id=\"da3615b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">お問い合わせ</h2>\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-cb5b594 e-flex e-con-boxed e-con e-parent\" data-id=\"cb5b594\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a82bba9 elementor-widget elementor-widget-text-editor\" data-id=\"a82bba9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>送信が完了しました</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2955d7e elementor-widget__width-inherit elementor-widget elementor-widget-text-editor\" data-id=\"2955d7e\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>内容を確認のうえ、担当よりご連絡いたします。</p><p>通常1〜3営業日以内にご返信いたします。<br data-start=\"1076\" data-end=\"1079\" />確認メールが届かない場合は、迷惑メールフォルダもご確認ください。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-1e723b7 elementor-widget elementor-widget-text-editor\" data-id=\"1e723b7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>※お問い合わせ内容によっては、ご回答までにお時間をいただく場合がございます。あらかじめご了承ください。また内容により、担当者よりお電話でご連絡させていただく場合がございます。</p><p>※お車の不調・故障・修理など、サービス・メンテナンスに関するご相談は、お近くのNicole Groupの各ショールームまたはサービス拠点へ直接ご連絡いただきますようお願いいたします。インターネットからのお問い合わせでは対応できない場合がございます。</p><p>※営業・ご提案などの内容につきましては、返信を差し控えさせていただく場合がございます。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-9518fb9 e-flex e-con-boxed e-con e-parent\" data-id=\"9518fb9\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>";
---

<NicoleLayout title={pageTitle} description={pageDescription}>
  <slot name="head" slot="head">
	<link rel="stylesheet" href="/wp-content/themes/astra/assets/css/minified/main.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/reviews-feed/vendor/smashballoon/framework/Packages/Blocks/css/sb-elementor.css" />
	<link rel="stylesheet" href="/wp-content/uploads/astra-addon/astra-addon-6ad82db3390588-53003025.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/frontend.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-image.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-icon-list.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-spacer.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/lib/animations/styles/fadeIn.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/lib/animations/styles/e-animation-grow.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor-pro/assets/css/widget-mega-menu.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor-pro/assets/css/modules/sticky.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor-pro/assets/css/widget-breadcrumbs.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-divider.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/lib/animations/styles/e-animation-shrink.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-icon-box.min.css" />
	<link rel="stylesheet" href="/wp-content/uploads/elementor/css/post-8.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-heading.min.css" />
	<link rel="stylesheet" href="/wp-content/uploads/elementor/css/post-9558.css" />
	<link rel="stylesheet" href="/wp-content/uploads/elementor/css/post-6801.css" />
	<link rel="stylesheet" href="/wp-content/uploads/elementor/css/post-4102.css" />
    <style is:global>
      /* Elementor 余白・レイアウト完全適合スタイル */
      .elementor {
        box-sizing: border-box;
      }
      .entry-content {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
      .elementor img {
        height: auto;
        max-width: 100%;
      }
      /* コンテナ幅・表示崩れ防止 */
      .elementor-element {
        --flex-direction: initial;
        --flex-wrap: initial;
        --justify-content: initial;
        --align-items: initial;
      }
    </style>
  </slot>

  <div class="elementor-page-wrapper">
    <div class="entry-content" set:html={elementorHtml} />
  </div>
</NicoleLayout>
