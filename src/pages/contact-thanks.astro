---
// src/pages/contact-thanks.astro
// ニコル・グループ お問い合わせ完了（完全モダン・脱Elementor）
import NicoleLayout from "../layouts/NicoleLayout.astro";

const pageTitle = "お問い合わせ完了 | Nicole Group 公式";
const pageDescription = "お問い合わせを受け付けいたしました。担当者より順次ご連絡差し上げます。";
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<main class="thanks-page">
		<!-- ヒーローヘッダー -->
		<header class="thanks-hero">
			<div class="thanks-hero__inner">
				<p class="thanks-hero__sub">THANK YOU</p>
				<h1 class="thanks-hero__title">お問い合わせ完了</h1>
			</div>
		</header>

		<div class="thanks-container">
			<div class="thanks-card">
				<div class="thanks-icon-wrap">
					<svg class="thanks-check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<polyline points="20 6 9 17 4 12"></polyline>
					</svg>
				</div>

				<h2 class="thanks-heading">送信が完了いたしました</h2>
				<p class="thanks-lead">
					この度はお問い合わせいただき、誠にありがとうございます。<br />
					内容を確認の上、担当者より順次ご連絡を差し上げます。
				</p>

				<div class="thanks-info-box">
					<p>通常1〜3営業日以内にご返信いたします。</p>
					<p class="thanks-note">
						※確認メールが届かない場合は、迷惑メールフォルダ等もあわせてご確認ください。<br />
						※お問い合わせ内容によっては、お電話にてご連絡させていただく場合がございます。
					</p>
				</div>

				<div class="thanks-action">
					<a href="/" class="thanks-btn">トップページへ戻る</a>
				</div>
			</div>
		</div>
	</main>
</NicoleLayout>

<style>
/* ============================================================== */
/* お問い合わせ完了ページ：完全モダン＆セマンティックデザイン */
/* ============================================================== */
.thanks-page {
	width: 100%;
	background-color: #fcfcfc;
	color: #111111;
	font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;
	line-height: 1.8;
	padding-bottom: 96px;
}

.thanks-container {
	width: 100%;
	max-width: 760px;
	margin: 0 auto;
	padding: 64px 40px 0;
	box-sizing: border-box;
}

/* --- ヒーローヘッダー --- */
.thanks-hero {
	width: 100%;
	background-color: #000000;
	color: #ffffff;
	padding: 88px 0 72px;
	border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	text-align: center;
}

.thanks-hero__inner {
	width: 100%;
	max-width: 1440px;
	margin: 0 auto;
	padding: 0 40px;
	box-sizing: border-box;
}

.thanks-hero__sub {
	font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
	font-size: 13px;
	letter-spacing: 0.28em;
	color: rgba(255, 255, 255, 0.6);
	margin: 0 0 16px;
	text-transform: uppercase;
}

.thanks-hero__title {
	font-size: clamp(30px, 4vw, 42px);
	font-weight: 600;
	letter-spacing: 0.08em;
	margin: 0;
	color: #ffffff;
	line-height: 1.3;
}

/* --- 完了カード --- */
.thanks-card {
	background-color: #ffffff;
	border: 1px solid #e5e5e5;
	border-radius: 4px;
	padding: 56px 48px;
	box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
	text-align: center;
}

.thanks-icon-wrap {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	width: 64px;
	height: 64px;
	border-radius: 50%;
	background-color: #f0fdf4;
	color: #16a34a;
	margin-bottom: 24px;
}

.thanks-check-icon {
	width: 32px;
	height: 32px;
}

.thanks-heading {
	font-size: clamp(22px, 2.5vw, 26px);
	font-weight: 600;
	color: #111111;
	margin: 0 0 16px;
	letter-spacing: 0.03em;
}

.thanks-lead {
	font-size: 15px;
	line-height: 1.85;
	color: #444444;
	margin: 0 0 32px;
}

.thanks-info-box {
	background-color: #fafafa;
	border: 1px solid #eeeeee;
	border-radius: 4px;
	padding: 24px;
	margin-bottom: 40px;
	text-align: left;
}

.thanks-info-box p {
	font-size: 14.5px;
	color: #333333;
	margin: 0 0 8px;
}

.thanks-note {
	font-size: 13px !important;
	color: #777777 !important;
	line-height: 1.7;
	margin: 0 !important;
}

.thanks-action {
	margin-top: 16px;
}

.thanks-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	padding: 14px 36px;
	background-color: #000000;
	color: #ffffff;
	border-radius: 4px;
	font-size: 14px;
	font-weight: 500;
	letter-spacing: 0.04em;
	text-decoration: none;
	transition: background-color 0.2s ease, transform 0.2s ease;
}

.thanks-btn:hover {
	background-color: #222222;
	transform: translateY(-1px);
}

/* --- レスポンシブ対応 --- */
@media (max-width: 768px) {
	.thanks-container {
		padding: 40px 20px 0;
	}

	.thanks-hero {
		padding: 56px 0 48px;
	}

	.thanks-card {
		padding: 36px 20px;
	}

	.thanks-info-box {
		padding: 20px 16px;
	}
}
</style>
