const htmlPart2 = "\n\t\t\t\t</div>\n\t\t\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-bd6c23a elementor-hidden-desktop elementor-hidden-tablet elementor-hidden-mobile e-flex e-con-boxed e-con e-parent\" data-id=\"bd6c23a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-85f3922 e-con-full e-flex e-con e-child\" data-id=\"85f3922\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-59e4bd1 elementor-widget elementor-widget-heading\" data-id=\"59e4bd1\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Nicole GroupがMINI正規ディーラーである理由</h2>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9628e44 elementor-widget elementor-widget-text-editor\" data-id=\"9628e44\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>Nicole GroupはMINI正規ディーラーとして、<br />新車販売からアフターサービスまで一貫したサポート体制を整えています。</p><p>専門知識を持つMINI認定スタッフが、<br />お客様一人ひとりのライフスタイルに合わせたご提案を行います。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-6e7cda0 elementor-widget elementor-widget-html\" data-id=\"6e7cda0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<script>\ndocument.addEventListener('DOMContentLoaded', function () {\n\n  const getParamMap = (url) => {\n    const map = new Map();\n    url.searchParams.forEach((v, k) => {\n      const set = map.get(k) || new Set();\n      String(v).split(',').map(s => s.trim()).filter(Boolean).forEach(x => set.add(x));\n      map.set(k, set);\n    });\n    return map;\n  };\n\n  const mapToSearchParams = (map) => {\n    const sp = new URLSearchParams();\n    map.forEach((set, key) => {\n      const arr = Array.from(set);\n      if (arr.length) sp.set(key, arr.join(','));\n    });\n    return sp;\n  };\n\n  const parseLinkFilter = (href) => {\n    const u = new URL(href, window.location.origin);\n    for (const [k, v] of u.searchParams.entries()) {\n      return { key: k, value: v };\n    }\n    return null;\n  };\n\n  // active反映\n  const applyActive = () => {\n    const map = getParamMap(new URL(window.location.href));\n    document.querySelectorAll('.filter-link').forEach(el => {\n      const link = (el.tagName.toLowerCase() === 'a') ? el : el.querySelector('a');\n      if (!link) return;\n\n      const f = parseLinkFilter(link.href);\n      if (!f) return;\n\n      const set = map.get(f.key);\n      const isOn = set && set.has(f.value);\n\n      el.classList.toggle('is-active', !!isOn);\n      link.classList.toggle('is-active', !!isOn);\n    });\n  };\n\n  // クリックで条件を“積み上げ/解除”\n  document.querySelectorAll('.filter-link').forEach(el => {\n    const link = (el.tagName.toLowerCase() === 'a') ? el : el.querySelector('a');\n    if (!link) return;\n\n    link.addEventListener('click', function(e){\n      const f = parseLinkFilter(link.href);\n      if (!f) return;\n\n      e.preventDefault();\n\n      const nextUrl = new URL(window.location.href);\n      const map = getParamMap(nextUrl);\n\n      // 同一キーは複数選択（トグル）\n      const set = map.get(f.key) || new Set();\n      if (set.has(f.value)) set.delete(f.value);\n      else set.add(f.value);\n\n      if (set.size) map.set(f.key, set);\n      else map.delete(f.key);\n\n      nextUrl.search = mapToSearchParams(map).toString();\n      window.location.href = nextUrl.toString();\n    });\n  });\n\n  applyActive();\n});\n</script>\n<script>\n(function () {\n  function openAllAccordions(scope) {\n    // Elementor 新アコーディオン（details/summary型）\n    scope.querySelectorAll('details').forEach(d => {\n      d.open = true;\n      d.setAttribute('open', 'open');\n    });\n\n    // Elementor のクラスがある場合も明示的に対応（新/旧混在対策）\n    scope.querySelectorAll('.e-n-accordion-item').forEach(item => {\n      item.setAttribute('open', 'open');\n      item.open = true;\n    });\n\n    // 旧アコーディオン：見出しをクリックして開く（JSで確実に展開）\n    scope.querySelectorAll('.elementor-accordion .elementor-tab-title, .elementor-toggle .elementor-tab-title').forEach(title => {\n      // 既にアクティブならスキップ\n      if (title.classList.contains('elementor-active')) return;\n      title.click();\n    });\n  }\n\n  function run() {\n    const scope = document.querySelector('.bmw-filters');\n    if (!scope) return;\n\n    openAllAccordions(scope);\n\n    // Elementorは後からDOMを差し替えることがあるので保険で再実行\n    setTimeout(() => openAllAccordions(scope), 300);\n    setTimeout(() => openAllAccordions(scope), 1000);\n  }\n\n  document.addEventListener('DOMContentLoaded', run);\n})();\n</script>\n\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-880e7c6 elementor-hidden-desktop elementor-hidden-tablet elementor-hidden-mobile e-flex e-con-boxed e-con e-parent\" data-id=\"880e7c6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-f8a90a4 e-con-full e-flex e-con e-child\" data-id=\"f8a90a4\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-c0430f6 e-con-full bmw-filters e-flex e-con e-child\" data-id=\"c0430f6\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-bc66b12 elementor-widget__width-initial elementor-widget elementor-widget-n-accordion\" data-id=\"bc66b12\" data-element_type=\"widget\" data-e-type=\"widget\" data-settings=\"{&quot;max_items_expended&quot;:&quot;multiple&quot;,&quot;default_state&quot;:&quot;expanded&quot;,&quot;n_accordion_animation_duration&quot;:{&quot;unit&quot;:&quot;ms&quot;,&quot;size&