// アイキャッチ画像のURL取得（EmDash R2ストレージ key および 外部URLの両方に対応）
function getImageUrl(img: unknown): string {
	if (!img) return "";
	let target: any = img;
	if (typeof target === "string") {
		const trimmed = target.trim();
		if (trimmed.startsWith("{") && trimmed.endsWith("}")) {
			try {
				target = JSON.parse(trimmed);
			} catch {
				return trimmed;
			}
		} else {
			return trimmed;
		}
	}
	if (typeof target === "object" && target !== null) {
		if (typeof target.src === "string" && target.src.trim()) {
			return target.src.trim();
		}
		const storageKey = target.meta?.storageKey || target.storageKey || target.id;
		if (storageKey) {
			return `/_emdash/api/media/file/${storageKey}`;
		}
	}
	return "";
}

