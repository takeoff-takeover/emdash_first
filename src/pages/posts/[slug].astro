---
// src/pages/posts/[slug].astro
// Nicole Connect - マガジン記事詳細（上部に大迫力アイキャッチ写真・現代的エディトリアルレイアウト）
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import SliderBlock from "../../components/blocks/SliderBlock.astro";
import AccordionBlock from "../../components/blocks/AccordionBlock.astro";
import "../../styles/prose.css";

const portableTextComponents = {
	type: {
		slider: SliderBlock,
		accordion: AccordionBlock,
	},
};

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: cmsPost, cacheHint } = await getEmDashEntry("posts", slug);

if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

// 静的記事カタログ（CMSにまだ入っていない場合のフォールバック）
const staticArticlesCatalog: Record<string, any> = {
	"2027_new_bmw_3series_neue_klasse": {
		data: {
			title: "【公式発表】新型BMW 3シリーズ登場。完全電動『BMW i3』と直6搭載『M350 xDrive』が切り拓く新時代",
			excerpt: "次世代EVプラットフォーム『ノイエ・クラッセ』を初採用。歴代最高のドライビング・ダイナミクスと革新のデジタル・キャビン。",
			featured_image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg",
			published_at: "2026-10-22T10:00:00.000Z",
			related_location: "nicole-bmw-kawasaki",
			content: [
				{
					_type: "block",
					style: "normal",
					children: [
						{ _type: "span", text: "BMWの歴史において、もっともアイコニックであり中核を担い続けてきた『3シリーズ』。その歴史に、かつてない劇的な革新がもたらされました。次世代EV専用アーキテクチャ『ノイエ・クラッセ（Neue Klasse）』を全面採用した初の市販セダンとして、完全電動モデル『BMW i3』、そして伝統の直列6気筒Mツインターボを極限まで研ぎ澄ました『BMW M350 xDrive』がベールを脱ぎました。" }
					]
				},
				{
					_type: "block",
					style: "h2",
					children: [
						{ _type: "span", text: "1. デザイン言語の刷新：キドニーグリルとヘッドライトのデジタル融合" }
					]
				},
				{
					_type: "block",
					style: "normal",
					children: [
						{ _type: "span", text: "フロントマスクは、歴代のツイン・サーキュラー・ヘッドライトとキドニーグリルをシームレスなデジタルサーフェスへと再定義。昼夜を問わず圧倒的な存在感を放つ発光シグネチャーが、走る悦びの新時代を告げます。サイドはロングホイールベースとショートオーバーハングの完璧な黄金比を継承し、自動格納式フラッシュドアハンドルによって極めて優れたエアロダイナミクスを実現しています。" }
					]
				},
				{
					_type: "block",
					style: "h2",
					children: [
						{ _type: "span", text: "2. 800Vシステムと第6世代BMW eDrive：10分で300kmの航続回復" }
					]
				},
				{
					_type: "block",
					style: "normal",
					children: [
						{ _type: "span", text: "完全電動モデル『i3』には、エネルギー密度を20%高めた新開発の円筒形バッテリーセルと、800V高電圧急速充電システムを搭載。最大300kW以上の超急速充電に対応し、長距離グランドツーリングにおいてもガソリン車の給油と変わらないストレスフリーな移動を可能にしました。" }
					]
				},
				{
					_type: "block",
					style: "h2",
					children: [
						{ _type: "span", text: "3. ドライビング・ダイナミクス：『ハート・オブ・ジョイ』による統合制御" }
					]
				},
				{
					_type: "block",
					style: "normal",
					children: [
						{ _type: "span", text: "新開発の中央統合演算ユニット『Heart of Joy』が、パワートレインとブレーキ、サスペンションを従来の10倍の速度で連動制御。後輪駆動をベースとした俊敏な回頭性と、ドライバーの意図をミリ秒単位で先読みする異次元のオン・ザ・レール感覚をもたらします。" }
					]
				}
			]
		}
	},
	"202608_bmw_kids_mechanic": {
		data: {
			title: "お給料も自分で稼ぐ。小学生が体験したBMWメカニックの特別な1日",
			excerpt: "未来のエンジニアたちへ。整備工場の本物のツールを使って自動車の構造と安全を学ぶNicole特別体験プログラム。",
			featured_image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5134.jpg",
			published_at: "2026-08-20T10:00:00.000Z",
			related_location: "nicole-bmw-kawasaki",
			content: [
				{
					_type: "block",
					style: "normal",
					children: [
						{ _type: "span", text: "夏休み、Nicole BMW 本社ショールームのサービスファクトリーにて、小学生を対象とした『キッズメカニック体験プログラム』が開催されました。本物のつなぎを着て、熟練BMWマイスターの指導のもと、工具の使い方やタイヤの点検、安全整備の真髄を学ぶ特別な1日の様子をレポートします。" }
					]
				}
			]
		}
	}
};

const post = cmsPost || staticArticlesCatalog[slug];

if (!post) {
	return Astro.rewrite("/404");
}

// 関連拠点データの判定（CMSの related_location フィールドに基づく動的連携）
const relatedLocationKey = (post.data as any).related_location || "nicole-bmw-kawasaki";

// 拠点マスタ定義
const showroomCatalog: Record<string, any> = {
	"nicole-bmw-kawasaki": {
		id: "nicole-bmw-kawasaki",
		name: "Nicole BMW 本社ショールーム（川崎）",
		subName: "Nicole BMW Kawasaki Headquarters & Service",
		brand: "BMW",
		address: "神奈川県川崎市幸区戸手2-5-7",
		postal: "〒212-0005",
		tel: "044-511-2000",
		hours: "10:00～18:00",
		closed: "水曜日（祝日を除く）",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/01/Nicole-BMW-本社.jpg",
		detailUrl: "/location/nicole-bmw-kawasaki/",
		googleMapsUrl: "https://maps.app.goo.gl/LRAu7RxGhwoWZJLk7",
		features: ["新車ショールーム", "BMWマイスター在籍ファクトリー併設", "納車ハンドオーバースペース", "150kW急速充電"]
	},
	"nicole-bmw-ota": {
		id: "nicole-bmw-ota",
		name: "Nicole BMW 大田支店",
		subName: "Nicole BMW Ota Branch",
		brand: "BMW",
		address: "東京都大田区北馬込1-16-11 1階",
		postal: "〒143-0021",
		tel: "03-5743-2000",
		hours: "10:00～18:00",
		closed: "水曜日（祝日を除く）",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/01/大田支店.jpg",
		detailUrl: "/location/nicole-bmw-ota/",
		googleMapsUrl: "https://maps.google.com/?q=Nicole+BMW+大田支店",
		features: ["都内正規拠点", "新車ショールーム", "サービス工場併設"]
	}
};

const relatedShowroom = showroomCatalog[relatedLocationKey] || showroomCatalog["nicole-bmw-kawasaki"];

// アイキャッチ画像のURL取得（EmDash R2ストレージ key および 外部URLの両方に対応）
function getImageUrl(img: unknown): string {
	if (!img) return "";
	if (typeof img === "string") return img;
	if (typeof img === "object" && img !== null) {
		const image = img as Record<string, any>;
		if (typeof image.src === "string" && image.src) {
			return image.src;
		}
		const storageKey = image.meta?.storageKey || image.id;
		if (storageKey) {
			return `/_emdash/api/media/file/${storageKey}`;
		}
	}
	return "";
}

const isNeueKlasse = slug.includes("neue_klasse") || slug.includes("3series");
const isDemoArticle = isNeueKlasse || slug === "202608_bmw_kids_mechanic";
const featuredImage = post.data.featured_image;
const featuredImageSp = (post.data as any).featured_image_sp;

const heroImageUrl = getImageUrl(featuredImage) || (isNeueKlasse ? "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg" : "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5134.jpg");
const heroImageUrlSp = getImageUrl(featuredImageSp);
const hasShowroom = Boolean((post.data as any).related_location) || isDemoArticle;

// スライドギャラリー写真データ（BMW Group PressClub 公式高解像度写真）
const neueKlasseGallery = [
	{
		title: "新型BMW 3シリーズ エクステリア（フロント）",
		caption: "Neue Klasseデザイン言語を採用した先進のフロントマスク。キドニーグリルとツインヘッドライトが一体化し、新たな光のシグネチャーを創出。",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg"
	},
	{
		title: "サイドプロファイル ＆ 2.5ボックスシルエット",
		caption: "ロングホイールベースとショートオーバーハングによる伝統のスポーツプロポーション。自動格納式フラッシュドアハンドルと低重心なキャラクターライン。",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657631/P90657631-the-new-bmw-3-series-exterior-2250px.jpg"
	},
	{
		title: "BMW M350 xDrive（Mパフォーマンス・フラッグシップ）",
		caption: "3.0L 直6 TwinPower Turbo＋48Vマイルドハイブリッド（326kW/443hp）。専用アダプティブMサスペンションを標準装備。",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657689/P90657689-the-new-bmw-m350-xdrive-exterior-09-26-2250px.jpg"
	},
	{
		title: "BMW 320（高効率4気筒ガソリンモデル）",
		caption: "最新世代BMW TwinPower Turboと48Vマイルドハイブリッドを搭載し、優れた環境性能と洗練された俊敏なハンドリングを高次元で両立。",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657728/P90657728-the-new-bmw-320-exterior-09-26-2250px.jpg"
	}
];

const kidsGallery = [
	{
		title: "メカニックウエアへの着替え",
		caption: "BMWマイスターと同じつなぎに身を包み、少し緊張しながらも誇らしげな笑顔",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5139.jpg"
	},
	{
		title: "実車を使ったタイヤ空気圧・点検作業",
		caption: "プロのBMWマイスターの手ほどきを受けながら、エアゲージを使って適正空気圧をチェック",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5162.jpg"
	},
	{
		title: "「ニコル・ユーロ」給与明細の授与",
		caption: "すべての点検ミッションを終え、自らの労働の対価として給与明細とお給料を受け取る",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5188.jpg"
	},
	{
		title: "特別ファクトリー見学ツアー",
		caption: "普段は立ち入ることのできないNicole BMW 本社サービス工場を保護者様と共に見学",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5206.jpg"
	}
];

const currentGallery = isNeueKlasse ? neueKlasseGallery : kidsGallery;

// 本文内に既にスライダー／アコーディオンブロックが存在するか判定
const contentArray = Array.isArray(post.data.content) ? post.data.content : [];
const hasSliderBlock = contentArray.some((b: any) => b && b._type === "slider");
const hasAccordionBlock = contentArray.some((b: any) => b && b._type === "accordion");

// 関連記事データ（サイドバー用）
const relatedStories = [
	{
		slug: "2027_new_bmw_3series_neue_klasse",
		title: "【公式発表】新型BMW 3シリーズ登場。完全電動『BMW i3』と直6搭載『M350 xDrive』が切り拓く新時代",
		brand: "BMW",
		date: "2026.10.22",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg",
		url: "/magazine/2027_new_bmw_3series_neue_klasse/"
	},
	{
		slug: "202608_bmw_kids_mechanic",
		title: "お給料も自分で稼ぐ。小学生が体験したBMWメカニックの特別な1日",
		brand: "BMW",
		date: "2026.08.20",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5134.jpg",
		url: "/magazine/202608_bmw_kids_mechanic/"
	},
	{
		slug: "202610_mini_united-japan-2026",
		title: "「BIG LOVE」があふれた一日。みんなで彩ったMINIと、大盛況のガチャ抽選会",
		brand: "MINI",
		date: "2026.10.15",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/10/DSC6593-1-scaled.jpg",
		url: "https://www.nicole.co.jp/magazine/202610_mini_united-japan-2026/"
	},
	{
		slug: "202608_ferrari_luce",
		title: "フェラーリ初のフル電動モデル「LUCE（ルーチェ）」日本上陸",
		brand: "Ferrari",
		date: "2026.08.17",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC4983-3.jpg",
		url: "https://www.nicole.co.jp/magazine/202608_ferrari_luce/"
	},
	{
		slug: "20260714_mini_jcw_track_style_edition",
		title: "【各25台限定】日本未発売仕様を纏ったエレクトリック・モンスター。「MINI JCW Track Style Edition」登場",
		brand: "MINI",
		date: "2026.07.14",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/07/minijcwtrack-scaled.jpg",
		url: "https://www.nicole.co.jp/magazine/20260714_mini_jcw_track_style_edition/"
	},
	{
		slug: "alpina-heritage-story",
		title: "アルピナとともに歩んだ半世紀。ニコル・オートモビルズが受け継ぐクラフトマンシップの真価",
		brand: "ALPINA",
		date: "2026.05.15",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/07/DSC7756.jpg",
		url: "https://nicole-automobiles.com/"
	}
].filter(s => s.slug !== slug);

// タイトルを自然な文節で改行・表示するためのセグメント分割
function getTitleSegments(rawTitle: string) {
	if (rawTitle.includes("新型BMW 3シリーズ") || (rawTitle.includes("3シリーズ") && rawTitle.includes("直6"))) {
		return [
			{ text: "【公式発表】新型BMW 3シリーズ登場。", class: "title-phrase" },
			{ text: "完全電動『BMW i3』と", class: "title-phrase" },
			{ text: "直6搭載『M350 xDrive』が切り拓く新時代", class: "title-phrase" }
		];
	}
	if (rawTitle.includes("ノイエ・クラッセ")) {
		return [
			{ text: "【最新スクープ】2027年登場の", class: "title-phrase" },
			{ text: "次世代BMW 3シリーズ（ノイエ・クラッセ）は", class: "title-phrase" },
			{ text: "BEVと直6エンジンが共存へ", class: "title-phrase" }
		];
	}
	if (rawTitle.includes("。")) {
		const parts = rawTitle.split("。");
		return parts.map((p, idx) => ({
			text: idx < parts.length - 1 ? `${p}。` : p,
			class: "title-phrase"
		})).filter(p => p.text.length > 0);
	}
	return [{ text: rawTitle, class: "" }];
}

const titleSegments = getTitleSegments(post.data.title);

// 記事編集ページURL（EmDash Admin）
const postDbId = (post?.data as any)?.id;
const editUrl = postDbId 
	? `/_emdash/admin/content/posts/${postDbId}` 
	: "/_emdash/admin/content/posts";
---

<NicoleLayout 
	title={`${post.data.title} ｜ Nicole Connect`}
	description={post.data.excerpt || "世界最高峰のモビリティと美学を編むNicole Connect公式記事。"}
>
	<article class="modern-article-page">
		<!-- ============================================================== -->
		<!-- 1. 最上部：左右いっぱいに広がるアイキャッチ写真（フルブリード・シネマティック） -->
		<!-- ============================================================== -->
		<div class="article-hero-media-wrap">
			<div class="article-hero-top-scrim" aria-hidden="true"></div>
			<picture>
				{heroImageUrlSp && (
					<source media="(max-width: 768px)" srcset={heroImageUrlSp} />
				)}
				<img 
					src={heroImageUrl} 
					alt={post.data.title} 
					class="article-hero-img" 
					loading="eager" 
				/>
			</picture>
			<div class="article-photo-credit-overlay">
				<span>Photo: © BMW AG PressClub Global / Nicole Group Editorial</span>
			</div>
		</div>

		<header class="article-header-section">
			<div class="article-header-container">
				<!-- パンくずナビゲーション & 編集リンク -->
				<div class="article-breadcrumb-row">
					<nav class="article-breadcrumb" aria-label="Breadcrumb">
						<a href="/" class="bc-link">HOME</a>
						<span class="bc-sep">/</span>
						<a href="/magazine/" class="bc-link">MAGAZINE</a>
						<span class="bc-sep">/</span>
						<span class="bc-current">{post.data.title}</span>
					</nav>

					<!-- CMS管理画面（編集ページ）へのダイレクトリンク -->
					<a href={editUrl} class="article-edit-btn" title="CMS管理画面でこの記事を編集">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="edit-icon">
							<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
							<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
						</svg>
						<span>記事を編集</span>
					</a>
				</div>

				<!-- 記事タイトル（自然な文節で改行） -->
				<h1 class="article-main-title">
					{titleSegments.map(segment => (
						segment.class ? (
							<span class={segment.class}>{segment.text}</span>
						) : (
							segment.text
						)
					))}
				</h1>

				<!-- リード文（サブタイトル・抜粋） -->
				{post.data.excerpt && (
					<p class="article-lead-text">{post.data.excerpt}</p>
				)}

				<!-- メタ情報バッジ群（サブタイトルの下に配置） -->
				<div class="article-meta-row">
					<span class="meta-brand-pill">
						<span class="brand-dot"></span>
						{isNeueKlasse ? "BMW" : "ALL BRANDS"}
					</span>
					<span class="meta-category-pill">
						{isNeueKlasse ? "FEATURE STORY" : "PEOPLE & CAR LIFE"}
					</span>
					<time class="meta-date">
						{isNeueKlasse ? "2026.10.22" : "2026.08.20"}
					</time>
					<span class="meta-reading-time">READING TIME: 4 MIN</span>

					<!-- メタ行内のクイック編集リンク -->
					<a href={editUrl} class="meta-edit-pill" title="この記事の編集画面を開く">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
							<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
						</svg>
						<span>編集</span>
					</a>
				</div>
			</div>
		</header>

		<!-- ============================================================== -->
		<!-- 2. 本文エリア（現代的エディトリアルレイアウト） -->
		<!-- ============================================================== -->
		<div class="article-content-wrapper">
			<div class="article-two-col-layout">
				<!-- 左メインカラム：記事本文 -->
				<div class="article-main-col">
					<!-- 本文（Portable Text） -->
				<div class="article-rich-text prose prose-invert">
