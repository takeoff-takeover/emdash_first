// 本文の数字付き見出し・タイトルを自動サニタイズ（「1. 」「2. 」等の連番を完全撤廃）
function sanitizeContent(content: any) {
	if (!Array.isArray(content)) return content;
	return content.map((node: any) => {
		if (!node || typeof node !== "object") return node;
		if (node._type === "accordion" || node._type === "faq" || node._type === "accordion_faq") {
			const newNode = { ...node };
			if (newNode.id) newNode.id = newNode.id.replace(/^\d+[\.．\s]+/, "");
			if (newNode.title) newNode.title = newNode.title.replace(/^\d+[\.．\s]+/, "");
			return newNode;
		}
		if (node._type === "block" && (node.style === "h2" || node.style === "h3" || node.style === "h4")) {
			const children = Array.isArray(node.children)
				? node.children.map((child: any, idx: number) => {
						if (idx === 0 && child && typeof child.text === "string") {
							return {
								...child,
								text: child.text.replace(/^\d+[\.．\s]+/, "")
							};
						}
						return child;
				  })
				: node.children;
			return {
				...node,
				children
			};
		}
		return node;
	});
}

