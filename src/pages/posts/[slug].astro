// タイトルを自然な文節で改行・表示するためのセグメント分割
function getTitleSegments(rawTitle: string) {
	if (rawTitle.includes("iX4") || rawTitle.includes("BMW iX4")) {
		return [
			{ text: "【公式発表】新型BMW iX4登場。", class: "title-phrase" },
			{ text: "次世代EV専用『ノイエ・クラッセ』SACが切り拓く", class: "title-phrase" },
			{ text: "航続828kmの新時代", class: "title-phrase" }
		];
	}
	if (rawTitle.includes("新型BMW 3シリーズ") || (rawTitle.includes("3シリーズ") && rawTitle.includes("直6"))) {
		return [
			{ text: "【公式発表】新型BMW 3シリーズ登場。", class: "title-phrase" },
			{ text: "完全電動『BMW i3』と", class: "title-phrase" },
			{ text: "直6搭載『M350 xDrive』が切り拓く新時代", class: "title-phrase" }
		];
	}
	if (rawTitle.includes("ノイエ・クラッセ")) {
		return [
			{ text: "【最新スクープ】2027年登場の", class: "title-phrase" },
			{ text: "次世代BMW 3シリーズ（ノイエ・クラッセ）は", class: "title-phrase" },
			{ text: "BEVと直6エンジンが共存へ", class: "title-phrase" }
		];
	}
	if (rawTitle.includes("。")) {
		const parts = rawTitle.split("。");
		return parts.map((p, idx) => ({
			text: idx < parts.length - 1 ? `${p}。` : p,
			class: "title-phrase"
		})).filter(p => p.text.length > 0);
	}
	return [{ text: rawTitle, class: "" }];
}

const titleSegments = getTitleSegments(post.data.title);

// 記事編集ページURL（EmDash Admin）
const postDbId = (post?.data as any)?.id;
const editUrl = postDbId 
	? `/_emdash/admin/content/posts/${postDbId}` 
	: "/_emdash/admin/content/posts";
---

<NicoleLayout 
