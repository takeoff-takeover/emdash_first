		padding-bottom: 14px;
		margin-bottom: 28px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.article-breadcrumb {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.6);
		min-width: 0;
	}

	.bc-link {
		color: rgba(255, 255, 255, 0.6);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.bc-link:hover {
		color: var(--color-nicole-red, #E60012);
	}

	.bc-sep {
		opacity: 0.3;
	}

	.bc-current {
		color: rgba(255, 255, 255, 0.7);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-width: 480px;
	}

	/* 編集ボタン（パンくず右端） */
	.article-edit-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 5px 12px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 4px;
		color: rgba(255, 255, 255, 0.85);
		font-size: 11.5px;
		font-weight: 600;
		text-decoration: none;
		letter-spacing: 0.05em;
		transition: all 0.2s ease;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.article-edit-btn:hover {
		background: rgba(255, 255, 255, 0.15);
		border-color: rgba(255, 255, 255, 0.35);
		color: #ffffff;
		transform: translateY(-1px);
	}

	.article-edit-btn .edit-icon {
		width: 13px;
		height: 13px;
	}

	/* タイトル（自然な文節改行を担保） */
	.article-main-title {
		font-family: -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Yu Gothic", "SF Pro Display", sans-serif;
		font-size: clamp(24px, 2.8vw, 40px);
		font-weight: 700;
		line-height: 1.48;
		letter-spacing: -0.01em;
		color: #ffffff;
		margin: 0 0 16px 0;
		max-width: 1200px;
		word-break: normal;
		overflow-wrap: break-word;
	}

	.article-main-title .title-phrase {
		display: inline-block;
	}

	/* リード文（サブタイトル） */
	.article-lead-text {
		font-size: clamp(16px, 1.4vw, 19px);
		line-height: 1.8;
		color: rgba(255, 255, 255, 0.85);
		margin: 0 0 24px 0;
		max-width: 980px;
		padding-left: 0;
		border-left: none;
	}

	/* メタ情報行（サブタイトルの下に配置） */
	.article-meta-row {
		display: flex;
		align-items: center;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 0;
	}

	.meta-brand-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 12px;
		background: var(--color-nicole-red, #E60012);
		color: #FFFFFF;
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.12em;
		border-radius: 999px;
	}

	.brand-dot {
		width: 5px;
		height: 5px;
		border-radius: 50%;
		background: #040507;
	}

	.meta-category-pill {
		padding: 4px 12px;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.12em;
		color: #ffffff;
		backdrop-filter: blur(8px);
	}

	.meta-date,
	.meta-reading-time {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.65);
		letter-spacing: 0.08em;
	}

	.meta-edit-pill {
		margin-left: auto;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 11px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 999px;
		color: rgba(255, 255, 255, 0.7);
		font-size: 11px;
		font-weight: 600;
		text-decoration: none;
		letter-spacing: 0.05em;
		transition: all 0.2s ease;
	}

	.meta-edit-pill:hover {
		background: rgba(230, 0, 18, 0.15);
		border-color: var(--color-nicole-red, #E60012);
		color: #ffffff;
		transform: translateY(-1px);
	}

	.meta-edit-pill svg {
		width: 12px;
		height: 12px;
	}

	/* ============================================================== */
	/* 1. 最上部フルブリード・アイキャッチ写真（下地なしヘッダー・グラデーション・写真内クレジット） */
	/* ============================================================== */
	.article-hero-media-wrap {
		width: 100%;
		padding-top: 0;
		background: #000000;
		overflow: hidden;
		position: relative;
	}

	/* 写真上部の薄いグレー/黒グラデーション（写真が白くてもヘッダー文字が見えるようにする） */
	.article-hero-top-scrim {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 180px;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.22) 55%, transparent 100%);
		pointer-events: none;
		z-index: 2;
	}

	.article-hero-img {
		width: 100%;
		height: clamp(460px, 72vh, 800px);
		object-fit: cover;
		display: block;
	}

	/* 写真の右下に重ねるクレジット（黒い余計な下地をなくす） */
	.article-photo-credit-overlay {
		position: absolute;
		bottom: 16px;
		right: 28px;
		z-index: 3;
		font-size: 11px;
		color: rgba(255, 255, 255, 0.7);
		letter-spacing: 0.04em;
		background: rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		padding: 4px 10px;
		border-radius: 3px;
		pointer-events: none;
	}

	/* ============================================================== */
	/* 3. 洗練された2カラムエディトリアルレイアウト（白・黒・赤ベース） */
	/* ============================================================== */
	:root {
		--color-nicole-red: #E60012;
		--color-nicole-red-hover: #D60000;
	}

	.article-content-wrapper {
		width: 100%;
		padding: 20px 0 120px 0;
		background: #06070a;
	}

	.article-two-col-layout {
		width: 100%;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 40px;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 340px;
		gap: 64px;
		align-items: start;
		box-sizing: border-box;
	}

	.article-main-col {
		width: 100%;
		max-width: 860px;
		min-width: 0;
	}

	/* サイドバー：シンプル・読みやすさ重視・スティッキー */
	.article-sidebar-col {
		width: 100%;
		min-width: 0;
	}

	.sidebar-sticky-panel {
		position: sticky;
		top: 120px;
	}

	.sidebar-block {
		background: rgba(255, 255, 255, 0.02);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 4px;
		padding: 28px 24px;
	}

	.sidebar-heading {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
		font-size: 16px;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: #ffffff;
		margin: 0 0 20px 0;
		padding-bottom: 12px;
		border-bottom: 2px solid var(--color-nicole-red);
	}

	.sidebar-story-list {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.sidebar-story-card {
		padding-bottom: 18px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.sidebar-story-card:last-child {
		padding-bottom: 0;
		border-bottom: none;
	}

	.sidebar-story-link {
		display: grid;
		grid-template-columns: 88px 1fr;
		gap: 14px;
		text-decoration: none;
		color: inherit;
		align-items: flex-start;
		transition: opacity 0.2s ease;
	}

	.sidebar-story-link:hover {
		opacity: 0.85;
	}

	.sidebar-story-media {
		position: relative;
		width: 88px;
		height: 64px;
		border-radius: 3px;
		overflow: hidden;
		background: #111111;
		flex-shrink: 0;
	}

	.sidebar-story-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.35s ease;
	}

	.sidebar-story-link:hover .sidebar-story-media img {
		transform: scale(1.08);
	}

	.sidebar-story-brand {
		position: absolute;
		top: 4px;
		left: 4px;
		background: rgba(0, 0, 0, 0.75);
		color: #FFFFFF;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.06em;
		padding: 2px 5px;
		border-radius: 2px;
		backdrop-filter: blur(4px);
	}

	.sidebar-story-body {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}

	.sidebar-story-date {
		font-size: 11px;
		color: rgba(255, 255, 255, 0.45);
		letter-spacing: 0.04em;
	}

	.sidebar-story-title {
		font-size: 13.5px;
		font-weight: 500;
		line-height: 1.45;
		color: rgba(255, 255, 255, 0.9);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.2s ease;
	}

	.sidebar-story-link:hover .sidebar-story-title {
		color: var(--color-nicole-red);
	}

	.sidebar-footer-link {
		margin-top: 22px;
		padding-top: 14px;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		text-align: right;
	}

	.sidebar-all-link {
		font-size: 12px;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.6);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.sidebar-all-link:hover {
		color: var(--color-nicole-red);
	}

	@media (max-width: 1080px) {
		.article-header-container,
		.article-two-col-layout {
			padding: 0 24px;
		}

		.article-two-col-layout {
			grid-template-columns: 1fr;
			gap: 50px;
		}

		.article-main-col {
			max-width: 100%;
		}

		.sidebar-sticky-panel {
			position: static;
		}
	}

	.article-rich-text {
		font-size: 17px;
		line-height: 1.95;
		color: #e4e6eb;
		letter-spacing: 0.02em;
	}

	/* 見出し（ゴールド縦線と下地なし・クリーンタイポグラフィ） */
	.article-rich-text :global(h2) {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
		font-size: clamp(24px, 2.4vw, 30px);
		font-weight: 700;
		color: #ffffff;
		margin: 64px 0 24px 0;
		padding: 0;
		border: none;
		background: none;
		line-height: 1.35;
	}

	.article-rich-text :global(h3) {
		font-size: 20px;
		font-weight: 700;
		color: var(--color-nicole-red, #E60012);
		margin: 44px 0 18px 0;
		line-height: 1.4;
	}

	.article-rich-text :global(p) {
		margin-bottom: 28px;
	}

	.article-rich-text :global(img) {
		width: 100%;
		border-radius: 12px;
		margin: 36px 0;
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.6);
	}

	/* ギャラリー内の全画像（スライド＆サムネイル）はリッチテキストのimg装飾を完全除外 */
	.article-rich-text :global(.cms-filmstrip-gallery img),
	.article-rich-text :global(.filmstrip-slide img),
	.article-rich-text :global(.filmstrip-thumb img) {
		width: 100% !important;
		height: 100% !important;
		object-fit: cover !important;
		margin: 0 !important;
		padding: 0 !important;
		border-radius: 0 !important;
		box-shadow: none !important;
		display: block !important;
	}

	.article-rich-text :global(blockquote) {
		margin: 36px 0;
		padding: 20px 24px;
		background: rgba(223, 186, 115, 0.05);
		border-left: 3px solid var(--color-nicole-red, #E60012);
		border-radius: 0 8px 8px 0;
		font-style: italic;
		color: rgba(255, 255, 255, 0.85);
	}

	.article-rich-text :global(a) {
		color: var(--color-nicole-red, #E60012);
		text-decoration: underline;
		text-underline-offset: 4px;
		transition: color 0.2s ease;
	}

	.article-rich-text :global(a:hover) {
		color: #FFFFFF;
	}

	/* ============================================================== */
	/* 4. スライダーギャラリーブロック（シンプル・枠線と背景なし・左右移動の楕円廃止） */
	/* ============================================================== */
	.gallery-slider-block {
		margin: 60px 0;
		padding: 0;
		background: transparent;
		border: none;
		border-radius: 0;
		box-shadow: none;
	}

	.block-header {
		margin-bottom: 20px;
	}

	.block-kicker {
		font-size: 10.5px;
		font-weight: 800;
		letter-spacing: 0.2em;
		color: var(--color-nicole-red, #E60012);
		display: block;
		margin-bottom: 6px;
	}

	.block-title {
		font-size: 22px;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 8px 0;
	}

	.block-sub {
		font-size: 13px;
		color: rgba(255, 255, 255, 0.55);
		margin: 0;
	}

	.slider-viewport {
		position: relative;
		overflow: hidden;
		border-radius: 10px;
		background: #000;
	}

	.slider-track {
		display: flex;
		transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
		width: 100%;
	}

	.slider-slide {
		min-width: 100%;
		display: flex;
		flex-direction: column;
	}

	.slide-media {
		position: relative;
		height: 440px;
		background: #000;
	}

	.slide-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.slide-badge {
		position: absolute;
		top: 14px;
		right: 14px;
		padding: 3px 10px;
		background: rgba(0, 0, 0, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		font-size: 11px;
		font-weight: 700;
		color: #ffffff;
		backdrop-filter: blur(6px);
	}

	.slide-info {
		padding: 14px 0 0 0;
		background: transparent;
	}

	.slide-heading {
		font-size: 15px;
		font-weight: 600;
		color: #ffffff;
		margin: 0 0 4px 0;
	}

	.slide-caption {
		font-size: 13px;
		color: rgba(255, 255, 255, 0.75);
		line-height: 1.6;
		margin: 0;
	}

	/* 左右移動の楕円をやめて、ミニマルで洗練されたフロート矢印に */
	.slider-btn {
		position: absolute;
		top: 40%;
		transform: translateY(-50%);
		width: auto;
		height: auto;
		padding: 10px;
		border-radius: 0;
		background: transparent;
		border: none;
		color: rgba(255, 255, 255, 0.85);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		backdrop-filter: none;
		transition: color 0.2s ease, transform 0.2s ease;
		z-index: 10;
		filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.9));
	}

	.slider-btn svg {
		width: 34px;
		height: 34px;
		stroke-width: 2.2;
	}

	.slider-btn:hover {
		background: transparent;
		color: #ffffff;
		transform: translateY(-50%) scale(1.15);
	}

	.slider-btn--prev { left: 8px; }
	.slider-btn--next { right: 8px; }

	.slider-thumbnails {
		display: flex;
		gap: 10px;
		margin-top: 14px;
		overflow-x: auto;
		padding-bottom: 6px;
	}

	.slider-thumb-btn {
		width: 80px;
		height: 52px;
		border-radius: 6px;
		overflow: hidden;
		border: 2px solid transparent;
		background: #000;
		padding: 0;
		cursor: pointer;
		flex-shrink: 0;
		opacity: 0.5;
		transition: opacity 0.25s ease, border-color 0.25s ease;
	}

	.slider-thumb-btn.is-active {
		border-color: #ffffff;
		opacity: 1;
	}

	.slider-thumb-btn img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* ============================================================== */
	/* 5. FAQ / アコーディオン（枠線・下地なし、テキストと同じ左右幅） */
	/* ============================================================== */
	.accordion-details-block {
		margin: 60px 0;
		padding: 0;
		background: transparent;
		border: none;
		border-radius: 0;
		width: 100%;
		box-shadow: none;
	}

	.modern-accordion-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.accordion-item {
		background: transparent;
		border: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 0;
		overflow: hidden;
		transition: border-color 0.25s ease;
	}

	.accordion-item:first-child {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.accordion-item[open] {
		border-color: rgba(255, 255, 255, 0.22);
		background: transparent;
	}

	.accordion-summary {
		padding: 22px 0;
		font-size: 16px;
		font-weight: 700;
		color: #ffffff;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		user-select: none;
		list-style: none;
	}

	.accordion-summary::-webkit-details-marker {
		display: none;
	}

	.accordion-icon {
		font-size: 18px;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.7);
		transition: transform 0.3s ease;
	}

	.accordion-item[open] .accordion-icon {
		transform: rotate(45deg);
	}

	.accordion-content {
		padding: 0 0 24px 0;
		font-size: 15px;
		line-height: 1.85;
		color: rgba(255, 255, 255, 0.8);
	}

	.accordion-content p {
		margin: 0;
	}

	/* ============================================================== */
	/* 関連ショールームカード */
	/* ============================================================== */
	.showroom-feature-block {
		margin: 70px 0;
	}

	.showroom-card-modern {
		display: grid;
		grid-template-columns: 320px 1fr;
		background: #090b0e;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
	}

	.showroom-card-media {
		position: relative;
		background: #000;
	}

	.showroom-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.showroom-brand-tag {
		position: absolute;
		top: 14px;
		left: 14px;
		padding: 3px 10px;
		background: rgba(4, 5, 7, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		font-size: 10.5px;
		font-weight: 700;
		color: #ffffff;
		backdrop-filter: blur(6px);
	}

	.showroom-card-body {
		padding: 32px;
		display: flex;
		flex-direction: column;
	}

	.showroom-kicker {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.5);
		margin-bottom: 6px;
	}

	.showroom-title {
		font-size: 20px;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 4px 0;
	}

	.showroom-sub {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.5);
		margin: 0 0 20px 0;
	}

	.showroom-details {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-bottom: 24px;
		padding: 16px;
		background: rgba(255, 255, 255, 0.03);
		border-radius: 8px;
	}

	.detail-row {
		display: flex;
		align-items: baseline;
		gap: 14px;
		font-size: 12.5px;
	}

	.detail-label {
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.45);
		width: 90px;
		flex-shrink: 0;
	}

	.detail-val {
		color: rgba(255, 255, 255, 0.85);
	}

	.showroom-actions {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: auto;
		flex-wrap: wrap;
	}

	.btn-showroom-detail {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 11px 22px;
		background: #ffffff;
