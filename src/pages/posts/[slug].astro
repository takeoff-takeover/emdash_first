	}

	/* ============================================================== */
	/* 1. 記事ヘッダー（Nロゴの左端ラインと均等配置） */
	/* ============================================================== */
	.article-header-section {
		width: 100%;
		padding-top: 48px;
		padding-bottom: 0;
		background: #06070a;
	}

	.article-header-container {
		width: 100%;
		max-width: 1400px;
		margin: 0 auto;
