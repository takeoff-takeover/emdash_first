	.sidebar-story-card {
		padding-bottom: 18px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.sidebar-story-card:last-child {
		padding-bottom: 0;
		border-bottom: none;
	}

	.sidebar-story-link {
		display: grid;
		grid-template-columns: 88px 1fr;
		gap: 14px;
		text-decoration: none;
		color: inherit;
		align-items: flex-start;
		transition: opacity 0.2s ease;
	}

	.sidebar-story-link:hover {
		opacity: 0.85;
	}

	.sidebar-story-media {
		position: relative;
		width: 88px;
		height: 64px;
		border-radius: 3px;
		overflow: hidden;
		background: #111111;
		flex-shrink: 0;
	}

	.sidebar-story-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.35s ease;
	}

	.sidebar-story-link:hover .sidebar-story-media img {
		transform: scale(1.08);
	}

	.sidebar-story-brand {
		position: absolute;
		top: 4px;
		left: 4px;
		background: rgba(0, 0, 0, 0.75);
		color: #FFFFFF;
		font-size: 8px;
		font-weight: 700;
		letter-spacing: 0.06em;
		padding: 2px 5px;
		border-radius: 2px;
		backdrop-filter: blur(4px);
	}

	.sidebar-story-body {
		display: flex;
		flex-direction: column;
		gap: 4px;
		min-width: 0;
	}

	.sidebar-story-date {
		font-size: 11px;
		color: rgba(255, 255, 255, 0.45);
		letter-spacing: 0.04em;
	}

	.sidebar-story-title {
		font-size: 13.5px;
		font-weight: 500;
		line-height: 1.45;
		color: rgba(255, 255, 255, 0.9);
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.2s ease;
	}

	.sidebar-story-link:hover .sidebar-story-title {
		color: var(--color-nicole-red);
	}

	.sidebar-footer-link {
		margin-top: 22px;
		padding-top: 14px;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		text-align: right;
	}

	.sidebar-all-link {
		font-size: 12px;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.6);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.sidebar-all-link:hover {
		color: var(--color-nicole-red);
	}

	@media (max-width: 1080px) {
		.article-header-container,
		.article-two-col-layout {
			padding: 0 24px;
		}

		.article-two-col-layout {
			grid-template-columns: 1fr;
			gap: 50px;
		}

		.article-main-col {
			max-width: 100%;
		}

		.sidebar-sticky-panel {
			position: static;
		}
	}

	.article-rich-text {
		font-size: 17px;
		line-height: 1.95;
		color: #e4e6eb;
		letter-spacing: 0.02em;
	}

	/* 見出し（ゴールド縦線と下地なし・クリーンタイポグラフィ） */
	.article-rich-text :global(h2) {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
		font-size: clamp(24px, 2.4vw, 30px);
		font-weight: 700;
		color: #ffffff;
		margin: 64px 0 24px 0;
		padding: 0;
		border: none;
		background: none;
		line-height: 1.35;
	}

	.article-rich-text :global(h3) {
		font-size: 20px;
		font-weight: 700;
		color: var(--color-nicole-red, #E60012);
		margin: 44px 0 18px 0;
		line-height: 1.4;
	}

	.article-rich-text :global(p) {
		margin-bottom: 28px;
	}

	.article-rich-text :global(img) {
		width: 100%;
		border-radius: 12px;
		margin: 36px 0;
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.6);
	}

	.article-rich-text :global(blockquote) {
		margin: 36px 0;
		padding: 20px 24px;
		background: rgba(223, 186, 115, 0.05);
		border-left: 3px solid var(--color-nicole-red, #E60012);
		border-radius: 0 8px 8px 0;
		font-style: italic;
		color: rgba(255, 255, 255, 0.85);
	}

	.article-rich-text :global(a) {
		color: var(--color-nicole-red, #E60012);
		text-decoration: underline;
		text-underline-offset: 4px;
		transition: color 0.2s ease;
	}

	.article-rich-text :global(a:hover) {
		color: #FFFFFF;
	}

	/* ============================================================== */
	/* 4. スライダーギャラリーブロック（シンプル・枠線と背景なし・左右移動の楕円廃止） */
	/* ============================================================== */
	.gallery-slider-block {
		margin: 60px 0;
		padding: 0;
		background: transparent;
		border: none;
		border-radius: 0;
		box-shadow: none;
	}

	.block-header {
		margin-bottom: 20px;
	}

	.block-kicker {
		font-size: 10.5px;
		font-weight: 800;
		letter-spacing: 0.2em;
		color: var(--color-nicole-red, #E60012);
		display: block;
		margin-bottom: 6px;
	}

	.block-title {
		font-size: 22px;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 8px 0;
	}

	.block-sub {
		font-size: 13px;
		color: rgba(255, 255, 255, 0.55);
		margin: 0;
	}

	.slider-viewport {
		position: relative;
		overflow: hidden;
		border-radius: 10px;
		background: #000;
	}

	.slider-track {
		display: flex;
		transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
		width: 100%;
	}

	.slider-slide {
		min-width: 100%;
		display: flex;
		flex-direction: column;
	}

	.slide-media {
		position: relative;
		height: 440px;
		background: #000;
	}

	.slide-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.slide-badge {
		position: absolute;
		top: 14px;
		right: 14px;
		padding: 3px 10px;
		background: rgba(0, 0, 0, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		font-size: 11px;
		font-weight: 700;
		color: #ffffff;
		backdrop-filter: blur(6px);
	}

	.slide-info {
		padding: 14px 0 0 0;
		background: transparent;
	}

	.slide-heading {
		font-size: 15px;
		font-weight: 600;
		color: #ffffff;
		margin: 0 0 4px 0;
	}

	.slide-caption {
		font-size: 13px;
		color: rgba(255, 255, 255, 0.75);
		line-height: 1.6;
		margin: 0;
	}

	/* 左右移動の楕円をやめて、ミニマルで洗練されたフロート矢印に */
	.slider-btn {
		position: absolute;
		top: 40%;
		transform: translateY(-50%);
		width: auto;
		height: auto;
		padding: 10px;
		border-radius: 0;
		background: transparent;
		border: none;
		color: rgba(255, 255, 255, 0.85);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		backdrop-filter: none;
		transition: color 0.2s ease, transform 0.2s ease;
		z-index: 10;
		filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.9));
	}

	.slider-btn svg {
		width: 34px;
		height: 34px;
		stroke-width: 2.2;
	}

	.slider-btn:hover {
		background: transparent;
		color: #ffffff;
		transform: translateY(-50%) scale(1.15);
	}

	.slider-btn--prev { left: 8px; }
	.slider-btn--next { right: 8px; }

	.slider-thumbnails {
		display: flex;
		gap: 10px;
		margin-top: 14px;
		overflow-x: auto;
		padding-bottom: 6px;
	}

	.slider-thumb-btn {
		width: 80px;
		height: 52px;
		border-radius: 6px;
		overflow: hidden;
		border: 2px solid transparent;
		background: #000;
		padding: 0;
		cursor: pointer;
		flex-shrink: 0;
		opacity: 0.5;
		transition: opacity 0.25s ease, border-color 0.25s ease;
	}

	.slider-thumb-btn.is-active {
		border-color: #ffffff;
		opacity: 1;
	}

	.slider-thumb-btn img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* ============================================================== */
	/* 5. FAQ / アコーディオン（枠線・下地なし、テキストと同じ左右幅） */
	/* ============================================================== */
	.accordion-details-block {
		margin: 60px 0;
		padding: 0;
		background: transparent;
		border: none;
		border-radius: 0;
		width: 100%;
		box-shadow: none;
	}

	.modern-accordion-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.accordion-item {
		background: transparent;
		border: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 0;
		overflow: hidden;
		transition: border-color 0.25s ease;
	}

	.accordion-item:first-child {
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}

	.accordion-item[open] {
		border-color: rgba(255, 255, 255, 0.22);
		background: transparent;
	}

	.accordion-summary {
		padding: 22px 0;
		font-size: 16px;
		font-weight: 700;
		color: #ffffff;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		user-select: none;
		list-style: none;
	}

	.accordion-summary::-webkit-details-marker {
		display: none;
	}

	.accordion-icon {
		font-size: 18px;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.7);
		transition: transform 0.3s ease;
	}

	.accordion-item[open] .accordion-icon {
		transform: rotate(45deg);
	}

	.accordion-content {
		padding: 0 0 24px 0;
		font-size: 15px;
		line-height: 1.85;
		color: rgba(255, 255, 255, 0.8);
	}

	.accordion-content p {
		margin: 0;
	}

	/* ============================================================== */
	/* 関連ショールームカード */
	/* ============================================================== */
	.showroom-feature-block {
		margin: 70px 0;
	}

	.showroom-card-modern {
		display: grid;
		grid-template-columns: 320px 1fr;
		background: #090b0e;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 16px;
		overflow: hidden;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
	}

	.showroom-card-media {
		position: relative;
		background: #000;
	}

	.showroom-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.showroom-brand-tag {
		position: absolute;
		top: 14px;
		left: 14px;
		padding: 3px 10px;
		background: rgba(4, 5, 7, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		font-size: 10.5px;
		font-weight: 700;
		color: #ffffff;
		backdrop-filter: blur(6px);
	}

	.showroom-card-body {
		padding: 32px;
		display: flex;
		flex-direction: column;
	}

	.showroom-kicker {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.5);
		margin-bottom: 6px;
	}

	.showroom-title {
		font-size: 20px;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 4px 0;
	}

	.showroom-sub {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.5);
		margin: 0 0 20px 0;
	}

	.showroom-details {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-bottom: 24px;
		padding: 16px;
		background: rgba(255, 255, 255, 0.03);
		border-radius: 8px;
	}

	.detail-row {
		display: flex;
		align-items: baseline;
		gap: 14px;
		font-size: 12.5px;
	}

	.detail-label {
		font-size: 9.5px;
		font-weight: 700;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.45);
		width: 90px;
		flex-shrink: 0;
	}

	.detail-val {
		color: rgba(255, 255, 255, 0.85);
	}

	.showroom-actions {
		display: flex;
		align-items: center;
		gap: 16px;
		margin-top: auto;
		flex-wrap: wrap;
	}

	.btn-showroom-detail {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 11px 22px;
		background: #ffffff;
		color: #000000;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.06em;
		border-radius: 4px;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.btn-showroom-detail svg {
		width: 14px;
		height: 14px;
		transition: transform 0.25s ease;
	}

	.btn-showroom-detail:hover {
		background: rgba(255, 255, 255, 0.85);
		transform: translateY(-2px);
	}

	.btn-showroom-detail:hover svg {
		transform: translateX(3px);
	}

	.btn-showroom-map {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.6);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.btn-showroom-map:hover {
		color: var(--color-nicole-red, #E60012);
	}

	/* ============================================================== */
	/* シェアバー ＆ バックリンク */
	/* ============================================================== */
	.article-share-bar {
		margin: 60px 0 40px 0;
		padding: 24px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 12px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
	}

	.share-label {
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: rgba(255, 255, 255, 0.7);
	}

	.share-buttons {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-wrap: wrap;
	}

	.share-btn {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 999px;
		font-size: 12px;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		cursor: pointer;
		transition: all 0.25s ease;
	}

	.share-btn svg {
		width: 14px;
		height: 14px;
	}

	.share-btn:hover {
		background: rgba(255, 255, 255, 0.15);
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.35);
	}

	.article-back-nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		margin-top: 50px;
	}

	.btn-back-to-magazine {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 12px 28px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: #ffffff;
		border-radius: 999px;
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.btn-back-to-magazine svg {
		width: 16px;
		height: 16px;
		transition: transform 0.3s ease;
	}

	.btn-back-to-magazine:hover {
		background: #ffffff;
		color: #000000;
		border-color: #ffffff;
	}

	.btn-back-to-magazine:hover svg {
		transform: translateX(-4px);
	}

	.btn-edit-article-admin {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 11px 22px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 999px;
		color: rgba(255, 255, 255, 0.85);
		font-size: 13px;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-decoration: none;
		transition: all 0.25s ease;
	}

	.btn-edit-article-admin:hover {
		background: rgba(230, 0, 18, 0.15);
		border-color: var(--color-nicole-red, #E60012);
		color: #ffffff;
		transform: translateY(-2px);
	}

	.btn-edit-article-admin svg {
		width: 14px;
		height: 14px;
	}

	/* ============================================================== */
	/* 3. おすすめ記事セクション */
	/* ============================================================== */
	.recommended-stories-section {
		padding: 80px 0 100px 0;
		background: #040507;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.recommended-container {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 30px;
	}

	.recommended-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 36px;
		padding-bottom: 16px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.rec-kicker {
		font-size: 10.5px;
		font-weight: 800;
		letter-spacing: 0.22em;
		color: var(--color-nicole-red, #E60012);
		display: block;
		margin-bottom: 4px;
	}

	.rec-title {
		font-size: 24px;
		font-weight: 700;
		color: #ffffff;
		margin: 0;
	}

	.rec-all-link {
		font-size: 12.5px;
		color: rgba(255, 255, 255, 0.6);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.rec-all-link:hover {
		color: var(--color-nicole-red, #E60012);
	}

	.recommended-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.rec-card {
		background: #090b0e;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
	}

	.rec-card:hover {
		transform: translateY(-5px);
		border-color: rgba(223, 186, 115, 0.4);
		box-shadow: 0 14px 30px rgba(0, 0, 0, 0.6);
	}

	.rec-card-link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.rec-card-media {
		position: relative;
		height: 190px;
		background: #000;
		overflow: hidden;
	}

	.rec-card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.rec-card:hover .rec-card-media img {
		transform: scale(1.05);
	}

	.rec-card-brand {
		position: absolute;
		top: 12px;
		left: 12px;
		padding: 3px 9px;
		background: rgba(4, 5, 7, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		font-size: 10px;
		font-weight: 700;
		color: #ffffff;
		backdrop-filter: blur(6px);
	}

	.rec-card-body {
		padding: 20px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.rec-card-meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		color: var(--color-nicole-red, #E60012);
		font-weight: 600;
		margin-bottom: 8px;
	}

	.rec-meta-sep {
		opacity: 0.4;
		color: rgba(255, 255, 255, 0.4);
	}

	.rec-card-title {
		font-size: 14.5px;
		font-weight: 600;
		line-height: 1.45;
		color: #ffffff;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.25s ease;
	}

	.rec-card:hover .rec-card-title {
		color: var(--color-nicole-red, #E60012);
	}

	/* ============================================================== */
	/* レスポンシブ対応 */
	/* ============================================================== */
	@media (max-width: 992px) {
		.showroom-card-modern {
			grid-template-columns: 1fr;
		}

		.showroom-card-media {
			height: 220px;
		}

		.recommended-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 768px) {
		.article-header-container,
		.article-two-col-layout {
			padding: 0 20px;
		}

		.article-header-section {
			padding-top: 36px;
			padding-bottom: 0;
		}

		.article-header-container {
