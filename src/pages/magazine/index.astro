					</div>
					<h3 class="no-articles-title">該当する記事が見つかりませんでした</h3>
					<p class="no-articles-desc">選択中のブランドまたは検索キーワードを変更してお試しください。</p>
					<button type="button" id="btn-reset-filters" class="btn-reset-filters">すべてのフィルターを解除</button>
				</div>
			</div>
		</section>
	</main>
</NicoleLayout>

<!-- 3Dブックカバー傾き＆光沢シマー＆フィルター制御スクリプト -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		// ==============================================================
		// 1. 本の表紙 3Dジャイロ傾き＆金箔押しシマー効果
		// ==============================================================
		const bookWrapper = document.getElementById('book-perspective-wrapper');
		const bookObject = document.getElementById('interactive-book-cover');
		const glareFoil = document.getElementById('book-glare-foil');

		if (bookWrapper && bookObject) {
			let isHovered = false;

			bookWrapper.addEventListener('mouseenter', () => {
				isHovered = true;
				bookObject.style.transition = 'transform 0.15s ease-out, box-shadow 0.15s ease-out';
			});

			bookWrapper.addEventListener('mousemove', (e) => {
				if (!isHovered) return;
				const rect = bookWrapper.getBoundingClientRect();
				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;

				const centerX = rect.width / 2;
				const centerY = rect.height / 2;

				// -1 to 1 の正規化オフセット
				const offsetX = (x - centerX) / centerX;
				const offsetY = (y - centerY) / centerY;

				// 最大12度の立体チルト
				const rotateY = offsetX * 14;
				const rotateX = -offsetY * 12;

				bookObject.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;

				// 光沢シマー（グレア）の反射位置計算
				if (glareFoil) {
					const glareX = ((x / rect.width) * 100).toFixed(1);
					const glareY = ((y / rect.height) * 100).toFixed(1);
					glareFoil.style.background = `radial-gradient(circle at ${glareX}% ${glareY}%, rgba(255, 230, 180, 0.45) 0%, rgba(212, 175, 55, 0.15) 35%, transparent 70%)`;
					glareFoil.style.opacity = '1';
				}
			});

			bookWrapper.addEventListener('mouseleave', () => {
				isHovered = false;
				// スプリングのように元の角度へスムーズに復帰
				bookObject.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
				bookObject.style.transform = 'rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)';
				if (glareFoil) {
					glareFoil.style.opacity = '0';
				}
			});
		}

		// ==============================================================
		// 2. インタラクティブ・フィルタリング制御
		// ==============================================================
		let currentBrand = 'ALL';
		let currentTopic = 'ALL';
		let searchQuery = '';

		const brandPills = document.querySelectorAll('#brand-filters .filter-pill');
		const topicSelect = document.getElementById('topic-select');
		const searchInput = document.getElementById('article-search-input');
		const articles = document.querySelectorAll('.article-item');
		const countDisplay = document.getElementById('current-article-count');
		const noArticles = document.getElementById('no-articles');
		const resetBtn = document.getElementById('btn-reset-filters');

		function applyFilters() {
			let visibleCount = 0;

			articles.forEach(article => {
				const brand = article.getAttribute('data-brand') || '';
				const topic = article.getAttribute('data-topic') || '';
				const title = article.getAttribute('data-title') || '';
				const lead = article.getAttribute('data-lead') || '';

				const matchBrand = (currentBrand === 'ALL') || (brand === currentBrand);
				const matchTopic = (currentTopic === 'ALL') || (topic === currentTopic);
				const matchSearch = (!searchQuery) || (title.includes(searchQuery) || lead.includes(searchQuery) || brand.toLowerCase().includes(searchQuery));

				if (matchBrand && matchTopic && matchSearch) {
					article.style.display = '';
					visibleCount++;
				} else {
					article.style.display = 'none';
				}
			});

			if (countDisplay) {
				countDisplay.textContent = visibleCount.toString();
			}

			if (noArticles) {
				if (visibleCount === 0) {
					noArticles.style.display = 'block';
				} else {
					noArticles.style.display = 'none';
				}
			}
		}

		// ブランドピルクリック切り替え
		brandPills.forEach(pill => {
			pill.addEventListener('click', (e) => {
				brandPills.forEach(p => p.classList.remove('is-active'));
				pill.classList.add('is-active');
				currentBrand = pill.getAttribute('data-value') || 'ALL';
				applyFilters();
			});
		});

		// カテゴリーセレクト切り替え
		if (topicSelect) {
			topicSelect.addEventListener('change', (e) => {
				currentTopic = e.target.value;
				applyFilters();
			});
		}

		// インクリメンタルキーワード検索
		if (searchInput) {
			searchInput.addEventListener('input', (e) => {
				searchQuery = e.target.value.toLowerCase().trim();
				applyFilters();
			});
		}

		// リセットボタン
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				currentBrand = 'ALL';
				currentTopic = 'ALL';
				searchQuery = '';

				brandPills.forEach(p => {
					if (p.getAttribute('data-value') === 'ALL') p.classList.add('is-active');
					else p.classList.remove('is-active');
				});

				if (topicSelect) topicSelect.value = 'ALL';
				if (searchInput) searchInput.value = '';

				applyFilters();
			});
		}
	});
</script>

