<NicoleLayout 
	title="Nicole Connect - Web Magazine ｜ ニコル・グループ公式" 
	description="Appleのような大迫力のビジュアルと洗練されたエディトリアルで綴るWebマガジン「Nicole Connect」。BMW、MINI、フェラーリ、ロールス・ロイス、アルピナの最新モデル情報から特集記事まで。"
	isMagazine={true}
>
	<main class="apple-magazine-main">
		<!-- ============================================================== -->
		<!-- 1. Apple風 特大マガジンカバー・HERO（画面全体に写真を大胆に使用） -->
		<!-- ============================================================== -->
		<section class="apple-hero" id="hero-cover">
			<!-- 巨大背景画像コンテナ（スクロール視差パララックス対応） -->
			<div class="apple-hero__media" id="apple-hero-media">
				<img 
					src={coverArticle.image} 
					alt={coverArticle.title} 
					class="apple-hero__img" 
					id="apple-hero-img"
					loading="eager" 
				/>
				<!-- 映画的なダークビネットとグラデーション -->
				<div class="apple-hero__gradient"></div>
				<div class="apple-hero__side-vignette"></div>
			</div>



			<!-- 表紙コンテンツ（Apple風の大胆かつ洗練されたタイポグラフィ） -->
			<div class="apple-hero__content">
				<div class="mag-container apple-hero__container">
					<!-- センター：目玉記事の超巨大ヘッドライン ＆ コピー -->
					<div class="apple-hero__center">
						<h1 class="apple-hero__title">
							{coverArticle.id === "2027_new_bmw_ix4_neue_klasse" || coverArticle.slug === "2027_new_bmw_ix4_neue_klasse" 
								? "THE ALL-NEW BMW iX4." 
								: coverArticle.title}
						</h1>

						<p class="apple-hero__lead">
							{coverArticle.id === "2027_new_bmw_ix4_neue_klasse" || coverArticle.slug === "2027_new_bmw_ix4_neue_klasse"
								? "【世界初公開】BMWノイエ・クラッセ初の完全電動スポーツ・アクティビティ・クーペ。流麗なファストバック造形、最高出力612馬力のM60 xDrive、そして航続828kmが切り拓く新時代。"
								: coverArticle.lead}
						</p>

						<!-- Apple風の洗練されたアクションボタン群 -->
						<div class="apple-hero__actions">
							<a href={coverArticle.url} class="apple-cta-btn apple-cta-btn--secondary">
								<span>記事を読む</span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							</a>
						</div>
					</div>
				</div>
			</div>

			<!-- スクロール促進インジケーター -->
			<a href="#table-of-contents" class="apple-hero__scroll-cue" aria-label="コンテンツへスクロール">
				<span class="scroll-cue-text">SCROLL TO READ</span>
				<div class="scroll-cue-line"></div>
			</a>
		</section>

		<!-- ============================================================== -->
		<!-- 2. 最新記事ハイライト（LATEST STORIES） -->
		<!-- ============================================================== -->
		<section class="toc-section" id="table-of-contents">
			<div class="mag-container">
				<div class="toc-header">
					<h2 class="toc-heading">LATEST STORIES</h2>
					<p class="toc-sub">Nicoleが厳選した最新の特集ストーリーをお届けします。</p>
				</div>

				<div class="toc-grid">
					{highlightStories.map((story) => (
						<article class="toc-card">
							<a href={story.url} class="toc-card__link">
								<div class="toc-card__media">
									<img src={story.image} alt={story.title} loading="lazy" class="toc-card__img" />
									<div class="toc-card__overlay"></div>
									<span class="toc-card__brand">{story.brand}</span>
								</div>
								<div class="toc-card__body">
									<div class="toc-card__meta">
										<span class="toc-meta-topic">{story.topic}</span>
										<span class="toc-meta-sep">/</span>
										<time class="toc-meta-date">{story.date}</time>
									</div>
									<h3 class="toc-card__title">{story.title}</h3>
									{story.lead && <p class="toc-card__lead">{story.lead}</p>}
									<div class="toc-card__arrow">
										<span>記事を読む</span>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
									</div>
								</div>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- 3. インタラクティブ・フィルターバー（Stickyナビゲーション） -->
		<!-- ============================================================== -->
		<section class="filter-sticky-bar" id="magazine-archive">
			<div class="mag-container">
				<div class="filter-wrap">
					<!-- ブランドフィルター（メインタブ） -->
					<div class="filter-group filter-group--brand">
						<span class="filter-group__label">BRAND:</span>
						<div class="filter-pills" id="brand-filters">
							{brandsList.map((b) => (
								<button 
									type="button" 
									class={`filter-pill ${b === 'ALL' ? 'is-active' : ''}`} 
									data-filter-type="brand" 
									data-value={b}
								>
									{b}
								</button>
							))}
						</div>
					</div>

					<!-- トピックフィルター ＆ 検索バー -->
					<div class="filter-controls-right">
						<div class="filter-group filter-group--topic">
							<span class="filter-group__label">CATEGORY:</span>
							<select id="topic-select" class="topic-dropdown" aria-label="カテゴリーを選択">
								{topicsList.map((t) => (
									<option value={t}>{t === 'ALL' ? 'すべてのカテゴリー' : t}</option>
								))}
							</select>
						</div>

						<!-- キーワード検索 -->
						<div class="filter-search-box">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
							<input 
								type="text" 
								id="article-search-input" 
								placeholder="記事をキーワード検索..." 
								aria-label="記事をキーワード検索"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- 4. 全記事エディトリアルグリッド（LIBRARY / ARCHIVE） -->
		<!-- ============================================================== -->
		<section class="all-articles-section">
			<div class="mag-container">
				<div class="section-title-bar">
					<div>
						<h2 class="section-heading">ALL STORIES & ESSAYS</h2>
					</div>
					<div class="count-display">
						収録記事：<span id="current-article-count">{initialArchiveCount}</span>篇
					</div>
				</div>

				<!-- 記事グリッド（JSフィルタリング対象） -->
				<div class="articles-grid" id="articles-grid">
					{mainArticles.map((art) => (
						<article 
							class="article-item" 
							data-id={art.id}
							data-is-top3={top3ArticleIds.has(art.id) ? "true" : "false"}
							data-brand={art.brand} 
							data-topic={art.topic}
							data-title={art.title.toLowerCase()}
							data-lead={art.lead ? art.lead.toLowerCase() : ''}
						>
							<a href={art.url} class="article-item__link">
								<div class="article-item__media">
									<img src={art.image} alt={art.title} loading="lazy" class="article-item__img" />
									<div class="article-item__overlay"></div>
									<span class="article-brand-pill">{art.brand}</span>
								</div>
								<div class="article-item__body">
									<div class="article-item__meta">
										<time class="meta-date">{art.date}</time>
										<span class="meta-divider">/</span>
										<span class="meta-topic">{art.topic}</span>
									</div>
									<h3 class="article-item__title">{art.title}</h3>
									{art.lead && <p class="article-item__lead">{art.lead}</p>}
									<div class="article-item__footer">
										<span class="article-item__more">記事を読む →</span>
										<span class="article-item__views">👁 {art.views}</span>
									</div>
								</div>
							</a>
						</article>
					))}
				</div>

				<!-- 「もっと見る」ボタン（初期9件、クリックで古い記事を順次展開） -->
				<div class="all-articles-more-wrap" id="articles-more-wrap" style="display: none;">
					<button type="button" id="btn-articles-load-more" class="btn-articles-load-more">
						<span class="btn-articles-load-more__text">もっと見る</span>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-articles-load-more__icon"><path d="M6 9l6 6 6-6"/></svg>
					</button>
				</div>

				<!-- 検索該当なしプレースホルダー -->
				<div id="no-articles" class="no-articles-state" style="display: none;">
					<div class="no-articles-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><line x1="8" x2="14" y1="11" y2="11"/></svg>
					</div>
					<h3 class="no-articles-title">該当する記事が見つかりませんでした</h3>
					<p class="no-articles-desc">選択中のブランドまたは検索キーワードを変更してお試しください。</p>
					<button type="button" id="btn-reset-filters" class="btn-reset-filters">すべてのフィルターを解除</button>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- 5. ESG / SDGs 専用ブロック（SUSTAINABILITY & COMMUNITY） -->
		<!-- ============================================================== -->
		<section class="magazine-esg-section" id="esg-section">
			<div class="mag-container">
				<div class="esg-section__header">
					<div class="esg-section__titles">
						<span class="esg-section__eyebrow">SUSTAINABILITY & COMMUNITY</span>
						<h2 class="esg-section__heading">ESG / SDGs — 持続可能な未来への取り組み</h2>
						<p class="esg-section__desc">地域社会への貢献、環境保全、そして未来を担う次世代育成。ニコル・グループが取り組む活動の歩みをお届けします。</p>
					</div>
					<a href="/esg_sdgs" class="esg-section__portal-link">
						<span>ニコル・グループのESG方針を見る</span>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
					</a>
				</div>

				<!-- 4カラム・コンパクトカードグリッド（初期4件、もっと見るで展開） -->
				<div class="esg-cards-grid" id="esg-cards-grid">
					{esgArticles.map((art, index) => (
						<article class={`esg-card ${index >= 4 ? 'is-collapsed' : ''}`} data-esg-index={index}>
							<a href={art.url} class="esg-card__link">
								<div class="esg-card__media">
									<img src={art.image} alt={art.title} loading="lazy" class="esg-card__img" />
									<span class="esg-card__badge">ESG / SDGs</span>
								</div>
								<div class="esg-card__body">
									<time class="esg-card__date">{art.date}</time>
									<h3 class="esg-card__title">{art.title}</h3>
								</div>
							</a>
						</article>
					))}
				</div>

				{esgArticles.length > 4 && (
					<div class="esg-more-wrap">
						<button type="button" id="btn-toggle-esg-more" class="btn-esg-more" data-total={esgArticles.length}>
							<span class="btn-esg-more__text">もっと見る（全{esgArticles.length}件）</span>
							<svg class="btn-esg-more__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
						</button>
					</div>
				)}
			</div>
		</section>
	</main>
</NicoleLayout>

<!-- Apple風スクロールパララックス＆フィルタリング制御スクリプト -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		// ==============================================================
		// 1. Apple風 スクロールパララックス＆ズーム効果
		// ==============================================================
		const heroImg = document.getElementById('apple-hero-img');
		const heroSection = document.getElementById('hero-cover');

		if (heroImg && heroSection) {
			let ticking = false;

			window.addEventListener('scroll', () => {
				if (!ticking) {
					window.requestAnimationFrame(() => {
						const scrollY = window.scrollY;
						const heroHeight = heroSection.offsetHeight;

						if (scrollY <= heroHeight) {
							// スクロールに合わせて背景画像がわずかにゆっくり動き（パララックス）、奥へと引く
							const translateY = scrollY * 0.35;
							const scale = 1.05 - (scrollY / heroHeight) * 0.05;
							heroImg.style.transform = `translate3d(0, ${translateY}px, 0) scale(${Math.max(scale, 1)})`;
						}
						ticking = false;
					});
					ticking = true;
				}
			}, { passive: true });
		}

		// ==============================================================
		// 2. インタラクティブ・フィルタリング＆「もっと見る」制御（初期9件、古い記事を展開）
		// ==============================================================
		const INITIAL_COUNT = 9;
		const LOAD_STEP = 9;
		let visibleCount = INITIAL_COUNT;
		let currentBrand = 'ALL';
		let currentTopic = 'ALL';
		let searchQuery = '';

		const brandPills = document.querySelectorAll('#brand-filters .filter-pill');
		const topicSelect = document.getElementById('topic-select');
		const searchInput = document.getElementById('article-search-input');
		const articles = Array.from(document.querySelectorAll('.article-item'));
		const countDisplay = document.getElementById('current-article-count');
		const noArticles = document.getElementById('no-articles');
		const resetBtn = document.getElementById('btn-reset-filters');
		const moreWrap = document.getElementById('articles-more-wrap');
		const loadMoreBtn = document.getElementById('btn-articles-load-more');

		function applyFilters(resetCount = true) {
			if (resetCount) {
				visibleCount = INITIAL_COUNT;
			}

			// 絞り込み（ブランド/カテゴリー）または検索が行われているか
			const isFiltered = (currentBrand !== 'ALL') || (currentTopic !== 'ALL') || (searchQuery.length > 0);

			const matchedArticles = [];

			articles.forEach(article => {
				const isTop3 = article.getAttribute('data-is-top3') === 'true';
				const brand = article.getAttribute('data-brand') || '';
				const topic = article.getAttribute('data-topic') || '';
				const title = article.getAttribute('data-title') || '';
				const lead = article.getAttribute('data-lead') || '';

				// 初期状態（絞り込みなし）では最新3記事を除外。
				// ブランドやカテゴリーの絞り込み、またはキーワード検索時は最新3記事も含めてマッチ判定
				if (!isFiltered && isTop3) {
					article.style.display = 'none';
					return;
				}

				const matchBrand = (currentBrand === 'ALL') || (brand === currentBrand);
				const matchTopic = (currentTopic === 'ALL') || (topic === currentTopic);
				const matchSearch = (!searchQuery) || (title.includes(searchQuery) || lead.includes(searchQuery) || brand.toLowerCase().includes(searchQuery));

				if (matchBrand && matchTopic && matchSearch) {
					matchedArticles.push(article);
				} else {
					article.style.display = 'none';
				}
			});

			const totalCount = matchedArticles.length;

			// visibleCount までの記事を表示し、それ以降は非表示
			matchedArticles.forEach((article, idx) => {
				if (idx < visibleCount) {
					article.style.display = '';
				} else {
					article.style.display = 'none';
				}
			});

			if (countDisplay) {
				countDisplay.textContent = totalCount.toString();
			}

			if (noArticles) {
				noArticles.style.display = totalCount === 0 ? 'block' : 'none';
			}

			// 「もっと見る」ボタンの表示および残り件数の制御
			if (moreWrap && loadMoreBtn) {
				if (visibleCount < totalCount) {
					moreWrap.style.display = 'flex';
					const remaining = totalCount - visibleCount;
					const btnText = loadMoreBtn.querySelector('.btn-articles-load-more__text');
					if (btnText) {
						btnText.textContent = `もっと見る（残り${remaining}件）`;
					}
				} else {
					moreWrap.style.display = 'none';
				}
			}
		}

		// 初期ロード時の実行（初期9件表示）
		applyFilters(true);

		// 「もっと見る」ボタンクリックで古い記事を9件ずつ追加表示
		if (loadMoreBtn) {
			loadMoreBtn.addEventListener('click', () => {
				visibleCount += LOAD_STEP;
				applyFilters(false);
			});
		}

		// ブランドピルクリック切り替え
		brandPills.forEach(pill => {
			pill.addEventListener('click', (e) => {
				brandPills.forEach(p => p.classList.remove('is-active'));
				pill.classList.add('is-active');
				currentBrand = pill.getAttribute('data-value') || 'ALL';
				applyFilters(true);
			});
		});

		// カテゴリーセレクト切り替え
		if (topicSelect) {
			topicSelect.addEventListener('change', (e) => {
				currentTopic = e.target.value;
				applyFilters(true);
			});
		}

		// インクリメンタルキーワード検索
		if (searchInput) {
			searchInput.addEventListener('input', (e) => {
				searchQuery = e.target.value.toLowerCase().trim();
				applyFilters(true);
			});
		}

		// リセットボタン
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				currentBrand = 'ALL';
				currentTopic = 'ALL';
				searchQuery = '';

				brandPills.forEach(p => {
					if (p.getAttribute('data-value') === 'ALL') p.classList.add('is-active');
					else p.classList.remove('is-active');
				});

				if (topicSelect) topicSelect.value = 'ALL';
				if (searchInput) searchInput.value = '';

				applyFilters(true);
			});
		}

		// ==============================================================
		// 3. ESG / SDGs 「もっと見る」展開・格納トグル制御
		// ==============================================================
		const toggleEsgBtn = document.getElementById('btn-toggle-esg-more');
		if (toggleEsgBtn) {
			const collapsedCards = document.querySelectorAll('.esg-card.is-collapsed');
			let isExpanded = false;
			const totalCount = toggleEsgBtn.getAttribute('data-total') || '0';
			const btnText = toggleEsgBtn.querySelector('.btn-esg-more__text');
			const btnIcon = toggleEsgBtn.querySelector('.btn-esg-more__icon');

			toggleEsgBtn.addEventListener('click', () => {
				isExpanded = !isExpanded;
				collapsedCards.forEach(card => {
					if (isExpanded) {
						card.classList.remove('is-collapsed');
						card.classList.add('is-expanded');
					} else {
						card.classList.add('is-collapsed');
						card.classList.remove('is-expanded');
					}
				});

				if (isExpanded) {
					if (btnText) btnText.textContent = '閉じる';
					if (btnIcon) btnIcon.style.transform = 'rotate(180deg)';
				} else {
					if (btnText) btnText.textContent = `もっと見る（全${totalCount}件）`;
					if (btnIcon) btnIcon.style.transform = 'rotate(0deg)';
					const esgSec = document.getElementById('esg-section');
					if (esgSec) {
						esgSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
					}
				}
			});
		}
	});
</script>

<style>
	/* ============================================================== */
	/* Nicole Connect - Apple風大判写真エディトリアルマガジン */
