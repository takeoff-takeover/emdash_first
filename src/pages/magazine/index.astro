		height: 36px;
		background: linear-gradient(180deg, #ffffff 0%, transparent 100%);
		animation: scrollDrop 1.8s infinite ease-in-out;
	}

	@keyframes scrollDrop {
		0% { transform: scaleY(0); transform-origin: top; }
		50% { transform: scaleY(1); transform-origin: top; }
		50.1% { transform: scaleY(1); transform-origin: bottom; }
		100% { transform: scaleY(0); transform-origin: bottom; }
	}

	/* ============================================================== */
	/* 2. 本の見開き目次（TABLE OF CONTENTS） */
	/* ============================================================== */
	.toc-section {
		padding: 90px 0 70px 0;
		background: #06070a;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.toc-header {
		margin-bottom: 44px;
	}

	.toc-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: #a0a0aa;
		margin-bottom: 10px;
	}

	.badge-accent {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #ffffff;
	}

	.toc-heading {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
		font-size: clamp(28px, 3vw, 42px);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #ffffff;
		margin: 0 0 10px 0;
	}

	.toc-sub {
		font-size: 15px;
		color: rgba(255, 255, 255, 0.6);
		margin: 0;
	}

	.toc-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 32px;
	}

	.toc-card {
		background: #0a0d12;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 14px;
		overflow: hidden;
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
	}

	.toc-card:hover {
		transform: translateY(-6px);
		border-color: rgba(255, 255, 255, 0.35);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
	}

	.toc-card__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.toc-card__media {
		position: relative;
		height: 320px;
		overflow: hidden;
		background: #000;
	}

	.toc-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.toc-card:hover .toc-card__img {
		transform: scale(1.06);
	}

	.toc-card__overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, transparent 40%, rgba(10, 13, 18, 0.8) 100%);
	}

	.toc-card__brand {
		position: absolute;
		top: 14px;
		left: 14px;
		padding: 3px 10px;
		background: rgba(7, 8, 10, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 999px;
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: #ffffff;
		backdrop-filter: blur(8px);
	}

	.toc-card__body {
		padding: 28px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.toc-card__meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		color: rgba(255, 255, 255, 0.5);
		margin-bottom: 8px;
	}

	.toc-meta-topic {
		color: #a0a0aa;
		font-weight: 600;
	}

	.toc-card__title {
		font-size: 20px;
		font-weight: 600;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.88);
		margin: 0 0 12px 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1), text-shadow 0.3s ease;
	}

	.toc-card:hover .toc-card__title {
		color: #ffffff;
		text-shadow: 0 0 16px rgba(255, 255, 255, 0.35);
	}

	.toc-card__lead {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.6);
		line-height: 1.6;
		margin: 0 0 20px 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex-grow: 1;
		transition: color 0.3s ease;
	}

	.toc-card:hover .toc-card__lead {
		color: rgba(255, 255, 255, 0.85);
	}

	.toc-card__arrow {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.7);
		margin-top: auto;
		transition: color 0.3s ease, transform 0.3s ease;
	}

	.toc-card:hover .toc-card__arrow {
		color: #ffffff;
	}

	.toc-card__arrow svg {
		width: 14px;
		height: 14px;
		transition: transform 0.3s ease;
	}

	.toc-card:hover .toc-card__arrow svg {
		transform: translateX(4px);
	}

	/* ============================================================== */
	/* 3. インタラクティブ・フィルターバー */
	/* ============================================================== */
	.filter-sticky-bar {
		position: sticky;
		top: 70px;
		z-index: 500;
		background: rgba(6, 7, 10, 0.94);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.12);
		padding: 16px 0;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
	}

	.filter-wrap {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		flex-wrap: wrap;
	}

	.filter-group {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.filter-group__label {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: rgba(255, 255, 255, 0.5);
	}

	.filter-pills {
		display: flex;
		align-items: center;
		gap: 8px;
		flex-wrap: wrap;
	}

	.filter-pill {
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: rgba(255, 255, 255, 0.8);
		padding: 6px 16px;
		border-radius: 999px;
		font-size: 12px;
		font-weight: 600;
		letter-spacing: 0.08em;
		cursor: pointer;
		transition: all 0.25s ease;
	}

	.filter-pill:hover {
		background: rgba(255, 255, 255, 0.14);
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.35);
	}

	/* ブランドを選択するボタン：今押されている（アクティブ）ボタンは赤地に白文字 */
	.filter-pill.is-active {
		background: #e50012;
		border-color: #e50012;
		color: #ffffff;
		font-weight: 700;
		box-shadow: 0 2px 14px rgba(229, 0, 18, 0.45);
	}

	.filter-controls-right {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.topic-dropdown {
		height: 40px;
		box-sizing: border-box;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: #ffffff;
		padding: 0 14px;
		border-radius: 8px;
		font-size: 12.5px;
		outline: none;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		transition: border-color 0.25s ease;
	}

	.topic-dropdown:focus {
		border-color: #ffffff;
	}

	.topic-dropdown option {
		background: #111419;
		color: #ffffff;
	}

	.filter-search-box {
		position: relative;
		display: flex;
		align-items: center;
		gap: 8px;
		height: 40px;
		box-sizing: border-box;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 8px;
		padding: 0 14px;
		width: 220px;
		transition: border-color 0.25s ease, width 0.3s ease;
	}

	.filter-search-box:focus-within {
		border-color: #ffffff;
		width: 280px;
	}

	.search-icon {
		width: 14px;
		height: 14px;
		stroke: rgba(255, 255, 255, 0.4);
		flex-shrink: 0;
	}

	.filter-search-box input {
		background: none;
		border: none;
		color: #ffffff;
		font-size: 12.5px;
		width: 100%;
		outline: none;
	}

	.filter-search-box input::placeholder {
		color: rgba(255, 255, 255, 0.35);
	}

	/* ============================================================== */
	/* 4. 全記事エディトリアルグリッド（LIBRARY） */
	/* ============================================================== */
	.all-articles-section {
		padding: 60px 0 120px 0;
	}

	.section-title-bar {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 36px;
		padding-bottom: 16px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.section-num {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
		font-size: 11px;
		font-weight: 700;
		color: #a0a0aa;
		letter-spacing: 0.2em;
		display: block;
		margin-bottom: 4px;
	}

	.section-heading {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
		font-size: 26px;
		font-weight: 700;
		color: #ffffff;
		margin: 0;
		letter-spacing: -0.01em;
	}

	.count-display {
		font-size: 13px;
		color: rgba(255, 255, 255, 0.5);
	}

	.count-display span {
		color: #ffffff;
		font-weight: 700;
	}

	.articles-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.article-item {
		background: #090b0e;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
	}

	.article-item:hover {
		transform: translateY(-5px);
		border-color: rgba(255, 255, 255, 0.35);
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
	}

	.article-item__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.article-item__media {
		position: relative;
		height: 220px;
		overflow: hidden;
		background: #000;
	}

	.article-item__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.article-item:hover .article-item__img {
		transform: scale(1.05);
	}

	.article-item__overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, transparent 50%, rgba(9, 11, 14, 0.8) 100%);
	}

	.article-brand-pill {
		position: absolute;
		top: 14px;
		left: 14px;
		padding: 3px 10px;
		background: rgba(7, 8, 10, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 999px;
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: #ffffff;
		backdrop-filter: blur(8px);
	}

	.article-item__body {
		padding: 22px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.article-item__meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11.5px;
		color: rgba(255, 255, 255, 0.45);
		margin-bottom: 8px;
	}

	.meta-divider {
		opacity: 0.4;
	}

	.meta-topic {
		color: #a0a0aa;
		font-weight: 600;
	}

	.article-item__title {
		font-size: 16px;
		font-weight: 600;
		line-height: 1.45;
		color: rgba(255, 255, 255, 0.88);
		margin: 0 0 10px 0;
		transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1), text-shadow 0.3s ease;
	}

	.article-item:hover .article-item__title {
		color: #ffffff;
		text-shadow: 0 0 14px rgba(255, 255, 255, 0.3);
	}

	.article-item__lead {
		font-size: 13px;
		color: rgba(255, 255, 255, 0.65);
		line-height: 1.6;
		margin: 0 0 18px 0;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex-grow: 1;
		transition: color 0.3s ease;
	}

	.article-item:hover .article-item__lead {
		color: rgba(255, 255, 255, 0.82);
	}

	.article-item__footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 11.5px;
		padding-top: 14px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		margin-top: auto;
	}

	.article-item__more {
		color: rgba(255, 255, 255, 0.65);
		font-weight: 600;
		transition: color 0.25s ease, transform 0.25s ease;
	}

	.article-item:hover .article-item__more {
		color: #ffffff;
	}

	.article-item__views {
		color: rgba(255, 255, 255, 0.4);
	}

	/* ============================================================== */
	/* ALL STORIES & ESSAYS 「もっと見る」ボタン（モノトーンエディトリアルデザイン） */
	/* ============================================================== */
	.all-articles-more-wrap {
		display: flex;
		justify-content: center;
		margin-top: 48px;
		padding-top: 36px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.btn-articles-load-more {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 13.5px;
		font-weight: 600;
		color: #ffffff;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 9999px;
		padding: 12px 34px;
		cursor: pointer;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		user-select: none;
	}

	.btn-articles-load-more:hover {
		background: rgba(255, 255, 255, 0.14);
		border-color: rgba(255, 255, 255, 0.35);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
	}

	.btn-articles-load-more__icon {
		width: 15px;
		height: 15px;
		transition: transform 0.2s ease;
	}

	.btn-articles-load-more:hover .btn-articles-load-more__icon {
		transform: translateY(2px);
	}

	/* 検索該当なし状態 */
	.no-articles-state {
		text-align: center;
		padding: 80px 20px;
		background: #090b0e;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 16px;
		margin-top: 20px;
	}

	.no-articles-icon {
		width: 56px;
		height: 56px;
		margin: 0 auto 20px auto;
		color: rgba(255, 255, 255, 0.3);
	}

	.no-articles-icon svg {
		width: 100%;
		height: 100%;
	}

	.no-articles-title {
		font-size: 18px;
		font-weight: 600;
		margin: 0 0 8px 0;
		color: #ffffff;
	}

	.no-articles-desc {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.5);
		margin: 0 0 24px 0;
	}

	.btn-reset-filters {
		background: #ffffff;
		color: #040507;
		border: none;
		padding: 10px 24px;
		border-radius: 6px;
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.25s ease, transform 0.25s ease;
	}

	.btn-reset-filters:hover {
		background: #e4e4e7;
		transform: translateY(-2px);
	}

	/* ============================================================== */
	/* レスポンシブ対応（モバイル・タブレット） */
	/* ============================================================== */
	@media (max-width: 1200px) {
		.toc-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.articles-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 1024px) {
		.mag-container {
			padding: 0 24px;
		}
	}

	@media (max-width: 768px) {
		.mag-container {
			padding: 0 20px;
		}

		.apple-hero {
			min-height: 85vh;
			padding-top: 60px;
		}

		.apple-hero__frame {
			top: 15px;
			left: 15px;
			right: 15px;
			bottom: 15px;
		}

		.apple-hero__header {
			flex-direction: column;
			align-items: flex-start;
			gap: 12px;
		}

		.apple-hero__masthead {
			align-items: flex-start;
			text-align: left;
		}

		.apple-hero__title {
			font-size: 42px;
		}

		.apple-hero__lead {
			font-size: 15px;
		}

		.apple-hero__actions {
			flex-direction: column;
			align-items: stretch;
		}

		.apple-cta-btn {
			justify-content: center;
		}

		.apple-hero__footer {
			display: none;
		}

		.apple-hero__scroll-cue {
			display: none;
		}

		.toc-grid {
			grid-template-columns: 1fr;
		}

		.filter-wrap {
			flex-direction: column;
			align-items: stretch;
		}

		.filter-controls-right {
			flex-direction: column;
			width: 100%;
		}

		.filter-search-box {
			width: 100%;
		}

		.filter-search-box:focus-within {
			width: 100%;
		}

		.articles-grid {
			grid-template-columns: 1fr;
		}

		.magazine-esg-section {
			padding: 60px 0 80px;
		}

		.esg-section__heading {
			font-size: 21px;
		}

		.esg-cards-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 12px;
		}

		.esg-card__body {
			padding: 10px 10px 12px;
		}

		.esg-card__title {
			font-size: 12.5px;
			line-height: 1.42;
		}
	}

	/* ============================================================== */
	/* 5. ESG / SDGs 専用ブロック（SUSTAINABILITY & COMMUNITY） */
	/* ============================================================== */
	.magazine-esg-section {
		padding: 88px 0 110px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.015) 0%, rgba(255, 255, 255, 0) 100%);
	}

	.esg-section__header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 36px;
		gap: 24px;
		flex-wrap: wrap;
	}

	.esg-section__titles {
		max-width: 720px;
	}

	.esg-section__eyebrow {
		display: block;
		font-family: var(--font-mono, monospace);
		font-size: 11px;
		letter-spacing: 0.16em;
		color: #8e95a5;
		text-transform: uppercase;
		margin-bottom: 8px;
	}

	.esg-section__heading {
		font-size: 26px;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: #ffffff;
		margin: 0 0 10px;
		line-height: 1.35;
	}

	.esg-section__desc {
		font-size: 13.5px;
		color: #9aa1b2;
		line-height: 1.6;
		margin: 0;
	}

	.esg-section__portal-link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 13px;
		font-weight: 500;
		color: #ffffff;
		text-decoration: none;
		padding: 10px 20px;
		border-radius: 9999px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.15);
		transition: all 0.25s ease;
	}

	.esg-section__portal-link svg {
		width: 14px;
		height: 14px;
		transition: transform 0.2s ease;
	}

	.esg-section__portal-link:hover {
		background: rgba(255, 255, 255, 0.14);
		border-color: rgba(255, 255, 255, 0.35);
	}

	.esg-section__portal-link:hover svg {
		transform: translate(2px, -2px);
	}

	/* ESG 4カラム・コンパクトカードグリッド（他のカードより一回り小さく） */
	.esg-cards-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	.esg-card {
		border-radius: 10px;
		background: #0d0f14;
		border: 1px solid rgba(255, 255, 255, 0.08);
		overflow: hidden;
		transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.esg-card.is-collapsed {
		display: none;
	}

