		background-color: #040507;
		color: var(--mag-color-lead);
		font-family: "Helvetica Neue", Helvetica, Arial, -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
		min-height: 100vh;
		position: relative;
		overflow-x: hidden;
	}

	.mag-container {
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 40px;
	}

	/* ============================================================== */
	/* 1. Apple風 特大マガジンカバー・HERO */
	/* ============================================================== */
	.apple-hero {
		position: relative;
		min-height: 94vh;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		padding-top: 80px;
		background: #000000;
	}

	/* 巨大背景画像コンテナ */
	.apple-hero__media {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		overflow: hidden;
	}

	.apple-hero__img {
		width: 100%;
		height: 115%;
		object-fit: cover;
		object-position: center 38%;
