	.apple-hero__gradient {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			180deg, 
			rgba(4, 5, 7, 0.88) 0%, 
			rgba(4, 5, 7, 0.25) 35%, 
			rgba(4, 5, 7, 0.4) 65%, 
			rgba(4, 5, 7, 0.98) 100%
