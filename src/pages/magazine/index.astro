// CMS記事がある場合は統合
const cmsArticles = (cmsPosts || []).map((p: any) => {
	const featImg = p.data.featured_image;
	const imgUrl = typeof featImg === "object" && featImg !== null && "src" in featImg
		? featImg.src
		: (typeof featImg === "string" ? featImg : "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg");

	return {
		id: p.id || p.data.id,
		slug: p.id,
		title: p.data.title,
		brand: p.data.related_location ? "BMW" : "ALL",
		topic: "Feature",
		date: p.data.published_at ? new Date(p.data.published_at).toISOString().slice(0, 10).replace(/-/g, '.') : "2026.10.25",
		views: "NEW",
		image: imgUrl,
		lead: p.data.excerpt || "",
		url: `/magazine/${p.id}/`,
		isFeatured: false
	};
});

// 全記事リスト（重複排除）
const allArticles = [
	...cmsArticles.filter(ca => !staticArticles.some(sa => sa.slug === ca.slug)),
	...staticArticles
];

// 一番目玉の記事（Cover Story）
const coverArticle = allArticles.find(a => a.isFeatured) || allArticles[0];

// 本の目次（Chapters）として掲載するハイライト記事
const chaptersArticles = allArticles.filter(a => a.id !== coverArticle.id).slice(0, 3);

const brandsList = ["ALL", "BMW", "MINI", "Ferrari", "Rolls-Royce", "ALPINA"];
const topicsList = ["ALL", "Feature", "Guide", "People", "ESG / SDGs"];
---

<NicoleLayout 
	title="Nicole Connect - The Editorial Volume ｜ ニコル・グループ公式マガジン" 
	description="世界最高峰のモビリティと美学を編むWebマガジン「Nicole Connect」。BMW、MINI、フェラーリ、ロールス・ロイス、アルピナの最新特集・インタビュー・購入ガイド。"
>
	<main class="magazine-book-main">
		<!-- ============================================================== -->
		<!-- 1. 栞（ブックマーク・リボン）：ページ上部から垂れ下がる布製リボン -->
		<!-- ============================================================== -->
		<a href="#magazine-archive" class="bookmark-ribbon" title="目次・全記事一覧へスクロール">
			<span class="ribbon-text">INDEX ▾</span>
			<span class="ribbon-end"></span>
		</a>

		<!-- ============================================================== -->
		<!-- 2. 特大ブックカバー・ヒーローステージ（本に特化したエディトリアル装丁） -->
		<!-- ============================================================== -->
		<section class="book-hero-stage">
			<div class="book-ambient-glow"></div>

			<div class="mag-container">
				<div class="book-hero-layout">
					<!-- 左／中央：3D立体ブック（目玉記事がそのまま特大ハードカバー本の表紙に！） -->
					<div class="book-showcase-col">
						<div class="book-3d-perspective" id="book-perspective-wrapper">
							<article class="editorial-book-object" id="interactive-book-cover">
								<a href={coverArticle.url} class="book-cover-anchor" aria-label={`今号の巻頭特集：${coverArticle.title}`}>
									<!-- 背表紙の折り目溝・陰影（ハードカバーの質感を再現） -->
									<div class="book-spine-crease"></div>

									<!-- ページ束の多層厚み（本の右端に覗く紙の重なり） -->
									<div class="book-pages-stack"></div>

									<!-- 表紙画像（目玉記事の写真） -->
									<div class="book-cover-artwork">
										<img 
											src={coverArticle.image} 
											alt={coverArticle.title} 
											class="book-cover-image" 
											loading="eager" 
										/>
										<div class="book-cover-vignette"></div>
									</div>

									<!-- 光沢シマー反射レイヤー（マウスの動きで光が走る） -->
									<div class="book-glare-foil" id="book-glare-foil"></div>

									<!-- 表紙グラフィック・タイポグラフィ装丁 -->
									<div class="book-cover-header">
										<div class="book-vol-tag">
											<span class="vol-symbol">❖</span>
											<span>VOL. 08 — AUTUMN / WINTER 2026-2027</span>
										</div>
										<h1 class="book-masthead">
											<span class="masthead-main">NICOLE CONNECT</span>
											<span class="masthead-sub">THE EDITORIAL CAR CULTURE & CRAFTSMANSHIP</span>
										</h1>
									</div>

									<div class="book-cover-body">
										<div class="book-feature-kicker">COVER STORY</div>
										<h2 class="book-feature-headline">
											THE NEW DAWN OF 3 SERIES.
										</h2>
										<p class="book-feature-subline">
											次世代ノイエ・クラッセ初採用。時代が静かに、だが劇的に動き出す。
										</p>
									</div>

									<!-- 本の帯（Book Obi）：限定特装版のリアルな帯 -->
									<div class="book-obi">
										<div class="book-obi__ribbon">SPECIAL EDITION</div>
										<div class="book-obi__body">
											<span class="book-obi__lead">【世界初公開】BMW i3 ＆ M350 xDrive</span>
											<span class="book-obi__sub">歴代最高のドライビング・ダイナミクスと革新のデジタル・キャビン</span>
										</div>
										<div class="book-obi__open">
											<span>READ</span>
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
										</div>
									</div>

									<!-- 奥付・ISBNバーコード（本のディテール） -->
									<div class="book-colophon">
										<div class="colophon-barcode">
											<span class="bar b1"></span><span class="bar b2"></span><span class="bar b3"></span>
											<span class="bar b1"></span><span class="bar b4"></span><span class="bar b2"></span>
											<span class="bar b3"></span><span class="bar b1"></span><span class="bar b2"></span>
										</div>
										<span class="colophon-isbn">ISBN 978-4-990000-08-9</span>
										<span class="colophon-pub">NICOLE GROUP PUBLICATIONS</span>
									</div>

									<!-- 右下角の紙めくれ（ドッグイア / Page Curl） -->
									<div class="book-page-curl" title="ページをめくる">
										<span class="curl-text">OPEN</span>
									</div>
								</a>
							</article>
						</div>

						<!-- 本の置き台シャドウ（床面に落ちる重厚なソフトシャドウ） -->
						<div class="book-pedestal-shadow"></div>
						<div class="book-interaction-hint">
							<span class="hint-icon">✦</span>
							<span>カーソルに合わせて本が立体的に傾きます。クリックして特集ページへ</span>
						</div>
					</div>

					<!-- 右：今号の目次・解説（Book Overview & Chapters） -->
					<div class="book-contents-col">
						<div class="volume-header">
							<div class="volume-label">
								<span class="volume-dot"></span>
								<span>COLLECTOR'S VOLUME 08</span>
							</div>
							<h2 class="volume-title">本質を極めた、美しいモビリティの記録。</h2>
							<p class="volume-desc">
								自動車は単なる移動の手段を超え、人生を豊かに彩る芸術作品となる。本号では、新世代EVへと昇華した新型BMW 3シリーズを筆頭に、跳ね馬の血統を受け継ぐフェラーリ初のフル電動モデル、そしてクラフトマンシップが息づく熟練マイスターたちの手仕事まで、妥協なき情熱の結晶を1冊の特装本として綴ります。
							</p>
						</div>

						<!-- 本の目次（Chapters / 今号のハイライト） -->
						<div class="book-chapters-card">
							<div class="chapters-card-head">
								<span class="chapters-card-title">TABLE OF CONTENTS</span>
								<span class="chapters-card-vol">VOL.08</span>
							</div>

							<div class="chapters-list">
								<!-- Chapter 01: 巻頭特集 -->
								<a href={coverArticle.url} class="chapter-item is-cover">
									<div class="chapter-num">CHAP. 01</div>
									<div class="chapter-content">
										<div class="chapter-meta">
											<span class="chapter-brand">{coverArticle.brand}</span>
											<span class="chapter-tag">COVER STORY</span>
										</div>
										<div class="chapter-title">{coverArticle.title}</div>
									</div>
									<div class="chapter-arrow">→</div>
								</a>

								<!-- Chapter 02, 03... -->
