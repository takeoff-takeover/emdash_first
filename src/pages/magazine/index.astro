---
// src/pages/magazine/index.astro
// Nicole Connect - Web Magazine（Apple風の巨大写真ヒーロー＆エディトリアル・マガジンカバー）
import { getEmDashCollection, getTermsForEntries } from "emdash";
import { env } from "cloudflare:workers";
import { DatabaseSync } from "node:sqlite";
import fs from "node:fs";
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import "../../styles/magazine-text.css";
import { isNoticeArticle, isESGArticle } from "../../lib/magazinePolicy";

// CMS（magazineコレクション および postsコレクション）から記事を取得
let cmsMagazines: any[] = [];
let cacheHint: any = null;

try {
	const magResult = await getEmDashCollection("magazine" as any, {
		orderBy: { published_at: "desc" },
		limit: 100,
	});
	if (magResult?.entries) {
		cmsMagazines = magResult.entries;
		cacheHint = magResult.cacheHint;
	}
} catch (e) {}

let cmsPosts: any[] = [];
try {
	const postResult = await getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 100,
	});
	if (postResult?.entries) {
		cmsPosts = postResult.entries;
		if (!cacheHint) cacheHint = postResult.cacheHint;
	}
} catch (e) {}

if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

// 記事閲覧数マップを一括取得
const viewsMap = new Map<string, number>();
try {
	let db: any = null;
	try {
		db = (env as any)?.DB;
	} catch (e) {}

	if (db) {
		const rows = await db.prepare("SELECT slug, views FROM article_views").all();
		for (const r of (rows.results || [])) {
			if (r.slug && typeof r.views === "number") {
				viewsMap.set(r.slug, r.views);
			}
		}
	} else {
		const d1Dir = ".wrangler/state/v3/d1/miniflare-D1DatabaseObject";
		let dbPath = "";
		if (fs.existsSync(d1Dir)) {
			const files = fs.readdirSync(d1Dir);
			const f = files.find((name: string) => name.endsWith(".sqlite") && !name.includes("metadata") && !name.includes("bak"));
			if (f) dbPath = `${d1Dir}/${f}`;
		}
		if (!dbPath && fs.existsSync("seed/backup.sqlite")) {
			dbPath = "seed/backup.sqlite";
		}
		if (dbPath) {
			const localDb = new DatabaseSync(dbPath);
			const rows = localDb.prepare("SELECT slug, views FROM article_views").all() as any[];
			for (const r of rows) {
				if (r.slug && typeof r.views === "number") {
					viewsMap.set(r.slug, r.views);
				}
			}
		}
	}
} catch (e) {
	// DB取得エラー時はフォールバック
}



// 本文からリード文（2〜3行の冒頭テキスト）を自動抽出するヘルパー
function extractLead(p: any): string {
	if (p.data?.excerpt && p.data.excerpt.trim()) {
		return p.data.excerpt.trim();
	}
	const content = p.data?.content;
	if (Array.isArray(content)) {
		for (const block of content) {
			if (block._type === 'block' && block.style === 'normal' && Array.isArray(block.children)) {
				const text = block.children.map((c: any) => c.text || '').join('').trim();
				if (text.length > 20) {
					return text.length > 140 ? text.slice(0, 137) + '...' : text;
				}
			}
		}
	}
	return "";
}

// アイキャッチ画像のURL解決ヘルパー（EmDash R2ストレージ key, オブジェクト, JSON文字列, 外部URLのすべてに対応）
function resolveMediaUrl(img: unknown, fallback: string = ""): string {
	if (!img) return fallback;
	let target: any = img;
	if (typeof target === "string") {
		const trimmed = target.trim();
		if (trimmed.startsWith("{") && trimmed.endsWith("}")) {
			try {
				target = JSON.parse(trimmed);
			} catch {
				return trimmed;
			}
		} else {
			return trimmed || fallback;
		}
	}
	if (typeof target === "object" && target !== null) {
		if (typeof target.src === "string" && target.src.trim()) {
			return target.src.trim();
		}
		const storageKey = target.meta?.storageKey || target.storageKey || target.id;
		if (storageKey) {
			return `/_emdash/api/media/file/${storageKey}`;
		}
	}
	return fallback;
}

// 記事カテゴリー判定ヘルパー (Cars / People / ESG / Buyer's Guide)
function determineArticleCategory(p: any): string {
	const slug = (p.slug || p.id || "").toLowerCase();
	const title = (p.title || p.data?.title || "").toLowerCase();
	const topic = (p.topic || "").toLowerCase();

	// Campaign 判定
	if (slug.includes("campaign") || slug.includes("fair") || slug.includes("debut") || title.includes("フェア") || title.includes("キャンペーン")) {
		return "Campaign";
	}

	// Buyer's Guide 判定
	if (slug.includes("guide") || slug.includes("buyer") || title.includes("ガイド") || title.includes("選び方") || title.includes("購入") || topic === "guide") {
		return "Buyer's Guide";
	}

	// ESG 判定
	const esgKeywords = [
		"tamagawa", "cleanup", "japanesenight", "inspire_hub", "traffic-safety",
		"food-for-community", "sustainable", "emergency", "kids-mechanic", "haruhinofes",
		"norimonofes", "sdgs", "summerconference", "esg", "美化活動", "クリーンアップ", "交通安全", "防災", "寄付"
	];
	if (esgKeywords.some(kw => slug.includes(kw) || title.includes(kw)) || topic.includes("esg") || topic.includes("sdgs")) {
		return "ESG";
	}

	// People 判定
	const peopleKeywords = [
		"people", "interview", "staff", "mechanic", "craft", "職人", "社員", "インタビュー",
		"ストーリー", "story", "マイスター", "junior_high", "work-experience", "international-employee",
		"fire-department", "mochitsuki", "餅つき", "交流会", "感謝状", "職場体験", "alpina-heritage", "rolls-royce-bespoke"
	];
	if (peopleKeywords.some(kw => slug.includes(kw) || title.includes(kw)) || topic === "people") {
		return "People";
	}

	// デフォルトは Cars
	return "Cars";
}



// CMS記事がある場合は統合
// magazineコレクションおよびpostsコレクションの記事を統合
const allCmsEntries = [...cmsMagazines, ...cmsPosts.filter(p => !cmsMagazines.some(m => m.id === p.id))];

// 共通の「ブランド (brand)」および「カテゴリー (category)」分類グループから一括取得
let brandTermsByEntry = new Map<string, any[]>();
let categoryTermsByEntry = new Map<string, any[]>();
try {
	const magIds = cmsMagazines.map((p: any) => p.data?.id || p.id).filter(Boolean);
	if (magIds.length > 0) {
		[brandTermsByEntry, categoryTermsByEntry] = await Promise.all([
			getTermsForEntries("magazine", magIds, "brand"),
			getTermsForEntries("magazine", magIds, "category"),
		]);
	}
} catch (e) {}

const cmsArticles = allCmsEntries.map((p: any) => {
	const publishedAt = new Date(p.data.publishedAt ?? p.data.createdAt ?? 0).getTime() || 0;
	const featImg = p.data.featured_image;
	const imgUrl = resolveMediaUrl(
		featImg,
		"https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg"
	);
	const entryDbId = p.data?.id || p.id;
	const assignedCategories = (categoryTermsByEntry.get(entryDbId) || []).map((term: any) => term.label).filter(Boolean);
	const inferredCat = determineArticleCategory(p);
	const cat = isESGArticle(p) ? "ESG" : (inferredCat === "Campaign")
		? "Campaign"
		: (assignedCategories.length > 0 ? assignedCategories[0] : inferredCat);

	const s = (p.id || "").toLowerCase();
	const t = (p.data.title || "").toLowerCase();
	const assignedBrands = (brandTermsByEntry.get(entryDbId) || []).map((term: any) => term.label).filter(Boolean);

	let b = "ALL";
	if (assignedBrands.length > 0) {
		b = assignedBrands.join(" / ");
	} else if (t.includes("mini") || s.includes("mini")) b = "MINI";
	else if (t.includes("bmw") || s.includes("bmw") || t.includes("7シリーズ") || t.includes("3シリーズ")) b = "BMW";
	else if (t.includes("ferrari") || s.includes("ferrari")) b = "Ferrari";
	else if (t.includes("rolls") || s.includes("rolls") || t.includes("ロールス")) b = "Rolls-Royce";
	else if (t.includes("alpina") || s.includes("alpina") || t.includes("アルピナ")) b = "ALPINA";
	else if (p.data.related_location) b = "BMW";

	const articleUrl = (s.includes("mini-new-generation-debut-fair") || cat === "Campaign")
		? `/campaigns/${p.id}`
		: `/magazine/${p.id}/`;

	const viewsCount = viewsMap.get(p.id) || 0;

	return {
		id: p.id || p.data.id,
		slug: p.id,
		title: p.data.title,
		brand: b,
		topic: cat,
		category: cat,
		date: new Date(publishedAt).toLocaleDateString("sv-SE", { timeZone: "Asia/Tokyo" }).replace(/-/g, "."),
		publishedAt,
		viewsCount,
		views: `${viewsCount.toLocaleString()} views`,
		image: imgUrl,
		lead: extractLead(p),
		url: articleUrl,
		isFeatured: cat === "Campaign" || s.includes("mini-new-generation")
	};
});

// 公式Magazineから取り込んだCMS記事と、編集部で作成したCMS記事を掲載する。
// お知らせ（休業日案内・ドメインSNS変更等）はマガジンから除外
const allArticles = cmsArticles.filter(a => !isNoticeArticle(a));

// ユーザー指示（A案）：通常一覧からESG記事を完全に除外し、最下部の専用ブロックへ集約
const mainArticles = allArticles.filter(a => !isESGArticle(a));
const esgArticles = allArticles.filter(a => isESGArticle(a)).sort((a, b) => (b.date || "").localeCompare(a.date || ""));

// CMSの公開記事を公開日時順に掲載し、静的アーカイブはその後に補充する。
const cmsArticleIds = new Set(cmsArticles.map(article => article.id));
mainArticles.sort((a, b) => {
	const sourceOrder = Number(cmsArticleIds.has(b.id)) - Number(cmsArticleIds.has(a.id));
	if (sourceOrder) return sourceOrder;
	const aDate = a.publishedAt;
	const bDate = b.publishedAt;
	return (bDate || 0) - (aDate || 0) || a.id.localeCompare(b.id);
});

// 一番目玉の記事（Cover Story）
const coverArticle = mainArticles[0];

// 特集ハイライト記事（最新記事 2枠）
const highlightStories = mainArticles.filter(a => a.id !== coverArticle.id).slice(0, 2);

// 人気の記事ランキング（閲覧数の多い順、同数の場合は公開日時の新しい順に上位5件）
const popularArticles = [...mainArticles]
	.sort((a, b) => (b.viewsCount || 0) - (a.viewsCount || 0) || (b.publishedAt || 0) - (a.publishedAt || 0))
	.slice(0, 5);

// トップ最新3記事のIDセット（Cover Story 1件 + LATEST STORIES 2件）
const top3ArticleIds = new Set([coverArticle.id, ...highlightStories.map(s => s.id)]);
// 初期表示時のアーカイブ収録記事数（最新3記事を除いた件数）
const initialArchiveCount = mainArticles.filter(a => !top3ArticleIds.has(a.id)).length;

const brandsList = ["ALL", "BMW", "MINI", "Ferrari", "Rolls-Royce", "ALPINA"];
const topicsList = ["ALL", "Cars", "People", "Buyer's Guide", "Campaign"];
const archiveArticles = Astro.url.searchParams.get("view") === "latest"
	? [...allArticles].sort((a, b) => b.publishedAt - a.publishedAt || a.id.localeCompare(b.id))
	: mainArticles;
---

<NicoleLayout 
	title="Nicole Connect - Web Magazine ｜ ニコル・グループ公式" 
	description="Appleのような大迫力のビジュアルと洗練されたエディトリアルで綴るWebマガジン「Nicole Connect」。BMW、MINI、フェラーリ、ロールス・ロイス、アルピナの最新モデル情報から特集記事まで。"
	isMagazine={true}
>
	<main class="apple-magazine-main">
		<!-- ============================================================== -->
		<!-- 1. Apple風 特大マガジンカバー・HERO（画面全体に写真を大胆に使用） -->
		<!-- ============================================================== -->
		<section class="apple-hero" id="hero-cover">
			<!-- 巨大背景画像コンテナ（スクロール視差パララックス対応） -->
			<div class="apple-hero__media" id="apple-hero-media">
				<img 
					src={coverArticle.image} 
					alt={coverArticle.title} 
					class="apple-hero__img" 
					id="apple-hero-img"
					loading="eager" 
				/>
				<!-- 映画的なダークビネットとグラデーション -->
				<div class="apple-hero__gradient"></div>
				<div class="apple-hero__side-vignette"></div>
			</div>



			<!-- 表紙コンテンツ -->
			<div class="apple-hero__content">
				<div class="mag-container apple-hero__container">
					<!-- 1. 左上固定：マガジンマストヘッド（どの記事でも固定） -->
					<div class="hero-masthead">
						<h1 class="hero-masthead__brand">Nicole<br />Connect</h1>
						<p class="hero-masthead__tagline">A web magazine curating the world of Nicole Group</p>
					</div>

					<!-- 2. 画面左側に並ぶ最新記事情報（文字サイズ縮小・エディトリアル左揃え） -->
					<div class="hero-featured-story">
						<h2 class="hero-story-title">
							{coverArticle.id === "2027_new_bmw_ix4_neue_klasse" || coverArticle.slug === "2027_new_bmw_ix4_neue_klasse" 
								? "THE ALL-NEW BMW iX4." 
								: coverArticle.title}
						</h2>

						<p class="hero-story-lead">
							{coverArticle.id === "2027_new_bmw_ix4_neue_klasse" || coverArticle.slug === "2027_new_bmw_ix4_neue_klasse"
								? "【世界初公開】BMWノイエ・クラッセ初の完全電動スポーツ・アクティビティ・クーペ。流麗なファストバック造形、最高出力612馬力のM60 xDrive、そして航続828kmが切り拓く新時代。"
								: coverArticle.lead}
						</p>

						<!-- 左寄せのアクションボタン -->
						<div class="hero-story-actions">
							<a href={coverArticle.url} class="apple-cta-btn apple-cta-btn--secondary">
								<span>記事を読む</span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							</a>
						</div>
					</div>
				</div>
			</div>

			<!-- スクロール促進インジケーター -->
			<a href="#table-of-contents" class="apple-hero__scroll-cue" aria-label="コンテンツへスクロール">
				<span class="scroll-cue-text">SCROLL TO READ</span>
				<div class="scroll-cue-line"></div>
			</a>
		</section>

		<!-- ============================================================== -->
		<!-- 2. 最新記事ハイライト（LATEST STORIES） -->
		<!-- ============================================================== -->
		<section class="toc-section" id="table-of-contents">
			<div class="mag-container">
				<div class="toc-header">
					<h2 class="toc-heading">LATEST STORIES</h2>
					<p class="toc-sub">Nicoleが厳選した最新の特集ストーリーをお届けします。</p>
				</div>

				<div class="toc-grid">
					{highlightStories.map((story) => (
						<article class="toc-card">
							<a href={story.url} class="toc-card__link">
								<div class="toc-card__media">
									<img src={story.image} alt={story.title} loading="lazy" class="toc-card__img" />
									<div class="toc-card__overlay"></div>
									<span class="toc-card__brand">{story.brand}</span>
								</div>
								<div class="toc-card__body">
									<div class="toc-card__meta">
										<span class="toc-meta-topic">{story.topic}</span>
										<span class="toc-meta-sep">/</span>
										<time class="toc-meta-date">{story.date}</time>
										<span class="toc-meta-sep">/</span>
										<span class="toc-meta-views" title="閲覧数">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="toc-views-icon" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
											<span>{story.views}</span>
										</span>
									</div>
									<h3 class="toc-card__title">{story.title}</h3>
									{story.lead && <p class="toc-card__lead">{story.lead}</p>}
									<div class="toc-card__arrow">
										<span>記事を読む</span>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
									</div>
								</div>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- 3. 人気の記事ランキング（アクセス数の多い上位ストーリー） -->
		<!-- ============================================================== -->
		<section class="popular-section is-dark-text" id="popular-stories">
			<div class="mag-container">
				<div class="popular-header">
					<h2 class="popular-heading">人気の記事</h2>
					<p class="popular-sub">読者の皆様に今最も多く読まれている注目のストーリー。</p>
				</div>

				<div class="popular-grid">
					{popularArticles.map((story, index) => (
						<article class="popular-card">
							<a href={story.url} class="popular-card__link">
								<div class="popular-card__media">
									<img src={story.image} alt={story.title} loading="lazy" class="popular-card__img" />
									<div class="popular-card__overlay"></div>
									<span class={`popular-rank-badge ${index < 3 ? 'is-top' : ''}`}>
										{index + 1}
									</span>
								</div>
								<div class="popular-card__body">
									<div class="popular-card__meta">
										<span class="popular-meta-brand">{story.brand}</span>
										<span class="popular-meta-sep">/</span>
										<span class="popular-meta-views" title="閲覧数">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="card-views-icon" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
											<span>{story.views}</span>
										</span>
									</div>
									<h3 class="popular-card__title">{story.title}</h3>
								</div>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- 4. インタラクティブ・フィルターバー（Stickyナビゲーション） -->
		<!-- ============================================================== -->
		<section class="filter-sticky-bar" id="magazine-archive">
			<div class="mag-container">
				<div class="filter-wrap">
					<!-- ブランドフィルター（メインタブ） -->
					<div class="filter-group filter-group--brand">
						<span class="filter-group__label">ブランド</span>
						<div class="filter-pills" id="brand-filters">
							{brandsList.map((b) => (
								<button 
									type="button" 
									class={`filter-pill ${b === 'ALL' ? 'is-active' : ''}`} 
									data-filter-type="brand" 
									data-value={b}
								>
									{b}
								</button>
							))}
						</div>
					</div>

					<!-- トピックフィルター ＆ 検索バー -->
					<div class="filter-controls-right">
						<div class="filter-group filter-group--topic">
							<span class="filter-group__label">カテゴリー</span>
							<div class="filter-pills" id="topic-filters">
								{topicsList.map((t) => (
									<button 
										type="button" 
										class={`filter-pill ${t === 'ALL' ? 'is-active' : ''}`} 
										data-filter-type="topic" 
										data-value={t}
									>
										{t}
									</button>
								))}
							</div>
						</div>

						<!-- キーワード検索 -->
						<div class="filter-search-box">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="search-icon"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
							<input 
								type="text" 
								id="article-search-input" 
								placeholder="記事をキーワード検索..." 
								aria-label="記事をキーワード検索"
							/>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- 4. 全記事エディトリアルグリッド（LIBRARY / ARCHIVE） -->
		<!-- ============================================================== -->
		<section class="all-articles-section">
			<div class="mag-container">
				<div class="section-title-bar">
					<div>
						<h2 class="section-heading">ALL STORIES & ESSAYS</h2>
					</div>
					<div class="count-display">
						収録記事：<span id="current-article-count">{initialArchiveCount}</span>篇
					</div>
				</div>

				<!-- 記事グリッド（JSフィルタリング対象） -->
				<div class="articles-grid" id="articles-grid">
					{archiveArticles.map((art, idx) => {
						const cycle = idx % 10;
						let featuredClass = '';
						if (cycle === 0) featuredClass = 'is-featured-lead';
						else if (cycle === 5) featuredClass = 'is-featured-reverse';

						return (
							<article 
								class={`article-item ${featuredClass}`} 
								data-id={art.id}
								data-is-top3={top3ArticleIds.has(art.id) ? "true" : "false"}
								data-brand={art.brand} 
								data-topic={art.topic}
								data-title={art.title.toLowerCase()}
								data-lead={art.lead ? art.lead.toLowerCase() : ''}
							>
								<a href={art.url} class="article-item__link">
									<div class="article-item__media">
										<img src={art.image} alt={art.title} loading="lazy" class="article-item__img" />
										<div class="article-item__overlay"></div>
										<span class="article-brand-pill">{art.brand}</span>
									</div>
									<div class="article-item__body">
										<div class="article-item__meta">
											<time class="meta-date">{art.date}</time>
											<span class="meta-divider">/</span>
											<span class="meta-topic">{art.topic}</span>
										</div>
										<h3 class="article-item__title">{art.title}</h3>
										{art.lead ? (
											<p class="article-item__lead">{art.lead}</p>
										) : (
											<div class="article-item__lead is-empty" aria-hidden="true"></div>
										)}
										<div class="article-item__footer">
											<span class="article-item__more">記事を読む</span>
											<span class="article-item__views" title="閲覧数">
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="card-views-icon" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
												<span>{art.views}</span>
											</span>
										</div>
									</div>
								</a>
							</article>
						);
					})}
				</div>

				<!-- 「もっと見る」ボタン（初期9件、クリックで古い記事を順次展開） -->
				<div class="all-articles-more-wrap" id="articles-more-wrap" style="display: none;">
					<button type="button" id="btn-articles-load-more" class="btn-articles-load-more">
						<span class="btn-articles-load-more__text">もっと見る</span>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-articles-load-more__icon"><path d="M6 9l6 6 6-6"/></svg>
					</button>
				</div>

				<!-- 検索該当なしプレースホルダー -->
				<div id="no-articles" class="no-articles-state" style="display: none;">
					<div class="no-articles-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><line x1="8" x2="14" y1="11" y2="11"/></svg>
					</div>
					<h3 class="no-articles-title">該当する記事が見つかりませんでした</h3>
					<p class="no-articles-desc">選択中のブランドまたは検索キーワードを変更してお試しください。</p>
					<button type="button" id="btn-reset-filters" class="btn-reset-filters">すべてのフィルターを解除</button>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- 5. ESG / SDGs 専用ブロック（SUSTAINABILITY & COMMUNITY） -->
		<!-- ============================================================== -->
		<section class="magazine-esg-section is-dark-text" id="esg-section">
			<div class="mag-container">
				<div class="esg-section__header">
					<div class="esg-section__titles">
						<h2 class="esg-section__heading">
							ESG / SDGs
							<span class="esg-section__heading-sub">持続可能な未来への取り組み</span>
						</h2>
						<p class="esg-section__desc">地域社会への貢献、環境保全、そして未来を担う次世代育成。<br class="pc-only" />ニコル・グループが取り組む活動の歩みを<span class="u-nowrap">お届けします。</span></p>
					</div>
					<a href="/esg_sdgs" class="esg-section__portal-link">
						<span>ニコル・グループのESG方針を見る</span>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
					</a>
				</div>

				<!-- 4カラム・コンパクトカードグリッド（初期4件、もっと見るで展開） -->
				<div class="esg-cards-grid" id="esg-cards-grid">
					{esgArticles.map((art, index) => (
						<article class={`esg-card ${index >= 4 ? 'is-collapsed' : ''}`} data-esg-index={index}>
							<a href={art.url} class="esg-card__link">
								<div class="esg-card__media">
									<img src={art.image} alt={art.title} loading="lazy" class="esg-card__img" />
									<span class="esg-card__badge">ESG / SDGs</span>
								</div>
								<div class="esg-card__body">
									<div class="esg-card__meta">
										<time class="esg-card__date">{art.date}</time>
										<span class="esg-meta-sep">/</span>
										<span class="esg-meta-views" title="閲覧数">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="toc-views-icon" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
											<span>{art.views}</span>
										</span>
									</div>
									<h3 class="esg-card__title">{art.title}</h3>
								</div>
							</a>
						</article>
					))}
				</div>

				{esgArticles.length > 4 && (
					<div class="esg-more-wrap" id="esg-more-wrap">
						<button type="button" id="btn-toggle-esg-more" class="btn-esg-more" data-total={esgArticles.length}>
							<span class="btn-esg-more__text">もっと見る（残り{esgArticles.length - 4}件）</span>
							<svg class="btn-esg-more__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
						</button>
					</div>
				)}
			</div>
		</section>
	</main>
</NicoleLayout>

<!-- Apple風スクロールパララックス＆フィルタリング制御スクリプト -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		// ==============================================================
		// 1. Apple風 スクロールパララックス＆ズーム効果
		// ==============================================================
		const heroImg = document.getElementById('apple-hero-img');
		const heroSection = document.getElementById('hero-cover');

		if (heroImg && heroSection) {
			let ticking = false;

			window.addEventListener('scroll', () => {
				if (!ticking) {
					window.requestAnimationFrame(() => {
						const scrollY = window.scrollY;
						const heroHeight = heroSection.offsetHeight;

						if (scrollY <= heroHeight) {
							// スクロールに合わせて背景画像がわずかにゆっくり動き（パララックス）、奥へと引く
							const translateY = scrollY * 0.35;
							const scale = 1.05 - (scrollY / heroHeight) * 0.05;
							heroImg.style.transform = `translate3d(0, ${translateY}px, 0) scale(${Math.max(scale, 1)})`;
						}
						ticking = false;
					});
					ticking = true;
				}
			}, { passive: true });
		}

		// ==============================================================
		// 2. インタラクティブ・フィルタリング＆「もっと見る」制御（PC3列・タブレット2列の両方で余りが出ない10件サイクル）
		// ==============================================================
		const INITIAL_COUNT = 10;
		const LOAD_STEP = 10;
		let visibleCount = INITIAL_COUNT;
		const archiveParams = new URLSearchParams(window.location.search);
		const requestedBrand = archiveParams.get('brand');
		const allowedBrands = ['BMW', 'MINI', 'Ferrari', 'Rolls-Royce', 'ALPINA'];
		let currentBrand = allowedBrands.includes(requestedBrand || '') ? requestedBrand : 'ALL';
		let showLatestArchive = archiveParams.get('view') === 'latest';
		let currentTopic = 'ALL';
		let currentSort = 'latest';
		let searchQuery = '';

		const brandPills = document.querySelectorAll('#brand-filters .filter-pill');
		const topicPills = document.querySelectorAll('#topic-filters .filter-pill');
		const sortSelect = document.getElementById('article-sort-select');
		const searchInput = document.getElementById('article-search-input');
		const gridContainer = document.getElementById('articles-grid');
		const articles = Array.from(document.querySelectorAll('.article-item'));
		const countDisplay = document.getElementById('current-article-count');
		const noArticles = document.getElementById('no-articles');
		const resetBtn = document.getElementById('btn-reset-filters');
		const moreWrap = document.getElementById('articles-more-wrap');
		const loadMoreBtn = document.getElementById('btn-articles-load-more');

		function applyFilters(resetCount = true) {
			if (resetCount) {
				visibleCount = INITIAL_COUNT;
			}

			// 絞り込み（ブランド/カテゴリー/検索/ソート）が行われているか
			const isFiltered = showLatestArchive || (currentBrand !== 'ALL') || (currentTopic !== 'ALL') || (searchQuery.length > 0) || (currentSort !== 'latest');

			const matchedArticles = [];

			articles.forEach(article => {
				const isTop3 = article.getAttribute('data-is-top3') === 'true';
				const brand = article.getAttribute('data-brand') || '';
				const topic = article.getAttribute('data-topic') || '';
				const title = article.getAttribute('data-title') || '';
				const lead = article.getAttribute('data-lead') || '';

				// 初期状態（絞り込みなし）では最新3記事を除外。また「ALL」時はESGは下部専用セクションにあるためグリッドからは除外
				if (!isFiltered) {
					if (isTop3 || topic === 'ESG') {
						article.style.display = 'none';
						return;
					}
				}

				const brandTokens = brand.split('/').map(s => s.trim());
				const matchBrand = (currentBrand === 'ALL') || (brand === currentBrand) || brandTokens.includes(currentBrand);
				const matchTopic = (currentTopic === 'ALL') || (topic === currentTopic);
				const matchSearch = (!searchQuery) || (title.includes(searchQuery) || lead.includes(searchQuery) || brand.toLowerCase().includes(searchQuery));

				if (matchBrand && matchTopic && matchSearch) {
					matchedArticles.push(article);
				} else {
					article.style.display = 'none';
				}
			});

			// ソート順の適用
			if (currentSort === 'latest') {
				matchedArticles.sort((a, b) => {
					const dateA = a.getAttribute('data-date') || '';
					const dateB = b.getAttribute('data-date') || '';
					return dateB.localeCompare(dateA);
				});
			} else if (currentSort === 'popular') {
				matchedArticles.sort((a, b) => {
					const viewsA = parseInt(a.getAttribute('data-views-count') || '0', 10);
					const viewsB = parseInt(b.getAttribute('data-views-count') || '0', 10);
					return viewsB - viewsA;
				});
			} else if (currentSort === 'title') {
				matchedArticles.sort((a, b) => {
					const titleA = a.getAttribute('data-title') || '';
					const titleB = b.getAttribute('data-title') || '';
					return titleA.localeCompare(titleB, 'ja');
				});
			}

			// DOM要素の並び順を反映
			if (gridContainer) {
				matchedArticles.forEach(item => {
					gridContainer.appendChild(item);
				});
			}

			const totalCount = matchedArticles.length;

			// visibleCount までの記事を表示し、それ以降は非表示
			// 10件サイクルで雑誌見開き風のアシンメトリーリズムを付与（0番目: 左ワイド、5番目: 2つ目のワイド）
			// これにより、PC（3列×4行＝12枠）でもタブレット（2列×6行＝12枠）でも余り・端数が出ません
			matchedArticles.forEach((article, idx) => {
				const cycle = idx % 10;
				article.classList.remove('is-featured-lead', 'is-featured-reverse');
				if (cycle === 0) {
					article.classList.add('is-featured-lead');
				} else if (cycle === 5) {
					article.classList.add('is-featured-reverse');
				}

				if (idx < visibleCount) {
					article.style.display = '';
				} else {
					article.style.display = 'none';
				}
			});

			if (countDisplay) {
				countDisplay.textContent = totalCount.toString();
			}

			if (noArticles) {
				noArticles.style.display = totalCount === 0 ? 'block' : 'none';
			}

			// 「もっと見る」ボタンの表示および残り件数の制御
			if (moreWrap && loadMoreBtn) {
				if (visibleCount < totalCount) {
					moreWrap.style.display = 'flex';
					const remaining = totalCount - visibleCount;
					const btnText = loadMoreBtn.querySelector('.btn-articles-load-more__text');
					if (btnText) {
						btnText.textContent = `もっと見る（残り${remaining}件）`;
					}
				} else {
					moreWrap.style.display = 'none';
				}
			}
		}

		// 初期ロード時の実行（初期9件表示）
		brandPills.forEach(pill => pill.classList.toggle('is-active', pill.getAttribute('data-value') === currentBrand));
		applyFilters(true);

		// 「もっと見る」ボタンクリックで古い記事を9件ずつ追加表示
		if (loadMoreBtn) {
			loadMoreBtn.addEventListener('click', () => {
				visibleCount += LOAD_STEP;
				applyFilters(false);
			});
		}

		// ブランドピルクリック切り替え
		brandPills.forEach(pill => {
			pill.addEventListener('click', () => {
				brandPills.forEach(p => p.classList.remove('is-active'));
				pill.classList.add('is-active');
				currentBrand = pill.getAttribute('data-value') || 'ALL';
				applyFilters(true);
			});
		});

		// カテゴリーピルクリック切り替え
		topicPills.forEach(pill => {
			pill.addEventListener('click', () => {
				topicPills.forEach(p => p.classList.remove('is-active'));
				pill.classList.add('is-active');
				currentTopic = pill.getAttribute('data-value') || 'ALL';
				applyFilters(true);
			});
		});

		// ソート切り替え
		if (sortSelect) {
			sortSelect.addEventListener('change', (e) => {
				currentSort = e.target.value;
				applyFilters(true);
			});
		}

		// インクリメンタルキーワード検索
		if (searchInput) {
			searchInput.addEventListener('input', (e) => {
				searchQuery = e.target.value.toLowerCase().trim();
				applyFilters(true);
			});
		}

		// リセットボタン
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				currentBrand = 'ALL';
				showLatestArchive = false;
				currentTopic = 'ALL';
				currentSort = 'latest';
				searchQuery = '';

				brandPills.forEach(p => {
					if (p.getAttribute('data-value') === 'ALL') p.classList.add('is-active');
					else p.classList.remove('is-active');
				});

				topicPills.forEach(p => {
					if (p.getAttribute('data-value') === 'ALL') p.classList.add('is-active');
					else p.classList.remove('is-active');
				});

				if (sortSelect) sortSelect.value = 'latest';
				if (searchInput) searchInput.value = '';

				applyFilters(true);
			});
		}

		// ==============================================================
		// 3. ESG / SDGs 「もっと見る」段階的ロード制御（初期4件、+4件ずつ段階展開）
		// ==============================================================
		const toggleEsgBtn = document.getElementById('btn-toggle-esg-more');
		const esgMoreWrap = document.getElementById('esg-more-wrap');
		if (toggleEsgBtn) {
			const esgCards = Array.from(document.querySelectorAll('.esg-card'));
			const ESG_INITIAL = 4;
			const ESG_STEP = 4;
			let visibleEsgCount = ESG_INITIAL;
			const totalEsgCount = esgCards.length;
			const btnText = toggleEsgBtn.querySelector('.btn-esg-more__text');

			function updateEsgDisplay() {
				esgCards.forEach((card, idx) => {
					if (idx < visibleEsgCount) {
						card.classList.remove('is-collapsed');
					} else {
						card.classList.add('is-collapsed');
					}
				});

				if (visibleEsgCount < totalEsgCount) {
					if (esgMoreWrap) esgMoreWrap.style.display = 'flex';
					const remaining = totalEsgCount - visibleEsgCount;
					if (btnText) {
						btnText.textContent = `もっと見る（残り${remaining}件）`;
					}
				} else {
					if (esgMoreWrap) esgMoreWrap.style.display = 'none';
				}
			}

			toggleEsgBtn.addEventListener('click', () => {
				visibleEsgCount += ESG_STEP;
				updateEsgDisplay();
			});
		}
	});
</script>

<style>
	/* ============================================================== */
	/* Nicole Connect - Apple風大判写真エディトリアルマガジン */
	/* ============================================================== */
	.apple-magazine-main {
		/* 4色のエディトリアル・タイポグラフィ体系（ダークテーマ） */
		--mag-color-heading: #f2f3f6;     /* 1. 見出し・タイトル（白に近い上品なソフトホワイト） */
		--mag-color-lead: #9ea3ae;        /* 2. リード文・本文（圧迫感を減らし読みやすいミディアムグレー） */
		--mag-color-meta: #6b707d;        /* 3. 日付・タグ・閲覧数（補助的なシックグレー） */
