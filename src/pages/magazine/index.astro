	}

	.latest-carousel.is-gathered .latest-carousel__slide[data-gather="prev"],
	.latest-carousel.is-gathered .latest-carousel__slide[data-gather="next"] {
		transform: scale(0.95) translateX(0);
		opacity: 0.42;
	}

	.latest-carousel.is-gathered .latest-carousel__slide.is-active {
		transform: scale(1) translateY(0);
		opacity: 1;
	}

	.latest-carousel.is-gathered:not(.is-motion-done) .latest-card__top-badge {
		opacity: 1;
		transform: translateY(0);
		transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.2s, transform 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
	}

	.latest-carousel.is-gathered:not(.is-motion-done) .latest-card__content {
		opacity: 1;
		transform: translateY(0);
		transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.25s, transform 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.25s;
	}

	.latest-carousel.is-gathered.is-motion-done .latest-card__top-badge,
	.latest-carousel.is-gathered.is-motion-done .latest-card__content {
		opacity: 1;
		transform: none;
		transition: none;
	}

	/* 矢印ボタンも左右の外側から所定位置にスライドイン */
	.latest-carousel:not(.is-gathered) .latest-carousel__arrow--prev {
		opacity: 0;
		transform: translateY(-50%) translateX(-60px);
		pointer-events: none;
	}
	.latest-carousel:not(.is-gathered) .latest-carousel__arrow--next {
		opacity: 0;
		transform: translateY(-50%) translateX(60px);
		pointer-events: none;
	}

	.latest-carousel.is-gathered .latest-carousel__arrow--prev,
	.latest-carousel.is-gathered .latest-carousel__arrow--next {
		opacity: 1;
		transform: translateY(-50%) translateX(0);
		pointer-events: auto;
		transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s, transform 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.35s;
	}

	/* カード本体（写真スライダー構造） */
	.latest-card {
		position: relative;
		width: 100%;
		height: 520px;
		border-radius: var(--radius-card, 4px);
		overflow: hidden;
		background: #0a0c10;
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
		transition: border-color 0.35s ease, box-shadow 0.35s ease;
	}

	.latest-carousel__slide.is-active .latest-card:hover {
		border-color: rgba(255, 255, 255, 0.3);
		box-shadow: 0 24px 60px rgba(0, 0, 0, 0.8);
	}

	.latest-card__media-link {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		text-decoration: none;
	}

	.latest-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		transition: transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.latest-carousel__slide.is-active .latest-card:hover .latest-card__img {
		transform: scale(1.03);
	}

	/* 左側からのシネマティック・グラデーション（文字可読性の完全保証） */
	.latest-card__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(90deg, 
			rgba(5, 7, 10, 0.94) 0%, 
			rgba(5, 7, 10, 0.82) 38%, 
			rgba(5, 7, 10, 0.35) 70%, 
			transparent 100%
		);
		transition: background 0.35s ease;
	}

	/* 写真上部のバッジ表示（ブランド単独・ALL BRANDSの2行折れ防止） */
	.latest-card__top-badge {
		position: absolute;
		top: clamp(28px, 3.2vw, 38px);
		left: clamp(32px, 3.6vw, 44px);
		z-index: 3;
		display: flex;
		align-items: center;
		pointer-events: none;
	}

	.latest-card__brand-tag {
		color: #ffffff;
		background: rgba(7, 8, 10, 0.75);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		padding: 5px 14px;
		border-radius: var(--radius-meta, 0);
		border: 1px solid rgba(255, 255, 255, 0.22);
		font-size: 11px;
		letter-spacing: 0.08em;
		font-weight: 700;
		text-transform: uppercase;
		white-space: nowrap !important;
		flex-shrink: 0;
	}

	/* コンテンツレイヤー（写真の下部に配置・PCにふさわしい上質でゆったりとした余白） */
	.latest-card__content {
		position: relative;
		z-index: 2;
		height: 100%;
		padding: clamp(34px, 3.8vw, 48px);
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		max-width: 680px;
		box-sizing: border-box;
		pointer-events: none;
	}

	.latest-card__meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
		font-size: 11.5px;
		color: rgba(255, 255, 255, 0.7);
		margin-bottom: 8px;
		letter-spacing: 0.02em;
	}

	.latest-card__meta .meta-date {
		font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
		font-size: 11.5px;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.65);
		letter-spacing: 0.02em;
	}

	.latest-card__meta .meta-divider {
		opacity: 0.4;
		font-size: 10px;
		color: rgba(255, 255, 255, 0.5);
	}

	.latest-card__meta .meta-topic {
		color: rgba(255, 255, 255, 0.85);
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.latest-carousel__slide.is-active .latest-card__content {
		pointer-events: auto;
	}

	/* 大きく太い引用風見出し */
	.latest-card__headline {
		font-family: inherit;
		font-size: clamp(22px, 3.2vw, 36px);
		font-weight: 700;
		color: #ffffff;
		line-height: 1.28;
		margin: 0 0 16px 0;
		letter-spacing: -0.015em;
		word-break: auto-phrase !important;
		line-break: strict !important;
	}

	.latest-card__headline-link {
		color: #ffffff;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.latest-card__headline-link:hover {
		color: #ffffff;
	}

	.latest-card__lead {
		font-size: clamp(13px, 1.3vw, 15px);
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.78);
		margin: 0 0 28px 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.latest-card__cta-wrap {
		margin-top: 4px;
	}

	/* 赤系サテンクリムゾンCTAボタン（公式仕様：モノトーン基調＋アクセントレッド） */
	.latest-card__cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 13px 30px;
		background: #b81424;
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: var(--radius-action, 9999px);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-decoration: none;
		width: fit-content;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		box-shadow: 0 4px 18px rgba(0, 0, 0, 0.45);
	}

	.latest-card__cta-btn:hover {
		background: #9f111f;
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.35);
		transform: translateY(-2px);
		box-shadow: 0 8px 26px rgba(0, 0, 0, 0.6);
	}

	.latest-card__cta-btn:active {
		transform: translateY(0);
		background: #8b0f1b;
	}

	.latest-card__cta-arrow {
		width: 16px;
		height: 16px;
		stroke: #ffffff;
		transition: transform 0.25s ease;
	}

	.latest-card__cta-btn:hover .latest-card__cta-arrow {
		transform: translateX(4px);
	}

	/* フロート円形矢印ナビゲーション（透過・ぼかしのラグジュアリー・フロストガラス仕様） */
	.latest-carousel__arrow {
		position: absolute;
		top: calc(16px + 260px) !important; /* PCカード高さ520pxの上下完全中央 (padding-top 16px + 260px = 276px) */
		transform: translateY(-50%) !important;
		width: 48px !important;
		height: 48px !important;
		min-width: 48px !important;
		max-width: 48px !important;
		padding: 0 !important;
		border-radius: 50% !important;
		background: rgba(255, 255, 255, 0.16) !important;
		backdrop-filter: blur(16px) saturate(160%) !important;
		-webkit-backdrop-filter: blur(16px) saturate(160%) !important;
		border: 1px solid rgba(255, 255, 255, 0.32) !important;
		color: #ffffff !important;
		box-shadow: 0 8px 28px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.25) !important;
		cursor: pointer;
		display: flex !important;
		align-items: center;
		justify-content: center;
		z-index: 20;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		box-sizing: border-box;
	}

	.latest-carousel__arrow svg {
		width: 22px !important;
		height: 22px !important;
		display: block !important;
		stroke: #ffffff !important;
		color: #ffffff !important;
		fill: none !important;
		flex-shrink: 0;
	}

	.latest-carousel__arrow:hover {
		transform: translateY(-50%) scale(1.08) !important;
		background: rgba(255, 255, 255, 0.28) !important;
		border-color: rgba(255, 255, 255, 0.6) !important;
		box-shadow: 0 12px 36px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.45) !important;
	}

	.latest-carousel__arrow:active {
		transform: translateY(-50%) scale(0.96) !important;
		background: rgba(255, 255, 255, 0.2) !important;
	}

	.latest-carousel__arrow--prev {
		left: clamp(28px, 3.5vw, 48px);
	}

	.latest-carousel__arrow--next {
		right: clamp(28px, 3.5vw, 48px);
	}

	/* 下部中央インジケータードット */
	.latest-carousel__dots {
		position: absolute;
		bottom: 20px;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		gap: 8px;
		z-index: 20;
	}

	.latest-carousel__dot {
		appearance: none;
		border: none;
		padding: 0;
		cursor: pointer;
		height: 6px;
		width: 6px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.4);
		transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.latest-carousel__dot:hover {
		background: rgba(255, 255, 255, 0.7);
	}

	.latest-carousel__dot.is-active {
		width: 24px;
		border-radius: 9999px;
		background: #ffffff;
	}

	/* レスポンシブ最適化 */
	@media (max-width: 1024px) {
		.latest-carousel__track {
			gap: 14px;
		}
		.latest-carousel__slide {
			width: 84vw;
		}
		.latest-card {
			height: 480px;
		}
		.latest-carousel__arrow {
			top: calc(16px + 240px) !important; /* タブレットカード高さ480pxの上下完全中央 (padding-top 16px + 240px = 256px) */
		}
		.latest-carousel__arrow--prev {
			left: 20px;
		}
		.latest-carousel__arrow--next {
			right: 20px;
		}
	}

	@media (max-width: 768px) {
		.latest-carousel-section {
			padding: 50px 0 40px 0;
		}
		.latest-carousel {
			padding: 8px 0 52px; /* ドットとウインドウの余白を十分に確保 */
		}
		.latest-carousel__track {
			gap: 12px;
		}
		.latest-carousel__slide {
			width: 90vw;
		}
		.latest-card {
			height: 440px;
		}
		.latest-card__overlay {
			background: linear-gradient(180deg, 
				rgba(5, 7, 10, 0.15) 0%, 
				rgba(5, 7, 10, 0.35) 40%, 
				rgba(5, 7, 10, 0.94) 80%
			);
		}
		.latest-card__top-badge {
			top: 22px;
			left: 22px;
		}
		.latest-card__brand-tag {
			padding: 4px 10px;
			font-size: 10.5px;
			white-space: nowrap !important;
		}
		/* 写真の中のパディングは下の記事（22px）と統一 */
		.latest-card__content {
			justify-content: flex-end;
			padding: 22px !important;
			max-width: 100%;
		}
		.latest-card__headline {
			font-size: 18px;
			line-height: 1.35;
			margin-bottom: 12px;
		}
		/* スマホ時は中身テキスト（リード文）を非表示にして写真を美しく主役に */
		.latest-card__lead {
			display: none !important;
		}
		.latest-card__cta-wrap {
			margin-top: 0;
		}
		.latest-card__cta-btn {
			padding: 9px 20px;
			font-size: 12.5px;
		}
		/* 左右移動丸ボタンはカードの上下完全中央配置（padding-top 8px + カード高さ440px / 2 = 228px） */
		.latest-carousel__arrow {
			width: 34px !important;
			height: 34px !important;
			min-width: 34px !important;
			max-width: 34px !important;
			top: calc(8px + 220px) !important;
			transform: translateY(-50%) !important;
		}
		.latest-carousel__arrow svg {
			width: 15px !important;
			height: 15px !important;
		}
		.latest-carousel__arrow--prev {
			left: 6px !important;
		}
		.latest-carousel__arrow--next {
			right: 6px !important;
		}
		.latest-carousel__dots {
			bottom: 18px; /* カード下部および次セクションとの十分な距離 */
		}
	}

	/* ============================================================== */
	/* スクロール連動エントランスモーション（Stagger Wave / 時間差リビール） */
	/* ============================================================== */
	.popular-card,
	.article-item,
	.esg-card {
		opacity: 0;
		transform: translateY(24px) scale(0.985);
		transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), 
		            transform 0.75s cubic-bezier(0.16, 1, 0.3, 1), 
		            border-color 0.35s ease, 
		            box-shadow 0.35s ease;
		will-change: opacity, transform;
	}

	.popular-card.is-revealed,
	.article-item.is-revealed,
	.esg-card.is-revealed {
		opacity: 1;
		transform: translateY(0) scale(1);
	}

	/* 1. 人気の記事（POPULAR STORIES）：左から順に1位〜5位へ波打つ時間差（0.08s刻み） */
	.popular-grid .popular-card:nth-child(1) { transition-delay: 0s; }
	.popular-grid .popular-card:nth-child(2) { transition-delay: 0.08s; }
	.popular-grid .popular-card:nth-child(3) { transition-delay: 0.16s; }
	.popular-grid .popular-card:nth-child(4) { transition-delay: 0.24s; }
	.popular-grid .popular-card:nth-child(5) { transition-delay: 0.32s; }

	/* 2. 全記事アーカイブ（ALL STORIES）：行ごとに左から右へ流れる時間差（3列/2列対応） */
	@media (min-width: 1025px) {
		.articles-grid .article-item:nth-child(3n + 1) { transition-delay: 0s; }
		.articles-grid .article-item:nth-child(3n + 2) { transition-delay: 0.07s; }
		.articles-grid .article-item:nth-child(3n + 3) { transition-delay: 0.14s; }
	}

	@media (min-width: 641px) and (max-width: 1024px) {
		.articles-grid .article-item:nth-child(2n + 1) { transition-delay: 0s; }
		.articles-grid .article-item:nth-child(2n + 2) { transition-delay: 0.08s; }
	}

	@media (max-width: 640px) {
		.articles-grid .article-item { transition-delay: 0s; }
	}

	/* 3. ESG / SDGs カード：4列グリッドでの心地よい時間差（0.07s刻み） */
	@media (min-width: 1025px) {
		.esg-cards-grid .esg-card:nth-child(4n + 1) { transition-delay: 0s; }
		.esg-cards-grid .esg-card:nth-child(4n + 2) { transition-delay: 0.07s; }
		.esg-cards-grid .esg-card:nth-child(4n + 3) { transition-delay: 0.14s; }
		.esg-cards-grid .esg-card:nth-child(4n + 4) { transition-delay: 0.21s; }
	}

	@media (min-width: 641px) and (max-width: 1024px) {
		.esg-cards-grid .esg-card:nth-child(2n + 1) { transition-delay: 0s; }
		.esg-cards-grid .esg-card:nth-child(2n + 2) { transition-delay: 0.08s; }
	}

	/* マウスホバー時は即応性を最優先（transition-delay をゼロにして快適に追従） */
	.popular-card.is-revealed:hover,
	.article-item.is-revealed:hover,
	.esg-card.is-revealed:hover {
		transition-delay: 0s !important;
	}

	.popular-card.is-revealed:hover {
		transform: translateY(-4px) scale(1);
	}

	.article-item.is-revealed:hover {
		transform: translateY(-5px) scale(1);
	}

	.esg-card.is-revealed:hover {
		transform: translateY(-5px) scale(1);
	}

	@media (prefers-reduced-motion: reduce) {
		.popular-card,
		.article-item,
		.esg-card {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
			transition-delay: 0s !important;
		}
	}

	/* ============================================================== */
	/* 3. 人気の記事ランキング（POPULAR STORIES）- 明暗アクセント帯 */
	/* ============================================================== */
	.popular-section {
		padding: 76px 0 68px 0;
		background: #f4f5f8;
		color: #111114;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
	}

	.popular-header {
		margin-bottom: 32px;
	}

	.popular-heading {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
		font-size: clamp(26px, 2.8vw, 34px);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #111114 !important;
		line-height: 1.25;
		margin: 0 0 8px 0;
	}

	.popular-sub {
		font-size: 14px;
		color: #55555c !important;
		margin: 0;
	}

	.popular-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 18px;
	}

	.popular-card {
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: var(--radius-card, 4px);
		overflow: hidden;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
	}

	.popular-card:hover {
		border-color: rgba(0, 0, 0, 0.18);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
	}

	.popular-card__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: #111114;
	}

	.popular-card__media {
		position: relative;
		height: 140px;
		overflow: hidden;
		background: #000000;
	}

	.popular-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.popular-card:hover .popular-card__img {
		transform: scale(1.05);
	}

	.popular-card__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.45) 100%);
	}

	.popular-rank-badge {
		position: absolute;
		top: 10px;
		left: 10px;
		width: 24px;
		height: 24px;
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
		font-size: 12px;
		font-weight: 700;
		background: #111114;
		color: #ffffff !important;
		border: 1px solid rgba(255, 255, 255, 0.2);
		z-index: 2;
	}

	.popular-rank-badge.is-top {
		background: #b81424;
		color: #ffffff !important;
		border-color: #b81424;
		box-shadow: 0 2px 8px rgba(184, 20, 36, 0.35);
	}

	.popular-card__body {
		padding: 14px 14px 16px 14px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.popular-card__meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		color: #666672 !important;
		margin-bottom: 8px;
	}

	.popular-meta-brand {
		font-weight: 700;
		color: #111114 !important;
	}

	.popular-meta-sep {
		opacity: 0.4;
		color: #9999a4 !important;
	}

	.popular-meta-views {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: #666672 !important;
	}

	.popular-meta-views svg {
		stroke: #666672;
	}

	.popular-card__title {
		font-size: 13.5px;
		font-weight: 600;
		line-height: 1.45;
		color: #111114 !important;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.3s ease;
	}

	.popular-card:hover .popular-card__title {
		color: #000000 !important;
	}

	@media (max-width: 1024px) {
		.popular-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 640px) {
		.popular-section {
			padding: 48px 0 40px 0;
		}

		.popular-grid {
			display: flex;
			overflow-x: auto;
			gap: 14px;
			padding-bottom: 12px;
			scroll-snap-type: x mandatory;
			-webkit-overflow-scrolling: touch;
		}

		.popular-card {
			flex: 0 0 220px;
			scroll-snap-align: start;
		}
	}

	/* ============================================================== */
	/* 4. インタラクティブ・フィルターバー */
	/* ============================================================== */
	.filter-sticky-bar {
		position: sticky;
		top: 60px;
		z-index: 500;
		background: rgba(0, 0, 0, 0.96);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		padding: 16px 0 20px 0;
		margin-bottom: 32px;
		border-bottom: 1px solid var(--mag-color-border);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.4);
	}

	.filter-wrap {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: nowrap;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.filter-wrap::-webkit-scrollbar {
		display: none;
	}

	.filter-group {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-shrink: 0;
	}

	.filter-group--topic {
		padding-left: 20px;
		border-left: 1px solid var(--mag-color-border);
	}

	.filter-group__label {
		display: inline-flex;
		align-items: center;
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Hiragino Kaku Gothic ProN", sans-serif;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--mag-color-meta);
		background: none;
		border: none;
		flex-shrink: 0;
		white-space: nowrap;
		margin-right: 2px;
	}

	.filter-pills {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: nowrap;
	}

	.filter-pill {
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid var(--mag-color-border);
		color: var(--mag-color-lead);
		padding: 5px 13px;
		border-radius: var(--radius-action, 9999px);
		font-size: 11.5px;
		font-weight: 600;
		letter-spacing: 0.04em;
		cursor: pointer;
		white-space: nowrap;
		transition: all 0.25s ease;
	}

	.filter-pill:hover {
		background: rgba(255, 255, 255, 0.14);
		color: var(--mag-color-heading);
		border-color: rgba(255, 255, 255, 0.35);
	}

	/* ブランドを選択するボタン：今押されている（アクティブ）ボタンは赤地に白文字 */
	.filter-pill.is-active {
		background: #e50012;
		border-color: #e50012;
		color: #ffffff;
		font-weight: 700;
		box-shadow: 0 2px 14px rgba(229, 0, 18, 0.45);
	}

	.filter-controls-right {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: nowrap;
		flex-shrink: 0;
		margin-left: auto;
	}

	.filter-search-box {
		position: relative;
		display: flex;
		align-items: center;
		gap: 8px;
		height: 34px;
		box-sizing: border-box;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid var(--mag-color-border);
		border-radius: var(--radius-action, 9999px);
		padding: 0 14px;
		width: 210px;
		flex-shrink: 0;
		transition: border-color 0.25s ease, box-shadow 0.25s ease, width 0.3s ease;
	}

	.filter-search-box:focus-within {
		border-color: rgba(255, 255, 255, 0.5);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25);
		width: 250px;
	}

	.search-icon {
		width: 13px;
		height: 13px;
		stroke: var(--mag-color-meta);
		flex-shrink: 0;
	}

	.filter-search-box input {
		background: none;
		border: none;
		color: var(--mag-color-heading);
		font-size: 12px;
		width: 100%;
		outline: none;
	}

	.filter-search-box input::placeholder {
		color: var(--mag-color-meta);
	}

	/* ============================================================== */
	/* 4. 全記事エディトリアルグリッド（LIBRARY） */
	/* ============================================================== */
	.all-articles-section {
		padding: 60px 0 120px 0;
	}

	.section-title-bar {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 20px;
		padding-bottom: 4px;
		border-bottom: none;
	}

	.section-num {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
		font-size: 11px;
		font-weight: 700;
		color: var(--mag-color-meta);
		letter-spacing: 0.2em;
		display: block;
		margin-bottom: 4px;
	}

	.section-heading {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
		font-size: clamp(32px, 3.4vw, 42px);
		font-weight: 700;
		color: var(--mag-color-heading) !important;
		margin: 0;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.count-display {
		font-size: 13px;
		color: var(--mag-color-meta);
	}

	.count-display span {
		color: var(--mag-color-heading);
		font-weight: 700;
	}

	.articles-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.article-item {
		background: #090b0e;
		border: 1px solid var(--mag-color-border);
		border-radius: var(--radius-card, 4px);
		overflow: hidden;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.article-item:hover {
		border-color: rgba(255, 255, 255, 0.35);
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
	}

	.article-item__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.article-item__media {
		position: relative;
		height: 220px;
		overflow: hidden;
		background: #000;
	}

	.article-item__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.article-item:hover .article-item__img {
		transform: scale(1.05);
	}

	.article-item__overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, transparent 50%, rgba(9, 11, 14, 0.8) 100%);
	}

	.article-brand-pill {
		position: absolute;
		top: 14px;
		left: 14px;
		padding: 3px 10px;
		background: rgba(7, 8, 10, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: var(--radius-meta, 0);
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--mag-color-heading);
		backdrop-filter: blur(8px);
	}

	.article-item__body {
		padding: 22px 22px 22px 22px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		box-sizing: border-box;
	}

	.article-item__meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11.5px;
		color: var(--mag-color-meta);
		margin-bottom: 8px;
	}

	.meta-divider {
		opacity: 0.4;
	}

	.meta-topic {
		color: var(--mag-color-meta);
		font-weight: 600;
	}

	.article-item__title {
		font-size: 16px;
		font-weight: 600;
		line-height: 1.45;
		color: var(--mag-color-heading) !important;
		margin: 0 0 10px 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: 2.9em;
		transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1), text-shadow 0.3s ease;
	}

	.article-item:hover .article-item__title {
		color: #ffffff !important;
		text-shadow: 0 0 14px rgba(255, 255, 255, 0.3);
	}

	.article-item__lead {
		font-size: 13px;
		color: var(--mag-color-lead);
		line-height: 1.6;
		margin: 0 0 18px 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: 3.2em;
		flex: none;
		transition: color 0.3s ease;
	}

	.article-item__lead.is-empty {
		min-height: 3.2em;
		margin: 0 0 18px 0;
		display: block;
	}

	.article-item:hover .article-item__lead {
		color: var(--mag-color-heading);
	}

	.article-item__footer {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 11.5px;
		padding-top: 14px;
		border-top: 1px solid var(--mag-color-border);
		margin-top: auto;
	}

	.article-item__more {
		color: var(--mag-color-heading);
		font-weight: 600;
		transition: color 0.25s ease, transform 0.25s ease;
	}

	.article-item:hover .article-item__more {
		color: #ffffff;
	}

	.article-item__views {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: var(--mag-color-meta);
		font-size: 11px;
		opacity: 0.85;
		letter-spacing: 0.04em;
	}

	.card-views-icon {
		width: 12px;
		height: 12px;
		stroke-width: 1.8;
		opacity: 0.85;
	}

	/* ============================================================== */
	/* 雑誌見開き風・アシンメトリー特集カード（左ワイド＆右ワイド） */
	/* ============================================================== */
	@media (min-width: 1024px) {
		.article-item.is-featured-lead,
		.article-item.is-featured-reverse {
			grid-column: span 2;
			background: #0c0f14;
			border-color: rgba(255, 255, 255, 0.18);
			box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
		}

		/* 0番目（左ワイド）：テキスト幅を上下カード（2列目）と完全一致させ、写真を大きく広げて箱パディング（22px）と揃える */
		.article-item.is-featured-lead .article-item__link {
			display: grid;
			grid-template-columns: calc((100% + 28px) / 2) calc((100% - 28px) / 2);
			column-gap: 0;
			height: 100%;
		}

		.article-item.is-featured-lead .article-item__media {
			height: 100%;
			min-height: 280px;
		}

		/* 5番目（右ワイド）：テキスト幅を上下カード（1列目）と完全一致させ、写真を大きく広げて箱パディング（22px）と揃える */
		.article-item.is-featured-reverse .article-item__link {
			display: grid;
			grid-template-columns: calc((100% - 28px) / 2) calc((100% + 28px) / 2);
			column-gap: 0;
			height: 100%;
		}

		.article-item.is-featured-reverse .article-item__media {
			order: 2;
			height: 100%;
			min-height: 280px;
		}

		.article-item.is-featured-reverse .article-item__body {
			order: 1;
		}

		/* ワイドカード共通のテキストエリア設定（通常カードと全く同じpadding: 22pxで「記」の開始位置・距離を完全同期） */
		.article-item.is-featured-lead .article-item__body,
		.article-item.is-featured-reverse .article-item__body {
			padding: 22px;
			display: flex;
			flex-direction: column;
			justify-content: flex-start;
			height: 100%;
			box-sizing: border-box;
		}

		.article-item.is-featured-lead .article-item__meta,
		.article-item.is-featured-reverse .article-item__meta {
			font-size: 11.5px;
			margin-bottom: 8px;
		}

		.article-item.is-featured-lead .article-item__title,
		.article-item.is-featured-reverse .article-item__title {
			font-size: 17px;
			line-height: 1.42;
			font-weight: 600;
			margin-bottom: 10px;
			min-height: 2.9em;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		.article-item.is-featured-lead .article-item__lead,
		.article-item.is-featured-reverse .article-item__lead {
			font-size: 13px;
			line-height: 1.6;
			margin-bottom: 18px;
			min-height: 3.2em;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
		}

		/* フッターの位置と境界線を通常カードと完全に一致させる */
		.article-item.is-featured-lead .article-item__footer,
		.article-item.is-featured-reverse .article-item__footer {
			margin-top: auto;
			padding-top: 14px;
			border-top: 1px solid var(--mag-color-border);
		}
	}

	@media (max-width: 1023px) and (min-width: 768px) {
		.article-item.is-featured-lead,
		.article-item.is-featured-reverse {
			grid-column: span 2;
		}

		.article-item.is-featured-lead .article-item__link {
			display: grid;
			grid-template-columns: calc((100% + 28px) / 2) calc((100% - 28px) / 2);
			column-gap: 0;
			height: 100%;
		}

		.article-item.is-featured-reverse .article-item__link {
			display: grid;
			grid-template-columns: calc((100% - 28px) / 2) calc((100% + 28px) / 2);
			column-gap: 0;
			height: 100%;
		}

		.article-item.is-featured-reverse .article-item__media {
			order: 2;
		}

		.article-item.is-featured-reverse .article-item__body {
			order: 1;
		}

		.article-item.is-featured-lead .article-item__body,
		.article-item.is-featured-reverse .article-item__body {
			padding: 22px;
			display: flex;
			flex-direction: column;
			height: 100%;
			box-sizing: border-box;
		}

		.article-item.is-featured-lead .article-item__footer,
		.article-item.is-featured-reverse .article-item__footer {
			margin-top: auto;
			padding-top: 14px;
			border-top: 1px solid var(--mag-color-border);
		}
	}

	/* ============================================================== */
	/* ALL STORIES & ESSAYS 「もっと見る」ボタン（モノトーンエディトリアルデザイン） */
	/* ============================================================== */
	.all-articles-more-wrap {
		display: flex;
		justify-content: center;
		margin-top: 48px;
		padding-top: 36px;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.btn-articles-load-more {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-size: 13.5px;
		font-weight: 600;
		color: var(--magazine-text-color);
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 9999px;
		padding: 12px 34px;
		cursor: pointer;
		transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		user-select: none;
	}

	.btn-articles-load-more:hover {
		background: rgba(255, 255, 255, 0.14);
		border-color: rgba(255, 255, 255, 0.35);
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
	}

	.btn-articles-load-more__icon {
		width: 15px;
		height: 15px;
		transition: transform 0.2s ease;
	}

	.btn-articles-load-more:hover .btn-articles-load-more__icon {
		transform: translateY(2px);
	}

	/* 検索該当なし状態 */
	.no-articles-state {
		text-align: center;
		padding: 80px 20px;
		background: #090b0e;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: var(--radius-card, 4px);
		margin-top: 20px;
	}

	.no-articles-icon {
		width: 56px;
		height: 56px;
		margin: 0 auto 20px auto;
		color: var(--magazine-text-color);
	}

	.no-articles-icon svg {
		width: 100%;
		height: 100%;
	}

	.no-articles-title {
		font-size: 18px;
		font-weight: 600;
		margin: 0 0 8px 0;
		color: var(--magazine-text-color);
	}

	.no-articles-desc {
		font-size: 14px;
		color: var(--magazine-text-color);
		margin: 0 0 24px 0;
	}

	.btn-reset-filters {
		background: #ffffff;
		color: #000000;
		border: none;
		padding: 10px 24px;
		border-radius: var(--radius-action, 9999px);
		font-size: 13px;
		font-weight: 700;
		cursor: pointer;
		transition: background 0.25s ease, transform 0.25s ease;
	}

	.btn-reset-filters:hover {
		background: #e4e4e7;
		transform: translateY(-2px);
	}

	/* ============================================================== */
	/* レスポンシブ対応（モバイル・タブレット） */
	/* ============================================================== */
	@media (max-width: 1200px) {
		.toc-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.articles-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 1024px) {
		.mag-container {
			padding: 0 24px;
		}
	}

	@media (max-width: 768px) {
