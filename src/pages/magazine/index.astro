		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.apple-cta-btn svg {
		width: 16px;
		height: 16px;
		transition: transform 0.3s ease;
	}

	.apple-cta-btn--primary {
		background: #ffffff;
		color: #040507;
		box-shadow: 0 4px 20px rgba(255, 255, 255, 0.25);
	}

	.apple-cta-btn--primary:hover {
		background: #e4e4e7;
		transform: translateY(-2px);
		box-shadow: 0 8px 30px rgba(255, 255, 255, 0.4);
	}

	.apple-cta-btn--primary:hover svg {
		transform: translateX(4px);
	}

	.apple-cta-btn--secondary {
		background: rgba(255, 255, 255, 0.12);
		color: var(--magazine-text-color);
		border: 1px solid rgba(255, 255, 255, 0.3);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
	}

	.apple-cta-btn--secondary:hover {
		background: rgba(255, 255, 255, 0.22);
		border-color: rgba(255, 255, 255, 0.6);
		transform: translateY(-2px);
		box-shadow: 0 8px 30px rgba(0, 0, 0, 0.55);
	}

	.apple-cta-btn--secondary:hover svg {
		transform: translateX(4px);
	}

	/* スクロールキュー */
	.apple-hero__scroll-cue {
		position: absolute;
		bottom: 24px;
		right: 48px;
		z-index: 10;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		color: var(--magazine-text-color);
		transition: color 0.3s ease;
	}

	.apple-hero__scroll-cue:hover {
		color: var(--magazine-text-color);
	}

	.scroll-cue-text {
		font-size: 9px;
		font-weight: 800;
		letter-spacing: 0.25em;
		writing-mode: vertical-rl;
	}

	.scroll-cue-line {
		width: 1px;
		height: 36px;
		background: linear-gradient(180deg, #ffffff 0%, transparent 100%);
		animation: scrollDrop 1.8s infinite ease-in-out;
	}

	@keyframes scrollDrop {
		0% { transform: scaleY(0); transform-origin: top; }
		50% { transform: scaleY(1); transform-origin: top; }
		50.1% { transform: scaleY(1); transform-origin: bottom; }
		100% { transform: scaleY(0); transform-origin: bottom; }
	}

	/* ============================================================== */
	/* 2. 本の見開き目次（TABLE OF CONTENTS） */
	/* ============================================================== */
	.toc-section {
		padding: 90px 0 70px 0;
		background: #06070a;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.toc-header {
		margin-bottom: 44px;
	}

	.toc-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: var(--magazine-text-color);
		margin-bottom: 10px;
	}

	.badge-accent {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #ffffff;
	}

	.toc-heading {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
		font-size: clamp(32px, 3.4vw, 42px);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--magazine-text-color);
		line-height: 1.2;
		margin: 0 0 12px 0;
	}

	.toc-sub {
		font-size: 15px;
		color: var(--magazine-text-color);
		margin: 0;
	}

	.toc-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 32px;
	}

	.toc-card {
		background: #0a0d12;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 14px;
		overflow: hidden;
		transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
	}

	.toc-card:hover {
		transform: translateY(-6px);
		border-color: rgba(255, 255, 255, 0.35);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
	}

	.toc-card__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.toc-card__media {
		position: relative;
		height: 320px;
		overflow: hidden;
		background: #000;
	}

	.toc-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.toc-card:hover .toc-card__img {
		transform: scale(1.06);
	}

	.toc-card__overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, transparent 40%, rgba(10, 13, 18, 0.8) 100%);
	}

	.toc-card__brand {
		position: absolute;
		top: 14px;
		left: 14px;
		padding: 3px 10px;
		background: rgba(7, 8, 10, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 999px;
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--magazine-text-color);
		backdrop-filter: blur(8px);
	}

	.toc-card__body {
		padding: 28px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.toc-card__meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		color: var(--mag-color-meta);
		margin-bottom: 8px;
	}

	.toc-meta-views {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		opacity: 0.85;
	}

	.toc-views-icon {
		width: 12px;
		height: 12px;
		stroke-width: 1.8;
		opacity: 0.85;
	}

	.toc-meta-topic {
		color: var(--mag-color-meta);
		font-weight: 600;
	}

	.toc-card__title {
		font-size: 20px;
		font-weight: 600;
		line-height: 1.4;
		color: var(--mag-color-heading) !important;
		margin: 0 0 12px 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1), text-shadow 0.3s ease;
	}

	.toc-card:hover .toc-card__title {
		color: #ffffff !important;
		text-shadow: 0 0 16px rgba(255, 255, 255, 0.35);
	}

	.toc-card__lead {
		font-size: 14px;
		color: var(--mag-color-lead);
		line-height: 1.6;
		margin: 0 0 20px 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: none;
		transition: color 0.3s ease;
	}

	.toc-card:hover .toc-card__lead {
		color: var(--mag-color-heading);
	}

	.toc-card__arrow {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 13px;
		font-weight: 700;
		color: var(--mag-color-heading);
		margin-top: auto;
		transition: color 0.3s ease, transform 0.3s ease;
	}

	.toc-card:hover .toc-card__arrow {
		color: #ffffff;
	}

	.toc-card__arrow svg {
		width: 14px;
		height: 14px;
		transition: transform 0.3s ease;
	}

	.toc-card:hover .toc-card__arrow svg {
		transform: translateX(4px);
	}

	/* ============================================================== */
	/* 3. 人気の記事ランキング（POPULAR STORIES）- 明暗アクセント帯 */
	/* ============================================================== */
	.popular-section {
		padding: 76px 0 68px 0;
		background: #f4f5f8;
		color: #111114;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		border-bottom: 1px solid rgba(0, 0, 0, 0.08);
	}

	.popular-header {
		margin-bottom: 32px;
	}

	.popular-heading {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
		font-size: clamp(26px, 2.8vw, 34px);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: #111114 !important;
		line-height: 1.25;
		margin: 0 0 8px 0;
	}

	.popular-sub {
		font-size: 14px;
		color: #55555c !important;
		margin: 0;
	}

	.popular-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 18px;
	}

	.popular-card {
		background: #ffffff;
		border: 1px solid rgba(0, 0, 0, 0.08);
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
		transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.popular-card:hover {
		transform: translateY(-4px);
		border-color: rgba(0, 0, 0, 0.18);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
	}

	.popular-card__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: #111114;
	}

	.popular-card__media {
		position: relative;
		height: 140px;
		overflow: hidden;
		background: #000000;
	}

	.popular-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.popular-card:hover .popular-card__img {
		transform: scale(1.05);
	}

	.popular-card__overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.45) 100%);
	}

	.popular-rank-badge {
		position: absolute;
		top: 10px;
		left: 10px;
		width: 24px;
		height: 24px;
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono, monospace);
		font-size: 11.5px;
		font-weight: 700;
		background: #f0f0f3;
		color: #44444c !important;
		border: 1px solid rgba(0, 0, 0, 0.12);
		z-index: 2;
	}

	.popular-rank-badge.is-top {
		background: #111114;
		color: #ffffff !important;
		border-color: #111114;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
	}

	.popular-card__body {
		padding: 14px 14px 16px 14px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.popular-card__meta {
		display: flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		color: #666672 !important;
		margin-bottom: 8px;
	}

	.popular-meta-brand {
		font-weight: 700;
		color: #111114 !important;
	}

	.popular-meta-sep {
		opacity: 0.4;
		color: #9999a4 !important;
	}

	.popular-meta-views {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		color: #666672 !important;
	}

	.popular-meta-views svg {
		stroke: #666672;
	}

	.popular-card__title {
		font-size: 13.5px;
		font-weight: 600;
		line-height: 1.45;
		color: #111114 !important;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: color 0.3s ease;
	}

	.popular-card:hover .popular-card__title {
		color: #000000 !important;
	}

	@media (max-width: 1024px) {
		.popular-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}

	@media (max-width: 640px) {
		.popular-section {
			padding: 48px 0 40px 0;
		}

		.popular-grid {
			display: flex;
			overflow-x: auto;
			gap: 14px;
			padding-bottom: 12px;
			scroll-snap-type: x mandatory;
			-webkit-overflow-scrolling: touch;
		}

		.popular-card {
			flex: 0 0 220px;
			scroll-snap-align: start;
		}
	}

	/* ============================================================== */
	/* 4. インタラクティブ・フィルターバー */
	/* ============================================================== */
	.filter-sticky-bar {
		position: sticky;
		top: 70px;
		z-index: 500;
		background: rgba(6, 7, 10, 0.94);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		padding: 24px 0;
		box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
	}

	/* すぐ下の1ピクセルの線：モニタ全幅ではなく、ページレイアウト最大幅（コンテンツ端）と完全に一致 */
	.filter-sticky-bar .mag-container {
		position: relative;
	}

	.filter-sticky-bar .mag-container::after {
		content: "";
		position: absolute;
		bottom: -24px;
		left: 40px;
		right: 40px;
		height: 1px;
		background: var(--mag-color-border);
		pointer-events: none;
	}

	.filter-wrap {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: nowrap;
		width: 100%;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: none;
	}

	.filter-wrap::-webkit-scrollbar {
		display: none;
	}

	.filter-group {
		display: flex;
		align-items: center;
		gap: 10px;
		flex-shrink: 0;
	}

	.filter-group--topic {
		padding-left: 20px;
		border-left: 1px solid var(--mag-color-border);
	}

	.filter-group__label {
		display: inline-flex;
		align-items: center;
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Hiragino Kaku Gothic ProN", sans-serif;
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--mag-color-meta);
		background: none;
		border: none;
		flex-shrink: 0;
		white-space: nowrap;
		margin-right: 2px;
	}

	.filter-pills {
		display: flex;
		align-items: center;
		gap: 6px;
		flex-wrap: nowrap;
	}

	.filter-pill {
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid var(--mag-color-border);
		color: var(--mag-color-lead);
		padding: 5px 13px;
		border-radius: 999px;
		font-size: 11.5px;
		font-weight: 600;
		letter-spacing: 0.04em;
		cursor: pointer;
		white-space: nowrap;
		transition: all 0.25s ease;
	}

	.filter-pill:hover {
		background: rgba(255, 255, 255, 0.14);
		color: var(--mag-color-heading);
		border-color: rgba(255, 255, 255, 0.35);
	}

	/* ブランドを選択するボタン：今押されている（アクティブ）ボタンは赤地に白文字 */
	.filter-pill.is-active {
		background: #e50012;
		border-color: #e50012;
		color: #ffffff;
		font-weight: 700;
		box-shadow: 0 2px 14px rgba(229, 0, 18, 0.45);
	}

	.filter-controls-right {
		display: flex;
		align-items: center;
		gap: 20px;
		flex-wrap: nowrap;
		flex-shrink: 0;
		margin-left: auto;
	}

	.filter-search-box {
		position: relative;
		display: flex;
		align-items: center;
		gap: 8px;
		height: 34px;
		box-sizing: border-box;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid var(--mag-color-border);
		border-radius: 999px;
		padding: 0 14px;
		width: 170px;
		flex-shrink: 0;
		transition: border-color 0.25s ease, box-shadow 0.25s ease, width 0.3s ease;
	}

	.filter-search-box:focus-within {
		border-color: rgba(255, 255, 255, 0.5);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.25);
		width: 210px;
	}

	.search-icon {
		width: 13px;
		height: 13px;
		stroke: var(--mag-color-meta);
		flex-shrink: 0;
	}

	.filter-search-box input {
		background: none;
		border: none;
		color: var(--mag-color-heading);
		font-size: 12px;
		width: 100%;
		outline: none;
	}

	.filter-search-box input::placeholder {
		color: var(--mag-color-meta);
	}

	/* ============================================================== */
	/* 4. 全記事エディトリアルグリッド（LIBRARY） */
	/* ============================================================== */
	.all-articles-section {
		padding: 60px 0 120px 0;
	}

	.section-title-bar {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 36px;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--mag-color-border);
	}

	.section-num {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", sans-serif;
		font-size: 11px;
		font-weight: 700;
		color: var(--mag-color-meta);
		letter-spacing: 0.2em;
		display: block;
		margin-bottom: 4px;
	}

	.section-heading {
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", sans-serif;
		font-size: clamp(32px, 3.4vw, 42px);
		font-weight: 700;
		color: var(--mag-color-heading) !important;
		margin: 0;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}

	.count-display {
		font-size: 13px;
		color: var(--mag-color-meta);
	}

	.count-display span {
		color: var(--mag-color-heading);
		font-weight: 700;
	}

	.articles-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.article-item {
		background: #090b0e;
		border: 1px solid var(--mag-color-border);
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.article-item:hover {
		transform: translateY(-5px);
		border-color: rgba(255, 255, 255, 0.35);
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.6);
	}

	.article-item__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.article-item__media {
		position: relative;
		height: 220px;
		overflow: hidden;
		background: #000;
	}

	.article-item__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.article-item:hover .article-item__img {
		transform: scale(1.05);
	}

	.article-item__overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(180deg, transparent 50%, rgba(9, 11, 14, 0.8) 100%);
	}

	.article-brand-pill {
		position: absolute;
		top: 14px;
		left: 14px;
		padding: 3px 10px;
		background: rgba(7, 8, 10, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 999px;
		font-size: 10.5px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--mag-color-heading);
		backdrop-filter: blur(8px);
	}

	.article-item__body {
		padding: 22px 22px 22px 22px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		box-sizing: border-box;
	}

	.article-item__meta {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 11.5px;
		color: var(--mag-color-meta);
		margin-bottom: 8px;
	}

	.meta-divider {
		opacity: 0.4;
	}

	.meta-topic {
		color: var(--mag-color-meta);
		font-weight: 600;
	}

	.article-item__title {
		font-size: 16px;
		font-weight: 600;
		line-height: 1.45;
		color: var(--mag-color-heading) !important;
		margin: 0 0 10px 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: 2.9em;
		transition: color 0.3s cubic-bezier(0.16, 1, 0.3, 1), text-shadow 0.3s ease;
	}

	.article-item:hover .article-item__title {
		color: #ffffff !important;
		text-shadow: 0 0 14px rgba(255, 255, 255, 0.3);
	}

	.article-item__lead {
		font-size: 13px;
		color: var(--mag-color-lead);
		line-height: 1.6;
		margin: 0 0 18px 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		min-height: 3.2em;
		flex: none;
		transition: color 0.3s ease;
	}

	.article-item__lead.is-empty {
		min-height: 3.2em;
		margin: 0 0 18px 0;
		display: block;
	}

	.article-item:hover .article-item__lead {
		color: var(--mag-color-heading);
	}

	.article-item__footer {
