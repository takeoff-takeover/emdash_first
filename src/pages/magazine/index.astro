// 本文からリード文（2〜3行の冒頭テキスト）を自動抽出するヘルパー
function extractLead(p: any): string {
	if (p.data?.excerpt && p.data.excerpt.trim()) {
		return p.data.excerpt.trim();
	}
	const content = p.data?.content;
	if (Array.isArray(content)) {
		for (const block of content) {
			if (block._type === 'block' && block.style === 'normal' && Array.isArray(block.children)) {
				const text = block.children.map((c: any) => c.text || '').join('').trim();
				if (text.length > 20) {
					return text.length > 140 ? text.slice(0, 137) + '...' : text;
				}
			}
		}
	}
	return "";
}

// CMS記事がある場合は統合
const cmsArticles = (cmsPosts || []).map((p: any) => {
	const featImg = p.data.featured_image;
	const imgUrl = typeof featImg === "object" && featImg !== null && "src" in featImg
		? featImg.src
		: (typeof featImg === "string" ? featImg : "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg");

	return {
		id: p.id || p.data.id,
		slug: p.id,
		title: p.data.title,
		brand: p.data.related_location ? "BMW" : "ALL",
		topic: "Feature",
		date: p.data.published_at ? new Date(p.data.published_at).toISOString().slice(0, 10).replace(/-/g, '.') : "2026.10.25",
		views: "NEW",
		image: imgUrl,
		lead: extractLead(p),
		url: `/magazine/${p.id}/`,
		isFeatured: false
	};
});

// 全記事リスト（重複排除）
const allArticles = [
	...cmsArticles.filter(ca => !staticArticles.some(sa => sa.slug === ca.slug)),
	...staticArticles
];

// ESG / SDGs 記事判定ヘルパー
const isESGArticle = (p: any): boolean => {
	const slug = (p.slug || p.id || "").toLowerCase();
	const topic = (p.topic || "").toLowerCase();
	const title = (p.title || "").toLowerCase();
	const esgSlugs = [
		"tamagawa", "shinyurigaoka_cleanup", "japanesenight", "inspire_hub",
		"traffic-safety", "food-for-community", "sustainable-marche",
		"emergency-home-support", "kids-mechanic-event", "haruhinofes",
		"work-experience", "junior_high_shool_experience", "fire-department-award",
		"international-employee-meetup", "mochitsuki", "norimonofes",
		"sdgs_partner", "summerconference", "esg-sdgs-activities", "esg", "sdgs"
	];
	if (esgSlugs.some(s => slug.includes(s))) return true;
	if (topic.includes("esg") || topic.includes("sdgs")) return true;
	if (title.includes("美化活動") || title.includes("クリーンアップ") || title.includes("sdgs") || title.includes("交通安全") || title.includes("防災") || title.includes("寄付") || title.includes("職場体験") || title.includes("サステナブル") || title.includes("餅つき") || title.includes("インター会") || title.includes("交流会") || title.includes("感謝状") || title.includes("のりものフェスタ")) return true;
	return false;
};

// ユーザー指示（A案）：通常一覧からESG記事を完全に除外し、最下部の専用ブロックへ集約
const mainArticles = allArticles.filter(a => !isESGArticle(a));
const esgArticles = allArticles.filter(a => isESGArticle(a)).sort((a, b) => (b.date || "").localeCompare(a.date || ""));

// 一番目玉の記事（Cover Story）
// 最新の最重要記事（BMW iX4）を確実に先頭（Cover Story）にする
mainArticles.sort((a, b) => {
	if (a.id === "2027_new_bmw_ix4_neue_klasse" || a.slug === "2027_new_bmw_ix4_neue_klasse") return -1;
	if (b.id === "2027_new_bmw_ix4_neue_klasse" || b.slug === "2027_new_bmw_ix4_neue_klasse") return 1;
	return 0;
});

// 一番目玉の記事（Cover Story）
const coverArticle = mainArticles[0];

// 特集ハイライト記事（最新記事 2枠）
const highlightStories = mainArticles.filter(a => a.id !== coverArticle.id).slice(0, 2);

// トップ最新3記事のIDセット（Cover Story 1件 + LATEST STORIES 2件）
const top3ArticleIds = new Set([coverArticle.id, ...highlightStories.map(s => s.id)]);
// 初期表示時のアーカイブ収録記事数（最新3記事を除いた件数）
const initialArchiveCount = mainArticles.filter(a => !top3ArticleIds.has(a.id)).length;

const brandsList = ["ALL", "BMW", "MINI", "Ferrari", "Rolls-Royce", "ALPINA"];
const topicsList = ["ALL", "Feature", "Guide", "People"];
