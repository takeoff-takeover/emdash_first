			padding: 0 20px;
		}

		.filter-sticky-bar {
			top: 52px;
			padding: 12px 0 14px 0;
			margin-bottom: 24px;
		}

		.magazine-hero {
			min-height: 85vh;
			padding-top: 60px;
		}

		.magazine-hero__frame {
			top: 15px;
			left: 15px;
			right: 15px;
			bottom: 15px;
		}

		.magazine-hero__header {
			flex-direction: column;
			align-items: flex-start;
			gap: 12px;
		}

		.hero-masthead {
			margin-bottom: 28px;
			display: flex;
			flex-direction: column;
			align-items: flex-start;
