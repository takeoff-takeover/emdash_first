		}

		.hero-story-actions {
			flex-direction: column;
			align-items: stretch;
		}

		.magazine-cta-btn {
			justify-content: center;
		}

		.pc-only {
			display: none;
		}

		.magazine-hero__footer {
			display: none;
		}

		.magazine-hero__scroll-cue {
			display: none;
		}

		.toc-grid {
			grid-template-columns: 1fr;
		}

		.filter-wrap {
			flex-direction: column;
			align-items: stretch;
			gap: 12px;
			overflow-x: visible;
		}

		.filter-group {
			display: flex;
			align-items: center;
			gap: 10px;
			width: 100%;
			overflow: hidden;
		}

		.filter-group--topic {
			padding-left: 0;
			border-left: none;
		}

		.filter-group__label {
			width: 70px;
			font-size: 12.5px;
			letter-spacing: 0.04em;
			flex-shrink: 0;
			background: none;
			border: none;
			white-space: nowrap;
		}

		.filter-pills {
			display: flex;
			align-items: center;
			gap: 6px;
			flex-wrap: nowrap;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: none;
			padding-bottom: 2px;
			width: 100%;
		}

		.filter-pills::-webkit-scrollbar {
			display: none;
		}

		.filter-pill {
			flex-shrink: 0;
			padding: 5px 12px;
			font-size: 11px;
		}

		.filter-controls-right {
			flex-direction: column;
			align-items: stretch;
			width: 100%;
			gap: 12px;
		}

		.filter-search-box {
			width: 100%;
