					</div>
				</div>

				<!-- 記事グリッド（JSフィルタリング対象） -->
				<div class="articles-grid" id="articles-grid">
					{allArticles.map((art) => (
						<article 
							class="article-item" 
							data-brand={art.brand} 
							data-topic={art.topic}
							data-title={art.title.toLowerCase()}
							data-lead={art.lead ? art.lead.toLowerCase() : ''}
						>
							<a href={art.url} class="article-item__link">
								<div class="article-item__media">
									<img src={art.image} alt={art.title} loading="lazy" class="article-item__img" />
									<div class="article-item__overlay"></div>
									<span class="article-brand-pill">{art.brand}</span>
								</div>
								<div class="article-item__body">
									<div class="article-item__meta">
										<time class="meta-date">{art.date}</time>
										<span class="meta-divider">/</span>
										<span class="meta-topic">{art.topic}</span>
									</div>
									<h3 class="article-item__title">{art.title}</h3>
									{art.lead && <p class="article-item__lead">{art.lead}</p>}
									<div class="article-item__footer">
										<span class="article-item__more">記事を読む →</span>
										<span class="article-item__views">👁 {art.views}</span>
									</div>
								</div>
							</a>
						</article>
					))}
				</div>

				<!-- ページネーション（20件超の場合に動的表示） -->
				<div id="mag-pagination" class="mag-pagination" style="display: none;"></div>

				<!-- 検索該当なしプレースホルダー -->
				<div id="no-articles" class="no-articles-state" style="display: none;">
					<div class="no-articles-icon">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><line x1="8" x2="14" y1="11" y2="11"/></svg>
					</div>
					<h3 class="no-articles-title">該当する記事が見つかりませんでした</h3>
					<p class="no-articles-desc">選択中のブランドまたは検索キーワードを変更してお試しください。</p>
					<button type="button" id="btn-reset-filters" class="btn-reset-filters">すべてのフィルターを解除</button>
				</div>
			</div>
		</section>
	</main>
</NicoleLayout>

<!-- Apple風スクロールパララックス＆フィルタリング制御スクリプト -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		// ==============================================================
		// 1. Apple風 スクロールパララックス＆ズーム効果
		// ==============================================================
		const heroImg = document.getElementById('apple-hero-img');
		const heroSection = document.getElementById('hero-cover');

		if (heroImg && heroSection) {
			let ticking = false;

			window.addEventListener('scroll', () => {
				if (!ticking) {
					window.requestAnimationFrame(() => {
						const scrollY = window.scrollY;
						const heroHeight = heroSection.offsetHeight;

						if (scrollY <= heroHeight) {
							// スクロールに合わせて背景画像がわずかにゆっくり動き（パララックス）、奥へと引く
							const translateY = scrollY * 0.35;
							const scale = 1.05 - (scrollY / heroHeight) * 0.05;
							heroImg.style.transform = `translate3d(0, ${translateY}px, 0) scale(${Math.max(scale, 1)})`;
						}
						ticking = false;
					});
					ticking = true;
				}
			}, { passive: true });
		}

		// ==============================================================
		// 2. インタラクティブ・フィルタリング＆ページネーション制御（20件/ページ）
		// ==============================================================
		const PAGE_SIZE = 20;
		let currentPage = 1;
		let currentBrand = 'ALL';
		let currentTopic = 'ALL';
		let searchQuery = '';

		const brandPills = document.querySelectorAll('#brand-filters .filter-pill');
		const topicSelect = document.getElementById('topic-select');
		const searchInput = document.getElementById('article-search-input');
		const articles = document.querySelectorAll('.article-item');
		const countDisplay = document.getElementById('current-article-count');
		const noArticles = document.getElementById('no-articles');
		const resetBtn = document.getElementById('btn-reset-filters');
		const paginationEl = document.getElementById('mag-pagination');

		function renderPagination(totalPages) {
			if (!paginationEl) return;

			if (totalPages <= 1) {
				paginationEl.style.display = 'none';
				paginationEl.innerHTML = '';
				return;
			}

			paginationEl.style.display = 'flex';
			let html = '';

			// 前へボタン
			html += `<button type="button" class="page-btn page-btn--nav" ${currentPage === 1 ? 'disabled' : ''} data-page="${currentPage - 1}" aria-label="前のページへ">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="page-btn__icon"><path d="M15 18l-6-6 6-6"/></svg>
				<span>前へ</span>
			</button>`;

			// ページ番号ボタン群
			html += `<div class="page-numbers">`;
			for (let p = 1; p <= totalPages; p++) {
				html += `<button type="button" class="page-btn page-btn--num ${p === currentPage ? 'is-active' : ''}" data-page="${p}" aria-label="${p}ページ目">${p}</button>`;
			}
			html += `</div>`;

			// 次へボタン
			html += `<button type="button" class="page-btn page-btn--nav" ${currentPage === totalPages ? 'disabled' : ''} data-page="${currentPage + 1}" aria-label="次のページへ">
				<span>次へ</span>
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="page-btn__icon"><path d="M9 18l6-6-6-6"/></svg>
			</button>`;

			paginationEl.innerHTML = html;

			// クリックイベント
			paginationEl.querySelectorAll('.page-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					if (btn.disabled || btn.classList.contains('is-active')) return;
					const targetPage = parseInt(btn.getAttribute('data-page'), 10);
					if (!isNaN(targetPage) && targetPage >= 1 && targetPage <= totalPages) {
						currentPage = targetPage;
						applyFilters(false);
						const archiveSection = document.getElementById('magazine-archive');
						if (archiveSection) {
							archiveSection.scrollIntoView({ behavior: 'smooth' });
						}
					}
				});
			});
		}

		function applyFilters(resetPage = true) {
			if (resetPage) {
				currentPage = 1;
			}

			const matchedArticles = [];

			articles.forEach(article => {
				const brand = article.getAttribute('data-brand') || '';
				const topic = article.getAttribute('data-topic') || '';
				const title = article.getAttribute('data-title') || '';
				const lead = article.getAttribute('data-lead') || '';

				const matchBrand = (currentBrand === 'ALL') || (brand === currentBrand);
				const matchTopic = (currentTopic === 'ALL') || (topic === currentTopic);
				const matchSearch = (!searchQuery) || (title.includes(searchQuery) || lead.includes(searchQuery) || brand.toLowerCase().includes(searchQuery));

				if (matchBrand && matchTopic && matchSearch) {
					matchedArticles.push(article);
				} else {
					article.style.display = 'none';
				}
			});

			const totalCount = matchedArticles.length;
			const totalPages = Math.ceil(totalCount / PAGE_SIZE) || 1;

			if (currentPage > totalPages) {
				currentPage = totalPages;
			}

			// 現在のページに応じた20件の表示制御
			const startIndex = (currentPage - 1) * PAGE_SIZE;
			const endIndex = startIndex + PAGE_SIZE;

			matchedArticles.forEach((article, idx) => {
				if (idx >= startIndex && idx < endIndex) {
					article.style.display = '';
				} else {
					article.style.display = 'none';
				}
			});

			if (countDisplay) {
				countDisplay.textContent = totalCount.toString();
			}

			if (noArticles) {
				if (totalCount === 0) {
					noArticles.style.display = 'block';
				} else {
					noArticles.style.display = 'none';
				}
			}

			renderPagination(totalPages);
		}

		// 初期ロード時の実行（20件表示制限とページネーション生成）
		applyFilters(true);

		// ブランドピルクリック切り替え
		brandPills.forEach(pill => {
			pill.addEventListener('click', (e) => {
				brandPills.forEach(p => p.classList.remove('is-active'));
				pill.classList.add('is-active');
				currentBrand = pill.getAttribute('data-value') || 'ALL';
				applyFilters(true);
			});
		});

		// カテゴリーセレクト切り替え
		if (topicSelect) {
			topicSelect.addEventListener('change', (e) => {
				currentTopic = e.target.value;
				applyFilters(true);
			});
		}

		// インクリメンタルキーワード検索
		if (searchInput) {
			searchInput.addEventListener('input', (e) => {
				searchQuery = e.target.value.toLowerCase().trim();
				applyFilters(true);
			});
		}

		// リセットボタン
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				currentBrand = 'ALL';
				currentTopic = 'ALL';
				searchQuery = '';

				brandPills.forEach(p => {
					if (p.getAttribute('data-value') === 'ALL') p.classList.add('is-active');
					else p.classList.remove('is-active');
				});

				if (topicSelect) topicSelect.value = 'ALL';
				if (searchInput) searchInput.value = '';

				applyFilters(true);
			});
		}
	});
</script>

