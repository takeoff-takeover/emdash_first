										<span class="meta-divider">/</span>
										<span class="meta-topic">{art.topic}</span>
									</div>
									<h3 class="article-item__title">{art.title}</h3>
									{art.lead && <p class="article-item__lead">{art.lead}</p>}
									<div class="article-item__footer">
										<span class="article-item__more">記事を開く →</span>
										<span class="article-item__views">👁 {art.views}</span>
									</div>
