		font-weight: 700;
		color: #38bdf8;
		letter-spacing: 0.12em;
		margin-bottom: 8px;
	}

	.tag-icon {
		width: 14px;
		height: 14px;
	}

	.gallery-heading, .accordion-heading {
		font-size: 1.5rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 8px;
	}

	.gallery-sub, .accordion-sub {
		font-size: 0.875rem;
		color: #999999;
		margin: 0;
	}

	.custom-carousel {
		position: relative;
		border-radius: 14px;
		overflow: hidden;
		background: #111317;
		border: 1px solid rgba(255, 255, 255, 0.12);
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
	}

	.carousel-viewport {
		position: relative;
		overflow: hidden;
		width: 100%;
		height: 480px;
		background: #000000;
	}

	.carousel-track {
		display: flex;
		height: 100%;
		transition: transform 0.45s cubic-bezier(0.25, 1, 0.5, 1);
		will-change: transform;
	}

	.carousel-slide {
		min-width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		position: relative;
	}

	.slide-image-wrap {
		position: relative;
		width: 100%;
		height: 400px;
		background: #000000;
		overflow: hidden;
	}

	.slide-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.slide-counter-badge {
		position: absolute;
		top: 14px;
		right: 14px;
		padding: 4px 10px;
		background: rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(6px);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 20px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		font-weight: 700;
		color: #ffffff;
	}

	.slide-source-tag {
		position: absolute;
		top: 14px;
		left: 14px;
		padding: 4px 10px;
		background: rgba(0, 102, 177, 0.85);
		border-radius: 4px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.6875rem;
		font-weight: 700;
		color: #ffffff;
	}

	.slide-caption-bar {
		padding: 16px 24px;
		background: #111317;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.slide-title {
		font-size: 1.0625rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 4px;
	}

	.slide-desc {
		font-size: 0.8125rem;
		color: #a0a0a0;
		line-height: 1.5;
		margin: 0;
	}

	/* 矢印ボタン */
	.carousel-arrow {
		position: absolute;
		top: 200px;
		transform: translateY(-50%);
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: rgba(13, 15, 18, 0.85);
		backdrop-filter: blur(8px);
		border: 1px solid rgba(255, 255, 255, 0.25);
		color: #ffffff;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		z-index: 10;
		transition: all 0.2s ease;
	}

	.carousel-arrow:hover {
		background: #0066b1;
		border-color: #0066b1;
		transform: translateY(-50%) scale(1.1);
	}

	.carousel-arrow svg {
		width: 22px;
		height: 22px;
	}

	.carousel-arrow--prev {
		left: 16px;
	}

	.carousel-arrow--next {
		right: 16px;
	}

	/* サムネイル一覧バー */
	.carousel-thumbnails {
		display: flex;
		gap: 8px;
		padding: 12px 16px;
		background: #0d0f12;
		overflow-x: auto;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
	}

	.thumb-btn {
		position: relative;
		width: 72px;
		height: 48px;
		flex-shrink: 0;
		border-radius: 6px;
		overflow: hidden;
		border: 2px solid transparent;
		background: #000;
		padding: 0;
		cursor: pointer;
		opacity: 0.5;
		transition: all 0.2s ease;
	}

	.thumb-btn img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.thumb-btn:hover {
		opacity: 0.9;
	}

	.thumb-btn.active {
		opacity: 1;
		border-color: #0066b1;
		transform: scale(1.05);
	}

	/* ========================================================
	   ★アコーディオンツール スタイル
	======================================================== */
	.accordion-section {
		margin: 64px 0;
		padding: 40px 0 0;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.accordion-section-header {
		margin-bottom: 24px;
	}

	.accordion-container {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.acc-item {
		background: #111317;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 10px;
		overflow: hidden;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.acc-item[open] {
		border-color: rgba(0, 102, 177, 0.6);
		background: #14171d;
	}

	.acc-trigger {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 20px 24px;
		cursor: pointer;
		user-select: none;
		list-style: none;
	}

	.acc-trigger::-webkit-details-marker {
		display: none;
	}

	.acc-trigger-left {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.acc-icon-wrap {
		width: 34px;
		height: 34px;
		border-radius: 8px;
		background: rgba(0, 102, 177, 0.2);
		border: 1px solid rgba(0, 102, 177, 0.4);
		display: flex;
		align-items: center;
		justify-content: center;
		color: #38bdf8;
		flex-shrink: 0;
	}

	.acc-icon-wrap svg {
		width: 18px;
		height: 18px;
	}

	.acc-title {
		font-size: 1.0625rem;
		font-weight: 700;
		color: #ffffff;
	}

	.acc-toggle-indicator {
		position: relative;
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}

	.acc-toggle-indicator::before, .acc-toggle-indicator::after {
		content: '';
		position: absolute;
		background: #a1a1aa;
		transition: transform 0.25s ease;
	}

	/* 水平バー */
	.acc-toggle-indicator::before {
		top: 8px;
		left: 1px;
		width: 16px;
		height: 2px;
	}

	/* 垂直バー */
	.acc-toggle-indicator::after {
		top: 1px;
		left: 8px;
		width: 2px;
		height: 16px;
	}

	.acc-item[open] .acc-toggle-indicator::after {
		transform: rotate(90deg);
		opacity: 0;
	}

	.acc-item[open] .acc-toggle-indicator::before {
		background: #38bdf8;
	}

	.acc-content {
		padding: 0 24px 24px;
		color: #d1d5db;
		font-size: 0.9375rem;
		line-height: 1.8;
	}

	/* スペック表 */
	.spec-table-wrap {
		overflow-x: auto;
	}

	.spec-table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.875rem;
	}

	.spec-table th, .spec-table td {
		padding: 12px 16px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		text-align: left;
	}

	.spec-table th {
		width: 200px;
		color: #a1a1aa;
		font-weight: 600;
		background: rgba(255, 255, 255, 0.02);
	}

	.spec-table td {
		color: #ffffff;
	}

	.spec-table td strong {
		color: #38bdf8;
	}

	/* ラインナップカード */
	.lineup-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 16px;
		margin-top: 8px;
	}

	.lineup-card {
		padding: 18px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 8px;
	}

	.lineup-badge {
		display: inline-block;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.6875rem;
		font-weight: 700;
		color: #38bdf8;
		background: rgba(0, 102, 177, 0.2);
		padding: 2px 8px;
		border-radius: 4px;
		margin-bottom: 6px;
	}

	.lineup-badge--m { color: #facc15; background: rgba(234, 179, 8, 0.15); }
	.lineup-badge--ice { color: #4ade80; background: rgba(34, 197, 94, 0.15); }
	.lineup-badge--mhigh { color: #f87171; background: rgba(239, 68, 68, 0.2); }

	.lineup-card h5 {
		font-size: 0.9375rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 6px;
	}

	.lineup-card p {
		font-size: 0.8125rem;
		color: #999999;
		margin: 0;
		line-height: 1.5;
	}

	/* FAQ */
	.faq-list {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}

	.faq-item {
		display: flex;
		gap: 14px;
		padding: 14px 16px;
		background: rgba(255, 255, 255, 0.02);
		border-radius: 8px;
	}

	.q-mark {
		font-family: 'JetBrains Mono', monospace;
		font-size: 1.125rem;
		font-weight: 800;
		color: #0066b1;
		flex-shrink: 0;
	}

	.q-body strong {
		display: block;
		font-size: 0.9375rem;
		color: #ffffff;
		margin-bottom: 6px;
	}

	.q-body p {
		font-size: 0.875rem;
		color: #a0a0a0;
		margin: 0;
		line-height: 1.6;
	}

	.program-steps {
		padding-left: 20px;
		margin: 0;
	}

	.program-steps li {
		margin-bottom: 8px;
		font-size: 0.875rem;
	}

	/* ========================================================
	   ★関連拠点セクション（川崎ショールームカード）
	======================================================== */
	.related-location-card-box {
		margin: 72px 0 56px;
		padding: 36px;
		background: linear-gradient(180deg, #101318 0%, #0d0f13 100%);
		border: 1px solid rgba(0, 102, 177, 0.4);
		border-radius: 16px;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6), 0 0 30px rgba(0, 102, 177, 0.15);
	}

	.box-tag {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		font-weight: 700;
		color: #38bdf8;
		letter-spacing: 0.12em;
		margin-bottom: 8px;
	}

	.tag-live-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #38bdf8;
		box-shadow: 0 0 8px #38bdf8;
	}

	.box-heading {
		font-size: 1.5rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 8px;
	}

	.box-sub {
		font-size: 0.9375rem;
		color: #a0a0a0;
		margin: 0 0 28px;
	}

	.showroom-banner-card {
		display: grid;
		grid-template-columns: 340px 1fr;
		gap: 28px;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		overflow: hidden;
		transition: border-color 0.2s ease;
	}

	.showroom-banner-card:hover {
		border-color: rgba(0, 102, 177, 0.6);
	}

	.showroom-banner-media {
		position: relative;
		height: 100%;
		min-height: 240px;
		background: #000000;
	}

	.showroom-banner-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.showroom-banner-pill {
		position: absolute;
		top: 12px;
		left: 12px;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		background: rgba(0, 0, 0, 0.85);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 4px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.6875rem;
		font-weight: 700;
		color: #ffffff;
	}

	.showroom-banner-body {
		padding: 24px 24px 24px 0;
		display: flex;
		flex-direction: column;
	}

	.location-area-badge {
		font-size: 0.75rem;
		color: #38bdf8;
		font-weight: 600;
		margin-bottom: 6px;
	}

	.showroom-banner-title {
		font-size: 1.375rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 10px;
	}

	.showroom-banner-desc {
		font-size: 0.875rem;
		line-height: 1.6;
		color: #b0b4ba;
		margin: 0 0 16px;
	}

	.showroom-banner-meta {
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-size: 0.8125rem;
		margin-bottom: 16px;
		padding-bottom: 14px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.meta-label {
		color: #71717a;
	}

	.meta-val {
		color: #e4e4e7;
	}

	.tel-text {
		color: #38bdf8;
		font-family: 'JetBrains Mono', monospace;
		font-weight: 700;
		text-decoration: none;
	}

	.showroom-banner-features {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 24px;
	}

	.feat-tag {
		font-size: 0.75rem;
		color: #93c5fd;
		background: rgba(0, 102, 177, 0.15);
		border: 1px solid rgba(0, 102, 177, 0.3);
		padding: 2px 8px;
		border-radius: 4px;
	}

	.showroom-banner-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-top: auto;
	}

	.btn-goto-showroom {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 12px 22px;
		background: #0066b1;
		color: #ffffff;
		border-radius: 6px;
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
		box-shadow: 0 4px 16px rgba(0, 102, 177, 0.4);
		transition: all 0.2s ease;
	}

	.btn-goto-showroom:hover {
		background: #0077cf;
		transform: translateY(-2px);
		box-shadow: 0 6px 20px rgba(0, 102, 177, 0.55);
	}

	.btn-arrow {
		width: 16px;
		height: 16px;
		transition: transform 0.2s ease;
	}

	.btn-goto-showroom:hover .btn-arrow {
		transform: translateX(3px);
	}

	.btn-goto-gmaps {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 12px 18px;
		background: rgba(255, 255, 255, 0.08);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 6px;
		color: #ffffff;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.btn-goto-gmaps:hover {
		background: rgba(255, 255, 255, 0.16);
		border-color: #ffffff;
	}

	.btn-svg {
		width: 15px;
		height: 15px;
	}

	/* ========================================================
	   ★関連記事セクション（Related Articles）
	======================================================== */
	.section-related-posts, .section-popular-posts {
		margin: 64px 0 0;
		padding-top: 48px;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
	}

	.section-badge-label {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.6875rem;
		font-weight: 700;
		color: #0066b1;
		letter-spacing: 0.14em;
		margin-bottom: 6px;
	}

	.section-posts-title {
		font-size: 1.375rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 24px;
	}

	.related-posts-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 20px;
	}

	.related-post-card {
		background: #111317;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 10px;
		overflow: hidden;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.related-post-card:hover {
		transform: translateY(-3px);
		border-color: rgba(0, 102, 177, 0.5);
	}

	.rel-media {
		position: relative;
		height: 150px;
		background: #000;
	}

	.rel-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.rel-brand-chip {
		position: absolute;
		top: 10px;
		left: 10px;
		padding: 2px 8px;
		background: rgba(0, 102, 177, 0.9);
		border-radius: 3px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.6875rem;
		font-weight: 700;
		color: #ffffff;
	}

	.rel-body {
		padding: 16px;
