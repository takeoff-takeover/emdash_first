	.rank-badge--1 {
		color: #facc15;
	}

	.rank-badge--2 {
		color: #cbd5e1;
	}

	.rank-badge--3 {
		color: #f97316;
	}

	.pop-media {
		width: 100px;
		height: 64px;
		border-radius: 6px;
		overflow: hidden;
		background: #000;
	}

	.pop-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pop-info {
