	.pop-meta {
		display: flex;
		align-items: center;
		gap: 4px;
		font-size: 0.6875rem;
		color: #71717a;
	}

	.pop-eye {
		width: 12px;
		height: 12px;
	}

	/* フッターナビ */
	.article-footer-nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 36px;
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		gap: 16px;
		flex-wrap: wrap;
		margin-top: 48px;
	}

	.btn-back-magazine, .btn-all-locations {
		color: #a1a1aa;
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 500;
		transition: color 0.2s ease;
	}

	.btn-back-magazine:hover, .btn-all-locations:hover {
		color: #ffffff;
	}

	/* レスポンシブ */
	@media (max-width: 900px) {
		.showroom-banner-card {
			grid-template-columns: 1fr;
