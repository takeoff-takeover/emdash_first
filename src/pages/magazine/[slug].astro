		flex-direction: column;
		gap: 4px;
	}

	.pop-brand-tag {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.625rem;
		font-weight: 700;
		padding: 1px 6px;
		border-radius: 3px;
		width: fit-content;
