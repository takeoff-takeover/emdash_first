	.pop-brand-tag--bmw { background: rgba(0, 102, 177, 0.25); color: #38bdf8; border: 1px solid rgba(0, 102, 177, 0.4); }
	.pop-brand-tag--mini { background: rgba(255, 255, 255, 0.1); color: #ffffff; }
	.pop-brand-tag--ferrari { background: rgba(212, 0, 0, 0.25); color: #f87171; border: 1px solid rgba(212, 0, 0, 0.4); }

	.pop-title {
		font-size: 0.875rem;
		font-weight: 600;
		color: #e4e4e7;
		line-height: 1.4;
		margin: 0;
