---
import { getEmDashEntry, decodeSlug } from "emdash";
import { PortableText } from "emdash/ui";
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import SliderBlock from "../../components/blocks/SliderBlock.astro";
import AccordionBlock from "../../components/blocks/AccordionBlock.astro";
import "../../styles/prose.css";

const portableTextComponents = {
	type: {
		slider: SliderBlock,
		accordion: AccordionBlock,
	},
};

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

// 関連拠点データの判定（CMSの related_location フィールドに基づく動的連携）
const relatedLocationKey = (post.data as any).related_location || "nicole-bmw-kawasaki";

// 拠点マスタ定義
const showroomCatalog: Record<string, any> = {
	"nicole-bmw-kawasaki": {
		id: "nicole-bmw-kawasaki",
		name: "Nicole BMW 本社ショールーム（川崎）",
		subName: "Nicole BMW Kawasaki Headquarters & Service",
		brand: "BMW",
		address: "神奈川県川崎市幸区戸手2-5-7",
		postal: "〒212-0005",
		tel: "044-511-2000",
		telDirect: "044-543-5400",
		hours: "10:00～18:00",
		closed: "水曜日（祝日を除く）",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/01/Nicole-BMW-本社.jpg",
		detailUrl: "/location/nicole-bmw-kawasaki/",
		googleMapsUrl: "https://maps.app.goo.gl/LRAu7RxGhwoWZJLk7",
		features: ["新車ショールーム", "BMWマイスター在籍ファクトリー併設", "納車ハンドオーバースペース", "150kW急速充電"]
	},
	"nicole-bmw-ota": {
		id: "nicole-bmw-ota",
		name: "Nicole BMW 大田支店",
		subName: "Nicole BMW Ota Branch",
		brand: "BMW",
		address: "東京都大田区北馬込1-16-11 1階",
		postal: "〒143-0021",
		tel: "03-5743-2000",
		telDirect: "03-5743-2000",
		hours: "10:00～18:00",
		closed: "水曜日（祝日を除く）",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/01/大田支店.jpg",
		detailUrl: "/location/#loc-2",
		googleMapsUrl: "https://maps.google.com/?q=Nicole+BMW+大田支店",
		features: ["都内正規拠点", "新車ショールーム", "サービス工場併設"]
	}
};

const relatedShowroom = showroomCatalog[relatedLocationKey] || showroomCatalog["nicole-bmw-kawasaki"];

// アイキャッチ画像のURL取得（BMW Group PressClub公式写真）
const featuredImage = post.data.featured_image;
const heroImageUrl = typeof featuredImage === "object" && featuredImage !== null && "src" in featuredImage
	? (featuredImage as { src: string }).src
	: (typeof featuredImage === "string" ? featuredImage : "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg");

const isNeueKlasse = slug.includes("neue_klasse") || slug.includes("3series");

// ★スライドギャラリー写真データ（BMW Group PressClub 公式高解像度写真 T0460993EN）
const neueKlasseGallery = [
	{
		title: "新型BMW 3シリーズ エクステリア（フロント）",
		caption: "Neue Klasseデザイン言語を採用した先進のフロントマスク。キドニーグリルとツインヘッドライトが一体化し、新たな光のシグネチャーを創出。",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg"
	},
	{
		title: "サイドプロファイル ＆ 2.5ボックスシルエット",
		caption: "ロングホイールベースとショートオーバーハングによる伝統のスポーツプロポーション。自動格納式フラッシュドアハンドルと低重心なキャラクターライン。",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657631/P90657631-the-new-bmw-3-series-exterior-2250px.jpg"
	},
	{
		title: "BMW M350 xDrive（Mパフォーマンス・フラッグシップ）",
		caption: "3.0L 直6 TwinPower Turbo＋48Vマイルドハイブリッド（326kW/443hp）。新機能『Drift Moment』と専用アダプティブMサスペンションを標準装備。",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657689/P90657689-the-new-bmw-m350-xdrive-exterior-09-26-2250px.jpg"
	},
	{
		title: "BMW 320（高効率4気筒ガソリンモデル）",
		caption: "最新世代BMW TwinPower Turboと48Vマイルドハイブリッドを搭載し、優れた環境性能と洗練された俊敏なハンドリングを高次元で両立。",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657728/P90657728-the-new-bmw-320-exterior-09-26-2250px.jpg"
	}
];

const kidsGallery = [
	{
		title: "メカニックウエアへの着替え",
		caption: "BMWマイスターと同じつなぎに身を包み、少し緊張しながらも誇らしげな笑顔",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5139.jpg"
	},
	{
		title: "実車を使ったタイヤ空気圧・点検作業",
		caption: "プロのBMWマイスターの手ほどきを受けながら、エアゲージを使って適正空気圧をチェック",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5162.jpg"
	},
	{
		title: "「ニコル・ユーロ」給与明細の授与",
		caption: "すべての点検ミッションを終え、自らの労働の対価として給与明細とお給料を受け取る",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5188.jpg"
	},
	{
		title: "特別ファクトリー見学ツアー",
		caption: "普段は立ち入ることのできないNicole BMW 本社サービス工場を保護者様と共に見学",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5206.jpg"
	}
];

const currentGallery = isNeueKlasse ? neueKlasseGallery : kidsGallery;

// 本文内に既にスライダー／アコーディオンブロックが存在するか判定
const contentArray = Array.isArray(post.data.content) ? post.data.content : [];
const hasSliderBlock = contentArray.some((b: any) => b && b._type === "slider");
const hasAccordionBlock = contentArray.some((b: any) => b && b._type === "accordion");

// 関連記事データ
const relatedArticles = [
	{
		slug: "2027_new_bmw_3series_neue_klasse",
		title: "【公式発表】新型BMW 3シリーズ登場。完全電動『BMW i3』と直6搭載『M350 xDrive』が切り拓く新時代",
		brand: "BMW",
		category: "FUTURE & TECH",
		date: "2026.10.22",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg",
		views: "8,150"
	},
	{
		slug: "202608_bmw_kids_mechanic",
		title: "お給料も自分で稼ぐ。小学生が体験したBMWメカニックの特別な1日",
		brand: "BMW",
		category: "CAR LIFE",
		date: "2026.08.20",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5134.jpg",
		views: "6,720"
	},
	{
		slug: "202610_bmw_7series_review",
		title: "世界初の助手席画面も！新型BMW 7シリーズ先進装備の衝撃",
		brand: "BMW",
		category: "MODELS",
		date: "2026.10.19",
		image: "https://images.unsplash.com/photo-1580273916550-e323be2ae537?auto=format&fit=crop&w=800&q=80",
		views: "4,590"
	}
].filter(a => a.slug !== slug);

// 人気ランキング
const popularArticles = [
	{
		rank: 1,
		title: "【各25台限定】日本未発売仕様を纏ったエレクトリック・モンスター。「MINI JCW Track Style Edition」登場",
		brand: "MINI",
		brandClass: "mini",
		url: "https://www.nicole.co.jp/magazine/20260714_mini_jcw_track_style_edition/",
		views: "12,854",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/07/minijcwtrack-scaled.jpg"
	},
	{
		rank: 2,
		title: "フェラーリ初のフル電動モデル「LUCE（ルーチェ）」日本上陸",
		brand: "FERRARI",
		brandClass: "ferrari",
		url: "https://www.nicole.co.jp/magazine/202608_ferrari_luce/",
		views: "9,420",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC4983-3.jpg"
	},
	{
		rank: 3,
		title: "【公式発表】新型BMW 3シリーズ登場。完全電動『BMW i3』と直6搭載『M350 xDrive』が切り拓く新時代",
		brand: "BMW",
		brandClass: "bmw",
		url: "/magazine/2027_new_bmw_3series_neue_klasse/",
		views: "8,150",
		image: "https://mediapool.bmwgroup.com/cache/P9/202609/P90657627/P90657627-the-new-bmw-3-series-exterior-2249px.jpg"
	},
	{
		rank: 4,
		title: "お給料も自分で稼ぐ。小学生が体験したBMWメカニックの特別な1日",
		brand: "BMW",
		brandClass: "bmw",
		url: "/magazine/202608_bmw_kids_mechanic/",
		views: "6,720",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/08/DSC5134.jpg"
	}
];
---

<NicoleLayout 
	title={`${post.data.title} | MAGAZINE - ニコル・グループ`}
	description={post.data.excerpt || "ニコル・グループがお届けするオフィシャル・マガジン。"}
>
	<article class="magazine-article">
		<!-- パンくずバー -->
		<nav class="article-breadcrumb" aria-label="Breadcrumb">
			<div class="bc-inner">
				<a href="/" class="bc-link">ホーム</a>
				<span class="bc-sep">/</span>
				<a href="/#magazine" class="bc-link">マガジン</a>
				<span class="bc-sep">/</span>
				<span class="bc-current">{post.data.title}</span>
			</div>
		</nav>

		<!-- 記事ヘッダー -->
		<header class="article-header">
			<div class="header-inner">
				<div class="header-meta-row">
					<span class="brand-chip brand-chip--bmw">
						<svg class="bmw-tiny-svg" viewBox="0 0 100 100" width="16" height="16">
							<circle cx="50" cy="50" r="48" fill="#111111" stroke="#ffffff" stroke-width="3"/>
							<circle cx="50" cy="50" r="37" fill="#ffffff"/>
							<path d="M50 13 A37 37 0 0 1 87 50 L50 50 Z" fill="#0066b1"/>
							<path d="M50 50 L13 50 A37 37 0 0 1 50 13 Z" fill="#ffffff"/>
							<path d="M50 50 L50 87 A37 37 0 0 1 13 50 Z" fill="#0066b1"/>
							<path d="M50 50 L87 50 A37 37 0 0 1 50 87 Z" fill="#ffffff"/>
						</svg>
						BMW
					</span>
					<span class="category-chip">
						{isNeueKlasse ? "FUTURE & SCOOP" : "COLUMN / CAR LIFE"}
					</span>
					<time class="post-date">
						{isNeueKlasse ? "2026.10.22" : "2026.08.20"}
					</time>
					<span class="read-count">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="meta-icon"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
						{isNeueKlasse ? "8,150 views" : "6,720 views"}
					</span>
					{isNeueKlasse && (
						<span class="official-press-badge">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="badge-check-icon"><polyline points="20 6 9 17 4 12"/></svg>
							BMW Group PressClub 公式フォト採用
						</span>
					)}
				</div>

				<h1 class="article-title">{post.data.title}</h1>

				{post.data.excerpt && (
					<p class="article-lead">{post.data.excerpt}</p>
				)}
			</div>

			<!-- ヒーローアイキャッチ画像（BMW Group PressClub公式写真） -->
			<div class="article-hero-media">
				<img src={heroImageUrl} alt={post.data.title} class="article-hero-img" />
				<div class="press-photo-credit">Photo: © BMW AG (BMW Group PressClub Global)</div>
			</div>
		</header>

		<!-- 記事本文エリア -->
		<div class="article-content-wrapper">
			<div class="article-main-body prose prose-invert">
				<PortableText value={post.data.content} components={portableTextComponents} />
			</div>

			<!-- ========================================================
			     ★ご要望ツール①：スライドできる写真ギャラリー（Carousel）
			     ※本文内にカスタムブロックが存在しない場合のみフォールバック表示
			======================================================== -->
			{!hasSliderBlock && (
			<section class="slider-gallery-section" id="slider-gallery">
				<div class="gallery-section-header">
					<div class="gallery-tag">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tag-icon"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
						INTERACTIVE PHOTO SLIDER
					</div>
					<h3 class="gallery-heading">
						{isNeueKlasse ? "BMW Vision Neue Klasse 公式フォトスライダー" : "キッズメカニック体験 イベントフォトスライダー"}
					</h3>
					<p class="gallery-sub">左右の矢印ボタンまたはスワイプ操作でスライド切り替えが可能です。（全 {currentGallery.length} 枚）</p>
				</div>

				<div class="custom-carousel" id="customCarousel">
					<!-- スライダーメインビューポート -->
					<div class="carousel-viewport">
						<div class="carousel-track" id="carouselTrack">
							{currentGallery.map((item, index) => (
								<div class={`carousel-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
									<div class="slide-image-wrap">
										<img src={item.image} alt={item.title} class="slide-img" loading={index === 0 ? "eager" : "lazy"} />
										<span class="slide-counter-badge">{index + 1} / {currentGallery.length}</span>
										{isNeueKlasse && <span class="slide-source-tag">© BMW AG PressClub</span>}
									</div>
									<div class="slide-caption-bar">
										<h4 class="slide-title">{item.title}</h4>
										<p class="slide-desc">{item.caption}</p>
									</div>
								</div>
							))}
						</div>

						<!-- ナビゲーション矢印 -->
						<button type="button" class="carousel-arrow carousel-arrow--prev" id="carouselPrev" aria-label="前の写真">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
						</button>
						<button type="button" class="carousel-arrow carousel-arrow--next" id="carouselNext" aria-label="次の写真">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
						</button>
					</div>

					<!-- サムネイルナビゲーション -->
					<div class="carousel-thumbnails" id="carouselThumbs">
						{currentGallery.map((item, index) => (
							<button type="button" class={`thumb-btn ${index === 0 ? 'active' : ''}`} data-thumb-index={index} aria-label={`写真 ${index + 1} へジャンプ`}>
								<img src={item.image} alt="" />
							</button>
						))}
					</div>
				</div>
			</section>
			)}

			<!-- ========================================================
			     ★ご要望ツール②：アコーディオン形式ツール（開閉詳細・FAQ）
			     ※本文内にカスタムブロックが存在しない場合のみフォールバック表示
			======================================================== -->
			{!hasAccordionBlock && (
			<section class="accordion-section" id="accordion-section">
				<div class="accordion-section-header">
					<div class="accordion-tag">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="tag-icon"><line x1="12" x2="12" y1="5" y2="19"/><line x1="5" x2="19" y1="12" y2="12"/></svg>
						COLLAPSIBLE DETAILS &amp; FAQ
					</div>
					<h3 class="accordion-heading">
						{isNeueKlasse ? "次世代3シリーズ 詳細技術スペック ＆ FAQ（アコーディオン）" : "イベント詳細・よくあるご質問（アコーディオン）"}
					</h3>
					<p class="accordion-sub">項目をクリック（タップ）すると詳細情報が開閉します。</p>
				</div>

				<div class="accordion-container">
					{isNeueKlasse ? (
						<>
							<!-- アコーディオン 1: 主要スペック予測 -->
							<details class="acc-item" open>
								<summary class="acc-trigger">
									<div class="acc-trigger-left">
										<span class="acc-icon-wrap">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
										</span>
										<span class="acc-title">1. 【主要諸元・技術スペック予測】第6世代eDrive &amp; 800Vシステム</span>
									</div>
									<span class="acc-toggle-indicator"></span>
								</summary>
								<div class="acc-content">
									<div class="spec-table-wrap">
										<table class="spec-table">
											<tbody>
												<tr>
													<th>プラットフォーム &amp; 駆動</th>
													<td>BMW Neue Klasse Gen6 eDrive BEVアーキテクチャ ＆ 進化型高効率ICEアーキテクチャ</td>
												</tr>
												<tr>
													<th>統合制御ECU</th>
													<td><strong>Heart of Joy（ハート・オブ・ジョイ）</strong>：従来比10倍の処理速度を誇る次世代統合ドライビングスタック</td>
												</tr>
												<tr>
													<th>バッテリー技術 &amp; 電圧</th>
													<td>新開発 大径円筒形リチウムイオンセル ＆ <strong>800V 高電圧システム</strong>（最大400kW DC急速充電）</td>
												</tr>
												<tr>
													<th>急速充電性能</th>
													<td><strong>わずか10分間の充電で最大 423km分</strong>（WLTP）の航続距離を急速チャージ可能</td>
												</tr>
												<tr>
													<th>一充電航続距離</th>
													<td><strong>最大 912km</strong>（WLTP欧州モード値 / BMW i3 50 xDrive）</td>
												</tr>
												<tr>
													<th>コックピット &amp; OS</th>
													<td>BMW Panoramic iDrive（フロントガラス下端全幅投影「BMW Panoramic Vision」＋ 17.9インチ センターディスプレイ ＋ BMW OS X）</td>
												</tr>
												<tr>
													<th>運転支援 &amp; AI</th>
													<td>SAE Level 2、Motorway Assistant（時速130km/hまでのハンズオフ走行対応・日本等21カ国展開）、Amazon Alexa+ AI対話</td>
												</tr>
											</tbody>
										</table>
									</div>
								</div>
							</details>

							<!-- アコーディオン 2: グレード・ラインナップ展開 -->
							<details class="acc-item">
								<summary class="acc-trigger">
									<div class="acc-trigger-left">
										<span class="acc-icon-wrap">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 12 2 2 4-4"/></svg>
										</span>
										<span class="acc-title">2. 【ラインナップ構成】完全電動（i3）から直6ガソリン（M350 xDrive）まで</span>
									</div>
									<span class="acc-toggle-indicator"></span>
								</summary>
								<div class="acc-content">
									<div class="lineup-list">
										<div class="lineup-card">
											<span class="lineup-badge">完全電動 BEV フラッグシップ</span>
											<h5>BMW i3 50 xDrive（AWD・長距離モデル）</h5>
											<p>システム最高出力 345 kW（469 hp）、最大トルク 645 Nm。0-100km/h加速 4.7秒。108.7 kWhバッテリー搭載、航続距離は驚異の最大912 km（WLTP）。</p>
										</div>
										<div class="lineup-card">
