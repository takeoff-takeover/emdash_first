	.rel-title {
		font-size: 0.9375rem;
		font-weight: 700;
		color: #ffffff;
		line-height: 1.45;
		margin: 0 0 12px;
	}

	.rel-views {
		font-size: 0.6875rem;
		color: #38bdf8;
		margin-top: auto;
