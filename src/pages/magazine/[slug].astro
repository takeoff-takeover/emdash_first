	<script is:inline>
		document.addEventListener('DOMContentLoaded', function() {
			const track = document.getElementById('carouselTrack');
			const prevBtn = document.getElementById('carouselPrev');
			const nextBtn = document.getElementById('carouselNext');
			const thumbs = document.querySelectorAll('.thumb-btn');
			const slides = document.querySelectorAll('.carousel-slide');

			if (!track || slides.length === 0) return;

			let currentIndex = 0;
			const totalSlides = slides.length;

			function updateSlide(index) {
				if (index < 0) index = totalSlides - 1;
				if (index >= totalSlides) index = 0;
				currentIndex = index;

				// トラックの移動
				track.style.transform = `translateX(-${currentIndex * 100}%)`;

				// サムネイルのアクティブクラス更新
				thumbs.forEach((th, i) => {
					th.classList.toggle('active', i === currentIndex);
				});

				// スライドのアクティブクラス
				slides.forEach((sl, i) => {
					sl.classList.toggle('active', i === currentIndex);
				});
			}

			if (prevBtn) {
				prevBtn.addEventListener('click', () => updateSlide(currentIndex - 1));
			}

			if (nextBtn) {
				nextBtn.addEventListener('click', () => updateSlide(currentIndex + 1));
			}

			thumbs.forEach((th) => {
				th.addEventListener('click', () => {
					const idx = parseInt(th.dataset.thumbIndex, 10);
					updateSlide(idx);
				});
			});

			// キーボード操作（左右矢印キー）
			document.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') updateSlide(currentIndex - 1);
				if (e.key === 'ArrowRight') updateSlide(currentIndex + 1);
			});

			// タッチスワイプ
			let startX = 0;
			let endX = 0;
			track.addEventListener('touchstart', (e) => {
				startX = e.touches[0].clientX;
			}, { passive: true });

			track.addEventListener('touchend', (e) => {
				endX = e.changedTouches[0].clientX;
				const diff = startX - endX;
				if (Math.abs(diff) > 40) {
					if (diff > 0) updateSlide(currentIndex + 1);
					else updateSlide(currentIndex - 1);
				}
			}, { passive: true });
		});
	</script>
