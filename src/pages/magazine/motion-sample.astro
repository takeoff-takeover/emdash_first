---
// src/pages/magazine/motion-sample.astro
// LATEST STORIES モーション演出 比較検証サンプルページ
import NicoleLayout from "../../layouts/NicoleLayout.astro";

const demoStories = [
	{
		title: "【公式発表】新型BMW iX4登場。次世代EV専用『ノイエ・クラッセ』SACが切り拓く航続828kmの新時代",
		brand: "BMW",
		topic: "Feature",
		date: "2026.10.28",
		image: "/uploads/ix4/key-visual.jpg",
		lead: "BMW公式プレスリリースより完全電動スポーツ・アクティビティ・クーペ『BMW iX4』が世界初公開。Cd値0.23の流麗なファストバック、最大出力612馬力、航続最大828km。",
		url: "/magazine/2027_new_bmw_ix4_neue_klasse/"
	},
	{
		title: "【公式発表】新型BMW X5誕生。Neue Klasseの革新デザインと初の完全電動『iX5』を含む5つの動力源",
		brand: "BMW",
		topic: "Feature",
		date: "2026.07.01",
		image: "https://mediapool.bmwgroup.com/cache/P9/202606/P90646987/P90646987-the-new-bmw-x5-and-ix5-2250px.jpg",
		lead: "プレミアムSAVのパイオニアが第5世代（G65）へ進化。Neue Klasseデザイン言語、BMWパノラミックiDrive、最高峰SAVの新基準。",
		url: "/magazine/202607_new_bmw_x5/"
	}
];
---

<NicoleLayout 
	title="LATEST STORIES モーション検証サンプル ｜ Nicole Connect" 
	description="Nicole Connect Webマガジン LATEST STORIES の動き（モーション演出）を実際に触って比較できるサンプルページです。"
	isMagazine={true}
>
	<main class="sample-page">
		<!-- ページヘッダー -->
		<section class="sample-intro">
			<div class="sample-container">
				<span class="sample-tag">MOTION SHOWCASE & PROTOTYPE</span>
				<h1 class="sample-title">LATEST STORIES モーション演出 比較サンプル</h1>
				<p class="sample-lead">
					Nicole Connectの最新ストーリーを飾るにふさわしい、3つの異なるモーション演出プロトタイプを作成しました。<br>
					実際にマウスを動かしたり、ページをスクロールして動きの質感をご体験ください。
				</p>

				<!-- クイックジャンプナビ -->
				<div class="sample-nav">
					<a href="#pattern-1" class="sample-nav-btn">
						<span class="nav-num">01</span>
						<span class="nav-txt">【案1】3Dチルト ＆ 光彩追従（Apple / 高級車風）</span>
					</a>
					<a href="#pattern-2" class="sample-nav-btn">
						<span class="nav-num">02</span>
						<span class="nav-txt">【案2】シネマティック微動（Ken Burns 呼吸）</span>
					</a>
					<a href="#pattern-3" class="sample-nav-btn">
						<span class="nav-num">03</span>
						<span class="nav-txt">【案3】立体深度パララックス（左右速度差）</span>
					</a>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- パターン1: 3Dチルト ＆ 光彩追従（インタラクティブ・ラグジュアリー） -->
		<!-- ============================================================== -->
		<section class="sample-section" id="pattern-1">
			<div class="sample-container">
				<div class="section-badge-wrap">
					<span class="badge-number">案 1</span>
					<span class="badge-label">イチオシ・触って気持ちいい</span>
				</div>
				<h2 class="section-title">インタラクティブ 3Dチルト ＆ 光彩追従</h2>
				<p class="section-desc">
					マウスの動きに合わせて、カードが3次元空間で滑らかに傾き、写真・テキスト・バッジがそれぞれ異なる奥行きで立体的に浮き上がります。<br>
					さらにカード表面を車のボディのような繊細なスポットライト光（グレア）が追従します。
				</p>
				<p class="sample-action-hint">👉 カードの上にマウスを乗せて、グリグリ動かしてみてください。</p>

				<div class="showcase-grid pattern-1-grid">
					{demoStories.map((story) => (
						<article class="tilt-card js-tilt-card">
							<a href={story.url} class="tilt-card__link">
								<div class="tilt-card__media">
									<img src={story.image} alt={story.title} class="tilt-card__img" />
									<div class="tilt-card__overlay"></div>
									<span class="tilt-card__brand" data-depth="40">{story.brand}</span>
								</div>
								<div class="tilt-card__body">
									<div class="tilt-card__meta" data-depth="20">
										<span class="meta-topic">{story.topic}</span>
										<span class="meta-sep">/</span>
										<time class="meta-date">{story.date}</time>
									</div>
									<h3 class="tilt-card__title" data-depth="30">{story.title}</h3>
									<p class="tilt-card__lead" data-depth="15">{story.lead}</p>
									<div class="tilt-card__arrow" data-depth="25">
										<span>記事を読む</span>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
									</div>
								</div>
								<!-- 光の反射レイヤー -->
								<div class="tilt-card__glare"></div>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- パターン2: シネマティック微動（Ken Burns 呼吸 ＆ アンビエント） -->
		<!-- ============================================================== -->
		<section class="sample-section" id="pattern-2">
			<div class="sample-container">
				<div class="section-badge-wrap">
					<span class="badge-number">案 2</span>
					<span class="badge-label">自動で映画のように生き生き動く</span>
				</div>
				<h2 class="section-title">シネマティック微動（Ken Burns 呼吸エフェクト）</h2>
				<p class="section-desc">
					マウス操作をしなくても、背景の写真が映画のワンシーンのようにごくゆっくりと拡大・移動を繰り返します（呼吸エフェクト）。<br>
					カード枠線には微細な光のパルスが巡り、静止画でありながら「映像」を見ているかのような生きた空気感を醸成します。
				</p>
				<p class="sample-action-hint">👉 そのまま眺めてみてください。写真が映画のように生きて動いています。ホバーするとフォーカスが合います。</p>

				<div class="showcase-grid pattern-2-grid">
					{demoStories.map((story, idx) => (
						<article class={`kenburns-card kenburns-card--${idx % 2 === 0 ? 'a' : 'b'}`}>
							<a href={story.url} class="kenburns-card__link">
								<div class="kenburns-card__media">
									<div class="kenburns-img-wrapper">
										<img src={story.image} alt={story.title} class="kenburns-card__img" />
									</div>
									<div class="kenburns-card__overlay"></div>
									<span class="kenburns-card__brand">
										<span class="pulse-dot"></span>
										{story.brand}
									</span>
								</div>
								<div class="kenburns-card__body">
									<div class="kenburns-card__meta">
										<span class="meta-topic">{story.topic}</span>
										<span class="meta-sep">/</span>
										<time class="meta-date">{story.date}</time>
									</div>
									<h3 class="kenburns-card__title">{story.title}</h3>
									<p class="kenburns-card__lead">{story.lead}</p>
									<div class="kenburns-card__arrow">
										<span>記事を読む</span>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
									</div>
								</div>
								<!-- アンビエント発光ボーダー -->
								<div class="ambient-glow-border"></div>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- パターン3: 立体深度パララックス（左右非対称スクロール ＆ 浮遊感） -->
		<!-- ============================================================== -->
		<section class="sample-section" id="pattern-3">
			<div class="sample-container">
				<div class="section-badge-wrap">
					<span class="badge-number">案 3</span>
					<span class="badge-label">スクロールと心地よく連動</span>
				</div>
				<h2 class="section-title">立体深度パララックス（左右速度差スクロール）</h2>
				<p class="section-desc">
					画面をスクロールする速度に合わせて、左のカードと右のカードがわずかに異なる速度（左が標準、右が少し遅れて追従）で動きます。<br>
					重力や奥行きを感じさせる優雅なエディトリアルレイアウトです。
				</p>
				<p class="sample-action-hint">👉 画面をゆっくり上下にスクロールしてみてください。左右のカードに心地よいスピード差と浮遊感が生まれます。</p>

				<div class="showcase-grid pattern-3-grid" id="parallax-showcase-grid">
					<article class="parallax-card parallax-card--left js-parallax-left">
						<a href={demoStories[0].url} class="parallax-card__link">
							<div class="parallax-card__media">
								<img src={demoStories[0].image} alt={demoStories[0].title} class="parallax-card__img" />
								<div class="parallax-card__overlay"></div>
								<span class="parallax-card__brand">{demoStories[0].brand}</span>
							</div>
							<div class="parallax-card__body">
								<div class="parallax-card__meta">
									<span class="meta-topic">{demoStories[0].topic}</span>
									<span class="meta-sep">/</span>
									<time class="meta-date">{demoStories[0].date}</time>
								</div>
								<h3 class="parallax-card__title">{demoStories[0].title}</h3>
								<p class="parallax-card__lead">{demoStories[0].lead}</p>
								<div class="parallax-card__arrow">
									<span>記事を読む</span>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
								</div>
							</div>
						</a>
					</article>

					<article class="parallax-card parallax-card--right js-parallax-right">
						<a href={demoStories[1].url} class="parallax-card__link">
							<div class="parallax-card__media">
								<img src={demoStories[1].image} alt={demoStories[1].title} class="parallax-card__img" />
								<div class="parallax-card__overlay"></div>
								<span class="parallax-card__brand">{demoStories[1].brand}</span>
							</div>
							<div class="parallax-card__body">
								<div class="parallax-card__meta">
									<span class="meta-topic">{demoStories[1].topic}</span>
									<span class="meta-sep">/</span>
									<time class="meta-date">{demoStories[1].date}</time>
								</div>
								<h3 class="parallax-card__title">{demoStories[1].title}</h3>
								<p class="parallax-card__lead">{demoStories[1].lead}</p>
								<div class="parallax-card__arrow">
									<span>記事を読む</span>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
								</div>
							</div>
						</a>
					</article>
				</div>
			</div>
		</section>

		<!-- ページフッター誘導 -->
		<section class="sample-footer-cta">
			<div class="sample-container">
				<h3 class="footer-cta-title">どのモーションがお好みでしょうか？</h3>
				<p class="footer-cta-desc">
					「案1のチルト感がいい」「案2のシネマティックな呼吸感がいい」「案1と案2を合体させたい」など、<br>
					チャットでお気軽にご感想・ご指示をお聞かせください。すぐに本番マガジンへ反映いたします。
				</p>
				<a href="/magazine/" class="btn-return-mag">← マガジントップへ戻る</a>
			</div>
		</section>
	</main>
</NicoleLayout>

<!-- インタラクティブ・スクリプト -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		// ==============================================================
		// 1. パターン1: 3Dチルト ＆ マウス連動光彩シマー追従
		// ==============================================================
		const tiltCards = document.querySelectorAll('.js-tilt-card');

		tiltCards.forEach(card => {
			const glare = card.querySelector('.tilt-card__glare');
			const layers = card.querySelectorAll('[data-depth]');

			let rect = null;

			card.addEventListener('mouseenter', () => {
				rect = card.getBoundingClientRect();
				card.style.transition = 'transform 0.1s ease-out, box-shadow 0.25s ease';
				if (glare) glare.style.opacity = '1';
			});

			card.addEventListener('mousemove', (e) => {
				if (!rect) rect = card.getBoundingClientRect();

				const x = e.clientX - rect.left;
				const y = e.clientY - rect.top;

				const centerX = rect.width / 2;
				const centerY = rect.height / 2;

				// チルト角度（最大約 ±10度）
				const rotateX = ((y - centerY) / centerY) * -10;
				const rotateY = ((x - centerX) / centerX) * 10;

				card.style.transform = `perspective(1000px) rotateX(${rotateX.toFixed(2)}deg) rotateY(${rotateY.toFixed(2)}deg) translateY(-8px) scale3d(1.02, 1.02, 1.02)`;

				// 多層レイヤーのパララックス（奥行き）
				layers.forEach(layer => {
					const depth = parseFloat(layer.getAttribute('data-depth') || '20');
					const moveX = ((x - centerX) / centerX) * (depth * 0.18);
					const moveY = ((y - centerY) / centerY) * (depth * 0.18);
					layer.style.transform = `translate3d(${moveX.toFixed(1)}px, ${moveY.toFixed(1)}px, ${depth}px)`;
				});

				// 光彩（グレア）の追従
				if (glare) {
					const glareX = (x / rect.width) * 100;
					const glareY = (y / rect.height) * 100;
					glare.style.background = `radial-gradient(circle 320px at ${glareX}% ${glareY}%, rgba(255, 255, 255, 0.18), transparent 70%)`;
				}
			});

			card.addEventListener('mouseleave', () => {
				rect = null;
				card.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease';
				card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px) scale3d(1, 1, 1)';

				layers.forEach(layer => {
					layer.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
					layer.style.transform = 'translate3d(0, 0, 0)';
				});

				if (glare) {
					glare.style.opacity = '0';
				}
			});
		});

		// ==============================================================
		// 3. パターン3: スクロール連動立体深度パララックス（左右非対称スクロール）
		// ==============================================================
		const parallaxLeft = document.querySelector('.js-parallax-left');
		const parallaxRight = document.querySelector('.js-parallax-right');
		const parallaxGrid = document.getElementById('parallax-showcase-grid');

		if (parallaxLeft && parallaxRight && parallaxGrid) {
			let ticking = false;

			window.addEventListener('scroll', () => {
				if (!ticking) {
					window.requestAnimationFrame(() => {
						const rect = parallaxGrid.getBoundingClientRect();
						const windowHeight = window.innerHeight;

						// グリッドが画面内にあるときのみ計算
						if (rect.top < windowHeight && rect.bottom > 0) {
							// 画面中央からの相対オフセット (-1 〜 1)
							const progress = (windowHeight / 2 - rect.top) / (windowHeight + rect.height);
							
							// 左はわずかに上へ、右はゆっくり下へ（相対速度差）
							const offsetLeft = progress * -20;
							const offsetRight = progress * 30;

							parallaxLeft.style.transform = `translate3d(0, ${offsetLeft}px, 0)`;
							parallaxRight.style.transform = `translate3d(0, ${offsetRight}px, 0)`;
						}
						ticking = false;
					});
					ticking = true;
				}
			}, { passive: true });
		}
	});
</script>

<style>
	/* ============================================================== */
	/* モーションサンプルページ 基本スタイル */
	/* ============================================================== */
	.sample-page {
		background-color: #040507;
		color: #ffffff;
		font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", sans-serif;
		min-height: 100vh;
		padding-top: 100px;
	}

	.sample-container {
		max-width: 1280px;
		margin: 0 auto;
		padding: 0 32px;
	}

	/* イントロ */
	.sample-intro {
		padding: 40px 0 60px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.sample-tag {
		display: inline-block;
		font-family: var(--font-mono, monospace);
		font-size: 11px;
		letter-spacing: 0.16em;
		color: #8e95a5;
		margin-bottom: 12px;
	}

	.sample-title {
		font-size: clamp(32px, 4vw, 52px);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: #ffffff;
		margin: 0 0 16px;
		line-height: 1.2;
	}

	.sample-lead {
		font-size: 16px;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.65);
		max-width: 800px;
		margin: 0 0 36px;
	}

	.sample-nav {
		display: flex;
		gap: 16px;
		flex-wrap: wrap;
	}

	.sample-nav-btn {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 999px;
		padding: 10px 22px;
		text-decoration: none;
		color: #ffffff;
		font-size: 13.5px;
		font-weight: 600;
		transition: all 0.25s ease;
	}

	.sample-nav-btn:hover {
		background: rgba(255, 255, 255, 0.15);
		border-color: rgba(255, 255, 255, 0.35);
		transform: translateY(-2px);
	}

	.nav-num {
		font-family: var(--font-mono, monospace);
		font-size: 11px;
		color: #8e95a5;
	}

	/* セクション共通 */
	.sample-section {
		padding: 80px 0 100px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.section-badge-wrap {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 12px;
	}

	.badge-number {
		font-size: 11px;
		font-weight: 800;
		letter-spacing: 0.1em;
		padding: 3px 10px;
		border-radius: 4px;
		background: #ffffff;
		color: #040507;
	}

	.badge-label {
		font-size: 12px;
		color: #9aa1b2;
		font-weight: 500;
	}

	.section-title {
		font-size: clamp(26px, 3vw, 36px);
		font-weight: 700;
		letter-spacing: -0.01em;
		margin: 0 0 12px;
	}

	.section-desc {
		font-size: 15px;
		line-height: 1.65;
		color: rgba(255, 255, 255, 0.65);
		max-width: 820px;
		margin: 0 0 14px;
	}

	.sample-action-hint {
		display: inline-block;
		font-size: 13px;
		color: #e2e8f0;
		background: rgba(255, 255, 255, 0.06);
		padding: 6px 14px;
		border-radius: 6px;
		margin-bottom: 36px;
		border-left: 2px solid #ffffff;
	}

	/* グリッドレイアウト共通 */
	.showcase-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 36px;
	}

	/* ============================================================== */
	/* 案1: 3Dチルト ＆ 光彩追従 スタイル */
	/* ============================================================== */
	.tilt-card {
		background: #090c10;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 16px;
		overflow: hidden;
		position: relative;
		transform-style: preserve-3d;
		will-change: transform;
		cursor: pointer;
		box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
	}

	.tilt-card:hover {
		box-shadow: 0 28px 60px rgba(0, 0, 0, 0.8), 0 0 30px rgba(255, 255, 255, 0.05);
		border-color: rgba(255, 255, 255, 0.35);
	}

	.tilt-card__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
		position: relative;
	}

	.tilt-card__media {
		position: relative;
		height: 320px;
		overflow: hidden;
		background: #000;
	}

	.tilt-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.tilt-card:hover .tilt-card__img {
		transform: scale(1.06);
	}

	.tilt-card__overlay {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
