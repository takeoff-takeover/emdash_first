---
// src/pages/locations.astro
// ニコル・グループ 拠点一覧ページ（最上部マップ・統合拠点ポップアップ・新車/中古車/サービス整備フィルター・超薄型リスト）
import NicoleLayout from "../layouts/NicoleLayout.astro";
import locationsData from "../data/locations.json";

// 拠点ごとのロゴ判定（青山・世田谷は文字なしNマークを使用）
function getLocationLogo(loc: any): string {
	if (loc.name.includes("青山") || loc.name.includes("世田谷") || loc.brand === "Nicole" || loc.brand === "ALPINA") {
		return "/brands/nicole-n-mark.svg";
	}
	if (loc.brand === "BMW") return "/brands/bmw.svg";
	if (loc.brand === "MINI") return "/brands/mini.svg";
	if (loc.brand === "Rolls-Royce") return "/brands/rolls-royce.svg";
	if (loc.brand === "Ferrari") return "/brands/ferrari.svg";
	return "/brands/nicole-n-mark.svg";
}

// サービスバッジ判定（新車販売、中古車販売、サービス整備）
function getFacilityCategory(loc: any) {
	const text = `${(loc.services || []).join(" ")} ${loc.facilityType || ""} ${loc.name || ""}`;
	const isSales = text.includes("新車") || loc.facilityType === "ショールーム" || text.includes("車両販売");
	const isUsed = text.includes("認定中古車") || text.includes("中古車") || text.includes("BPS") || text.includes("プレオウンド") || text.includes("NEXT");
	const isService = text.includes("サービス") || text.includes("車検") || text.includes("点検") || text.includes("修理");
	const isOffice = loc.facilityType === "本社・オフィス";
	return { isSales, isUsed, isService, isOffice };
}

// ブランド一覧と拠点件数
const brandCounts = {
	ALL: locationsData.length,
	BMW: locationsData.filter(l => l.brand === "BMW").length,
	MINI: locationsData.filter(l => l.brand === "MINI").length,
	"Rolls-Royce": locationsData.filter(l => l.brand === "Rolls-Royce").length,
	Ferrari: locationsData.filter(l => l.brand === "Ferrari").length,
	ALPINA: locationsData.filter(l => l.brand === "ALPINA" || l.name.includes("青山") || l.name.includes("世田谷")).length,
};

// 取扱機能別の件数
const functionCounts = {
	sales: locationsData.filter(l => getFacilityCategory(l).isSales).length,
	used: locationsData.filter(l => getFacilityCategory(l).isUsed).length,
	service: locationsData.filter(l => getFacilityCategory(l).isService).length,
};
---

<NicoleLayout
	title="拠点一覧 | SHOWROOM & SERVICE LOCATIONS - ニコル・グループ公式"
	description="ニコル・グループの正規ディーラーショールームおよびサービスセンター拠点一覧。BMW、MINI、Rolls-Royce、Ferrari、ALPINAの住所、新車販売、中古車販売、サービス整備情報をご案内します。"
>
	<Fragment slot="head">
		<!-- Leaflet CSS & JS -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
	</Fragment>

	<main class="locs-page">
		<!-- 1. Hero Showcase -->
		<section class="locs-hero">
			<div class="locs-hero__media">
				<img 
					src="/uploads/2026/01/Nicole-BMW-本社.jpg" 
					alt="Nicole Group Network" 
					class="locs-hero__img" 
					loading="eager"
				/>
				<div class="locs-hero__overlay"></div>
			</div>
			<div class="locs-container locs-hero__inner">
				<!-- パンくずナビ -->
				<nav class="locs-breadcrumbs" aria-label="Breadcrumb">
					<ol class="locs-breadcrumbs__list">
						<li><a href="/">HOME</a></li>
						<li class="locs-breadcrumbs__sep">/</li>
						<li><a href="/corporate">CORPORATE</a></li>
						<li class="locs-breadcrumbs__sep">/</li>
						<li aria-current="page">LOCATIONS</li>
					</ol>
				</nav>

				<div class="locs-hero__content">
					<span class="locs-eyebrow">FACILITIES & NETWORK</span>
					<h1 class="locs-hero__title">
						<span class="heading-phrase">卓越したサービスをお届けする、</span><br />
						<span class="heading-phrase">20の拠点ネットワーク。</span>
					</h1>
					<p class="locs-hero__lead">
						東京都内および神奈川県の主要ロケーションに展開する正規ディーラーショールーム、認定中古車センター、最高峰のサービスファクトリー。
					</p>
				</div>
			</div>
		</section>

		<!-- 2. 【最上部】インタラクティブ・ネットワークマップ -->
		<section class="locs-map-section">
			<div class="locs-container">
				<div class="locs-map-header">
					<div class="locs-map-title-wrap">
						<span class="locs-map-dot"></span>
						<h2 class="locs-map-title">NETWORK MAP</h2>
						<span class="locs-map-sub">ピンをタップすると入居拠点一覧（新車・中古車・サービス）とGoogle Mapsルート案内が表示されます</span>
					</div>
					<button type="button" id="btn-reset-map" class="locs-map-reset-btn" title="地図全体を表示">
						全体を表示
					</button>
				</div>

				<div class="locs-map-frame">
					<div id="nicole-leaflet-map" class="nicole-leaflet-map"></div>
				</div>
			</div>
		</section>

		<!-- 3. 多層フィルターコントロールバー（ブランド ＆ 取扱機能 ＆ エリア） -->
		<section class="locs-filter-section">
			<div class="locs-container">
				<div class="locs-filter-matrix">
					<!-- ブランド絞り込み -->
					<div class="filter-row">
						<span class="filter-label">BRAND</span>
						<div class="locs-filter-group" id="brand-filters">
							<button type="button" class="locs-filter-btn is-active" data-filter="all">
								すべて <span class="locs-filter-count">({brandCounts.ALL})</span>
							</button>
							<button type="button" class="locs-filter-btn" data-filter="BMW">
								BMW <span class="locs-filter-count">({brandCounts.BMW})</span>
							</button>
							<button type="button" class="locs-filter-btn" data-filter="MINI">
								MINI <span class="locs-filter-count">({brandCounts.MINI})</span>
							</button>
							<button type="button" class="locs-filter-btn" data-filter="Rolls-Royce">
								Rolls-Royce <span class="locs-filter-count">({brandCounts["Rolls-Royce"]})</span>
							</button>
							<button type="button" class="locs-filter-btn" data-filter="Ferrari">
								Ferrari <span class="locs-filter-count">({brandCounts.Ferrari})</span>
							</button>
							<button type="button" class="locs-filter-btn" data-filter="ALPINA">
								ALPINA / Nicole <span class="locs-filter-count">({brandCounts.ALPINA})</span>
							</button>
						</div>
					</div>

					<!-- 取扱機能絞り込み（新車販売、中古車販売、サービス整備） -->
					<div class="filter-row">
						<span class="filter-label">SERVICE</span>
						<div class="locs-filter-group" id="service-filters">
							<button type="button" class="locs-pill-btn is-active" data-service="all">
								すべての機能
							</button>
							<button type="button" class="locs-pill-btn" data-service="sales">
								新車販売 <span class="locs-filter-count">({functionCounts.sales})</span>
							</button>
							<button type="button" class="locs-pill-btn" data-service="used">
								中古車販売 <span class="locs-filter-count">({functionCounts.used})</span>
							</button>
							<button type="button" class="locs-pill-btn" data-service="service">
								サービス整備 <span class="locs-filter-count">({functionCounts.service})</span>
							</button>
						</div>

						<div class="filter-area-group" id="area-filters">
							<button type="button" class="locs-area-chip is-active" data-area="all">全エリア</button>
							<button type="button" class="locs-area-chip" data-area="神奈川">神奈川</button>
							<button type="button" class="locs-area-chip" data-area="東京">東京</button>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. 拠点スリムリスト（1列1個・横長ストリップ・写真なし・電話/営業時間/定休なし） -->
		<section class="locs-list-section">
			<div class="locs-container">
				<div class="locs-list" id="locations-list">
					{locationsData.map((loc) => {
						const cat = getFacilityCategory(loc);
						const logo = getLocationLogo(loc);
						const brandFilterVal = (loc.brand === "ALPINA" || loc.name.includes("青山") || loc.name.includes("世田谷")) ? "ALPINA" : loc.brand;

						return (
							<article 
								class="loc-slim-row" 
								data-brand={brandFilterVal} 
								data-area={loc.areaGroup}
								data-has-sales={cat.isSales ? "true" : "false"}
								data-has-used={cat.isUsed ? "true" : "false"}
								data-has-service={cat.isService ? "true" : "false"}
								data-loc-id={loc.id}
								data-lat={loc.lat}
								data-lng={loc.lng}
							>
								<!-- 1. ブランドマーク -->
								<div class="loc-slim-row__brand" title={loc.brand}>
									<img src={logo} alt={loc.brand} class="loc-slim-row__logo" loading="lazy" />
								</div>

								<!-- 2. メイン情報（拠点名が一番最初、エリアプレフィックスなし） -->
								<div class="loc-slim-row__content">
									<div class="loc-slim-row__primary">
										<h2 class="loc-slim-row__name">{loc.name}</h2>
										<div class="loc-slim-row__badges">
											{cat.isSales && <span class="loc-badge loc-badge--sales">新車販売</span>}
											{cat.isUsed && <span class="loc-badge loc-badge--used">中古車販売</span>}
											{cat.isService && <span class="loc-badge loc-badge--service">サービス整備</span>}
											{cat.isOffice && <span class="loc-badge loc-badge--office">本社・オフィス</span>}
										</div>
									</div>

									<div class="loc-slim-row__secondary">
										<p class="loc-slim-row__addr" title={loc.address}>
											<span class="loc-postal">{loc.postal}</span> {loc.address}
										</p>
									</div>
								</div>

								<!-- 3. アクションボタン -->
								<div class="loc-slim-row__actions">
									<a 
										href={`https://maps.google.com/?q=${loc.mapQuery}`} 
										target="_blank" 
										rel="noopener noreferrer" 
										class="loc-btn loc-btn--map"
										title="Google Mapsで地図を確認"
									>
										MAP ↗
									</a>
									<a 
										href="/contact" 
										class="loc-btn loc-btn--contact"
									>
										お問い合わせ
									</a>
								</div>
							</article>
						);
					})}
				</div>

				<!-- 該当なしメッセージ -->
				<div class="locs-empty" id="locs-empty" style="display: none;">
					<p class="locs-empty__text">選択された条件に一致する拠点は見つかりませんでした。</p>
					<button type="button" class="locs-empty__reset" id="reset-filters">フィルターをリセット</button>
				</div>
			</div>
		</section>

		<!-- 5. フッターCTA -->
		<section class="locs-cta">
			<div class="locs-container locs-cta__container">
				<span class="locs-eyebrow">CUSTOMER SUPPORT</span>
				<h2 class="locs-cta__title">お車に関するあらゆるご相談を承ります。</h2>
				<p class="locs-cta__desc">
					新車・認定中古車のご購入相談から、点検・整備・車検のお見積もりまで。お近くのNicole Group各拠点へお気軽にお問い合わせください。
				</p>
				<div class="locs-cta__actions">
					<a href="/contact" class="locs-btn-large locs-btn-large--primary">総合お問い合わせフォーム</a>
					<a href="/corporate" class="locs-btn-large locs-btn-large--outline">会社概要を見る</a>
				</div>
			</div>
		</section>
	</main>
</NicoleLayout>

<!-- 拠点データ受け渡し用インラインJSON -->
<script is:inline id="locations-data" type="application/json" set:html={JSON.stringify(locationsData)} />

<!-- Leaflet マップ & フィルター連動スクリプト -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const rawDataEl = document.getElementById('locations-data');
		const locations = rawDataEl ? JSON.parse(rawDataEl.textContent) : [];

		let currentBrand = 'all';
		let currentService = 'all';
		let currentArea = 'all';

		const brandBtns = document.querySelectorAll('#brand-filters .locs-filter-btn');
		const serviceBtns = document.querySelectorAll('#service-filters .locs-pill-btn');
		const areaBtns = document.querySelectorAll('#area-filters .locs-area-chip');
		const rows = document.querySelectorAll('.loc-slim-row');
		const emptyMsg = document.getElementById('locs-empty');
		const resetBtn = document.getElementById('reset-filters');
		const btnResetMap = document.getElementById('btn-reset-map');

		// 1. 同一座標の拠点をグループ化（新百合ヶ丘や川崎本社などの複合拠点で重なる問題を完全解決）
		const coordGroups = {};
		locations.forEach(loc => {
			if (!loc.lat || !loc.lng) return;
			const key = `${loc.lat.toFixed(5)},${loc.lng.toFixed(5)}`;
			if (!coordGroups[key]) {
				coordGroups[key] = {
					lat: loc.lat,
					lng: loc.lng,
					areaGroup: loc.areaGroup,
					address: loc.address,
					locations: []
				};
			}
			coordGroups[key].locations.push(loc);
		});

		// 2. Leaflet マップ初期化
		let map = null;
		let markers = [];
		const defaultCenter = [35.56, 139.63];
		const defaultZoom = 11;

		function getLocCategory(loc) {
			const text = `${(loc.services || []).join(" ")} ${loc.facilityType || ""} ${loc.name || ""}`;
			return {
				isSales: text.includes("新車") || loc.facilityType === "ショールーム" || text.includes("車両販売"),
				isUsed: text.includes("認定中古車") || text.includes("中古車") || text.includes("BPS") || text.includes("プレオウンド") || text.includes("NEXT"),
				isService: text.includes("サービス") || text.includes("車検") || text.includes("点検") || text.includes("修理"),
				isOffice: loc.facilityType === "本社・オフィス"
			};
		}

		function initMap() {
			const mapEl = document.getElementById('nicole-leaflet-map');
			if (!mapEl || mapEl._leaflet_id) return;
			if (typeof L === 'undefined') {
				setTimeout(initMap, 100);
				return;
			}

			try {
				map = L.map('nicole-leaflet-map', {
					center: defaultCenter,
					zoom: defaultZoom,
					zoomControl: true,
					attributionControl: false,
					closePopupOnClick: false // 背景クリックやドラッグ操作で不意に吹き出しが閉じるのを防止
				});

				// OpenStreetMap タイル（ダーク反転CSS付き）
				L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
					maxZoom: 19
				}).addTo(map);

				// グループ化されたマーカーの生成
				Object.values(coordGroups).forEach(group => {
					const groupLocs = group.locations;
					const brands = [...new Set(groupLocs.map(l => (l.brand === "ALPINA" || l.name.includes("青山") || l.name.includes("世田谷")) ? "ALPINA" : l.brand))];
					
					// 代表ロゴの選定
					let brandLogo = '/brands/bmw.svg';
					if (brands.includes('BMW') && brands.includes('MINI')) {
						brandLogo = '/brands/bmw.svg'; // 複合店
					} else if (brands.includes('MINI')) {
						brandLogo = '/brands/mini.svg';
					} else if (brands.includes('Rolls-Royce')) {
						brandLogo = '/brands/rolls-royce.svg';
					} else if (brands.includes('Ferrari')) {
						brandLogo = '/brands/ferrari.svg';
					} else if (brands.includes('ALPINA')) {
						brandLogo = '/brands/nicole-n-mark.svg';
					}

					// 複数拠点合体バッジ表示（新百合ヶ丘など5拠点合体の場合はカウントバッジを付与）
					const badgeHtml = groupLocs.length > 1 
						? `<span class="map-pin__count">${groupLocs.length}</span>` 
						: '';

					const icon = L.divIcon({
						className: 'loc-map-marker',
						html: `
							<div class="map-pin" data-brands="${brands.join(',')}">
								<div class="map-pin__head">
									<img src="${brandLogo}" alt="" class="map-pin__logo" />
									${badgeHtml}
								</div>
								<div class="map-pin__tip"></div>
							</div>
						`,
						iconSize: [38, 44],
						iconAnchor: [19, 44],
						popupAnchor: [0, -44]
					});

					const marker = L.marker([group.lat, group.lng], { icon: icon });

					// 総合ポップアップ（合体拠点の全施設・全機能を一括リスト表示）
					const isMulti = groupLocs.length > 1;
					const mainTitle = isMulti 
						? (group.locations.find(l => l.name.includes('新百合ヶ丘')) ? 'Nicole 新百合ヶ丘 総合拠点' : (group.locations.find(l => l.name.includes('本社')) ? 'Nicole 川崎本社 総合拠点' : groupLocs[0].name))
						: groupLocs[0].name;

					let facilitiesHtml = '';
					groupLocs.forEach(l => {
						const cat = getLocCategory(l);
						let badgeText = '';
						if (cat.isSales) badgeText += '<span class="popup-tag popup-tag--sales">新車</span>';
						if (cat.isUsed) badgeText += '<span class="popup-tag popup-tag--used">中古車</span>';
						if (cat.isService) badgeText += '<span class="popup-tag popup-tag--service">サービス</span>';
						if (cat.isOffice) badgeText += '<span class="popup-tag">オフィス</span>';

						facilitiesHtml += `
							<div class="popup-facility-item">
								<div class="popup-facility-top">
									<strong class="popup-facility-name">${l.name}</strong>
									<span class="popup-facility-tags">${badgeText}</span>
								</div>
								<div class="popup-facility-tel">TEL: ${l.tel}</div>
							</div>
						`;
					});

					const popupContent = `
						<div class="map-popup">
							<div class="map-popup__header">
								<div class="map-popup__title">${mainTitle}</div>
								<div class="map-popup__addr">${group.address}</div>
							</div>
							<div class="map-popup__facilities">
								${facilitiesHtml}
							</div>
							<a href="https://maps.google.com/?q=${encodeURIComponent(group.address)}" target="_blank" rel="noopener noreferrer" class="map-popup__btn">
								Google Mapsで開く ↗
							</a>
						</div>
					`;

					marker.bindPopup(popupContent, { 
						maxWidth: 340,
						minWidth: 260,
						autoPan: true,
						autoPanPaddingTopLeft: [40, 60],
						autoPanPaddingBottomRight: [40, 40],
						keepInView: true
					});

					// ピンをクリックした際、吹き出しが画面外に消えないよう地図をスムーズに少し上方に移動
					marker.on('click', () => {
						const targetLat = group.lat + 0.004;
						map.panTo([targetLat, group.lng], { animate: true, duration: 0.35 });
					});

					marker.groupData = group;
					markers.push(marker);
					marker.addTo(map);
				});
			} catch (e) {
				console.error('Map init error:', e);
			}
		}

		initMap();

		// 3. 複合フィルタリング同期（マップ ＆ リスト）
		function applyFilters() {
			let visibleCount = 0;
			const visibleLatLngs = [];

			// リスト側のフィルタリング
			rows.forEach(row => {
				const brand = row.getAttribute('data-brand');
				const area = row.getAttribute('data-area');
				const hasSales = row.getAttribute('data-has-sales') === 'true';
				const hasUsed = row.getAttribute('data-has-used') === 'true';
				const hasService = row.getAttribute('data-has-service') === 'true';

				const matchBrand = (currentBrand === 'all') || (brand === currentBrand);
				const matchArea = (currentArea === 'all') || (area === currentArea);

				let matchService = true;
				if (currentService === 'sales') matchService = hasSales;
				else if (currentService === 'used') matchService = hasUsed;
				else if (currentService === 'service') matchService = hasService;

				if (matchBrand && matchArea && matchService) {
					row.style.display = 'flex';
					visibleCount++;
				} else {
					row.style.display = 'none';
				}
			});

			// マップマーカー側のフィルタリング（グループ内のどれか1つでも条件に一致すればピンを表示）
			markers.forEach(marker => {
				const group = marker.groupData;
				const matchingLocs = group.locations.filter(l => {
					const b = (l.brand === "ALPINA" || l.name.includes("青山") || l.name.includes("世田谷")) ? "ALPINA" : l.brand;
					const matchBrand = (currentBrand === 'all') || (b === currentBrand);
					const matchArea = (currentArea === 'all') || (l.areaGroup === currentArea);

					const cat = getLocCategory(l);
					let matchService = true;
					if (currentService === 'sales') matchService = cat.isSales;
					else if (currentService === 'used') matchService = cat.isUsed;
					else if (currentService === 'service') matchService = cat.isService;

					return matchBrand && matchArea && matchService;
				});

				if (matchingLocs.length > 0) {
					if (!map.hasLayer(marker)) map.addLayer(marker);
					visibleLatLngs.push([group.lat, group.lng]);
				} else {
					if (map.hasLayer(marker)) map.removeLayer(marker);
				}
			});

			// 該当なしメッセージ
			if (emptyMsg) {
				emptyMsg.style.display = (visibleCount === 0) ? 'block' : 'none';
			}

			// マップ表示領域の自動調整
			if (map && visibleLatLngs.length > 0) {
				const bounds = L.latLngBounds(visibleLatLngs);
				map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
			}
		}

		// ブランドボタン
		brandBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				brandBtns.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentBrand = btn.getAttribute('data-filter') || 'all';
				applyFilters();
			});
		});

		// サービス・機能ボタン（新車販売、中古車販売、サービス整備）
		serviceBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				serviceBtns.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentService = btn.getAttribute('data-service') || 'all';
				applyFilters();
			});
		});

		// エリアボタン
		areaBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				areaBtns.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentArea = btn.getAttribute('data-area') || 'all';
				applyFilters();
			});
		});

		// リセット処理
		function resetAll() {
			currentBrand = 'all';
			currentService = 'all';
			currentArea = 'all';

			brandBtns.forEach(b => b.classList.remove('is-active'));
			document.querySelector('#brand-filters [data-filter="all"]')?.classList.add('is-active');

			serviceBtns.forEach(b => b.classList.remove('is-active'));
			document.querySelector('#service-filters [data-service="all"]')?.classList.add('is-active');

			areaBtns.forEach(b => b.classList.remove('is-active'));
			document.querySelector('#area-filters [data-area="all"]')?.classList.add('is-active');

			applyFilters();
			if (map) {
				map.setView(defaultCenter, defaultZoom);
			}
		}

		if (resetBtn) resetBtn.addEventListener('click', resetAll);
		if (btnResetMap) btnResetMap.addEventListener('click', () => {
			if (map) map.setView(defaultCenter, defaultZoom);
		});
	});
</script>

