												data-badge-type={b.type}
												data-badge-brands={b.brands.join(",")}
											>
												<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="loc-service-tag__icon">
													<rect x="4" y="2" width="16" height="20" rx="2" ry="2"/>
													<path d="M9 22v-4h6v4"/>
													<path d="M8 6h.01M16 6h.01M8 10h.01M16 10h.01M8 14h.01M16 14h.01"/>
