<!-- 拠点データ受け渡し用インラインJSON -->
<script is:inline id="locations-data" type="application/json" set:html={JSON.stringify(locationsData)} />

<!-- Leaflet マップ & フィルター連動スクリプト -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', () => {
		const rawDataEl = document.getElementById('locations-data');
		const locations = rawDataEl ? JSON.parse(rawDataEl.textContent) : [];

		let currentBrand = 'all';
		let currentService = 'all';
		let currentArea = 'all';

		const brandBtns = document.querySelectorAll('#brand-filters .locs-filter-btn');
		const serviceBtns = document.querySelectorAll('#service-filters .locs-pill-btn');
		const rows = document.querySelectorAll('.loc-slim-row');
		const emptyMsg = document.getElementById('locs-empty');
		const resetBtn = document.getElementById('reset-filters');
		const btnResetMap = document.getElementById('btn-reset-map');

		// 1. 完全同一住所（番地まで同一）の拠点のみをグループ化
		const addrGroups = {};
		locations.forEach(loc => {
			if (!loc.lat || !loc.lng) return;
			// 住所の空白を除去してキーにし、同一住所（同一敷地）のみを合体させる
			const normAddr = (loc.address || "").trim().replace(/\s+/g, "");
			const key = normAddr || `${loc.lat.toFixed(5)},${loc.lng.toFixed(5)}`;
			if (!addrGroups[key]) {
				addrGroups[key] = {
					lat: loc.lat,
					lng: loc.lng,
					areaGroup: loc.areaGroup,
					address: loc.address,
					locations: []
				};
			}
			addrGroups[key].locations.push(loc);
		});

		// 2. Leaflet マップ初期化
		let map = null;
		let markers = [];
		const defaultCenter = [35.56, 139.63];
		const defaultZoom = 11;

		// データベースの取扱サービスからバッジ情報を完全自動取得
		function getClientLocBadges(loc) {
			if (loc.services && loc.services.length > 0) {
				return loc.services.map(label => {
					let type = "sales";
					let brands = [loc.brand];

					if (label.includes("Rolls-Royce") || label.includes("ロールスロイス")) brands = ["Rolls-Royce"];
					else if (label.includes("Ferrari") || label.includes("フェラーリ")) brands = ["Ferrari"];
					else if (label.includes("MINI") || label.includes("ミニ")) brands = ["MINI"];
					else if (label.includes("ALPINA") || label.includes("アルピナ")) brands = ["ALPINA"];
					else if (label.includes("BMW")) brands = ["BMW"];

					if (label.includes("新車") || label.includes("車両")) {
						type = "sales";
					} else if (label.includes("認定中古車") || label.includes("中古車")) {
						type = "used";
					} else if (label.includes("サービス") || label.includes("点検") || label.includes("車検")) {
						type = "service";
						if (label.includes("BMW（ALPINA）")) {
							brands = ["BMW", "ALPINA"];
						}
					} else if (label.includes("本社・オフィス")) {
						type = "office";
						brands = loc.id === "office-yokohama" ? ["Rolls-Royce", "Ferrari"] : ["BMW", "MINI", "ALPINA"];
					}

					return { type, label, brands };
				});
			}
			return [];
		}

		// 地図ピン用マッチ判定（オフィスではなく一般顧客向けショールーム・サービス拠点の機能が存在するかで判定）
		function locMatchesFilter(loc, targetBrand, targetService, targetArea) {
			if (targetArea !== 'all' && loc.areaGroup !== targetArea) return false;
			// 地図ピンはお客様が訪れる店舗・サービス拠点のみを対象とし、オフィス単体機能ではピンを立てない
			if (loc.facilityType === "本社・オフィス") return false;

			const badges = getClientLocBadges(loc);
			return badges.some(b => {
				if (b.type === "office") return false;
				const brandMatch = (targetBrand === 'all') || b.brands.includes(targetBrand);
				const serviceMatch = (targetService === 'all') || (b.type === targetService);
				return brandMatch && serviceMatch;
			});
		}

		function getLocCategory(loc) {
			const badges = getClientLocBadges(loc);
			return {
				isSales: badges.some(b => b.type === "sales"),
				isUsed: badges.some(b => b.type === "used"),
				isService: badges.some(b => b.type === "service"),
				isOffice: badges.some(b => b.type === "office")
			};
		}

		function initMap() {
			const mapEl = document.getElementById('nicole-leaflet-map');
			if (!mapEl || mapEl._leaflet_id) return;
			if (typeof L === 'undefined') {
				setTimeout(initMap, 100);
				return;
			}

			try {
				map = L.map('nicole-leaflet-map', {
					center: defaultCenter,
					zoom: defaultZoom,
					zoomControl: true,
					attributionControl: false,
					closePopupOnClick: false // 背景クリックやドラッグ操作で不意に吹き出しが閉じるのを防止
				});

				// OpenStreetMap タイル（ダーク反転CSS付き）
				L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
					maxZoom: 19
				}).addTo(map);

				// グループ化されたマーカーの生成
				Object.values(addrGroups).forEach(group => {
					const groupLocs = group.locations;
					const brands = [...new Set(groupLocs.flatMap(l => {
						const bList = [];
						if (l.brand === "ALPINA" || l.brand === "Nicole" || l.name.includes("青山") || l.name.includes("世田谷")) {
							bList.push("ALPINA");
						} else if (l.brand) {
							bList.push(l.brand);
						}
						const svcs = (l.services || []).join(" ") + " " + (l.name || "");
						if (l.id === "loc-22" || svcs.includes("Rolls-Royce") || svcs.includes("ロールスロイス")) {
							bList.push("Rolls-Royce");
						}
						if (["loc-1", "loc-2", "loc-4", "loc-8", "loc-16", "loc-22"].includes(l.id) || svcs.includes("MINI サービス")) {
							bList.push("MINI");
						}
						if (["loc-1", "loc-2", "loc-3", "loc-4", "loc-22"].includes(l.id) || l.brand === "BMW") {
							bList.push("ALPINA");
							bList.push("BMW");
						}
						return bList;
					}))];
					
					// 代表ロゴの選定（選択ブランドに応じてピンのロゴを動的決定）
					function getMarkerLogo(targetBrand) {
						if (targetBrand !== 'all') {
							// 1. 対象ブランド直営・専売の拠点（例: l.brand === 'MINI'）がグループ内に存在するか判定
							const hasDirectBrandLoc = groupLocs.some(l => {
								if (targetBrand === 'ALPINA') {
									return l.brand === 'ALPINA' || l.brand === 'Nicole' || l.name.includes('青山') || l.name.includes('世田谷');
								}
								return l.brand === targetBrand;
							});

							// 対象ブランドの実店舗（ショールーム・認定中古車等）がある場合はそのブランドロゴを表示
							if (hasDirectBrandLoc) {
								if (targetBrand === 'MINI') return '/brands/mini.svg';
								if (targetBrand === 'BMW') return '/brands/bmw.svg';
								if (targetBrand === 'Rolls-Royce') return '/brands/rolls-royce.svg';
								if (targetBrand === 'Ferrari') return '/brands/ferrari.svg';
								if (targetBrand === 'ALPINA') return '/brands/nicole-n-mark.svg';
							}

							// 2. MINIサービスのみを提供しているBMW拠点などの場合：
							// ユーザーの誤認を防ぐため、拠点の母体ブランド（BMW等）のロゴマークを表示
							const primaryBrand = groupLocs[0].brand;
							if (primaryBrand === 'BMW') return '/brands/bmw.svg';
							if (primaryBrand === 'Ferrari') return '/brands/ferrari.svg';
							if (primaryBrand === 'Rolls-Royce') return '/brands/rolls-royce.svg';
							if (primaryBrand === 'ALPINA' || primaryBrand === 'Nicole') return '/brands/nicole-n-mark.svg';
							if (primaryBrand === 'MINI') return '/brands/mini.svg';
						}

						// all選択時のデフォルト代表ロゴ
						if (brands.includes('Ferrari')) return '/brands/ferrari.svg';
						if (brands.includes('Rolls-Royce') && !brands.includes('BMW')) return '/brands/rolls-royce.svg';
						if (brands.includes('BMW')) return '/brands/bmw.svg';
						if (brands.includes('MINI')) return '/brands/mini.svg';
						if (brands.includes('ALPINA') || brands.includes('Nicole')) return '/brands/nicole-n-mark.svg';
						return '/brands/bmw.svg';
					}

					let brandLogo = getMarkerLogo(currentBrand);

					// 複数拠点合体バッジ表示（新百合ヶ丘など同一敷地合体の場合はカウントバッジを付与）
					const badgeHtml = groupLocs.length > 1 
						? `<span class="map-pin__count">${groupLocs.length}</span>` 
						: '';

					const isMobile = window.innerWidth <= 640;
					const pinW = isMobile ? 22 : 38;
					const pinH = isMobile ? 26 : 44;
					const anchorX = Math.round(pinW / 2);
					const anchorY = pinH;

					const icon = L.divIcon({
						className: 'loc-map-marker',
						html: `
							<div class="map-pin" data-brands="${brands.join(',')}">
								<div class="map-pin__head">
									<img src="${brandLogo}" alt="" class="map-pin__logo" />
									${badgeHtml}
								</div>
								<div class="map-pin__tip"></div>
							</div>
						`,
						iconSize: [pinW, pinH],
						iconAnchor: [anchorX, anchorY],
						popupAnchor: [0, -anchorY]
					});

					const marker = L.marker([group.lat, group.lng], { icon: icon });
					marker.getMarkerLogo = getMarkerLogo;

					// ポップアップHTML生成関数（選択ブランドに応じて施設順を動的ソート）
					function buildPopupContent(activeBrand) {
						const sortedLocs = [...groupLocs];
						if (activeBrand !== 'all') {
							sortedLocs.sort((a, b) => {
								const getFacilityScore = (l) => {
									const cat = getLocCategory(l);
									const isTarget = (l.brand === activeBrand) ||
										(activeBrand === 'ALPINA' && (l.brand === 'ALPINA' || l.brand === 'Nicole' || l.name.includes('青山') || l.name.includes('世田谷')));
									if (isTarget) {
										if (cat.isSales) return 1;  // 新車
										if (cat.isUsed) return 2;   // 中古車
										if (cat.isService) return 3;// サービス
										return 4;
									}
									if (cat.isSales) return 10;
									if (cat.isUsed) return 20;
									if (cat.isService) return 30;
									return 40;
								};
								return getFacilityScore(a) - getFacilityScore(b);
							});
						}

						// ポップアップタイトルの決定（同一敷地の合体拠点のみ総合タイトル、単独は拠点名）
						const isMulti = sortedLocs.length > 1;
						let mainTitle = sortedLocs[0].name;
						if (isMulti) {
							if (group.address.includes('戸手')) {
								mainTitle = 'Nicole 川崎本社 総合拠点';
							} else if (group.address.includes('片平')) {
								mainTitle = 'Nicole 新百合ヶ丘 総合拠点';
							} else if (group.address.includes('東方町')) {
								mainTitle = 'Nicole 横浜港北 認定中古車センター';
							} else if (group.address.includes('川向町')) {
								mainTitle = 'Nicole Competizione 横浜川向拠点';
							}
						}

						// 施設ごとのバッジHTMLをブランドに応じて生成（MINI選択時はBMW新車販売等は非表示）
						function getPopupBadgeHtml(targetLoc) {
							const badges = getClientLocBadges(targetLoc);
							const filtered = (activeBrand === 'all')
								? badges.filter(b => b.type !== 'office')
								: badges.filter(b => b.type !== 'office' && b.brands.includes(activeBrand));
							
							const listToUse = filtered.length > 0 ? filtered : badges.filter(b => b.type !== 'office');
							return listToUse.map(b => `<span class="popup-tag popup-tag--${b.type}">${b.label}</span>`).join(' ');
						}

						let facilitiesHtml = '';
						if (isMulti) {
							let itemsToRender = sortedLocs;
							if (activeBrand !== 'all') {
								const brandMatches = sortedLocs.filter(l => {
									const bList = getClientLocBadges(l);
									return bList.some(b => b.type !== 'office' && b.brands.includes(activeBrand));
								});
								if (brandMatches.length > 0) {
									itemsToRender = brandMatches;
								}
							}

							itemsToRender.forEach(l => {
								const badgeText = getPopupBadgeHtml(l);
								const isKawasakiBmw = (l.id === 'loc-1' || (l.name.includes('Nicole BMW 本社') && !l.name.includes('オフィス')));

								facilitiesHtml += `
									<div class="popup-facility-item">
										<div class="popup-facility-main">
											<strong class="popup-facility-name">${l.name}</strong>
											<div class="popup-facility-tags">${badgeText}</div>
										</div>
										${isKawasakiBmw ? `<a href="/location/nicole-bmw-kawasaki/" class="popup-detail-btn" title="川崎本社の店舗詳細を見る">詳細</a>` : ''}
									</div>
								`;
							});
						} else {
							const singleLoc = sortedLocs[0];
							const badgeText = getPopupBadgeHtml(singleLoc);
							const isKawasakiBmw = (singleLoc.id === 'loc-1' || (singleLoc.name.includes('Nicole BMW 本社') && !singleLoc.name.includes('オフィス')));

							facilitiesHtml += `
								<div class="popup-facility-item popup-facility-item--single">
									<div class="popup-facility-main">
										<div class="popup-facility-tags">${badgeText}</div>
									</div>
									${isKawasakiBmw ? `<a href="/location/nicole-bmw-kawasaki/" class="popup-detail-btn" title="川崎本社の店舗詳細を見る">詳細</a>` : ''}
								</div>
							`;
						}

						return `
							<div class="map-popup">
								<div class="map-popup__header">
									<div class="map-popup__title">${mainTitle}</div>
									<div class="map-popup__addr">
										<a href="https://maps.google.com/?q=${encodeURIComponent(group.address)}" target="_blank" rel="noopener noreferrer" class="map-popup__addr-link" title="Google Mapsで地図を確認">
											<span class="map-popup__addr-text">${group.address}</span>
											<span class="map-popup__addr-badge">MAP ↗</span>
										</a>
									</div>
								</div>
								<div class="map-popup__facilities">
									${facilitiesHtml}
								</div>
							</div>
						`;
					}

					marker.bindPopup(buildPopupContent(currentBrand), { 
						maxWidth: 340,
						minWidth: 260,
						autoPan: true,
						autoPanPaddingTopLeft: [40, 60],
						autoPanPaddingBottomRight: [40, 40],
						keepInView: true
					});

					// ピンをクリックした際、最新の選択ブランド順でポップアップを更新し、吹き出しが画面外に消えないよう地図をスムーズに少し上方に移動
					marker.on('click', () => {
						marker.setPopupContent(buildPopupContent(currentBrand));
						const targetLat = group.lat + 0.004;
						map.panTo([targetLat, group.lng], { animate: true, duration: 0.35 });
					});

					marker.groupData = group;
					marker.buildPopupContent = buildPopupContent;
					markers.push(marker);
					marker.addTo(map);
				});
			} catch (e) {
				console.error('Map init error:', e);
			}
		}

		initMap();

		// リスト項目の並び替え優先度スコア計算（MINI選択時はMINI新車→MINI中古車→それ以降）
		function getRowPriority(row, brand) {
			const initialOrder = parseInt(row.getAttribute('data-initial-order') || '0', 10);
			if (brand === 'all') {
				return initialOrder;
			}

			const primaryBrand = row.getAttribute('data-primary-brand') || '';
			const hasSales = row.getAttribute('data-has-sales') === 'true';
			const hasUsed = row.getAttribute('data-has-used') === 'true';
			const hasService = row.getAttribute('data-has-service') === 'true';

			const isTargetPrimary = (primaryBrand === brand) || 
				(brand === 'ALPINA' && (primaryBrand === 'ALPINA' || primaryBrand === 'Nicole'));

			// 該当ブランド（例: MINI）自体の拠点
			if (isTargetPrimary) {
				if (hasSales) return 100 + initialOrder;   // 1. 新車販売
				if (hasUsed) return 200 + initialOrder;    // 2. 認定中古車
				if (hasService) return 300 + initialOrder; // 3. サービス専業
				return 400 + initialOrder;
			}

			// 他ブランドだが対象ブランドのサービス等を扱う拠点（例: BMW本社・新百合ヶ丘など）
			// 「それ以降」として後方に配置
			if (hasSales) return 1000 + initialOrder;
			if (hasUsed) return 2000 + initialOrder;
			return 3000 + initialOrder;
		}

		// 行が (brand, service, area) の掛け合わせ条件に一致するか判定
		function doesRowMatchFilter(row, targetBrand, targetService, targetArea) {
			const area = row.getAttribute('data-area');
			if (targetArea !== 'all' && area !== targetArea) {
				return false;
			}

			const isOffice = row.getAttribute('data-is-office') === 'true';
			if (isOffice) {
				// オフィスは一般向け販売・整備を行っていないため、機能（新車・中古車・サービス）選択時は非表示
				if (targetService !== 'all') return false;
				const brandsAttr = row.getAttribute('data-brand') || '';
				const brands = brandsAttr.split(',').filter(Boolean);
				return (targetBrand === 'all') || brands.includes(targetBrand);
			}

			const tags = Array.from(row.querySelectorAll('.loc-service-tag'));
			if (tags.length === 0) return false;

			// targetBrand と targetService を同時に満たすバッジが存在するか判定
			return tags.some(tag => {
				const type = tag.getAttribute('data-badge-type');
				const tagBrands = (tag.getAttribute('data-badge-brands') || '').split(',').filter(Boolean);

				const matchBrand = (targetBrand === 'all') || tagBrands.includes(targetBrand);
				const matchService = (targetService === 'all') || (type === targetService);

				return matchBrand && matchService;
			});
		}

		// SERVICEボタン（新車販売、中古車販売、サービス整備）の件数を現在ブランドに応じて動的更新
		function updateServiceButtonCounts(activeBrand, activeArea) {
			let salesCount = 0;
			let usedCount = 0;
			let serviceCount = 0;

			rows.forEach(row => {
				if (row.getAttribute('data-is-office') === 'true') return;
				const area = row.getAttribute('data-area');
				if (activeArea !== 'all' && area !== activeArea) return;

				const tags = Array.from(row.querySelectorAll('.loc-service-tag'));
				const hasSales = tags.some(t => {
					const brands = (t.getAttribute('data-badge-brands') || '').split(',');
					return t.getAttribute('data-badge-type') === 'sales' && (activeBrand === 'all' || brands.includes(activeBrand));
				});
				const hasUsed = tags.some(t => {
					const brands = (t.getAttribute('data-badge-brands') || '').split(',');
					return t.getAttribute('data-badge-type') === 'used' && (activeBrand === 'all' || brands.includes(activeBrand));
				});
				const hasService = tags.some(t => {
					const brands = (t.getAttribute('data-badge-brands') || '').split(',');
					return t.getAttribute('data-badge-type') === 'service' && (activeBrand === 'all' || brands.includes(activeBrand));
				});

				if (hasSales) salesCount++;
				if (hasUsed) usedCount++;
				if (hasService) serviceCount++;
			});

			const salesEl = document.querySelector('#service-filters [data-service="sales"] .loc-filter-count');
			const usedEl = document.querySelector('#service-filters [data-service="used"] .loc-filter-count');
			const serviceEl = document.querySelector('#service-filters [data-service="service"] .loc-filter-count');

			if (salesEl) salesEl.textContent = `(${salesCount})`;
			if (usedEl) usedEl.textContent = `(${usedCount})`;
			if (serviceEl) serviceEl.textContent = `(${serviceCount})`;
		}

		// 3. 複合フィルタリング同期（マップ ＆ リスト）
		function applyFilters() {
			let visibleRetailCount = 0;
			let visibleOfficeCount = 0;
			const visibleLatLngs = [];

			const retailRows = [];
			const officeRows = [];

			// サービスボタンの件数を現在のブランド選択に応じて動的更新
			updateServiceButtonCounts(currentBrand, currentArea);

			// リスト側のフィルタリング ＆ バッジ個別表示制御 ＆ 並び順スコア計算
			rows.forEach(row => {
				const isOffice = row.getAttribute('data-is-office') === 'true';
				const isMatch = doesRowMatchFilter(row, currentBrand, currentService, currentArea);

				if (isMatch) {
					row.style.display = 'flex';
					const priority = getRowPriority(row, currentBrand);
					row.style.order = priority;

					// バッジの表示・非表示：選択ブランドに関係のない他ブランドバッジを非表示にする
					const tags = row.querySelectorAll('.loc-service-tag');
					tags.forEach(tag => {
						const tagBrands = (tag.getAttribute('data-badge-brands') || '').split(',').filter(Boolean);
						const type = tag.getAttribute('data-badge-type');

						const matchBrand = (currentBrand === 'all') || tagBrands.includes(currentBrand);
						const matchService = (currentService === 'all') || (type === currentService);

						if (matchBrand && matchService) {
							tag.style.display = 'inline-flex';
						} else {
							tag.style.display = 'none';
						}
					});

					if (isOffice) {
						visibleOfficeCount++;
						officeRows.push({ row, priority });
					} else {
						visibleRetailCount++;
						retailRows.push({ row, priority });
					}
				} else {
					row.style.display = 'none';
				}
			});

			// 一覧DOM自体の順序も整えて完全同期（MINI選択時はMINI新車→MINI中古車→それ以降の順）
			const retailListEl = document.getElementById('locations-list');
			if (retailListEl && retailRows.length > 0) {
				retailRows.sort((a, b) => a.priority - b.priority);
				retailRows.forEach(item => retailListEl.appendChild(item.row));
			}

			// オフィス別枠ブロックの表示・非表示連動
			const officesBlock = document.getElementById('locs-offices-block');
			if (officesBlock) {
				officesBlock.style.display = (visibleOfficeCount > 0) ? 'block' : 'none';
			}

			const visibleCount = visibleRetailCount + visibleOfficeCount;

			// マップマーカー側のフィルタリング（グループ内のどれか1つでも条件に一致すればピンを表示）
			markers.forEach(marker => {
				const group = marker.groupData;
				const matchingLocs = group.locations.filter(l => locMatchesFilter(l, currentBrand, currentService, currentArea));

				if (matchingLocs.length > 0) {
					if (!map.hasLayer(marker)) map.addLayer(marker);
					visibleLatLngs.push([group.lat, group.lng]);

					// ピンのロゴマークを選択ブランドに合わせて動的更新（MINI選択時はBMW複合拠点もMINIロゴに切り替え）
					if (marker.getMarkerLogo) {
						const targetLogo = marker.getMarkerLogo(currentBrand);
						const updateLogo = () => {
							const markerEl = marker.getElement();
							if (markerEl) {
								const img = markerEl.querySelector('.map-pin__logo');
								if (img && img.getAttribute('src') !== targetLogo) {
									img.src = targetLogo;
								}
							}
						};
						updateLogo();
						// レイヤー追加直後でDOMが非同期生成されるケースにも対応
						setTimeout(updateLogo, 20);
					}

					// 吹き出しが開いている場合は選択ブランドに合わせて最新のタグ内容に動的更新
					if (marker.isPopupOpen && marker.isPopupOpen() && marker.buildPopupContent) {
						marker.setPopupContent(marker.buildPopupContent(currentBrand));
					}
				} else {
					if (map.hasLayer(marker)) map.removeLayer(marker);
				}
			});

			// 該当なしメッセージ
			if (emptyMsg) {
				emptyMsg.style.display = (visibleCount === 0) ? 'block' : 'none';
			}

			// マップ表示領域の自動調整
			if (map && visibleLatLngs.length > 0) {
				const bounds = L.latLngBounds(visibleLatLngs);
				map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
			}
		}

		// ブランドボタン
		brandBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				brandBtns.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentBrand = btn.getAttribute('data-filter') || 'all';
				applyFilters();
			});
		});

		// サービス・機能ボタン（新車販売、中古車販売、サービス整備）
		serviceBtns.forEach(btn => {
			btn.addEventListener('click', () => {
				serviceBtns.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');
				currentService = btn.getAttribute('data-service') || 'all';
				applyFilters();
			});
		});

		// リセット処理
		function resetAll() {
			currentBrand = 'all';
			currentService = 'all';
			currentArea = 'all';

			brandBtns.forEach(b => b.classList.remove('is-active'));
			document.querySelector('#brand-filters [data-filter="all"]')?.classList.add('is-active');

			serviceBtns.forEach(b => b.classList.remove('is-active'));
			document.querySelector('#service-filters [data-service="all"]')?.classList.add('is-active');

			areaBtns.forEach(b => b.classList.remove('is-active'));
			document.querySelector('#area-filters [data-area="all"]')?.classList.add('is-active');

			applyFilters();
			if (map) {
				map.setView(defaultCenter, defaultZoom);
			}
		}

		if (resetBtn) resetBtn.addEventListener('click', resetAll);
		if (btnResetMap) btnResetMap.addEventListener('click', () => {
			if (map) map.setView(defaultCenter, defaultZoom);
		});
	});
</script>

