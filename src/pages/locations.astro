---
// src/pages/locations.astro
// ニコル・グループ 拠点一覧ページ（最上部マップ・統合拠点ポップアップ・完全DB連携一本化）
import NicoleLayout from "../layouts/NicoleLayout.astro";
import { getEmDashCollection } from "emdash";
import { geocodeAddress } from "../utils/geocode";

// 1. EmDash 公式APIから全拠点データを直接取得（一本化）
let emdashEntries: any[] = [];
try {
	const res = await getEmDashCollection("locations" as any, {
		limit: 100,
	});
	if (res?.entries) {
		emdashEntries = res.entries;
	}
} catch (e) {
	console.error("[locations] Failed to query getEmDashCollection:", e);
}

// 2. データベースから取得したデータをlocations形式に正規化（複合拠点は一覧で新車/中古車を別行表示し、詳細は同一総合ハブへ連携）
const rawLocationsDataNested = await Promise.all(emdashEntries.map(async (entry) => {
	const row = entry.data || entry;
	let lat = typeof row.lat === 'number' ? row.lat : (row.lat ? parseFloat(row.lat) : null);
	let lng = typeof row.lng === 'number' ? row.lng : (row.lng ? parseFloat(row.lng) : null);

	// 緯度経度が未設定の場合は住所から国土地理院APIで自動取得
	if ((!lat || !lng) && row.address) {
		const coords = await geocodeAddress(row.address);
		if (coords) {
			lat = coords.lat;
			lng = coords.lng;
		}
	}

	const addr = row.address || "";
	const areaGroup = addr.includes("東京都") || addr.includes("東京") ? "東京" : "神奈川";
	const rawBadges = row.badges;
	const badgesStr = Array.isArray(rawBadges) ? rawBadges.join(",") : (typeof rawBadges === "string" ? rawBadges : "");
	const isOffice = badgesStr.includes("本社・オフィス") || row.brand === "Nicole";
	const servicesList = Array.isArray(rawBadges)
		? rawBadges.map((s: any) => String(s).trim()).filter(Boolean)
		: badgesStr.split(",").map((s: string) => s.trim()).filter(Boolean);

	// 見本用のサンプルGoogle評価（将来はAPIまたは管理画面から取得）
	const sampleRatingMap: Record<string, { rating: number; count: number }> = {
		'nicole-bmw-kawasaki': { rating: 4.1, count: 186 },
		'nicole-bmw-kohoku': { rating: 4.3, count: 215 },
		'nicole-bmw-aoba-miyamae': { rating: 4.2, count: 98 },
		'nicole-bmw-shinyurigaoka': { rating: 4.2, count: 142 },
		'nicole-bmw-ota': { rating: 4.0, count: 76 },
		'bps-kohoku': { rating: 4.4, count: 64 },
		'bps-shinyurigaoka': { rating: 4.2, count: 142 },
		'nicole-bmw-service-centre': { rating: 4.1, count: 52 },
		'mini-kohoku': { rating: 4.3, count: 122 },
		'mini-tsuzuki': { rating: 4.2, count: 88 },
		'mini-shinyurigaoka': { rating: 4.3, count: 105 },
		'mini-next-shinyurigaoka': { rating: 4.3, count: 105 },
		'mini-next-kohoku': { rating: 4.2, count: 48 },
		'rolls-royce-motor-cars-yokohama': { rating: 4.6, count: 34 },
		'nicole-competizione-showroom': { rating: 4.5, count: 68 },
		'nicole-setagaya': { rating: 4.4, count: 42 },
		'nicole-aoyama': { rating: 4.3, count: 38 }
	};

	const currentSample = sampleRatingMap[row.slug] || null;
	const finalRating = row.google_rating_override ? parseFloat(row.google_rating_override) : (currentSample?.rating || null);
	const finalCount = row.google_reviews_count_override ? parseInt(row.google_reviews_count_override, 10) : (currentSample?.count || null);

	// 新百合ヶ丘（BMW）複合拠点：一覧では「新車窓口」と「認定中古車窓口」を別々の独立行として一覧表示し、詳細URLは共通の総合ハブ（/location/nicole-bmw-shinyurigaoka）へ接続
	if (row.slug === 'nicole-bmw-shinyurigaoka') {
		return [
			{
				id: 'nicole-bmw-shinyurigaoka',
				name: 'Nicole BMW 新百合ヶ丘支店',
				brand: 'BMW',
				facilityType: 'ショールーム',
				areaGroup,
				services: ['BMW 新車', 'BMW（ALPINA）サービス', 'MINI サービス'],
				postal: row.postal || "〒215-0023",
				address: addr,
				tel: row.sales_tel || row.tel || "044-959-1400",
				image: row.featured_image || "/uploads/2026/02/BMW_MINI_BPS_MININEXT新百合ヶ丘2025-1-1024x682.jpg",
				lat: lat || 35.6025,
				lng: lng || 139.4975,
				detailUrl: '/location/nicole-bmw-shinyurigaoka',
				mapQuery: encodeURIComponent(`Nicole BMW 新百合ヶ丘支店 ${addr}`),
				rating: 4.2,
				reviewCount: 142
			},
			{
				id: 'bps-shinyurigaoka',
				name: 'BMW Premium Selection 新百合ヶ丘',
				brand: 'BMW',
				facilityType: 'ショールーム',
				areaGroup,
				services: ['BMW 認定中古車'],
				postal: row.postal || "〒215-0023",
				address: addr,
				tel: row.used_tel || "044-396-0180",
				image: row.featured_image || "/uploads/2026/02/BMW_MINI_BPS_MININEXT新百合ヶ丘2025-1-1024x682.jpg",
				lat: lat || 35.6025,
				lng: lng || 139.4975,
				detailUrl: '/location/nicole-bmw-shinyurigaoka', // 詳細は共通の総合ページへ！
				mapQuery: encodeURIComponent(`BMW Premium Selection 新百合ヶ丘 ${addr}`),
				rating: 4.2,
				reviewCount: 142
			}
		];
	}

	// 新百合ヶ丘（MINI）複合拠点：一覧では「新車窓口」と「認定中古車窓口」を別々の独立行として一覧表示し、詳細URLは共通の総合ハブ（/location/mini-shinyurigaoka）へ接続
	if (row.slug === 'mini-shinyurigaoka') {
		return [
			{
				id: 'mini-shinyurigaoka',
				name: 'MINI 新百合ヶ丘',
				brand: 'MINI',
				facilityType: 'ショールーム',
				areaGroup,
				services: ['MINI 新車', 'MINI サービス'],
				postal: row.postal || "〒215-0023",
				address: addr,
				tel: row.sales_tel || row.tel || "044-959-3032",
				image: row.featured_image || "/uploads/2026/02/BMW_MINI_BPS_MININEXT新百合ヶ丘2025-1-1024x682.jpg",
				lat: lat || 35.6025,
				lng: lng || 139.4975,
				detailUrl: '/location/mini-shinyurigaoka',
				mapQuery: encodeURIComponent(`MINI 新百合ヶ丘 ${addr}`),
				rating: 4.3,
				reviewCount: 105
			},
			{
				id: 'mini-next-shinyurigaoka',
				name: 'MINI NEXT 新百合ヶ丘',
				brand: 'MINI',
				facilityType: 'ショールーム',
				areaGroup,
				services: ['MINI 認定中古車'],
				postal: row.postal || "〒215-0023",
				address: addr,
				tel: row.used_tel || "044-396-0180",
				image: row.featured_image || "/uploads/2026/02/BMW_MINI_BPS_MININEXT新百合ヶ丘2025-1-1024x682.jpg",
				lat: lat || 35.6025,
				lng: lng || 139.4975,
				detailUrl: '/location/mini-shinyurigaoka', // 詳細は共通の総合ページへ！
				mapQuery: encodeURIComponent(`MINI NEXT 新百合ヶ丘 ${addr}`),
				rating: 4.3,
				reviewCount: 105
			}
		];
	}

	return [{
		id: entry.id || row.slug || row.id,
		name: protectPhrases(row.title),
		brand: row.brand || "Nicole",
		facilityType: isOffice ? "本社・オフィス" : "ショールーム",
		areaGroup,
		services: servicesList,
		postal: row.postal || "",
		address: addr,
		tel: row.tel || row.sales_tel || "",
		image: row.featured_image || "/uploads/2026/01/Nicole-BMW-本社.jpg",
		lat: lat || 35.54589,
		lng: lng || 139.69708,
		detailUrl: isOffice ? "" : `/location/${entry.id || row.slug}`,
		mapQuery: encodeURIComponent(`${row.title} ${addr}`),
		rating: finalRating,
		reviewCount: finalCount
	}];
}));

const locationsData = rawLocationsDataNested.flat();

// 3. ユーザー指定のブランド優先順位（BMW ➔ MINI ➔ ロールス・ロイス ➔ フェラーリ ➔ ニコル/アルピナ/オフィス）による完全固定ソート
const BRAND_PRIORITY_ORDER: Record<string, number> = {
	'BMW': 1,
	'MINI': 2,
	'Rolls-Royce': 3,
	'Ferrari': 4,
	'ALPINA': 5,
	'Nicole': 6
};

// スラグごとの個別表示優先順位（ユーザーご指定順）
const SPECIFIC_SLUG_ORDER: Record<string, number> = {
	// ─── 1. BMW（新車系） ───
	'nicole-bmw-kawasaki': 101,      // Nicole BMW 本社（川崎）
	'nicole-bmw-kohoku': 102,        // Nicole BMW 横浜港北支店
	'nicole-bmw-aoba-miyamae': 103,  // Nicole BMW 青葉宮前支店
	'nicole-bmw-shinyurigaoka': 104, // Nicole BMW 新百合ヶ丘支店
	'nicole-bmw-ota': 105,           // Nicole BMW 大田支店

	// ─── 2. BMW（BPS・サービス系） ───
	'bps-kohoku': 106,               // BMW Premium Selection 横浜港北（BMW認定中古車）
	'bps-shinyurigaoka': 107,        // BMW Premium Selection 新百合ヶ丘
	'nicole-bmw-service-centre': 108,// Nicole BMW Service Centre

	// ─── 3. MINI ───
	'mini-kohoku': 201,              // MINI 港北
	'mini-tsuzuki': 202,             // MINI 都筑
	'mini-shinyurigaoka': 203,       // MINI 新百合ヶ丘
	'mini-next-kohoku': 204,         // MINI NEXT 横浜港北（MINI 認定中古車）
	'mini-next-shinyurigaoka': 205,  // MINI NEXT 新百合ヶ丘

	// ─── 4. ロールス・ロイス ───
	'rolls-royce-motor-cars-yokohama': 301, // ロールス・ロイス・モーター・カーズ横浜

	// ─── 5. フェラーリ ───
	'nicole-competizione-showroom': 401,        // Nicole Competizione ショールーム
	'nicole-competizione-pre-owned': 402,       // Nicole Competizione プレオウンド ショールーム
	'nicole-competizione-service-centre': 403,  // Nicole Competizione サービスセンター

	// ─── 6. ニコル（アルピナ） ───
	'nicole-setagaya': 501,          // ニコル世田谷ショールーム
	'nicole-aoyama': 502,            // ニコル青山ショールーム

	// ─── 7. 管理オフィス（別枠ブロック） ───
	'office-kawasaki': 601,          // 川崎本社オフィス
	'office-yokohama': 602           // 横浜本社オフィス
};

locationsData.sort((a, b) => {
	const orderA = SPECIFIC_SLUG_ORDER[a.id] ?? (BRAND_PRIORITY_ORDER[a.brand] ? BRAND_PRIORITY_ORDER[a.brand] * 100 : 999);
	const orderB = SPECIFIC_SLUG_ORDER[b.id] ?? (BRAND_PRIORITY_ORDER[b.brand] ? BRAND_PRIORITY_ORDER[b.brand] * 100 : 999);
	return orderA - orderB;
});

function protectPhrases(str: string): string {
	if (!str) return '';
	return str
		.replace(/BMW Premium Selection/g, 'BMW\u00A0Premium\u00A0Selection')
		.replace(/MINI NEXT/g, 'MINI\u00A0NEXT');
}

// 拠点ごとのロゴ判定
function getLocationLogo(loc: any): string {
	if (loc.name.includes("青山") || loc.name.includes("世田谷") || loc.brand === "Nicole" || loc.brand === "ALPINA") {
		return "/brands/nicole-n-mark.svg";
	}
	if (loc.brand === "BMW") return "/brands/bmw.svg";
	if (loc.brand === "MINI") return "/brands/mini.svg";
	if (loc.brand === "Rolls-Royce") return "/brands/rolls-royce.svg";
	if (loc.brand === "Ferrari") return "/brands/ferrari.svg";
	return "/brands/nicole-n-mark.svg";
}

// サービスバッジ・タグ型定義
interface ServiceBadge {
	type: "sales" | "used" | "service" | "office";
	label: string;
	icon: "car" | "shield" | "wrench" | "building";
	brands: string[];
}

// データベースの取扱サービス（badges）からバッジを完全自動生成
function getFacilityBadges(loc: any): ServiceBadge[] {
	if (loc.services && loc.services.length > 0) {
		return loc.services.map((label: string) => {
			let type: "sales" | "used" | "service" | "office" = "sales";
			let icon: "car" | "shield" | "wrench" | "building" = "car";
			let brands = [loc.brand];

			if (label.includes("Rolls-Royce") || label.includes("ロールスロイス")) brands = ["Rolls-Royce"];
			else if (label.includes("Ferrari") || label.includes("フェラーリ")) brands = ["Ferrari"];
			else if (label.includes("MINI") || label.includes("ミニ")) brands = ["MINI"];
			else if (label.includes("ALPINA") || label.includes("アルピナ")) brands = ["ALPINA"];
			else if (label.includes("BMW")) brands = ["BMW"];

			if (label.includes("新車") || label.includes("車両")) {
				type = "sales";
				icon = "car";
			} else if (label.includes("認定中古車") || label.includes("中古車")) {
				type = "used";
				icon = "shield";
			} else if (label.includes("サービス") || label.includes("点検") || label.includes("車検") || label.includes("修理")) {
				type = "service";
				icon = "wrench";
				if (label.includes("BMW（ALPINA）")) {
					brands = ["BMW", "ALPINA"];
				}
			} else if (label.includes("本社・オフィス")) {
				type = "office";
				icon = "building";
				brands = loc.id === "loc-24" ? ["Rolls-Royce", "Ferrari"] : ["BMW", "MINI", "ALPINA"];
			}

			return { type, label, icon, brands };
		});
	}

	return [];
}

// 拠点ごとの対応ブランド取得
function getLocationBrands(loc: any): string[] {
	const brands = new Set<string>();
	if (loc.brand === "ALPINA" || loc.brand === "Nicole" || loc.name.includes("青山") || loc.name.includes("世田谷")) {
		brands.add("ALPINA");
		if (loc.brand) brands.add(loc.brand);
	} else if (loc.brand) {
		brands.add(loc.brand);
	}

	const badges = getFacilityBadges(loc);
	badges.forEach(b => {
		b.brands.forEach(br => brands.add(br));
	});

	return Array.from(brands);
}

// サービスバッジ判定（新車、中古車、サービス整備）
function getFacilityCategory(loc: any) {
	const badges = getFacilityBadges(loc);
	return {
		isSales: badges.some(b => b.type === "sales"),
		isUsed: badges.some(b => b.type === "used"),
		isService: badges.some(b => b.type === "service"),
		isOffice: badges.some(b => b.type === "office"),
	};
}

// ブランド一覧と拠点件数
const brandCounts = {
	ALL: locationsData.length,
	BMW: locationsData.filter(l => getLocationBrands(l).includes("BMW")).length,
	MINI: locationsData.filter(l => getLocationBrands(l).includes("MINI")).length,
	"Rolls-Royce": locationsData.filter(l => getLocationBrands(l).includes("Rolls-Royce")).length,
	Ferrari: locationsData.filter(l => getLocationBrands(l).includes("Ferrari")).length,
	ALPINA: locationsData.filter(l => getLocationBrands(l).includes("ALPINA")).length,
};

// 取扱機能別の件数
const functionCounts = {
	sales: locationsData.filter(l => getFacilityCategory(l).isSales).length,
	used: locationsData.filter(l => getFacilityCategory(l).isUsed).length,
	service: locationsData.filter(l => getFacilityCategory(l).isService).length,
};

// 店舗・ファクトリー（一般顧客向け）と本社オフィス（管理部門）を分離
const retailLocations = locationsData.filter(l => l.facilityType !== "本社・オフィス");
const officeLocations = locationsData.filter(l => l.facilityType === "本社・オフィス");
---

<NicoleLayout
	title="拠点一覧 | SHOWROOM & SERVICE LOCATIONS - ニコル・グループ公式"
	description="ニコル・グループの正規ディーラーショールームおよびサービスセンター拠点一覧。BMW、MINI、Rolls-Royce、Ferrari、ALPINAの住所、新車販売、中古車販売、サービス整備情報をご案内します。"
>
	<Fragment slot="head">
		<!-- Leaflet CSS & JS -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
	</Fragment>

	<main class="locs-page">
		<!-- 1. Hero Showcase -->
		<section class="locs-hero">
			<div class="locs-hero__media">
				<img 
					src="/uploads/2026/01/Nicole-BMW-本社.jpg" 
					alt="Nicole Group Network" 
					class="locs-hero__img" 
					loading="eager"
				/>
				<div class="locs-hero__overlay"></div>
			</div>
			<div class="locs-container locs-hero__inner">
				<!-- パンくずナビ -->
				<nav class="locs-breadcrumbs" aria-label="Breadcrumb">
					<ol class="locs-breadcrumbs__list">
						<li><a href="/">HOME</a></li>
						<li class="locs-breadcrumbs__sep">/</li>
						<li><a href="/corporate">CORPORATE</a></li>
						<li class="locs-breadcrumbs__sep">/</li>
						<li aria-current="page">LOCATIONS</li>
					</ol>
				</nav>

				<div class="locs-hero__content">
					<span class="locs-eyebrow">FACILITIES & NETWORK</span>
					<h1 class="locs-hero__title">
						<span class="heading-phrase">卓越したサービスをお届けする、</span><br />
						<span class="heading-phrase">拠点ネットワーク。</span>
					</h1>
					<p class="locs-hero__lead">
						東京都内および神奈川県の主要ロケーションに展開する正規ディーラーショールーム、認定中古車センター、最高峰のサービスファクトリー。
					</p>
				</div>
			</div>
		</section>

		<!-- 2. 【最上部】インタラクティブ・ネットワークマップ -->
		<section class="locs-map-section">
			<div class="locs-container">
				<div class="locs-map-header">
					<div class="locs-map-title-wrap">
						<span class="locs-map-dot"></span>
						<h2 class="locs-map-title">NETWORK MAP</h2>
						<span class="locs-map-sub">ピンをタップすると入居拠点一覧（新車・中古車・サービス）とGoogle Mapsルート案内が表示されます</span>
					</div>
					<button type="button" id="btn-reset-map" class="locs-map-reset-btn" title="地図全体を表示">
						全体を表示
					</button>
				</div>

				<div class="locs-map-frame">
					<div id="nicole-leaflet-map" class="nicole-leaflet-map"></div>
				</div>
			</div>
		</section>

		<!-- 3. 多層フィルターコントロールバー（ブランド ＆ 取扱機能 ＆ エリア） -->
		<section class="locs-filter-section">
			<div class="locs-container">
				<div class="locs-filter-matrix">
					<!-- ブランド絞り込み -->
					<div class="filter-row">
						<span class="filter-label">ブランド</span>
						<div class="locs-filter-group" id="brand-filters">
							<button type="button" class="locs-filter-btn is-active" data-filter="all">
								すべて <span class="locs-filter-count">({brandCounts.ALL})</span>
							</button>
							<button type="button" class="locs-filter-btn" data-filter="BMW">
								BMW <span class="locs-filter-count">({brandCounts.BMW})</span>
							</button>
							<button type="button" class="locs-filter-btn" data-filter="MINI">
								MINI <span class="locs-filter-count">({brandCounts.MINI})</span>
							</button>
							<button type="button" class="locs-filter-btn" data-filter="Rolls-Royce">
								Rolls-Royce <span class="locs-filter-count">({brandCounts["Rolls-Royce"]})</span>
							</button>
							<button type="button" class="locs-filter-btn" data-filter="Ferrari">
								Ferrari <span class="locs-filter-count">({brandCounts.Ferrari})</span>
							</button>
							<button type="button" class="locs-filter-btn" data-filter="ALPINA">
								ALPINA / Nicole <span class="locs-filter-count">({brandCounts.ALPINA})</span>
							</button>
						</div>
					</div>

					<!-- 取扱機能絞り込み（新車販売、中古車販売、サービス整備） -->
					<div class="filter-row">
						<span class="filter-label">サービス</span>
						<div class="locs-filter-group" id="service-filters">
							<button type="button" class="locs-pill-btn is-active" data-service="all">
								すべて
							</button>
							<button type="button" class="locs-pill-btn" data-service="sales">
								新車販売 <span class="locs-filter-count">({functionCounts.sales})</span>
							</button>
							<button type="button" class="locs-pill-btn" data-service="used">
								中古車販売 <span class="locs-filter-count">({functionCounts.used})</span>
							</button>
							<button type="button" class="locs-pill-btn" data-service="service">
								サービス整備 <span class="locs-filter-count">({functionCounts.service})</span>
							</button>
						</div>

						
					</div>
				</div>
