---
// src/pages/404.astro
// Nicole Group 公式 404 エラーページ
import NicoleLayout from "../layouts/NicoleLayout.astro";
---

<NicoleLayout 
	title="お探しのページが見つかりませんでした (404 Not Found) | Nicole Group 公式" 
	description="アクセスされたページは削除されたか、URLが変更された可能性があります。"
>
	<main class="nicole-404-main">
		<div class="nicole-404-container">
			<div class="nicole-404-badge">404 NOT FOUND</div>
			<h1 class="nicole-404-title">ページが見つかりませんでした</h1>
			<p class="nicole-404-lead">
				申し訳ございません。お探しのページは移動または削除されたか、<br class="pc-only" />
				URLが正しく入力されていない可能性があります。
			</p>

			<div class="nicole-404-nav-grid">
				<a href="/" class="nicole-404-card">
					<span class="nicole-404-card__title">ホーム</span>
					<span class="nicole-404-card__desc">ニコル・グループ トップページ</span>
					<span class="nicole-404-card__arrow">→</span>
				</a>
				<a href="/locations" class="nicole-404-card">
					<span class="nicole-404-card__title">拠点一覧</span>
					<span class="nicole-404-card__desc">東京・神奈川のショールーム・サービス工場</span>
					<span class="nicole-404-card__arrow">→</span>
				</a>
				<a href="/magazine/" class="nicole-404-card">
					<span class="nicole-404-card__title">マガジン</span>
					<span class="nicole-404-card__desc">Nicole Connect 最新ストーリー</span>
					<span class="nicole-404-card__arrow">→</span>
				</a>
				<a href="/news" class="nicole-404-card">
					<span class="nicole-404-card__title">お知らせ</span>
					<span class="nicole-404-card__desc">最新ニュース・営業日のご案内</span>
					<span class="nicole-404-card__arrow">→</span>
				</a>
			</div>

			<div class="nicole-404-cta">
				<a href="/" class="nicole-404-btn-primary">トップページへ戻る</a>
				<a href="/contact" class="nicole-404-btn-sub">お問い合わせはこちら</a>
			</div>
		</div>
	</main>
</NicoleLayout>

<style>
	.nicole-404-main {
		background: #0f1115;
		color: #ffffff;
		min-height: 70vh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 6rem 1.5rem;
		position: relative;
	}

	.nicole-404-container {
		max-width: 760px;
		width: 100%;
		margin: 0 auto;
		text-align: center;
	}

	.nicole-404-badge {
		display: inline-block;
		font-family: var(--font-mono, monospace);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		color: rgba(255, 255, 255, 0.45);
		border: 1px solid rgba(255, 255, 255, 0.12);
		padding: 0.35rem 0.85rem;
		border-radius: 9999px;
		margin-bottom: 1.5rem;
	}

	.nicole-404-title {
		font-size: clamp(1.75rem, 3.5vw, 2.5rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 1rem;
		color: #ffffff;
	}

	.nicole-404-lead {
		font-size: 1rem;
		line-height: 1.8;
		color: rgba(255, 255, 255, 0.65);
		margin: 0 0 3rem;
	}

	.nicole-404-nav-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		margin-bottom: 3rem;
		text-align: left;
	}

	@media (max-width: 640px) {
		.nicole-404-nav-grid {
			grid-template-columns: 1fr;
		}
	}

	.nicole-404-card {
		display: block;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 8px;
		padding: 1.25rem 1.5rem;
		text-decoration: none;
		position: relative;
		transition: all 0.2s ease;
	}

	.nicole-404-card:hover {
		background: rgba(255, 255, 255, 0.07);
		border-color: rgba(255, 255, 255, 0.2);
		transform: translateY(-2px);
	}

	.nicole-404-card__title {
		display: block;
		font-size: 1rem;
		font-weight: 600;
		color: #ffffff;
		margin-bottom: 0.25rem;
	}

	.nicole-404-card__desc {
		display: block;
		font-size: 0.8125rem;
		color: rgba(255, 255, 255, 0.5);
	}

	.nicole-404-card__arrow {
		position: absolute;
		right: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
		font-size: 1.125rem;
		color: rgba(255, 255, 255, 0.3);
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.nicole-404-card:hover .nicole-404-card__arrow {
		transform: translate(3px, -50%);
		color: #ffffff;
	}

	.nicole-404-cta {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.nicole-404-btn-primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.875rem 2rem;
		background: #ffffff;
		color: #000000;
		font-size: 0.9375rem;
		font-weight: 600;
		border-radius: 4px;
		text-decoration: none;
		transition: background 0.2s ease, opacity 0.2s ease;
	}

	.nicole-404-btn-primary:hover {
		opacity: 0.9;
	}

	.nicole-404-btn-sub {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.875rem 2rem;
		background: transparent;
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.25);
		font-size: 0.9375rem;
		font-weight: 600;
		border-radius: 4px;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.nicole-404-btn-sub:hover {
		border-color: #ffffff;
		background: rgba(255, 255, 255, 0.05);
	}

	@media (max-width: 768px) {
		.pc-only {
			display: none;
		}
	}
</style>
