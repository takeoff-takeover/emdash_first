---
// src/pages/corporate/nicole-competizione.astro
// Nicole Competizione合同会社 会社案内（Nicole Connect マガジン同等の黒背景エディトリアルデザイン）
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import svgs from "../../data/corporate-svgs.json";

const pageTitle = "Nicole Competizione合同会社 | フェラーリ正規ディーラー | Nicole Group 公式";
const pageDescription = "イタリアが誇る至高の跳ね馬 フェラーリ正規販売代理店 Nicole Competizione合同会社の企業情報です。横浜みなとみらいの新車ショールーム、都筑区川向町のプレオウンド（認定中古車）ショールームならびに最新鋭サービスセンターを展開。2年連続となる「全国フェラーリ最優秀ディーラー賞（2024・2025）」を受賞。";

// ショールームフォトギャラリー写真（Gallery format rule準拠: シンプルな番号と説明のみ）
const showroomGallery = [
	{
		src: "/uploads/2026/02/22A4894_web_size_re-e1772189562839.avif",
		alt: "Nicole Competizione メインショールーム展示エリア",
		num: "01",
		caption: "横浜みなとみらいに位置する最新モデル展示メインフロア"
	},
	{
		src: "/uploads/2026/02/Z7A8366_re_web.avif",
		alt: "Nicole Competizione アトリエ・パーソナライゼーション空間",
		num: "02",
		caption: "内外装マテリアルを選び世界に一台を仕立てるアトリエ"
	},
	{
		src: "/uploads/2026/02/24_0206_nicol_kohoku_35470_re_web.avif",
		alt: "Nicole Competizione プレオウンドショールーム 展示スペース",
		num: "03",
		caption: "厳格な品質基準をクリアしたFerrari Approved認定中古車フロア"
	},
	{
		src: "/uploads/2026/02/24_0206_nicol_kohoku_33477_re_re-scaled.avif",
		alt: "Nicole Competizione サービスセンター ワークショップ",
		num: "04",
		caption: "マラネッロ基準の専用診断テスターと設備を備えるテクニカルベイ"
	},
	{
		src: "/uploads/2026/02/24_0206_nicol_kohoku_35084_re_web.avif",
		alt: "Nicole Competizione オーナーズラウンジ",
		num: "05",
		caption: "フェラーリのヘリテージを感じながら寛げるオーナーズラウンジ"
	}
];

// 拠点データ（locations.json準拠）
const facilities = [
	{
		name: "Nicole Competizione ショールーム",
		type: "新車ショールーム",
		postal: "〒220-0012",
		address: "神奈川県横浜市西区みなとみらい3-3-3",
		tel: "045-680-4465",
		fax: "045-680-4466",
		hours: "10:00～18:00",
		closed: "水曜日",
		image: "/uploads/2026/02/トーンカーブ-1-e1773743622630-1-1024x683.jpg",
		mapUrl: "https://maps.google.com/?q=Nicole+Competizione+ショールーム+横浜市西区みなとみらい3-3-3",
		desc: "最新のコーポレートアイデンティティに基づき設計された新車ショールーム。特別な一台を形づくる「アトリエ」や、プライベート商談ラウンジを完備しています。"
	},
	{
		name: "Nicole Competizione プレオウンド ショールーム",
		type: "認定中古車ショールーム",
		postal: "〒224-0044",
		address: "神奈川県横浜市都筑区川向町2003-6",
		tel: "045-577-3817",
		fax: "045-577-3818",
		hours: "10:00～18:00",
		closed: "水曜日",
		image: "/uploads/2026/02/24_0206_nicol_kohoku_34664_re_re-e1773743709911-2-1024x683.jpg",
		mapUrl: "https://maps.google.com/?q=Nicole+Competizione+プレオウンド+ショールーム+横浜市都筑区川向町2003-6",
		desc: "フェラーリ本国の厳格な最大202項目に及ぶテクニカルインスペクションをクリアした「Ferrari Approved」認定中古車を取り揃えています。"
	},
	{
		name: "Nicole Competizione サービスセンター",
		type: "指定サービス工場",
		postal: "〒224-0044",
		address: "神奈川県横浜市都筑区川向町2003-6",
		tel: "045-577-3824",
		fax: "045-577-3825",
		hours: "10:00～18:00",
		closed: "水曜日",
		image: "/uploads/2026/02/24_0206_nicol_kohoku_34664_re_re-e1773743709911-1-1024x683.jpg",
		mapUrl: "https://maps.google.com/?q=Nicole+Competizione+サービスセンター+横浜市都筑区川向町2003-6",
		desc: "フェラーリ本国マラネッロ指定の最新鋭診断テスターと専用工具を備え、メーカー公式認定を受けた熟練テクニシャンが点検・車検・レストアを執り行います。"
	}
];

// 受賞歴
const awardInfo = {
	title: "全国フェラーリ最優秀ディーラー賞",
	badge: "2年連続受賞（2024・2025）",
	desc: "日本国内の正規フェラーリディーラーネットワークにおいて、販売実績、顧客満足度、アフターセールス品質、ブランド基準遵守のすべてにおいて最高峰の評価を獲得。設立10年目の2024年に続き、2025年にも栄冠を手にしました。",
	svgIndex: 17
};

// 関連記事データ
const relatedArticles = [
	{
		title: "フェラーリ認定中古車は買い？最大202項目点検・保証・維持費を解説",
		date: "2026.08.15",
		tag: "Ferrari Approved",
		url: "/posts/202608_ferrari_approved-guide/",
		img: "/uploads/2026/02/24_0206_nicol_kohoku_35470_re_web.avif"
	},
	{
		title: "初めてのフェラーリ購入ガイド｜新車vs認定中古車・モデル選び・納期の現実",
		date: "2026.08.10",
		tag: "Ferrari Guide",
		url: "/posts/202608_ferrari_first-guide/",
		img: "/uploads/2026/02/22A4894_web_size_re-e1772189562839.avif"
	},
	{
		title: "フェラーリ初のフル電動モデル「LUCE（ルーチェ）」日本上陸",
		date: "2026.08.08",
		tag: "Ferrari Innovation",
		url: "/posts/202608_ferrari_luce/",
		img: "/uploads/2026/02/Z7A8366_re_web.avif"
	},
	{
		title: "フェラーリスタの心を揺さぶる体験。その世界観を支えるマーケターの視点",
		date: "2026.08.07",
		tag: "Ferrari Culture",
		url: "/posts/202608_ferrari_marketing/",
		img: "/uploads/2026/02/24_0206_nicol_kohoku_35084_re_web.avif"
	}
];

// Schema.org 構造化データ（JSON-LD）
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "AboutPage",
			"@id": "https://www.nicole.co.jp/corporate/nicole-competizione/#webpage",
			"url": "https://www.nicole.co.jp/corporate/nicole-competizione",
			"name": pageTitle,
			"description": pageDescription,
			"breadcrumb": {
				"@id": "https://www.nicole.co.jp/corporate/nicole-competizione/#breadcrumb"
			}
		},
		{
			"@type": "BreadcrumbList",
			"@id": "https://www.nicole.co.jp/corporate/nicole-competizione/#breadcrumb",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "HOME",
					"item": "https://www.nicole.co.jp/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "会社概要",
					"item": "https://www.nicole.co.jp/corporate"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "Nicole Competizione合同会社",
					"item": "https://www.nicole.co.jp/corporate/nicole-competizione"
				}
			]
		},
		{
			"@type": "AutoDealer",
			"@id": "https://www.nicole.co.jp/corporate/nicole-competizione/#organization",
			"name": "Nicole Competizione合同会社",
			"alternateName": "Nicole Competizione LLC",
			"url": "https://www.nicole.co.jp/corporate/nicole-competizione",
			"telephone": "045-680-4465",
			"address": {
				"@type": "PostalAddress",
				"postalCode": "220-0012",
				"addressRegion": "神奈川県",
				"addressLocality": "横浜市西区",
				"streetAddress": "みなとみらい3-3-3"
			},
			"parentOrganization": {
				"@type": "Organization",
				"name": "ニコル・グループ",
				"url": "https://www.nicole.co.jp/"
			}
		}
	]
};
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style is:global>
			body:has(.corporate-magazine-main),
			body:has(.corporate-magazine-main) #page,
			body:has(.corporate-magazine-main) #content,
			body:has(.corporate-magazine-main) .site-content,
			body:has(.corporate-magazine-main) #primary,
			body:has(.corporate-magazine-main) .content-area,
			body:has(.corporate-magazine-main) .ast-container {
				background-color: #040507 !important;
				background-image: none !important;
			}
		</style>
	</Fragment>

	<main class="corporate-magazine-main">
		<!-- 1. HERO COVER -->
		<header class="corp-hero">
			<div class="corp-hero__media">
				<img 
					src="/uploads/2026/02/22A4894_web_size_re-e1772189562839.avif" 
					alt="Nicole Competizione合同会社 フェラーリ メインショールーム" 
					class="corp-hero__img" 
					loading="eager" 
					decoding="async" 
				/>
				<div class="corp-hero__gradient"></div>
				<div class="corp-hero__side-vignette"></div>
			</div>

			<div class="corp-container corp-hero__inner">
				<nav class="corp-breadcrumbs" aria-label="パンくずリスト">
					<ol class="corp-breadcrumbs__list">
						<li class="corp-breadcrumbs__item"><a href="/" class="corp-breadcrumbs__link">HOME</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item"><a href="/corporate" class="corp-breadcrumbs__link">会社概要</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item" aria-current="page">Nicole Competizione合同会社</li>
					</ol>
				</nav>

				<div class="corp-hero__logo-wrap">
					<div class="corp-hero__brand-logo" set:html={svgs[8]} />
				</div>

				<h1 class="corp-hero__title">Nicole Competizione合同会社</h1>
				<p class="corp-hero__subtitle">
					<span class="corp-hero__phrase">イタリアが誇る至高の跳ね馬「フェラーリ」正規販売代理店。</span>
					<span class="corp-hero__phrase">全国最優秀ディーラー賞 2年連続受賞（2024・2025）。</span><br class="corp-hero__br" />
					<span class="corp-hero__phrase">横浜みなとみらいの新車ショールーム、都筑区川向町のプレオウンドショールームとサービスセンターの3拠点体制で、</span>
					<span class="corp-hero__phrase">フェラーリが織りなす特別な世界観とライフスタイルをお届けします。</span>
				</p>

				<!-- ページ内クイックナビゲーション -->
				<nav class="corp-subnav" aria-label="ページ内目次">
					<ul class="corp-subnav__list">
						<li><a href="#about" class="corp-subnav__pill">会社紹介</a></li>
						<li><a href="#showrooms" class="corp-subnav__pill">拠点案内</a></li>
						<li><a href="#awards" class="corp-subnav__pill">受賞歴</a></li>
						<li><a href="#gallery" class="corp-subnav__pill">ギャラリー</a></li>
						<li><a href="#articles" class="corp-subnav__pill">関連記事</a></li>
						<li><a href="#profile" class="corp-subnav__pill">会社基本データ</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<!-- 2. 会社紹介（ABOUT & PHILOSOPHY） -->
		<section id="about" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<div class="corp-narrative-grid">
					<!-- 左列: メディアビジュアル -->
					<div class="corp-narrative-visual">
						<div class="corp-narrative-card">
							<img 
								src="/uploads/2026/02/Z7A8366_re_web.avif" 
								alt="Nicole Competizione アトリエ・パーソナライゼーション空間" 
								class="corp-narrative-img" 
								width="1200" 
								height="800" 
								loading="lazy" 
								decoding="async" 
							/>
							<div class="corp-narrative-caption">
								<span class="corp-narrative-caption-title">フェラーリ アトリエ</span>
								<span class="corp-narrative-caption-sub">Nicole Competizione Atelier</span>
							</div>
						</div>
					</div>

					<!-- 右列: ストーリー本文 -->
					<div class="corp-narrative-content">
						<header class="corp-section-header">
							<h2 class="corp-section-title">情熱と卓越の跳ね馬。<br />お客様と紡ぐ揺るぎない信頼。</h2>
							<p class="corp-section-lead">フェラーリ正規販売代理店として、包括的なサービスと比類なき体験をお届けします</p>
						</header>

						<div class="corp-narrative-body">
							<p>Nicole Competizione合同会社は、イタリアが誇る至高のラグジュアリースポーツカーブランド「フェラーリ」の正規販売代理店として、2014年8月に設立されました。</p>

							<p>横浜みなとみらいに位置する新車ショールーム、都筑区川向町に展開する認定中古車（プレオウンド）ショールーム、ならびに最新鋭の設備を備えたサービスセンターの3拠点体制を敷き、新車のご購入からパーソナライゼーション、認定中古車のご提案、点検・車検・レストアに至るまで、一貫した最高峰のサービスを提供しています。</p>

							<p>設立10年目となる2024年に初の「全国フェラーリ最優秀ディーラー賞」を獲得、さらに2025年にも2年連続となる最優秀ディーラー賞を受賞。世界水準の情熱と高度な専門技術をもって、オーナーの皆様の情熱的なフェラーリライフを誠心誠意サポートいたします。</p>
						</div>

						<div class="corp-narrative-highlights">
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">2年連続</div>
								<div class="corp-highlight-item__label">最優秀ディーラー賞（2024・2025）</div>
							</div>
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">2014年</div>
								<div class="corp-highlight-item__label">設立・正規指名</div>
							</div>
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">3拠点</div>
								<div class="corp-highlight-item__label">新車・認定中古車・サービス拠点</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. 拠点案内（SHOWROOMS & SERVICE） -->
		<section id="showrooms" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">拠点のご案内</h2>
					<p class="corp-section-subtitle">横浜みなとみらいと都筑区に展開する3つの正規ネットワーク。新車、認定中古車、アフターセールスの全方位でフェラーリの世界を支えます。</p>
				</header>

				<div class="corp-showrooms-stack">
					{facilities.map((f) => (
						<div class="corp-showroom-grid">
							<div class="corp-showroom-visual">
								<div class="corp-showroom-photo-wrap">
									<img 
										src={f.image} 
										alt={`${f.name} 外観写真`} 
										class="corp-showroom-photo" 
										loading="lazy" 
										decoding="async" 
									/>
									<div class="corp-showroom-photo-badge">{f.type}</div>
								</div>
							</div>

							<div class="corp-showroom-info">
								<header class="corp-showroom-header">
									<div>
										<span class="corp-showroom-type">{f.type}</span>
										<h3 class="corp-showroom-name">{f.name}</h3>
									</div>
								</header>

								<p class="corp-showroom-desc">{f.desc}</p>

								<dl class="corp-showroom-details">
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">所在地</dt>
										<dd class="corp-showroom-dd">
											{f.postal} {f.address}
											<a href={f.mapUrl} target="_blank" rel="noopener noreferrer" class="corp-map-link">Google Mapsで開く</a>
										</dd>
									</div>
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">電話番号</dt>
										<dd class="corp-showroom-dd">
											<a href={`tel:${f.tel.replace(/-/g, '')}`} class="corp-tel-link">{f.tel}</a>
											{f.fax && <span class="corp-fax">（FAX: {f.fax}）</span>}
										</dd>
									</div>
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">営業時間</dt>
										<dd class="corp-showroom-dd">{f.hours}</dd>
									</div>
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">定休日</dt>
										<dd class="corp-showroom-dd">{f.closed}</dd>
									</div>
								</dl>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 4. 受賞歴（AWARDS） -->
		<section id="awards" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">受賞実績</h2>
					<p class="corp-section-subtitle">全国のフェラーリ正規販売代理店ネットワークにおいて最高峰の栄誉を連続受賞。</p>
				</header>

				<div class="corp-awards-panel">
					<div class="corp-award-card corp-award-card--featured">
						<div class="corp-award-card__wreath" set:html={svgs[awardInfo.svgIndex]} />
						<div class="corp-award-card__content">
							<span class="corp-award-card__badge">{awardInfo.badge}</span>
							<h3 class="corp-award-card__title">{awardInfo.title}</h3>
							<p class="corp-award-card__desc">{awardInfo.desc}</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 5. ギャラリー（GALLERY） -->
		<section id="gallery" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">ギャラリー</h2>
					<p class="corp-section-subtitle">Nicole Competizioneが誇る最新ショールーム、アトリエ、テクニカルベイの空間。</p>
				</header>

				<div class="corp-gallery-grid">
					{showroomGallery.map((item) => (
						<article class="corp-gallery-card">
							<div class="corp-gallery-visual">
								<img 
									src={item.src} 
									alt={item.alt} 
									class="corp-gallery-img" 
									loading="lazy" 
									decoding="async" 
								/>
								<span class="corp-gallery-badge">{item.num}</span>
							</div>
							<div class="corp-gallery-meta">
								<p class="corp-gallery-caption">{item.caption}</p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- 6. 関連記事（RELATED ARTICLES） -->
		<section id="articles" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">関連記事</h2>
					<p class="corp-section-subtitle">オウンドメディア「Nicole Connect」より、フェラーリに関する最新情報やオーナー向け解説記事をお届けします。</p>
				</header>

				<div class="corp-articles-grid">
					{relatedArticles.map((art) => (
						<a href={art.url} class="corp-article-card">
							<div class="corp-article-card__thumb-wrap">
								<img 
									src={art.img} 
									alt={art.title} 
									class="corp-article-card__thumb" 
									loading="lazy" 
									decoding="async" 
								/>
