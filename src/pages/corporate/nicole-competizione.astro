};
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style is:global>
			body:has(.corporate-magazine-main),
			body:has(.corporate-magazine-main) #page,
			body:has(.corporate-magazine-main) #content,
			body:has(.corporate-magazine-main) .site-content,
			body:has(.corporate-magazine-main) #primary,
			body:has(.corporate-magazine-main) .content-area,
			body:has(.corporate-magazine-main) .ast-container {
				background-color: #040507 !important;
				background-image: none !important;
			}
			body:has(.corporate-magazine-main) #primary,
			body:has(.corporate-magazine-main) .content-area {
				margin: 0 !important;
				padding: 0 !important;
			}
			body:has(.corporate-magazine-main) #content,
			body:has(.corporate-magazine-main) .site-content,
			body:has(.corporate-magazine-main) .ast-container {
				margin: 0 !important;
				padding-left: 0 !important;
				padding-right: 0 !important;
				padding-top: 0 !important;
				max-width: 100% !important;
				width: 100% !important;
			}
		</style>
	</Fragment>

	<main class="corporate-magazine-main">
		<!-- 1. HERO COVER -->
		<header class="corp-hero">
			<div class="corp-hero__media">
				<img 
					src={heroImageSrc} 
					alt={`${companyTitle} メインショールーム`} 
					class="corp-hero__img" 
					loading="eager" 
					decoding="async" 
				/>
				<div class="corp-hero__gradient"></div>
				<div class="corp-hero__side-vignette"></div>
			</div>

			<div class="corp-container corp-hero__inner">
				<nav class="corp-breadcrumbs" aria-label="パンくずリスト">
					<ol class="corp-breadcrumbs__list">
						<li class="corp-breadcrumbs__item"><a href="/" class="corp-breadcrumbs__link">HOME</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item"><a href="/corporate" class="corp-breadcrumbs__link">会社概要</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item" aria-current="page">{companyTitle}</li>
					</ol>
				</nav>

				<h1 class="corp-hero__title">{companyTitle}</h1>
				<p class="corp-hero__subtitle">
					<span class="corp-hero__phrase">{heroPhrase}</span>
				</p>

				<!-- ページ内クイックナビゲーション -->
				<nav class="corp-subnav" aria-label="ページ内目次">
					<ul class="corp-subnav__list">
						<li><a href="#about" class="corp-subnav__pill">会社紹介</a></li>
						<li><a href="#showrooms" class="corp-subnav__pill">拠点案内</a></li>
						<li><a href="#profile" class="corp-subnav__pill">会社基本データ</a></li>
						<li><a href="#awards" class="corp-subnav__pill">受賞実績</a></li>
						<li><a href="#gallery" class="corp-subnav__pill">ギャラリー</a></li>
						{parsedContent.length > 0 && <li><a href="#additional-content" class="corp-subnav__pill">詳細情報</a></li>}
						<li><a href="#articles" class="corp-subnav__pill">関連記事</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<!-- 2. 会社紹介（ABOUT & PHILOSOPHY） -->
		<section id="about" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<div class="corp-narrative-grid">
					<!-- 左列: メディアビジュアル -->
					<div class="corp-narrative-visual">
						<div class="corp-narrative-card">
							<img 
								src={aboutImageSrc} 
								alt={aboutImageCaption} 
								class="corp-narrative-img" 
								width="1024" 
								height="683" 
								loading="lazy" 
								decoding="async" 
							/>
						</div>
					</div>

					<!-- 右列: ストーリー本文 -->
					<div class="corp-narrative-content">
						<header class="corp-section-header">
							<h2 class="corp-section-title" set:html={aboutTitle} />
							<p class="corp-section-lead">{aboutLead}</p>
						</header>

						<div class="corp-narrative-body">
							{aboutText.split("\n\n").map((para: string) => (
								<p>{para}</p>
							))}
						</div>

						<div class="corp-narrative-highlights">
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">{highlight1Num}</div>
								<div class="corp-highlight-item__label">{highlight1Label}</div>
							</div>
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">{highlight2Num}</div>
								<div class="corp-highlight-item__label">{highlight2Label}</div>
							</div>
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">{highlight3Num}</div>
								<div class="corp-highlight-item__label">{highlight3Label}</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. 拠点案内（SHOWROOMS & SERVICE） -->
		<section id="showrooms" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">拠点のご案内</h2>
					<p class="corp-section-subtitle">
						<span class="corp-hero__phrase">横浜みなとみらいと都筑区に展開する3つの正規ネットワーク。</span>
						<span class="corp-hero__phrase">新車、認定中古車、アフターセールスの全方位でフェラーリの世界を支えます。</span>
					</p>
				</header>

				<div class="corp-showrooms-stack">
					{facilities.map((f) => (
						<div class="corp-showroom-grid">
							<div class="corp-showroom-visual">
								<div class="corp-showroom-photo-wrap">
									<img 
										src={f.image} 
										alt={`${f.name} 外観写真`} 
										class="corp-showroom-photo" 
										loading="lazy" 
										decoding="async" 
									/>
								</div>
							</div>

							<div class="corp-showroom-info">
								<header class="corp-showroom-header">
									<div>
										<span class="corp-showroom-type">{f.type}</span>
										<h3 class="corp-showroom-name">{f.name}</h3>
									</div>
								</header>

								<p class="corp-showroom-desc">{f.desc}</p>

								<dl class="corp-showroom-details">
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">所在地</dt>
										<dd class="corp-showroom-dd">
											<span>{f.postal} {f.address}</span>
											<MapBadge href={f.mapUrl} title="Googleマップで地図を見る" ariaLabel={`${f.name}の地図をGoogleマップで開く`} />
										</dd>
									</div>
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">電話番号</dt>
										<dd class="corp-showroom-dd">
											<a href={`tel:${f.tel.replace(/-/g, '')}`} class="corp-tel-link">{f.tel}</a>
											{f.fax && <span class="corp-fax">（FAX: {f.fax}）</span>}
										</dd>
									</div>
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">営業時間</dt>
										<dd class="corp-showroom-dd">{f.hours}</dd>
									</div>
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">定休日</dt>
										<dd class="corp-showroom-dd">{f.closed}</dd>
									</div>
								</dl>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 4. 会社基本データ -->
		<section id="profile" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">会社基本データ</h2>
					<p class="corp-section-subtitle">Nicole Competizione合同会社の企業概要データです。</p>
				</header>

				<div class="corp-profile-card">
					<table class="corp-profile-table">
						<tbody>
							<tr>
								<th scope="row">会社名</th>
								<td>{companyTitle}（{companyNameEn}）</td>
							</tr>
							<tr>
								<th scope="row">設立</th>
								<td>{established}</td>
							</tr>
							<tr>
								<th scope="row">代表者</th>
								<td>{representative}</td>
							</tr>
							<tr>
								<th scope="row">所在地</th>
								<td>
									<span>{postal} {address}</span>
									{facilities[0]?.mapUrl && (
										<MapBadge href={facilities[0].mapUrl} title="Googleマップで地図を見る" ariaLabel="本社の地図をGoogleマップで開く" />
									)}
								</td>
							</tr>
							<tr>
								<th scope="row">電話番号</th>
								<td>{telDisplay}</td>
							</tr>
							<tr>
								<th scope="row">事業内容</th>
								<td>
									<ul class="corp-business-list">
										{businessList.map((item: string) => (
											<li>{item}</li>
										))}
									</ul>
								</td>
							</tr>
							<tr>
								<th scope="row">運営拠点</th>
								<td>
									<span class="corp-facility-summary">全{facilities.length}拠点（神奈川県横浜市）</span>
									<ul class="corp-profile-facilities">
										{facilities.map((f) => (
											<li>
												<span class="corp-facility-type">{f.type}：</span>
												<strong class="corp-facility-name">{f.name}</strong>
												<span class="corp-facility-addr">（{f.postal} {f.address}）</span>
												<MapBadge href={f.mapUrl} title="Googleマップで地図を見る" ariaLabel={`${f.name}の地図をGoogleマップで開く`} />
											</li>
										))}
									</ul>
								</td>
							</tr>
							<tr>
								<th scope="row">取扱ブランド</th>
								<td>Ferrari（フェラーリ）</td>
							</tr>
							<tr>
								<th scope="row">関連ページ</th>
								<td>
									<div class="corp-related-links">
										<a href="/corporate" class="corp-inline-link">会社概要（グループ総合）</a>
										<span class="corp-inline-link-sep">/</span>
										<a href="/philosophy" class="corp-inline-link">企業理念</a>
										<span class="corp-inline-link-sep">/</span>
										<a href="/locations" class="corp-inline-link">グループ拠点一覧</a>
										<span class="corp-inline-link-sep">/</span>
										<a href="/magazine" class="corp-inline-link">Web Magazine</a>
									</div>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<!-- 5. 受賞実績（AWARDS） -->
		<section id="awards" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">受賞実績</h2>
					<p class="corp-section-subtitle">全国のフェラーリ正規販売代理店ネットワークにおいて最高峰の栄誉を連続受賞。</p>
				</header>

				<div class="corp-awards-panel">
					<div class="corp-award-card corp-award-card--featured">
						<div class="corp-award-card__content">
							<span class="corp-award-card__badge">{awardBadge}</span>
							<h3 class="corp-award-card__title">{awardTitle}</h3>
							<p class="corp-award-card__desc">{awardDesc}</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 6. ギャラリー（GALLERY - カルーセルスライダー） -->
		<section id="gallery" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">ギャラリー</h2>
					<p class="corp-section-subtitle">Nicole Competizioneが誇る最新ショールーム、アトリエ、テクニカルベイの空間。</p>
				</header>

				<div class="corp-slider-wrapper">
					<div class="corp-slider-viewport">
						<div class="corp-slider-track" id="corpSliderTrack">
							{showroomGallery.map((item, idx) => (
								<div class={`corp-slider-slide ${idx === 0 ? "is-active" : ""}`} data-slide-index={idx}>
									<div class="corp-slider-media">
										<img 
											src={item.src} 
											alt={item.alt} 
											class="corp-slider-img" 
											loading={idx === 0 ? "eager" : "lazy"} 
											decoding="async" 
										/>
										<span class="corp-slider-badge">{item.num} / {String(showroomGallery.length).padStart(2, "0")}</span>
									</div>
									<div class="corp-slider-caption">
										<h3 class="corp-slider-title">{item.title}</h3>
										<p class="corp-slider-desc">{item.caption}</p>
									</div>
								</div>
							))}
						</div>

						<!-- 左右ナビゲーション矢印 -->
						<button type="button" class="corp-slider-btn corp-slider-btn--prev" id="corpSliderPrev" aria-label="前の写真へ">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
						</button>
						<button type="button" class="corp-slider-btn corp-slider-btn--next" id="corpSliderNext" aria-label="次の写真へ">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
						</button>
					</div>

					<!-- サムネイルナビゲーション -->
					<div class="corp-slider-thumbs" id="corpSliderThumbs" role="tablist" aria-label="サムネイル一覧">
						{showroomGallery.map((item, idx) => (
							<button 
								type="button" 
								class={`corp-slider-thumb ${idx === 0 ? "is-active" : ""}`} 
								data-thumb-index={idx}
								aria-label={`スライド ${idx + 1} (${item.title}) を表示`}
							>
								<img src={item.src} alt={item.title} class="corp-slider-thumb-img" loading="lazy" decoding="async" />
							</button>
						))}
					</div>
				</div>
			</div>
		</section>

		<!-- 7. 追加コンテンツ（CMS Portable Text 自由ブロック） -->
		{parsedContent.length > 0 && (
			<section id="additional-content" class="corp-section corp-section--bordered">
				<div class="corp-container">
					<div class="corp-prose-wrap">
						<RichPortableText value={parsedContent} />
					</div>
				</div>
			</section>
		)}

		<!-- 8. 関連記事（RELATED ARTICLES） -->
		<section id="articles" class="corp-section">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">関連記事</h2>
					<p class="corp-section-subtitle">オウンドメディア「Nicole Connect」より、フェラーリに関する最新情報やオーナー向け解説記事をお届けします。</p>
				</header>

				<div class="corp-articles-grid">
					{relatedArticles.map((art) => (
						<ArticleCard
							title={art.title}
							url={art.url}
							image={art.img}
							date={art.date}
							topic={art.category}
							brand={art.brand}
							showBrandPill={false}
						/>
					))}
				</div>
			</div>
		</section>
	</main>
</NicoleLayout>

<style>
	/* ============================================================== */
	/* Nicole Corporate - 黒背景エディトリアルデザインシステム */
	/* ============================================================== */
	.corporate-magazine-main {
		background-color: #040507;
		color: #ffffff;
		font-family: "Helvetica Neue", Helvetica, Arial, -apple-system, BlinkMacSystemFont, "Hiragino Kaku Gothic ProN", "Yu Gothic", sans-serif;
		min-height: 100vh;
		position: relative;
		overflow-x: hidden;
		padding-top: 0;
	}

	.corp-container {
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 40px;
		box-sizing: border-box;
	}

	@media (max-width: 1024px) {
		.corp-container {
			padding: 0 24px;
		}
	}

	@media (max-width: 480px) {
		.corp-container {
			padding: 0 16px;
		}
	}

	/* 共通セクション設定 */
	.corp-section {
		padding: 90px 0;
		position: relative;
	}

	.corp-section--bordered {
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	@media (max-width: 768px) {
		.corp-section {
			padding: 60px 0;
		}
	}

	.corp-section-header {
		margin-bottom: 48px;
	}

	.corp-section-title {
		font-size: clamp(26px, 3.2vw, 38px);
		font-weight: 700;
		color: #ffffff;
		letter-spacing: -0.01em;
		line-height: 1.3;
		margin: 0 0 14px 0;
		text-wrap: balance;
	}

	.corp-section-subtitle {
