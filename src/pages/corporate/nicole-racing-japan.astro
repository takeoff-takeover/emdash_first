---
// src/pages/corporate/nicole-racing-japan.astro
// ニコル・レーシング・ジャパン合同会社 会社案内（Nicole Connect マガジン同等の黒背景エディトリアルデザイン）
import { getEmDashEntry, getEmDashCollection, getTermsForEntries } from "emdash";
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import MapBadge from "../../components/MapBadge.astro";
import RichPortableText from "../../components/blocks/RichPortableText.astro";
import svgs from "../../data/corporate-svgs.json";
import "../../styles/corporate.css";

// CMS 'companies' コレクションからデータを優先取得
let companyEntry: any = null;
try {
	const res = await getEmDashEntry("companies" as any, "nicole-racing-japan");
	if (res?.entry) {
		companyEntry = res.entry.data || res.entry;
	}
} catch (e) {}

// 管理画面で追加された自由ブロック（Portable Text）のパース
let parsedContent: any[] = [];
if (companyEntry?.content) {
	if (Array.isArray(companyEntry.content)) {
		parsedContent = companyEntry.content;
	} else if (typeof companyEntry.content === "string") {
		try {
			const parsed = JSON.parse(companyEntry.content);
			if (Array.isArray(parsed)) parsedContent = parsed;
		} catch (e) {}
	}
}

const companyTitle = companyEntry?.title || "ニコル・レーシング・ジャパン合同会社";

const pageTitle = companyEntry?.title
	? `${companyEntry.title} | グループ中枢・シェアードサービス | Nicole Group 公式`
	: "ニコル・レーシング・ジャパン合同会社 | グループ中枢・シェアードサービス | Nicole Group 公式";

const pageDescription = companyEntry?.hero_phrase
	? companyEntry.hero_phrase
	: "ニコル・グループの創業母体であるニコル・レーシング・ジャパン合同会社の企業情報です。1977年の設立以来、グループ全体の経営資源最適化、シェアードサービス（経理・財務・総務・人事・法務）、マーケティング戦略、IT基盤統括などの中枢機能を担っています。";

// ヒーロー
const heroImageSrc = companyEntry?.hero_image?.src || "/uploads/2026/01/ニコルレーシングジャパン合同会社-scaled.jpg";
const heroPhrase = companyEntry?.hero_phrase || "1977年設立。ニコル・グループの創業母体であり、グループの事業成長を支える中枢機能。シェアードサービス機能（経理・財務・総務・人事・法務）と戦略的マーケティングを集約し、各事業会社がお客様へのサービス提供に専念できる強固な経営支援とシナジー最大化を推進しています。";

// 会社紹介
const aboutTitle = companyEntry?.about_title || "グループの経営資源を最適化し、<br />未来の持続的成長を牽引する。";
const aboutLead = companyEntry?.about_lead || "1977年の創業以来、グループ各社の自律とシナジーを両立させる中枢基盤";
const aboutImageSrc = companyEntry?.about_image?.src || "/uploads/2026/01/Nicole-BMW-本社-1.jpg";
const aboutImageCaption = companyEntry?.about_image_caption || "ニコル・グループ 川崎本社";
const aboutText = companyEntry?.about_text || "ニコル・レーシング・ジャパン合同会社は、1977年3月、レーシングドライバーであり創業者のC. H. ニコルによって設立されたニコル・グループの創業母体です。\n\n以来、BMW、MINI、Rolls-Royce、Ferrari、ALPINAといった世界最高峰のモビリティブランドを展開するグループ各社の中枢として、経営企画、コーポレートガバナンス、ITシステム基盤の構築・統括を担ってまいりました。\n\nまた、経理・財務、人事・労務、総務、法務などの管理部門機能を「シェアードサービス」として集約。各事業会社の業務効率化と標準化を推進することで、現場のディーラー各拠点がお客様への最高峰のホスピタリティとサービス提供に専念できる強固な組織体制を確立しています。";

// ハイライト
const highlight1Num = companyEntry?.highlight_1_num || "1977年";
const highlight1Label = companyEntry?.highlight_1_label || "グループ創業の原点";
const highlight2Num = companyEntry?.highlight_2_num || "4社";
const highlight2Label = companyEntry?.highlight_2_label || "事業会社の中枢統轄";
const highlight3Num = companyEntry?.highlight_3_num || "2拠点";
const highlight3Label = companyEntry?.highlight_3_label || "横浜・川崎オフィス";

// オフィスフォトギャラリー写真（CMS 'companies' コレクションから動的生成）
let officeGallery: any[] = [];
if (companyEntry) {
	for (let i = 1; i <= 6; i++) {
		const rawImg = companyEntry[`gallery_image_${i}`];
		if (rawImg) {
			let src = "";
			let alt = companyEntry[`gallery_title_${i}`] || `${companyTitle} 写真 ${i}`;
			if (typeof rawImg === "string") {
				try {
					const parsed = JSON.parse(rawImg);
					src = parsed.src || rawImg;
					if (parsed.alt) alt = parsed.alt;
				} catch {
					src = rawImg;
				}
			} else if (typeof rawImg === "object" && rawImg !== null) {
				src = rawImg.src || "";
				if (rawImg.alt) alt = rawImg.alt;
			}
			if (src) {
				const num = String(officeGallery.length + 1).padStart(2, "0");
				officeGallery.push({
					src,
					alt,
					num,
					title: companyEntry[`gallery_title_${i}`] || `ギャラリー ${num}`,
					caption: companyEntry[`gallery_caption_${i}`] || ""
				});
			}
		}
	}
}

// オフィス拠点データ（locations.json準拠）
const offices = [
	{
