---
// src/pages/corporate/nicole-racing-japan.astro
// ニコル・レーシング・ジャパン合同会社 会社案内（Nicole Connect マガジン同等の黒背景エディトリアルデザイン）
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import svgs from "../../data/corporate-svgs.json";

const pageTitle = "ニコル・レーシング・ジャパン合同会社 | グループ中枢・シェアードサービス | Nicole Group 公式";
const pageDescription = "ニコル・グループの創業母体であるニコル・レーシング・ジャパン合同会社の企業情報です。1977年の設立以来、グループ全体の経営資源最適化、シェアードサービス（経理・財務・総務・人事・法務）、マーケティング戦略、IT基盤統括などの中枢機能を担っています。";

// 中枢機能（CORE FUNCTIONS）
const coreFunctions = [
	{
		num: "01",
		title: "シェアードサービス（経営管理統轄）",
		desc: "経理・財務、人事・労務、総務、法務など、グループ各社の管理部門業務を一元的に集約。標準化と高度な専門性により業務効率を最大化し、現場の事業会社がお客様対応に専念できる強固なバックボーンを築きます。"
	},
	{
		num: "02",
		title: "グループ・マーケティング戦略",
		desc: "BMW、MINI、Rolls-Royce、Ferrari、ALPINAといった世界最高峰のブランドを扱うグループ全体の価値向上を牽引。オウンドメディア「Nicole Connect」の運営、デジタルマーケティング、CRM、特別イベントの企画・実行を統括します。"
	},
	{
		num: "03",
		title: "ITインフラ・ガバナンス＆DX推進",
		desc: "高度な情報セキュリティ環境の維持、基幹業務システムの最適化、顧客接点のデジタル化など、次世代のラグジュアリーモビリティ体験を支えるITインフラとコーポレートガバナンス体制を推進・管理しています。"
	}
];

// オフィス拠点データ（locations.json準拠）
const offices = [
	{
		name: "横浜本社オフィス",
		type: "グループ中枢・本社機能",
		postal: "〒220-0012",
		address: "神奈川県横浜市西区みなとみらい4-4-2 横浜ブルーアベニュー13F",
		tel: "045-228-8360",
		fax: "045-228-8361",
		hours: "9:00～18:00",
		closed: "土曜日・日曜日・祝日",
		image: "/uploads/2026/01/ニコルレーシングジャパン合同会社-1024x683.jpg",
		mapUrl: "https://maps.google.com/?q=横浜市西区みなとみらい4-4-2+横浜ブルーアベニュー",
		desc: "みなとみらいエリアに位置するグループの経営企画、マーケティング、IT部門の中枢拠点です。"
	},
	{
		name: "川崎本社オフィス",
		type: "グループ管理統轄・シェアードサービス",
		postal: "〒212-0005",
		address: "神奈川県川崎市幸区戸手2-5-7",
		tel: "044-541-3011",
		fax: "044-541-3036",
		hours: "9:00～18:00",
		closed: "土曜日・日曜日・祝日",
		image: "/uploads/2026/01/Nicole-BMW-本社-1-1024x682.jpg",
		mapUrl: "https://maps.google.com/?q=神奈川県川崎市幸区戸手2-5-7",
		desc: "創業の地である川崎に構えるグループ管理拠点。経理・財務、人事、総務部門が集約されています。"
	}
];

// 関連記事データ
const relatedArticles = [
	{
		title: "BMW / MINI / Rolls-Royce / Ferrari｜認定中古車とは？メリット・保証・点検・選び方について",
		date: "2026.07.06",
		tag: "Nicole Group",
		url: "/posts/202607_nicole_certified-used-cars-guide/",
		img: "/uploads/2026/07/★ALL_Generated_Image_whwtoswhwtoswhwt.jpg"
	},
	{
		title: "愛車の輝きを10年守る。プロテクションフィルムの選び方と「メーカー直結施工」の真価",
		date: "2026.06.25",
		tag: "Service & Bodycare",
		url: "/posts/202606_nicole_protection-film/",
		img: "/uploads/2026/06/DSC8395-e1782193339640.jpg"
	},
	{
		title: "フェラーリスタの心を揺さぶる体験。その世界観を支えるマーケターの視点",
		date: "2026.08.07",
		tag: "Marketing & Strategy",
		url: "/posts/202608_ferrari_marketing/",
		img: "/uploads/2026/02/24_0206_nicol_kohoku_35084_re_web.avif"
	},
	{
		title: "一時代の終幕、ミュンヘンのBMW工場からの旅立ち",
		date: "2026.01.10",
		tag: "ALPINA History",
		url: "/posts/202601_alpina_departure-from-munich/",
		img: "/uploads/2026/02/DSC2802-scaled.avif"
	}
];

// Schema.org 構造化データ（JSON-LD）
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "AboutPage",
			"@id": "https://www.nicole.co.jp/corporate/nicole-racing-japan/#webpage",
			"url": "https://www.nicole.co.jp/corporate/nicole-racing-japan",
			"name": pageTitle,
			"description": pageDescription,
			"breadcrumb": {
				"@id": "https://www.nicole.co.jp/corporate/nicole-racing-japan/#breadcrumb"
			}
		},
		{
			"@type": "BreadcrumbList",
			"@id": "https://www.nicole.co.jp/corporate/nicole-racing-japan/#breadcrumb",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "HOME",
					"item": "https://www.nicole.co.jp/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "会社概要",
					"item": "https://www.nicole.co.jp/corporate"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "ニコル・レーシング・ジャパン合同会社",
					"item": "https://www.nicole.co.jp/corporate/nicole-racing-japan"
				}
			]
		},
		{
			"@type": "Organization",
			"@id": "https://www.nicole.co.jp/corporate/nicole-racing-japan/#organization",
			"name": "ニコル・レーシング・ジャパン合同会社",
			"alternateName": "Nicole Racing Japan LLC",
			"url": "https://www.nicole.co.jp/corporate/nicole-racing-japan",
			"telephone": "045-228-8360",
			"address": {
				"@type": "PostalAddress",
				"postalCode": "220-0012",
				"addressRegion": "神奈川県",
				"addressLocality": "横浜市西区",
				"streetAddress": "みなとみらい4-4-2 横浜ブルーアベニュー13F"
			},
			"parentOrganization": {
				"@type": "Organization",
				"name": "ニコル・グループ",
				"url": "https://www.nicole.co.jp/"
			}
		}
	]
};
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style is:global>
			body:has(.corporate-magazine-main),
			body:has(.corporate-magazine-main) #page,
			body:has(.corporate-magazine-main) #content,
			body:has(.corporate-magazine-main) .site-content,
			body:has(.corporate-magazine-main) #primary,
			body:has(.corporate-magazine-main) .content-area,
			body:has(.corporate-magazine-main) .ast-container {
				background-color: #040507 !important;
				background-image: none !important;
			}
		</style>
	</Fragment>

	<main class="corporate-magazine-main">
		<!-- 1. HERO COVER -->
		<header class="corp-hero">
			<div class="corp-hero__media">
				<img 
					src="/uploads/2026/01/ニコルレーシングジャパン合同会社-scaled.jpg" 
					alt="ニコル・レーシング・ジャパン合同会社 横浜本社オフィス" 
					class="corp-hero__img" 
					loading="eager" 
					decoding="async" 
				/>
				<div class="corp-hero__gradient"></div>
				<div class="corp-hero__side-vignette"></div>
			</div>

			<div class="corp-container corp-hero__inner">
				<nav class="corp-breadcrumbs" aria-label="パンくずリスト">
					<ol class="corp-breadcrumbs__list">
						<li class="corp-breadcrumbs__item"><a href="/" class="corp-breadcrumbs__link">HOME</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item"><a href="/corporate" class="corp-breadcrumbs__link">会社概要</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item" aria-current="page">ニコル・レーシング・ジャパン合同会社</li>
					</ol>
				</nav>

				<div class="corp-hero__logo-wrap">
					<div class="corp-hero__brand-logo" set:html={svgs[0]} />
				</div>

				<h1 class="corp-hero__title">ニコル・レーシング・ジャパン合同会社</h1>
				<p class="corp-hero__subtitle">
					<span class="corp-hero__phrase">1977年設立。ニコル・グループの創業母体であり、グループの事業成長を支える中枢機能。</span><br class="corp-hero__br" />
					<span class="corp-hero__phrase">シェアードサービス機能（経理・財務・総務・人事・法務）と戦略的マーケティングを集約し、</span>
					<span class="corp-hero__phrase">各事業会社がお客様へのサービス提供に専念できる強固な経営支援とシナジー最大化を推進しています。</span>
				</p>

				<!-- ページ内クイックナビゲーション -->
				<nav class="corp-subnav" aria-label="ページ内目次">
					<ul class="corp-subnav__list">
						<li><a href="#about" class="corp-subnav__pill">会社紹介</a></li>
						<li><a href="#functions" class="corp-subnav__pill">中枢機能</a></li>
						<li><a href="#offices" class="corp-subnav__pill">オフィス案内</a></li>
						<li><a href="#articles" class="corp-subnav__pill">関連記事</a></li>
						<li><a href="#profile" class="corp-subnav__pill">会社基本データ</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<!-- 2. 会社紹介（ABOUT & PHILOSOPHY） -->
		<section id="about" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<div class="corp-narrative-grid">
					<!-- 左列: メディアビジュアル -->
					<div class="corp-narrative-visual">
						<div class="corp-narrative-card">
							<img 
								src="/uploads/2026/01/Nicole-BMW-本社-1.jpg" 
								alt="ニコル・グループ 川崎本社オフィス 外観" 
								class="corp-narrative-img" 
								width="1200" 
								height="800" 
								loading="lazy" 
								decoding="async" 
							/>
							<div class="corp-narrative-caption">
								<span class="corp-narrative-caption-title">ニコル・グループ 川崎本社</span>
								<span class="corp-narrative-caption-sub">Nicole Group Head Office</span>
							</div>
						</div>
					</div>

					<!-- 右列: ストーリー本文 -->
					<div class="corp-narrative-content">
						<header class="corp-section-header">
							<h2 class="corp-section-title">グループの経営資源を最適化し、<br />未来の持続的成長を牽引する。</h2>
							<p class="corp-section-lead">1977年の創業以来、グループ各社の自律とシナジーを両立させる中枢基盤</p>
						</header>

						<div class="corp-narrative-body">
							<p>ニコル・レーシング・ジャパン合同会社は、1977年にニコル・グループの創業母体として設立されました。半世紀近い歴史のなかで、モータースポーツへの情熱から始まった事業は、今日では世界最高峰のプレミアム＆ラグジュアリーカーを取り扱う総合モビリティグループへと進化を遂げました。</p>

							<p>当社はグループの中枢として、経理・財務、人事、総務、法務といった管理部門業務を集約するシェアードサービス機能を提供。各事業会社（ニコル・カーズ、ニコル・オートモビルズ、Nicole MotorCars、Nicole Competizione）が、お客様への最高水準の接客とアフターサービスの充実に専念できる体制を構築しています。</p>

							<p>さらに、グループ全体のブランド価値向上を担うマーケティング戦略の立案・実行、ITインフラとコーポレートガバナンスの統轄を担い、グループ全体の持続的成長と価値創造を牽引しています。</p>
						</div>

						<div class="corp-narrative-highlights">
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">1977年</div>
								<div class="corp-highlight-item__label">グループ創業母体</div>
							</div>
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">5社</div>
								<div class="corp-highlight-item__label">グループ事業会社統括</div>
							</div>
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">400名</div>
								<div class="corp-highlight-item__label">グループ従業員支援</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. 中枢機能（CORE FUNCTIONS） -->
		<section id="functions" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">グループ中枢としての3大機能</h2>
					<p class="corp-section-subtitle">専門性に特化した機能集約により、経営効率の向上とブランドシナジーの最大化を両立しています。</p>
				</header>

				<div class="corp-functions-grid">
					{coreFunctions.map((fn) => (
						<article class="corp-function-card">
							<div class="corp-function-card__header">
								<span class="corp-function-card__num">{fn.num}</span>
								<h3 class="corp-function-card__title">{fn.title}</h3>
							</div>
							<p class="corp-function-card__desc">{fn.desc}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- 4. オフィス案内（OFFICES） -->
		<section id="offices" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">オフィスのご案内</h2>
					<p class="corp-section-subtitle">横浜みなとみらいと川崎本社の2拠点においてグループ全体の管理・企画機能を展開しています。</p>
				</header>

				<div class="corp-showrooms-stack">
					{offices.map((ofc) => (
						<div class="corp-showroom-grid">
							<div class="corp-showroom-visual">
								<div class="corp-showroom-photo-wrap">
									<img 
										src={ofc.image} 
										alt={`${ofc.name} 外観写真`} 
										class="corp-showroom-photo" 
										loading="lazy" 
										decoding="async" 
									/>
									<div class="corp-showroom-photo-badge">{ofc.type}</div>
								</div>
							</div>

							<div class="corp-showroom-info">
								<header class="corp-showroom-header">
									<div>
										<span class="corp-showroom-type">{ofc.type}</span>
										<h3 class="corp-showroom-name">{ofc.name}</h3>
									</div>
								</header>

								<p class="corp-showroom-desc">{ofc.desc}</p>

								<dl class="corp-showroom-details">
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">所在地</dt>
										<dd class="corp-showroom-dd">
											{ofc.postal} {ofc.address}
											<a href={ofc.mapUrl} target="_blank" rel="noopener noreferrer" class="corp-map-link">Google Mapsで開く</a>
										</dd>
									</div>
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">電話番号</dt>
										<dd class="corp-showroom-dd">
											<a href={`tel:${ofc.tel.replace(/-/g, '')}`} class="corp-tel-link">{ofc.tel}</a>
											{ofc.fax && <span class="corp-fax">（FAX: {ofc.fax}）</span>}
										</dd>
									</div>
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">営業時間</dt>
										<dd class="corp-showroom-dd">{ofc.hours}</dd>
									</div>
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">定休日</dt>
										<dd class="corp-showroom-dd">{ofc.closed}</dd>
									</div>
								</dl>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 5. 関連記事（RELATED ARTICLES） -->
		<section id="articles" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">関連記事</h2>
					<p class="corp-section-subtitle">オウンドメディア「Nicole Connect」より、ニコル・グループの活動やカルチャーに関する特集記事をお届けします。</p>
				</header>

				<div class="corp-articles-grid">
					{relatedArticles.map((art) => (
						<a href={art.url} class="corp-article-card">
							<div class="corp-article-card__thumb-wrap">
								<img 
									src={art.img} 
									alt={art.title} 
									class="corp-article-card__thumb" 
									loading="lazy" 
									decoding="async" 
								/>
								<span class="corp-article-card__tag">{art.tag}</span>
							</div>
							<div class="corp-article-card__content">
								<time class="corp-article-card__date">{art.date}</time>
								<h3 class="corp-article-card__title">{art.title}</h3>
							</div>
						</a>
					))}
				</div>
			</div>
		</section>

		<!-- 6. 会社基本データ -->
		<section id="profile" class="corp-section">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">会社基本データ</h2>
					<p class="corp-section-subtitle">ニコル・レーシング・ジャパン合同会社の企業概要データです。</p>
				</header>

				<div class="corp-profile-card">
					<table class="corp-profile-table">
						<tbody>
							<tr>
								<th scope="row">会社名</th>
								<td>ニコル・レーシング・ジャパン合同会社（Nicole Racing Japan LLC）</td>
							</tr>
							<tr>
								<th scope="row">設立</th>
								<td>1977年3月（グループ創業母体）</td>
							</tr>
							<tr>
								<th scope="row">代表者</th>
								<td>代表職務執行者 社長 ミヒャエル・ヴィット（Michael Witt）</td>
							</tr>
							<tr>
								<th scope="row">本社所在地</th>
								<td>
									<strong>横浜本社オフィス：</strong><br />
									〒220-0012 神奈川県横浜市西区みなとみらい4-4-2 横浜ブルーアベニュー13F<br />
									TEL：045-228-8360（代表） / FAX：045-228-8361<br /><br />
									<strong>川崎本社オフィス：</strong><br />
									〒212-0005 神奈川県川崎市幸区戸手2-5-7<br />
									TEL：044-541-3011（代表） / FAX：044-541-3036
								</td>
							</tr>
							<tr>
								<th scope="row">事業内容</th>
								<td>
									<ul class="corp-business-list">
										<li>ニコル・グループ各社の経営企画・事業統轄</li>
										<li>シェアードサービス業務（経理、財務、総務、人事、労務、法務等の管理部門機能の集約・受託）</li>
										<li>グループ全体のブランディングおよびマーケティング戦略の立案・実行</li>
										<li>オウンドメディア「Nicole Connect」の企画・運営</li>
										<li>ITシステムインフラの企画・構築・運用およびデジタルトランスフォーメーション（DX）推進</li>
										<li>損害保険・生命保険代理店業務</li>
									</ul>
								</td>
							</tr>
							<tr>
								<th scope="row">統括事業会社</th>
								<td>
