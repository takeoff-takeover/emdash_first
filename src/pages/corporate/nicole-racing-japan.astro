		type: "グループ中枢・本社機能",
		postal: "〒220-0012",
		address: "神奈川県横浜市西区みなとみらい4-4-2 横浜ブルーアベニュー13F",
		tel: "045-228-8360",
		fax: "045-228-8361",
		hours: "9:00～18:00",
		closed: "土曜日・日曜日・祝日",
		image: "/uploads/2026/01/ニコルレーシングジャパン合同会社-1024x683.jpg",
		mapUrl: "https://maps.google.com/?q=横浜市西区みなとみらい4-4-2+横浜ブルーアベニュー",
		desc: "みなとみらいエリアに位置するグループの経営企画、マーケティング、IT部門の中枢拠点です。"
	},
	{
		name: "川崎本社オフィス",
		type: "グループ管理統轄・シェアードサービス",
		postal: "〒212-0005",
		address: "神奈川県川崎市幸区戸手2-5-7",
		tel: "044-541-3011",
		fax: "044-541-3036",
		hours: "9:00～18:00",
		closed: "土曜日・日曜日・祝日",
		image: "/uploads/2026/01/Nicole-BMW-本社-1-1024x682.jpg",
		mapUrl: "https://maps.google.com/?q=神奈川県川崎市幸区戸手2-5-7",
		desc: "創業の地である川崎に構えるグループ管理拠点。経理・財務、人事、総務部門が集約されています。"
	}
];

// CMS 'locations' コレクションからオフィス拠点を動的取得
let facilities = offices;
try {
	const locResult = await getEmDashCollection("locations" as any, { limit: 50 });
	if (locResult?.entries && locResult.entries.length > 0) {
		facilities = facilities.map(ofc => {
			const found = locResult.entries.find((e: any) => {
				const slug = (e.id || e.slug || "").toLowerCase();
				const title = ((e.data?.title || e.title || "")).toLowerCase();
				return (slug.includes("yokohama") || slug.includes("office-yokohama")) && ofc.name.includes("横浜") ||
				       (slug.includes("kawasaki") || slug.includes("office-kawasaki")) && ofc.name.includes("川崎");
			});
			if (!found) return ofc;
			const d = found.data || found;
			let imgSrc = ofc.image;
			if (d.featured_image) {
				const feat = typeof d.featured_image === "string" ? (() => { try { return JSON.parse(d.featured_image); } catch { return d.featured_image; } })() : d.featured_image;
				if (feat?.src) imgSrc = feat.src;
				else if (typeof feat === "string" && feat.trim()) imgSrc = feat.trim();
			}
			return {
				...ofc,
				name: d.title || ofc.name,
				postal: d.postal || ofc.postal,
				address: d.address || ofc.address,
				tel: d.sales_tel || d.tel || ofc.tel,
				fax: d.sales_fax || d.fax || ofc.fax,
				hours: d.sales_hours || ofc.hours,
				closed: d.sales_closed || ofc.closed,
				image: imgSrc,
				mapUrl: d.google_maps_url || ofc.mapUrl,
				desc: d.sales_desc || d.concept_text || ofc.desc
			};
		});
	}
} catch (e) {}

// 会社基本データ
const companyNameEn = companyEntry?.name_en || "Nicole Racing Japan LLC";
const established = companyEntry?.established || "1977年3月（グループ創業母体）";
const representative = companyEntry?.representative || "代表職務執行者 社長 ミヒャエル・ヴィット（Michael Witt）";
const postal = companyEntry?.postal || facilities[0]?.postal || "〒220-0012";
const address = companyEntry?.address || facilities[0]?.address || "神奈川県横浜市西区みなとみらい4-4-2 横浜ブルーアベニュー13F";
const tel = companyEntry?.tel || (facilities[0]?.tel ? `${facilities[0].tel}（代表） / FAX：${facilities[0].fax || '045-228-8361'}` : "045-228-8360（代表） / FAX：045-228-8361");
const telDisplay = tel.startsWith("TEL") ? tel : `TEL：${tel}`;
const businessList = companyEntry?.business_desc
	? companyEntry.business_desc.split("\n").filter(Boolean)
	: [
		"ニコル・グループ各社の経営企画・事業統轄",
		"シェアードサービス業務（経理、財務、総務、人事、労務、法務等の管理部門機能の集約・受託）",
		"グループ全体のブランディングおよびマーケティング戦略の立案・実行",
		"オウンドメディア「Nicole Connect」の企画・運営",
		"ITシステムインフラの企画・構築・運用およびデジタルトランスフォーメーション（DX）推進",
		"損害保険・生命保険代理店業務"
	];





// 記事カテゴリー判定ヘルパー（マガジン「Nicole Connect」と完全共通）
function determineArticleCategory(p: any): string {
	const slug = (p.slug || p.id || "").toLowerCase();
	const title = (p.title || p.data?.title || "").toLowerCase();
	const topic = (p.topic || "").toLowerCase();

	if (slug.includes("campaign") || slug.includes("fair") || slug.includes("debut") || title.includes("フェア") || title.includes("キャンペーン")) {
		return "Campaign";
	}
	if (slug.includes("guide") || slug.includes("buyer") || title.includes("ガイド") || title.includes("選び方") || title.includes("購入") || topic === "guide") {
		return "Buyer's Guide";
	}
	const esgKeywords = [
		"tamagawa", "cleanup", "japanesenight", "inspire_hub", "traffic-safety",
		"food-for-community", "sustainable", "emergency", "kids-mechanic", "haruhinofes",
		"norimonofes", "sdgs", "summerconference", "esg", "美化活動", "クリーンアップ", "交通安全", "防災", "寄付"
	];
	if (esgKeywords.some(kw => slug.includes(kw) || title.includes(kw)) || topic.includes("esg") || topic.includes("sdgs")) {
		return "ESG";
	}
	const peopleKeywords = [
		"people", "interview", "staff", "mechanic", "craft", "職人", "社員", "インタビュー",
		"ストーリー", "story", "マイスター", "junior_high", "work-experience", "international-employee",
		"fire-department", "mochitsuki", "餅つき", "交流会", "感謝状", "職場体験", "alpina-heritage", "rolls-royce-bespoke"
	];
	if (peopleKeywords.some(kw => slug.includes(kw) || title.includes(kw)) || topic === "people") {
		return "People";
	}
	return "Cars";
}

// マガジンコレクションからグループ・カルチャー・企業最新記事を動的取得
let relatedArticles: Array<{
	title: string;
	date: string;
	category: string;
	brand: string;
	url: string;
	img: string;
}> = [];

try {
	const magResult = await getEmDashCollection("magazine" as any, {
		orderBy: { published_at: "desc" },
		limit: 100,
	});
	if (magResult?.entries && magResult.entries.length > 0) {
		const filtered = magResult.entries.filter((entry: any) => {
			const slug = (entry.id || entry.slug || "").toLowerCase();
			const title = (entry.data?.title || entry.title || "").toLowerCase();
			return slug.includes("nicole") || slug.includes("welcome") || slug.includes("award") || title.includes("ニコル") || title.includes("グループ") || title.includes("認定中古車");
		});

		const selectedEntries = (filtered.length >= 4 ? filtered : magResult.entries).slice(0, 4);
		const entryIds = selectedEntries.map((e: any) => e.data?.id || e.id).filter(Boolean);

		let categoryTermsByEntry = new Map<string, any[]>();
		try {
			if (entryIds.length > 0) {
				categoryTermsByEntry = await getTermsForEntries("magazine", entryIds, "category");
			}
		} catch (e) {}

		relatedArticles = selectedEntries.map((entry: any) => {
			const slug = entry.id || entry.slug;
			const title = entry.data?.title || entry.title || "Nicole Group 特集記事";
			const entryDbId = entry.data?.id || entry.id;
			const publishedAt = new Date(entry.data?.publishedAt ?? entry.data?.createdAt ?? entry.published_at ?? 0).getTime() || 0;
			const dateStr = publishedAt 
				? new Date(publishedAt).toLocaleDateString("sv-SE", { timeZone: "Asia/Tokyo" }).replace(/-/g, ".")
				: "2026.07.06";
			
			let imgPath = entry.data?.featured_image?.src || entry.featured_image?.src || "/uploads/2026/07/★ALL_Generated_Image_whwtoswhwtoswhwt.jpg";
			if (imgPath.includes("nicole.co.jp/wp/wp-content")) {
				imgPath = imgPath.replace(/https?:\/\/[^\/]+\/wp\/wp-content/, "/uploads/wp");
			}

			const assignedCategories = (categoryTermsByEntry.get(entryDbId) || []).map((term: any) => term.label).filter(Boolean);
			const inferredCat = determineArticleCategory({ slug, title, topic: entry.data?.topic || entry.topic });
			const category = assignedCategories.length > 0 ? assignedCategories[0] : inferredCat;

			return {
				title,
				date: dateStr,
				category,
				brand: "Nicole Group",
				url: `/magazine/${slug}/`,
				img: imgPath
			};
		});
	}
} catch (e) {}

// フォールバック（グループ厳選4記事・実在画像保証）
if (relatedArticles.length === 0) {
	relatedArticles = [
		{
			title: "BMW / MINI / Rolls-Royce / Ferrari｜認定中古車とは？メリット・保証・点検・選び方について",
			date: "2026.07.06",
			category: "Buyer's Guide",
			brand: "Nicole Group",
			url: "/magazine/202607_nicole_certified-used-cars-guide/",
			img: "/uploads/2026/07/★ALL_Generated_Image_whwtoswhwtoswhwt.jpg"
		},
		{
			title: "愛車の輝きを10年守る。プロテクションフィルムの選び方と「メーカー直結施工」の真価",
			date: "2026.06.25",
			category: "Cars",
			brand: "Nicole Group",
			url: "/magazine/202606_nicole_protection-film/",
			img: "/uploads/2026/06/DSC8395-e1782193339640.jpg"
		},
		{
			title: "Webマガジン 「Nicole Connect」へようこそ",
			date: "2026.03.01",
			category: "People",
			brand: "Nicole Group",
			url: "/magazine/202603_welcome_nicoleconnect/",
			img: "/uploads/2026/02/DSC8585-scaled.avif"
		},
		{
			title: "ニコル・グループが「ウルトラ・ラグジュアリー・パフォーマンス・アワード」を受賞",
			date: "2026.07.20",
			category: "Cars",
			brand: "Nicole Group",
			url: "/magazine/202607_ultra_luxury_performance_award/",
			img: "/uploads/2026/02/DSC2390-scaled-e1772189662282.avif"
		}
	];
}

// Schema.org 構造化データ（JSON-LD）
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "AboutPage",
			"@id": "https://www.nicole.co.jp/corporate/nicole-racing-japan/#webpage",
			"url": "https://www.nicole.co.jp/corporate/nicole-racing-japan",
			"name": pageTitle,
			"description": pageDescription,
			"breadcrumb": {
				"@id": "https://www.nicole.co.jp/corporate/nicole-racing-japan/#breadcrumb"
			}
		},
		{
			"@type": "BreadcrumbList",
			"@id": "https://www.nicole.co.jp/corporate/nicole-racing-japan/#breadcrumb",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "HOME",
					"item": "https://www.nicole.co.jp/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "会社概要",
					"item": "https://www.nicole.co.jp/corporate"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "ニコル・レーシング・ジャパン合同会社",
					"item": "https://www.nicole.co.jp/corporate/nicole-racing-japan"
				}
			]
		},
		{
			"@type": "Organization",
			"@id": "https://www.nicole.co.jp/corporate/nicole-racing-japan/#organization",
			"name": "ニコル・レーシング・ジャパン合同会社",
			"alternateName": "Nicole Racing Japan LLC",
			"url": "https://www.nicole.co.jp/corporate/nicole-racing-japan",
			"telephone": "045-228-8360",
			"address": {
				"@type": "PostalAddress",
				"postalCode": "220-0012",
				"addressRegion": "神奈川県",
				"addressLocality": "横浜市西区",
				"streetAddress": "みなとみらい4-4-2 横浜ブルーアベニュー13F"
			},
			"parentOrganization": {
				"@type": "Organization",
				"name": "ニコル・グループ",
				"url": "https://www.nicole.co.jp/"
			}
		}
	]
};
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		
	</Fragment>

	<main class="corporate-magazine-main">
		<!-- 1. HERO COVER -->
		<header class="corp-hero">
			<div class="corp-hero__media">
				<img 
					src={heroImageSrc} 
					alt="ニコル・レーシング・ジャパン合同会社 横浜本社オフィス" 
					class="corp-hero__img" 
					loading="eager" 
					decoding="async" 
				/>
				<div class="corp-hero__gradient"></div>
				<div class="corp-hero__side-vignette"></div>
			</div>

			<div class="corp-container corp-hero__inner">
				<nav class="corp-breadcrumbs" aria-label="パンくずリスト">
					<ol class="corp-breadcrumbs__list">
						<li class="corp-breadcrumbs__item"><a href="/" class="corp-breadcrumbs__link">HOME</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item"><a href="/corporate" class="corp-breadcrumbs__link">会社概要</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item" aria-current="page">ニコル・レーシング・ジャパン合同会社</li>
					</ol>
				</nav>

				<h1 class="corp-hero__title">{companyTitle}</h1>
				<p class="corp-hero__subtitle">
					{heroPhrase.split("。").filter(Boolean).map((phrase: string) => (
						<span class="corp-hero__phrase">{phrase}。</span>
					))}
				</p>

				<!-- ページ内クイックナビゲーション -->
				<nav class="corp-subnav" aria-label="ページ内目次">
					<ul class="corp-subnav__list">
						<li><a href="#about" class="corp-subnav__pill">会社紹介</a></li>
						{parsedContent.length > 0 && <li><a href="#additional-content" class="corp-subnav__pill">詳細情報</a></li>}
						<li><a href="#offices" class="corp-subnav__pill">オフィス案内</a></li>
						<li><a href="#profile" class="corp-subnav__pill">会社基本データ</a></li>
						{officeGallery.length > 0 && <li><a href="#gallery" class="corp-subnav__pill">ギャラリー</a></li>}
						<li><a href="#articles" class="corp-subnav__pill">関連記事</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<!-- 2. 会社紹介（ABOUT & PHILOSOPHY） -->
		<section id="about" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<div class="corp-narrative-grid">
					<!-- 左列: メディアビジュアル -->
					<div class="corp-narrative-visual">
						<div class="corp-narrative-card">
							<img 
								src={aboutImageSrc} 
								alt={aboutImageCaption} 
								class="corp-narrative-img" 
								width="1024" 
								height="683" 
								loading="lazy" 
								decoding="async" 
							/>
						</div>
					</div>

					<!-- 右列: ストーリー本文 -->
					<div class="corp-narrative-content">
						<header class="corp-section-header">
