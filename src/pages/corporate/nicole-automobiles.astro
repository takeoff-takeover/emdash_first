		postal: "〒107-0052",
		address: "東京都港区赤坂7-1-15",
		tel: "03-3478-3511",
		fax: "03-3478-1343",
		hours: "10:00～18:00",
		closed: "火曜日・水曜日",
		image: "/uploads/2026/02/青山ショールーム202603.jpg",
		mapUrl: "https://maps.app.goo.gl/YjNHp4AiNNcgfc4V9",
		desc: "港区赤坂・青山通りに面したフラッグシップショールーム。BMW ALPINA各モデルの展示を行っています。"
	},
	{
		name: "ニコル世田谷ショールーム",
		type: "ショールーム",
		postal: "〒158-0091",
		address: "東京都世田谷区中町1-1-1",
		tel: "03-5758-2500",
		fax: "03-5758-2525",
		hours: "10:00～18:00",
		closed: "火曜日・水曜日",
		image: "/uploads/2026/02/世田谷ショールーム2026.jpg",
		mapUrl: "https://maps.app.goo.gl/6zBR2V99Vz5WFdin9",
		desc: "世田谷区中町に位置するショールーム。BMW ALPINAの認定中古車やアフターサービスのご相談を承ります。"
	}
];

// CMS 'locations' コレクションからALPINAショールーム拠点を動的取得
let facilities = showrooms;
try {
	const locResult = await getEmDashCollection("locations" as any, { limit: 50 });
	if (locResult?.entries && locResult.entries.length > 0) {
		facilities = facilities.map(sh => {
			const found = locResult.entries.find((e: any) => {
				const slug = (e.id || e.slug || "").toLowerCase();
				const title = ((e.data?.title || e.title || "")).toLowerCase();
				return slug.includes("setagaya") && sh.name.includes("世田谷") || slug.includes("aoyama") && sh.name.includes("青山");
			});
			if (!found) return sh;
			const d = found.data || found;
			let imgSrc = sh.image;
			if (d.featured_image) {
				const feat = typeof d.featured_image === "string" ? (() => { try { return JSON.parse(d.featured_image); } catch { return d.featured_image; } })() : d.featured_image;
				if (feat?.src) imgSrc = feat.src;
				else if (typeof feat === "string" && feat.trim()) imgSrc = feat.trim();
			}
			return {
				...sh,
				name: d.title || sh.name,
				postal: d.postal || sh.postal,
				address: d.address || sh.address,
				tel: d.sales_tel || d.tel || sh.tel,
				fax: d.sales_fax || d.fax || sh.fax,
				hours: d.sales_hours || sh.hours,
				closed: d.sales_closed || sh.closed,
				image: imgSrc,
				mapUrl: d.google_maps_url || sh.mapUrl,
				desc: d.sales_desc || d.concept_text || sh.desc
			};
		});
	}
} catch (e) {}

// 会社基本データ
const companyNameEn = companyEntry?.name_en || "Nicole Automobiles LLC";
const established = companyEntry?.established || "1982年";
const representative = companyEntry?.representative || "代表職務執行者 社長 ミヒャエル・ヴィット（Michael Witt）";
const postal = companyEntry?.postal || facilities[0]?.postal || "〒107-0052";
const address = companyEntry?.address || facilities[0]?.address || "東京都港区赤坂7-1-15";
const tel = companyEntry?.tel || (facilities[0]?.tel ? `${facilities[0].tel}（代表） / FAX：${facilities[0].fax || '03-3478-1343'}` : "03-3478-3511（代表） / FAX：03-3478-1343");
const telDisplay = tel.startsWith("TEL") ? tel : `TEL：${tel}`;
const businessList = companyEntry?.business_desc
	? companyEntry.business_desc.split("\n").filter(Boolean)
	: [
		"BMW ALPINA 在庫車および認定中古車の販売・査定・買取",
		"BMW ALPINA アフターサービス・車検・法定点検・整備修理",
		"BMW ALPINA 純正部品・アクセサリー・公式グッズ販売",
		"公式オンラインショップ（nicole-automobiles.shop）の運営",
		"自動車保険代理店業務"
	];




// 記事カテゴリー判定ヘルパー（マガジン「Nicole Connect」と完全共通）
function determineArticleCategory(p: any): string {
	const slug = (p.slug || p.id || "").toLowerCase();
	const title = (p.title || p.data?.title || "").toLowerCase();
	const topic = (p.topic || "").toLowerCase();

	if (slug.includes("campaign") || slug.includes("fair") || slug.includes("debut") || title.includes("フェア") || title.includes("キャンペーン")) {
		return "Campaign";
	}
	if (slug.includes("guide") || slug.includes("buyer") || title.includes("ガイド") || title.includes("選び方") || title.includes("購入") || topic === "guide") {
		return "Buyer's Guide";
	}
	const esgKeywords = [
		"tamagawa", "cleanup", "japanesenight", "inspire_hub", "traffic-safety",
		"food-for-community", "sustainable", "emergency", "kids-mechanic", "haruhinofes",
		"norimonofes", "sdgs", "summerconference", "esg", "美化活動", "クリーンアップ", "交通安全", "防災", "寄付"
	];
	if (esgKeywords.some(kw => slug.includes(kw) || title.includes(kw)) || topic.includes("esg") || topic.includes("sdgs")) {
		return "ESG";
	}
	const peopleKeywords = [
		"people", "interview", "staff", "mechanic", "craft", "職人", "社員", "インタビュー",
		"ストーリー", "story", "マイスター", "junior_high", "work-experience", "international-employee",
		"fire-department", "mochitsuki", "餅つき", "交流会", "感謝状", "職場体験", "alpina-heritage", "rolls-royce-bespoke"
	];
	if (peopleKeywords.some(kw => slug.includes(kw) || title.includes(kw)) || topic === "people") {
		return "People";
	}
	return "Cars";
}

// マガジンコレクションからALPINA関連最新記事を動的取得
let relatedArticles: Array<{
	title: string;
	date: string;
	category: string;
	brand: string;
	url: string;
	img: string;
}> = [];

try {
	const magResult = await getEmDashCollection("magazine" as any, {
		orderBy: { published_at: "desc" },
		limit: 100,
	});
	if (magResult?.entries && magResult.entries.length > 0) {
		const filtered = magResult.entries.filter((entry: any) => {
			const slug = (entry.id || entry.slug || "").toLowerCase();
			const title = (entry.data?.title || entry.title || "").toLowerCase();
			return slug.includes("alpina") || title.includes("alpina") || title.includes("アルピナ") || slug.includes("buchloe");
		});

		const selectedEntries = filtered.slice(0, 4);
		const entryIds = selectedEntries.map((e: any) => e.data?.id || e.id).filter(Boolean);

		let categoryTermsByEntry = new Map<string, any[]>();
		try {
			if (entryIds.length > 0) {
				categoryTermsByEntry = await getTermsForEntries("magazine", entryIds, "category");
			}
		} catch (e) {}

		relatedArticles = selectedEntries.map((entry: any) => {
			const slug = entry.id || entry.slug;
			const title = entry.data?.title || entry.title || "ALPINA特集記事";
			const entryDbId = entry.data?.id || entry.id;
			const publishedAt = new Date(entry.data?.publishedAt ?? entry.data?.createdAt ?? entry.published_at ?? 0).getTime() || 0;
			const dateStr = publishedAt 
				? new Date(publishedAt).toLocaleDateString("sv-SE", { timeZone: "Asia/Tokyo" }).replace(/-/g, ".")
				: "2026.03.15";
			
			let imgPath = entry.data?.featured_image?.src || entry.featured_image?.src || "/uploads/2026/02/DSC8585-scaled.avif";
			if (imgPath.includes("nicole.co.jp/wp/wp-content")) {
				imgPath = imgPath.replace(/https?:\/\/[^\/]+\/wp\/wp-content/, "/uploads/wp");
			}

			const assignedCategories = (categoryTermsByEntry.get(entryDbId) || []).map((term: any) => term.label).filter(Boolean);
			const inferredCat = determineArticleCategory({ slug, title, topic: entry.data?.topic || entry.topic });
			const category = assignedCategories.length > 0 ? assignedCategories[0] : inferredCat;

			return {
				title,
				date: dateStr,
				category,
				brand: "ALPINA",
				url: `/magazine/${slug}/`,
				img: imgPath
			};
		});
	}
} catch (e) {}

// フォールバック（ALPINA厳選4記事・実在画像保証）
if (relatedArticles.length === 0) {
	relatedArticles = [
		{
