---
// src/pages/corporate/nicole-automobiles.astro
// ニコル・オートモビルズ合同会社 会社案内（Nicole Connect マガジン同等の黒背景エディトリアルデザイン）
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import svgs from "../../data/corporate-svgs.json";

const pageTitle = "ニコル・オートモビルズ合同会社 | ALPINA | Nicole Group 公式";
const pageDescription = "BMW ALPINAの日本総輸入元として46年の歴史を紡いできたニコル・オートモビルズ合同会社の企業情報です。2026年以降も在庫車・認定中古車および正規アフターサービスを提供。ニコル世田谷ショールーム、ニコル青山ショールームの拠点情報をご案内します。";

// ショールームフォトギャラリー写真（Gallery format rule準拠: シンプルな番号と説明のみ）
const showroomGallery = [
	{
		src: "/uploads/2026/02/DSC8585-scaled.avif",
		alt: "BMW ALPINA ブルー & デコライン エクステリア",
		num: "01",
		caption: "アルピナ ブルーと伝統のデコラインが放つ唯一無二のエクステリア"
	},
	{
		src: "/uploads/2026/02/DSC2802-scaled.avif",
		alt: "BMW ALPINA ラヴァリナ・レザー インテリア",
		num: "02",
		caption: "熟練職人の手縫いによる極上のラヴァリナ・レザーインテリア"
	},
	{
		src: "/uploads/2026/02/DSC5967-scaled.avif",
		alt: "BMW ALPINA クラシック・マルチスポークホイール",
		num: "03",
		caption: "軽量性と美しさを極限まで追求した伝統のクラシックホイール"
	},
	{
		src: "/uploads/2026/03/DSC3293-scaled.avif",
		alt: "ニコル青山ショールーム 展示スペース",
		num: "04",
		caption: "落ち着いた洗練の空間で名車と向き合う青山ショールーム"
	}
];

// ショールーム拠点データ
const showrooms = [
	{
		name: "ニコル青山ショールーム",
		type: "ショールーム",
		postal: "〒107-0052",
		address: "東京都港区赤坂7-1-15",
		tel: "03-3478-3511",
		fax: "03-3478-1343",
		hours: "10:00～18:00",
		closed: "火曜日・水曜日",
		image: "/uploads/2026/02/青山ショールーム202603.jpg",
		mapUrl: "https://maps.app.goo.gl/YjNHp4AiNNcgfc4V9"
	},
	{
		name: "ニコル世田谷ショールーム",
		type: "ショールーム",
		postal: "〒158-0091",
		address: "東京都世田谷区中町1-1-1",
		tel: "03-5758-2500",
		fax: "03-5758-2525",
		hours: "10:00～18:00",
		closed: "火曜日・水曜日",
		image: "/uploads/2026/02/世田谷ショールーム2026.jpg",
		mapUrl: "https://maps.app.goo.gl/6zBR2V99Vz5WFdin9"
	}
];

// 関連記事データ
const relatedArticles = [
	{
		title: "ブッフローエが日本に託した、最後の傑作",
		date: "2026.01.20",
		tag: "ALPINA Heritage",
		url: "/posts/202601_alpina_buchloe-masterpiece/",
		img: "/uploads/2026/02/DSC8585-scaled.avif"
	},
	{
		title: "一時代の終幕、ミュンヘンのBMW工場からの旅立ち",
		date: "2026.01.10",
		tag: "ALPINA History",
		url: "/posts/202601_alpina_departure-from-munich/",
		img: "/uploads/2026/02/DSC2802-scaled.avif"
	},
	{
		title: "愛車の輝きを10年守る。プロテクションフィルムの選び方と「メーカー直結施工」の真価",
		date: "2026.06.25",
		tag: "Service & Bodycare",
		url: "/posts/202606_nicole_protection-film/",
		img: "/uploads/2026/06/DSC8395-e1782193339640.jpg"
	},
	{
		title: "BMW / MINI / Rolls-Royce / Ferrari｜認定中古車とは？メリット・保証・点検・選び方について",
		date: "2026.07.06",
		tag: "Certified Pre-Owned",
		url: "/posts/202607_nicole_certified-used-cars-guide/",
		img: "/uploads/2026/07/★ALL_Generated_Image_whwtoswhwtoswhwt.jpg"
	}
];

// Schema.org 構造化データ（JSON-LD）
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "AboutPage",
			"@id": "https://www.nicole.co.jp/corporate/nicole-automobiles/#webpage",
			"url": "https://www.nicole.co.jp/corporate/nicole-automobiles",
			"name": pageTitle,
			"description": pageDescription,
			"breadcrumb": {
				"@id": "https://www.nicole.co.jp/corporate/nicole-automobiles/#breadcrumb"
			}
		},
		{
			"@type": "BreadcrumbList",
			"@id": "https://www.nicole.co.jp/corporate/nicole-automobiles/#breadcrumb",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "HOME",
					"item": "https://www.nicole.co.jp/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "会社概要",
					"item": "https://www.nicole.co.jp/corporate"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "ニコル・オートモビルズ合同会社",
					"item": "https://www.nicole.co.jp/corporate/nicole-automobiles"
				}
			]
		},
		{
			"@type": "AutoDealer",
			"@id": "https://www.nicole.co.jp/corporate/nicole-automobiles/#organization",
			"name": "ニコル・オートモビルズ合同会社",
			"alternateName": "Nicole Automobiles LLC",
			"url": "https://www.nicole.co.jp/corporate/nicole-automobiles",
			"telephone": "03-3478-3511",
			"address": {
				"@type": "PostalAddress",
				"postalCode": "107-0052",
				"addressRegion": "東京都",
				"addressLocality": "港区赤坂",
				"streetAddress": "7-1-15"
			},
			"parentOrganization": {
				"@type": "Organization",
				"name": "ニコル・グループ",
				"url": "https://www.nicole.co.jp/"
			}
		}
	]
};
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style is:global>
			body:has(.corporate-magazine-main),
			body:has(.corporate-magazine-main) #page,
			body:has(.corporate-magazine-main) #content,
			body:has(.corporate-magazine-main) .site-content,
			body:has(.corporate-magazine-main) #primary,
			body:has(.corporate-magazine-main) .content-area,
			body:has(.corporate-magazine-main) .ast-container {
				background-color: #040507 !important;
				background-image: none !important;
			}
		</style>
	</Fragment>

	<main class="corporate-magazine-main">
		<!-- 1. HERO COVER -->
		<header class="corp-hero">
			<div class="corp-hero__media">
				<img 
					src="/uploads/2026/02/DSC8585-scaled.avif" 
					alt="ニコル・オートモビルズ合同会社 BMW ALPINA" 
					class="corp-hero__img" 
					loading="eager" 
					decoding="async" 
				/>
				<div class="corp-hero__gradient"></div>
				<div class="corp-hero__side-vignette"></div>
			</div>

			<div class="corp-container corp-hero__inner">
				<nav class="corp-breadcrumbs" aria-label="パンくずリスト">
					<ol class="corp-breadcrumbs__list">
						<li class="corp-breadcrumbs__item"><a href="/" class="corp-breadcrumbs__link">HOME</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item"><a href="/corporate" class="corp-breadcrumbs__link">会社概要</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item" aria-current="page">ニコル・オートモビルズ合同会社</li>
					</ol>
				</nav>

				<div class="corp-hero__logo-wrap">
					<div class="corp-hero__brand-logo" set:html={svgs[1]} />
				</div>

				<h1 class="corp-hero__title">ニコル・オートモビルズ合同会社</h1>
				<p class="corp-hero__subtitle">
					<span class="corp-hero__phrase">独国アルピナ社（BMW ALPINA）日本総代理店として46年。</span>
					<span class="corp-hero__phrase">8,000台を超える特別な名車を日本のお客様へお届けしてまいりました。</span><br class="corp-hero__br" />
					<span class="corp-hero__phrase">2026年以降も在庫車・認定中古車の販売と正規アフターサービスを通じて、</span>
					<span class="corp-hero__phrase">孤高のクラフトマンシップと唯一無二の走りの世界をお支えします。</span>
				</p>

				<!-- ページ内クイックナビゲーション -->
				<nav class="corp-subnav" aria-label="ページ内目次">
					<ul class="corp-subnav__list">
						<li><a href="#about" class="corp-subnav__pill">会社紹介</a></li>
						<li><a href="#showrooms" class="corp-subnav__pill">ショールーム案内</a></li>
						<li><a href="#gallery" class="corp-subnav__pill">ギャラリー</a></li>
						<li><a href="#articles" class="corp-subnav__pill">関連記事</a></li>
						<li><a href="#profile" class="corp-subnav__pill">会社基本データ</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<!-- 2. 会社紹介（ABOUT & PHILOSOPHY） -->
		<section id="about" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<div class="corp-narrative-grid">
					<!-- 左列: メディアビジュアル -->
					<div class="corp-narrative-visual">
						<div class="corp-narrative-card">
							<img 
								src="/uploads/2026/02/DSC2802-scaled.avif" 
								alt="BMW ALPINA 職人によるハンドクラフト・インテリア" 
								class="corp-narrative-img" 
								width="1200" 
								height="800" 
								loading="lazy" 
								decoding="async" 
							/>
							<div class="corp-narrative-caption">
								<span class="corp-narrative-caption-title">BMW ALPINA クラフトマンシップ</span>
								<span class="corp-narrative-caption-sub">Nicole Automobiles Collection</span>
							</div>
						</div>
					</div>

					<!-- 右列: ストーリー本文 -->
					<div class="corp-narrative-content">
						<header class="corp-section-header">
							<h2 class="corp-section-title">46年の歴史が紡ぐ、<br />孤高のクラフトマンシップと信頼。</h2>
							<p class="corp-section-lead">日本総代理店として8,000台におよぶ名車を日本のお客様にお届けしてきた誇り</p>
						</header>

						<div class="corp-narrative-body">
							<p>ニコル・オートモビルズ合同会社は、独国アルピナ社（BMW ALPINA）の日本総代理店として、1982年の会社設立以来、46年の長きにわたり8,000台におよぶ名車を日本の選ばれたお客様にお届けしてまいりました。</p>

							<p>2025年12月31日のアルピナ社によるBMW社への商標譲渡完了を経て、2026年1月1日以降も、ニコル世田谷ショールーム、ニコル青山ショールーム、ならびに全国のBMW正規ディーラー・ネットワークを通じて、引き続き在庫車および認定中古車を中心とした販売と、純正部品の供給、熟練の専任メカニックによる高水準のアフターサービスを提供し続けています。</p>

							<p>クラフトマンシップへの深い敬意と情熱、そして半世紀近くにわたり培った専門知識をもとに、オーナーの皆様が愛車とともに過ごす豊かな時間を末永くお支えいたします。</p>
						</div>

						<div class="corp-narrative-highlights">
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">46年</div>
								<div class="corp-highlight-item__label">総代理店の歩み</div>
							</div>
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">8,000台</div>
								<div class="corp-highlight-item__label">日本国内導入実績</div>
							</div>
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">2拠点</div>
								<div class="corp-highlight-item__label">青山・世田谷ショールーム</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. ショールーム案内（SHOWROOMS） -->
		<section id="showrooms" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">ショールームのご案内</h2>
					<p class="corp-section-subtitle">青山および世田谷に構える正規ショールーム。落ち着いた空間で特別な名車と専門スタッフがお客様をお迎えします。</p>
				</header>

				<div class="corp-showrooms-stack">
					{showrooms.map((sh) => (
						<div class="corp-showroom-grid">
							<div class="corp-showroom-visual">
								<div class="corp-showroom-photo-wrap">
									<img 
										src={sh.image} 
										alt={`${sh.name} 外観写真`} 
										class="corp-showroom-photo" 
										loading="lazy" 
										decoding="async" 
									/>
									<div class="corp-showroom-photo-badge">{sh.type}</div>
								</div>
							</div>

							<div class="corp-showroom-info">
								<header class="corp-showroom-header">
									<div>
										<span class="corp-showroom-type">正規ショールーム / サービス受付</span>
										<h3 class="corp-showroom-name">{sh.name}</h3>
									</div>
								</header>

								<dl class="corp-showroom-details">
									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">所在地</dt>
										<dd class="corp-showroom-dd">
											<span>{sh.postal} {sh.address}</span>
											<a 
												href={sh.mapUrl} 
												target="_blank" 
												rel="noopener noreferrer" 
												class="corp-map-link"
												aria-label={`${sh.name} のGoogle Mapsを開く（外部サイト）`}
											>
												<span>Google Mapsで地図を見る</span>
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="external-svg" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
											</a>
										</dd>
									</div>

									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">連絡先</dt>
										<dd class="corp-showroom-dd">
											<div class="corp-showroom-contacts">
												<a href={`tel:${sh.tel.replace(/[^0-9]/g, '')}`} class="corp-tel-link">TEL：{sh.tel}</a>
												<span class="corp-contact-sep">/</span>
												<span class="corp-fax-text">FAX：{sh.fax}</span>
											</div>
										</dd>
									</div>

									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">営業時間</dt>
										<dd class="corp-showroom-dd">{sh.hours}</dd>
									</div>

									<div class="corp-showroom-row">
										<dt class="corp-showroom-dt">定休日</dt>
										<dd class="corp-showroom-dd">{sh.closed}</dd>
									</div>
								</dl>
							</div>
						</div>
					))}
				</div>

				<!-- 公式アクションボタン群 -->
				<div class="corp-brand-action-banner">
					<div class="corp-brand-action-banner__inner">
						<div>
							<h3 class="corp-brand-action-title">ニコル・オートモビルズ 公式サイト & オンラインストア</h3>
							<p class="corp-brand-action-desc">在庫車・認定中古車情報や、正規アクセサリー・ライフスタイルコレクションをご案内しています。</p>
						</div>
						<div class="corp-brand-action-links">
							<a href="https://nicole-automobiles.com/" target="_blank" rel="noopener noreferrer" class="corp-btn corp-btn--primary">
								<span>オフィシャル・サイト</span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-svg" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							</a>
							<a href="https://nicole-automobiles.shop/" target="_blank" rel="noopener noreferrer" class="corp-btn corp-btn--outline">
								<span>オンライン・ショップ</span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-svg" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. ギャラリー（GALLERY: Gallery format rule準拠） -->
		<section id="gallery" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">ギャラリー</h2>
					<p class="corp-section-subtitle">BMW ALPINAのディテールと、ショールームの洗練された佇まい。</p>
				</header>

				<div class="corp-gallery-grid">
					{showroomGallery.map((item) => (
						<figure class="corp-gallery-card">
							<div class="corp-gallery-card__media">
								<img 
									src={item.src} 
									alt={item.alt} 
									class="corp-gallery-card__img" 
									loading="lazy" 
									decoding="async" 
								/>
								<div class="corp-gallery-card__count">{item.num}</div>
							</div>
							<figcaption class="corp-gallery-card__caption">
								{item.caption}
							</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<!-- 5. 関連記事（WEB MAGAZINE） -->
		<section id="articles" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">関連記事</h2>
					<p class="corp-section-subtitle">BMW ALPINAの歴史やクラフトマンシップ、認定中古車の価値を紐解く特集記事をご紹介します。</p>
				</header>

				<div class="corp-articles-grid">
					{relatedArticles.map((art) => (
						<article class="corp-article-card">
							<a href={art.url} class="corp-article-card__link">
								<div class="corp-article-card__media">
									<img 
										src={art.img} 
										alt={art.title} 
										class="corp-article-card__img" 
										loading="lazy" 
										decoding="async" 
									/>
									<span class="corp-article-card__badge">{art.tag}</span>
								</div>
								<div class="corp-article-card__content">
									<time class="corp-article-card__date" datetime={art.date}>{art.date}</time>
									<h3 class="corp-article-card__title">{art.title}</h3>
								</div>
							</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- 6. 会社基本データ（テーブル崩れ完全修正） -->
		<section id="profile" class="corp-section">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">会社基本データ</h2>
					<p class="corp-section-subtitle">ニコル・オートモビルズ合同会社の企業概要データです。</p>
				</header>

				<div class="corp-profile-card">
					<table class="corp-profile-table">
						<tbody>
							<tr>
								<th scope="row">会社名</th>
								<td>ニコル・オートモビルズ合同会社（Nicole Automobiles LLC）</td>
							</tr>
							<tr>
								<th scope="row">設立</th>
								<td>1982年</td>
							</tr>
							<tr>
								<th scope="row">代表者</th>
								<td>代表職務執行者 社長 ミヒャエル・ヴィット（Michael Witt）</td>
							</tr>
							<tr>
								<th scope="row">所在地</th>
								<td>〒107-0052 東京都港区赤坂7-1-15</td>
							</tr>
							<tr>
								<th scope="row">電話番号</th>
								<td>03-3478-3511（代表） / FAX：03-3478-1343</td>
							</tr>
							<tr>
								<th scope="row">事業内容</th>
								<td>
									<ul class="corp-business-list">
										<li>BMW ALPINA 在庫車および認定中古車の販売・査定・買取</li>
