// CMS 'companies' コレクションからデータを優先取得
let companyEntry: any = null;
try {
	const res = await getEmDashEntry("companies" as any, "nicole-automobiles");
	if (res?.entry) {
		companyEntry = res.entry.data || res.entry;
	}
} catch (e) {}

// 管理画面で追加された自由ブロック（Portable Text）のパース
let parsedContent: any[] = [];
if (companyEntry?.content) {
	if (Array.isArray(companyEntry.content)) {
		parsedContent = companyEntry.content;
	} else if (typeof companyEntry.content === "string") {
		try {
			const parsed = JSON.parse(companyEntry.content);
			if (Array.isArray(parsed)) parsedContent = parsed;
		} catch (e) {}
	}
}

const companyTitle = companyEntry?.title || "ニコル・オートモビルズ合同会社";

const pageTitle = companyEntry?.title
	? `${companyEntry.title} | ALPINA | Nicole Group 公式`
	: "ニコル・オートモビルズ合同会社 | ALPINA | Nicole Group 公式";

const pageDescription = companyEntry?.hero_phrase
	? companyEntry.hero_phrase
	: "BMW ALPINAの日本総輸入元として46年の歴史を紡いできたニコル・オートモビルズ合同会社の企業情報です。2026年以降も在庫車・認定中古車および正規アフターサービスを提供。ニコル世田谷ショールーム、ニコル青山ショールームの拠点情報をご案内します。";

// ヒーロー
const heroImageSrc = companyEntry?.hero_image?.src || "/uploads/2026/02/DSC8585-scaled.avif";
const heroPhrase = companyEntry?.hero_phrase || "独国アルピナ社（BMW ALPINA）日本総代理店として46年。8,000台を超える特別な名車を日本のお客様へお届けしてまいりました。2026年以降も在庫車・認定中古車の販売と正規アフターサービスを通じて、孤高のクラフトマンシップと唯一無二の走りの世界をお支えします。";

// 会社紹介
const aboutTitle = companyEntry?.about_title || "46年の歴史が紡ぐ、<br />孤高のクラフトマンシップと信頼。";
const aboutLead = companyEntry?.about_lead || "日本総代理店として8,000台におよぶ名車を日本のお客様にお届けしてきた誇り";
const aboutImageSrc = companyEntry?.about_image?.src || "/uploads/2026/02/DSC2802-scaled.avif";
const aboutImageCaption = companyEntry?.about_image_caption || "BMW ALPINA クラフトマンシップ";
const aboutText = companyEntry?.about_text || "ニコル・オートモビルズ合同会社は、独国アルピナ社（BMW ALPINA）の日本総代理店として、1982年の会社設立以来、46年の長きにわたり8,000台におよぶ名車を日本の選ばれたお客様にお届けしてまいりました。\n\n2025年12月31日のアルピナ社によるBMW社への商標譲渡完了を経て、2026年1月1日以降も、ニコル世田谷ショールーム、ニコル青山ショールーム、ならびに全国のBMW正規ディーラー・ネットワークを通じて、引き続き在庫車および認定中古車を中心とした販売と、純正部品の供給、熟練の専任メカニックによる高水準のアフターサービスを提供し続けています。\n\nクラフトマンシップへの深い敬意と情熱、そして半世紀近くにわたり培った専門知識をもとに、オーナーの皆様が愛車とともに過ごす豊かな時間を末永くお支えいたします。";

// ハイライト
