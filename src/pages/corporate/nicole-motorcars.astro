		alt: "ロールス・ロイス・モーター・カーズ横浜 ビスポーク・アトリエ",
		num: "02",
		title: "ビスポーク・アトリエ",
		caption: "世界に一台だけの車を仕立てるビスポーク・アトリエ"
	},
	{
		src: "/uploads/2026/02/20240119RRYokohama_Photo10-scaled.avif",
		alt: "ロールス・ロイス・モーター・カーズ横浜 プライベート商談ラウンジ",
		num: "03",
		title: "プライベートラウンジ",
		caption: "優雅で落ち着いた対話をお届けするプライベート商談ラウンジ"
	},
	{
		src: "/uploads/2026/02/DSC07532-scaled.avif",
		alt: "ロールス・ロイス ビスポーク マテリアルサンプルコレクション",
		num: "04",
		title: "マテリアルサンプル",
		caption: "最高品質のレザー、ウッド、ペイントカラーのマテリアルサンプル"
	},
	{
		src: "/uploads/2026/02/DSC07521-scaled.avif",
		alt: "ロールス・ロイス・モーター・カーズ横浜 ショールームエントランス",
		num: "05",
		title: "エントランス",
		caption: "洗練されたラグジュアリーの世界観へと誘うエントランス"
	},
	{
		src: "/uploads/2026/02/O0A0165-scaled.avif",
		alt: "ロールス・ロイス ディテール クラフトマンシップ",
		num: "06",
		title: "クラフトマンシップ",
		caption: "比類なき頂点のクラフトマンシップが息づく車両ディテール"
	}
];

if (companyEntry) {
	const dynamicGallery: any[] = [];
	for (let i = 1; i <= 6; i++) {
		const rawImg = companyEntry[`gallery_image_${i}`];
		if (rawImg) {
			let src = "";
			let alt = companyEntry[`gallery_title_${i}`] || `${companyTitle} 写真 ${i}`;
			if (typeof rawImg === "string") {
				try {
					const parsed = JSON.parse(rawImg);
					src = parsed.src || rawImg;
					if (parsed.alt) alt = parsed.alt;
				} catch {
					src = rawImg;
				}
			} else if (typeof rawImg === "object" && rawImg !== null) {
				src = rawImg.src || "";
				if (rawImg.alt) alt = rawImg.alt;
			}
			if (src) {
				const num = String(dynamicGallery.length + 1).padStart(2, "0");
				dynamicGallery.push({
					src,
					alt,
					num,
					title: companyEntry[`gallery_title_${i}`] || `ギャラリー ${num}`,
					caption: companyEntry[`gallery_caption_${i}`] || ""
				});
			}
		}
	}
	if (dynamicGallery.length > 0) {
		showroomGallery = dynamicGallery;
	}
}

// 会社基本データ
const companyNameEn = companyEntry?.name_en || "Nicole MotorCars LLC";
const established = companyEntry?.established || "2009年";
const representative = companyEntry?.representative || "代表職務執行者 社長 ミヒャエル・ヴィット（Michael Witt）";
const postal = companyEntry?.postal || showroomData?.postal || "〒220-0012";
const address = companyEntry?.address || showroomData?.address || "神奈川県横浜市西区みなとみらい4-2-1";
const tel = companyEntry?.tel || (showroomData?.tel ? `${showroomData.tel}（代表） / FAX：${showroomData.fax || '045-680-4501'}` : "045-680-4500（代表） / FAX：045-680-4501");
const telDisplay = tel.startsWith("TEL") ? tel : `TEL：${tel}`;
const businessList = companyEntry?.business_desc
	? companyEntry.business_desc.split("\n").filter(Boolean)
	: [
		"ロールス・ロイス・モーター・カーズ新車販売およびアフターセールス",
		"ロールス・ロイス認定中古車「プロビナンス（Provenance）」の販売・査定・買取",
		"ロールス・ロイス純正部品・アクセサリーの販売",
		"ビスポーク（完全オーダーメイド）のご相談・オーダー受付",
		"自動車保険代理店業務"
	];

// 記事カテゴリー判定ヘルパー（マガジン「Nicole Connect」と完全共通）
function determineArticleCategory(p: any): string {
	const slug = (p.slug || p.id || "").toLowerCase();
	const title = (p.title || p.data?.title || "").toLowerCase();
	const topic = (p.topic || "").toLowerCase();

	if (slug.includes("campaign") || slug.includes("fair") || slug.includes("debut") || title.includes("フェア") || title.includes("キャンペーン")) {
		return "Campaign";
	}
	if (slug.includes("guide") || slug.includes("buyer") || title.includes("ガイド") || title.includes("選び方") || title.includes("購入") || topic === "guide") {
		return "Buyer's Guide";
	}
	const esgKeywords = [
		"tamagawa", "cleanup", "japanesenight", "inspire_hub", "traffic-safety",
		"food-for-community", "sustainable", "emergency", "kids-mechanic", "haruhinofes",
		"norimonofes", "sdgs", "summerconference", "esg", "美化活動", "クリーンアップ", "交通安全", "防災", "寄付"
	];
	if (esgKeywords.some(kw => slug.includes(kw) || title.includes(kw)) || topic.includes("esg") || topic.includes("sdgs")) {
		return "ESG";
	}
	const peopleKeywords = [
		"people", "interview", "staff", "mechanic", "craft", "職人", "社員", "インタビュー",
		"ストーリー", "story", "マイスター", "junior_high", "work-experience", "international-employee",
		"fire-department", "mochitsuki", "餅つき", "交流会", "感謝状", "職場体験", "alpina-heritage", "rolls-royce-bespoke"
	];
	if (peopleKeywords.some(kw => slug.includes(kw) || title.includes(kw)) || topic === "people") {
		return "People";
	}
	return "Cars";
}

// マガジンコレクションからロールス・ロイス関連最新記事を動的取得
let relatedArticles: Array<{
	title: string;
	date: string;
	category: string;
	brand: string;
	url: string;
	img: string;
}> = [];

try {
	const magResult = await getEmDashCollection("magazine" as any, {
		orderBy: { published_at: "desc" },
		limit: 100,
	});
	if (magResult?.entries && magResult.entries.length > 0) {
		const filtered = magResult.entries.filter((entry: any) => {
			const slug = (entry.id || entry.slug || "").toLowerCase();
			const title = (entry.data?.title || entry.title || "").toLowerCase();
			return slug.includes("rolls-royce") || slug.includes("rollsroyce") || title.includes("ロールス") || title.includes("rolls-royce");
		});

		const selectedEntries = (filtered.length >= 4 ? filtered : magResult.entries.filter((e: any) => {
			const s = (e.id || e.slug || "").toLowerCase();
			const t = (e.data?.title || e.title || "").toLowerCase();
			return s.includes("rolls") || t.includes("ロールス");
		})).slice(0, 4);

		const entryIds = selectedEntries.map((e: any) => e.data?.id || e.id).filter(Boolean);

		let categoryTermsByEntry = new Map<string, any[]>();
		try {
			if (entryIds.length > 0) {
				categoryTermsByEntry = await getTermsForEntries("magazine", entryIds, "category");
			}
		} catch (e) {}

		relatedArticles = selectedEntries.map((entry: any) => {
			const slug = entry.id || entry.slug;
			const title = entry.data?.title || entry.title || "ロールス・ロイス特集記事";
			const entryDbId = entry.data?.id || entry.id;
			const publishedAt = new Date(entry.data?.publishedAt ?? entry.data?.createdAt ?? entry.published_at ?? 0).getTime() || 0;
			const dateStr = publishedAt 
				? new Date(publishedAt).toLocaleDateString("sv-SE", { timeZone: "Asia/Tokyo" }).replace(/-/g, ".")
				: "2026.09.03";
			
			let imgPath = entry.data?.featured_image?.src || entry.featured_image?.src || "/uploads/2026/02/20240119RRYokohama_Photo07-scaled.avif";
			if (imgPath.includes("nicole.co.jp/wp/wp-content")) {
				imgPath = imgPath.replace(/https?:\/\/[^\/]+\/wp\/wp-content/, "/uploads/wp");
			}

			const assignedCategories = (categoryTermsByEntry.get(entryDbId) || []).map((term: any) => term.label).filter(Boolean);
			const inferredCat = determineArticleCategory({ slug, title, topic: entry.data?.topic || entry.topic });
			const category = assignedCategories.length > 0 ? assignedCategories[0] : inferredCat;

			return {
				title,
				date: dateStr,
				category,
				brand: "Rolls-Royce",
				url: `/magazine/${slug}/`,
				img: imgPath
			};
		});
	}
} catch (e) {}

// フォールバック（ロールス・ロイス厳選4記事・実在画像保証）
if (relatedArticles.length === 0) {
	relatedArticles = [
		{
			title: "世界が認めた「究極の一台」を創る場所。ロールス・ロイス・モーター・カーズ横浜が体現するビスポークの真髄",
