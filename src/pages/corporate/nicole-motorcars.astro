---
// src/pages/corporate/nicole-motorcars.astro
// Nicole MotorCars合同会社 会社案内（Nicole Connect マガジン同等の黒背景エディトリアルデザイン）
import { getEmDashEntry, getEmDashCollection, getTermsForEntries } from "emdash";
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import MapBadge from "../../components/MapBadge.astro";
import RichPortableText from "../../components/blocks/RichPortableText.astro";
import svgs from "../../data/corporate-svgs.json";
import "../../styles/corporate.css";

// CMS 'companies' コレクションからデータを優先取得
let companyEntry: any = null;
try {
	const res = await getEmDashEntry("companies" as any, "nicole-motorcars");
	if (res?.entry) {
		companyEntry = res.entry.data || res.entry;
	}
} catch (e) {}

// 管理画面で追加された自由ブロック（Portable Text）のパース
let parsedContent: any[] = [];
if (companyEntry?.content) {
	if (Array.isArray(companyEntry.content)) {
		parsedContent = companyEntry.content;
	} else if (typeof companyEntry.content === "string") {
		try {
			const parsed = JSON.parse(companyEntry.content);
			if (Array.isArray(parsed)) parsedContent = parsed;
		} catch (e) {}
	}
}

const companyTitle = companyEntry?.title || "Nicole MotorCars合同会社";

const pageTitle = companyEntry?.title
	? `${companyEntry.title} | ロールス・ロイス・モーター・カーズ正規ディーラー | Nicole Group 公式`
	: "Nicole MotorCars合同会社 | ロールス・ロイス・モーター・カーズ正規ディーラー | Nicole Group 公式";

const pageDescription = companyEntry?.hero_phrase
	? companyEntry.hero_phrase
	: "英国ロールス・ロイス・モーター・カーズ正規販売代理店 Nicole MotorCars合同会社の企業情報です。横浜みなとみらいに日本初となる最新CIショールームを構え、2024年には世界一となる「グローバル・ビスポーク・オブ・ザ・イヤー」を受賞。卓越したクラフトマンシップと比類なきビスポーク体験をご提供いたします。";

// ヒーロー
const heroImageSrc = companyEntry?.hero_image?.src || "/uploads/2026/02/20240119RRYokohama_Photo07-scaled.avif";
const heroPhrase = companyEntry?.hero_phrase || "英国ロールス・ロイス・モーター・カーズ正規販売代理店。横浜みなとみらいに日本初となる最新CIショールームを構え、2024年には世界一となる「グローバル・ビスポーク・オブ・ザ・イヤー」を受賞。比類なき頂点のクラフトマンシップと、選ばれたお客様のための至高の体験をお届けします。";

// 会社紹介
const aboutTitle = companyEntry?.about_title || "世界最高峰のラグジュアリーと、<br />比類なき歓びをお届けする。";
const aboutLead = companyEntry?.about_lead || "2009年の設立以来、卓越した実績と信頼を積み重ねてきた正規ディーラー";
const aboutImageSrc = companyEntry?.about_image?.src || "/uploads/2026/02/DSC07169-scaled.avif";
const aboutImageCaption = companyEntry?.about_image_caption || "ビスポーク・アトリエ（Bespoke Atelier Yokohama）";
const aboutText = companyEntry?.about_text || "Nicole MotorCars合同会社は、2009年に英国ロールス・ロイス・モーター・カーズより神奈川エリアの正規ディーラーとして指名を受け設立されました。\n\n以来、世界最高峰の自動車ブランドにふさわしい最高水準のホスピタリティと技術力を磨き続け、横浜みなとみらいの地でお客様一人ひとりの想いに寄り添うパーソナルなサービスを展開してまいりました。\n\n2024年には、日本初となる最新CIに基づいた新ショールームをオープン。開放感あふれる最新鋭の空間には、特別なビスポーク・アトリエを完備し、素材やペイントカラー、ステッチの細部に至るまで妥協なく追求できる環境を整えています。\n\n同年、全世界のロールス・ロイス正規代理店を対象としたアワードにおいて、世界一となる「グローバル・ビスポーク・オブ・ザ・イヤー」を受賞。世界基準で認められた提案力と情熱をもって、限られたお客様へ一生涯記憶に残る感動をお届けしています。";

// ハイライト
const highlight1Num = companyEntry?.highlight_1_num || "世界一";
const highlight1Label = companyEntry?.highlight_1_label || "Bespoke Dealer of the Year 2024";
const highlight2Num = companyEntry?.highlight_2_num || "日本初";
const highlight2Label = companyEntry?.highlight_2_label || "新世代CIショールーム開設";
