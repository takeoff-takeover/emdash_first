---
// src/pages/corporate/nicole-motorcars.astro
// Nicole MotorCars合同会社 会社案内（Nicole Connect マガジン同等の黒背景エディトリアルデザイン）
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import svgs from "../../data/corporate-svgs.json";

const pageTitle = "Nicole MotorCars合同会社 | ロールス・ロイス・モーター・カーズ正規ディーラー | Nicole Group 公式";
const pageDescription = "英国ロールス・ロイス・モーター・カーズ正規販売代理店 Nicole MotorCars合同会社の企業情報です。横浜みなとみらいに日本初となる最新CIショールームを構え、2024年には世界一となる「グローバル・ビスポーク・オブ・ザ・イヤー」を受賞。卓越したクラフトマンシップと比類なきビスポーク体験をご提供いたします。";

// ショールームフォトギャラリー写真（Gallery format rule準拠: シンプルな番号と説明のみ）
const showroomGallery = [
	{
		src: "/uploads/2026/02/20240119RRYokohama_Photo07-scaled.avif",
		alt: "ロールス・ロイス・モーター・カーズ横浜 最新CIショールーム展示スペース",
		num: "01",
		caption: "最新CIに基づき設計されたメインショールーム展示フロア"
	},
	{
		src: "/uploads/2026/02/DSC07169-scaled.avif",
		alt: "ロールス・ロイス・モーター・カーズ横浜 ビスポーク・アトリエ",
		num: "02",
		caption: "世界に一台だけの車を仕立てるビスポーク・アトリエ"
	},
	{
		src: "/uploads/2026/02/20240119RRYokohama_Photo10-scaled.avif",
		alt: "ロールス・ロイス・モーター・カーズ横浜 プライベート商談ラウンジ",
		num: "03",
		caption: "優雅で落ち着いた対話をお届けするプライベート商談ラウンジ"
	},
	{
		src: "/uploads/2026/02/DSC07532-scaled.avif",
		alt: "ロールス・ロイス ビスポーク マテリアルサンプルコレクション",
		num: "04",
		caption: "最高品質のレザー、ウッド、ペイントカラーのマテリアルサンプル"
	},
	{
		src: "/uploads/2026/02/DSC07521-scaled.avif",
		alt: "ロールス・ロイス・モーター・カーズ横浜 ショールームエントランス",
		num: "05",
		caption: "洗練されたラグジュアリーの世界観へと誘うエントランス"
	},
	{
		src: "/uploads/2026/02/O0A0165-scaled.avif",
		alt: "ロールス・ロイス ディテール クラフトマンシップ",
		num: "06",
		caption: "比類なき頂点のクラフトマンシップが息づく車両ディテール"
	},
	{
		src: "/uploads/2026/02/DSC07535-scaled.avif",
		alt: "ロールス・ロイス ビスポーク サンプルディスプレイウォール",
		num: "07",
		caption: "無限のパーソナライゼーションを体感できるサンプルウォール"
	}
];

// 関連記事データ
const relatedArticles = [
	{
		title: "ロールス・ロイス認定中古車は買い？プロビナンスの保証と価値",
		date: "2026.09.03",
		tag: "Rolls-Royce",
		url: "/posts202609_rolls-royce_provenance-worth-it/",
		img: "/uploads/2026/08/Rolls-Royce-Cullinan-Series-II-Captain-Finished-in-Monteverde-Image-9-2025-scaled-e1787725475530.jpg"
	},
	{
		title: "BMW / MINI / Rolls-Royce / Ferrari｜認定中古車とは？メリット・保証・点検・選び方について",
		date: "2026.07.06",
		tag: "Certified Pre-Owned",
		url: "/posts202607_nicole_certified-used-cars-guide/",
		img: "/uploads/2026/07/★ALL_Generated_Image_whwtoswhwtoswhwt.jpg"
	},
	{
		title: "愛車の輝きを10年守る。プロテクションフィルムの選び方と「メーカー直結施工」の真価",
		date: "2026.06.25",
		tag: "Service & Bodycare",
		url: "/posts202606_nicole_protection-film/",
		img: "/uploads/2026/06/DSC8395-e1782193339640.jpg"
	},
	{
		title: "2026年版 ロールス・ロイス スペクター補助金ガイド（CEV補助金・助成情報）",
		date: "2026.06.03",
		tag: "Rolls-Royce Spectre",
		url: "/posts202606_rolls-royce_ev-subsidy-guide/",
		img: "/uploads/2026/06/cq5dam.web_-e1780380151979.jpg"
	}
];

// Schema.org 構造化データ（JSON-LD）
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "AboutPage",
			"@id": "https://www.nicole.co.jp/corporate/nicole-motorcars/#webpage",
			"url": "https://www.nicole.co.jp/corporate/nicole-motorcars",
			"name": pageTitle,
			"description": pageDescription,
			"breadcrumb": {
				"@id": "https://www.nicole.co.jp/corporate/nicole-motorcars/#breadcrumb"
			}
		},
		{
			"@type": "BreadcrumbList",
			"@id": "https://www.nicole.co.jp/corporate/nicole-motorcars/#breadcrumb",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "HOME",
					"item": "https://www.nicole.co.jp/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "会社概要",
					"item": "https://www.nicole.co.jp/corporate"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "Nicole MotorCars合同会社",
					"item": "https://www.nicole.co.jp/corporate/nicole-motorcars"
				}
			]
		},
		{
			"@type": "AutoDealer",
			"@id": "https://www.nicole.co.jp/corporate/nicole-motorcars/#organization",
			"name": "Nicole MotorCars合同会社",
			"alternateName": "ロールス・ロイス・モーター・カーズ横浜",
			"url": "https://www.nicole.co.jp/corporate/nicole-motorcars",
			"logo": "https://www.nicole.co.jp/brands/rolls-royce.svg",
			"image": "https://www.nicole.co.jp/uploads/2026/02/rr_20261008.jpg",
			"telephone": "045-680-4500",
			"address": {
				"@type": "PostalAddress",
				"postalCode": "220-0012",
				"addressRegion": "神奈川県",
				"addressLocality": "横浜市西区",
				"streetAddress": "みなとみらい4-2-1"
			},
			"parentOrganization": {
				"@type": "Organization",
				"name": "ニコル・グループ",
				"url": "https://www.nicole.co.jp/"
			}
		}
	]
};
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style is:global>
			body:has(.corporate-magazine-main),
			body:has(.corporate-magazine-main) #page,
			body:has(.corporate-magazine-main) #content,
			body:has(.corporate-magazine-main) .site-content,
			body:has(.corporate-magazine-main) #primary,
			body:has(.corporate-magazine-main) .content-area,
			body:has(.corporate-magazine-main) .ast-container {
				background-color: #040507 !important;
				background-image: none !important;
			}
		</style>
	</Fragment>

	<main class="corporate-magazine-main">
		<!-- 1. HERO COVER（最新CIショールーム展示スペース大判カバー） -->
		<header class="corp-hero">
			<div class="corp-hero__media">
				<img 
					src="/uploads/2026/02/20240119RRYokohama_Photo07-scaled.avif" 
					alt="ロールス・ロイス・モーター・カーズ横浜 ショールーム展示フロア" 
					class="corp-hero__img" 
					loading="eager" 
					decoding="async" 
				/>
				<div class="corp-hero__gradient"></div>
				<div class="corp-hero__side-vignette"></div>
			</div>

			<div class="corp-container corp-hero__inner">
				<nav class="corp-breadcrumbs" aria-label="パンくずリスト">
					<ol class="corp-breadcrumbs__list">
						<li class="corp-breadcrumbs__item"><a href="/" class="corp-breadcrumbs__link">HOME</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item"><a href="/corporate" class="corp-breadcrumbs__link">会社概要</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item" aria-current="page">Nicole MotorCars合同会社</li>
					</ol>
				</nav>

				<div class="corp-hero__logo-wrap">
					<div class="corp-hero__brand-logo" set:html={svgs[6]} />
				</div>

				<h1 class="corp-hero__title">Nicole MotorCars合同会社</h1>
				<p class="corp-hero__subtitle">
					<span class="corp-hero__phrase">英国ロールス・ロイス・モーター・カーズ正規販売代理店。</span>
					<span class="corp-hero__phrase">横浜みなとみらいに日本初となる最新CIショールームを構え、</span>
					<span class="corp-hero__phrase">2024年には世界一となる「グローバル・ビスポーク・オブ・ザ・イヤー」を受賞。</span><br class="corp-hero__br" />
					<span class="corp-hero__phrase">比類なき頂点のクラフトマンシップと、</span>
					<span class="corp-hero__phrase">選ばれたお客様のための至高の体験をお届けします。</span>
				</p>

				<!-- ページ内クイックナビゲーション -->
				<nav class="corp-subnav" aria-label="ページ内目次">
					<ul class="corp-subnav__list">
						<li><a href="#about" class="corp-subnav__pill">会社紹介</a></li>
						<li><a href="#showroom" class="corp-subnav__pill">ショールーム</a></li>
						<li><a href="#gallery" class="corp-subnav__pill">ギャラリー</a></li>
						<li><a href="#awards" class="corp-subnav__pill">受賞実績</a></li>
						<li><a href="#articles" class="corp-subnav__pill">関連記事</a></li>
						<li><a href="#profile" class="corp-subnav__pill">会社基本データ</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<!-- 2. 会社紹介（ABOUT & PHILOSOPHY） -->
		<section id="about" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<div class="corp-narrative-grid">
					<!-- 左列: メディアビジュアル（ビスポーク・アトリエ） -->
					<div class="corp-narrative-visual">
						<div class="corp-narrative-card">
							<img 
								src="/uploads/2026/02/DSC07169-scaled.avif" 
								alt="ロールス・ロイス・モーター・カーズ横浜 ビスポーク・アトリエ内観" 
								class="corp-narrative-img" 
								width="1200" 
								height="800" 
								loading="lazy" 
								decoding="async" 
							/>
							<div class="corp-narrative-caption">
								<span class="corp-narrative-caption-title">ビスポーク・アトリエ</span>
								<span class="corp-narrative-caption-sub">Bespoke Atelier Yokohama</span>
							</div>
						</div>
					</div>

					<!-- 右列: ストーリー本文 -->
					<div class="corp-narrative-content">
						<header class="corp-section-header">
							<h2 class="corp-section-title">世界最高峰のラグジュアリーと、<br />比類なき歓びをお届けする。</h2>
							<p class="corp-section-lead">2009年の設立以来、卓越した実績と信頼を積み重ねてきた正規ディーラー</p>
						</header>

						<div class="corp-narrative-body">
							<p>Nicole MotorCars合同会社は、2009年に英国ロールス・ロイス・モーター・カーズより神奈川エリアの正規ディーラーとして指名を受け設立されました。</p>

							<p>以来、世界最高峰の自動車ブランドにふさわしい最高水準のホスピタリティと技術力を磨き続け、横浜みなとみらいの地でお客様一人ひとりの想いに寄り添うパーソナルなサービスを展開してまいりました。</p>

							<p>2024年には、日本初となる最新CIに基づいた新ショールームをオープン。開放感あふれる最新鋭の空間には、特別なビスポーク・アトリエを完備し、素材やペイントカラー、ステッチの細部に至るまで妥協なく追求できる環境を整えています。</p>

							<p>同年、全世界のロールス・ロイス正規代理店を対象としたアワードにおいて、世界一となる「グローバル・ビスポーク・オブ・ザ・イヤー」を受賞。世界基準で認められた提案力と情熱をもって、限られたお客様へ一生涯記憶に残る感動をお届けしています。</p>
						</div>

						<div class="corp-narrative-highlights">
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">2009</div>
								<div class="corp-highlight-item__label">設立・正規指名</div>
							</div>
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">No.1</div>
								<div class="corp-highlight-item__label">2024年世界一受賞</div>
							</div>
							<div class="corp-highlight-item">
								<div class="corp-highlight-item__num">New CI</div>
								<div class="corp-highlight-item__label">日本初最新ショールーム</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. ショールーム案内（SHOWROOM & SERVICES） -->
		<section id="showroom" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">ショールームのご案内</h2>
					<p class="corp-section-subtitle">横浜みなとみらいに位置する、最新CIに基づいたロールス・ロイス正規ショールームです。</p>
				</header>

				<div class="corp-showroom-grid">
					<!-- 外観写真 -->
					<div class="corp-showroom-visual">
						<div class="corp-showroom-photo-wrap">
							<img 
								src="/uploads/2026/02/rr_20261008.jpg" 
								alt="ロールス・ロイス・モーター・カーズ横浜 ショールーム外観" 
								class="corp-showroom-photo" 
								loading="lazy" 
								decoding="async" 
							/>
							<div class="corp-showroom-photo-badge">最新CI正規ショールーム</div>
						</div>
					</div>

					<!-- 拠点詳細カード -->
					<div class="corp-showroom-info">
						<header class="corp-showroom-header">
							<div class="corp-showroom-brand-mark">
								<img src="/brands/rolls-royce.svg" alt="Rolls-Royce Motor Cars" width="36" height="48" class="rr-mark-img" />
							</div>
							<div>
								<span class="corp-showroom-type">正規ショールーム / ビスポーク・ラウンジ</span>
								<h3 class="corp-showroom-name">ロールス・ロイス・モーター・カーズ横浜</h3>
							</div>
						</header>

						<dl class="corp-showroom-details">
							<div class="corp-showroom-row">
								<dt class="corp-showroom-dt">所在地</dt>
								<dd class="corp-showroom-dd">
									<span>〒220-0012 神奈川県横浜市西区みなとみらい4-2-1</span>
									<a 
										href="https://www.google.com/maps/place/%E3%83%AD%E3%83%BC%E3%83%AB%E3%82%B9%E3%83%BB%E3%83%AD%E3%82%A4%E3%82%B9%E3%83%BB%E3%83%A2%E3%83%BC%E3%82%BF%E3%83%BC%E3%83%BB%E3%82%AB%E3%83%BC%E3%82%BA%E6%A8%AA%E6%B5%9C/@35.4581904,139.626748,16z/data=!3m1!4b1!4m6!3m5!1s0x60185c5d101eaf3f:0x9f2fbe48141851fc!8m2!3d35.4581904!4d139.626748!16s%2Fg%2F1vgqd1jr?entry=ttu" 
										target="_blank" 
										rel="noopener noreferrer" 
										class="corp-map-link"
										aria-label="ロールス・ロイス・モーター・カーズ横浜のGoogleマップを開く（外部サイト）"
									>
										<span>Google Mapsで地図を見る</span>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="external-svg" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
									</a>
								</dd>
							</div>

							<div class="corp-showroom-row">
								<dt class="corp-showroom-dt">連絡先</dt>
								<dd class="corp-showroom-dd">
									<div class="corp-showroom-contacts">
										<a href="tel:045-680-4500" class="corp-tel-link">TEL：045-680-4500</a>
										<span class="corp-contact-sep">/</span>
										<span class="corp-fax-text">FAX：045-680-4501</span>
									</div>
								</dd>
							</div>

							<div class="corp-showroom-row">
								<dt class="corp-showroom-dt">営業時間</dt>
								<dd class="corp-showroom-dd">10:00～18:00</dd>
							</div>

							<div class="corp-showroom-row">
								<dt class="corp-showroom-dt">定休日</dt>
								<dd class="corp-showroom-dd">水曜日</dd>
							</div>
						</dl>

						<!-- 公式アクションボタン -->
						<div class="corp-showroom-actions">
							<a 
								href="https://www.rolls-roycemotorcars.com/yokohama/ja_JP/showroom.html" 
								target="_blank" 
								rel="noopener noreferrer" 
								class="corp-btn corp-btn--primary"
								aria-label="ロールス・ロイス・モーター・カーズ横浜 オフィシャル・サイトへ（外部サイト）"
							>
								<span>オフィシャル・サイト</span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-svg" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							</a>

							<a 
								href="https://pre-owned.rolls-roycemotorcars.com/ja_jp/dealer_127669_rolls_royce_motor_cars_yokohama/searchresults" 
								target="_blank" 
								rel="noopener noreferrer" 
								class="corp-btn corp-btn--outline"
								aria-label="ロールス・ロイス プロビナンス 認定中古車検索へ（外部サイト）"
							>
								<span>プロビナンス 認定中古車</span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-svg" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							</a>
						</div>
						<p class="corp-showroom-note">※外部サイトへ遷移し、別ウィンドウで表示されます。</p>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. ショールームギャラリー（GALLERY: Gallery format rule準拠） -->
		<section id="gallery" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">ショールーム</h2>
					<p class="corp-section-subtitle">日本初となる最新CIを導入したショールームの内観とビスポーク空間。</p>
				</header>

				<div class="corp-gallery-grid">
					{showroomGallery.map((item) => (
						<figure class="corp-gallery-card">
							<div class="corp-gallery-card__media">
								<img 
									src={item.src} 
									alt={item.alt} 
									class="corp-gallery-card__img" 
									loading="lazy" 
									decoding="async" 
								/>
								<div class="corp-gallery-card__count">{item.num}</div>
							</div>
							<figcaption class="corp-gallery-card__caption">
								{item.caption}
							</figcaption>
						</figure>
					))}
				</div>
			</div>
		</section>

		<!-- 5. 実績・受賞歴（AWARDS） -->
		<section id="awards" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">受賞実績</h2>
					<p class="corp-section-subtitle">世界最高峰のロールス・ロイス正規代理店ネットワークにおいて認められた卓越した栄誉。</p>
				</header>

				<div class="corp-awards-grid">
					<!-- グローバル・ビスポーク・オブ・ザ・イヤー -->
					<div class="corp-award-card">
						<div class="corp-award-card__wreath" set:html={svgs[16]} />
						<div class="corp-award-card__info">
							<div class="corp-award-card__badge-tag">2024年 世界一受賞</div>
							<h3 class="corp-award-card__title">ロールス・ロイス ビスポーク・ディーラー・オブ・ザ・イヤー</h3>
