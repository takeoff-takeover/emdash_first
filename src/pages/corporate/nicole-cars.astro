	title: string;
	date: string;
	category: string;
	brand: string;
	url: string;
	img: string;
}> = [];

try {
	const magResult = await getEmDashCollection("magazine" as any, {
		orderBy: { published_at: "desc" },
		limit: 100,
	});
	if (magResult?.entries && magResult.entries.length > 0) {
		const filtered = magResult.entries.filter((entry: any) => {
			const slug = (entry.id || entry.slug || "").toLowerCase();
			const title = (entry.data?.title || entry.title || "").toLowerCase();
			const isBmwOrMini = slug.includes("bmw") || slug.includes("mini") || title.includes("bmw") || title.includes("mini");
			const isExclusive = !slug.includes("ferrari") && !slug.includes("rolls-royce") && !title.includes("フェラーリ") && !title.includes("ロールス");
			return isBmwOrMini && isExclusive;
		});

		const selectedEntries = (filtered.length >= 4 ? filtered : magResult.entries.filter((e: any) => {
			const s = (e.id || e.slug || "").toLowerCase();
			const t = (e.data?.title || e.title || "").toLowerCase();
			return s.includes("bmw") || s.includes("mini") || t.includes("bmw") || t.includes("mini");
		})).slice(0, 4);

		const entryIds = selectedEntries.map((e: any) => e.data?.id || e.id).filter(Boolean);

		let categoryTermsByEntry = new Map<string, any[]>();
		try {
			if (entryIds.length > 0) {
				categoryTermsByEntry = await getTermsForEntries("magazine", entryIds, "category");
			}
		} catch (e) {}

		relatedArticles = selectedEntries.map((entry: any) => {
			const slug = entry.id || entry.slug;
			const title = entry.data?.title || entry.title || "BMW & MINI 特集記事";
			const entryDbId = entry.data?.id || entry.id;
			const publishedAt = new Date(entry.data?.publishedAt ?? entry.data?.createdAt ?? entry.published_at ?? 0).getTime() || 0;
			const dateStr = publishedAt 
				? new Date(publishedAt).toLocaleDateString("sv-SE", { timeZone: "Asia/Tokyo" }).replace(/-/g, ".")
				: "2026.10.22";
			
			let imgPath = entry.data?.featured_image?.src || entry.featured_image?.src || "/uploads/2026/02/DSC2293-scaled.avif";
			if (imgPath.includes("nicole.co.jp/wp/wp-content")) {
				imgPath = imgPath.replace(/https?:\/\/[^\/]+\/wp\/wp-content/, "/uploads/wp");
			}

			const assignedCategories = (categoryTermsByEntry.get(entryDbId) || []).map((term: any) => term.label).filter(Boolean);
			const inferredCat = determineArticleCategory({ slug, title, topic: entry.data?.topic || entry.topic });
			const category = assignedCategories.length > 0 ? assignedCategories[0] : inferredCat;

			const brandName = (slug.includes("mini") || title.includes("mini") || title.includes("MINI")) ? "MINI" : "BMW";

			return {
				title,
				date: dateStr,
				category,
				brand: brandName,
				url: `/magazine/${slug}/`,
				img: imgPath
			};
		});
	}
} catch (e) {}

// フォールバック（BMW/MINI厳選4記事・実在画像保証）
if (relatedArticles.length === 0) {
	relatedArticles = [
		{
			title: "i7・740徹底比較！新型7シリーズ後悔しない選び方",
			date: "2026.10.22",
			category: "Buyer's Guide",
			brand: "BMW",
			url: "/magazine/202610_bmw-7series-i7-740-comparison-guide/",
			img: "/uploads/2026/10/169P90636141_lowRes_bmw-i7-60-xdrive-04--scaled-e1792659841606.jpg"
		},
		{
			title: "世界初の助手席画面も！新型BMW 7シリーズ先進装備の衝撃",
			date: "2026.10.15",
			category: "Cars",
			brand: "BMW",
			url: "/magazine/202610_bmw-7series-passenger-display-features/",
			img: "/uploads/2026/10/P90638737_lowRes_the-display-and-oper-1.jpg"
		},
		{
			title: "「BIG LOVE」があふれた一日。みんなで彩ったMINIと、大盛況のガチャ抽選会",
			date: "2026.10.08",
			category: "People",
			brand: "MINI",
			url: "/magazine/202610_mini-big-love-event-report/",
			img: "/uploads/2026/10/DSC6593-1-scaled.jpg"
		},
		{
			title: "BMW / MINI / Rolls-Royce / Ferrari｜認定中古車とは？メリット・保証・点検・選び方について",
			date: "2026.07.06",
			category: "Buyer's Guide",
			brand: "BMW",
			url: "/magazine/202607_nicole_certified-used-cars-guide/",
			img: "/uploads/2026/07/★ALL_Generated_Image_whwtoswhwtoswhwt.jpg"
		}
	];
}

// Schema.org 構造化データ（JSON-LD）
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "AboutPage",
			"@id": "https://www.nicole.co.jp/corporate/nicole-cars/#webpage",
			"url": "https://www.nicole.co.jp/corporate/nicole-cars",
			"name": pageTitle,
			"description": pageDescription,
			"breadcrumb": {
				"@id": "https://www.nicole.co.jp/corporate/nicole-cars/#breadcrumb"
			}
		},
		{
			"@type": "BreadcrumbList",
			"@id": "https://www.nicole.co.jp/corporate/nicole-cars/#breadcrumb",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "HOME",
					"item": "https://www.nicole.co.jp/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "会社概要",
					"item": "https://www.nicole.co.jp/corporate"
				},
				{
					"@type": "ListItem",
					"position": 3,
					"name": "ニコル・カーズ合同会社",
					"item": "https://www.nicole.co.jp/corporate/nicole-cars"
				}
			]
		},
		{
			"@type": "AutoDealer",
			"@id": "https://www.nicole.co.jp/corporate/nicole-cars/#organization",
			"name": "ニコル・カーズ合同会社",
			"alternateName": "Nicole Cars LLC",
			"url": "https://www.nicole.co.jp/corporate/nicole-cars",
			"telephone": "044-511-2000",
			"address": {
				"@type": "PostalAddress",
				"postalCode": "212-0005",
				"addressRegion": "神奈川県",
				"addressLocality": "川崎市幸区",
				"streetAddress": "戸手2-5-7"
			},
			"parentOrganization": {
				"@type": "Organization",
				"name": "ニコル・グループ",
				"url": "https://www.nicole.co.jp/"
			}
		}
	]
};
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		
	</Fragment>

	<main class="corporate-magazine-main">
		<!-- 1. HERO COVER -->
		<header class="corp-hero">
			<div class="corp-hero__media">
				<img 
					src={heroImageSrc} 
					alt="ニコル・カーズ合同会社 BMW / MINI 正規ディーラー" 
					class="corp-hero__img" 
					loading="eager" 
					decoding="async" 
				/>
				<div class="corp-hero__gradient"></div>
				<div class="corp-hero__side-vignette"></div>
			</div>

			<div class="corp-container corp-hero__inner">
				<nav class="corp-breadcrumbs" aria-label="パンくずリスト">
					<ol class="corp-breadcrumbs__list">
						<li class="corp-breadcrumbs__item"><a href="/" class="corp-breadcrumbs__link">HOME</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item"><a href="/corporate" class="corp-breadcrumbs__link">会社概要</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item" aria-current="page">ニコル・カーズ合同会社</li>
					</ol>
				</nav>

				<h1 class="corp-hero__title">{companyTitle}</h1>
				<p class="corp-hero__subtitle">
					{heroPhrase.split("。").filter(Boolean).map((phrase: string) => (
						<span class="corp-hero__phrase">{phrase}。</span>
					))}
				</p>

				<!-- ページ内クイックナビゲーション -->
				<nav class="corp-subnav" aria-label="ページ内目次">
					<ul class="corp-subnav__list">
						<li><a href="#about" class="corp-subnav__pill">会社紹介</a></li>
						{parsedContent.length > 0 && <li><a href="#additional-content" class="corp-subnav__pill">詳細情報</a></li>}
						<li><a href="#network" class="corp-subnav__pill">拠点ネットワーク</a></li>
						<li><a href="#profile" class="corp-subnav__pill">会社基本データ</a></li>
						<li><a href="#awards" class="corp-subnav__pill">受賞実績</a></li>
						{showroomGallery.length > 0 && <li><a href="#gallery" class="corp-subnav__pill">ギャラリー</a></li>}
						<li><a href="#articles" class="corp-subnav__pill">関連記事</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<!-- 2. 会社紹介（ABOUT & PHILOSOPHY） -->
		<section id="about" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<div class="corp-narrative-grid">
					<!-- 左列: メディアビジュアル -->
					<div class="corp-narrative-visual">
						<div class="corp-narrative-card">
							<img 
								src={aboutImageSrc} 
								alt={aboutImageCaption} 
								class="corp-narrative-img" 
								width="1024" 
								height="683" 
								loading="lazy" 
								decoding="async" 
							/>
						</div>
					</div>

					<!-- 右列: ストーリー本文 -->
					<div class="corp-narrative-content">
						<header class="corp-section-header">
							<h2 class="corp-section-title" set:html={aboutTitle} />
							<p class="corp-section-lead">{aboutLead}</p>
						</header>

						<div class="corp-narrative-body">
							{aboutText.split("\n\n").map((p: string) => (
								<p>{p}</p>
							))}
						</div>
					</div>
				</div>
			</div>
		</section>
		<!-- 自由ブロック（Portable Text: 管理画面から自由に追加・上下並び替え可能） -->
		{parsedContent.length > 0 && (
			<section id="additional-content" class="corp-section corp-section--bordered">
				<div class="corp-container">
					<div class="corp-additional-blocks">
						<RichPortableText value={parsedContent} />
					</div>
				</div>
			</section>
		)}

		<!-- 3. 拠点ネットワーク（NETWORK & SHOWROOMS: 全13拠点） -->
		<section id="network" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">拠点ネットワーク（全13拠点）</h2>
					<p class="corp-section-subtitle">東京・神奈川エリアに広がる新車ショールーム、認定中古車センター、総合サービス拠点をカテゴリー別にご案内します。</p>
				</header>

				<div class="corp-network-stack">
					{activeNetworkSections.map((sec) => (
						<div class="corp-network-group">
							<div class="corp-network-group__header">
								<h3 class="corp-network-group__title">{sec.category}</h3>
								<span class="corp-network-group__sub">{sec.categorySub}</span>
							</div>

							<div class="corp-locations-grid">
								{sec.locations.map((loc) => (
									<article class="corp-loc-card">
										<div class="corp-loc-card__media">
											<img 
												src={loc.image} 
												alt={`${loc.name} 外観写真`} 
												class="corp-loc-card__img" 
												loading="lazy" 
												decoding="async" 
											/>
											
										</div>

										<div class="corp-loc-card__content">
											<h4 class="corp-loc-card__name">{loc.name}</h4>
											<p class="corp-loc-card__addr">
												<span class="corp-loc-card__postal">{loc.postal}</span><br />
												{loc.address}
											</p>

											<dl class="corp-loc-card__meta">
												<div class="corp-loc-card__row">
													<dt>TEL</dt>
													<dd>
														<a href={`tel:${loc.tel.replace(/[^0-9]/g, '')}`} class="corp-loc-card__tel">
															{loc.tel}
														</a>
														{loc.fax && <span class="corp-loc-card__fax">/ FAX：{loc.fax}</span>}
													</dd>
												</div>
												<div class="corp-loc-card__row">
													<dt>営業時間</dt>
													<dd>{loc.hours}</dd>
												</div>
												<div class="corp-loc-card__row">
													<dt>定休日</dt>
													<dd>{loc.closed}</dd>
												</div>
											</dl>

											<footer class="corp-loc-card__footer">
												<MapBadge href={loc.mapUrl} title="Googleマップで地図を見る" ariaLabel={`${loc.name}の地図をGoogleマップで開く`} />
											</footer>
										</div>
									</article>
								))}
							</div>
						</div>
					))}
				</div>

				<!-- 公式アクションボタン群 -->
				<div class="corp-brand-action-banner">
					<div class="corp-brand-action-banner__inner">
						<div>
							<h3 class="corp-brand-action-title">BMW / MINI 公式オンラインサービス</h3>
							<p class="corp-brand-action-desc">正規ラインナップの最新情報や、認定中古車の最新在庫をご確認いただけます。</p>
						</div>
						<div class="corp-brand-action-links">
							<a href="https://locator.bmw.co.jp/" target="_blank" rel="noopener noreferrer" class="corp-btn corp-btn--primary">
								<span>BMW 認定中古車検索</span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-svg" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							</a>
							<a href="https://locator.mini.jp/" target="_blank" rel="noopener noreferrer" class="corp-btn corp-btn--outline">
								<span>MINI 認定中古車検索</span>
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-svg" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. 会社基本データ -->
		<section id="profile" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">会社基本データ</h2>
					<p class="corp-section-subtitle">ニコル・カーズ合同会社の企業概要データです。</p>
				</header>

				<div class="corp-profile-card">
					<table class="corp-profile-table">
						<tbody>
							<tr>
								<th scope="row">会社名</th>
								<td>{companyTitle}（{companyNameEn}）</td>
							</tr>
							<tr>
								<th scope="row">設立</th>
								<td>{established}</td>
							</tr>
							<tr>
								<th scope="row">代表者</th>
								<td>{representative}</td>
							</tr>
							<tr>
								<th scope="row">所在地</th>
								<td>
									<span>{postal} {address}</span>
									<MapBadge href="https://maps.app.goo.gl/LRAu7RxGhwoWZJLk7" title="Googleマップで地図を見る" ariaLabel="本社の地図をGoogleマップで開く" />
								</td>
							</tr>
							<tr>
								<th scope="row">電話番号</th>
								<td>{telDisplay}</td>
							</tr>
							<tr>
								<th scope="row">事業内容</th>
								<td>
									<ul class="corp-business-list">
										{businessList.map((item: string) => (
											<li>{item}</li>
										))}
									</ul>
								</td>
							</tr>
							<tr>
								<th scope="row">運営拠点</th>
								<td>
									<span class="corp-facility-summary">全13拠点（東京都1拠点・神奈川県12拠点）</span>
									<ul class="corp-profile-facilities">
										<li>
											<span class="corp-facility-type">BMW新車ショールーム：</span>
											<strong class="corp-facility-name">本社川崎・横浜港北・青葉宮前・新百合ヶ丘・大田</strong>
										</li>
										<li>
											<span class="corp-facility-type">MINI新車ショールーム：</span>
											<strong class="corp-facility-name">港北・都筑・新百合ヶ丘</strong>
										</li>
										<li>
											<span class="corp-facility-type">総合サービス拠点：</span>
											<strong class="corp-facility-name">Nicole BMW Service Centre</strong>
											<span class="corp-facility-addr">（神奈川県横浜市都筑区川向町2003-4）</span>
											<MapBadge href="https://maps.app.goo.gl/9U1z1L75mvdq5oVs9" title="Googleマップで地図を見る" ariaLabel="Nicole BMW Service Centreの地図をGoogleマップで開く" />
										</li>
										<li>
											<span class="corp-facility-type">認定中古車センター：</span>
											<strong class="corp-facility-name">BPS横浜港北・BPS新百合ヶ丘・MINI NEXT横浜港北・MINI NEXT新百合ヶ丘</strong>
										</li>
									</ul>
								</td>
							</tr>
							
							<tr>
								<th scope="row">取扱ブランド</th>
								<td>BMW、MINI</td>
							</tr>
							<tr>
								<th scope="row">関連ページ</th>
								<td>
									<div class="corp-related-links">
										<a href="/corporate" class="corp-inline-link">会社概要（グループ総合）</a>
										<span class="corp-inline-link-sep">/</span>
										<a href="/philosophy" class="corp-inline-link">企業理念</a>
										<span class="corp-inline-link-sep">/</span>
										<a href="/locations" class="corp-inline-link">グループ拠点一覧</a>
										<span class="corp-inline-link-sep">/</span>
										<a href="/magazine" class="corp-inline-link">Web Magazine</a>
									</div>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<!-- 5. 受賞実績（AWARDS） -->
		<section id="awards" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">受賞実績</h2>
					<p class="corp-section-subtitle">卓越したサービス品質と確かな信頼に裏打ちされた、数々の受賞歴をご紹介します。</p>
				</header>

				<div class="corp-awards-grid">
					{awardsList.map((award) => (
						<div class="corp-award-card">
							<div class="corp-award-card__wreath" set:html={svgs[award.svgIndex]} />
							<div class="corp-award-card__info">
								<div class="corp-award-card__badge-tag">{award.badge}</div>
								<h3 class="corp-award-card__title">{award.title}</h3>
								<p class="corp-award-card__desc">{award.desc}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 6. ギャラリー（GALLERY - カルーセルスライダー） -->
		{showroomGallery.length > 0 && (
			<section id="gallery" class="corp-section corp-section--bordered">
				<div class="corp-container">
					<header class="corp-section-header">
						<h2 class="corp-section-title">ギャラリー</h2>
						<p class="corp-section-subtitle">Nicole BMW・MINIが誇るショールーム空間と最新鋭サービスファシリティ。</p>
					</header>

					<div class="corp-slider-wrapper">
						<div class="corp-slider-viewport">
							<div class="corp-slider-track" id="corpSliderTrack">
								{showroomGallery.map((item, idx) => (
									<div class={`corp-slider-slide ${idx === 0 ? "is-active" : ""}`} data-slide-index={idx}>
										<div class="corp-slider-media">
											<img 
												src={item.src} 
												alt={item.alt} 
												class="corp-slider-img" 
												loading={idx === 0 ? "eager" : "lazy"} 
												decoding="async" 
											/>
											<span class="corp-slider-badge">{item.num} / {String(showroomGallery.length).padStart(2, "0")}</span>
										</div>
										<div class="corp-slider-caption">
											<h3 class="corp-slider-title">{item.title}</h3>
											<p class="corp-slider-desc">{item.caption}</p>
										</div>
									</div>
								))}
							</div>

							<!-- 左右ナビゲーション矢印 -->
							<button type="button" class="corp-slider-btn corp-slider-btn--prev" id="corpSliderPrev" aria-label="前の写真へ">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
							</button>
							<button type="button" class="corp-slider-btn corp-slider-btn--next" id="corpSliderNext" aria-label="次の写真へ">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
							</button>
						</div>

						<!-- サムネイルナビゲーション -->
						<div class="corp-slider-thumbs" id="corpSliderThumbs" role="tablist" aria-label="サムネイル一覧">
							{showroomGallery.map((item, idx) => (
								<button 
									type="button" 
									class={`corp-slider-thumb ${idx === 0 ? "is-active" : ""}`} 
									data-thumb-index={idx}
									aria-label={`スライド ${idx + 1} (${item.title}) を表示`}
								>
									<img src={item.src} alt={item.title} class="corp-slider-thumb-img" loading="lazy" decoding="async" />
								</button>
							))}
						</div>
					</div>
				</div>
			</section>
		)}

		<!-- 7. 追加コンテンツ（CMS Portable Text 自由ブロック） -->
		

		<!-- 8. 関連記事（RELATED ARTICLES） -->
		<section id="articles" class="corp-section">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">関連記事</h2>
					<p class="corp-section-subtitle">BMWおよびMINIの最新モデル解説、テクノロジー、認定中古車の選び方に関する特集記事をご紹介します。</p>
				</header>

				<div class="corp-articles-grid">
					{relatedArticles.map((art) => (
						<ArticleCard
							title={art.title}
							url={art.url}
							image={art.img}
							date={art.date}
							topic={art.category}
							brand={art.brand}
							showBrandPill={false}
						/>
					))}
				</div>
			</div>
		</section>
	</main>
</NicoleLayout>



<!-- ギャラリー カルーセルスライダースクリプト -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		const track = document.getElementById('corpSliderTrack');
		const prevBtn = document.getElementById('corpSliderPrev');
		const nextBtn = document.getElementById('corpSliderNext');
		const thumbs = document.querySelectorAll('.corp-slider-thumb');
		const slides = document.querySelectorAll('.corp-slider-slide');

		if (track && prevBtn && nextBtn && slides.length > 0) {
			let currentIndex = 0;
			const total = slides.length;

			function goToSlide(idx) {
				currentIndex = (idx + total) % total;
				track.style.transform = `translateX(-${currentIndex * 100}%)`;

				slides.forEach((s, i) => {
					if (i === currentIndex) s.classList.add('is-active');
					else s.classList.remove('is-active');
				});

				thumbs.forEach((t, i) => {
					if (i === currentIndex) {
						t.classList.add('is-active');
						t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
					} else {
						t.classList.remove('is-active');
					}
				});
			}

			prevBtn.addEventListener('click', () => goToSlide(currentIndex - 1));
			nextBtn.addEventListener('click', () => goToSlide(currentIndex + 1));

			thumbs.forEach(thumb => {
				thumb.addEventListener('click', () => {
					const idx = parseInt(thumb.getAttribute('data-thumb-index') || '0', 10);
					goToSlide(idx);
				});
			});
		}
	});
</script>
