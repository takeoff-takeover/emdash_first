---
// src/pages/customer-policy.astro
// ニコル・グループ 公式固定ページ（WordPress/Elementor デザインレイアウト完全継承）
import NicoleLayout from "../layouts/NicoleLayout.astro";

const pageTitle = "お客さま本位の業務運営方針（FD宣言） | Nicole Group 公式";
const pageDescription = "ニコル・グループ各社が定める「お客さま本位の業務運営方針（FD宣言）」をご案内いたします。";

// Elementor 完全継承HTMLコンテンツ
const elementorHtml = "<div data-elementor-type=\"wp-page\" data-elementor-id=\"3970\" class=\"elementor elementor-3970\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-36f2fa2 e-flex e-con-boxed e-con e-parent\" data-id=\"36f2fa2\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-0af75ae elementor-widget elementor-widget-heading\" data-id=\"0af75ae\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">お客さま本位の業務運営方針（FD宣言）</h2>\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-6cb0702 e-flex e-con-boxed e-con e-parent\" data-id=\"6cb0702\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-119f84c elementor-widget elementor-widget-text-editor\" data-id=\"119f84c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<div class=\"row justify-content-center\">\n<div class=\"col-md-10 mt-sm-0 mt-md-5 pt-2 pb-1 px-4\">\n<p class=\"fs-6 text-black text-start text-md-start\">私たち、Nicole Groupは、経営理念に「私達は共に働く仲間・お客様・パートナーの期待を超える喜びをお届けします。」を掲げ、お客様本位の業務運営方針を策定・公表・実践してまいります。</p>\n</div>\n</div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-931e771 elementor-widget elementor-widget-heading\" data-id=\"931e771\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">方針1. お客様本位の業務運営の徹底について</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-99720e4 elementor-widget elementor-widget-text-editor\" data-id=\"99720e4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>私たちは、経営理念と本方針に基づき、全社員がお客様本位で行動していく企業風土を醸成します。 また、本方針の定期的な見直しは、社会情勢や経営環境の変化を踏まえ行います。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-161a1cc elementor-widget elementor-widget-heading\" data-id=\"161a1cc\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">方針2.お客様の最善の利益の追求について</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-949faf9 elementor-widget elementor-widget-text-editor\" data-id=\"949faf9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>具体的取組内容</p>\n<ol>\n<li> <strong>最適な自動車保険のご提案</strong>\n<ul>\n<li> お客様のカーライフニーズを把握し、ご意向にお応えした最適な自動車保険をご提案し、損保制度遵守の上、実践します。</li>\n</ul>\n</li>\n<li> <strong>より分かりやすいデジタルでのお手続き</strong>\n<ul>\n<li>自動車保険のお手続きは、原則パソコンやタブレットのデジタル機器を使用し分かりやすく実施します。</li>\n</ul>\n</li>\n<li> <strong>重要事項のご説明</strong>\n<ul>\n<li>自動車保険の重要事項説明書を使用し、お客様の最善の利益を図るために保険商品、並びに不利益となる可能性がある情報について分かりやすく説明します。</li>\n</ul>\n</li>\n</ol>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-569339a elementor-widget elementor-widget-heading\" data-id=\"569339a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">方針3.ガバナンス体制整備について</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ac6bb49 elementor-widget elementor-widget-text-editor\" data-id=\"ac6bb49\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>具体的取組内容</p>\n<ol>\n<li><strong> 人材育成</strong>\n<ul>\n<li>各種階層研修(入社時、コンプライアンス、保険勉強会など）を実施し、当グループにふさわしい人材育成に取り組みます。</li>\n</ul>\n</li>\n<li><strong> 内部監査の実施</strong>\n<ul>\n<li>定期的な内部監査(施設、保険)を行い、PDCAサイクルを運営することでコンプライアンス意識の醸成と企業倫理観の保持を実現します。</li>\n</ul>\n</li>\n</ol>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-fd9dc5c elementor-widget elementor-widget-heading\" data-id=\"fd9dc5c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">方針4.実現化するためのKPIについて</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-4d493e9 elementor-widget elementor-widget-text-editor\" data-id=\"4d493e9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>具体的取組内容</p>\n<ol>\n<li>私たちは、お客様アンケート満足度指数をKPIとして定め、数値向上を追求します。</li>\n<li>保険募集でいただく「ご指摘」「改善のご要望」などを当グループ内で集約し、定例で共有し、お客様満足度向上に繋げてまいります。</li>\n</ol>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f2b2fc4 elementor-widget elementor-widget-text-editor\" data-id=\"f2b2fc4\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>制定日：2025年5月</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-858921f elementor-widget elementor-widget-text-editor\" data-id=\"858921f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>&lt; Nicole Group of Companies &gt;</p><p>ニコル・レーシング・ジャパン合同会社<br />ニコル・オートモビルズ合同会社<br />ニコル・カーズ合同会社<br />Nicole MotorCars合同会社<br />Nicole Competizione合同会社</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>";
---

<NicoleLayout title={pageTitle} description={pageDescription}>
  <slot name="head" slot="head">
	<link rel="stylesheet" href="/wp-content/themes/astra/assets/css/minified/main.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/reviews-feed/vendor/smashballoon/framework/Packages/Blocks/css/sb-elementor.css" />
	<link rel="stylesheet" href="/wp-content/uploads/astra-addon/astra-addon-6ad82db3390588-53003025.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/frontend.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-image.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-icon-list.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-spacer.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/lib/animations/styles/fadeIn.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/lib/animations/styles/e-animation-grow.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor-pro/assets/css/widget-mega-menu.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor-pro/assets/css/modules/sticky.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/lib/animations/styles/e-animation-pop.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/lib/animations/styles/fadeInRight.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor-pro/assets/css/widget-breadcrumbs.min.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-divider.min.css" />
	<link rel="stylesheet" href="/wp-content/uploads/elementor/css/post-8.css" />
	<link rel="stylesheet" href="/wp-content/plugins/elementor/assets/css/widget-heading.min.css" />
	<link rel="stylesheet" href="/wp-content/uploads/elementor/css/post-3970.css" />
	<link rel="stylesheet" href="/wp-content/uploads/elementor/css/post-6801.css" />
	<link rel="stylesheet" href="/wp-content/uploads/elementor/css/post-12887.css" />
    <style is:global>
      /* Elementor 余白・レイアウト完全適合スタイル */
      .elementor {
        box-sizing: border-box;
      }
      .entry-content {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
      .elementor img {
        height: auto;
        max-width: 100%;
      }
      /* コンテナ幅・表示崩れ防止 */
      .elementor-element {
        --flex-direction: initial;
        --flex-wrap: initial;
        --justify-content: initial;
        --align-items: initial;
      }

      /* ============================================================== */
      /* グローバルヘッダーの左右端（max-width: 1440px / padding: 0 40px）に揃えるスタイル */
      /* ============================================================== */

      /* ① FD宣言 ヒーローバナー */
      .elementor-3970 .elementor-element.elementor-element-36f2fa2 {
        padding-left: 0 !important;
        padding-right: 0 !important;
        width: 100% !important;
      }
      .elementor-3970 .elementor-element.elementor-element-36f2fa2 > .e-con-inner {
        max-width: 1440px !important;
        margin: 0 auto !important;
        padding-left: 40px !important;
        padding-right: 40px !important;
        box-sizing: border-box !important;
      }

      /* ② 方針本文コンテナ: 1440px / 40px で左右一杯に展開 */
      .elementor-3970 .elementor-element.elementor-element-6cb0702 {
        padding-left: 0 !important;
        padding-right: 0 !important;
        width: 100% !important;
      }
      .elementor-3970 .elementor-element.elementor-element-6cb0702 > .e-con-inner {
        max-width: 1440px !important;
        margin: 0 auto !important;
        padding-left: 40px !important;
        padding-right: 40px !important;
        box-sizing: border-box !important;
      }
      .elementor-3970 .col-md-10 {
        max-width: 100% !important;
        width: 100% !important;
        flex: 0 0 100% !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
      }

      /* 見出しの改行最適化（単語分断・孤立文字防止） */
      .elementor-3970 .elementor-heading-title,
      .elementor-3970 h1, .elementor-3970 h2, .elementor-3970 h3, .elementor-3970 h4 {
        text-wrap: balance !important;
        word-break: auto-phrase !important;
        overflow-wrap: break-word !important;
      }

      /* レスポンシブ対応 (グローバルヘッダーと同一のパディング推移) */
      @media (max-width: 1024px) {
        .elementor-3970 .elementor-element.elementor-element-36f2fa2 > .e-con-inner,
        .elementor-3970 .elementor-element.elementor-element-6cb0702 > .e-con-inner {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
      }

      @media (max-width: 480px) {
        .elementor-3970 .elementor-element.elementor-element-36f2fa2 > .e-con-inner,
        .elementor-3970 .elementor-element.elementor-element-6cb0702 > .e-con-inner {
          padding-left: 16px !important;
          padding-right: 16px !important;
        }
      }
    </style>
  </slot>

  <div class="elementor-page-wrapper">
    <div class="entry-content" set:html={elementorHtml} />
  </div>
</NicoleLayout>
