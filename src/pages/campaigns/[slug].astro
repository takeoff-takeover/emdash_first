<!-- ギャラリー切り替えスクリプト -->
<script is:inline>
	(() => {
		const btns = document.querySelectorAll('.cmp-thumb-btn');
		const img = document.getElementById('cmpGalleryImg');
		const badge = document.getElementById('cmpGalleryBadge');
		const cap = document.getElementById('cmpGalleryCap');

		if (!btns.length || !img) return;

		btns.forEach(btn => {
			btn.addEventListener('click', () => {
				btns.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');

				const src = btn.getAttribute('data-img');
				const text = btn.getAttribute('data-cap');
				const idx = btn.getAttribute('data-idx');

				if (src && img) img.src = src;
				if (text && cap) cap.textContent = text;
				if (idx && badge) badge.textContent = `${idx} / ${btns.length}`;
			});
		});
	})();
</script>

