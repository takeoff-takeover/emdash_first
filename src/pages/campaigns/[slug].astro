---
// src/pages/campaigns/[slug].astro
// ニコル・グループ キャンペーンLP（モジュラー型リッチデザインブロックシステム）
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import { getEmDashEntry, getEmDashCollection, getTermsForEntries } from "emdash";
import RichPortableText from "../../components/blocks/RichPortableText.astro";
import "../../styles/prose.css";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/campaigns");
}

let item: any = null;
let allCampaigns: any[] = [];

// 1. EmDash からキャンペーン情報を取得
try {
	const res = await getEmDashCollection("campaigns" as any, { limit: 100 });
	if (res?.entries && res.entries.length > 0) {
		const campIds = res.entries.map((e: any) => e.data?.id || e.id).filter(Boolean);
		const brandTermsByEntry = campIds.length > 0
			? await getTermsForEntries("campaigns", campIds, "brand")
			: new Map();

		allCampaigns = res.entries.map((e: any) => {
			const d = e.data || e;
			const entryDbId = e.data?.id || d.id || e.id;
			const assignedBrands = (brandTermsByEntry.get(entryDbId) || []).map((t: any) => t.label).filter(Boolean);
			const resolvedBrand = assignedBrands.length > 0 ? assignedBrands.join(" / ") : (d.brand || "BMW");
			return {
				id: e.id || d.slug,
				slug: e.id || d.slug,
				title: d.title || "",
				brand: resolvedBrand,
				category: d.category || "新車",
				period_text: d.period_text || "",
				featured_image: typeof d.featured_image === 'string' ? (d.featured_image.startsWith('{') ? JSON.parse(d.featured_image).src : d.featured_image) : (d.featured_image?.src || "/uploads/2026/02/DSC2293-scaled.avif"),
				excerpt: d.excerpt || "",
				target_locations: d.target_locations || "Nicole Group 全拠点",
				cta_label: d.cta_label || "試乗予約・お問い合わせ",
				cta_url: d.cta_url || "/contact"
			};
		});

		let found: any = null;
		try {
			const entryRes = await getEmDashEntry("campaigns" as any, slug);
			if (entryRes?.entry) found = entryRes.entry;
		} catch {}
		if (!found) {
			found = res.entries.find((e: any) => (e.id === slug || e.data?.slug === slug || (e.data && e.data.slug === slug)));
		}
		if (found) {
			const d = found.data || found;
			const foundDbId = found.data?.id || d.id || found.id;
			const foundBrands = (brandTermsByEntry.get(foundDbId) || []).map((t: any) => t.label).filter(Boolean);
			const foundResolvedBrand = foundBrands.length > 0 ? foundBrands.join(" / ") : (d.brand || "BMW");
			item = {
				id: found.id || d.slug || slug,
				slug: found.id || d.slug || slug,
				title: d.title || "",
				brand: foundResolvedBrand,
				category: d.category || "新車",
				period_text: d.period_text || "",
				period_start: d.period_start || "",
				period_end: d.period_end || "",
				featured_image: typeof d.featured_image === 'string' ? (d.featured_image.startsWith('{') ? JSON.parse(d.featured_image).src : d.featured_image) : (d.featured_image?.src || "/uploads/2026/02/DSC2293-scaled.avif"),
				featured_image_sp: typeof d.featured_image_sp === 'string' ? (d.featured_image_sp.startsWith('{') ? JSON.parse(d.featured_image_sp).src : d.featured_image_sp) : (d.featured_image_sp?.src || ""),
				excerpt: d.excerpt || "",
				content: d.content || null,
				target_locations: d.target_locations || "Nicole Group 全拠点",
				cta_label: d.cta_label || "試乗予約・お問い合わせ",
				cta_url: d.cta_url || "/contact",
				databaseId: found.data?.id || found.id,
				layout_type: d.layout_type || "1col" // デモ用初期値
			};
		}
	}
} catch (e) {
	console.error(`[campaigns] Failed to get campaign: ${slug}`, e);
}

// フォールバックデータ
if (!item) {
	const fallbackMap: Record<string, any> = {
		'bmw-autumn-test-drive-2026': {
			id: 'bmw-autumn-test-drive-2026',
			slug: 'bmw-autumn-test-drive-2026',
			title: 'BMW オータム・テストドライブ・フェア 2026',
			brand: 'BMW',
			category: '新車',
			period_text: '2026年11月1日(日) 〜 11月30日(月)',
			featured_image: '/uploads/2026/02/DSC2293-scaled.avif',
			excerpt: '最新のBMWモデルを体感できる特別試乗フェアを開催。期間中のご試乗・ご成約でNicole Group限定の特別記念品を進呈いたします。',
			target_locations: 'Nicole BMW 全拠点（本社ショールーム・横浜港北・青葉宮前・新百合ヶ丘・大田）',
			cta_label: '試乗予約はこちら',
			cta_url: '/contact',
			layout_type: '2col'
		},
		'mini-new-generation-debut-fair': {
			id: 'mini-new-generation-debut-fair',
			slug: 'mini-new-generation-debut-fair',
			title: 'MINI THE NEW GENERATION デビュー・フェア',
			brand: 'MINI',
			category: '新車',
			period_text: '2026年11月7日(土) 〜 11月23日(月・祝)',
			featured_image: '/uploads/2026/08/169P90635275_highRes_mini-family-04-2026-scaled.jpg',
			excerpt: '新世代MINIファミリーが一堂に集結。個性あふれるデザインとゴーカート・フィーリングを各ショールームでご体感ください。',
			target_locations: 'MINI 港北 / MINI 都筑 / MINI 新百合ヶ丘',
			cta_label: '来場予約はこちら',
			cta_url: '/contact',
			layout_type: '1col'
		},
		'bmw-alpina-bps-special-selection': {
			id: 'bmw-alpina-bps-special-selection',
			slug: 'bmw-alpina-bps-special-selection',
			title: 'BMW & BMW ALPINA 認定中古車 特選オータム・セレクション',
			brand: 'ALPINA',
			category: '認定中古車',
			period_text: '2026年11月1日(日) 〜 11月30日(月)',
			featured_image: '/uploads/2026/02/BMW_MINI_BPS_MININEXT新百合ヶ丘2025.jpg',
			excerpt: '厳格な基準をクリアしたBMWおよびBMW ALPINA認定中古車を特別プライスでご案内。特別低金利ローンをご利用いただけます。',
			target_locations: 'BPS 横浜港北 / BPS 新百合ヶ丘 / ニコル世田谷',
			cta_label: '認定中古車在庫を見る',
			cta_url: '/locations',
			layout_type: '2col'
		},
		'rolls-royce-private-preview-yokohama': {
			id: 'rolls-royce-private-preview-yokohama',
			slug: 'rolls-royce-private-preview-yokohama',
			title: 'ロールス・ロイス スペクター プライベート・プレビュー',
			brand: 'Rolls-Royce',
			category: '新車',
			period_text: '事前予約制・随時受付中',
			featured_image: '/uploads/2026/06/cq5dam.web_-e1780380151979.jpg',
			excerpt: 'ウルトラ・ラグジュアリー・クーペ「スペクター」を完全プライベート空間でご案内いたします。専任アンバサダーが極上の時間をお届けします。',
			target_locations: 'ロールス・ロイス・モーター・カーズ横浜 ショールーム',
			cta_label: 'プライベート内覧を予約する',
			cta_url: '/contact',
			layout_type: '2col'
		},
		'ferrari-winter-clinic-service': {
			id: 'ferrari-winter-clinic-service',
			slug: 'ferrari-winter-clinic-service',
			title: 'Nicole Competizione ウィンター・チェックアップ・クリニック',
			brand: 'Ferrari',
			category: 'サービス',
			period_text: '2026年11月15日(日) 〜 12月20日(日)',
			featured_image: '/uploads/2026/02/0H9A1397.jpg',
			excerpt: 'フェラーリ正規ファクトリーによる冬期特別点検プログラム。最新専用テスター診断とエキスパートメカニックによる30項目徹底チェックを実施。',
			target_locations: 'Nicole Competizione サービスセンター（横浜川向）',
			cta_label: '入庫・点検予約',
			cta_url: '/contact',
			layout_type: '2col'
		}
	};
	item = fallbackMap[slug] || null;
}

if (!item) {
	return Astro.redirect("/campaigns");
}

const otherCampaigns = allCampaigns.filter(c => c.slug !== item.slug).slice(0, 3);
const editUrl = `http://localhost:4321/_emdash/api/auth/dev-bypass?redirect=/_emdash/admin/content/campaigns/${item.databaseId || item.slug}`;
const parsedContent = typeof item.content === "string"
	? (() => { try { return JSON.parse(item.content); } catch { return null; } })()
	: item.content;
---

<NicoleLayout 
	title={`${item.title} | キャンペーン・フェア - ニコル・グループ公式`}
	description={item.excerpt || `${item.title}の開催概要・特典情報・対象店舗をご案内します。`}
>
	<main class="cmp-lp-page">
		<!-- ============================================================== -->
		<!-- ブロック1: 【フルワイド 100vw】大迫力シネマティックHERO -->
		<!-- ============================================================== -->
		<section class="cmp-hero">
			<div class="cmp-hero__media">
				<picture>
					{item.featured_image_sp && (
						<source media="(max-width: 640px)" srcset={item.featured_image_sp} />
					)}
					<img 
						src={item.featured_image} 
						alt={item.title} 
						class="cmp-hero__img" 
						loading="eager" 
					/>
				</picture>
				<div class="cmp-hero__scrim"></div>
			</div>

			<div class="cmp-hero__content">
				<div class="cmp-container">
					<div class="cmp-hero__top-row">
						<nav class="cmp-breadcrumbs" aria-label="Breadcrumb">
							<ol class="cmp-breadcrumbs__list">
								<li><a href="/">HOME</a></li>
								<li class="cmp-sep">/</li>
								<li><a href="/campaigns">CAMPAIGNS</a></li>
								<li class="cmp-sep">/</li>
								<li aria-current="page">{item.brand}</li>
							</ol>
						</nav>

						<a href={editUrl} class="cmp-edit-btn" title="CMS管理画面でこのキャンペーンを編集">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cmp-edit-icon">
								<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
								<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
							</svg>
							<span>キャンペーンを編集</span>
						</a>
					</div>

					<div class="cmp-hero__meta-strip">
						<span class="cmp-pill cmp-pill--status">
							<span class="status-dot"></span>
							開催中
						</span>
						<span class="cmp-pill cmp-pill--brand">{item.brand}</span>
						<span class="cmp-pill cmp-pill--cat">{item.category}</span>
						<span class="cmp-pill cmp-pill--period">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="period-icon">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
								<line x1="16" y1="2" x2="16" y2="6"></line>
								<line x1="8" y1="2" x2="8" y2="6"></line>
								<line x1="3" y1="10" x2="21" y2="10"></line>
							</svg>
							{item.period_text}
						</span>
					</div>

					<h1 class="cmp-hero__title">{item.title}</h1>

					{item.excerpt && (
						<p class="cmp-hero__lead">{item.excerpt}</p>
					)}
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- 本文（Portable Text ブロックエディタから出力） -->
		<!-- ============================================================== -->
		<section class="cmp-section cmp-section--wide cmp-article-section">
			<div class="cmp-container">
				{parsedContent && Array.isArray(parsedContent) && parsedContent.length > 0 && (
					<div class="cmp-portable-text prose prose-invert">
						<RichPortableText value={parsedContent} />
					</div>
				)}
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- ブロック7: 【縦積みコンパクトCTA】予約・商談アクションカード（最重要CTA） -->
		<!-- 無理に左右に広げず、縦積みに集約した洗練レイアウト -->
		<!-- ============================================================== -->
		<section class="cmp-section cmp-booking-section" id="cmp-booking">
			<div class="cmp-container cmp-container--narrow">
				<div class="cmp-booking-card cmp-booking-card--stacked">
					<div class="cmp-booking-header">
						<h2 class="cmp-booking-title">フェア事前予約・商談申込</h2>
						<p class="cmp-booking-desc">
							専任セールス・コンサルタントが丁寧にご案内いたします。Web予約で優先的に試乗車をご用意いたします。
						</p>
					</div>

					<!-- 最重要アクション（縦積み：勝負所のアクセントレッド） -->
					<div class="cmp-booking-actions">
						<a href={item.cta_url} class="cmp-btn-cta-primary">
							<span>{item.cta_label}</span>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow">
								<line x1="5" y1="12" x2="19" y2="12"></line>
								<polyline points="12 5 19 12 12 19"></polyline>
							</svg>
						</a>
						<a href="/locations" class="cmp-btn-cta-secondary">
							<span>開催ショールーム一覧を見る</span>
						</a>
					</div>

					<!-- 概要スペックリスト（2カラム・コンパクト） -->
					<div class="cmp-summary-grid">
						<div class="cmp-summary-item">
							<span class="cmp-summary-k">対象ブランド</span>
							<span class="cmp-summary-v">{item.brand}</span>
						</div>
						<div class="cmp-summary-item">
							<span class="cmp-summary-k">種別</span>
							<span class="cmp-summary-v">{item.category}</span>
						</div>
						<div class="cmp-summary-item">
							<span class="cmp-summary-k">開催期間</span>
							<span class="cmp-summary-v">{item.period_text}</span>
						</div>
						<div class="cmp-summary-item">
							<span class="cmp-summary-k">開催店舗</span>
							<span class="cmp-summary-v">{item.target_locations}</span>
						</div>
					</div>

					<!-- お電話窓口 -->
					<div class="cmp-phone-strip">
						<span class="cmp-phone-label">お電話でのご予約・お問い合わせ:</span>
						<a href="tel:0120980343" class="cmp-phone-num">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="phone-icon">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
							0120-980-343
						</a>
						<span class="cmp-phone-sub">（10:00 - 18:00 / 水曜定休）</span>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- ブロック8: その他の開催中キャンペーン（OTHER CAMPAIGNS） -->
		<!-- ============================================================== -->
		{otherCampaigns.length > 0 && (
			<section class="cmp-other-section">
				<div class="cmp-container">
					<div class="cmp-section-heading">
						<h2 class="cmp-heading-title">その他の開催中キャンペーン ＆ 特別フェア</h2>
					</div>

					<div class="cmp-other-grid">
						{otherCampaigns.map(c => (
							<a href={`/campaigns/${c.slug}`} class="cmp-other-card">
								<div class="cmp-other-card__media">
									<img src={c.featured_image} alt={c.title} loading="lazy" />
									<span class="cmp-pill-mini">{c.brand}</span>
								</div>
								<div class="cmp-other-card__body">
									<span class="cmp-other-period">{c.period_text}</span>
									<h3 class="cmp-other-title">{c.title}</h3>
									<span class="cmp-other-arrow">詳細を見る →</span>
								</div>
							</a>
						))}
					</div>

					<div class="cmp-all-btn-wrap">
						<a href="/campaigns" class="cmp-btn-all-campaigns">
							すべてのキャンペーン一覧へ
						</a>
					</div>
				</div>
			</section>
		)}
	</main>
</NicoleLayout>

<!-- ギャラリー切り替えスクリプト -->
<script is:inline>
	(() => {
		const btns = document.querySelectorAll('.cmp-thumb-btn');
		const img = document.getElementById('cmpGalleryImg');
		const badge = document.getElementById('cmpGalleryBadge');
		const cap = document.getElementById('cmpGalleryCap');

		if (!btns.length || !img) return;

		btns.forEach(btn => {
			btn.addEventListener('click', () => {
				btns.forEach(b => b.classList.remove('is-active'));
				btn.classList.add('is-active');

				const src = btn.getAttribute('data-img');
				const text = btn.getAttribute('data-cap');
				const idx = btn.getAttribute('data-idx');

				if (src && img) img.src = src;
				if (text && cap) cap.textContent = text;
				if (idx && badge) badge.textContent = `${idx} / ${btns.length}`;
			});
		});
	})();
</script>

<style>
	/* ============================================================== */
	/* 共通設定（厳格なモノトーン・高品格ルール準拠） */
	/* ============================================================== */
	.cmp-lp-page {
		background: #000000;
		color: #ffffff;
		min-height: 100vh;
		font-family: var(--font-body, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
		overflow-x: hidden;
	}

	.cmp-container {
		width: 100%;
		max-width: 1240px;
		margin: 0 auto;
		padding: 0 40px;
		box-sizing: border-box;
	}

	.cmp-container--standard {
		max-width: 960px;
	}

	.cmp-section {
		padding: 70px 0;
	}

	.cmp-section-heading {
		margin-bottom: 32px;
		border-bottom: 1px solid #1f1f23;
		padding-bottom: 16px;
	}

	.cmp-eyebrow {
		display: block;
		font-family: var(--font-mono, monospace);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: #71717a;
		margin-bottom: 6px;
	}

	.cmp-heading-title {
		font-size: 1.5rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0;
		letter-spacing: -0.01em;
	}

	/* ============================================================== */
	/* 1. HEROセクション（フルワイド 100vw） */
	/* ============================================================== */
	.cmp-hero {
		position: relative;
		width: 100%;
		min-height: 80vh;
		display: flex;
		align-items: flex-end;
		padding: 140px 0 60px;
		box-sizing: border-box;
		overflow: hidden;
	}

	.cmp-hero__media {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
	}

	.cmp-hero__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.cmp-hero__scrim {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.4) 0%,
			rgba(0, 0, 0, 0.15) 35%,
			rgba(0, 0, 0, 0.75) 75%,
			#000000 100%
		);
	}

	.cmp-hero__content {
		position: relative;
		z-index: 2;
		width: 100%;
	}

	.cmp-hero__top-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 24px;
		flex-wrap: wrap;
		gap: 16px;
	}

	.cmp-breadcrumbs__list {
		display: flex;
		align-items: center;
		gap: 8px;
		list-style: none;
		margin: 0;
		padding: 0;
		font-size: 11px;
		letter-spacing: 0.12em;
		color: rgba(255, 255, 255, 0.45);
	}

	.cmp-breadcrumbs__list a {
		color: rgba(255, 255, 255, 0.7);
		text-decoration: none;
	}

	.cmp-sep {
		opacity: 0.3;
	}

	.cmp-edit-btn {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 14px;
		background: rgba(0, 0, 0, 0.65);
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 999px;
		font-size: 11px;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		backdrop-filter: blur(8px);
		transition: all 0.2s ease;
	}

	.cmp-edit-btn:hover {
		background: #ffffff;
		color: #000000;
		border-color: #ffffff;
	}

	.cmp-edit-icon {
		width: 12px;
		height: 12px;
	}

	.cmp-hero__meta-strip {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 20px;
	}

	.cmp-pill {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.06em;
		padding: 5px 12px;
		border-radius: 4px;
		text-transform: uppercase;
	}

	.cmp-pill--status {
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.25);
		color: #ffffff;
	}

	.status-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: #ffffff;
		box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
	}

	.cmp-pill--brand {
		background: #ffffff;
		color: #000000;
	}

	.cmp-pill--cat {
		background: #18181b;
		border: 1px solid #27272a;
		color: #d4d4d8;
	}

	.cmp-pill--period {
		background: rgba(0, 0, 0, 0.6);
		border: 1px solid rgba(255, 255, 255, 0.15);
		color: #e4e4e7;
		font-family: var(--font-mono, monospace);
		font-weight: 500;
		text-transform: none;
	}

	.period-icon {
		width: 12px;
		height: 12px;
		opacity: 0.7;
	}

	.cmp-hero__title {
		font-size: 3rem;
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.02em;
		margin: 0 0 16px 0;
		max-width: 900px;
		color: #ffffff !important;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
	}

	.cmp-hero__lead {
		font-size: 1.125rem;
		line-height: 1.7;
		color: rgba(255, 255, 255, 0.8);
		max-width: 820px;
		margin: 0;
	}

	/* ============================================================== */
	/* 2. 3大特別特典ブロック（ワイド 1240px） */
	/* ============================================================== */
	.cmp-benefits-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.cmp-benefit-card {
		background: #09090b;
		border: 1px solid #1f1f23;
		border-radius: 8px;
		padding: 28px 24px;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}

	.cmp-benefit-card:hover {
		border-color: #3f3f46;
		transform: translateY(-2px);
	}

	.cmp-benefit-card__num {
		font-family: var(--font-mono, monospace);
		font-size: 12px;
		font-weight: 700;
		color: #71717a;
		margin-bottom: 12px;
	}

	.cmp-benefit-card__title {
		font-size: 1.1rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 10px 0;
		line-height: 1.4;
	}

	.cmp-benefit-card__text {
		font-size: 0.875rem;
		line-height: 1.7;
		color: #a1a1aa;
		margin: 0;
	}

	/* ============================================================== */
	/* 3 & 4. 左右スプリットブロック（左写真・右文 / 右写真・左文） */
	/* ============================================================== */
	.cmp-split-card {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 60px;
		align-items: center;
		background: #09090b;
		border: 1px solid #1f1f23;
		border-radius: 12px;
		padding: 44px;
		box-sizing: border-box;
	}

	.cmp-split-media {
		width: 100%;
		aspect-ratio: 4 / 3;
		border-radius: 8px;
		overflow: hidden;
		background: #18181b;
	}

	.cmp-split-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.cmp-split-card:hover .cmp-split-media img {
		transform: scale(1.03);
	}

	.cmp-split-content {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.cmp-split-title {
		font-size: 1.6rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 16px 0;
		line-height: 1.4;
		letter-spacing: -0.01em;
	}

	.cmp-split-desc {
		font-size: 0.95rem;
		line-height: 1.85;
		color: #a1a1aa;
		margin: 0 0 24px 0;
	}

	.cmp-btn-outline-pill {
		display: inline-flex;
		align-items: center;
		padding: 10px 22px;
		background: #18181b;
		border: 1px solid #3f3f46;
		border-radius: 999px;
		font-size: 0.85rem;
		font-weight: 600;
		color: #ffffff;
		text-decoration: none;
		transition: all 0.2s ease;
		width: fit-content;
	}

	.cmp-btn-outline-pill:hover {
		background: #ffffff;
		color: #000000;
		border-color: #ffffff;
	}

	/* パターンB: デスクトップでは右に写真、左にテキスト */
	.cmp-split-card--right-media .cmp-split-media {
		order: 2;
	}
	.cmp-split-card--right-media .cmp-split-content {
		order: 1;
	}

	/* ============================================================== */
	/* 帯（Band）システム ＆ フィーチャーカードブロック */
	/* ============================================================== */
	.cmp-band {
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		padding: 72px 0;
		box-sizing: border-box;
	}

	.cmp-band--dark {
		background: #09090b;
		border-top: 1px solid #1f1f23;
		border-bottom: 1px solid #1f1f23;
		color: #ffffff;
	}

	.cmp-band--light {
		background: #f4f4f6;
		border-top: 1px solid #e4e4e7;
		border-bottom: 1px solid #e4e4e7;
		color: #09090b;
	}

	.cmp-band-lead {
		font-size: 0.95rem;
		line-height: 1.7;
		color: #a1a1aa;
		margin: 8px 0 0 0;
	}

	.cmp-band-lead--dark {
		color: #52525b;
	}

	.cmp-section-heading--light .cmp-heading-title--dark {
		color: #09090b;
	}

	.cmp-eyebrow--dark {
		color: #71717a !important;
	}

	/* グリッドレイアウト（3カラム / 2カラム） */
	.cmp-feature-grid {
		display: grid;
		margin-top: 40px;
	}

	.cmp-feature-grid--3col {
		grid-template-columns: repeat(3, 1fr);
		gap: 28px;
	}

	.cmp-feature-grid--2col {
		grid-template-columns: repeat(2, 1fr);
		gap: 36px;
	}

	/* フィーチャーカード共通 */
	.cmp-feature-card {
		display: flex;
		flex-direction: column;
		border-radius: 12px;
		overflow: hidden;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
	}

	.cmp-feature-card:hover {
		transform: translateY(-4px);
	}

	/* ダーク帯用カード */
	.cmp-feature-card--dark {
		background: #141417;
		border: 1px solid #27272a;
	}

	.cmp-feature-card--dark:hover {
		border-color: #3f3f46;
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
	}

	/* ライト帯用カード */
	.cmp-feature-card--light {
		background: #ffffff;
		border: 1px solid #e4e4e7;
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
	}

	.cmp-feature-card--light:hover {
		border-color: #d4d4d8;
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
	}

	/* カード上部メディア */
	.cmp-feature-card__media {
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #1f1f23;
	}

	.cmp-feature-card__media--large {
		aspect-ratio: 16 / 9;
	}

	.cmp-feature-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.cmp-feature-card:hover .cmp-feature-card__media img {
		transform: scale(1.04);
	}

	/* カード下部テキストエリア */
	.cmp-feature-card__body {
		padding: 24px;
		display: flex;
		flex-direction: column;
		flex: 1;
	}

	.cmp-feature-card__tag {
		display: inline-block;
		font-size: 10px;
		font-family: var(--font-mono, monospace);
		font-weight: 700;
		letter-spacing: 0.1em;
		color: rgba(255, 255, 255, 0.5);
		margin-bottom: 8px;
	}

	.cmp-feature-card__tag--dark {
		color: #71717a;
	}

	.cmp-feature-card__title {
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.45;
		margin: 0 0 12px 0;
		color: #ffffff;
		letter-spacing: -0.01em;
	}

	.cmp-feature-card__title--dark {
		color: #09090b;
	}

	.cmp-feature-card__text {
		font-size: 0.88rem;
		line-height: 1.75;
		color: #a1a1aa;
		margin: 0;
		flex: 1;
	}

	.cmp-feature-card__text--dark {
		color: #52525b;
	}

	.cmp-feature-card__footer {
		margin-top: 20px;
		padding-top: 16px;
		border-top: 1px solid #f4f4f6;
	}

	.cmp-btn-band-action {
		display: inline-flex;
		align-items: center;
		font-size: 0.85rem;
		font-weight: 700;
		color: #09090b;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.cmp-btn-band-action:hover {
		color: #71717a;
	}

	/* ============================================================== */
	/* 5. 大迫力パノラマセクション（フルワイド 100vw 端から端まで） */
	/* ============================================================== */
	.cmp-panorama-section {
		width: 100%;
		padding: 40px 0;
		box-sizing: border-box;
	}

	.cmp-panorama-wrap {
		position: relative;
		width: 100vw;
		margin-left: calc(-50vw + 50%);
		height: 520px;
		overflow: hidden;
	}

	.cmp-panorama-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.cmp-panorama-scrim {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			180deg,
			rgba(0, 0, 0, 0.3) 0%,
			rgba(0, 0, 0, 0.6) 100%
		);
	}

	.cmp-panorama-caption {
		position: absolute;
		bottom: 40px;
		left: 0;
		width: 100%;
		z-index: 2;
	}

	.cmp-panorama-tag {
		font-family: var(--font-mono, monospace);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.2em;
		color: #a1a1aa;
		display: block;
		margin-bottom: 8px;
	}

	.cmp-panorama-text {
		font-size: 1.5rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0;
		max-width: 800px;
		line-height: 1.45;
	}

	/* ============================================================== */
	/* 6. 中央標準 960px（本文 ＆ ギャラリー ＆ FAQ） */
	/* ============================================================== */
	.cmp-body-p {
		font-size: 1rem;
		line-height: 1.9;
		color: #d4d4d8;
		margin: 0 0 20px 0;
	}

	.cmp-portable-text {
		color: #d4d4d8;
		line-height: 1.9;
		font-size: 1rem;
	}

	.cmp-portable-text :global(h2),
	.cmp-portable-text :global(h3) {
		color: #ffffff;
		font-weight: 700;
		margin-top: 32px;
		margin-bottom: 14px;
	}

	.cmp-gallery-slider {
		background: #09090b;
		border: 1px solid #1f1f23;
		border-radius: 8px;
		overflow: hidden;
		padding: 20px;
		margin: 48px 0;
	}

	.cmp-gallery-main-view {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		background: #18181b;
		border-radius: 6px;
		overflow: hidden;
	}

	.cmp-gallery-active-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.cmp-gallery-counter {
		position: absolute;
		bottom: 12px;
		right: 12px;
		padding: 4px 10px;
		background: rgba(0, 0, 0, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 999px;
		font-family: var(--font-mono, monospace);
		font-size: 11px;
		font-weight: 600;
		color: #ffffff;
	}

	.cmp-gallery-caption {
		font-size: 0.85rem;
		line-height: 1.6;
		color: #a1a1aa;
		margin: 14px 4px 16px;
	}

	.cmp-gallery-thumbs {
		display: flex;
		gap: 8px;
	}

	.cmp-thumb-btn {
		width: 80px;
		height: 50px;
		padding: 0;
		border: 2px solid transparent;
		border-radius: 4px;
		overflow: hidden;
		background: #18181b;
		cursor: pointer;
		opacity: 0.5;
		transition: all 0.2s ease;
	}

	.cmp-thumb-btn.is-active,
	.cmp-thumb-btn:hover {
		opacity: 1;
		border-color: #ffffff;
	}

	.cmp-thumb-btn img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* アコーディオンFAQ */
	.cmp-faq-block {
		margin-top: 56px;
	}

	.cmp-accordion-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	.cmp-accordion-item {
		background: #09090b;
		border: 1px solid #1f1f23;
		border-radius: 8px;
		overflow: hidden;
	}

	.cmp-accordion-summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 18px 20px;
		font-size: 0.95rem;
		font-weight: 600;
		color: #ffffff;
		cursor: pointer;
		list-style: none;
		user-select: none;
	}

	.cmp-accordion-summary::-webkit-details-marker {
		display: none;
	}

	.cmp-accordion-icon {
		font-size: 16px;
		color: #71717a;
		transition: transform 0.2s ease;
	}

	.cmp-accordion-item[open] .cmp-accordion-icon {
		transform: rotate(45deg);
	}

	.cmp-accordion-body {
		padding: 0 20px 20px;
		font-size: 0.875rem;
		line-height: 1.7;
		color: #a1a1aa;
	}

	.cmp-accordion-body p {
		margin: 0;
	}

	/* ============================================================== */
	/* 7. 最重要予約アクションカード（勝負所：アクセントレッド / 縦積みコンパクト） */
	/* ============================================================== */
	.cmp-container--narrow {
		max-width: 760px;
		margin: 0 auto;
		width: 100%;
	}

	.cmp-booking-card {
		background: #09090b;
		border: 1px solid #27272a;
		border-radius: 12px;
		padding: 40px 36px;
		box-sizing: border-box;
	}

	.cmp-booking-card--stacked {
		display: flex;
		flex-direction: column;
	}

	.cmp-booking-card--stacked .cmp-booking-header {
		text-align: center;
		margin-bottom: 24px;
	}

	.cmp-booking-title {
		font-size: 1.55rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 10px 0;
		letter-spacing: -0.01em;
	}

	.cmp-booking-desc {
		font-size: 0.92rem;
		line-height: 1.65;
		color: #a1a1aa;
		margin: 0 auto;
		max-width: 580px;
	}

	.cmp-booking-card--stacked .cmp-booking-actions {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-bottom: 28px;
		width: 100%;
	}

	/* 最重要ボタン（勝負所の赤） */
	.cmp-btn-cta-primary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		width: 100%;
		padding: 16px 28px;
		background: #dc2626;
		border: 1px solid #ef4444;
		border-radius: 6px;
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: #ffffff;
		text-decoration: none;
		transition: all 0.2s ease;
		box-shadow: 0 4px 16px rgba(220, 38, 38, 0.35);
		box-sizing: border-box;
	}

	.cmp-btn-cta-primary:hover {
		background: #b91c1c;
		border-color: #dc2626;
		box-shadow: 0 6px 20px rgba(220, 38, 38, 0.5);
		transform: translateY(-1px);
	}

	.cta-arrow {
		width: 16px;
		height: 16px;
		transition: transform 0.2s ease;
	}

	.cmp-btn-cta-primary:hover .cta-arrow {
		transform: translateX(3px);
	}

	.cmp-btn-cta-secondary {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		padding: 14px 24px;
		background: #18181b;
		border: 1px solid #27272a;
		border-radius: 6px;
		font-size: 0.9rem;
		font-weight: 600;
		color: #d4d4d8;
		text-decoration: none;
		transition: all 0.2s ease;
		box-sizing: border-box;
	}

	.cmp-btn-cta-secondary:hover {
		background: #27272a;
		border-color: #3f3f46;
		color: #ffffff;
	}

	.cmp-summary-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 14px 20px;
		border-top: 1px solid #1f1f23;
		padding-top: 24px;
		margin-bottom: 20px;
	}

	.cmp-summary-item {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.cmp-summary-k {
		font-size: 11px;
		color: #71717a;
	}

	.cmp-summary-v {
		font-size: 0.95rem;
		font-weight: 600;
		color: #ffffff;
	}

	.cmp-phone-strip {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 8px;
		padding-top: 16px;
		border-top: 1px solid #1f1f23;
		font-size: 0.85rem;
		color: #71717a;
	}

	.cmp-phone-num {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-mono, monospace);
		font-size: 1.1rem;
		font-weight: 700;
		color: #ffffff;
		text-decoration: none;
	}

	.phone-icon {
		width: 14px;
		height: 14px;
	}

	/* ============================================================== */
	/* 8. その他のキャンペーン */
	/* ============================================================== */
	.cmp-other-section {
		padding: 80px 0 100px;
		background: #08080a;
		border-top: 1px solid #1f1f23;
	}

	.cmp-other-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
		margin-bottom: 48px;
	}

	.cmp-other-card {
		background: #000000;
		border: 1px solid #1f1f23;
		border-radius: 8px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		transition: transform 0.25s ease, border-color 0.25s ease;
	}

	.cmp-other-card:hover {
		transform: translateY(-4px);
		border-color: #3f3f46;
	}

	.cmp-other-card__media {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #18181b;
	}

	.cmp-other-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.cmp-other-card:hover .cmp-other-card__media img {
		transform: scale(1.05);
	}

	.cmp-pill-mini {
		position: absolute;
		top: 12px;
		left: 12px;
		padding: 3px 8px;
		background: rgba(0, 0, 0, 0.75);
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 2px;
		font-size: 10px;
		font-weight: 700;
		color: #ffffff;
		text-transform: uppercase;
	}

	.cmp-other-card__body {
		padding: 20px;
		display: flex;
		flex-direction: column;
		flex-grow: 1;
	}

	.cmp-other-period {
		font-family: var(--font-mono, monospace);
		font-size: 11px;
		color: #71717a;
		margin-bottom: 8px;
	}

	.cmp-other-title {
		font-size: 1rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0 0 16px 0;
		line-height: 1.45;
		flex-grow: 1;
	}

	.cmp-other-arrow {
		font-size: 12px;
		font-weight: 600;
		color: #a1a1aa;
		transition: color 0.2s ease, transform 0.2s ease;
	}

