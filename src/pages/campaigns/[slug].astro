---
// src/pages/campaigns/[slug].astro
// ニコル・グループ キャンペーン＆フェア詳細ページ（Apple / Magazine スタイル 超リッチエディトリアル）
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import { getEmDashEntry, getEmDashCollection } from "emdash";
import { PortableText } from "emdash/ui";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/campaigns");
}

let item: any = null;
let allCampaigns: any[] = [];

// 1. EmDash から該当キャンペーンおよび全キャンペーンを取得
try {
	const res = await getEmDashCollection("campaigns" as any, { limit: 100 });
	if (res?.entries && res.entries.length > 0) {
		allCampaigns = res.entries.map((e: any) => {
			const d = e.data || e;
			return {
				id: e.id || d.slug,
				slug: e.id || d.slug,
				title: d.title || "",
				brand: d.brand || "BMW",
				category: d.category || "新車",
				period_text: d.period_text || "",
				featured_image: typeof d.featured_image === 'string' ? (d.featured_image.startsWith('{') ? JSON.parse(d.featured_image).src : d.featured_image) : (d.featured_image?.src || "/uploads/2026/02/DSC2293-scaled.avif"),
				excerpt: d.excerpt || "",
				target_locations: d.target_locations || "Nicole Group 全拠点",
				cta_label: d.cta_label || "試乗予約・お問い合わせ",
				cta_url: d.cta_url || "/contact"
			};
		});

		const found = res.entries.find((e: any) => (e.id === slug || e.data?.slug === slug || (e.data && e.data.slug === slug)));
		if (found) {
			const d = found.data || found;
			item = {
				id: found.id || d.slug || slug,
				slug: found.id || d.slug || slug,
				title: d.title || "",
				brand: d.brand || "BMW",
				category: d.category || "新車",
				period_text: d.period_text || "",
				period_start: d.period_start || "",
				period_end: d.period_end || "",
				featured_image: typeof d.featured_image === 'string' ? (d.featured_image.startsWith('{') ? JSON.parse(d.featured_image).src : d.featured_image) : (d.featured_image?.src || "/uploads/2026/02/DSC2293-scaled.avif"),
				featured_image_sp: typeof d.featured_image_sp === 'string' ? (d.featured_image_sp.startsWith('{') ? JSON.parse(d.featured_image_sp).src : d.featured_image_sp) : (d.featured_image_sp?.src || ""),
				excerpt: d.excerpt || "",
				content: d.content || null,
				target_locations: d.target_locations || "Nicole Group 全拠点",
				cta_label: d.cta_label || "試乗予約・お問い合わせ",
				cta_url: d.cta_url || "/contact",
				databaseId: found.data?.id || found.id,
				layout_type: d.layout_type || "2col"
			};
		}
	}
} catch (e) {
	console.error(`[campaigns] Failed to get campaign: ${slug}`, e);
}

// フォールバックデータ（未登録時の安全策）
if (!item) {
	const fallbackMap: Record<string, any> = {
		'bmw-autumn-test-drive-2026': {
			id: 'bmw-autumn-test-drive-2026',
			slug: 'bmw-autumn-test-drive-2026',
			title: 'BMW オータム・テストドライブ・フェア 2026',
			brand: 'BMW',
			category: '新車',
			period_text: '2026年11月1日(日) 〜 11月30日(月)',
			featured_image: '/uploads/2026/02/DSC2293-scaled.avif',
			excerpt: '最新のBMWモデルを体感できる特別試乗フェアを開催。期間中のご試乗・ご成約でNicole Group限定の特別記念品を進呈いたします。',
			target_locations: 'Nicole BMW 全拠点（本社ショールーム・横浜港北・青葉宮前・新百合ヶ丘・大田）',
			cta_label: '試乗予約はこちら',
			cta_url: '/contact',
			layout_type: '2col'
		},
		'mini-new-generation-debut-fair': {
			id: 'mini-new-generation-debut-fair',
			slug: 'mini-new-generation-debut-fair',
			title: 'MINI THE NEW GENERATION デビュー・フェア',
			brand: 'MINI',
			category: '新車',
			period_text: '2026年11月7日(土) 〜 11月23日(月・祝)',
			featured_image: '/uploads/2026/02/MINI-新百合ヶ丘.jpg',
			excerpt: '新世代MINIファミリーが一堂に集結。個性あふれるデザインとゴーカート・フィーリングを各ショールームでご体感ください。',
			target_locations: 'MINI 港北 / MINI 都筑 / MINI 新百合ヶ丘',
			cta_label: '来場予約はこちら',
			cta_url: '/contact'
		},
		'bmw-alpina-bps-special-selection': {
			id: 'bmw-alpina-bps-special-selection',
			slug: 'bmw-alpina-bps-special-selection',
			title: 'BMW & BMW ALPINA 認定中古車 特選オータム・セレクション',
			brand: 'ALPINA',
			category: '認定中古車',
			period_text: '2026年11月1日(日) 〜 11月30日(月)',
			featured_image: '/uploads/2026/02/BMW_MINI_BPS_MININEXT新百合ヶ丘2025.jpg',
			excerpt: '厳格な基準をクリアしたBMWおよびBMW ALPINA認定中古車を特別プライスでご案内。特別低金利ローンをご利用いただけます。',
			target_locations: 'BPS 横浜港北 / BPS 新百合ヶ丘 / ニコル世田谷',
			cta_label: '認定中古車在庫を見る',
			cta_url: '/locations'
		},
		'rolls-royce-private-preview-yokohama': {
			id: 'rolls-royce-private-preview-yokohama',
			slug: 'rolls-royce-private-preview-yokohama',
			title: 'ロールス・ロイス スペクター プライベート・プレビュー',
			brand: 'Rolls-Royce',
			category: '新車',
			period_text: '事前予約制・随時受付中',
			featured_image: '/uploads/2026/06/cq5dam.web_-e1780380151979.jpg',
			excerpt: 'ウルトラ・ラグジュアリー・クーペ「スペクター」を完全プライベート空間でご案内いたします。専任アンバサダーが極上の時間をお届けします。',
			target_locations: 'ロールス・ロイス・モーター・カーズ横浜 ショールーム',
			cta_label: 'プライベート内覧を予約する',
			cta_url: '/contact'
		},
		'ferrari-winter-clinic-service': {
			id: 'ferrari-winter-clinic-service',
			slug: 'ferrari-winter-clinic-service',
			title: 'Nicole Competizione ウィンター・チェックアップ・クリニック',
			brand: 'Ferrari',
			category: 'サービス',
			period_text: '2026年11月15日(日) 〜 12月20日(日)',
			featured_image: '/uploads/2026/02/0H9A1397.jpg',
			excerpt: 'フェラーリ正規ファクトリーによる冬期特別点検プログラム。最新専用テスター診断とエキスパートメカニックによる30項目徹底チェックを実施。',
			target_locations: 'Nicole Competizione サービスセンター（横浜川向）',
			cta_label: '入庫・点検予約',
			cta_url: '/contact'
		}
	};
	item = fallbackMap[slug] || null;
}

if (!item) {
	return Astro.redirect("/campaigns");
}

// 他のキャンペーン（Related）
const otherCampaigns = allCampaigns.filter(c => c.slug !== item.slug).slice(0, 3);

// 管理画面編集URL
const editUrl = `http://localhost:4321/_emdash/api/auth/dev-bypass?redirect=/_emdash/admin/content/campaigns/${item.databaseId || item.slug}`;

// サンプルギャラリー（ミニマル表示用・ルール準拠）
const sampleGallery = [
	{
		image: item.featured_image,
		caption: `${item.title} メインビジュアル。正規ショールームにて特別な体験をご提供いたします。`
	},
	{
		image: "/uploads/2026/02/DSC2293-scaled.avif",
		caption: "最新モデルを揃えたショールーム展示エリア。専任セールス・コンサルタントが丁寧にご案内します。"
	},
	{
		image: "/uploads/2026/02/0H9A1397.jpg",
		caption: "最新設備を備えた指定サービス工場。万全の体制でお客様のカーライフをサポートいたします。"
	}
];
---

<NicoleLayout 
	title={`${item.title} | キャンペーン・フェア - ニコル・グループ公式`}
	description={item.excerpt || `${item.title}の開催概要・特典情報・対象店舗をご案内します。`}
>
	<main class="cmp-lp-page">
		<!-- ============================================================== -->
		<!-- 1. シネマティック・フルスクリーンHERO（Apple Magazineスタイル） -->
		<!-- ============================================================== -->
		<section class="cmp-hero">
			<div class="cmp-hero__media">
				<picture>
					{item.featured_image_sp && (
						<source media="(max-width: 640px)" srcset={item.featured_image_sp} />
					)}
					<img 
						src={item.featured_image} 
						alt={item.title} 
						class="cmp-hero__img" 
						loading="eager" 
					/>
				</picture>
				<!-- 映画的グラデーション＆ビネット（文字の可読性を極限まで高める） -->
				<div class="cmp-hero__scrim"></div>
			</div>

			<div class="cmp-hero__content">
				<div class="cmp-container">
					<!-- パンくず & 管理画面編集リンク -->
					<div class="cmp-hero__top-row">
						<nav class="cmp-breadcrumbs" aria-label="Breadcrumb">
							<ol class="cmp-breadcrumbs__list">
								<li><a href="/">HOME</a></li>
								<li class="cmp-sep">/</li>
								<li><a href="/campaigns">CAMPAIGNS</a></li>
								<li class="cmp-sep">/</li>
								<li aria-current="page">{item.brand}</li>
							</ol>
						</nav>

						<a href={editUrl} class="cmp-edit-btn" title="CMS管理画面でこのキャンペーンを編集">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cmp-edit-icon">
								<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
								<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
							</svg>
							<span>キャンペーンを編集</span>
						</a>
					</div>

					<!-- バッジ行（高密度・左右バランス最適化） -->
					<div class="cmp-hero__meta-strip">
						<span class="cmp-pill cmp-pill--status">
							<span class="status-dot"></span>
							開催中
						</span>
						<span class="cmp-pill cmp-pill--brand">{item.brand}</span>
						<span class="cmp-pill cmp-pill--cat">{item.category}</span>
						<span class="cmp-pill cmp-pill--period">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="period-icon">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
								<line x1="16" y1="2" x2="16" y2="6"></line>
								<line x1="8" y1="2" x2="8" y2="6"></line>
								<line x1="3" y1="10" x2="21" y2="10"></line>
							</svg>
							{item.period_text}
						</span>
					</div>

					<!-- キャンペーン大見出し -->
					<h1 class="cmp-hero__title">{item.title}</h1>

					<!-- リード文 -->
					{item.excerpt && (
						<p class="cmp-hero__lead">{item.excerpt}</p>
					)}
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- 2. エディトリアル・レイアウト（管理画面で1カラム / 2カラム切り替え対応） -->
		<!-- ============================================================== -->
		<section class="cmp-editorial-section">
			<div class={`cmp-container cmp-editorial-grid ${item.layout_type === '1col' ? 'cmp-editorial-grid--1col' : ''}`}>
				
				<!-- メインカラム -->
				<div class="cmp-main-column">
					
					<!-- 3大特別特典プログラム（カードグリッド） -->
					<section class="cmp-benefits-block">
						<div class="cmp-section-heading">
							<span class="cmp-eyebrow">SPECIAL BENEFITS</span>
							<h2 class="cmp-heading-title">期間限定の特別プログラム ＆ ご成約特典</h2>
						</div>

						<div class="cmp-benefits-grid">
							<!-- 特典1 -->
							<div class="cmp-benefit-card">
								<div class="cmp-benefit-card__num">01</div>
								<h3 class="cmp-benefit-card__title">特別低金利プログラム</h3>
								<p class="cmp-benefit-card__text">
									対象モデルに期間限定の特別優遇金利を適用。頭金サポートや据置額設定など、お客様に最適なファイナンシャル・プランをご提案いたします。
								</p>
							</div>

							<!-- 特典2 -->
							<div class="cmp-benefit-card">
								<div class="cmp-benefit-card__num">02</div>
								<h3 class="cmp-benefit-card__title">ご来場・ご試乗記念品</h3>
								<p class="cmp-benefit-card__text">
									期間中にWeb事前予約の上、ショールームにご来場・ご試乗いただいたお客様へ、Nicole Group限定オリジナルギフトを進呈いたします。
								</p>
							</div>

							<!-- 特典3 -->
							<div class="cmp-benefit-card">
								<div class="cmp-benefit-card__num">03</div>
								<h3 class="cmp-benefit-card__title">下取り査定特別優遇</h3>
								<p class="cmp-benefit-card__text">
									現在お乗りの愛車をメーカー・車種問わず高価下取り査定。正規ディーラーならではの安心と透明性をもってお応えいたします。
								</p>
							</div>
						</div>
					</section>

					<!-- 本文（Portable Text または デフォルトリッチボディ） -->
					<section class="cmp-body-block">
						<div class="cmp-section-heading">
							<span class="cmp-eyebrow">CAMPAIGN DETAILS</span>
							<h2 class="cmp-heading-title">キャンペーン詳細 ＆ ご案内</h2>
						</div>

						{item.content ? (
							<div class="cmp-portable-text prose prose-invert">
								<PortableText value={item.content} />
							</div>
						) : (
							<div class="cmp-rich-article">
								<p class="cmp-body-p">
									Nicole Group各ショールームでは、皆様の日頃のご愛顧に感謝を込め、最新モデルの魅力を存分にご体感いただける特別なキャンペーンを開催いたしております。
								</p>
								<p class="cmp-body-p">
									卓越した走行性能と最新のデジタル・テクノロジーが融合した新世代ラインナップを豊富に取り揃え、お客様一人ひとりのライフスタイルに寄り添うご提案をお届けします。ゆったりとしたプライベート空間で、心ゆくまでご試乗・ご相談をお楽しみください。
								</p>
							</div>
						)}
					</section>

					<!-- 写真ギャラリー（ギャラリーフォーマットルール準拠：余計な見出し・ラベル一切なし） -->
					<section class="cmp-gallery-block">
						<div class="cmp-gallery-slider">
							<div class="cmp-gallery-main-view">
								<img 
									id="cmpGalleryImg" 
									src={sampleGallery[0].image} 
									alt="" 
									class="cmp-gallery-active-img" 
								/>
								<span id="cmpGalleryBadge" class="cmp-gallery-counter">1 / {sampleGallery.length}</span>
							</div>
							<p id="cmpGalleryCap" class="cmp-gallery-caption">{sampleGallery[0].caption}</p>

							<!-- サムネイルセレクター -->
							<div class="cmp-gallery-thumbs">
								{sampleGallery.map((g, idx) => (
									<button 
										type="button" 
										class={`cmp-thumb-btn ${idx === 0 ? 'is-active' : ''}`}
										data-img={g.image}
										data-cap={g.caption}
										data-idx={idx + 1}
										aria-label={`写真 ${idx + 1}`}
									>
										<img src={g.image} alt="" />
									</button>
								))}
							</div>
						</div>
					</section>

					<!-- アコーディオンFAQ ＆ 注意事項 -->
					<section class="cmp-faq-block">
						<div class="cmp-section-heading">
							<span class="cmp-eyebrow">FAQ & NOTES</span>
							<h2 class="cmp-heading-title">よくあるご質問 ＆ ご留意事項</h2>
						</div>

						<div class="cmp-accordion-list">
							<details class="cmp-accordion-item" open>
								<summary class="cmp-accordion-summary">
									<span>試乗は当日の飛び込みでも可能ですか？</span>
									<span class="cmp-accordion-icon">＋</span>
								</summary>
								<div class="cmp-accordion-body">
									<p>当日のご案内も可能ですが、フェア期間中は混雑が予想され、ご希望の試乗車が貸出中の場合もございます。Webフォームより事前予約をいただくことで、スムーズにお乗り比べいただけます。</p>
								</div>
							</details>

							<details class="cmp-accordion-item">
								<summary class="cmp-accordion-summary">
									<span>記念品やプレゼントの受け取り条件はありますか？</span>
									<span class="cmp-accordion-icon">＋</span>
								</summary>
								<div class="cmp-accordion-body">
									<p>事前Web予約のうえ、対象ショールームにてご試乗・ご商談アンケートにご協力いただいたお客様を対象とさせていただきます。なお、数量限定につき、無くなり次第終了となりますので予めご了承ください。</p>
								</div>
							</details>

							<details class="cmp-accordion-item">
								<summary class="cmp-accordion-summary">
									<span>他社ブランドの車両に乗っていますが、下取りは可能ですか？</span>
									<span class="cmp-accordion-icon">＋</span>
								</summary>
								<div class="cmp-accordion-body">
									<p>はい、国産車・輸入車を問わず全メーカーのお車を高価下取り査定させていただきます。車検証をお持ちいただければ、ご試乗の間に迅速に無料査定を実施いたします。</p>
								</div>
							</details>
						</div>
					</section>

					<!-- 1カラム選択時専用：末尾ワイドアクションカード -->
					{item.layout_type === '1col' && (
						<section class="cmp-wide-cta-block">
							<div class="cmp-cta-card cmp-cta-card--wide">
								<div class="cmp-cta-card__header">
									<span class="cmp-cta-tag">LIMITED FAIR</span>
									<h3 class="cmp-cta-title">フェア事前予約・商談申込</h3>
									<p class="cmp-cta-desc">
										専任セールス・コンサルタントが丁寧にご案内いたします。Web予約で優先的に試乗車をご用意いたします。
									</p>
								</div>

								<div class="cmp-wide-cta-actions">
									<a href={item.cta_url} class="cmp-btn-cta-primary cmp-btn-cta-primary--wide">
										<span>{item.cta_label}</span>
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="cta-arrow">
											<line x1="5" y1="12" x2="19" y2="12"></line>
											<polyline points="12 5 19 12 12 19"></polyline>
										</svg>
									</a>
									<a href="/locations" class="cmp-btn-cta-secondary cmp-btn-cta-secondary--wide">
										<span>開催ショールーム一覧を見る</span>
									</a>
								</div>

								<div class="cmp-summary-list cmp-summary-list--wide">
									<div class="cmp-summary-row">
										<span class="cmp-summary-k">対象ブランド</span>
										<span class="cmp-summary-v">{item.brand}</span>
									</div>
									<div class="cmp-summary-row">
										<span class="cmp-summary-k">開催期間</span>
										<span class="cmp-summary-v">{item.period_text}</span>
									</div>
									<div class="cmp-summary-row">
										<span class="cmp-summary-k">開催店舗</span>
										<span class="cmp-summary-v">{item.target_locations}</span>
									</div>
								</div>

								<div class="cmp-phone-card cmp-phone-card--wide">
									<span class="cmp-phone-label">お電話でのご予約・お問い合わせ</span>
									<a href="tel:0120980343" class="cmp-phone-num">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="phone-icon">
