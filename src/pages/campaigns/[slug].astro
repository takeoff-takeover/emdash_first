---
// src/pages/campaigns/[slug].astro
// ニコル・グループ キャンペーンLP（モジュラー型リッチデザインブロックシステム）
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import { getEmDashEntry, getEmDashCollection } from "emdash";
import { PortableText } from "emdash/ui";

const { slug } = Astro.params;

if (!slug) {
	return Astro.redirect("/campaigns");
}

let item: any = null;
let allCampaigns: any[] = [];

// 1. EmDash からキャンペーン情報を取得
try {
	const res = await getEmDashCollection("campaigns" as any, { limit: 100 });
	if (res?.entries && res.entries.length > 0) {
		allCampaigns = res.entries.map((e: any) => {
			const d = e.data || e;
			return {
				id: e.id || d.slug,
				slug: e.id || d.slug,
				title: d.title || "",
				brand: d.brand || "BMW",
				category: d.category || "新車",
				period_text: d.period_text || "",
				featured_image: typeof d.featured_image === 'string' ? (d.featured_image.startsWith('{') ? JSON.parse(d.featured_image).src : d.featured_image) : (d.featured_image?.src || "/uploads/2026/02/DSC2293-scaled.avif"),
				excerpt: d.excerpt || "",
				target_locations: d.target_locations || "Nicole Group 全拠点",
				cta_label: d.cta_label || "試乗予約・お問い合わせ",
				cta_url: d.cta_url || "/contact"
			};
		});

		const found = res.entries.find((e: any) => (e.id === slug || e.data?.slug === slug || (e.data && e.data.slug === slug)));
		if (found) {
			const d = found.data || found;
			item = {
				id: found.id || d.slug || slug,
				slug: found.id || d.slug || slug,
				title: d.title || "",
				brand: d.brand || "BMW",
				category: d.category || "新車",
				period_text: d.period_text || "",
				period_start: d.period_start || "",
				period_end: d.period_end || "",
				featured_image: typeof d.featured_image === 'string' ? (d.featured_image.startsWith('{') ? JSON.parse(d.featured_image).src : d.featured_image) : (d.featured_image?.src || "/uploads/2026/02/DSC2293-scaled.avif"),
				featured_image_sp: typeof d.featured_image_sp === 'string' ? (d.featured_image_sp.startsWith('{') ? JSON.parse(d.featured_image_sp).src : d.featured_image_sp) : (d.featured_image_sp?.src || ""),
				excerpt: d.excerpt || "",
				content: d.content || null,
				target_locations: d.target_locations || "Nicole Group 全拠点",
				cta_label: d.cta_label || "試乗予約・お問い合わせ",
				cta_url: d.cta_url || "/contact",
				databaseId: found.data?.id || found.id,
				layout_type: d.layout_type || "1col" // デモ用初期値
			};
		}
	}
} catch (e) {
	console.error(`[campaigns] Failed to get campaign: ${slug}`, e);
}

// フォールバックデータ
if (!item) {
	const fallbackMap: Record<string, any> = {
		'bmw-autumn-test-drive-2026': {
			id: 'bmw-autumn-test-drive-2026',
			slug: 'bmw-autumn-test-drive-2026',
			title: 'BMW オータム・テストドライブ・フェア 2026',
			brand: 'BMW',
			category: '新車',
			period_text: '2026年11月1日(日) 〜 11月30日(月)',
			featured_image: '/uploads/2026/02/DSC2293-scaled.avif',
			excerpt: '最新のBMWモデルを体感できる特別試乗フェアを開催。期間中のご試乗・ご成約でNicole Group限定の特別記念品を進呈いたします。',
			target_locations: 'Nicole BMW 全拠点（本社ショールーム・横浜港北・青葉宮前・新百合ヶ丘・大田）',
			cta_label: '試乗予約はこちら',
			cta_url: '/contact',
			layout_type: '2col'
		},
		'mini-new-generation-debut-fair': {
			id: 'mini-new-generation-debut-fair',
			slug: 'mini-new-generation-debut-fair',
			title: 'MINI THE NEW GENERATION デビュー・フェア',
			brand: 'MINI',
			category: '新車',
			period_text: '2026年11月7日(土) 〜 11月23日(月・祝)',
			featured_image: '/uploads/2026/08/169P90635275_highRes_mini-family-04-2026-scaled.jpg',
			excerpt: '新世代MINIファミリーが一堂に集結。個性あふれるデザインとゴーカート・フィーリングを各ショールームでご体感ください。',
			target_locations: 'MINI 港北 / MINI 都筑 / MINI 新百合ヶ丘',
			cta_label: '来場予約はこちら',
			cta_url: '/contact',
			layout_type: '1col'
		},
		'bmw-alpina-bps-special-selection': {
			id: 'bmw-alpina-bps-special-selection',
			slug: 'bmw-alpina-bps-special-selection',
			title: 'BMW & BMW ALPINA 認定中古車 特選オータム・セレクション',
			brand: 'ALPINA',
			category: '認定中古車',
			period_text: '2026年11月1日(日) 〜 11月30日(月)',
			featured_image: '/uploads/2026/02/BMW_MINI_BPS_MININEXT新百合ヶ丘2025.jpg',
			excerpt: '厳格な基準をクリアしたBMWおよびBMW ALPINA認定中古車を特別プライスでご案内。特別低金利ローンをご利用いただけます。',
			target_locations: 'BPS 横浜港北 / BPS 新百合ヶ丘 / ニコル世田谷',
			cta_label: '認定中古車在庫を見る',
			cta_url: '/locations',
			layout_type: '2col'
		},
		'rolls-royce-private-preview-yokohama': {
			id: 'rolls-royce-private-preview-yokohama',
			slug: 'rolls-royce-private-preview-yokohama',
			title: 'ロールス・ロイス スペクター プライベート・プレビュー',
			brand: 'Rolls-Royce',
			category: '新車',
			period_text: '事前予約制・随時受付中',
			featured_image: '/uploads/2026/06/cq5dam.web_-e1780380151979.jpg',
			excerpt: 'ウルトラ・ラグジュアリー・クーペ「スペクター」を完全プライベート空間でご案内いたします。専任アンバサダーが極上の時間をお届けします。',
			target_locations: 'ロールス・ロイス・モーター・カーズ横浜 ショールーム',
			cta_label: 'プライベート内覧を予約する',
			cta_url: '/contact',
			layout_type: '2col'
		},
		'ferrari-winter-clinic-service': {
			id: 'ferrari-winter-clinic-service',
			slug: 'ferrari-winter-clinic-service',
			title: 'Nicole Competizione ウィンター・チェックアップ・クリニック',
			brand: 'Ferrari',
			category: 'サービス',
			period_text: '2026年11月15日(日) 〜 12月20日(日)',
			featured_image: '/uploads/2026/02/0H9A1397.jpg',
			excerpt: 'フェラーリ正規ファクトリーによる冬期特別点検プログラム。最新専用テスター診断とエキスパートメカニックによる30項目徹底チェックを実施。',
			target_locations: 'Nicole Competizione サービスセンター（横浜川向）',
			cta_label: '入庫・点検予約',
			cta_url: '/contact',
			layout_type: '2col'
		}
	};
	item = fallbackMap[slug] || null;
}

if (!item) {
	return Astro.redirect("/campaigns");
}

const otherCampaigns = allCampaigns.filter(c => c.slug !== item.slug).slice(0, 3);
const editUrl = `http://localhost:4321/_emdash/api/auth/dev-bypass?redirect=/_emdash/admin/content/campaigns/${item.databaseId || item.slug}`;

// サンプルギャラリー（ルール準拠）
const sampleGallery = [
	{
		image: item.featured_image || "/uploads/2026/08/169P90635275_highRes_mini-family-04-2026-scaled.jpg",
		caption: `${item.title} メインビジュアル。正規ショールームにて特別な体験をご提供いたします。`
	},
	{
		image: "/uploads/2026/04/mini2P90618119_highRes_sir-paul-smith-und-d-1-scaled-e1779256599764.jpg",
		caption: "新世代MINIのデザインフィロソフィーを体感できる特別ショールーム展示。"
	},
	{
		image: "/uploads/2026/06/1P90515769_highRes_mini-crossover-highl-scaled.jpg",
		caption: "力強さと洗練を極めたエクステリア。全方位にわたる卓越したプロポーション。"
	},
	{
		image: "/uploads/2026/02/0H9A1397.jpg",
		caption: "最新設備を備えた指定サービス工場。万全の体制でお客様のカーライフをサポートいたします。"
	}
];
---

<NicoleLayout 
	title={`${item.title} | キャンペーン・フェア - ニコル・グループ公式`}
	description={item.excerpt || `${item.title}の開催概要・特典情報・対象店舗をご案内します。`}
>
	<main class="cmp-lp-page">
		<!-- ============================================================== -->
		<!-- ブロック1: 【フルワイド 100vw】大迫力シネマティックHERO -->
		<!-- ============================================================== -->
		<section class="cmp-hero">
			<div class="cmp-hero__media">
				<picture>
					{item.featured_image_sp && (
						<source media="(max-width: 640px)" srcset={item.featured_image_sp} />
					)}
					<img 
						src={item.featured_image} 
						alt={item.title} 
						class="cmp-hero__img" 
						loading="eager" 
					/>
				</picture>
				<div class="cmp-hero__scrim"></div>
			</div>

			<div class="cmp-hero__content">
				<div class="cmp-container">
					<div class="cmp-hero__top-row">
						<nav class="cmp-breadcrumbs" aria-label="Breadcrumb">
							<ol class="cmp-breadcrumbs__list">
								<li><a href="/">HOME</a></li>
								<li class="cmp-sep">/</li>
								<li><a href="/campaigns">CAMPAIGNS</a></li>
								<li class="cmp-sep">/</li>
								<li aria-current="page">{item.brand}</li>
							</ol>
						</nav>

						<a href={editUrl} class="cmp-edit-btn" title="CMS管理画面でこのキャンペーンを編集">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="cmp-edit-icon">
								<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
								<path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
							</svg>
							<span>キャンペーンを編集</span>
						</a>
					</div>

					<div class="cmp-hero__meta-strip">
						<span class="cmp-pill cmp-pill--status">
							<span class="status-dot"></span>
							開催中
						</span>
						<span class="cmp-pill cmp-pill--brand">{item.brand}</span>
						<span class="cmp-pill cmp-pill--cat">{item.category}</span>
						<span class="cmp-pill cmp-pill--period">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="period-icon">
								<rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
								<line x1="16" y1="2" x2="16" y2="6"></line>
								<line x1="8" y1="2" x2="8" y2="6"></line>
								<line x1="3" y1="10" x2="21" y2="10"></line>
							</svg>
							{item.period_text}
						</span>
					</div>

					<h1 class="cmp-hero__title">{item.title}</h1>

					{item.excerpt && (
						<p class="cmp-hero__lead">{item.excerpt}</p>
					)}
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- ブロック2: 【ワイド 1240px】3大特別特典プログラム（カードグリッド） -->
		<!-- ============================================================== -->
		<section class="cmp-section cmp-section--wide cmp-benefits-section">
			<div class="cmp-container">
				<div class="cmp-section-heading">
					<h2 class="cmp-heading-title">期間限定の特別プログラム ＆ ご成約特典</h2>
				</div>

				<div class="cmp-benefits-grid">
					<div class="cmp-benefit-card">
						<h3 class="cmp-benefit-card__title">特別低金利プログラム</h3>
						<p class="cmp-benefit-card__text">
							対象モデルに期間限定の特別優遇金利を適用。頭金サポートや据置額設定など、お客様に最適なファイナンシャル・プランをご提案いたします。
						</p>
					</div>

					<div class="cmp-benefit-card">
						<h3 class="cmp-benefit-card__title">ご来場・ご試乗記念品</h3>
						<p class="cmp-benefit-card__text">
							期間中にWeb事前予約の上、ショールームにご来場・ご試乗いただいたお客様へ、Nicole Group限定オリジナルギフトを進呈いたします。
						</p>
					</div>

					<div class="cmp-benefit-card">
						<h3 class="cmp-benefit-card__title">下取り査定特別優遇</h3>
						<p class="cmp-benefit-card__text">
							現在お乗りの愛車をメーカー・車種問わず高価下取り査定。正規ディーラーならではの安心と透明性をもってお応えいたします。
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- ブロック3: 【左右分割 A: 左に写真、右にテキスト】 -->
		<!-- ============================================================== -->
		<section class="cmp-section cmp-section--wide cmp-split-section">
			<div class="cmp-container">
				<div class="cmp-split-card cmp-split-card--left-media">
					<!-- 左：写真 -->
					<div class="cmp-split-media">
						<img src="/uploads/2026/04/mini2P90618119_highRes_sir-paul-smith-und-d-1-scaled-e1779256599764.jpg" alt="ショールームでの体験" loading="lazy" />
					</div>
					<!-- 右：テキスト -->
					<div class="cmp-split-content">
						<h3 class="cmp-split-title">最新ラインナップを揃えたプライベート試乗</h3>
						<p class="cmp-split-desc">
							Nicole Group各ショールームでは、厳選された最新モデルの試乗車を常時ご用意。市街地から高速走行まで、実車ならではの走行フィールや先進運転支援システムを専任コンサルタントのエスコートのもと存分にご体感いただけます。
						</p>
						<div class="cmp-split-actions">
							<a href="#cmp-booking" class="cmp-btn-outline-pill">試乗モデルについて相談する →</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- ブロック4: 【左右分割 B: 右に写真、左にテキスト】 -->
		<!-- ※スマホ（SP）では写真が自然に上、テキストが下へ自動並び替え -->
		<!-- ============================================================== -->
		<section class="cmp-section cmp-section--wide cmp-split-section">
			<div class="cmp-container">
				<div class="cmp-split-card cmp-split-card--right-media">
					<!-- PCでは右、スマホでは上に自動配置される写真 -->
					<div class="cmp-split-media">
						<img src="/uploads/2026/02/0H9A1397.jpg" alt="正規指定工場の技術力" loading="lazy" />
					</div>
					<!-- PCでは左、スマホでは下に自動配置されるテキスト -->
					<div class="cmp-split-content">
						<h3 class="cmp-split-title">マイスターが支える最高峰の安心と整備品質</h3>
						<p class="cmp-split-desc">
							ドイツ本国の厳しいトレーニングと認定を受けた熟練メカニックが常駐。最新鋭の専用診断テスターと専用特殊工具を駆使し、お乗りいただくすべての瞬間に揺るぎない歓びと安心をお約束いたします。
						</p>
						<div class="cmp-split-actions">
							<a href="/locations" class="cmp-btn-outline-pill">サービス拠点ネットワークを見る →</a>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- ★NEW★ ブロック5: 【全幅 100vw ダーク帯】×【3カラム・フィーチャーカード（写真＋見出し＋文）】 -->
		<!-- ============================================================== -->
		<section class="cmp-band cmp-band--dark">
			<div class="cmp-container">
				<div class="cmp-section-heading">
					<h2 class="cmp-heading-title">新世代モデルを彩る 3つの革新フィーチャー</h2>
					<p class="cmp-band-lead">洗練されたデザインと妥協なき走行性能を両立した、注目のハイライトをご紹介します。</p>
				</div>

				<!-- 3カラム：写真＋写真下に見出し＋テキスト -->
				<div class="cmp-feature-grid cmp-feature-grid--3col">
					<!-- カード 1 -->
					<div class="cmp-feature-card cmp-feature-card--dark">
						<div class="cmp-feature-card__media">
							<img src="/uploads/ix4/int-01.jpg" alt="円形OLEDセンター・ディスプレイ" loading="lazy" />
						</div>
						<div class="cmp-feature-card__body">
							<h3 class="cmp-feature-card__title">業界初 直径240mm 円形OLEDセンター・ディスプレイ</h3>
							<p class="cmp-feature-card__text">
								極薄ベゼルと高精細有機ELを採用。ナビゲーション、エンターテインメント、車両設定のすべてを直感的に操作できる未来のコックピット。
							</p>
						</div>
					</div>

					<!-- カード 2 -->
					<div class="cmp-feature-card cmp-feature-card--dark">
						<div class="cmp-feature-card__media">
							<img src="/uploads/2026/09/169KV_color_1er-e1789542842388.jpg" alt="進化したゴーカート・フィーリング" loading="lazy" />
						</div>
						<div class="cmp-feature-card__body">
							<h3 class="cmp-feature-card__title">俊敏さを極めた 進化系ゴーカート・フィーリング</h3>
							<p class="cmp-feature-card__text">
								低重心設計と高剛性シャシーがもたらす極上の回頭性。意のままにコーナーを駆けぬける純粋なドライビングの歓びを日常に。
							</p>
						</div>
					</div>

					<!-- カード 3 -->
					<div class="cmp-feature-card cmp-feature-card--dark">
						<div class="cmp-feature-card__media">
							<img src="/uploads/2026/02/MINI-新百合ヶ丘.jpg" alt="持続可能なヴィーガン・マテリアル" loading="lazy" />
						</div>
						<div class="cmp-feature-card__body">
							<h3 class="cmp-feature-card__title">上質と環境を調和させる 新開発リサイクル・テキスタイル</h3>
							<p class="cmp-feature-card__text">
								高品質リサイクルポリエステルを用いた温かみのあるダッシュボード編み込み素材。サステナブルでありながら圧倒的なプレミアム感を演出。
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- ブロック6: 【フルワイド 100vw】大迫力全画面パノラマビジュアル -->
		<!-- ============================================================== -->
		<section class="cmp-panorama-section">
			<div class="cmp-panorama-wrap">
				<img 
					src="/uploads/2026/09/169KV_color_X3-scaled.jpg" 
					alt="パノラマビジュアル" 
					class="cmp-panorama-img" 
					loading="lazy" 
				/>
				<div class="cmp-panorama-scrim"></div>
				<div class="cmp-panorama-caption">
					<div class="cmp-container">
						<p class="cmp-panorama-text">革新が宿るステアリングを握り、未来への扉を開く特別なひとときを。</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ============================================================== -->
		<!-- ★NEW★ ブロック7: 【全幅 100vw ライトグレー帯】×【2カラム大判・フィーチャーカード（写真＋見出し＋文）】 -->
		<!-- ============================================================== -->
		<section class="cmp-band cmp-band--light">
			<div class="cmp-container">
				<div class="cmp-section-heading cmp-section-heading--light">
					<h2 class="cmp-heading-title cmp-heading-title--dark">選べる2つの特別エディション ＆ パッケージ</h2>
					<p class="cmp-band-lead cmp-band-lead--dark">ライフスタイルに合わせて選べる2つの魅力的な仕様をご用意いたしました。</p>
				</div>

				<!-- 2カラム版：2つの大判写真＋写真下に見出し＋テキスト -->
				<div class="cmp-feature-grid cmp-feature-grid--2col">
					<!-- 大判カード 1 -->
					<div class="cmp-feature-card cmp-feature-card--light">
						<div class="cmp-feature-card__media cmp-feature-card__media--large">
