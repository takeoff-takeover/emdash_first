---
// src/pages/corporate.astro
// ニコル・グループ 会社概要（Nicole Connect マガジン同等の黒背景エディトリアルデザイン）
import NicoleLayout from "../layouts/NicoleLayout.astro";
import svgs from "../data/corporate-svgs.json";

const pageTitle = "会社概要 | Nicole Group 公式";
const pageDescription = "東京・神奈川エリアを中心にBMW、MINI、Rolls-Royce、Ferrariといった世界のプレミアム＆ラグジュアリーブランドを展開するニコル・グループの会社概要、代表メッセージ、5つの事業会社、企業データ、受賞歴をご紹介します。";

// 5つのグループ事業会社データ（ブランドロゴマークは除外、会社名ロゴのみ掲載）
const groupCompanies = [
	{
		id: "racing-japan",
		name: "ニコル・レーシング・ジャパン合同会社",
		role: "グループ中枢",
		est: "1977年設立",
		url: "/pages/nicole-racing-japan",
		desc: "ニコル・グループ全体の経営資源を最適化し、事業成長を支える中枢機能を担っています。経理・財務、総務、人事といった管理部門業務を集約するシェアードサービス機能に加え、グループ全体のブランド価値を高めるマーケティング戦略を立案・実行。各事業会社がお客様へのサービス提供に専念できる強固な経営支援体制を構築するとともに、グループのガバナンス強化とシナジーの最大化を推進しています。",
		logoIndex: 0
	},
	{
		id: "automobiles",
		name: "ニコル・オートモビルズ合同会社",
		role: "独国アルピナ社日本総代理店（-2025）",
		est: "1982年設立",
		url: "/pages/nicole-automobiles",
		desc: "アルピナ社日本総代理店として、これまで46年の長きに渡り8000台におよぶ名車を日本の選ばれたお客様にお届けしてまいりました。2025年12月31日アルピナ社によるBMW社へのアルピナ商標譲渡完了を経て、2026年1月1日からは、引き続き在庫車、中古車を中心にニコル世田谷、ニコル青山ショールームおよび、全国のBMW正規ディーラー・ネットワークを通じて販売とアフターサービスを提供してまいります。",
		logoIndex: 1
	},
	{
		id: "cars",
		name: "ニコル・カーズ合同会社",
		role: "BMW / MINI 正規ディーラー",
		est: "1988年設立",
		url: "/pages/nicole-cars",
		desc: "BMWならびにMINI正規ディーラーとして、東京都内にBMW新車ショールームを1拠点、神奈川エリアにBMW新車ショールームを4拠点、MINIショールームを3拠点、サービスセンター1拠点、ならびにBMW / MINI認定中古車センター2拠点にて活動しています。全国BMW最優秀・優秀ディーラー賞 通算23回獲得、全国唯一となるBMW最優秀ディーラー賞7度受賞、全国MINI最優秀・優秀ディーラー賞通算3度獲得。",
		logoIndex: 4
	},
	{
		id: "motorcars",
		name: "Nicole MotorCars合同会社",
		role: "ロールス・ロイス・モーター・カーズ正規ディーラー",
		est: "2009年設立",
		url: "/corporate/nicole-motorcars",
		desc: "2009年に英国ロールス・ロイス・モーター・カーズより神奈川エリアの正規ディーラーとして指名を受け設立されました。横浜みなとみらいに拠点を構え、2024年には日本初となる最新CIに基づいた新ショールームをオープン。同年、「グローバル・ビスポーク・オブ・ザ・イヤー」を受賞するなど、世界最高峰のラグジュアリーブランドに相応しい実績を誇ります。限られたお客様へ、比類なき満足と歓びを提供し続けています。",
		logoIndex: 6
	},
	{
		id: "competizione",
		name: "Nicole Competizione合同会社",
		role: "フェラーリ正規ディーラー",
		est: "2014年設立",
		url: "/pages/nicole-competizione",
		desc: "イタリアが誇る至高のブランド「フェラーリ」の正規ディーラーとして、横浜を拠点に包括的なサービスを展開しています。設立10年目となる2024年に初の日本最優秀ディーラーを獲得し、2025年には2年連続となる最優秀ディーラー賞を受賞いたしました。その確かな実績と情熱をもって、フェラーリという特別な世界観とライフスタイルをお届けしながら、お客様との揺るぎない信頼関係を築いています。",
		logoIndex: 8
	}
];

// 企業データ（4大指標：アイコン実測値に合わせて3,300台・22拠点に修正）
const corporateStats = [
	{
		num: "400",
		unit: "名",
		label: "社員数",
		sub: "グループ総従業員",
		svgIndex: 9
	},
	{
		num: "3,300",
		unit: "台",
		label: "年間販売台数",
		sub: "新車・認定中古車",
		svgIndex: 10
	},
	{
		num: "22",
		unit: "拠点",
		label: "拠点数",
		sub: "東京・神奈川ネットワーク",
		svgIndex: 11
	},
	{
		num: "No.1",
		unit: "水準",
		label: "BMW認定メカニック",
		sub: "BMWマイスター多数在籍",
		svgIndex: 12
	}
];

// 受賞歴データ
const awardsList = [
	{
		title: "全国BMW最優秀・優秀ディーラー賞",
		badge: "通算23回獲得",
		desc: "全国のBMW正規ディーラーネットワークの中で、顧客満足度・販売実績・技術力のすべてにおいて卓越した業績を継続。",
		svgIndex: 13
	},
	{
		title: "全国BMW最優秀ディーラー賞",
		badge: "全国唯一 7度受賞",
		desc: "日本国内のBMWディーラーとして前人未到の7度におよぶ全国最優秀ディーラー賞を受賞。",
		svgIndex: 14
	},
	{
		title: "全国MINI最優秀・優秀ディーラー賞",
		badge: "通算3度獲得",
		desc: "MINIブランドの洗練された世界観と卓越したサービスが高く評価され、最優秀・優秀ディーラー賞を通算3度獲得。",
		svgIndex: 15
	},
	{
		title: "ロールス・ロイス ビスポーク・ディーラー",
		badge: "2024年世界一",
		desc: "全世界のロールス・ロイス・ディーラーを対象とした「グローバル・ビスポーク・オブ・ザ・イヤー2024」において世界一を獲得。",
		svgIndex: 16
	},
	{
		title: "全国フェラーリ最優秀ディーラー賞",
		badge: "2年連続受賞",
		desc: "設立10年目の2024年に初の日本最優秀ディーラーを獲得後、2025年にも2年連続となる栄冠を獲得。",
		svgIndex: 17
	}
];

// 職場環境（8項目）
const workplaceFeatures = [
	"変革志向をサポートする環境",
	"グローバルな環境",
	"充実した各種インセンティブスキーム",
	"安定した年次昇給",
	"四半期ごとの社員表彰制度",
	"充実した社員研修制度",
	"メーカー/インポーター主催イベント参加",
	"社員イベント"
];

// 福利厚生（8項目）
const welfareFeatures = [
	"BMW/MINI車両購入優遇制度",
	"GW・夏季・年末年始休暇",
	"慶弔休暇（最大5日）/特別休暇（最大3日）",
	"各種保険完備",
	"保養所・ホテル割引",
	"スポーツクラブ会員優待",
	"選択型確定拠出年金（DC）",
	"退職金制度"
];

// Schema.org 構造化データ（JSON-LD）
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "AboutPage",
			"@id": "https://www.nicole.co.jp/corporate/#webpage",
			"url": "https://www.nicole.co.jp/corporate",
			"name": pageTitle,
			"description": pageDescription,
			"breadcrumb": {
				"@id": "https://www.nicole.co.jp/corporate/#breadcrumb"
			}
		},
		{
			"@type": "BreadcrumbList",
			"@id": "https://www.nicole.co.jp/corporate/#breadcrumb",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "HOME",
					"item": "https://www.nicole.co.jp/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "会社概要",
					"item": "https://www.nicole.co.jp/corporate"
				}
			]
		},
		{
			"@type": "Organization",
			"@id": "https://www.nicole.co.jp/#organization",
			"name": "ニコル・グループ",
			"alternateName": "Nicole Group",
			"url": "https://www.nicole.co.jp/",
			"logo": "https://www.nicole.co.jp/uploads/2026/01/NICOLE_N_LOGO_neg.svg",
			"founder": "Nicole Group",
			"foundingDate": "1977",
			"numberOfEmployees": {
				"@type": "QuantitativeValue",
				"value": 400
			},
			"parentOrganization": {
				"@type": "Organization",
				"name": "Penske Automotive Group, Inc."
			},
			"subOrganization": [
				{ "@type": "Organization", "name": "ニコル・レーシング・ジャパン合同会社" },
				{ "@type": "Organization", "name": "ニコル・オートモビルズ合同会社" },
				{ "@type": "Organization", "name": "ニコル・カーズ合同会社" },
				{ "@type": "Organization", "name": "Nicole MotorCars合同会社" },
				{ "@type": "Organization", "name": "Nicole Competizione合同会社" }
			]
		}
	]
};
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style is:global>
			body:has(.corporate-magazine-main),
			body:has(.corporate-magazine-main) #page,
			body:has(.corporate-magazine-main) #content,
			body:has(.corporate-magazine-main) .site-content,
			body:has(.corporate-magazine-main) #primary,
			body:has(.corporate-magazine-main) .content-area,
			body:has(.corporate-magazine-main) .ast-container {
				background-color: #040507 !important;
				background-image: none !important;
			}
		</style>
	</Fragment>

	<main class="corporate-magazine-main">
		<!-- 1. HERO COVER（元のDSC3504.jpg背景画像を活かした映画的大判カバー） -->
		<header class="corp-hero">
			<div class="corp-hero__media">
				<img 
					src="/uploads/2026/02/DSC3504.jpg" 
					alt="ニコル・グループ 会社概要" 
					class="corp-hero__img" 
					loading="eager" 
					decoding="async" 
				/>
				<div class="corp-hero__gradient"></div>
				<div class="corp-hero__side-vignette"></div>
			</div>

			<div class="corp-container corp-hero__inner">
				<nav class="corp-breadcrumbs" aria-label="パンくずリスト">
					<ol class="corp-breadcrumbs__list">
						<li class="corp-breadcrumbs__item"><a href="/" class="corp-breadcrumbs__link">HOME</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item" aria-current="page">会社概要</li>
					</ol>
				</nav>

				<h1 class="corp-hero__title">会社概要</h1>
				<p class="corp-hero__subtitle">
					<span class="corp-hero__phrase">東京・神奈川エリアを中心に、</span><span class="corp-hero__phrase">BMW、MINI、Rolls-Royce、Ferrariといった</span><span class="corp-hero__phrase">世界のプレミアム＆ラグジュアリーブランドを展開するニコル・グループ。</span><br class="corp-hero__br" /><span class="corp-hero__phrase">1977年の設立以来、</span><span class="corp-hero__phrase">卓越した実績と品質で</span><span class="corp-hero__phrase">お客様の期待を超える喜びをお届けしています。</span>
				</p>

				<!-- ページ内クイックナビゲーション -->
				<nav class="corp-subnav" aria-label="ページ内目次">
					<ul class="corp-subnav__list">
						<li><a href="#message" class="corp-subnav__pill">代表メッセージ</a></li>
						<li><a href="#movie" class="corp-subnav__pill">ブランドムービー</a></li>
						<li><a href="#structure" class="corp-subnav__pill">5つの事業会社</a></li>
						<li><a href="#corporatedata" class="corp-subnav__pill">企業データ</a></li>
						<li><a href="#awards" class="corp-subnav__pill">受賞歴</a></li>
						<li><a href="#culture" class="corp-subnav__pill">職場環境・福利厚生</a></li>
						<li><a href="#profile" class="corp-subnav__pill">会社基本データ</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<!-- 2. 代表メッセージ -->
		<section id="message" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<div class="corp-message-grid">
					<!-- 左列: 代表ポートレート写真（スマホ時はコンパクト表示） -->
					<div class="corp-message-visual">
						<div class="corp-message-portrait-wrap">
							<img 
								src="/uploads/2026/02/witt_pc-731x1024.jpg" 
								alt="ニコル・グループ 代表職務執行者 社長 ミヒャエル・ヴィット" 
								class="corp-message-portrait" 
								width="731" 
								height="1024" 
								loading="lazy" 
								decoding="async" 
							/>
							<div class="corp-message-portrait-caption">
								<span class="corp-message-portrait-title">代表職務執行者 社長</span>
								<strong class="corp-message-portrait-name">ミヒャエル・ヴィット</strong>
								<span class="corp-message-portrait-sub">Michael Witt</span>
							</div>
						</div>
					</div>

					<!-- 右列: メッセージ本文 -->
					<div class="corp-message-content">
						<header class="corp-section-header">
							<h2 class="corp-section-title">代表メッセージ</h2>
							<p class="corp-section-lead">共に働く仲間、お客様、パートナーの期待を超える喜びをお届けする</p>
						</header>

						<div class="corp-message-body">
							<p>ニコル・グループは、BMW、MINI、ロールス・ロイス、フェラーリといったブランドを扱い、神奈川県および東京都に拠点を構えるラグジュアリー・カーとプレミアム・カーのディーラーです。1977年に誕生して以来、7度の全国BMW最優秀ディーラー賞をはじめ、2年連続となるフェラーリ最優秀ディーラー賞、世界一となる、ロールス・ロイス・ビスポーク・ディーラー・オブ・ザ・イヤー2024の受賞など卓越した業績を残し続けています。また、2025年末まではアルピナの日本総輸入元として、全国のお客様に感動を提供してきた実績も、私たちの誇りです。</p>

							<p>2021年に私が社長に就任した年は、ニコル・グループが世界屈指のグローバル自動車グループである米国ペンスキー・オートモーティブ・グループ（PAG）の一員となった年でもありました。以来、これまで築き上げてきた当社の知見に加えて、PAGのグローバルな幅広い経験を活用しています。</p>

							<p>そんな私たちが目指しているのは、「共に働く仲間、お客様、パートナーの期待を超える喜びをお届けする」ということです。互いを思いやりながらオープンにコミュニケーションを図り、情熱的に仕事に尽力する。その積み重ねによりお客様と一生涯を通じた信頼関係を築くことで、皆様の期待を超えることができると信じています。</p>

							<p>昨今の自動車産業は、自動運転技術の進歩や環境へ配慮したEVへの転換など、変化の目まぐるしい業界です。社会的責任を果たして会社を成長させるために、私たちも企業文化や体制、仕組みを変えるなど、One Teamとしてチーム一丸となり挑戦し続けています。</p>

							<p>22拠点、約400人の従業員とともに、これからも最も信頼されるラグジュアリー・オートモーティブ・グループを目指して参りますので、宜しくお願いいたします。</p>
						</div>

						<footer class="corp-message-signature">
							<div class="corp-message-signature__meta">
								<span class="corp-message-signature__role">ニコル・グループ 代表職務執行者 社長</span>
								<span class="corp-message-signature__name">ミヒャエル・ヴィット</span>
							</div>
						</footer>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. ブランドムービー / 企業紹介 -->
		<section id="movie" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header corp-section-header--center">
					<h2 class="corp-section-title">ブランドムービー</h2>
					<p class="corp-section-subtitle">卓越したクラフトマンシップと、走る歓びを追求し続けるニコル・グループの世界観をご覧ください。</p>
				</header>

				<div class="corp-video-card">
					<div class="corp-video-wrapper">
						<iframe 
							src="https://www.youtube-nocookie.com/embed/EGMpK1YHiH8?rel=0&modestbranding=1" 
							title="Nicole Group Corporate Movie" 
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
							allowfullscreen 
							loading="lazy"
						></iframe>
					</div>
				</div>
			</div>
		</section>

		<!-- 4. 5つの事業会社（会社名ロゴのみ掲載） -->
		<section id="structure" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">ニコル・グループを構成する5つの事業会社</h2>
					<p class="corp-section-subtitle">専門性と誇りを持った5つの事業会社が連携し、世界最高峰のブランド体験をお客様にお届けします。</p>
				</header>

				<div class="corp-companies-grid">
					{groupCompanies.map((comp) => (
						<article class="corp-company-card">
							<header class="corp-company-card__header">
								<div class="corp-company-card__logo-wrap">
									<div class="corp-company-card__main-logo" set:html={svgs[comp.logoIndex]} />
								</div>
								<div class="corp-company-card__badges">
									<span class="corp-badge corp-badge--subtle">{comp.role}</span>
									<span class="corp-badge corp-badge--outline">{comp.est}</span>
								</div>
								<h3 class="corp-company-card__title">{comp.name}</h3>
							</header>

							<p class="corp-company-card__desc">{comp.desc}</p>

							<footer class="corp-company-card__footer">
								<a href={comp.url} class="corp-company-card__link">
									<span>会社詳細を見る</span>
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
								</a>
							</footer>
						</article>
					))}
				</div>
			</div>
		</section>

		<!-- 5. 企業データ（丸アイコン拡大・3,300台・22拠点） -->
		<section id="corporatedata" class="corp-section corp-section--bordered">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">企業データ</h2>
					<p class="corp-section-subtitle">半世紀近くにわたり築き上げてきた信頼と実績を数字でご紹介します。</p>
				</header>

				<div class="corp-stats-grid">
					{corporateStats.map((stat) => (
						<div class="corp-stat-card">
							<div class="corp-stat-card__badge" set:html={svgs[stat.svgIndex]} />
							<div class="corp-stat-card__content">
								<div class="corp-stat-card__figure">
									<span class="corp-stat-card__num">{stat.num}</span>
									<span class="corp-stat-card__unit">{stat.unit}</span>
								</div>
								<span class="corp-stat-card__label">{stat.label}</span>
								<span class="corp-stat-card__sub">{stat.sub}</span>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- 6. 受賞歴（アイコン拡大・3列レイアウト） -->
