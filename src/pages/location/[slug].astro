	}

	.dealer-address-text {
		font-size: 0.875rem;
		color: #94a3b8;
	}

	.link-inline-gmap {
		display: inline-flex;
		align-items: center;
		font-size: 0.8125rem;
		font-weight: 600;
		color: #34d399;
		background: rgba(16, 185, 129, 0.08);
		border: 1px solid rgba(16, 185, 129, 0.25);
		padding: 3px 10px;
		border-radius: 4px;
