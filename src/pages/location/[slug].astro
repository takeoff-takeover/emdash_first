	<!-- インタラクティブ スクリプト（ギャラリー & 上部バッジ連動） -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			// ギャラリーサムネイル切り替え
			const thumbBtns = document.querySelectorAll('.gallery-thumb-btn');
			const mainImg = document.getElementById('gallery-main-img');
			const counterEl = document.getElementById('gallery-counter');
			const captionEl = document.getElementById('gallery-caption');
			const totalCount = String(thumbBtns.length).padStart(2, '0');

			thumbBtns.forEach((btn, index) => {
				btn.addEventListener('click', () => {
					thumbBtns.forEach((b) => b.classList.remove('is-active'));
					btn.classList.add('is-active');

					const src = btn.getAttribute('data-src');
					const alt = btn.getAttribute('data-alt');
					const caption = btn.getAttribute('data-caption');

					if (mainImg && src) {
						mainImg.setAttribute('src', src);
						mainImg.setAttribute('alt', alt || '');
					}
					if (counterEl) {
						counterEl.textContent = `${String(index + 1).padStart(2, '0')} / ${totalCount}`;
					}
					if (captionEl) {
						captionEl.textContent = caption || '';
					}
				});
			});

			// 店舗・窓口情報 タブ切り替えロジック
			const tabBtns = document.querySelectorAll('.dept-tab-btn');
			const tabPanels = document.querySelectorAll('.dept-tab-panel');
			const tabContainer = document.getElementById('departments-tab-container');

			function switchTab(deptId, shouldScroll = false) {
				if (!deptId) return;

				tabBtns.forEach((btn) => {
					const isActive = btn.getAttribute('data-target-dept') === deptId;
					btn.classList.toggle('is-active', isActive);
					btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
				});

				tabPanels.forEach((panel) => {
					const isTarget = panel.id === `tab-panel-${deptId}`;
					panel.classList.toggle('is-active', isTarget);
				});

				if (shouldScroll && tabContainer) {
					tabContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
					flashHighlight(tabContainer);
				}
			}

			tabBtns.forEach((btn) => {
				btn.addEventListener('click', () => {
					const deptId = btn.getAttribute('data-target-dept');
					switchTab(deptId, false);
				});
			});

			// 上部ステータスバー クリック連動（該当タブを開いてスクロール）
			const deptPills = document.querySelectorAll('[data-dept-target]');
			deptPills.forEach((pill) => {
				pill.addEventListener('click', (e) => {
					e.preventDefault();
					const targetId = pill.getAttribute('data-dept-target');
					if (targetId) {
						switchTab(targetId, true);
					}
				});
			});

			function flashHighlight(el) {
				el.classList.remove('is-targeted');
				void el.offsetWidth;
				el.classList.add('is-targeted');
				setTimeout(() => {
					el.classList.remove('is-targeted');
				}, 1600);
			}
		});
	</script>
</NicoleLayout>

