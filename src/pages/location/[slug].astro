	/* 窓口タブ切り替えUI */
	.dept-tabs-container {
		background: #0d0f12;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 8px;
		overflow: hidden;
		margin-top: 6px;
		scroll-margin-top: 110px;
		transition: border-color 0.2s ease;
	}

	.dept-tabs-container.is-targeted {
		animation: targetGlow 1.4s ease-out;
	}

	.dept-tabs-nav {
		display: flex;
		align-items: stretch;
		background: rgba(255, 255, 255, 0.03);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		overflow-x: auto;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}

	.dept-tabs-nav::-webkit-scrollbar {
		display: none;
	}

	.dept-tab-btn {
		flex: 1;
		min-width: 140px;
		appearance: none;
		background: transparent;
		border: none;
		border-right: 1px solid rgba(255, 255, 255, 0.08);
		border-bottom: 3px solid transparent;
		padding: 16px 20px;
		color: #94a3b8;
		font-size: 0.9375rem;
		font-weight: 600;
		cursor: pointer;
		text-align: center;
		white-space: nowrap;
		transition: all 0.2s ease;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
	}

	.dept-tab-btn:last-child {
		border-right: none;
	}

	.dept-tab-btn:hover {
		color: #ffffff;
		background: rgba(255, 255, 255, 0.05);
	}

	.dept-tab-btn.is-active {
		color: #ffffff;
		background: #14161b;
		border-bottom-color: #ffffff;
		font-weight: 700;
	}

	.dept-panels-wrap {
		background: #14161b;
		padding: 24px 24px 28px;
	}

	.dept-tab-panel {
		display: none;
	}

	.dept-tab-panel.is-active {
		display: block;
		animation: tabFadeIn 0.25s ease;
	}

	@keyframes tabFadeIn {
		from {
			opacity: 0;
			transform: translateY(4px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.dept-compact-table {
		background: rgba(0, 0, 0, 0.3);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 8px;
		padding: 14px 18px;
		margin-bottom: 20px;
	}

	.dept-table-row {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		padding: 10px 0;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		font-size: 0.875rem;
	}

	.dept-table-row:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}

	.dept-table-row:first-child {
		padding-top: 0;
	}

	.d-label {
		color: #777777;
		font-weight: 500;
		width: 100px;
		flex-shrink: 0;
	}

	.d-val {
		color: #e0e0e0;
		text-align: right;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 2px;
		font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
	}

	.d-val--bold {
		font-weight: 700;
		color: #ffffff;
	}

	.d-val--desc {
		font-family: inherit;
		line-height: 1.5;
		color: #bbbbbb;
		font-size: 0.8125rem;
	}

	.d-tel {
		font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
		font-size: 1rem;
		font-weight: 700;
		color: #ffffff;
		text-decoration: none;
		letter-spacing: 0.02em;
	}

	.d-tel:hover {
		text-decoration: underline;
	}

	.d-fax {
		font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
		font-size: 0.9375rem;
		font-weight: 500;
		color: #cccccc;
		letter-spacing: 0.02em;
	}

	/* 部門アクションボタン */
	.dept-card__actions {
		display: flex;
		gap: 12px;
		flex-wrap: wrap;
	}

	.btn-dept-call {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 10px;
		flex: 1;
		min-width: 200px;
		padding: 13px 18px;
		background: #1c69d4;
		color: #ffffff;
		border-radius: 6px;
		font-weight: 700;
		font-size: 0.9375rem;
		text-decoration: none;
		box-shadow: 0 4px 14px rgba(28, 105, 212, 0.3);
		transition: all 0.2s ease;
	}

	.btn-dept-call:hover {
		background: #1557b0;
		box-shadow: 0 6px 18px rgba(28, 105, 212, 0.45);
		transform: translateY(-1px);
	}

	.btn-dept-call .act-icon {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}

	.btn-dept-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 13px 20px;
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.875rem;
		text-decoration: none;
		transition: all 0.2s ease;
	}

	.btn-dept-cta:hover {
		background: rgba(255, 255, 255, 0.16);
		border-color: rgba(255, 255, 255, 0.35);
	}

	/* マップコンテナボックス */
	.map-container-box {
		position: relative;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.15);
		margin-bottom: 32px;
		background: #111317;
	}

	.embedded-gmap {
		display: block;
	}

	.map-floating-bar {
		position: absolute;
		bottom: 16px;
		left: 16px;
		right: 16px;
		background: rgba(13, 15, 18, 0.92);
		backdrop-filter: blur(12px);
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 8px;
		padding: 14px 20px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
	}

	.map-floating-bar__info strong {
		display: block;
		font-size: 0.9375rem;
		color: #ffffff;
	}

	.map-floating-bar__info span {
		font-size: 0.8125rem;
		color: #999999;
	}

	.btn-gmap-direct {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 10px 18px;
		background: #0f9d58;
		color: #ffffff;
		border-radius: 6px;
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		box-shadow: 0 4px 14px rgba(15, 157, 88, 0.35);
		transition: all 0.2s ease;
	}

	.btn-gmap-direct:hover {
		background: #0b8043;
		box-shadow: 0 6px 18px rgba(15, 157, 88, 0.45);
		transform: translateY(-1px);
	}

	.btn-svg {
		width: 16px;
		height: 16px;
	}

	/* アクセスアコーディオン */
	.access-accordion-list {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.access-acc-item {
		background: #111317;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 10px;
		overflow: hidden;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.access-acc-item[open] {
		background: #14161b;
		border-color: rgba(255, 255, 255, 0.22);
	}

	.access-acc-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 18px 24px;
		cursor: pointer;
		user-select: none;
		list-style: none;
		transition: background 0.2s ease;
	}

	.access-acc-header::-webkit-details-marker {
		display: none;
	}

	.access-acc-header:hover {
		background: rgba(255, 255, 255, 0.03);
	}

	.access-acc-title-group {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.access-acc-icon {
		width: 20px;
		height: 20px;
		color: #ffffff;
		flex-shrink: 0;
	}

	.access-acc-title {
		font-size: 1.0625rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0;
		letter-spacing: -0.01em;
	}

	.access-acc-chevron {
		width: 18px;
		height: 18px;
		color: #888888;
		transition: transform 0.25s ease, color 0.2s ease;
		flex-shrink: 0;
	}

	.access-acc-item[open] .access-acc-chevron {
		transform: rotate(180deg);
		color: #ffffff;
	}

	.access-acc-body {
		padding: 0 24px 24px;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		margin-top: 4px;
		padding-top: 20px;
		animation: accFadeIn 0.2s ease;
	}

	.route-item {
		margin-bottom: 18px;
	}

	.route-item:last-child {
		margin-bottom: 0;
	}

	.route-tag {
		display: inline-block;
		font-size: 0.6875rem;
		font-weight: 700;
		color: #08090a;
		background: #ffffff;
		padding: 2px 7px;
		border-radius: 2px;
		margin-bottom: 6px;
		letter-spacing: 0.02em;
	}

	.route-item p {
		font-size: 0.875rem;
		line-height: 1.65;
		color: #bbbbbb;
		margin: 0;
