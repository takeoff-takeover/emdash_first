	.btn-all-reviews {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 9px 16px;
		background: rgba(16, 185, 129, 0.08);
		color: #34d399;
		border: 1px solid rgba(16, 185, 129, 0.3);
		border-radius: 6px;
		font-size: 0.8125rem;
		font-weight: 600;
