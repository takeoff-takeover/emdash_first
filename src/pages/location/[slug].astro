		justify-content: center;
		gap: 8px;
		padding: 13px 18px;
		background: #0f9d58;
		color: #ffffff;
		border: none;
		border-radius: 6px;
		font-weight: 700;
		font-size: 0.875rem;
		text-decoration: none;
		box-shadow: 0 4px 14px rgba(15, 157, 88, 0.3);
		transition: all 0.2s ease;
	}

	.btn-sidebar-route:hover {
		background: #0b8043;
		box-shadow: 0 6px 18px rgba(15, 157, 88, 0.45);
		transform: translateY(-1px);
	}

