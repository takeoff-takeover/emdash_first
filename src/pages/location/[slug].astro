---
// src/pages/location/[slug].astro
// 拠点詳細動的テンプレート（ショールーム・サービス工場・認定中古車の複合対応）
import { getEmDashEntry, decodeSlug } from "emdash";
import { DatabaseSync } from "node:sqlite";
import fs from "node:fs";
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import { getGooglePlaceReviews } from "../../utils/google-places";

const slug = decodeSlug(Astro.params.slug);

// 旧URLからの安全な301転送（新百合ヶ丘の統合に伴う恒久リダイレクト）
if (slug === 'bps-shinyurigaoka') {
	return Astro.redirect('/location/nicole-bmw-shinyurigaoka', 301);
}
if (slug === 'mini-next-shinyurigaoka') {
	return Astro.redirect('/location/mini-shinyurigaoka', 301);
}

if (!slug) {
	return Astro.rewrite("/404");
}

let loc: any = null;

// 1. EmDash API から取得
try {
	const res = await getEmDashEntry("locations" as any, slug);
	if (res?.entry) {
		loc = res.entry;
	}
} catch (e) {}

// 2. フォールバック: D1 SQLite ローカル直参照
if (!loc) {
	try {
		const DB_PATH = '.wrangler/state/v3/d1/miniflare-D1DatabaseObject/c5f74f54de1b54dfe248af0cae042e755774e9e90fc1e7dc6e84e3d6d7130474.sqlite';
		if (fs.existsSync(DB_PATH)) {
			const db = new DatabaseSync(DB_PATH);
			const row = db.prepare('SELECT * FROM ec_locations WHERE slug = ? AND (status = "published" OR status = "draft")').get(slug) as any;
			if (row) {
				loc = row;
			}
		}
	} catch (e) {
		console.error("D1 SQLite fallback query error:", e);
	}
}

if (!loc) {
	return Astro.rewrite("/404");
}

// EmDash entry の場合は entry.data にフィールドが格納されるため正規化
const d = loc.data || loc;

// データの安全なパース
const parseJson = (val: any, fallback: any) => {
	if (!val) return fallback;
	if (typeof val === 'object') return val;
	try {
		return JSON.parse(val);
	} catch (e) {
		return fallback;
	}
};

const featuredImageObj = parseJson(d.featured_image, null);
const featuredImageSrc = featuredImageObj?.src || (typeof d.featured_image === 'string' ? d.featured_image : '/uploads/2026/01/Nicole-BMW-本社.jpg');
const featuredImageAlt = featuredImageObj?.alt || d.title;

// 1. ギャラリー写真6点（個別フィールド gallery_image_1 〜 6 を優先、なければ従来の gallery JSON）
const customGallery: Array<{ src: string; caption?: string; alt?: string }> = [];
for (let i = 1; i <= 6; i++) {
	const imgVal = d[`gallery_image_${i}`];
	const capVal = d[`gallery_caption_${i}`];
	if (imgVal) {
		const parsed = parseJson(imgVal, null);
		const src = parsed?.src || (typeof imgVal === 'string' ? imgVal : '');
		const alt = parsed?.alt || capVal || `${d.title} 外観写真 ${i}`;
		if (src) {
			customGallery.push({ src, caption: capVal || '', alt });
		}
	}
}

const galleryList: Array<{ src: string; caption?: string; alt?: string }> = customGallery.length > 0
	? customGallery
	: parseJson(d.gallery, [
		{ src: featuredImageSrc, caption: `${d.title} 外観`, alt: d.title }
	]);

// 2. 部門窓口リスト（個別フィールド sales_*, used_*, service_* を優先、なければ従来の departments JSON）
const customDepartments: Array<{
	id: string;
	brand: string;
	type: 'sales' | 'used' | 'service';
	title: string;
	subtitle?: string;
	tel?: string;
	fax?: string;
	hours?: string;
	closed?: string;
	desc?: string;
	ctaLabel?: string;
	ctaUrl?: string;
}> = [];

// 新車部門
if (d.sales_title || (d.sales_enabled !== '0' && (d.sales_tel || d.tel))) {
	let autoSubtitle = d.sales_subtitle;
	if (!autoSubtitle) {
		if (d.slug === 'mini-shinyurigaoka') autoSubtitle = 'MINI 新百合ヶ丘';
		else if (d.title?.includes('川崎')) autoSubtitle = 'Nicole BMW 本社';
		else autoSubtitle = d.title;
	}
	customDepartments.push({
		id: 'dept-sales',
		brand: d.brand || 'BMW',
		type: 'sales',
		title: d.sales_title || `${d.brand || 'BMW'} 新車ショールーム`,
		subtitle: autoSubtitle,
		tel: d.sales_tel || d.tel || '',
		fax: d.sales_fax || '',
		hours: d.sales_hours || '10:00 〜 18:00',
		closed: d.sales_closed || '水曜日（祝日を除く）',
		desc: d.sales_desc || '',
		ctaLabel: d.sales_cta_label || '試乗・来場予約',
		ctaUrl: d.sales_cta_url || ''
	});
}

// 認定中古車部門
if (d.used_title || (d.used_enabled === '1' && d.used_title)) {
	let autoSubtitle = d.used_subtitle;
	if (!autoSubtitle) {
		if (d.slug === 'mini-shinyurigaoka') autoSubtitle = 'MINI NEXT 新百合ヶ丘';
		else if (d.title?.includes('新百合')) autoSubtitle = 'BMW Premium Selection 新百合ヶ丘';
		else autoSubtitle = d.title;
	}
	customDepartments.push({
		id: 'dept-used',
		brand: d.brand || 'BMW',
		type: 'used',
		title: d.used_title,
		subtitle: autoSubtitle,
		tel: d.used_tel || d.tel || '',
		fax: d.used_fax || '',
		hours: d.used_hours || '10:00 〜 18:00',
		closed: d.used_closed || '水曜日（祝日を除く）',
		desc: d.used_desc || '',
		ctaLabel: d.used_cta_label || '認定中古車を見る',
		ctaUrl: d.used_cta_url || ''
	});
}

// サービス整備部門
if (d.service_title || (d.service_enabled !== '0' && (d.service_tel || d.tel))) {
	let autoSubtitle = d.service_subtitle;
	if (!autoSubtitle) {
		if (d.slug === 'mini-shinyurigaoka') autoSubtitle = 'Nicole BMW 新百合ヶ丘支店';
		else if (d.title?.includes('川崎')) autoSubtitle = 'Nicole BMW サービスセンター';
		else autoSubtitle = d.title;
	}
	customDepartments.push({
		id: 'dept-service',
		brand: d.brand || 'BMW',
		type: 'service',
		title: d.service_title || `${d.brand || 'BMW'} サービスセンター`,
		subtitle: autoSubtitle,
		tel: d.service_tel || d.tel || '',
		fax: d.service_fax || '',
		hours: d.service_hours || '09:00 〜 18:00',
		closed: d.service_closed || '水曜日（祝日を除く）',
		desc: d.service_desc || '',
		ctaLabel: d.service_cta_label || 'サービス入庫予約',
		ctaUrl: d.service_cta_url || ''
	});
}

const departmentsList: Array<{
	id?: string;
	brand?: string;
	type?: string;
	title: string;
	subtitle?: string;
	tel?: string;
	fax?: string;
	hours?: string;
	closed?: string;
	desc?: string;
	ctaLabel?: string;
	ctaUrl?: string;
}> = customDepartments.length > 0 ? customDepartments : parseJson(d.departments, [
	{
		id: 'dept-0',
		brand: d.brand || 'BMW',
		title: `${d.brand || 'BMW'} ショールーム`,
		subtitle: d.title,
		tel: d.tel || '',
		fax: d.fax || '',
		hours: '10:00 - 18:00',
		closed: '水曜日（祝日を除く）',
		desc: '最新モデルを展示。専門スタッフが丁寧にご案内いたします。'
	}
]);

// 3. 上部ステータスピルバッジ（基本情報 badges のチェック項目を最優先し、地図と表記統一）
function resolveBadgeItem(item: any): { brand: string; label: string; targetId: string } {
	const rawLabel = typeof item === 'string' ? item : (item.label || '');
	let brand = typeof item === 'object' && item.brand ? item.brand : 'BMW';
	let targetId = typeof item === 'object' && item.targetId ? item.targetId : 'departments';

	if (rawLabel.startsWith('BMW') || rawLabel.includes('BMW（ALPINA）')) {
		brand = 'BMW';
	} else if (rawLabel.includes('Rolls-Royce') || rawLabel.includes('ロールス・ロイス')) {
		brand = 'Rolls-Royce';
	} else if (rawLabel.includes('Ferrari') || rawLabel.includes('フェラーリ')) {
		brand = 'Ferrari';
	} else if (rawLabel.includes('MINI') || rawLabel.includes('ミニ')) {
		brand = 'MINI';
	} else if (rawLabel.includes('ALPINA') || rawLabel.includes('アルピナ')) {
		brand = 'ALPINA';
	}

	if (rawLabel.includes('新車') || rawLabel.includes('車両')) {
		targetId = 'dept-newcar';
	} else if (rawLabel.includes('認定中古車') || rawLabel.includes('中古車')) {
		targetId = 'dept-usedcar';
	} else if (rawLabel.includes('サービス') || rawLabel.includes('点検') || rawLabel.includes('車検')) {
		targetId = 'dept-service';
	}

	return { brand, label: rawLabel, targetId };
}

let parsedBadges: Array<{ brand: string; label: string; targetId: string }> = [];
if (d.badges) {
	if (typeof d.badges === 'string') {
		const trimmed = d.badges.trim();
		if (trimmed.startsWith('[') && trimmed.endsWith(']')) {
			try {
				const arr = JSON.parse(trimmed);
				if (Array.isArray(arr)) parsedBadges = arr.map(resolveBadgeItem);
			} catch (e) {
				parsedBadges = trimmed.split(',').map(s => s.trim()).filter(Boolean).map(resolveBadgeItem);
			}
		} else {
			parsedBadges = trimmed.split(',').map(s => s.trim()).filter(Boolean).map(resolveBadgeItem);
		}
	} else if (Array.isArray(d.badges)) {
		parsedBadges = d.badges.map(resolveBadgeItem);
	}
}

const badgesList: Array<{ brand?: string; label: string; targetId?: string }> = parsedBadges.length > 0
	? parsedBadges
	: (customDepartments.length > 0
		? customDepartments.map(dept => {
			let label = '新車';
			if (dept.type === 'used') label = '認定中古車';
			if (dept.type === 'service') label = 'サービス';
			return {
				brand: dept.brand,
				label: `${dept.brand} ${label}`,
				targetId: dept.id
			};
		})
		: [
			{ brand: d.brand || 'BMW', label: `${d.brand || 'BMW'} 新車`, targetId: 'dept-0' }
		]);

const googleMapsUrl = d.google_maps_url || `https://maps.google.com/?q=${encodeURIComponent(`${d.title} ${d.address || ''}`)}`;

// 4. 同一敷地内 併設拠点案内のブランドロゴ判定 ＆ タイトル整形
const relatedHubTitle = d.related_hub_title || '';
const cleanRelatedHubTitle = relatedHubTitle.replace(/^同一敷地内[：:]\s*/, '');
const relatedHubUrl = d.related_hub_url || '';
let relatedHubBrandLogo = '/brands/bmw.svg';
let relatedHubBrandAlt = 'BMW';
const relatedCombined = `${relatedHubTitle} ${relatedHubUrl}`.toLowerCase();
if (relatedCombined.includes('mini')) {
	relatedHubBrandLogo = '/brands/mini.svg';
	relatedHubBrandAlt = 'MINI';
} else if (relatedCombined.includes('rolls')) {
	relatedHubBrandLogo = '/brands/rolls-royce.svg';
	relatedHubBrandAlt = 'Rolls-Royce';
} else if (relatedCombined.includes('alpina')) {
	relatedHubBrandLogo = '/brands/alpina-nicole.svg';
	relatedHubBrandAlt = 'ALPINA';
} else if (relatedCombined.includes('bmw')) {
	relatedHubBrandLogo = '/brands/bmw.svg';
	relatedHubBrandAlt = 'BMW';
}
// ブランド情報取得ヘルパー
function getBrandInfo(brandName?: string, fallbackText?: string): { src: string; alt: string; isMini: boolean } {
	const bName = (brandName || '').toLowerCase();
	const fb = (fallbackText || '').toLowerCase();
	const combined = `${bName} ${fb}`;

	if (bName.includes('mini') || (!bName && (fb.includes('mini') || fb.includes('ミニ')))) {
		return { src: '/brands/mini.svg', alt: 'MINI', isMini: true };
	}
	if (combined.includes('rolls') || combined.includes('ロールス')) {
		return { src: '/brands/rolls-royce.svg', alt: 'Rolls-Royce', isMini: false };
	}
	if (combined.includes('ferrari') || combined.includes('フェラーリ')) {
		return { src: '/brands/ferrari.svg', alt: 'Ferrari', isMini: false };
	}
	if (bName.includes('alpina') || (!bName && (fb.includes('alpina') || fb.includes('アルピナ')))) {
		return { src: '/brands/alpina-nicole.svg', alt: 'ALPINA', isMini: false };
	}
	if (combined.includes('bmw')) {
		return { src: '/brands/bmw.svg', alt: 'BMW', isMini: false };
	}
	if (combined.includes('nicole')) {
		return { src: '/brands/nicole-n-mark.svg', alt: 'Nicole', isMini: false };
	}
	return { src: '/brands/bmw.svg', alt: 'BMW', isMini: false };
}

const mainBrandInfo = getBrandInfo(d.brand, d.title);

// 営業中ステータス初期判定ヘルパー（JST日本標準時）
function getOpenStatus(hoursStr?: string, closedStr?: string): { isOpen: boolean; statusText: string; statusClass: string } {
	if (!hoursStr) return { isOpen: false, statusText: '営業時間外', statusClass: 'status--closed' };

	const now = new Date();
	const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
	const jst = new Date(utc + (3600000 * 9));
	const dayOfWeek = jst.getDay();
	const currentMins = jst.getHours() * 60 + jst.getMinutes();
	const dayNames = ['日', '月', '火', '水', '木', '金', '土'];
	const todayName = dayNames[dayOfWeek];

	const closed = closedStr || '';
	const targetDayStr = `${todayName}曜日`;
	if (closed.includes(targetDayStr)) {
		return { isOpen: false, statusText: '本日定休日', statusClass: 'status--holiday' };
	}

	const match = hoursStr.match(/(\d{1,2}):(\d{2})\s*[～〜\-–]\s*(\d{1,2}):(\d{2})/);
	if (match) {
		const startMins = parseInt(match[1], 10) * 60 + parseInt(match[2], 10);
		const endMins = parseInt(match[3], 10) * 60 + parseInt(match[4], 10);

		if (currentMins >= startMins && currentMins < endMins) {
			return { isOpen: true, statusText: '現在営業中', statusClass: 'status--open' };
		}
	}

	return { isOpen: false, statusText: '営業時間外', statusClass: 'status--closed' };
}

// 英名ブランドフレーズが途中で不自然に改行されないようノーブレークスペース（\u00A0）で保護
function protectPhrases(str: string): string {
	if (!str) return '';
	return str
		.replace(/BMW Premium Selection/g, 'BMW\u00A0Premium\u00A0Selection')
		.replace(/MINI NEXT/g, 'MINI\u00A0NEXT')
		.replace(/Rolls-Royce Motor Cars/g, 'Rolls-Royce\u00A0Motor\u00A0Cars');
}

const displayTitle = protectPhrases(d.title);
const displayRelatedHubTitle = protectPhrases(cleanRelatedHubTitle);

// Google Places API またはフォールバックモックから評価・レビューを取得
const placeData = await getGooglePlaceReviews({
	placeId: d.google_place_id,
	locationTitle: d.title,
	ratingOverride: d.google_rating_override,
	countOverride: d.google_reviews_count_override
});
---

<NicoleLayout
	title={`${d.title}｜正規ディーラー｜Nicole Group`}
	description={`${d.title}の店舗情報。住所: ${d.postal || ''} ${d.address || ''}、電話番号: ${d.sales_tel || d.tel || ''}。新車・認定中古車・車検整備・サービス工場の詳細をご案内します。`}
>
	<div class="showroom-page">
		<!-- ヒーローヘッダー -->
		<header class="sr-hero">
			<div class="sr-hero__media">
				<img src={featuredImageSrc} alt={featuredImageAlt} class="sr-hero__img" />
				<div class="sr-hero__overlay"></div>
			</div>

			<div class="sr-hero__content">
				<h1 class="sr-hero__title">
					{displayTitle}
				</h1>


			</div>
		</header>

		<!-- 拠点提供サービス・機能ステータスバー（ヒーロー直下） -->
		{badgesList && badgesList.length > 0 && (
			<section class="facility-feature-bar" aria-label="店舗機能・取扱サービス">
				<div class="facility-feature-container">
					<div class="facility-feature-list">
						{badgesList.map((badge, idx) => {
							const brandLower = (badge.brand || 'bmw').toLowerCase();
							let logoSrc = '/brands/bmw.svg';
							let logoClass = 'feat-brand-logo--bmw';
							if (brandLower.includes('mini')) {
								logoSrc = '/brands/mini.svg';
								logoClass = 'feat-brand-logo--mini';
							} else if (brandLower.includes('rolls')) {
								logoSrc = '/brands/rolls-royce.svg';
								logoClass = 'feat-brand-logo--rolls';
							} else if (brandLower.includes('ferrari')) {
								logoSrc = '/brands/ferrari.svg';
								logoClass = 'feat-brand-logo--ferrari';
							} else if (brandLower.includes('alpina')) {
								logoSrc = '/brands/alpina-nicole.svg';
								logoClass = 'feat-brand-logo--alpina';
							} else if (brandLower.includes('nicole')) {
								logoSrc = '/brands/nicole-n-mark.svg';
								logoClass = 'feat-brand-logo--nicole';
							}
							const isMini = brandLower.includes('mini');
							const targetAccId = badge.targetId || (departmentsList[idx]?.id || `dept-${idx}`);
							return (
								<a href={`#${targetAccId}`} class={`feat-pill ${isMini ? 'feat-pill--mini' : ''}`} data-dept-target={targetAccId}>
									<img src={logoSrc} alt={badge.brand || 'Brand'} class={`feat-brand-logo ${logoClass}`} />
									<span class="feat-label">{badge.label}</span>
								</a>
							);
						})}
					</div>
				</div>
			</section>
		)}

		<!-- メインコンテンツグリッド -->
		<div class="sr-content-wrap">
			<div class="sr-layout-grid">
				<!-- 左側：メイン詳細コンテンツ -->
				<div class="sr-main-col">
					<!-- ショールームコンセプト（デスクトップで表示） -->
					{(d.concept_title || d.concept_text) && (
						<section class="sr-section sr-section--concept">
							{d.concept_title && <h2 class="section-title">{d.concept_title}</h2>}
							{d.concept_text && (
								<div class="prose-content">
									{d.concept_text.split('\n\n').map((paragraph: string) => (
										<p>{paragraph}</p>
									))}
								</div>
							)}
						</section>
					)}

					<!-- 写真ギャラリー（大写真1点 + サムネイル） -->
					{galleryList && galleryList.length > 0 && (
						<section class="sr-section sr-section--gallery">
							<div class="gallery-container">
								<div class="gallery-main-frame">
									<img
										id="gallery-main-img"
										src={galleryList[0].src}
										alt={galleryList[0].alt || galleryList[0].caption || d.title}
										class="gallery-main-img"
									/>
									<div class="gallery-info-bar">
										<span id="gallery-counter" class="gallery-counter">01 / {String(galleryList.length).padStart(2, '0')}</span>
										<span id="gallery-caption" class="gallery-caption">{galleryList[0].caption || ''}</span>
									</div>
								</div>
								{galleryList.length > 1 && (
									<div class="gallery-thumbs-grid" role="tablist" aria-label="店舗写真サムネイル">
										{galleryList.map((photo, idx) => (
											<button
												type="button"
												class={`gallery-thumb-btn ${idx === 0 ? 'is-active' : ''}`}
												data-src={photo.src}
												data-alt={photo.alt || photo.caption || ''}
												data-caption={photo.caption || ''}
												data-idx={idx}
												aria-label={`写真 ${idx + 1}`}
											>
												<img src={photo.src} alt={photo.alt || photo.caption || ''} class="gallery-thumb-img" loading="lazy" />
											</button>
										))}
									</div>
								)}
							</div>
						</section>
					)}

					<!-- 店舗・窓口情報（基本情報 ＋ 各部門窓口アコーディオン） -->
					<section class="sr-section sr-section--depts" id="departments">
						<h2 class="section-title">店舗・窓口情報</h2>
						<p class="section-desc">ご商談予約や試乗、車検・点検のご相談は各直通窓口にて承ります。</p>

						<div class="dealer-info-card">
							<!-- 拠点共通・基本情報バー -->
							<div class="dealer-summary-bar">
								<div class="dealer-summary-title-wrap">
									<div class="dealer-summary-icon">
										<img src={mainBrandInfo.src} alt={mainBrandInfo.alt} class={`dealer-brand-logo ${mainBrandInfo.isMini ? 'dealer-brand-logo--mini' : ''}`} />
									</div>
									<h3 class="dealer-summary-name">{displayTitle}</h3>
								</div>
								<div class="dealer-summary-address">
									<span class="dealer-address-text">{d.postal} {d.address}</span>
									<a href={googleMapsUrl} target="_blank" rel="noopener noreferrer" class="link-inline-gmap">
										Googleマップ
									</a>
								</div>
							</div>

							<!-- 各部門アコーディオン -->
							<div class="dept-accordion-list" role="region" aria-label="店舗窓口一覧">
								{departmentsList.map((dept, idx) => {
									const deptId = dept.id || `dept-${idx}`;
									const isDefaultOpen = idx === 0;
									let tabTitle = dept.title;
									const t = (dept.type || '').toLowerCase();
									const title = dept.title || '';
									let isSalesDept = false;
									let isUsedDept = false;
									let isServiceDept = false;
									if (t === 'sales' || dept.id?.includes('sales') || (!t && title.includes('新車'))) {
										tabTitle = '新車（試乗・商談）';
										isSalesDept = true;
									} else if (t === 'used' || dept.id?.includes('used') || title.includes('中古')) {
										tabTitle = '認定中古車（試乗・商談）';
										isUsedDept = true;
									} else if (t === 'service' || dept.id?.includes('service') || title.includes('サービス') || title.includes('工場')) {
										tabTitle = 'サービス（整備・点検）';
										isServiceDept = true;
									}

									const openStatus = getOpenStatus(dept.hours, dept.closed);

									return (
										<details class="dept-acc-item" id={deptId} open={isDefaultOpen}>
											<summary class="dept-acc-header">
												<div class="dept-acc-title-group">
													{isSalesDept && (
														<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dept-acc-icon" style="transform: scaleX(-1);" aria-label="新車"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9C2.1 11.2 2 11.6 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
													)}
													{isUsedDept && (
														<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dept-acc-icon" aria-label="認定中古車">
															<path d="m21 8-2 2-1.5-3.7A2 2 0 0 0 15.64 5H8.36a2 2 0 0 0-1.86 1.3L5 10 3 8"/>
															<rect width="18" height="8" x="3" y="10" rx="2"/>
															<path d="M5 18v2"/>
															<path d="M19 18v2"/>
															<path d="M6.5 14h.01"/>
															<path d="M17.5 14h.01"/>
															<path d="m9.5 13.5 1.8 1.8 3.5-3.5" stroke-width="2.2"/>
														</svg>
													)}
													{isServiceDept && (
														<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="dept-acc-icon" aria-label="サービス・点検"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
													)}
													<h3 class="dept-acc-name">{tabTitle}</h3>
												</div>
												<div class="dept-acc-meta-preview">
													<span
														class={`dept-status-badge ${openStatus.statusClass}`}
														data-hours={dept.hours || ''}
														data-closed={dept.closed || ''}
													>
														<span class="status-pulse-dot" aria-hidden="true"></span>
														<span class="status-label">{openStatus.statusText}</span>
													</span>
													<svg class="dept-acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
												</div>
											</summary>
											<div class="dept-acc-body">
												<div class="dept-compact-table">
													{dept.subtitle && (
														<div class="dept-table-row">
															<span class="d-label">拠点名</span>
															<span class="d-val d-val--bold">{dept.subtitle}</span>
														</div>
													)}
													{dept.tel && (
														<div class="dept-table-row">
															<span class="d-label">TEL</span>
															<div class="d-val">
																<a href={`tel:${dept.tel}`} class="d-tel">{dept.tel}</a>
															</div>
														</div>
													)}
													{dept.fax && (
														<div class="dept-table-row">
															<span class="d-label">FAX</span>
															<span class="d-val d-fax">{dept.fax}</span>
														</div>
													)}
													{dept.hours && (
														<div class="dept-table-row">
															<span class="d-label">営業時間</span>
															<span class="d-val">{dept.hours}</span>
														</div>
													)}
													{dept.closed && (
														<div class="dept-table-row">
															<span class="d-label">定休日</span>
															<span class="d-val">{dept.closed}</span>
														</div>
													)}
													{dept.desc && (
														<div class="dept-table-row">
															<span class="d-label">案内</span>
															<span class="d-val d-val--desc">{dept.desc}</span>
														</div>
													)}
												</div>

												<div class="dept-card__actions">
													{dept.tel && (
														<a href={`tel:${dept.tel}`} class="btn-dept-call">
															<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="act-icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
															電話：{dept.tel}
														</a>
													)}
													{dept.ctaUrl && (
														<a href={dept.ctaUrl} target="_blank" rel="noopener noreferrer" class="btn-dept-cta">
