	<!-- インタラクティブ スクリプト（ギャラリー & 上部バッジ連動） -->
	<script is:inline>
		document.addEventListener('DOMContentLoaded', () => {
			// ギャラリーサムネイル切り替え
			const thumbBtns = document.querySelectorAll('.gallery-thumb-btn');
			const mainImg = document.getElementById('gallery-main-img');
			const counterEl = document.getElementById('gallery-counter');
			const captionEl = document.getElementById('gallery-caption');
			const totalCount = String(thumbBtns.length).padStart(2, '0');

			thumbBtns.forEach((btn, index) => {
				btn.addEventListener('click', () => {
					thumbBtns.forEach((b) => b.classList.remove('is-active'));
					btn.classList.add('is-active');

					const src = btn.getAttribute('data-src');
					const alt = btn.getAttribute('data-alt');
					const caption = btn.getAttribute('data-caption');

					if (mainImg && src) {
						mainImg.setAttribute('src', src);
						mainImg.setAttribute('alt', alt || '');
					}
					if (counterEl) {
						counterEl.textContent = `${String(index + 1).padStart(2, '0')} / ${totalCount}`;
					}
					if (captionEl) {
						captionEl.textContent = caption || '';
					}
				});
			});

			// 上部ステータスバー クリック連動（該当アコーディオンを開いてスクロール）
			const deptPills = document.querySelectorAll('[data-dept-target]');
			deptPills.forEach((pill) => {
				pill.addEventListener('click', (e) => {
					e.preventDefault();
					const targetId = pill.getAttribute('data-dept-target');
					if (!targetId) return;

					const targetAcc = document.getElementById(targetId);
					if (targetAcc) {
						targetAcc.open = true;
						targetAcc.scrollIntoView({ behavior: 'smooth', block: 'start' });
						flashHighlight(targetAcc);
					}
				});
			});

			function flashHighlight(el) {
				el.classList.remove('is-targeted');
				void el.offsetWidth;
				el.classList.add('is-targeted');
				setTimeout(() => {
					el.classList.remove('is-targeted');
				}, 1600);
			}

			// 営業中ステータス判定・更新（クライアント側リアルタイム同期）
			function updateBusinessHoursStatus() {
				const badges = document.querySelectorAll('.dept-status-badge');
				if (!badges || badges.length === 0) return;

				const now = new Date();
				const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
				const jst = new Date(utc + (3600000 * 9));
				const dayOfWeek = jst.getDay();
				const currentMins = jst.getHours() * 60 + jst.getMinutes();
				const dayNames = ['日', '月', '火', '水', '木', '金', '土'];
				const todayName = dayNames[dayOfWeek];

				badges.forEach((badge) => {
					const hoursStr = badge.getAttribute('data-hours') || '';
					const closedStr = badge.getAttribute('data-closed') || '';
					const labelEl = badge.querySelector('.status-label');

					if (!hoursStr) {
						badge.className = 'dept-status-badge status--closed';
						if (labelEl) labelEl.textContent = '営業時間外';
						return;
					}

					// 定休日判定
					const targetDayStr = todayName + '曜日';
					if (closedStr.includes(targetDayStr)) {
						badge.className = 'dept-status-badge status--holiday';
						if (labelEl) labelEl.textContent = '本日定休日';
						return;
					}

					// 営業時間判定 (例: 10:00～18:00)
					const match = hoursStr.match(/(\d{1,2}):(\d{2})\s*[～〜\-–]\s*(\d{1,2}):(\d{2})/);
					if (match) {
						const startMins = parseInt(match[1], 10) * 60 + parseInt(match[2], 10);
						const endMins = parseInt(match[3], 10) * 60 + parseInt(match[4], 10);

						if (currentMins >= startMins && currentMins < endMins) {
							badge.className = 'dept-status-badge status--open';
							if (labelEl) labelEl.textContent = '現在営業中';
						} else {
							badge.className = 'dept-status-badge status--closed';
							if (labelEl) labelEl.textContent = '営業時間外';
						}
					} else {
						badge.className = 'dept-status-badge status--closed';
						if (labelEl) labelEl.textContent = '営業時間外';
					}
				});
			}

			updateBusinessHoursStatus();
			setInterval(updateBusinessHoursStatus, 60000);
		});
	</script>
</NicoleLayout>

