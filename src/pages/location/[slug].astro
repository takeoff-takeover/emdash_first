								const title = dept.title || '';
								if (t === 'sales' || dept.id?.includes('sales') || (!t && title.includes('新車'))) {
									unifiedName = '新車（試乗・商談）';
								} else if (t === 'used' || dept.id?.includes('used') || title.includes('中古')) {
									unifiedName = '認定中古車（試乗・商談）';
								} else if (t === 'service' || dept.id?.includes('service') || title.includes('サービス') || title.includes('工場')) {
