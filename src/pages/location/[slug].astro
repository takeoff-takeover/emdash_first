	/* マップコンテナボックス */
	.map-container-box {
		position: relative;
		border-radius: 12px;
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.15);
		margin-bottom: 32px;
		background: #111317;
	}

	.embedded-gmap {
		display: block;
	}

	/* アクセスアコーディオン */
	.access-accordion-list {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.access-acc-item {
		background: #111317;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 10px;
		overflow: hidden;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.access-acc-item[open] {
		background: #14161b;
		border-color: rgba(255, 255, 255, 0.22);
	}

	.access-acc-header {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 18px 24px;
		cursor: pointer;
		user-select: none;
		list-style: none;
		transition: background 0.2s ease;
	}

	.access-acc-header::-webkit-details-marker {
		display: none;
	}

	.access-acc-header:hover {
		background: rgba(255, 255, 255, 0.03);
	}

	.access-acc-title-group {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.access-acc-icon {
		width: 20px;
		height: 20px;
		color: #ffffff;
		flex-shrink: 0;
	}

	.access-acc-title {
		font-size: 1.0625rem;
		font-weight: 700;
		color: #ffffff;
		margin: 0;
		letter-spacing: -0.01em;
	}

	.access-acc-chevron {
		width: 18px;
		height: 18px;
		color: #888888;
		transition: transform 0.25s ease, color 0.2s ease;
		flex-shrink: 0;
	}

	.access-acc-item[open] .access-acc-chevron {
		transform: rotate(180deg);
		color: #ffffff;
	}

	.access-acc-body {
		padding: 0 24px 24px;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		margin-top: 4px;
		padding-top: 20px;
		animation: accFadeIn 0.2s ease;
	}

	.route-item {
		margin-bottom: 18px;
	}

	.route-item:last-child {
		margin-bottom: 0;
	}

	.route-tag {
		display: inline-block;
		font-size: 0.6875rem;
		font-weight: 700;
		color: #08090a;
		background: #ffffff;
		padding: 2px 7px;
		border-radius: 2px;
		margin-bottom: 6px;
		letter-spacing: 0.02em;
	}

	.route-item p {
		font-size: 0.875rem;
		line-height: 1.65;
		color: #bbbbbb;
		margin: 0;
