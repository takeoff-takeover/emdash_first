---
import NicoleLayout from "../../../layouts/NicoleLayout.astro";

// ショールーム基本データ
const showroom = {
	id: "nicole-bmw-kawasaki",
	name: "Nicole BMW 本社ショールーム（川崎）",
	subName: "Nicole BMW Kawasaki Headquarters Showroom",
	brand: "BMW",
	facilityType: "正規ディーラー・ショールーム",
	postal: "〒212-0005",
	address: "神奈川県川崎市幸区戸手2-5-7",
	tel: "044-511-2000",
	telDirect: "044-543-5400",
	fax: "044-543-5410",
	businessHours: "10:00～18:00",
	closedDays: "水曜日（祝日の場合は営業・翌火曜または木曜休）",
	parking: "完備（敷地内 屋根付き来客用パーキング 15台・ハイルーフ車可）",
	lat: 35.5459772,
	lng: 139.6897264,
	googleMapsUrl: "https://maps.app.goo.gl/LRAu7RxGhwoWZJLk7",
	image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/01/Nicole-BMW-本社.jpg",
	services: ["新車販売", "試乗車常備", "M認定ディーラー", "BMW i (EV) 充電スポット", "ファイナンシャルサービス", "自動車保険", "下取り査定"],
};

// 展示車・試乗車モデル
const featuredVehicles = [
	{
		model: "BMW i7 xDrive60 Excellence",
		type: "BEV (完全電動フラッグシップセダン)",
		specs: "最高出力 544ps | 一充電走行距離 650km | シアタースクリーン完備",
		image: "https://images.unsplash.com/photo-1555215695-3004980ad54e?auto=format&fit=crop&w=1200&q=80",
		status: "展示中 / 試乗可能",
		tag: "FLAGSHIP BEV"
	},
	{
		model: "BMW X7 M60i xDrive",
		type: "3列ラグジュアリーSAV (4.4L V8 ツインターボ)",
		specs: "最高出力 530ps | 48Vマイルドハイブリッド | 6名乗りコンフォートシート",
		image: "https://images.unsplash.com/photo-1549399542-7e3f8b79c341?auto=format&fit=crop&w=1200&q=80",
		status: "展示中 / 試乗可能",
		tag: "M PERFORMANCE"
	},
	{
		model: "BMW M4 Competition Coupé M xDrive",
		type: "ハイパフォーマンスクーペ (直列6気筒 Mツインタボ)",
		specs: "最高出力 530ps | 0-100km/h 3.5秒 | カーボンルーフ",
		image: "https://images.unsplash.com/photo-1617814076367-b759c7d7e738?auto=format&fit=crop&w=1200&q=80",
		status: "ショールーム展示中",
		tag: "M HIGH PERFORMANCE"
	},
	{
		model: "BMW 320i M Sport",
		type: "スポーツセダン (2.0L 直列4気筒ツインパワー・ターボ)",
		specs: "俊敏なハンドリング | 最新BMWカーブド・ディスプレイ | ドライブレコーダー内蔵",
		image: "https://images.unsplash.com/photo-1580273916550-e323be2ae537?auto=format&fit=crop&w=1200&q=80",
		status: "試乗可能",
		tag: "SPORTS SEDAN"
	}
];

// 施設・設備の特長
const amenities = [
	{
		title: "BMW M 認定正規ディーラー",
		desc: "Mハイパフォーマンスモデルの専門知識と走行テストを重ねた「M専任コンサルタント」が常駐。特別な個別コンフィギュレーションをご案内します。",
		icon: "m-badge"
	},
	{
		title: "BMW i 150kW 超急速EV充電器",
		desc: "次世代電気自動車「BMW i」のための最新急速充電スタンドを2基完備。快適な充電待ち時間をお過ごしいただけます。",
		icon: "charging"
	},
	{
		title: "プライベート・オーナーズラウンジ",
		desc: "バリスタによる挽きたてのエスプレッソや厳選ドリンク、高速Wi-Fi、電源を完備した静謐で洗練されたラウンジ空間です。",
		icon: "lounge"
	},
	{
		title: "併設 本社サービスファクトリー",
		desc: "隣接する敷地に10ベイ以上の最新テスター完備リフトを備え、BMWマイスター整備士による迅速なクイック点検・車検が可能です。",
		icon: "workshop"
	}
];
---

<NicoleLayout
	title={`${showroom.name}｜川崎・幸区のBMW正規ディーラー｜Nicole Group`}
	description="Nicole BMW 本社（川崎）は、神奈川県川崎市幸区戸手にあるBMW正規ディーラーです。最新BMW全モデルの新車展示・試乗、Mハイパフォーマンス、EV充電スポット完備。併設サービス工場と連携し最高峰のサポートを提供します。"
>
	<div class="showroom-page">
		<!-- パンくずナビゲーション -->
		<nav class="breadcrumb-bar" aria-label="Breadcrumb">
			<div class="breadcrumb-inner">
				<a href="/" class="bc-link">ホーム</a>
				<span class="bc-sep">/</span>
				<a href="/location/" class="bc-link">店舗・拠点一覧</a>
				<span class="bc-sep">/</span>
				<span class="bc-current">Nicole BMW 本社（川崎）</span>
			</div>
		</nav>

		<!-- ヒーローヘッダー -->
		<header class="sr-hero">
			<div class="sr-hero__media">
				<img src={showroom.image} alt={showroom.name} class="sr-hero__img" />
				<div class="sr-hero__overlay"></div>
			</div>

			<div class="sr-hero__content">
				<div class="sr-hero__badges">
					<!-- BMW公式ロゴバッジ -->
					<div class="bmw-pill">
						<svg class="bmw-emblem-svg" viewBox="0 0 100 100" width="28" height="28">
							<circle cx="50" cy="50" r="48" fill="#111111" stroke="#ffffff" stroke-width="2.5"/>
							<circle cx="50" cy="50" r="37" fill="#ffffff"/>
							<path d="M50 13 A37 37 0 0 1 87 50 L50 50 Z" fill="#0066b1"/>
							<path d="M50 50 L13 50 A37 37 0 0 1 50 13 Z" fill="#ffffff"/>
							<path d="M50 50 L50 87 A37 37 0 0 1 13 50 Z" fill="#0066b1"/>
							<path d="M50 50 L87 50 A37 37 0 0 1 50 87 Z" fill="#ffffff"/>
							<circle cx="50" cy="50" r="37" fill="none" stroke="#000000" stroke-width="1.2"/>
							<text x="50" y="21" font-family="'Inter', sans-serif" font-weight="900" font-size="9.5" fill="#ffffff" text-anchor="middle">B</text>
							<text x="76" y="38" font-family="'Inter', sans-serif" font-weight="900" font-size="9.5" fill="#ffffff" text-anchor="middle">M</text>
							<text x="24" y="38" font-family="'Inter', sans-serif" font-weight="900" font-size="9.5" fill="#ffffff" text-anchor="middle">W</text>
						</svg>
						<span>BMW AUTHORIZED DEALER</span>
					</div>
					<div class="status-live-badge">
						<span class="live-dot"></span>
						本日営業中 10:00 - 18:00
					</div>
				</div>

				<h1 class="sr-hero__title">
					Nicole BMW 本社
					<span class="sr-hero__title-sub">川崎・幸区 ショールーム</span>
				</h1>
				<p class="sr-hero__lead">
					1988年の創業以来、首都圏のBMWファンに選ばれ続けてきたニコル・グループの中核旗艦拠点。<br />
					国道1号線（第二京浜）沿いに広がる洗練の空間で、駆けぬける歓びのすべてをお届けいたします。
				</p>

				<!-- クイックアクションバー -->
				<div class="sr-quick-actions">
					<a href={showroom.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn-action btn-action--primary">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="act-icon"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
						Googleマップでルート案内
					</a>
					<a href="#test-drive" class="btn-action btn-action--secondary">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="act-icon"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
						試乗・商談予約
					</a>
					<a href={`tel:${showroom.telDirect}`} class="btn-action btn-action--outline">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="act-icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
						電話する：{showroom.telDirect}
					</a>
				</div>
			</div>
		</header>

		<!-- メインコンテンツグリッド -->
		<div class="sr-content-wrap">
			<div class="sr-layout-grid">
				<!-- 左側：メイン詳細コンテンツ -->
				<div class="sr-main-col">
					<!-- ショールームコンセプト -->
					<section class="sr-section">
						<div class="section-tag">CONCEPT &amp; PHILOSOPHY</div>
						<h2 class="section-title">首都圏随一のスケールを誇る、BMWの美学が息づく空間</h2>
						<div class="prose-content">
							<p>
								Nicole BMW 本社ショールームは、東京都心と横浜を結ぶ大動脈・国道1号線（第二京浜）に面し、多摩川を越えてすぐの川崎市幸区戸手に位置します。
								最新のBMWコーポレートアイデンティティ（CI）に基づいたガラス張りの開放的な空間には、最新モデルからフラッグシップの7シリーズ、Mハイパフォーマンスモデルまで常時多彩なラインナップを展示。
							</p>
							<p>
								専門のトレーニングを積んだプロダクト・ジーニアスおよびセールス・コンサルタントが、お客様のライフスタイルに最適な一台をご提案。
								敷地内には広々とした来客用パーキング、急速充電器、そして熟練のBMWマイスターが待機する「Nicole BMW 本社サービス工場」を併設し、購入からアフターメンテナンスまでワンストップで最高峰の安心をお約束します。
							</p>
						</div>

						<!-- 提供サービス一覧 -->
						<div class="services-block">
							<h3 class="services-subheading">取扱サービス・対応内容</h3>
							<div class="services-grid">
								{showroom.services.map((srv) => (
									<div class="srv-chip">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="srv-check"><polyline points="20 6 9 17 4 12"/></svg>
										<span>{srv}</span>
									</div>
								))}
							</div>
						</div>
					</section>

					<!-- 展示車・試乗車ラインナップ -->
					<section class="sr-section" id="test-drive">
						<div class="section-tag">FEATURED VEHICLES</div>
						<div class="section-header-flex">
							<div>
								<h2 class="section-title">展示車・試乗可能モデル</h2>
								<p class="section-desc">Nicole BMW 本社にて実際にご体感いただける最新モデルの一部をご紹介します。</p>
							</div>
							<a href={`tel:${showroom.telDirect}`} class="btn-reserve-all">
								試乗のお問い合わせ →
							</a>
						</div>

						<div class="car-cards-grid">
							{featuredVehicles.map((car) => (
								<div class="car-card">
									<div class="car-card__media">
										<img src={car.image} alt={car.model} class="car-card__img" loading="lazy" />
										<span class="car-tag">{car.tag}</span>
										<span class="car-status-badge">{car.status}</span>
									</div>
									<div class="car-card__body">
										<h3 class="car-model">{car.model}</h3>
										<p class="car-type">{car.type}</p>
										<p class="car-specs">{car.specs}</p>
										<div class="car-card__actions">
											<a href={`tel:${showroom.telDirect}`} class="btn-car-testdrive">
												試乗を申し込む
											</a>
											<a href={showroom.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn-car-detail">
												店舗で見る ↗
											</a>
										</div>
									</div>
								</div>
							))}
						</div>
					</section>

					<!-- 施設・設備の特長 -->
					<section class="sr-section">
						<div class="section-tag">FACILITIES &amp; AMENITIES</div>
						<h2 class="section-title">洗練されたおもてなしと充実の設備</h2>
						<div class="amenities-grid">
							{amenities.map((am) => (
								<div class="amenity-card">
									<div class="amenity-icon-wrap">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="amenity-svg">
											<path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
										</svg>
									</div>
									<h3 class="amenity-title">{am.title}</h3>
									<p class="amenity-desc">{am.desc}</p>
								</div>
							))}
						</div>
					</section>

					<!-- アクセス案内 & Googleマップ連携セクション -->
					<section class="sr-section" id="access">
						<div class="section-tag">LOCATION &amp; ACCESS</div>
						<h2 class="section-title">アクセス &amp; Googleマップ連携</h2>
						<p class="section-desc">東京方面・横浜方面のどちらからも国道1号線経由で快適にお越しいただけます。</p>

						<!-- Googleマップ インタラクティブ埋め込みビュー -->
						<div class="map-container-box">
							<iframe
								src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3246.6669865103094!2d139.68753771525712!3d35.54597718022649!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x601860e0a5c0b115%3A0x6b6339174fca0349!2zTmljb2xlIEJNVyDmnKznqL4!5e0!3m2!1sja!2sjp!4v1700000000000!5m2!1sja!2sjp"
								width="100%"
								height="440"
								style="border:0; filter: contrast(1.05) saturate(0.9);"
								allowfullscreen=""
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								title="Nicole BMW 本社 Googleマップ"
								class="embedded-gmap"
							></iframe>

							<!-- 地図上フローティング連携バー -->
							<div class="map-floating-bar">
								<div class="map-floating-bar__info">
									<strong>Nicole BMW 本社（川崎）</strong>
									<span>神奈川県川崎市幸区戸手2-5-7</span>
								</div>
								<div class="map-floating-bar__btns">
									<a href={showroom.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn-gmap-direct">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-svg"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
										Google Maps で経路案内を開く
									</a>
								</div>
							</div>
						</div>

						<!-- アクセスルート詳細 -->
						<div class="access-routes-grid">
							<!-- お車 -->
							<div class="route-card">
								<div class="route-header">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="route-icon"><rect width="16" height="10" x="4" y="5" rx="2"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="16.5" cy="17.5" r="2.5"/></svg>
									<h3>お車でお越しの方</h3>
								</div>
								<div class="route-item">
									<span class="route-tag">東京方面より</span>
									<p>国道1号線（第二京浜）を横浜方面へ直進。多摩川にかかる「多摩川大橋」を渡り、約800メートル先左側にございます。</p>
								</div>
								<div class="route-item">
									<span class="route-tag">横浜方面より</span>
									<p>国道1号線（第二京浜）を東京方面へ直進。信号「遠藤町」交差点を通過し、約200メートル先の右側にございます。（中央分離帯がございますので店舗前でのUターンにご注意ください）</p>
								</div>
								<div class="parking-note">
									<strong>駐車場のご案内：</strong> 敷地内に屋根付きのお客様専用パーキング（15台収容）を完備しております。雨天時でも濡れずにショールームへお入りいただけます。
								</div>
							</div>

							<!-- 電車・バス -->
							<div class="route-card">
								<div class="route-header">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="route-icon"><rect width="18" height="14" x="3" y="4" rx="2"/><line x1="3" x2="21" y1="10" y2="10"/><circle cx="7" cy="14" r="1"/><circle cx="17" cy="14" r="1"/></svg>
									<h3>電車・バスでお越しの方</h3>
								</div>
								<div class="route-item">
									<span class="route-tag">JR川崎駅より（東海道線・京浜東北線・南武線）</span>
									<p>西口北バスターミナル（ラゾーナ川崎プラザ側）より、反01系統 81番 東急バス「五反田駅行」に乗車。「戸手一丁目」バス停にて下車すぐ（所要時間：約10分）。</p>
								</div>
								<div class="route-item">
									<span class="route-tag">JR五反田駅より（山手線・都営浅草線）</span>
									<p>東急バス「川崎駅行」に乗車。「戸手1丁目」バス停にて下車すぐ。</p>
								</div>
								<div class="parking-note">
									<strong>タクシーをご利用の場合：</strong> JR川崎駅西口タクシー乗り場より約7分。「第二京浜の戸手のNicole BMW本社ショールーム」とお伝えください。
								</div>
							</div>
						</div>
					</section>
				</div>

				<!-- 右側：スティッキー店舗情報サイドバー -->
				<aside class="sr-sidebar">
					<div class="sidebar-card">
						<div class="sidebar-header">
							<span class="sidebar-label">DEALER INFORMATION</span>
							<h3 class="sidebar-title">店舗基本情報</h3>
						</div>

						<div class="sidebar-info-list">
							<div class="sb-item">
								<span class="sb-key">店舗名称</span>
								<span class="sb-val sb-val--bold">{showroom.name}</span>
							</div>
							<div class="sb-item">
								<span class="sb-key">所在地</span>
								<div class="sb-val">
									<span class="postal">{showroom.postal}</span>
									<span>{showroom.address}</span>
									<a href={showroom.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="link-inline-gmap">
										Googleマップで開く ↗
									</a>
								</div>
							</div>
							<div class="sb-item">
								<span class="sb-key">電話番号（代表）</span>
								<span class="sb-val"><a href={`tel:${showroom.tel}`} class="tel-link">{showroom.tel}</a></span>
							</div>
							<div class="sb-item">
								<span class="sb-key">ショールーム直通</span>
								<span class="sb-val"><a href={`tel:${showroom.telDirect}`} class="tel-link tel-link--highlight">{showroom.telDirect}</a></span>
							</div>
							<div class="sb-item">
								<span class="sb-key">FAX</span>
								<span class="sb-val">{showroom.fax}</span>
							</div>
							<div class="sb-item">
								<span class="sb-key">営業時間</span>
								<span class="sb-val">{showroom.businessHours}</span>
							</div>
							<div class="sb-item">
								<span class="sb-key">定休日</span>
								<span class="sb-val">{showroom.closedDays}</span>
							</div>
							<div class="sb-item">
								<span class="sb-key">駐車場</span>
								<span class="sb-val">{showroom.parking}</span>
							</div>
							<div class="sb-item">
								<span class="sb-key">運営法人</span>
