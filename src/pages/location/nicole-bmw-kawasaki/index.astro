---
import NicoleLayout from "../../../layouts/NicoleLayout.astro";

// ショールーム＆サービス統合拠点データ
const showroom = {
	id: "nicole-bmw-kawasaki",
	name: "Nicole BMW 本社（川崎）",
	subName: "Nicole BMW Kawasaki Headquarters & Service Center",
	brand: "BMW",
	serviceBrands: ["BMW", "MINI"],
	facilityType: "BMW正規ディーラー（ショールーム・サービス工場併設）",
	postal: "〒212-0005",
	address: "神奈川県川崎市幸区戸手2-5-7",
	tel: "044-511-2000",
	telDirect: "044-543-5400",
	serviceTel: "044-522-1500",
	fax: "044-543-5410",
	businessHours: "10:00～18:00（ショールーム） / 9:00～18:00（サービス）",
	closedDays: "水曜日（祝日の場合は営業）",
	parking: "完備（敷地内 屋根付き来客用パーキング 15台・ハイルーフ車可）",
	lat: 35.5459772,
	lng: 139.6897264,
	googleMapsUrl: "https://maps.app.goo.gl/LRAu7RxGhwoWZJLk7",
	image: "/uploads/2026/01/Nicole-BMW-本社.jpg",
	services: ["BMW 新車販売", "最新試乗車常備", "BMW M認定ディーラー", "BMW i (EV) 急速充電", "BMW/MINI 正規車検・点検", "ファイナンシャルサービス", "自動車保険", "下取り査定"],

	// 部門別データ
	departments: {
		sales: {
			name: "ショールーム（新車・試乗・ご商談）",
			brandBadge: "BMW",
			tel: "044-511-2000",
			telDirect: "044-543-5400",
			fax: "044-543-5410",
			hours: "10:00 〜 18:00",
			closed: "水曜日（祝日の場合は営業）",
			features: [
				"BMW 最新全モデルの新車展示・ご試乗",
				"BMW M 認定ディーラー（専任コンサルタント常駐）",
				"BMW i 超急速EV充電スタンド（150kW）完備",
				"オートローン・リース・自動車保険のご相談",
				"愛車査定・下取りのご相談"
			]
		},
		service: {
			name: "本社サービスセンター（車検・点検・整備工場）",
			brandBadges: ["BMW", "MINI"],
			tel: "044-522-1500",
			telDirect: "044-522-1500",
			hours: "09:00 〜 18:00",
			closed: "水曜日（祝日を除く）",
			note: "※BMWに加え、MINIの正規車検・点検・整備もワンストップで受け付けております。"
		}
	}
};

// ショールーム写真ギャラリー（6点）
const galleryPhotos = [
	{
		src: "/uploads/2026/01/Nicole-BMW-本社.jpg",
		alt: "Nicole BMW 本社 外観",
		caption: "国道1号線（第二京浜）沿いに面したNicole BMW 本社外観"
	},
	{
		src: "/uploads/2026/01/Nicole-BMW-本社-1.jpg",
		alt: "ショールーム内観",
		caption: "最新モデルを展示する開放的なメインショールーム"
	},
	{
		src: "/uploads/2026/02/BMWサービスセンター.jpg",
		alt: "本社サービス工場",
		caption: "BMW & MINIの車検・点検に対応する最新整備ベイ"
	},
	{
		src: "/uploads/2026/02/NicoleBMW青葉宮前2025.jpg",
		alt: "展示フロア",
		caption: "最新CIに基づいた洗練された車両展示エリア"
	},
	{
		src: "/uploads/2026/02/NicoleBMW大田支店2025.jpg",
		alt: "オーナーズラウンジ",
		caption: "点検や商談の際にご利用いただける静謐なラウンジスペース"
	},
	{
		src: "/uploads/2026/02/Nicole-BMW-横浜港北支店.jpg",
		alt: "デリバリーエリア",
		caption: "ご納車やお車の引き渡しを行う専用エリア"
	}
];
---

<NicoleLayout
	title={`${showroom.name}｜川崎・幸区のBMW正規ディーラー｜Nicole Group`}
	description="Nicole BMW 本社（川崎）は、神奈川県川崎市幸区戸手にあるBMW正規ディーラーです。最新BMW全モデルの新車展示・試乗、Mハイパフォーマンス、EV充電スポット完備。併設サービス工場と連携し最高峰のサポートを提供します。"
>
	<div class="showroom-page">
		<!-- ヒーローヘッダー（シンプル＆ゆとりのある構成） -->
		<header class="sr-hero">
			<div class="sr-hero__media">
				<img src={showroom.image} alt={showroom.name} class="sr-hero__img" />
				<div class="sr-hero__overlay"></div>
			</div>

			<div class="sr-hero__content">
				<span class="sr-hero__eyebrow">BMW AUTHORIZED DEALER</span>
				<h1 class="sr-hero__title">
					Nicole BMW 本社（川崎）
					<span class="sr-hero__title-sub">ショールーム ＆ 本社サービス工場</span>
				</h1>

				<div class="sr-hero__actions">
					<a href={showroom.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn-hero btn-hero--primary">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-hero-icon"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
						ルート案内
					</a>
					<a href="#departments" class="btn-hero btn-hero--secondary">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-hero-icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
						電話・窓口情報
					</a>
				</div>
			</div>
		</header>

		<!-- 拠点提供サービス・機能ステータスバー（ヒーロー直下：スマホでも崩壊しないクリーンな横スクロール対応） -->
		<section class="facility-feature-bar" aria-label="店舗機能・取扱サービス">
			<div class="facility-feature-container">
				<div class="facility-feature-list">
					<div class="feat-pill">
						<svg class="feat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></svg>
						<span>新車取扱（BMW）</span>
					</div>
					<div class="feat-pill">
						<svg class="feat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
						<span>本社サービス工場</span>
					</div>
					<div class="feat-pill feat-pill--highlight">
						<svg class="feat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
						<span>MINI 正規入庫対応</span>
					</div>
					<div class="feat-pill">
						<svg class="feat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg>
						<span>EV 急速充電</span>
					</div>
				</div>
			</div>
		</section>

		<!-- メインコンテンツグリッド -->
		<div class="sr-content-wrap">
			<div class="sr-layout-grid">
				<!-- 左側：メイン詳細コンテンツ -->
				<div class="sr-main-col">
					<!-- ショールームコンセプト（デスクトップで表示、スマホでは非表示にしてギャラリーへ直結） -->
					<section class="sr-section sr-section--concept">
						<div class="section-tag">CONCEPT &amp; PHILOSOPHY</div>
						<h2 class="section-title">首都圏随一のスケールを誇る、BMWの美学が息づく空間</h2>
						<div class="prose-content">
							<p>
								Nicole BMW 本社ショールームは、東京都心と横浜を結ぶ大動脈・国道1号線（第二京浜）に面し、多摩川を越えてすぐの川崎市幸区戸手に位置します。
								最新のBMWコーポレートアイデンティティ（CI）に基づいた開放的な空間には、最新モデルからフラッグシップの7シリーズ、Mモデルまで常時多彩なラインナップを展示。
							</p>
							<p>
								敷地内にはEV急速充電スタンド、そして熟練のBMWマイスターが待機する「Nicole BMW 本社サービス工場」を併設し、BMWおよびMINIの購入からアフターメンテナンスまでワンストップでお迎えいたします。
							</p>
						</div>
					</section>

					<!-- ショールーム写真ギャラリー（大写真1点 + 6点サムネイル） -->
					<section class="sr-section sr-section--gallery">
						<div class="gallery-container">
							<div class="gallery-main-frame">
								<img
									id="gallery-main-img"
									src={galleryPhotos[0].src}
									alt={galleryPhotos[0].alt}
									class="gallery-main-img"
								/>
								<div class="gallery-info-bar">
									<span id="gallery-counter" class="gallery-counter">01 / 06</span>
									<span id="gallery-caption" class="gallery-caption">{galleryPhotos[0].caption}</span>
								</div>
							</div>
							<div class="gallery-thumbs-grid" role="tablist" aria-label="ショールーム写真サムネイル">
								{galleryPhotos.map((photo, idx) => (
									<button
										type="button"
										class={`gallery-thumb-btn ${idx === 0 ? 'is-active' : ''}`}
										data-src={photo.src}
										data-alt={photo.alt}
										data-caption={photo.caption}
										data-idx={idx}
										aria-label={`写真 ${idx + 1}`}
									>
										<img src={photo.src} alt={photo.alt} class="gallery-thumb-img" loading="lazy" />
									</button>
								))}
							</div>
						</div>
					</section>

					<!-- 店舗・窓口情報（基本情報 ＋ 各部門窓口タブ） -->
					<section class="sr-section sr-section--depts" id="departments">
						<div class="section-tag">DEALER INFORMATION</div>
						<h2 class="section-title">店舗・窓口情報</h2>
						<p class="section-desc">Nicole BMW 本社ショールームおよび併設サービス工場の詳細情報です。</p>

						<div class="dealer-info-card">
							<!-- 拠点共通・基本情報 -->
							<div class="dealer-common-info">
								<div class="common-info-grid">
									<div class="c-info-item">
										<span class="c-info-label">施設名称</span>
										<span class="c-info-val c-info-val--bold">{showroom.name}</span>
									</div>
									<div class="c-info-item">
										<span class="c-info-label">所在地</span>
										<div class="c-info-val">
											<span class="postal">{showroom.postal}</span>
											<span>{showroom.address}</span>
											<a href={showroom.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="link-inline-gmap">
												Googleマップで開く ↗
											</a>
										</div>
									</div>
									<div class="c-info-item">
										<span class="c-info-label">運営法人</span>
										<span class="c-info-val">ニコル・カーズ合同会社</span>
									</div>
								</div>
							</div>

							<!-- 各部門（ショールーム／サービス工場）アコーディオン -->
							<div class="dept-accordion-list" role="region" aria-label="店舗窓口一覧">
								<!-- 1. ショールーム アコーディオン（デフォルト開） -->
								<details class="dept-acc-item" open>
									<summary class="dept-acc-header">
										<div class="dept-acc-title-group">
											<span class="dept-acc-badge">新車販売</span>
											<h3 class="dept-acc-name">ショールーム（新車）</h3>
										</div>
										<div class="dept-acc-meta-preview">
											<span class="preview-hours">10:00 〜 18:00</span>
											<svg class="dept-acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
										</div>
									</summary>
									<div class="dept-acc-body">
										<div class="dept-compact-table">
											<div class="dept-table-row">
												<span class="d-label">取扱ブランド</span>
												<span class="d-val d-val--bold">BMW（新車販売）</span>
											</div>
											<div class="dept-table-row">
												<span class="d-label">代表電話</span>
												<div class="d-val">
													<a href={`tel:${showroom.departments.sales.tel}`} class="d-tel">{showroom.departments.sales.tel}</a>
													<span class="d-sub-tel">（直通: {showroom.departments.sales.telDirect} / FAX: {showroom.departments.sales.fax}）</span>
												</div>
											</div>
											<div class="dept-table-row">
												<span class="d-label">営業時間</span>
												<span class="d-val">{showroom.departments.sales.hours}</span>
											</div>
											<div class="dept-table-row">
												<span class="d-label">定休日</span>
												<span class="d-val">{showroom.departments.sales.closed}</span>
											</div>
										</div>

										<div class="dept-card__action">
											<a href={`tel:${showroom.departments.sales.tel}`} class="btn-dept-call">
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="act-icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
												ショールームへ電話：{showroom.departments.sales.tel}
											</a>
										</div>
									</div>
								</details>

								<!-- 2. サービス工場 アコーディオン -->
								<details class="dept-acc-item">
									<summary class="dept-acc-header">
										<div class="dept-acc-title-group">
											<span class="dept-acc-badge dept-acc-badge--service">BMW / MINI 正規整備</span>
											<h3 class="dept-acc-name">サービス工場（車検・点検・整備）</h3>
										</div>
										<div class="dept-acc-meta-preview">
											<span class="preview-hours">09:00 〜 18:00</span>
											<svg class="dept-acc-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
										</div>
									</summary>
									<div class="dept-acc-body">
										<div class="dept-compact-table">
											<div class="dept-table-row">
												<span class="d-label">取扱ブランド</span>
												<span class="d-val d-val--bold">BMW ／ MINI（正規認定工場）</span>
											</div>
											<div class="dept-table-row">
												<span class="d-label">直通電話</span>
												<div class="d-val">
													<a href={`tel:${showroom.departments.service.tel}`} class="d-tel d-tel--service">{showroom.departments.service.tel}</a>
													<span class="d-sub-tel">（サービス工場直通）</span>
												</div>
											</div>
											<div class="dept-table-row">
												<span class="d-label">営業時間</span>
												<span class="d-val">{showroom.departments.service.hours}</span>
											</div>
											<div class="dept-table-row">
												<span class="d-label">定休日</span>
												<span class="d-val">{showroom.departments.service.closed}</span>
											</div>
										</div>

										<!-- MINI入庫歓迎コールアウト -->
										<div class="mini-service-alert">
											<span class="mini-alert-badge">入庫対応</span>
											<p>当サービス工場は、BMWに加え<strong>MINIの車検・点検・整備</strong>も受け付けております。</p>
										</div>

										<div class="dept-card__action">
											<a href={`tel:${showroom.departments.service.tel}`} class="btn-dept-call btn-dept-call--service">
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="act-icon"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
												サービス工場へ電話：{showroom.departments.service.tel}
											</a>
										</div>
									</div>
								</details>
							</div>
						</div>
					</section>

					<!-- アクセス案内 & Googleマップ連携セクション -->
					<section class="sr-section" id="access">
						<div class="section-tag">LOCATION &amp; ACCESS</div>
						<h2 class="section-title">アクセス &amp; Googleマップ連携</h2>
						<p class="section-desc">東京方面・横浜方面のどちらからも国道1号線経由で快適にお越しいただけます。</p>

						<!-- Googleマップ インタラクティブ埋め込みビュー -->
						<div class="map-container-box">
							<iframe
								src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3246.6669865103094!2d139.68753771525712!3d35.54597718022649!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x601860e0a5c0b115%3A0x6b6339174fca0349!2zTmljb2xlIEJNVyDmnKznqL4!5e0!3m2!1sja!2sjp!4v1700000000000!5m2!1sja!2sjp"
								width="100%"
								height="440"
								style="border:0; filter: contrast(1.05) saturate(0.9);"
								allowfullscreen=""
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								title="Nicole BMW 本社 Googleマップ"
								class="embedded-gmap"
							></iframe>

							<!-- 地図上フローティング連携バー -->
							<div class="map-floating-bar">
								<div class="map-floating-bar__info">
									<strong>Nicole BMW 本社（川崎）</strong>
									<span>神奈川県川崎市幸区戸手2-5-7</span>
								</div>
								<div class="map-floating-bar__btns">
									<a href={showroom.googleMapsUrl} target="_blank" rel="noopener noreferrer" class="btn-gmap-direct">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="btn-svg"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
										Google Maps で経路案内を開く
									</a>
								</div>
							</div>
						</div>

						<!-- アクセスルート詳細（アコーディオン） -->
						<div class="access-accordion-list" role="region" aria-label="アクセス方法一覧">
							<!-- 1. お車でお越しの方 -->
							<details class="access-acc-item" open>
								<summary class="access-acc-header">
									<div class="access-acc-title-group">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="access-acc-icon"><rect width="16" height="10" x="4" y="5" rx="2"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="16.5" cy="17.5" r="2.5"/></svg>
										<h3 class="access-acc-title">お車でお越しの方（東京・横浜方面より）</h3>
									</div>
