---
// src/pages/search.astro
// Nicole Group 公式 サイト内検索ページ（Nicoleダーク・エディトリアルデザイン）
export const prerender = false;

import { search } from "emdash";
import NicoleLayout from "../layouts/NicoleLayout.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";

// posts（お知らせ）および magazine（マガジン）の両コレクションから検索
const { items: results, nextCursor } = query
	? await search(query, { collections: ["posts", "magazine"], limit: 30 })
	: { items: [], nextCursor: undefined };

function escapeHtml(text: string) {
	return text
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;")
		.replaceAll("'", "&#39;");
}

const rows = results.map((result: any) => {
	const title = result.title ?? "無題";
	const snippetIsTitle =
		result.snippet?.replaceAll("<mark>", "").replaceAll("</mark>", "") ===
		escapeHtml(title);
	
	// コレクションに応じて適切なURLパスを生成
	const isMag = result.collection === "magazine";
	const path = isMag ? `/magazine/${result.slug ?? result.id}/` : `/news/${result.slug ?? result.id}`;
	const collectionLabel = isMag ? "MAGAZINE" : "NEWS";

	return {
		path,
		collectionLabel,
		title,
		titleHtml: snippetIsTitle ? result.snippet : undefined,
		snippet: snippetIsTitle ? undefined : result.snippet,
	};
});

const pageTitle = query ? `「${query}」の検索結果 | Nicole Group 公式` : "サイト内検索 | Nicole Group 公式";
---

<NicoleLayout 
	title={pageTitle} 
	description="Nicole Groupの最新マガジン記事、公式お知らせ、キャンペーン情報を検索できます。"
>
	<main class="nicole-search-main">
		<div class="nicole-search-container">
			<!-- 検索ヘッダー -->
			<header class="nicole-search-header">
				<h1 class="nicole-search-title">サイト内検索</h1>
				<p class="nicole-search-lead">
					最新のマガジン記事、モデル情報、公式お知らせなどをキーワードで検索できます。
				</p>

				<form method="get" action="/search" role="search" class="nicole-search-form">
					<div class="nicole-search-input-wrap">
						<svg class="nicole-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="11" cy="11" r="8"></circle>
							<path d="m21 21-4.35-4.35"></path>
						</svg>
						<input
							type="search"
							name="q"
							value={query}
							placeholder="キーワードを入力（例: BMW, アルピナ, フェラーリ, 点検）"
							class="nicole-search-input"
							autofocus={!query}
						/>
						<button type="submit" class="nicole-search-submit">検索</button>
					</div>
				</form>
			</header>

			<!-- 検索結果セクション -->
			{query && (
				<section class="nicole-search-results">
					<div class="nicole-search-meta">
						<p class="nicole-search-count">
							「<strong>{query}</strong>」の検索結果: <strong>{rows.length}件</strong>
						</p>
					</div>

					{rows.length > 0 ? (
						<ul class="nicole-search-list">
							{rows.map((row) => (
								<li class="nicole-search-item">
									<a href={row.path} class="nicole-search-link">
										<div class="nicole-search-item-badge">{row.collectionLabel}</div>
										<h2 class="nicole-search-item-title">
											{row.titleHtml ? (
												<Fragment set:html={row.titleHtml} />
											) : (
												row.title
											)}
										</h2>
										{row.snippet && (
											<p class="nicole-search-item-snippet" set:html={row.snippet} />
										)}
										<span class="nicole-search-item-path">{row.path}</span>
									</a>
								</li>
							))}
						</ul>
					) : (
						<div class="nicole-search-empty">
							<p class="nicole-search-empty-text">該当する記事やお知らせが見つかりませんでした。</p>
							<p class="nicole-search-empty-sub">言葉を変えるか、より短いキーワードでお試しください。</p>
							<div class="nicole-search-empty-links">
								<a href="/magazine/" class="nicole-search-btn-outline">マガジン一覧を見る</a>
								<a href="/news" class="nicole-search-btn-outline">お知らせ一覧を見る</a>
							</div>
						</div>
					)}
				</section>
			)}
		</div>
	</main>
</NicoleLayout>

<style>
	.nicole-search-main {
		background: #0f1115;
		color: #ffffff;
		min-height: 80vh;
		padding: 5rem 1.5rem 8rem;
	}

	.nicole-search-container {
		max-width: 860px;
		width: 100%;
		margin: 0 auto;
	}

	.nicole-search-header {
		margin-bottom: 3.5rem;
		text-align: center;
	}

	.nicole-search-title {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		letter-spacing: -0.02em;
		margin: 0 0 1rem;
		color: #ffffff;
	}

	.nicole-search-lead {
		font-size: 1rem;
		color: rgba(255, 255, 255, 0.6);
		margin: 0 0 2.5rem;
		line-height: 1.7;
	}

	.nicole-search-form {
		max-width: 680px;
		margin: 0 auto;
	}

	.nicole-search-input-wrap {
		display: flex;
		align-items: center;
		background: rgba(255, 255, 255, 0.05);
		border: 1px solid rgba(255, 255, 255, 0.15);
		border-radius: 6px;
		padding: 0.35rem 0.5rem 0.35rem 1.25rem;
		transition: border-color 0.2s ease, background 0.2s ease;
	}

	.nicole-search-input-wrap:focus-within {
		border-color: rgba(255, 255, 255, 0.4);
		background: rgba(255, 255, 255, 0.08);
	}

	.nicole-search-icon {
		width: 20px;
		height: 20px;
		color: rgba(255, 255, 255, 0.4);
		flex-shrink: 0;
		margin-right: 0.75rem;
	}

	.nicole-search-input {
		flex: 1;
		background: transparent;
		border: none;
		outline: none;
		color: #ffffff;
		font-size: 1rem;
		padding: 0.6rem 0;
	}

	.nicole-search-input::placeholder {
		color: rgba(255, 255, 255, 0.35);
	}

	.nicole-search-submit {
		background: #ffffff;
		color: #000000;
		border: none;
		border-radius: 4px;
		padding: 0.65rem 1.5rem;
		font-size: 0.9375rem;
		font-weight: 600;
		cursor: pointer;
		transition: opacity 0.2s ease;
		flex-shrink: 0;
	}

	.nicole-search-submit:hover {
		opacity: 0.9;
	}

	.nicole-search-meta {
		padding-bottom: 1rem;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.nicole-search-count {
		font-size: 1rem;
		color: rgba(255, 255, 255, 0.75);
		margin: 0;
	}

	.nicole-search-count strong {
		color: #ffffff;
	}

	.nicole-search-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.nicole-search-item {
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 8px;
		transition: all 0.2s ease;
	}

	.nicole-search-item:hover {
		background: rgba(255, 255, 255, 0.06);
		border-color: rgba(255, 255, 255, 0.2);
		transform: translateY(-2px);
	}

	.nicole-search-link {
		display: block;
		padding: 1.5rem 1.75rem;
		text-decoration: none;
		color: inherit;
	}

	.nicole-search-item-badge {
		display: inline-block;
		font-family: var(--font-mono, monospace);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: rgba(255, 255, 255, 0.5);
		background: rgba(255, 255, 255, 0.06);
		padding: 0.2rem 0.5rem;
		border-radius: 3px;
		margin-bottom: 0.5rem;
	}

	.nicole-search-item-title {
		font-size: 1.1875rem;
		font-weight: 600;
		line-height: 1.5;
		margin: 0 0 0.5rem;
		color: #ffffff;
	}

	:global(.nicole-search-item-title mark),
	:global(.nicole-search-item-snippet mark) {
		background: rgba(255, 255, 255, 0.25);
		color: #ffffff;
		padding: 0 0.2em;
		border-radius: 2px;
	}

	.nicole-search-item-snippet {
		font-size: 0.875rem;
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.65);
		margin: 0 0 0.5rem;
	}

	.nicole-search-item-path {
		font-family: var(--font-mono, monospace);
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.35);
	}

	.nicole-search-empty {
		text-align: center;
		padding: 4rem 1rem;
		background: rgba(255, 255, 255, 0.02);
		border: 1px dashed rgba(255, 255, 255, 0.12);
		border-radius: 8px;
	}

	.nicole-search-empty-text {
		font-size: 1.125rem;
		font-weight: 600;
		color: #ffffff;
		margin: 0 0 0.5rem;
	}

	.nicole-search-empty-sub {
		font-size: 0.875rem;
		color: rgba(255, 255, 255, 0.5);
		margin: 0 0 2rem;
	}

	.nicole-search-empty-links {
		display: flex;
		gap: 1rem;
		justify-content: center;
		flex-wrap: wrap;
	}

	.nicole-search-btn-outline {
		display: inline-flex;
		align-items: center;
		padding: 0.75rem 1.5rem;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 4px;
		color: #ffffff;
		text-decoration: none;
		font-size: 0.875rem;
		font-weight: 600;
		transition: all 0.2s ease;
	}

	.nicole-search-btn-outline:hover {
		border-color: #ffffff;
		background: rgba(255, 255, 255, 0.08);
	}
</style>
