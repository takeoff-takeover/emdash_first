	.form-radio-option input[type="radio"] {
		accent-color: #ffffff;
		width: 16px;
		height: 16px;
		margin: 0 !important;
		flex-shrink: 0;
		cursor: pointer;
	}

	/* プライバシー同意チェックボックス（箱なし・上ボーダー区切りのみ） */
	.form-consent-box {
		padding-top: 24px;
