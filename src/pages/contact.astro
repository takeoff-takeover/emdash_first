---
// src/pages/contact.astro
// ニコル・グループ お問い合わせフォーム
// 会社案内（corporate.astro）準拠：黒ベース（#040507）＆チャコールグレー帯（#0e1118）・1440pxワイド1カラム構成
// formrun API連携対応ネイティブHTMLフォーム
import NicoleLayout from "../layouts/NicoleLayout.astro";

const pageTitle = "お問い合わせ | Nicole Group 公式";
const pageDescription = "ニコル・グループへのお問い合わせ・ご相談窓口。試乗・商談・点検整備など各ショールームへのお問い合わせはこちらから。";

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "ContactPage",
			"@id": "https://www.nicole.co.jp/contact/#webpage",
			"url": "https://www.nicole.co.jp/contact",
			"name": pageTitle,
			"description": pageDescription,
			"breadcrumb": {
				"@id": "https://www.nicole.co.jp/contact/#breadcrumb"
			}
		},
		{
			"@type": "BreadcrumbList",
			"@id": "https://www.nicole.co.jp/contact/#breadcrumb",
			"itemListElement": [
				{
					"@type": "ListItem",
					"position": 1,
					"name": "HOME",
					"item": "https://www.nicole.co.jp/"
				},
				{
					"@type": "ListItem",
					"position": 2,
					"name": "お問い合わせ",
					"item": "https://www.nicole.co.jp/contact"
				}
			]
		}
	]
};
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<style is:global>
			body:has(.contact-dark-main),
			body:has(.contact-dark-main) #page,
			body:has(.contact-dark-main) #content,
			body:has(.contact-dark-main) .site-content,
			body:has(.contact-dark-main) #primary,
			body:has(.contact-dark-main) .content-area,
			body:has(.contact-dark-main) .ast-container {
				background-color: #040507 !important;
				background-image: none !important;
				padding: 0 !important;
				margin: 0 !important;
				max-width: 100% !important;
				width: 100% !important;
				border: none !important;
			}
		</style>
	</Fragment>

	<main class="contact-dark-main">
		<!-- 1. ヒーローヘッダー（会社案内準拠・写真背景＋ダークグラデーション） -->
		<header class="corp-hero">
			<div class="corp-hero__media">
				<img
					src="/uploads/2026/02/DSC3504.jpg"
					alt="ニコル・グループ お問い合わせ"
					class="corp-hero__img"
					loading="eager"
					decoding="async"
				/>
				<div class="corp-hero__gradient"></div>
				<div class="corp-hero__side-vignette"></div>
			</div>

			<div class="corp-container corp-hero__inner">
				<nav class="corp-breadcrumbs" aria-label="パンくずリスト">
					<ol class="corp-breadcrumbs__list">
						<li class="corp-breadcrumbs__item"><a href="/" class="corp-breadcrumbs__link">HOME</a></li>
						<li class="corp-breadcrumbs__separator" aria-hidden="true">/</li>
						<li class="corp-breadcrumbs__item" aria-current="page" id="contact-breadcrumb-current">お問い合わせ</li>
					</ol>
				</nav>

				<h1 class="corp-hero__title" id="contact-heading">お問い合わせ</h1>
				<p class="corp-hero__subtitle">
					<span class="corp-hero__phrase">試乗・商談のご予約、車両に関するご質問、</span><span class="corp-hero__phrase">ニコル・グループ各ブランドへのお問い合わせを承っております。</span>
				</p>
			</div>
		</header>

		<!-- 2. ご案内・注意事項セクション（#040507 ベース） -->
		<section class="corp-section corp-section--compact">
			<div class="corp-container">
				<div class="contact-notes">
					<p class="contact-notes__lead">
						以下のフォームをご入力の上、プライバシー・ポリシーをご一読いただき、ご了承いただける場合には「同意する」を選択して送信してください。
					</p>
					<ul class="contact-notes__list">
						<li>お問い合わせ内容によっては、ご回答までにお時間をいただく場合がございます。あらかじめご了承ください。また内容により、担当者よりお電話でご連絡させていただく場合がございます。</li>
						<li>お車の不調・故障・修理など、サービス・メンテナンスに関するご相談は、お近くのニコル・グループの各ショールームまたはサービス拠点（<a href="/locations" class="contact-inline-link">事業拠点・ショールーム一覧</a>）へ直接ご連絡いただきますようお願いいたします。インターネットからのお問い合わせでは対応できない場合がございます。</li>
						<li>営業・ご提案などの内容につきましては、返信を差し控えさせていただく場合がございます。</li>
					</ul>
				</div>
			</div>
		</section>

		<!-- 3. お問い合わせフォーム本体（チャコールグレー帯・1440pxワイド1カラム） -->
		<section id="contact-form-section" class="corp-section corp-section--alt">
			<div class="corp-container">
				<header class="corp-section-header">
					<h2 class="corp-section-title">お問い合わせフォーム</h2>
					<p class="corp-section-subtitle">
						「必須」と記載された項目は必ずご入力ください。
					</p>
				</header>

				<form
					id="nicole-contact-form"
					class="contact-form-panel"
					method="post"
					action="/api/contact"
					novalidate
				>
					<!-- 自社API ＆ 将来のformrun自動転送用メタフィールド -->
					<input type="hidden" name="brand_slug" id="field-brand-slug" value="nicole" />
					<input type="hidden" name="form_type" id="field-form-type" value="inquiry" />
					<input type="hidden" name="source_url" id="field-source-url" value="" />
					<!-- スパム対策ハニーポット（人間には非表示） -->
					<div class="form-hp-field" aria-hidden="true">
						<label for="field-company-website">Website</label>
						<input type="text" id="field-company-website" name="company_website" tabindex="-1" autocomplete="off" />
					</div>

					<!-- ご用件（種別） -->
					<fieldset class="form-group form-fieldset">
						<legend class="form-label">
							<span>お問い合わせ種別</span>
							<span class="form-badge form-badge--required">必須</span>
						</legend>
						<div class="form-radio-grid">
							<label class="form-radio-option">
								<input type="radio" name="inquiry_type" value="お問い合わせ" checked required />
								<span>一般的なお問い合わせ</span>
							</label>
							<label class="form-radio-option">
								<input type="radio" name="inquiry_type" value="来場・試乗予約" />
								<span>来場・試乗予約</span>
							</label>
							<label class="form-radio-option">
								<input type="radio" name="inquiry_type" value="カタログ・資料請求" />
								<span>カタログ・資料請求</span>
							</label>
							<label class="form-radio-option">
								<input type="radio" name="inquiry_type" value="認定中古車のご相談" />
								<span>認定中古車のご相談</span>
							</label>
							<label class="form-radio-option">
								<input type="radio" name="inquiry_type" value="その他" />
								<span>その他</span>
							</label>
						</div>
					</fieldset>

					<!-- 対象ブランド・ご検討モデル（PC 2列 / SP 1列） -->
					<div class="form-row-2col">
						<div class="form-group">
							<label for="field-brand" class="form-label">
								<span>対象ブランド</span>
								<span class="form-badge form-badge--required">必須</span>
							</label>
							<div class="form-select-wrap">
								<select id="field-brand" name="_field_19" class="form-control form-select" required>
									<option value="Nicole Group">Nicole Group（総合窓口）</option>
									<option value="BMW">BMW</option>
									<option value="MINI">MINI</option>
									<option value="Rolls-Royce">Rolls-Royce</option>
									<option value="ALPINA">ALPINA</option>
									<option value="Ferrari">Ferrari</option>
								</select>
							</div>
						</div>

						<div class="form-group">
							<label for="field-series" class="form-label">
								<span>ご検討中のモデル・車種</span>
								<span class="form-badge form-badge--optional">任意</span>
							</label>
							<input
								type="text"
								id="field-series"
								name="series"
								class="form-control"
								placeholder="例：BMW 3シリーズ、MINI Cooper、296 GTB など"
							/>
						</div>
					</div>

					<!-- お名前（姓・名） -->
					<div class="form-row-2col">
						<div class="form-group">
							<label for="field-last-name" class="form-label">
								<span>お名前（姓）</span>
								<span class="form-badge form-badge--required">必須</span>
							</label>
							<input
								type="text"
								id="field-last-name"
								name="last_name"
								class="form-control"
								autocomplete="family-name"
								placeholder="例：山田"
								required
							/>
						</div>

						<div class="form-group">
							<label for="field-first-name" class="form-label">
								<span>お名前（名）</span>
								<span class="form-badge form-badge--required">必須</span>
							</label>
							<input
								type="text"
								id="field-first-name"
								name="first_name"
								class="form-control"
								autocomplete="given-name"
								placeholder="例：太郎"
								required
							/>
						</div>
					</div>

					<!-- フリガナ（セイ・メイ） -->
					<div class="form-row-2col">
						<div class="form-group">
							<label for="field-last-kana" class="form-label">
								<span>フリガナ（セイ）</span>
								<span class="form-badge form-badge--required">必須</span>
							</label>
							<input
								type="text"
								id="field-last-kana"
								name="last_kana"
								class="form-control"
								placeholder="例：ヤマダ"
								required
							/>
						</div>

						<div class="form-group">
							<label for="field-first-kana" class="form-label">
								<span>フリガナ（メイ）</span>
								<span class="form-badge form-badge--required">必須</span>
							</label>
							<input
								type="text"
								id="field-first-kana"
								name="first_kana"
								class="form-control"
								placeholder="例：タロウ"
								required
							/>
						</div>
					</div>

					<!-- メールアドレス・電話番号 -->
					<div class="form-row-2col">
						<div class="form-group">
							<label for="field-email" class="form-label">
								<span>メールアドレス</span>
								<span class="form-badge form-badge--required">必須</span>
							</label>
							<input
								type="email"
								id="field-email"
								name="email"
								class="form-control"
								autocomplete="email"
								placeholder="例：example@nicole.co.jp"
								required
							/>
						</div>

						<div class="form-group">
							<label for="field-tel" class="form-label">
								<span>電話番号</span>
								<span class="form-badge form-badge--required">必須</span>
							</label>
							<input
								type="tel"
								id="field-tel"
								name="tel"
								class="form-control"
								autocomplete="tel"
								placeholder="例：044-511-9859"
								required
							/>
						</div>
					</div>

					<!-- ご希望の連絡方法 -->
					<fieldset class="form-group form-fieldset">
						<legend class="form-label">
							<span>ご希望の連絡方法</span>
							<span class="form-badge form-badge--optional">任意</span>
						</legend>
						<div class="form-radio-inline">
							<label class="form-radio-option">
								<input type="radio" name="preferred_contact" value="どちらでも可" checked />
								<span>どちらでも可</span>
							</label>
							<label class="form-radio-option">
								<input type="radio" name="preferred_contact" value="メール" />
								<span>メール</span>
							</label>
							<label class="form-radio-option">
								<input type="radio" name="preferred_contact" value="お電話" />
								<span>お電話</span>
							</label>
						</div>
					</fieldset>

					<!-- お問い合わせ内容 -->
					<div class="form-group">
						<label for="field-message" class="form-label">
							<span>お問い合わせ内容・ご要望</span>
							<span class="form-badge form-badge--required">必須</span>
						</label>
						<textarea
							id="field-message"
							name="message"
							class="form-control form-textarea"
							rows="6"
							placeholder="ご希望の試乗日時、ご質問内容などをご記入ください。"
							required
						></textarea>
					</div>

					<!-- プライバシー・ポリシー同意 -->
					<div class="form-consent-box">
						<label class="form-checkbox-label">
							<input type="checkbox" id="field-privacy" name="privacy_agreed" value="同意する" required />
							<span>
								<a href="/privacystatement" target="_blank" rel="noopener noreferrer" class="contact-inline-link">プライバシー・ポリシー</a>を確認し、個人情報の取り扱いに同意する
							</span>
						</label>
					</div>

					<!-- バリデーションエラーメッセージ -->
					<div id="form-error-banner" class="form-error-banner" role="alert" hidden></div>

					<!-- 送信ボタン -->
					<div class="form-submit-wrap">
						<button type="submit" id="form-submit-btn" class="form-submit-btn">
							<span>入力内容を送信する</span>
							<svg class="form-submit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
								<path d="M5 12h14M13 5l7 7-7 7"></path>
							</svg>
						</button>
					</div>
				</form>
			</div>
		</section>
	</main>
</NicoleLayout>

<style>
	/* ============================================================== */
	/* お問い合わせページ：黒ベース＆チャコールグレー帯・1440pxワイド */
	/* ============================================================== */
	.contact-dark-main {
		--spacing-4: 1rem;
		--spacing-6: 1.5rem;
		--spacing-8: 2rem;
		--spacing-10: 2.5rem;
		--spacing-12: 3rem;
		--spacing-16: 4rem;
		--spacing-20: 5rem;

		--color-bg: #040507;
		--color-border: rgba(255, 255, 255, 0.1);
		--color-text: #ffffff;
		--color-text-secondary: rgba(255, 255, 255, 0.74);
		--color-accent: #E60012;

		background-color: var(--color-bg);
		color: var(--color-text);
		font-family: "Helvetica Neue", Helvetica, "Hiragino Kaku Gothic ProN", "Yu Gothic", "Noto Sans JP", sans-serif;
		min-height: 100vh;
		position: relative;
		overflow-x: hidden;
		line-height: 1.8;
	}

	.corp-container {
		width: 100%;
		max-width: 1440px;
		margin: 0 auto;
		padding: 0 var(--spacing-10);
		box-sizing: border-box;
	}

	@media (max-width: 1024px) {
		.corp-container {
			padding: 0 var(--spacing-6);
		}
	}

	@media (max-width: 480px) {
		.corp-container {
			padding: 0 var(--spacing-4);
		}
	}

	/* --- ヒーローヘッダー（corporate.astro 準拠） --- */
	.corp-hero {
		position: relative;
		min-height: 440px;
		display: flex;
		align-items: flex-end;
		padding: 130px 0 56px 0;
		border-bottom: 1px solid var(--color-border);
		overflow: hidden;
		background: #000000;
	}

	@media (max-width: 768px) {
		.corp-hero {
			min-height: 340px;
			padding: 100px 0 36px 0;
		}
	}

	.corp-hero__media {
		position: absolute;
		inset: 0;
		z-index: 1;
		overflow: hidden;
	}

	.corp-hero__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 36%;
		filter: brightness(0.62) contrast(1.06);
		transform: scale(1.02);
	}

	.corp-hero__gradient {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			180deg,
			rgba(4, 5, 7, 0.86) 0%,
			rgba(4, 5, 7, 0.42) 40%,
			rgba(4, 5, 7, 0.85) 80%,
			#040507 100%
		);
	}

	.corp-hero__side-vignette {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			90deg,
			rgba(4, 5, 7, 0.82) 0%,
			rgba(4, 5, 7, 0.28) 55%,
			rgba(4, 5, 7, 0.62) 100%
		);
	}

	.corp-hero__inner {
		position: relative;
		z-index: 5;
		width: 100%;
	}

	.corp-breadcrumbs {
		margin-bottom: 20px;
	}

	.corp-breadcrumbs__list {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 8px;
		list-style: none;
		padding: 0;
		margin: 0;
		font-size: 12px;
		color: rgba(255, 255, 255, 0.55);
	}

	.corp-breadcrumbs__link {
		color: rgba(255, 255, 255, 0.72);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.corp-breadcrumbs__link:hover {
		color: #ffffff;
	}

	.corp-breadcrumbs__separator {
		color: rgba(255, 255, 255, 0.35);
	}

	.corp-hero__title {
		font-size: clamp(30px, 4.2vw, 52px);
		font-weight: 800;
		color: #ffffff;
		letter-spacing: -0.02em;
		margin: 0 0 14px 0;
		line-height: 1.18;
		text-shadow: 0 2px 10px rgba(0, 0, 0, 0.6);
		word-break: auto-phrase !important;
		line-break: strict !important;
	}

	.corp-hero__subtitle {
		font-size: clamp(14.5px, 1.35vw, 16.5px);
		line-height: 1.85;
		color: rgba(255, 255, 255, 0.86);
		max-width: 900px;
		margin: 0;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
		word-break: auto-phrase;
	}

	.corp-hero__phrase {
		display: inline-block;
	}

	@media (max-width: 640px) {
		.corp-hero__phrase {
			display: inline;
		}
	}

	/* --- セクション設定 --- */
	.corp-section {
		padding: var(--spacing-20) 0;
		position: relative;
		background-color: #040507;
	}

	.corp-section--compact {
		padding: var(--spacing-12) 0;
	}

	.corp-section--alt {
		background-color: #0e1118;
		background-image:
			linear-gradient(180deg, rgba(255, 255, 255, 0.03) 0%, rgba(255, 255, 255, 0) 100%),
			radial-gradient(ellipse 90% 45% at 50% 0%, rgba(255, 255, 255, 0.05) 0%, transparent 75%);
		border-top: 1px solid rgba(255, 255, 255, 0.1);
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow:
			inset 0 1px 0 0 rgba(255, 255, 255, 0.04),
			inset 0 -1px 0 0 rgba(0, 0, 0, 0.45);
	}

	@media (max-width: 768px) {
		.corp-section {
			padding: var(--spacing-12) 0;
		}
		.corp-section--compact {
			padding: var(--spacing-8) 0;
		}
	}

	.corp-section-header {
		margin-bottom: 32px;
	}

	.corp-section-title {
		font-size: clamp(22px, 2.8vw, 32px);
		font-weight: 700;
		color: #ffffff;
		letter-spacing: -0.01em;
		line-height: 1.3;
		margin: 0 0 8px 0;
		word-break: auto-phrase !important;
		line-break: strict !important;
	}

	.corp-section-subtitle {
		font-size: 14px;
		color: rgba(255, 255, 255, 0.62);
		margin: 0;
	}

	/* --- 注意事項エリア（箱なし・明度差と余白のみで表現） --- */
	.contact-notes {
		width: 100%;
	}

	.contact-notes__lead {
		font-size: 15.5px;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.92);
		margin: 0 0 16px;
		line-height: 1.85;
	}

	.contact-notes__list {
		padding-left: 20px;
		margin: 0;
		font-size: 13.5px;
		color: rgba(255, 255, 255, 0.6);
		line-height: 1.85;
	}

	.contact-notes__list li {
		margin-bottom: 6px;
	}

	.contact-notes__list li:last-child {
		margin-bottom: 0;
	}

	.contact-inline-link {
		color: #ffffff;
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-color: rgba(255, 255, 255, 0.45);
		transition: text-decoration-color 0.2s ease;
	}

	.contact-inline-link:hover {
		text-decoration-color: #ffffff;
	}

	/* --- ネイティブフォーム（外枠箱なし・セクション面に直接配置） --- */
