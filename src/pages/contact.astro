---
// src/pages/contact.astro
// ニコル・グループ お問い合わせフォーム（完全モダン・脱Elementor）
import NicoleLayout from "../layouts/NicoleLayout.astro";

const pageTitle = "お問い合わせ | Nicole Group 公式";
const pageDescription = "ニコル・グループへのお問い合わせ・ご相談窓口。試乗・商談・点検整備など各ショールームへのお問い合わせはこちらから。";
---

<NicoleLayout title={pageTitle} description={pageDescription}>
	<main class="contact-page">
		<!-- ヒーローヘッダー -->
		<header class="contact-hero">
			<div class="contact-hero__inner">
				<p class="contact-hero__sub">CONTACT</p>
				<h1 class="contact-hero__title" id="contact-heading">お問い合わせ</h1>
			</div>
		</header>

		<div class="contact-container">
			<div class="contact-content-card">
				<!-- 注意事項・ご案内 -->
				<div class="contact-notes">
					<p class="contact-notes__lead">
						以下のフォームをご入力の上、プライバシー・ポリシーをご一読いただき、ご了承いただける場合には「同意する」を選択して次へお進みください。
					</p>
					<ul class="contact-notes__list">
						<li>お問い合わせ内容によっては、ご回答までにお時間をいただく場合がございます。あらかじめご了承ください。また内容により、担当者よりお電話でご連絡させていただく場合がございます。</li>
						<li>お車の不調・故障・修理など、サービス・メンテナンスに関するご相談は、お近くのNicole Groupの各ショールームまたはサービス拠点へ直接ご連絡いただきますようお願いいたします。インターネットからのお問い合わせでは対応できない場合がございます。</li>
						<li>営業・ご提案などの内容につきましては、返信を差し控えさせていただく場合がございます。</li>
					</ul>
				</div>

				<!-- formrun 埋め込みエリア -->
				<div id="formrun-wrapper" class="formrun-wrapper">
					<div
						id="formrun-embed"
						class="formrun-embed"
						data-formrun-redirect="true"
						aria-label="お問い合わせフォーム"
					></div>
				</div>
			</div>
		</div>
	</main>
</NicoleLayout>

<style>
/* ============================================================== */
/* お問い合わせページ：完全モダン＆セマンティックデザイン */
/* ============================================================== */
.contact-page {
	width: 100%;
	background-color: #fcfcfc;
	color: #111111;
	font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;
	line-height: 1.8;
	padding-bottom: 96px;
}

.contact-container {
	width: 100%;
	max-width: 960px;
	margin: 0 auto;
	padding: 64px 40px 0;
	box-sizing: border-box;
}

/* --- ヒーローヘッダー --- */
.contact-hero {
	width: 100%;
	background-color: #000000;
	color: #ffffff;
	padding: 88px 0 72px;
	border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	text-align: center;
}

.contact-hero__inner {
	width: 100%;
	max-width: 1440px;
	margin: 0 auto;
	padding: 0 40px;
	box-sizing: border-box;
}

.contact-hero__sub {
	font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
	font-size: 13px;
	letter-spacing: 0.28em;
	color: rgba(255, 255, 255, 0.6);
	margin: 0 0 16px;
	text-transform: uppercase;
}

.contact-hero__title {
	font-size: clamp(30px, 4vw, 42px);
	font-weight: 600;
	letter-spacing: 0.08em;
	margin: 0;
	color: #ffffff;
	line-height: 1.3;
}

/* --- メインカード --- */
.contact-content-card {
	background-color: #ffffff;
	border: 1px solid #e5e5e5;
	border-radius: 4px;
	padding: 48px;
	box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
}

/* --- 注意事項 --- */
.contact-notes {
	background-color: #f9f9f9;
	border-left: 3px solid #dc2626;
	padding: 24px 28px;
	margin-bottom: 48px;
	border-radius: 0 4px 4px 0;
}

.contact-notes__lead {
	font-size: 15px;
	font-weight: 600;
	color: #111111;
	margin: 0 0 16px;
	line-height: 1.7;
}

.contact-notes__list {
	padding-left: 20px;
	margin: 0;
	font-size: 13.5px;
	color: #555555;
	line-height: 1.8;
}

.contact-notes__list li {
	margin-bottom: 8px;
}

.contact-notes__list li:last-child {
	margin-bottom: 0;
}

/* --- formrun 埋め込み --- */
.formrun-wrapper {
	position: relative;
	width: 100%;
	scroll-margin-top: 120px;
}

.formrun-embed {
	width: 100%;
	min-height: 700px;
}

:global(#formrun-embed iframe) {
	display: block;
	width: 100% !important;
	max-width: 100% !important;
	border: 0 !important;
}

/* --- レスポンシブ対応 --- */
@media (max-width: 768px) {
	.contact-container {
		padding: 40px 20px 0;
	}

	.contact-hero {
		padding: 56px 0 48px;
	}

	.contact-content-card {
		padding: 32px 20px;
	}

	.contact-notes {
		padding: 20px 18px;
		margin-bottom: 36px;
	}

	.formrun-wrapper {
		scroll-margin-top: 24px;
	}

	.formrun-embed {
		min-height: 600px;
	}
}
</style>

<!-- formrun 動的埋め込みスクリプト -->
<script is:inline>
(function () {
  'use strict';

  const params = new URLSearchParams(window.location.search);
  const DEFAULT_BRAND = 'nicole';
  const SCROLL_OFFSET_PC = 120;
  const SCROLL_OFFSET_SP = 24;
  const OBSERVER_ARM_DELAY = 2500;
  const HEIGHT_CHANGE_THRESHOLD = 200;
  const SCROLL_DELAY = 180;

  // タイトル更新（form_type連動）
  function updateHeading() {
    const formType = params.get('form_type');
    const headingMap = {
      inquiry: 'お問い合わせ',
      visit_testdrive: '来場・試乗予約'
    };
    const headingEl = document.getElementById('contact-heading');
    if (headingEl && headingMap[formType]) {
      headingEl.textContent = headingMap[formType];
    }
  }

  function detectBrandFromPath(pathname) {
    const path = String(pathname || '').toLowerCase();
    if (path.startsWith('/bmw/')) return 'bmw';
    if (path.startsWith('/mini/')) return 'mini';
    if (path.startsWith('/rolls-royce/')) return 'rolls-royce';
    if (path.startsWith('/alpina/')) return 'alpina';
    if (path.startsWith('/ferrari/')) return 'ferrari';
    return DEFAULT_BRAND;
  }

  function normalizeTitle(title) {
    if (!title) return '';
    let t = String(title).trim();
    t = t.replace(/\u3000/g, ' ');
    t = t.replace(/\s+/g, ' ').trim();
    t = t.replace(/\s*-\s*TEST\s*$/i, '');
    t = t.split(' - ')[0].trim();
    t = t.replace(/\s*[｜|]\s*Nicole.*$/i, '').trim();
    t = t.replace(/^BMW\s+/i, '');
    return t;
  }

  let brandSlug = String(params.get('brand') || '').toLowerCase();
  if (!brandSlug) {
    brandSlug = String(sessionStorage.getItem('ng_brand') || '').toLowerCase();
  }
  if (!brandSlug) {
    try {
      const referrerPath = document.referrer ? new URL(document.referrer).pathname : '';
      brandSlug = detectBrandFromPath(referrerPath);
    } catch (error) {
      brandSlug = DEFAULT_BRAND;
    }
  }
  if (!brandSlug || brandSlug === 'group') brandSlug = DEFAULT_BRAND;

  const allowedBrands = ['bmw', 'mini', 'rolls-royce', 'alpina', 'ferrari', 'nicole'];
  if (!allowedBrands.includes(brandSlug)) brandSlug = DEFAULT_BRAND;

  const brandMap = {
    'bmw': 'BMW',
    'mini': 'MINI',
    'rolls-royce': 'Rolls-Royce',
    'alpina': 'ALPINA',
    'ferrari': 'Ferrari',
    'nicole': 'Nicole Group'
  };
  const brand = brandMap[brandSlug] || brandMap[DEFAULT_BRAND];

  const formTitleRaw = params.get('form_title') || sessionStorage.getItem('ng_form_title') || '';
  const seriesValue = normalizeTitle(formTitleRaw);

  const formIdMap = {
    'bmw': '@nicole-group-contact-bmw',
    'mini': '@nicole-group-contact-mini',
    'rolls-royce': '@nicole-group-contact-rollsroyce',
    'alpina': '@nicole-group-contact-alpina',
    'ferrari': '@nicole-group-contact-ferrari',
    'nicole': '@nicole-group-contact'
  };

  const seriesFieldMap = {
    'bmw': '_field_20',
    'mini': '_field_21',
    'rolls-royce': '_field_19',
    'alpina': '_field_19',
    'ferrari': '_field_23',
    'nicole': '_field_19'
  };

  const formId = formIdMap[brandSlug] || formIdMap[DEFAULT_BRAND];
  const seriesFieldKey = seriesFieldMap[brandSlug] || seriesFieldMap[DEFAULT_BRAND];

  const formParams = new URLSearchParams();
  formParams.set('_field_19', brand);
  if (seriesValue && seriesFieldKey) {
    formParams.set(seriesFieldKey, seriesValue);
  }

  const queryString = formParams.toString().replace(/\+/g, '%20');
  const formrunFormValue = formId + (queryString ? '?' + queryString : '');

  const embedElement = document.getElementById('formrun-embed');
  if (embedElement) {
    embedElement.setAttribute('data-formrun-form', formrunFormValue);
    embedElement.setAttribute('data-formrun-redirect', 'true');
  }

  function getScrollOffset() {
    return window.matchMedia('(max-width: 767px)').matches ? SCROLL_OFFSET_SP : SCROLL_OFFSET_PC;
  }

  function scrollToFormTop() {
    const wrapper = document.getElementById('formrun-wrapper');
    if (!wrapper) return;
    const targetPosition = window.scrollY + wrapper.getBoundingClientRect().top - getScrollOffset();
    window.scrollTo({
      top: Math.max(targetPosition, 0),
      behavior: 'smooth'
    });
  }

  let scrollTimer = null;
  function scheduleScrollToFormTop() {
    if (scrollTimer) window.clearTimeout(scrollTimer);
    scrollTimer = window.setTimeout(function () {
      scrollToFormTop();
      scrollTimer = null;
    }, SCROLL_DELAY);
  }

  let observerArmed = false;
  let lastIframeHeight = 0;

  window.setTimeout(function () {
    observerArmed = true;
  }, OBSERVER_ARM_DELAY);

  function getIframeHeight(iframe) {
    if (!iframe) return 0;
    const rectHeight = iframe.getBoundingClientRect().height;
    const attributeHeight = parseFloat(iframe.getAttribute('height') || '0');
    const styleHeight = parseFloat(iframe.style.height || '0');
    return Math.max(rectHeight || 0, attributeHeight || 0, styleHeight || 0);
  }

  function handleIframeHeightChange(iframe) {
    const currentHeight = getIframeHeight(iframe);
    if (!currentHeight) return;
    if (!lastIframeHeight) {
      lastIframeHeight = currentHeight;
      return;
    }
    const heightDifference = Math.abs(currentHeight - lastIframeHeight);
    lastIframeHeight = currentHeight;

    if (!observerArmed || heightDifference < HEIGHT_CHANGE_THRESHOLD) return;
    scheduleScrollToFormTop();
  }

  if (embedElement) {
    const iframeCreationObserver = new MutationObserver(function () {
      const iframe = embedElement.querySelector('iframe');
      if (!iframe) return;
      if (iframe.getAttribute('data-nicole-formrun-observer') === 'true') return;
      iframe.setAttribute('data-nicole-formrun-observer', 'true');
      lastIframeHeight = getIframeHeight(iframe);

      const iframeAttributeObserver = new MutationObserver(function () {
        handleIframeHeightChange(iframe);
      });
      iframeAttributeObserver.observe(iframe, {
        attributes: true,
        attributeFilter: ['style', 'height']
      });

      if ('ResizeObserver' in window) {
        const iframeResizeObserver = new ResizeObserver(function () {
          handleIframeHeightChange(iframe);
        });
        iframeResizeObserver.observe(iframe);
      }
      iframeCreationObserver.disconnect();
    });

    iframeCreationObserver.observe(embedElement, {
      childList: true,
      subtree: true
    });
  }

  // formrun SDK読み込み
  const scriptUrl = 'https://sdk.form.run/js/v2/embed.js';
  if (!document.querySelector('script[src="' + scriptUrl + '"]')) {
    const script = document.createElement('script');
    script.src = scriptUrl;
    script.async = true;
    document.body.appendChild(script);
  }

  document.addEventListener('DOMContentLoaded', updateHeading);
})();
</script>
