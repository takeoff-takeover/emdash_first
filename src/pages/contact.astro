// src/pages/contact.astro
// ニコル・グループ 公式固定ページ（WordPress/Elementor デザインレイアウト完全継承）
import NicoleLayout from "../layouts/NicoleLayout.astro";

const pageTitle = "お問い合わせ | Nicole Group 公式";
const pageDescription = "ニコル・グループへのお問い合わせ・ご相談窓口。試乗・商談・点検整備など各ショールームへのお問い合わせはこちら。";

// Elementor 完全継承HTMLコンテンツ
const elementorHtml = "<div data-elementor-type=\"wp-page\" data-elementor-id=\"2263\" class=\"elementor elementor-2263\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-8e9842a e-flex e-con-boxed e-con e-parent\" data-id=\"8e9842a\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-65dd69e elementor-widget elementor-widget-heading\" data-id=\"65dd69e\" data-element_type=\"widget\" data-e-type=\"widget\" id=\"contact-heading-form\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">お問い合わせ</h2>\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-50780bf e-flex e-con-boxed e-con e-parent\" data-id=\"50780bf\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-602a7af elementor-widget elementor-widget-text-editor\" data-id=\"602a7af\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p><span style=\"font-style: inherit; font-weight: inherit;\">以下のフォームをご入力の上、プライバシー・ステートメントをご一読いただき、ご了承いただける場合には「同意する」を選択して次へお進みください。</span></p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-c2a2bd3 elementor-widget elementor-widget-text-editor\" data-id=\"c2a2bd3\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>※お問い合わせ内容によっては、ご回答までにお時間をいただく場合がございます。あらかじめご了承ください。また内容により、担当者よりお電話でご連絡させていただく場合がございます。</p><p>※お車の不調・故障・修理など、サービス・メンテナンスに関するご相談は、お近くのNicole Groupの各ショールームまたはサービス拠点へ直接ご連絡いただきますようお願いいたします。インターネットからのお問い合わせでは対応できない場合がございます。</p><p>※営業・ご提案などの内容につきましては、返信を差し控えさせていただく場合がございます。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-228aba5 e-con-full e-flex e-con e-parent\" data-id=\"228aba5\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-fa03c1c elementor-widget elementor-widget-html\" data-id=\"fa03c1c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<style>\r\n  /*\r\n   * =========================================================\r\n   * Nicole Group formrun埋め込み\r\n   * 本番 /contact/ 用\r\n   *\r\n   * ・確認画面はiframe内で表示\r\n   * ・送信完了後はブラウザ全体で外部完了ページへ遷移\r\n   * =========================================================\r\n   */\r\n\r\n  #formrun-wrapper {\r\n    position: relative;\r\n    width: 100%;\r\n    scroll-margin-top: 120px;\r\n  }\r\n\r\n  #formrun-embed {\r\n    width: 100%;\r\n    min-height: 700px;\r\n  }\r\n\r\n  #formrun-embed iframe {\r\n    display: block;\r\n    width: 100% !important;\r\n    max-width: 100% !important;\r\n    border: 0 !important;\r\n  }\r\n\r\n  @media screen and (max-width: 767px) {\r\n    #formrun-wrapper {\r\n      scroll-margin-top: 24px;\r\n    }\r\n\r\n    #formrun-embed {\r\n      min-height: 600px;\r\n    }\r\n  }\r\n</style>\r\n\r\n<div id=\"formrun-wrapper\">\r\n  <div\r\n    id=\"formrun-embed\"\r\n    class=\"formrun-embed\"\r\n    data-formrun-redirect=\"true\"\r\n    aria-label=\"お問い合わせフォーム\"\r\n  ></div>\r\n</div>\r\n\r\n<script>\r\n(function () {\r\n  'use strict';\r\n\r\n  const params = new URLSearchParams(window.location.search);\r\n\r\n  /*\r\n   * =========================================================\r\n   * 基本設定\r\n   * =========================================================\r\n   */\r\n\r\n  const DEFAULT_BRAND = 'nicole';\r\n\r\n  /*\r\n   * 固定ヘッダーとの重なりを避けるための余白\r\n   */\r\n  const SCROLL_OFFSET_PC = 120;\r\n  const SCROLL_OFFSET_SP = 24;\r\n\r\n  /*\r\n   * 初回描画による高さ変更ではスクロールさせないため、\r\n   * ページ表示後に監視を有効化するまでの時間\r\n   */\r\n  const OBSERVER_ARM_DELAY = 2500;\r\n\r\n  /*\r\n   * 小さな高さ変化では反応せず、\r\n   * 入力画面と確認画面の切り替えだけを対象にする\r\n   */\r\n  const HEIGHT_CHANGE_THRESHOLD = 200;\r\n\r\n  /*\r\n   * formrun側の高さ確定を待つ時間\r\n   */\r\n  const SCROLL_DELAY = 180;\r\n\r\n  /*\r\n   * =========================================================\r\n   * ブランド判定\r\n   * URLパラメータ\r\n   * → sessionStorage\r\n   * → referrer\r\n   * → Nicole Group\r\n   * =========================================================\r\n   */\r\n\r\n  function detectBrandFromPath(pathname) {\r\n    const path = String(pathname || '').toLowerCase();\r\n\r\n    if (path.startsWith('/bmw/')) {\r\n      return 'bmw';\r\n    }\r\n\r\n    if (path.startsWith('/mini/')) {\r\n      return 'mini';\r\n    }\r\n\r\n    if (path.startsWith('/rolls-royce/')) {\r\n      return 'rolls-royce';\r\n    }\r\n\r\n    if (path.startsWith('/alpina/')) {\r\n      return 'alpina';\r\n    }\r\n\r\n    if (path.startsWith('/ferrari/')) {\r\n      return 'ferrari';\r\n    }\r\n\r\n    return DEFAULT_BRAND;\r\n  }\r\n\r\n  /*\r\n   * =========================================================\r\n   * 車種・シリーズ名の整形\r\n   * =========================================================\r\n   */\r\n\r\n  function normalizeTitle(title) {\r\n    if (!title) {\r\n      return '';\r\n    }\r\n\r\n    let normalizedTitle = String(title).trim();\r\n\r\n    normalizedTitle = normalizedTitle.replace(/\\u3000/g, ' ');\r\n    normalizedTitle = normalizedTitle.replace(/\\s+/g, ' ').trim();\r\n    normalizedTitle = normalizedTitle.replace(\r\n      /\\s*-\\s*TEST\\s*$/i,\r\n      ''\r\n    );\r\n    normalizedTitle = normalizedTitle\r\n      .split(' - ')[0]\r\n      .trim();\r\n    normalizedTitle = normalizedTitle\r\n      .replace(/\\s*[｜|]\\s*Nicole.*$/i, '')\r\n      .trim();\r\n    normalizedTitle = normalizedTitle.replace(\r\n      /^BMW\\s+/i,\r\n      ''\r\n    );\r\n\r\n    return normalizedTitle;\r\n  }\r\n\r\n  /*\r\n   * =========================================================\r\n   * ブランド取得\r\n   * =========================================================\r\n   */\r\n\r\n  let brandSlug = String(\r\n    params.get('brand') || ''\r\n  ).toLowerCase();\r\n\r\n  if (!brandSlug) {\r\n    brandSlug = String(\r\n      sessionStorage.getItem('ng_brand') || ''\r\n    ).toLowerCase();\r\n  }\r\n\r\n  if (!brandSlug) {\r\n    try {\r\n      const referrerPath = document.referrer\r\n        ? new URL(document.referrer).pathname\r\n        : '';\r\n\r\n      brandSlug = detectBrandFromPath(referrerPath);\r\n    } catch (error) {\r\n      brandSlug = DEFAULT_BRAND;\r\n    }\r\n  }\r\n\r\n  if (!brandSlug || brandSlug === 'group') {\r\n    brandSlug = DEFAULT_BRAND;\r\n  }\r\n\r\n  const allowedBrands = [\r\n    'bmw',\r\n    'mini',\r\n    'rolls-royce',\r\n    'alpina',\r\n    'ferrari',\r\n    'nicole'\r\n  ];\r\n\r\n  if (!allowedBrands.includes(brandSlug)) {\r\n    brandSlug = DEFAULT_BRAND;\r\n  }\r\n\r\n  /*\r\n   * =========================================================\r\n   * ブランド表示名\r\n   * =========================================================\r\n   */\r\n\r\n  const brandMap = {\r\n    'bmw': 'BMW',\r\n    'mini': 'MINI',\r\n    'rolls-royce': 'Rolls-Royce',\r\n    'alpina': 'ALPINA',\r\n    'ferrari': 'Ferrari',\r\n    'nicole': 'Nicole Group'\r\n  };\r\n\r\n  const brand =\r\n    brandMap[brandSlug] ||\r\n    brandMap[DEFAULT_BRAND];\r\n\r\n  /*\r\n   * =========================================================\r\n   * form_type\r\n   * 現状はログ・将来拡張用\r\n   * =========================================================\r\n   */\r\n\r\n  const formType = String(\r\n    params.get('form_type') || 'inquiry'\r\n  ).toLowerCase();\r\n\r\n  /*\r\n   * =========================================================\r\n   * 車種・シリーズ名\r\n   * =========================================================\r\n   */\r\n\r\n  const formTitleRaw =\r\n    params.get('form_title') ||\r\n    sessionStorage.getItem('ng_form_title') ||\r\n    '';\r\n\r\n  const seriesValue = normalizeTitle(formTitleRaw);\r\n\r\n  /*\r\n   * =========================================================\r\n   * ブランド別formrunフォーム\r\n   * =========================================================\r\n   */\r\n\r\n  const formIdMap = {\r\n    'bmw': '@nicole-group-contact-bmw',\r\n    'mini': '@nicole-group-contact-mini',\r\n    'rolls-royce': '@nicole-group-contact-rollsroyce',\r\n    'alpina': '@nicole-group-contact-alpina',\r\n    'ferrari': '@nicole-group-contact-ferrari',\r\n    'nicole': '@nicole-group-contact'\r\n  };\r\n\r\n  /*\r\n   * =========================================================\r\n   * ブランド別シリーズ項目\r\n   * =========================================================\r\n   */\r\n\r\n  const seriesFieldMap = {\r\n    'bmw': '_field_20',\r\n    'mini': '_field_21',\r\n    'rolls-royce': '_field_19',\r\n    'alpina': '_field_19',\r\n    'ferrari': '_field_23',\r\n    'nicole': '_field_19'\r\n  };\r\n\r\n  const formId =\r\n    formIdMap[brandSlug] ||\r\n    formIdMap[DEFAULT_BRAND];\r\n\r\n  const seriesFieldKey =\r\n    seriesFieldMap[brandSlug] ||\r\n    seriesFieldMap[DEFAULT_BRAND];\r\n\r\n  /*\r\n   * =========================================================\r\n   * formrunへ渡す初期値を作成\r\n   * =========================================================\r\n   */\r\n\r\n  const formParams = new URLSearchParams();\r\n\r\n  /*\r\n   * ブランド\r\n   */\r\n  formParams.set('_field_19', brand);\r\n\r\n  /*\r\n   * シリーズ\r\n   */\r\n  if (seriesValue && seriesFieldKey) {\r\n    formParams.set(seriesFieldKey, seriesValue);\r\n  }\r\n\r\n  /*\r\n   * スペースを「+」ではなく「%20」に統一\r\n   */\r\n  const queryString = formParams\r\n    .toString()\r\n    .replace(/\\+/g, '%20');\r\n\r\n  const formrunFormValue =\r\n    formId +\r\n    (queryString ? '?' + queryString : '');\r\n\r\n  /*\r\n   * =========================================================\r\n   * formrun埋め込み要素へ設定\r\n   * =========================================================\r\n   */\r\n\r\n  const embedElement = document.getElementById(\r\n    'formrun-embed'\r\n  );\r\n\r\n  if (!embedElement) {\r\n    console.error(\r\n      'formrun-embed が見つかりません。'\r\n    );\r\n    return;\r\n  }\r\n\r\n  embedElement.setAttribute(\r\n    'data-formrun-form',\r\n    formrunFormValue\r\n  );\r\n\r\n  /*\r\n   * 送信完了後は、formrunで設定した外部完了ページを\r\n   * iframe内ではなくブラウザ全体で表示します。\r\n   */\r\n  embedElement.setAttribute(\r\n    'data-formrun-redirect',\r\n    'true'\r\n  );\r\n\r\n  /*\r\n   * =========================================================\r\n   * フォーム上部へスクロール\r\n   * =========================================================\r\n   */\r\n\r\n  function getScrollOffset() {\r\n    return window.matchMedia(\r\n      '(max-width: 767px)'\r\n    ).matches\r\n      ? SCROLL_OFFSET_SP\r\n      : SCROLL_OFFSET_PC;\r\n  }\r\n\r\n  function scrollToFormTop() {\r\n    const wrapper = document.getElementById(\r\n      'formrun-wrapper'\r\n    );\r\n\r\n    if (!wrapper) {\r\n      return;\r\n    }\r\n\r\n    const targetPosition =\r\n      window.scrollY +\r\n      wrapper.getBoundingClientRect().top -\r\n      getScrollOffset();\r\n\r\n    window.scrollTo({\r\n      top: Math.max(targetPosition, 0),\r\n      behavior: 'smooth'\r\n    });\r\n  }\r\n\r\n  /*\r\n   * 同じタイミングで複数の監視処理が反応しても、\r\n   * スクロール処理を重複させない\r\n   */\r\n  let scrollTimer = null;\r\n\r\n  function scheduleScrollToFormTop() {\r\n    if (scrollTimer) {\r\n      window.clearTimeout(scrollTimer);\r\n    }\r\n\r\n    scrollTimer = window.setTimeout(function () {\r\n      scrollToFormTop();\r\n      scrollTimer = null;\r\n    }, SCROLL_DELAY);\r\n  }\r\n\r\n  /*\r\n   * =========================================================\r\n   * formrun iframeの高さ変化を監視\r\n   *\r\n   * 入力画面 → 確認画面\r\n   * 確認画面 → 入力画面\r\n   *\r\n   * の切り替え時にフォーム上部へ戻します。\r\n   *\r\n   * 送信完了後はdata-formrun-redirect=\"true\"により、\r\n   * ブラウザ全体で外部完了ページへ遷移します。\r\n   * =========================================================\r\n   */\r\n\r\n  let observerArmed = false;\r\n  let lastIframeHeight = 0;\r\n\r\n  window.setTimeout(function () {\r\n    observerArmed = true;\r\n  }, OBSERVER_ARM_DELAY);\r\n\r\n  function getIframeHeight(iframe) {\r\n    if (!iframe) {\r\n      return 0;\r\n    }\r\n\r\n    const rectHeight =\r\n      iframe.getBoundingClientRect().height;\r\n\r\n    const attributeHeight = parseFloat(\r\n      iframe.getAttribute('height') || '0'\r\n    );\r\n\r\n    const styleHeight = parseFloat(\r\n      iframe.style.height || '0'\r\n    );\r\n\r\n    return Math.max(\r\n      rectHeight || 0,\r\n      attributeHeight || 0,\r\n      styleHeight || 0\r\n    );\r\n  }\r\n\r\n  function handleIframeHeightChange(iframe) {\r\n    const currentHeight = getIframeHeight(iframe);\r\n\r\n    if (!currentHeight) {\r\n      return;\r\n    }\r\n\r\n    if (!lastIframeHeight) {\r\n      lastIframeHeight = currentHeight;\r\n      return;\r\n    }\r\n\r\n    const heightDifference = Math.abs(\r\n      currentHeight - lastIframeHeight\r\n    );\r\n\r\n    lastIframeHeight = currentHeight;\r\n\r\n    if (\r\n      !observerArmed ||\r\n      heightDifference < HEIGHT_CHANGE_THRESHOLD\r\n    ) {\r\n      return;\r\n    }\r\n\r\n    scheduleScrollToFormTop();\r\n  }\r\n\r\n  /*\r\n   * =========================================================\r\n   * formrun SDKによって生成されるiframeを監視\r\n   * =========================================================\r\n   */\r\n\r\n  const iframeCreationObserver =\r\n    new MutationObserver(function () {\r\n      const iframe =\r\n        embedElement.querySelector('iframe');\r\n\r\n      if (!iframe) {\r\n        return;\r\n      }\r\n\r\n      if (\r\n        iframe.getAttribute(\r\n          'data-nicole-formrun-observer'\r\n        ) === 'true'\r\n      ) {\r\n        return;\r\n      }\r\n\r\n      iframe.setAttribute(\r\n        'data-nicole-formrun-observer',\r\n        'true'\r\n      );\r\n\r\n      lastIframeHeight = getIframeHeight(iframe);\r\n\r\n      /*\r\n       * style属性・height属性の変更を監視\r\n       */\r\n      const iframeAttributeObserver =\r\n        new MutationObserver(function () {\r\n          handleIframeHeightChange(iframe);\r\n        });\r\n\r\n      iframeAttributeObserver.observe(iframe, {\r\n        attributes: true,\r\n        attributeFilter: [\r\n          'style',\r\n          'height'\r\n        ]\r\n      });\r\n\r\n      /*\r\n       * 実際の表示サイズ変更も監視\r\n       */\r\n      if ('ResizeObserver' in window) {\r\n        const iframeResizeObserver =\r\n          new ResizeObserver(function () {\r\n            handleIframeHeightChange(iframe);\r\n          });\r\n\r\n        iframeResizeObserver.observe(iframe);\r\n      }\r\n\r\n      iframeCreationObserver.disconnect();\r\n\r\n      console.log(\r\n        'formrun iframe height observer started.'\r\n      );\r\n    });\r\n\r\n  iframeCreationObserver.observe(embedElement, {\r\n    childList: true,\r\n    subtree: true\r\n  });\r\n\r\n  /*\r\n   * =========================================================\r\n   * formrun公式埋め込みスクリプトを読み込む\r\n   * =========================================================\r\n   */\r\n\r\n  const scriptUrl =\r\n    'https://sdk.form.run/js/v2/embed.js';\r\n\r\n  const existingScript = document.querySelector(\r\n    'script[src=\"' + scriptUrl + '\"]'\r\n  );\r\n\r\n  if (!existingScript) {\r\n    const script = document.createElement('script');\r\n\r\n    script.src = scriptUrl;\r\n    script.async = true;\r\n\r\n    script.onerror = function () {\r\n      console.error(\r\n        'formrun埋め込みスクリプトの読み込みに失敗しました。'\r\n      );\r\n    };\r\n\r\n    document.body.appendChild(script);\r\n  }\r\n\r\n  /*\r\n   * =========================================================\r\n   * デバッグログ\r\n   * =========================================================\r\n   */\r\n\r\n  console.log('brandSlug:', brandSlug);\r\n  console.log('brand:', brand);\r\n  console.log('formType:', formType);\r\n  console.log('formTitleRaw:', formTitleRaw);\r\n  console.log('seriesValue:', seriesValue);\r\n  console.log('seriesFieldKey:', seriesFieldKey);\r\n  console.log('formrunFormValue:', formrunFormValue);\r\n})();\r\n</script>\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-40aa876 e-flex e-con-boxed e-con e-parent\" data-id=\"40aa876\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-49307ec elementor-widget elementor-widget-html\" data-id=\"49307ec\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<script>\r\n(function () {\r\n\r\n  function updateHeading() {\r\n    const params = new URLSearchParams(window.location.search);\r\n    const formType = params.get('form_type');\r\n\r\n    const headingMap = {\r\n      inquiry: 'お問い合わせ',\r\n      visit_testdrive: '来場・試乗予約'\r\n    };\r\n\r\n    // ElementorのCSS IDは「外枠div」のことが多い\r\n    const wrapper = document.getElementById('contact-heading-form');\r\n    if (!wrapper) return;\r\n\r\n    // 1) もしIDがhタグに付いてるならそれを使う\r\n    // 2) そうでなければ、内部の h1-h6 or .elementor-heading-title を探す\r\n    const isHeadingTag = /^H[1-6]$/.test(wrapper.tagName);\r\n    const headingEl = isHeadingTag\r\n      ? wrapper\r\n      : (wrapper.querySelector('.elementor-heading-title') ||\r\n         wrapper.querySelector('h1,h2,h3,h4,h5,h6'));\r\n\r\n    if (!headingEl) return;\r\n\r\n    const newText = headingMap[formType] || 'お問い合わせ';\r\n\r\n    // textContentのみ変更（タグ/クラス/スタイルは絶対触らない）\r\n    if (headingEl.textContent !== newText) {\r\n      headingEl.textContent = newText;\r\n    }\r\n\r\n    // デバッグ（必要な間だけ）\r\n    console.log('formType:', formType);\r\n    console.log('heading updated to:', newText);\r\n  }\r\n\r\n  // Elementor対策：初回＋少し遅延で再適用\r\n  document.addEventListener('DOMContentLoaded', function () {\r\n    updateHeading();\r\n    setTimeout(updateHeading, 300);\r\n    setTimeout(updateHeading, 1000);\r\n  });\r\n\r\n})();\