t_type=\"icon-list.default\">\n\t\t\t\t\t\t\t<ul class=\"elementor-icon-list-items\">\n\t\t\t\t\t\t\t<li class=\"elementor-icon-list-item\">\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"/customer-policy\">\n\n\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-icon-list-text\">お客さま本位の業務運営方針（FD宣言）</span>\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-a95dc6e e-con-full e-flex e-con e-child\" data-id=\"a95dc6e\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-11c81af elementor-align-end elementor-mobile-align-start elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list\" data-id=\"11c81af\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-list.default\">\n\t\t\t\t\t\t\t<ul class=\"elementor-icon-list-items\">\n\t\t\t\t\t\t\t<li class=\"elementor-icon-list-item\">\n\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-icon-list-text\">Copyright © Nicole Group All Rights Reserved.</span>\n\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-10156d5 e-flex e-con-boxed e-con e-parent\" data-id=\"10156d5\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-41118ef2 elementor-widget elementor-widget-html\" data-id=\"41118ef2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t\t<script>\r\n(function () {\r\n\r\n  function detectBrand(pathname) {\r\n    const p = (pathname || '').toLowerCase();\r\n    if (p.startsWith('/bmw/')) return 'bmw';\r\n    if (p.startsWith('/mini/')) return 'mini';\r\n    if (p.startsWith('/rolls-royce/')) return 'rolls-royce';\r\n    if (p.startsWith('/alpina/')) return 'alpina';\r\n    if (p.startsWith('/ferrari/')) return 'ferrari';\r\n    return 'nicole';\r\n  }\r\n\r\n  function normalizeTitle(title) {\r\n    if (!title) return '';\r\n    let t = String(title).trim();\r\n\r\n    // 全角スペース→半角、連続スペース→1つ\r\n    t = t.replace(/\\u3000/g, ' ');\r\n    t = t.replace(/\\s+/g, ' ').trim();\r\n\r\n    // 「 - TEST」削除\r\n    t = t.replace(/\\s*-\\s*TEST\\s*$/i, '');\r\n\r\n    // SEOタイトルの後半を落とす（最初の \" - \" より後ろ）\r\n    t = t.split(' - ')[0].trim();\r\n\r\n    // 末尾のサイト名を落とす（残っている場合）\r\n    t = t.replace(/\\s*[｜|]\\s*Nicole.*$/i, '').trim();\r\n\r\n    // 先頭に「BMW 」が付くケースは外す（必要なら）\r\n    t = t.replace(/^BMW\\s+/, '');\r\n\r\n    return t;\r\n  }\r\n\r\n  function getSourceTitle() {\r\n    const h1 = document.querySelector('h1');\r\n    if (h1 && h1.textContent) return normalizeTitle(h1.textContent);\r\n\r\n    const og = document.querySelector('meta[property=\"og:title\"]');\r\n    if (og && og.content) return normalizeTitle(og.content);\r\n\r\n    return normalizeTitle(document.title || '');\r\n  }\r\n\r\n  // ★クリックされた要素(.js-contact-link)から、実際のリンク(a)を特定してhrefを取る\r\n  function getHrefFromElement(el) {\r\n    if (!el) return '';\r\n\r\n    // 自身がaならそれ\r\n    if (el.tagName && el.tagName.toLowerCase() === 'a') {\r\n      return el.getAttribute('href') || '';\r\n    }\r\n\r\n    // 自身にhref属性が付いてる場合（念のため）\r\n    const ownHref = el.getAttribute && el.getAttribute('href');\r\n    if (ownHref) return ownHref;\r\n\r\n    // 子孫のaを探す（Elementorで外側にクラスが付くパターン対策）\r\n    const innerA = el.querySelector ? el.querySelector('a[href]') : null;\r\n    if (innerA) return innerA.getAttribute('href') || '';\r\n\r\n    return '';\r\n  }\r\n\r\n  // ★ form_type を “絶対に落とさない”：\r\n  // 1) data-form-type（外側でも内側aでもOK） 2) hrefのform_type 3) 現在URLのform_type 4) デフォルトinquiry\r\n  function resolveFormType(el, clickedHref) {\r\n    // data-form-type（外側）\r\n    const dataTypeOuter = (el && el.getAttribute) ? (el.getAttribute('data-form-type') || '').trim() : '';\r\n    if (dataTypeOuter) return dataTypeOuter;\r\n\r\n    // data-form-type（内側a）\r\n    const innerA = el && el.querySelector ? el.querySelector('a[data-form-type]') : null;\r\n    if (innerA) {\r\n      const dataTypeInner = (innerA.getAttribute('data-form-type') || '').trim();\r\n      if (dataTypeInner) return dataTypeInner;\r\n    }\r\n\r\n    // hrefから読む\r\n    try {\r\n      const original = new URL(clickedHref || '', location.origin);\r\n      const hrefType = original.searchParams.get('form_type');\r\n      if (hrefType) return hrefType;\r\n    } catch (e) {}\r\n\r\n    // 現在URLから読む（contactページ直打ちのとき等）\r\n    const pageType = new URLSearchParams(location.search).get('form_type');\r\n    if (pageType) return pageType;\r\n\r\n    return 'inquiry';\r\n  }\r\n\r\n  function buildContactUrl(clickedHref, el) {\r\n    const brandSlug = detectBrand(location.pathname);\r\n    const sourceTitle = getSourceTitle();\r\n\r\n    const formType = resolveFormType(el, clickedHref);\r\n\r\n    const to = new URL('/contact/', location.origin);\r\n    to.searchParams.set('brand', brandSlug);\r\n\r\n    // ★必ず付く\r\n    if (formType) to.searchParams.set('form_type', formType);\r\n\r\n    if (sourceTitle) to.searchParams.set('form_title', sourceTitle);\r\n\r\n    // 保険：sessionStorageにも保存\r\n    sessionStorage.setItem('ng_brand', brandSlug);\r\n    if (sourceTitle) sessionStorage.setItem('ng_form_title', sourceTitle);\r\n\r\n    return to.toString();\r\n  }\r\n\r\n  // ★イベント委譲：aでもdivでもbuttonでも拾う\r\n  document.addEventListener('click', function (e) {\r\n    const el = e.target && e.target.closest ? e.target.closest('.js-contact-link') : null;\r\n    if (!el) return;\r\n\r\n    // 新規タブ等は邪魔しない（実リンクがaの時だけ）\r\n    const href = getHrefFromElement(el);\r\n    let linkEl = null;\r\n    if (el.tagName && el.tagName.toLowerCase() === 'a') linkEl = el;\r\n    else if (el.querySelector) linkEl = el.querySelector('a[href]');\r\n\r\n    if (linkEl && (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey)) return;\r\n\r\n    const nextUrl = buildContactUrl(href, el);\r\n\r\n    console.log('Clicked href:', href);\r\n    console.log('Resolved form_type:', new URL(nextUrl).searchParams.get('form_type'));\r\n    console.log('Generated contact URL:', nextUrl);\r\n\r\n    e.preventDefault();\r\n    location.href = nextUrl;\r\n  }, true);\r\n\r\n  // ついでに「見た目のhref」も差し替え（aタグだけ）\r\n  document.querySelectorAll('a.js-contact-link').forEach((a) => {\r\n    const href = a.getAttribute('href') || '';\r\n    a.href = buildContactUrl(href, a);\r\n  });\r\n\r\n})();\r\n</script>\r\n\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</footer>\n\t\t\t</div><!-- #page -->\n<script type=\"speculationrules\">\n{\"prefetch\":[{\"source\":\"document\",\"where\":{\"and\":[{\"href_matches\":\"/*\"},{\"not\":{\"href_matches\":[\"/wp/wp-*.php\",\"/wp/wp-admin/*\",\"/wp/wp-content/uploads/*\",\"/wp/wp-content/*\",\"/wp/wp-content/plugins/*\",\"/wp/wp-content/themes/astra/*\",\"/*\\\\?(.+)\"]}},{\"not\":{\"selector_matches\":\"a[rel~=\\\"nofollow\\\"]\"}},{\"not\":{\"selector_matches\":\".no-prefetch, .no-prefetch a\"}}]},\"eagerness\":\"conservative\"}]}\n</script>\n<!-- Instagram Feed JS -->\r\n<script type=\"text/javascript\">\r\nvar sbiajaxurl = \"https://www.nicole.co.jp/wp/wp-admin/admin-ajax.php\";\r\n</script>\r\n\t\t\t<script>\n\t\t\t\t( () => {\n\t\t\t\t\tconst lazyloadRunObserver = () => {\n\t\t\t\t\t\tconst lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );\n\t\t\t\t\t\tconst lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {\n\t\t\t\t\t\t\tentries.forEach( ( entry ) => {\n\t\t\t\t\t\t\t\tif ( entry.isIntersecting ) {\n\t\t\t\t\t\t\t\t\tlet lazyloadBackground = entry.target;\n\t\t\t\t\t\t\t\t\tif( lazyloadBackground ) {\n\t\t\t\t\t\t\t\t\t\tlazyloadBackground.classList.add( 'e-lazyloaded' );\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\tlazyloadBackgroundObserver.unobserve( e