	}

	.form-submit-btn:hover {
		background-color: #c4000f;
		border-color: #c4000f;
		transform: translateY(-1px);
	}

	.form-submit-btn:disabled {
		opacity: 0.6;
		cursor: not-allowed;
		transform: none;
	}

	.form-submit-icon {
		width: 18px;
		height: 18px;
	}

	/* --- レスポンシブ --- */
	@media (max-width: 768px) {
		.contact-form-panel {
			gap: 24px;
			padding-top: 24px;
		}

		.form-row-2col {
			grid-template-columns: 1fr;
			gap: 20px;
		}

		.form-submit-btn {
			width: 100%;
			min-width: 0;
