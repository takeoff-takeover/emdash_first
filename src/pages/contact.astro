	/* エラーバナー */
	.form-error-banner {
		padding: 14px 18px;
		background-color: rgba(230, 0, 18, 0.12);
		border: 1px solid rgba(230, 0, 18, 0.5);
		border-radius: var(--radius-card, 4px);
		color: #ffd0d4;
		font-size: 14px;
		line-height: 1.7;
	}

	/* 送信ボタン（最重要CTA：アクセントレッド・丸型ピル・グロー影なし） */
	.form-submit-wrap {
		display: flex;
		justify-content: flex-start;
		padding-top: 8px;
	}

	.form-submit-btn {
