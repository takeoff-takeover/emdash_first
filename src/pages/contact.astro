</style>

<!-- URLパラメータ引き継ぎ ＆ 自社API（/api/contact）送信スクリプト -->
<script is:inline>
(function () {
	'use strict';

	const params = new URLSearchParams(window.location.search);
	const DEFAULT_BRAND = 'nicole';

	const BRAND_LABEL_TO_SLUG = {
		'BMW': 'bmw',
		'MINI': 'mini',
		'Rolls-Royce': 'rolls-royce',
		'ALPINA': 'alpina',
		'Ferrari': 'ferrari',
		'Nicole Group': 'nicole'
	};

	function detectBrandFromPath(pathname) {
		const path = String(pathname || '').toLowerCase();
		if (path.startsWith('/bmw/')) return 'bmw';
		if (path.startsWith('/mini/')) return 'mini';
		if (path.startsWith('/rolls-royce/')) return 'rolls-royce';
		if (path.startsWith('/alpina/')) return 'alpina';
		if (path.startsWith('/ferrari/')) return 'ferrari';
		return DEFAULT_BRAND;
	}

	function normalizeTitle(title) {
		if (!title) return '';
		let t = String(title).trim();
		t = t.replace(/\u3000/g, ' ');
		t = t.replace(/\s+/g, ' ').trim();
		t = t.replace(/\s*-\s*TEST\s*$/i, '');
		t = t.split(' - ')[0].trim();
		t = t.replace(/\s*[｜|]\s*Nicole.*$/i, '').trim();
		t = t.replace(/^BMW\s+/i, '');
		return t;
	}

	function initFormContext() {
		// 1. form_type 連動（見出し・種別ラジオ自動選択）
		const formType = params.get('form_type') || 'inquiry';
		const headingMap = {
			inquiry: 'お問い合わせ',
			visit_testdrive: '来場・試乗予約'
		};
		const headingEl = document.getElementById('contact-heading');
		const breadcrumbEl = document.getElementById('contact-breadcrumb-current');
		if (headingEl && headingMap[formType]) {
			headingEl.textContent = headingMap[formType];
		}
		if (breadcrumbEl && headingMap[formType]) {
			breadcrumbEl.textContent = headingMap[formType];
		}

		const formTypeInput = document.getElementById('field-form-type');
		if (formTypeInput) formTypeInput.value = formType;

		if (formType === 'visit_testdrive') {
			const visitRadio = document.querySelector('input[name="inquiry_type"][value="来場・試乗予約"]');
			if (visitRadio) visitRadio.checked = true;
		}

		// 2. ブランド自動判別・初期選択
		let brandSlug = String(params.get('brand') || '').toLowerCase();
		if (!brandSlug) {
			brandSlug = String(sessionStorage.getItem('ng_brand') || '').toLowerCase();
		}
		if (!brandSlug) {
			try {
				const referrerPath = document.referrer ? new URL(document.referrer).pathname : '';
				brandSlug = detectBrandFromPath(referrerPath);
			} catch {
				brandSlug = DEFAULT_BRAND;
			}
		}
		const allowedBrands = ['bmw', 'mini', 'rolls-royce', 'alpina', 'ferrari', 'nicole'];
		if (!allowedBrands.includes(brandSlug)) brandSlug = DEFAULT_BRAND;

		const brandMap = {
			bmw: 'BMW',
			mini: 'MINI',
			'rolls-royce': 'Rolls-Royce',
			alpina: 'ALPINA',
			ferrari: 'Ferrari',
			nicole: 'Nicole Group'
		};

		const brandSlugInput = document.getElementById('field-brand-slug');
		if (brandSlugInput) brandSlugInput.value = brandSlug;

		const brandSelect = document.getElementById('field-brand');
		if (brandSelect && brandMap[brandSlug]) {
			brandSelect.value = brandMap[brandSlug];
		}
		if (brandSelect && brandSlugInput) {
			brandSelect.addEventListener('change', function () {
				brandSlugInput.value = BRAND_LABEL_TO_SLUG[brandSelect.value] || DEFAULT_BRAND;
			});
		}

		// 3. 検討モデル（form_title）自動プリセット
		const formTitleRaw = params.get('form_title') || sessionStorage.getItem('ng_form_title') || '';
		const seriesValue = normalizeTitle(formTitleRaw);
		const seriesInput = document.getElementById('field-series');
		if (seriesInput && seriesValue) {
			seriesInput.value = seriesValue;
		}

		// 4. 遷移元URL記録
		const sourceUrlInput = document.getElementById('field-source-url');
		if (sourceUrlInput) {
			sourceUrlInput.value = document.referrer || window.location.href;
		}

		// 5. バリデーション ＆ 自社API（/api/contact）送信ハンドリング
		const form = document.getElementById('nicole-contact-form');
		const errorBanner = document.getElementById('form-error-banner');
		const submitBtn = document.getElementById('form-submit-btn');
		const submitBtnLabel = submitBtn ? submitBtn.querySelector('span') : null;

		if (!form) return;

		form.addEventListener('submit', async function (event) {
			event.preventDefault();

			// 既存エラーリセット
			form.querySelectorAll('.is-invalid').forEach(function (el) {
				el.classList.remove('is-invalid');
			});
			if (errorBanner) {
				errorBanner.hidden = true;
				errorBanner.textContent = '';
			}

			const errors = [];
			const requiredFields = form.querySelectorAll('[required]');
			let firstInvalid = null;

			requiredFields.forEach(function (field) {
				if (field.type === 'checkbox') {
					if (!field.checked) {
						errors.push('プライバシー・ポリシーへの同意が必要です。');
						if (!firstInvalid) firstInvalid = field;
					}
				} else if (field.type === 'email') {
					const val = field.value.trim();
					if (!val || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
						field.classList.add('is-invalid');
						errors.push('正しいメールアドレスをご入力ください。');
						if (!firstInvalid) firstInvalid = field;
					}
				} else if (!field.value.trim()) {
					field.classList.add('is-invalid');
					if (!firstInvalid) firstInvalid = field;
				}
			});

			if (firstInvalid) {
				if (errorBanner) {
					errorBanner.textContent = errors.length
						? errors[0]
						: '必須項目をご入力の上、送信してください。';
					errorBanner.hidden = false;
				}
				firstInvalid.focus();
				return;
			}

			if (submitBtn) submitBtn.disabled = true;
			if (submitBtnLabel) submitBtnLabel.textContent = '送信しています...';

			try {
				const formData = new FormData(form);
				const response = await fetch('/api/contact', {
					method: 'POST',
					body: formData,
					headers: { Accept: 'application/json' }
				});
				const result = await response.json().catch(function () { return {}; });

				if (!response.ok || !result.ok) {
					throw new Error(result.error || '送信中にエラーが発生しました。');
				}

				const refQuery = result.referenceId
					? '?ref=' + encodeURIComponent(result.referenceId)
					: '';
				window.location.href = '/contact-thanks' + refQuery;
			} catch (err) {
				if (errorBanner) {
					errorBanner.textContent =
						(err && err.message) ||
						'送信中にエラーが発生しました。時間をおいて再度お試しいただくか、お電話にてお問い合わせください。';
					errorBanner.hidden = false;
				}
				if (submitBtn) submitBtn.disabled = false;
				if (submitBtnLabel) submitBtnLabel.textContent = '入力内容を送信する';
			}
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initFormContext);
	} else {
		initFormContext();
	}
})();
</script>
