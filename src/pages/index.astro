---
import NicoleLayout from "../layouts/NicoleLayout.astro";
import NicoleHomeMain from "../components/NicoleHomeMain.astro";

// 旧WordPress検索クエリ（/?s=...）の互換転送
const searchParam = Astro.url.searchParams.get("s");
if (searchParam !== null) {
	return Astro.redirect(`/search?q=${encodeURIComponent(searchParam)}`, 301);
}
---

<NicoleLayout 
	title="ニコル・グループ公式｜BMW・MINI・Rolls-Royce・Ferrari 正規ディーラー（東京・神奈川）" 
	description="東京・神奈川を中心にBMW、MINI、Rolls-Royce、Ferrari、BMW ALPINAの正規ディーラーおよび認定サービス工場を展開するNicole Group（ニコル・グループ）公式サイト。新車・認定中古車・車検整備・希少車委託販売。">
	<NicoleHomeMain />
</NicoleLayout>
