---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { Image } from "emdash/ui";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

// 最新ニュースを取得
const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: 4,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// 取扱ブランド・グループ会社データ
const brands = [
	{
		name: "BMW",
		company: "ニコル・カーズ合同会社",
		desc: "最新の駆けぬける歓びと最先端のテクノロジー。神奈川・東京エリアの正規ディーラー。",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/05/P90580177_highRes_bmw-m235-xdrive-gran-scaled-e1779344456477-1024x553.jpg",
		tag: "AUTHORIZED DEALER"
	},
	{
		name: "MINI",
		company: "ニコル・カーズ合同会社",
		desc: "ゴーカート・フィーリングと唯一無二のデザイン。特別なカスタマイズをお届けします。",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/06/1P90515769_highRes_mini-crossover-highl-1024x576.jpg",
		tag: "AUTHORIZED DEALER"
	},
	{
		name: "Rolls-Royce",
		company: "Nicole MotorCars合同会社",
		desc: "究極のラグジュアリーとビスポークの世界。至高のモーターカーを取り揃えています。",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/03/P90608285_highRes_slate-blue-07-2025-scaled-e1775197240986-1024x555.jpg",
		tag: "OFFICIAL RETAILER"
	},
	{
		name: "Ferrari",
		company: "Nicole Competizione合同会社",
		desc: "跳ね馬の情熱と伝説のモータースポーツDNA。卓越したパフォーマンスと美の頂点。",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/03/P90460301_highRes_the-first-edition-04-scaled-e1774607834604-1024x702.jpg",
		tag: "OFFICIAL RETAILER"
	},
	{
		name: "BMW ALPINA",
		company: "ニコル・オートモビルズ合同会社",
		desc: "名門アルピナの日本総輸入元として長年築き上げた信頼と洗練のクラフトマンシップ。",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/04/169_DSC7243-scaled-e1782978343603-1024x473.jpg",
		tag: "GENERAL IMPORTER"
	},
	{
		name: "Nicole Racing",
		company: "ニコル・レーシング・ジャパン合同会社",
		desc: "サーキットからストリートへ。培われたエンジニアリングとレースサポートのDNA。",
		image: "https://www.nicole.co.jp/wp/wp-content/uploads/2026/07/20260718_4-scaled.jpg",
		tag: "MOTORSPORTS & TUNING"
	}
];
---

<Base title={siteTitle} description={siteTagline}>
	<!-- ヒーローセクション -->
	<section class="hero-section">
		<div class="hero-backdrop">
			<img 
				src="https://www.nicole.co.jp/wp/wp-content/uploads/2026/04/32P90615637_highRes_the-new-bmw-ix3-50-x-1536x1024.jpg" 
				alt="Nicole Group Luxury Cars"
				class="hero-bg-img"
			/>
			<div class="hero-gradient"></div>
		</div>
		<div class="frame hero-content">
			<span class="hero-eyebrow">NICOLE GROUP</span>
			<h1 class="hero-title">期待を超える<br class="hero-break" />喜びを。</h1>
			<p class="hero-tagline">{siteTagline}</p>
			<div class="hero-actions">
				<a href="/pages/philosophy" class="btn-nicole btn-nicole--primary">企業理念</a>
				<a href="/pages/corporate" class="btn-nicole btn-nicole--ghost">会社概要</a>
			</div>
		</div>
	</section>

	<!-- フィロソフィー・ステートメント -->
	<section class="band philosophy-section">
		<div class="frame philosophy-inner">
			<div class="philosophy-text">
				<span class="eyebrow">PHILOSOPHY</span>
				<h2 class="philosophy-title">最高の情熱と誠実さで、<br />特別なカーライフをお届けします。</h2>
				<p class="philosophy-desc">
					ニコル・グループは、半世紀近くにわたり世界のプレミアムブランドの魅力をお届けしてきました。<br />
					お客様ひとりひとりのライフスタイルに寄り添い、お車の購入からメンテナンス、アフターサポートまで、期待を超える感動と信頼をお約束いたします。
				</p>
			</div>
		</div>
	</section>

	<!-- ブランド＆グループ会社紹介 -->
	<section class="band brands-section">
		<div class="frame">
			<div class="section-header">
				<div>
					<span class="eyebrow">BRANDS & COMPANIES</span>
					<h2 class="section-title">取扱ブランド & グループ会社</h2>
				</div>
			</div>

			<div class="brands-grid">
				{brands.map((b) => (
					<div class="brand-card">
						<div class="brand-card__image-wrap">
							<img src={b.image} alt={b.name} class="brand-card__image" loading="lazy" />
							<span class="brand-card__tag">{b.tag}</span>
						</div>
						<div class="brand-card__body">
							<h3 class="brand-card__title">{b.name}</h3>
							<p class="brand-card__company">{b.company}</p>
							<p class="brand-card__desc">{b.desc}</p>
						</div>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- 最新ニュース＆トピックス -->
	<section class="band news-section">
		<div class="frame">
			<div class="section-header">
				<div>
					<span class="eyebrow">NEWS & TOPICS</span>
					<h2 class="section-title">最新ニュース・お知らせ</h2>
				</div>
				<a href="/posts" class="view-all-link">
					ニュース一覧を見る
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon">
						<path d="M5 12h14"></path>
						<path d="m12 5 7 7-7 7"></path>
					</svg>
				</a>
			</div>

			<div class="news-grid">
				{posts.map((post) => (
					<article class="news-card">
						<a href={`/posts/${post.id}`} class="news-card__link">
							<div class="news-card__media">
								{post.data.featured_image ? (
									<Image image={post.data.featured_image} class="news-card__img" />
								) : (
									<div class="news-card__placeholder">
										<span>Nicole Group</span>
									</div>
								)}
							</div>
							<div class="news-card__body">
								<h3 class="news-card__title">{post.data.title}</h3>
								<p class="news-card__excerpt">{post.data.excerpt}</p>
							</div>
						</a>
					</article>
				))}
			</div>
		</div>
	</section>
</Base>

<style>
	/* ヒーローセクション */
	.hero-section {
		position: relative;
		min-height: 82vh;
		display: flex;
		align-items: center;
		overflow: hidden;
		background: #000;
	}

	.hero-backdrop {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero-bg-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		opacity: 0.55;
		filter: brightness(0.9) contrast(1.1);
		transform: scale(1.03);
		animation: heroZoom 14s ease-out forwards;
	}

	@keyframes heroZoom {
		from { transform: scale(1.05); }
		to { transform: scale(1); }
	}

	.hero-gradient {
		position: absolute;
		inset: 0;
		background: radial-gradient(circle at 30% 50%, rgba(10, 10, 12, 0.4) 0%, rgba(10, 10, 12, 0.95) 100%),
					linear-gradient(to top, rgba(10, 10, 12, 1) 0%, transparent 60%);
	}

	.hero-content {
		position: relative;
		z-index: 1;
		padding-block: var(--spacing-16);
		max-width: 800px;
	}

	.hero-eyebrow {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.25em;
		color: #a1a1aa;
		text-transform: uppercase;
		margin-bottom: var(--spacing-4);
	}

	.hero-title {
		font-size: clamp(2.75rem, 2rem + 4vw, 4.75rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.03em;
		color: #ffffff;
		margin-bottom: var(--spacing-6);
		text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
	}

	.hero-tagline {
		font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.35rem);
		color: #d4d4d8;
		line-height: 1.6;
		margin-bottom: var(--spacing-8);
		max-width: 580px;
	}

	.hero-actions {
		display: flex;
		gap: var(--spacing-4);
		flex-wrap: wrap;
	}

	.btn-nicole {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem 1.75rem;
		border-radius: var(--radius-sm);
		font-size: 0.9375rem;
		font-weight: 500;
		letter-spacing: 0.05em;
		text-decoration: none !important;
		transition: all 0.25s ease;
	}

	.btn-nicole--primary {
		background: #ffffff;
		color: #09090b !important;
		border: 1px solid #ffffff;
	}

	.btn-nicole--primary:hover {
		background: #e4e4e7;
		transform: translateY(-1px);
	}

	.btn-nicole--ghost {
		background: rgba(255, 255, 255, 0.08);
		color: #ffffff !important;
		border: 1px solid rgba(255, 255, 255, 0.25);
		backdrop-filter: blur(8px);
	}

	.btn-nicole--ghost:hover {
		background: rgba(255, 255, 255, 0.18);
		border-color: rgba(255, 255, 255, 0.4);
		transform: translateY(-1px);
	}

	/* フィロソフィーセクション */
	.philosophy-section {
		padding-block: clamp(4rem, 3rem + 3vw, 6rem);
		background: linear-gradient(180deg, #0a0a0c 0%, #111116 100%);
	}

	.philosophy-inner {
		max-width: 820px;
		margin-inline: auto;
		text-align: center;
	}

	.philosophy-title {
		font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.5rem);
		font-weight: 600;
		line-height: 1.35;
		margin-top: var(--spacing-3);
		margin-bottom: var(--spacing-6);
		color: #ffffff;
	}

	.philosophy-desc {
		font-size: 1.0625rem;
		line-height: 1.9;
		color: #a1a1aa;
	}

	/* ブランドセクション */
	.brands-section {
		padding-block: clamp(4rem, 3rem + 3vw, 6rem);
		background: #0a0a0c;
	}

	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: var(--spacing-8);
		flex-wrap: wrap;
		gap: var(--spacing-4);
	}

	.section-title {
		font-size: clamp(1.6rem, 1.3rem + 1vw, 2.25rem);
		color: #ffffff;
		margin-top: var(--spacing-2);
	}

	.brands-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
		gap: var(--spacing-6);
	}

	.brand-card {
		background: #141418;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
	}

	.brand-card:hover {
		transform: translateY(-4px);
		border-color: rgba(255, 255, 255, 0.2);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.8);
	}

	.brand-card__image-wrap {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #1a1a20;
	}

	.brand-card__image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s ease;
	}

	.brand-card:hover .brand-card__image {
		transform: scale(1.05);
	}

	.brand-card__tag {
		position: absolute;
		top: 12px;
		inset-inline-start: 12px;
		background: rgba(0, 0, 0, 0.7);
		backdrop-filter: blur(6px);
		color: #e4e4e7;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		padding: 4px 10px;
		border-radius: var(--radius-sm);
		border: 1px solid rgba(255, 255, 255, 0.15);
	}

	.brand-card__body {
		padding: var(--spacing-5);
	}

	.brand-card__title {
		font-size: 1.35rem;
		font-weight: 600;
		color: #ffffff;
		margin-bottom: 4px;
	}

	.brand-card__company {
		font-size: 0.8125rem;
		color: #a1a1aa;
		margin-bottom: var(--spacing-3);
		font-weight: 500;
	}

	.brand-card__desc {
		font-size: 0.875rem;
		line-height: 1.6;
		color: #71717a;
	}

	/* ニュースセクション */
	.news-section {
		padding-block: clamp(4rem, 3rem + 3vw, 6rem);
		background: #0f0f13;
	}

	.view-all-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		color: #ffffff !important;
		font-size: 0.9375rem;
		font-weight: 500;
		text-decoration: none !important;
		border-bottom: 1px solid rgba(255, 255, 255, 0.3);
		padding-bottom: 2px;
		transition: border-color 0.2s;
	}

	.view-all-link:hover {
		border-color: #ffffff;
	}

	.arrow-icon {
		width: 16px;
		height: 16px;
		transition: transform 0.2s;
	}

	.view-all-link:hover .arrow-icon {
		transform: translateX(4px);
	}

	.news-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: var(--spacing-6);
	}

	.news-card {
		background: #141418;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: var(--radius-lg);
		overflow: hidden;
		transition: transform 0.2s ease, border-color 0.2s ease;
	}

	.news-card:hover {
		transform: translateY(-3px);
		border-color: rgba(255, 255, 255, 0.2);
	}

	.news-card__link {
		display: block;
		text-decoration: none !important;
		color: inherit !important;
	}

	.news-card__media {
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		background: #1f1f26;
	}

	.news-card__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.3s ease;
	}

	.news-card:hover .news-card__img {
		transform: scale(1.04);
	}

	.news-card__placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		color: #52525b;
		font-family: var(--font-mono);
		font-size: 0.875rem;
	}

	.news-card__body {
		padding: var(--spacing-4);
	}

	.news-card__title {
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.5;
		color: #f4f4f6;
		margin-bottom: var(--spacing-2);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.news-card__excerpt {
		font-size: 0.8125rem;
		color: #71717a;
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@media (max-width: 640px) {
		.brands-grid, .news-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
