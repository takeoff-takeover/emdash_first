---
import {
	getEmDashEntry,
	getSeoMeta,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);

if (!page) {
	return Astro.rewrite("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});
---

<NicoleLayout title={`${page.data.title} - ニコル・グループ`} description={seo.description}>
	<div class="nicole-page-container">
		<header class="nicole-page-header">
			<div class="nicole-page-header__inner">
				<span class="nicole-page-header__badge">CORPORATE</span>
				<h1 class="nicole-page-title" {...page.edit.title}>{page.data.title}</h1>
			</div>
		</header>

		<div class="nicole-page-content">
			<div class="prose nicole-page-prose" {...page.edit.content}>
				<PortableText value={page.data.content} />
			</div>
		</div>
	</div>
</NicoleLayout>

<style>
	.nicole-page-container {
		background: #000000;
		color: #ffffff;
		min-height: 80vh;
		padding-top: 140px;
		padding-bottom: 100px;
	}

	.nicole-page-header {
		border-bottom: 1px solid rgba(255, 255, 255, 0.15);
		padding-bottom: 40px;
		margin-bottom: 60px;
	}

	.nicole-page-header__inner {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 40px;
	}

	.nicole-page-header__badge {
		display: inline-block;
		font-family: "Helvetica", sans-serif;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.15em;
		color: #e60012;
		margin-bottom: 12px;
	}

	.nicole-page-title {
		font-family: "Helvetica", sans-serif;
		font-size: clamp(2rem, 1.5rem + 2.5vw, 3.2rem);
		font-weight: 300;
		line-height: 1.2;
		color: #ffffff;
		margin: 0;
	}

	.nicole-page-content {
		max-width: 1000px;
		margin: 0 auto;
		padding: 0 40px;
	}

	.nicole-page-prose {
		color: #d1d5db;
		font-size: 16px;
		line-height: 1.9;
	}

	.nicole-page-prose :global(h2) {
		color: #ffffff;
		font-family: "Helvetica", sans-serif;
		font-weight: 400;
		font-size: 1.8rem;
		border-left: 4px solid #e60012;
		padding-left: 16px;
		margin-top: 3rem;
		margin-bottom: 1.5rem;
	}

	.nicole-page-prose :global(h3) {
		color: #ffffff;
		font-size: 1.4rem;
		margin-top: 2rem;
		margin-bottom: 1rem;
	}

	.nicole-page-prose :global(p) {
		margin-bottom: 1.8rem;
	}

	.nicole-page-prose :global(strong) {
		color: #ffffff;
	}
</style>
