---
// src/pages/pages/[slug].astro
// ニコル・グループ 固定ページ動的ルーティング＆事業会社Elementorデザイン完全継承
import { decodeSlug } from "emdash";
import NicoleLayout from "../../layouts/NicoleLayout.astro";
import fs from "node:fs";
import path from "node:path";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.rewrite("/404");
}

// 1. トップレベル独立ページへの301リダイレクト
const redirectMap: Record<string, string> = {
	corporate: "/corporate",
	philosophy: "/philosophy",
	bmw: "/bmw",
	mini: "/mini",
	locations: "/locations",
	esg_sdgs: "/esg_sdgs",
	privacystatement: "/privacystatement",
	"customer-policy": "/customer-policy",
	contact: "/contact",
	"contact-thanks": "/contact-thanks"
};

if (redirectMap[slug]) {
	return Astro.redirect(redirectMap[slug], 301);
}

// 2. 5大事業会社のElementorデータロード
const companyFileMap: Record<string, string> = {
	"nicole-cars": "NicoleCarsElementor",
	"nicole-automobiles": "NicoleAutomobilesElementor",
	"nicole-motorcars": "NicoleMotorcarsElementor",
	"nicole-competizione": "NicoleCompetizioneElementor",
	"nicole-racing-japan": "NicoleRacingJapanElementor"
};

let pageData: { title: string; description: string; cssFiles: string[]; html: string } | null = null;

if (companyFileMap[slug]) {
	const baseName = companyFileMap[slug];
	const dir = path.resolve("./src/components/companies");
	const jsonPath = path.join(dir, `${baseName}.json`);
	const htmlPath = path.join(dir, `${baseName}.html`);
	
	if (fs.existsSync(jsonPath) && fs.existsSync(htmlPath)) {
		const meta = JSON.parse(fs.readFileSync(jsonPath, "utf-8"));
		const html = fs.readFileSync(htmlPath, "utf-8");
		pageData = {
			title: meta.title,
			description: meta.description,
			cssFiles: meta.cssFiles || [],
			html
		};
	}
}

if (!pageData) {
	return Astro.rewrite("/404");
}
---

<NicoleLayout title={pageData.title} description={pageData.description}>
  <slot name="head" slot="head">
    {pageData.cssFiles.map((css: string) => (
      <link rel="stylesheet" href={css} />
    ))}
    <style is:global>
      .elementor {
        box-sizing: border-box;
      }
      .entry-content {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
      }
      .elementor img {
        height: auto;
        max-width: 100%;
      }

      /* グローバルヘッダーの左右端（max-width: 1440px / padding: 0 40px）に揃えるスタイル */
      .elementor .e-con-boxed > .e-con-inner {
        max-width: 1440px !important;
        margin: 0 auto !important;
        padding-left: 40px !important;
        padding-right: 40px !important;
        box-sizing: border-box !important;
      }

      @media (max-width: 1024px) {
        .elementor .e-con-boxed > .e-con-inner {
          padding-left: 24px !important;
          padding-right: 24px !important;
        }
      }

      @media (max-width: 480px) {
        .elementor .e-con-boxed > .e-con-inner {
          padding-left: 16px !important;
          padding-right: 16px !important;
        }
      }
    </style>
  </slot>

  <div class="elementor-page-wrapper">
    <div class="entry-content" set:html={pageData.html} />
  </div>
</NicoleLayout>
