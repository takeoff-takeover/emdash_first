// src/pages/privacystatement.astro
// ニコル・グループ 公式固定ページ（WordPress/Elementor デザインレイアウト完全継承）
import NicoleLayout from "../layouts/NicoleLayout.astro";

const pageTitle = "プライバシー・ポリシー | Nicole Group 公式";
const pageDescription = "ニコル・グループの個人情報保護方針、お客様情報の取り扱い方針について定めたプライバシーステートメントです。";

// Elementor 完全継承HTMLコンテンツ
const elementorHtml = "<div data-elementor-type=\"wp-page\" data-elementor-id=\"3\" class=\"elementor elementor-3\" data-elementor-post-type=\"page\">\n\t\t\t\t<div class=\"elementor-element elementor-element-a15994e e-flex e-con-boxed e-con e-parent\" data-id=\"a15994e\" data-element_type=\"container\" data-e-type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-9c44050 elementor-widget elementor-widget-heading\" data-id=\"9c44050\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Privacy Statement</h2>\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-8aad8c9 e-flex e-con-boxed e-con e-parent\" data-id=\"8aad8c9\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-1fd0bc6 elementor-widget elementor-widget-text-editor\" data-id=\"1fd0bc6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<div class=\"row justify-content-center\"><div class=\"col-md-10 mt-sm-0 mt-md-5 pt-2 pb-1 px-4\"><p class=\"fs-6 text-black text-start text-md-start\">Nicole Group（ニコル・グループ）は創業以来、Excellenceを企業理念として常にクォリティの高い製品とサービスをお届けすることを目指して参りました。</p><p class=\"fs-6 text-black text-start text-md-start\">この理念のもとニコル・グループ5社の主幹的役割を担うニコル・レーシング・ジャパン合同会社の他、ニコル・オートモビルズ合同会社、ニコル・カーズ合同会社、Nicole MotorCars合同会社、Nicole Competizione合同会社、（以下、総称して「当社グループ」といいます）は、お客様第一主義を掲げ、高品質な製品にふさわしい卓越したサービスをご提供しております。</p><p class=\"fs-6 text-black text-start text-md-start\">このポリシーは、お客様個人情報の取得や取扱い方法及び保護においても一貫しており、当社グループ全体で真摯に取り組んで参ります。</p><p class=\"fs-6 text-black text-start text-md-start\">ここに当社グループとしてのプライバシー・ステートメントを公表し、お客様の信頼とご理解を頂く為、以下の原則に基づき、お客様個人情報の適正な取扱いに努めます。</p></div></div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b711cee elementor-widget elementor-widget-heading\" data-id=\"b711cee\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">1.法令遵守</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-7d2bb5d elementor-widget elementor-widget-text-editor\" data-id=\"7d2bb5d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループは、個人情報の保護に関する法律及びその他の法令の規範を遵守の上、お客様の個人情報を適正に取扱います。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-86ebc64 elementor-widget elementor-widget-heading\" data-id=\"86ebc64\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">2.お客様個人情報の利用目的について</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-fda0626 elementor-widget elementor-widget-text-editor\" data-id=\"fda0626\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループでは、お預かりしたお客様個人情報、および保有しているお客様個人データ（以下総称して「お客様個人情報」といいます）を以下の目的に利用いたします。</p>\n<ol>\n<li> 定期点検、車検および保険満期のご案内などを提供するための、郵便、電話、電子メール、面談などの方法によるお知らせ</li>\n<li> 当社グループにおいて取り扱う商品、サービスなど、または各種イベント、キャンペーンなどの開催についての、郵便、電話、電子メール、面談などの方法によるご案内</li>\n<li> 商品開発あるいはお客様満足度向上策検討のための、郵便、電話、電子メール、面談などの方法によるアンケート調査の実施</li>\n<li>資料請求、試乗申し込み、懸賞応募などに対応したサービスのご提供</li>\n<li>与信・審査およびご契約期間中の信用調査・管理</li>\n<li>市場調査および流通分析、統計</li>\n<li>当社グループが代理店として委託を受け損害保険契約を締結する損害保険会社各社に対し、同各社がお客様に保険商品の案内および提供を行うため<br />＜損害保険会社＞<br />三井住友海上火災保険株式会社<br />損害保険ジャパン株式会社</li>\n<li>項番4．に定めるお客様情報及びお客様車両サービス情報の共同利用による、お客様車両に対する的確なサービスの提供、査定、代替時等、的確なアドバイス、当社グループにおいて取扱う商品のご案内等</li>\n<li>緊急時の路上サービスの提供（項番4．に定めるメーカーが提供するエマージェンシー・サービスの提供を含む）</li>\n<li>その他当社グループの行う販売業務、サービス業務遂行のための利用</li>\n<li>法令または裁判所の命令もしくは権限ある行政機関の命令や決定により開示を求められた場合</li>\n<li>当社が取り扱う損害保険※およびこれらに付帯・関連するサービスのご提供<br />【当社取扱保険会社】<br />■三井住友海上火災保険株式会社（https://www.ms-ins.com）<br />■損害保険ジャパン株式会社（https://www.sompo-japan.co.jp）</li>\n</ol>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-74d0538 elementor-widget elementor-widget-heading\" data-id=\"74d0538\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">3.お客様個人情報の第三者提供について</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-60eeec7 elementor-widget elementor-widget-text-editor\" data-id=\"60eeec7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループは、お客様個人情報を、以下の例外を除き、お客様の同意なく第三者に提供いたしません。また、当社グループがお客様個人情報の 取扱いを含む業務を委託する場合、その業務委託の目的の範囲内でお客様個人情報を当該委託先に預託いたします。</p>\n<ol>\n<li> 法令に基づく場合</li>\n<li> 人の生命、身体又は財産の保護のために必要がある場合であって、本人の同意を得ることが困難であるとき</li>\n<li> 公衆衛生の向上又は児童の健全な育成の推進のために特に必要がある場合であって、本人の同意を得ることが困難であるとき</li>\n<li>国の機関若しくは地方公共団体又はその委託を受けた者が法令の定める事務を遂行することに対して協力する必要がある場合であって、本人の同意を得ることにより当該事務の遂行に支障を及ぼすおそれがあるとき</li>\n</ol>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-7a0688f elementor-widget elementor-widget-heading\" data-id=\"7a0688f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">4.お客様個人情報及びお客様車両サービス情報の共同利用について</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-94f3fd9 elementor-widget elementor-widget-text-editor\" data-id=\"94f3fd9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループは、お客様個人情報を、以下の例外を除き、お客様の同意なく第三者に提供いたしません。また、当社グループがお客様個人情報の 取扱いを含む業務を委託する場合、その業務委託の目的の範囲内でお客様個人情報を当該委託先に預託いたします。</p>\n<ol>\n<li><span style=\"font-style: inherit; font-weight: inherit;\"> </span>共同利用するお客様個人情報の項目及び範囲：</li>\n<li> 共同利用者によるお客様個人情報の利用目的：</li>\n<li> 共同利用するお客様個人情報の管理についての責任を有する者</li>\n</ol>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-0d923c3 elementor-widget elementor-widget-heading\" data-id=\"0d923c3\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">5.お客様個人情報の適正な管理</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-cf35ccb elementor-widget elementor-widget-text-editor\" data-id=\"cf35ccb\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループは、お客様個人情報を適切に管理すると共に、不正アクセス、お客様個人情報の紛失、破壊、改ざん、及び漏えいを防止する為の組織体制を整備し、システム面等の安全管理措置を実行します。 業務委託先についても、同様の方針でお客様個人情報を厳正に管理して参ります。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-c683bd5 elementor-widget elementor-widget-heading\" data-id=\"c683bd5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">6.お預かりしているお客様個人情報の取扱いに関して</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-5389e38 elementor-widget elementor-widget-text-editor\" data-id=\"5389e38\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループは、グループの主幹的役割を担うニコル・レーシング・ジャパン合同会社の管理のもと、保有しているお客様個人情報に関しては、お客様の事前同意がない限り、項番2．に記載した目的以外には利用しません。</p>\n<p>なお、お客様がご本人様の個人情報の開示、訂正等を希望される場合は、別途定める手続きにてご請求頂き、当社グループは合理的な範囲で速やかに応じます。お客様個人情報の開示・消去は、当社グループが定める書面で、また訂正・変更・利用停止は、問い合わせ窓口に電話で請求頂き、お客様ご本人である確認をとらせて頂いた上で、万が一不正確、または誤りであることが明らかになった場合は、速やかに消去・訂正・変更等に応じます。</p>\n<p>開示請求書等当社グループの定める書面の入手方法につきましては、項番7．に記載のお客様個人情報の取扱いに関する窓口までお問い合わせください。 開示のご回答には、個人情報開示請求書に記載の所定の手数料（郵送費、消費税込）を申し受けますのでご了承ください。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-4e49c59 elementor-widget elementor-widget-heading\" data-id=\"4e49c59\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">7.お客様個人情報の取扱いに関する窓口、保有個人データ開示請求書等の送付先</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a1857cc elementor-widget elementor-widget-text-editor\" data-id=\"a1857cc\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>〒212-0005 神奈川県川崎市幸区戸手2-5-7<br />ニコル・レーシング・ジャパン合同会社<br />お客様相談室（お客様個人情報に関するお問い合わせ窓口） TEL：044-511-9859</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2395d27 elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list\" data-id=\"2395d27\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"icon-list.default\">\n\t\t\t\t\t\t\t<ul class=\"elementor-icon-list-items\">\n\t\t\t\t\t\t\t<li class=\"elementor-icon-list-item\">\n\t\t\t\t\t\t\t\t\t\t\t<a href=\"/uploads/2026/05/privacy.pdf\" target=\"_blank\">\n\n\t\t\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-icon-list-icon\">\n\t\t\t\t\t\t\t<svg aria-hidden=\"true\" class=\"e-font-icon-svg e-fas-file-pdf\" viewBox=\"0 0 384 512\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M181.9 256.1c-5-16-4.9-46.9-2-46.9 8.4 0 7.6 36.9 2 46.9zm-1.7 47.2c-7.7 20.2-17.3 43.3-28.4 62.7 18.3-7 39-17.2 62.9-21.9-12.7-9.6-24.9-23.4-34.5-40.8zM86.1 428.1c0 .8 13.2-5.4 34.9-40.2-6.7 6.3-29.1 24.5-34.9 40.2zM248 160h136v328c0 13.3-10.7 24-24 24H24c-13.3 0-24-10.7-24-24V24C0 10.7 10.7 0 24 0h200v136c0 13.2 10.8 24 24 24zm-8 171.8c-20-12.2-33.3-29-42.7-53.8 4.5-18.5 11.6-46.6 6.2-64.2-4.7-29.4-42.4-26.5-47.8-6.8-5 18.3-.4 44.1 8.1 77-11.6 27.6-28.7 64.6-40.8 85.8-.1 0-.1.1-.2.1-27.1 13.9-73.6 44.5-54.5 68 5.6 6.9 16 10 21.5 10 17.9 0 35.7-18 61.1-61.8 25.8-8.5 54.1-19.1 79-23.2 21.7 11.8 47.1 19.5 64 19.5 29.2 0 31.2-32 19.7-43.4-13.9-13.6-54.3-9.7-73.6-7.2zM377 105L279 7c-4.5-4.5-10.6-7-17-7h-6v128h128v-6.1c0-6.3-2.5-12.4-7-16.9zm-74.1 255.3c4.1-2.7-2.5-11.9-42.8-9 37.1 15.8 42.8 9 42.8 9z\"></path></svg>\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t\t\t<span class=\"elementor-icon-list-text\">PDF個人情報開示請求書（304KB）</span>\n\t\t\t\t\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t\t\t\t</li>\n\t\t\t\t\t\t</ul>\n\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b6413b6 elementor-widget elementor-widget-heading\" data-id=\"b6413b6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">8.教育</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2d43908 elementor-widget elementor-widget-text-editor\" data-id=\"2d43908\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>お客様個人情報の保護に関する教育を全役職員に対して継続的に行います。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ae9be03 elementor-widget elementor-widget-heading\" data-id=\"ae9be03\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">9.プライバシー・ステートメントの変更</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b7a6664 elementor-widget elementor-widget-text-editor\" data-id=\"b7a6664\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループは、法令の変更ないしお客様のご要望等に対応するために、このプライバシー・ステートメントを変更することがあります。<br />変更のご案内については、当社グループウェブサイト等によって公表しますので、定期的にご確認いただきますようお願いいたします。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-58344ed elementor-widget elementor-widget-heading\" data-id=\"58344ed\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">10.お客様のご質問</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-58dba5f elementor-widget elementor-widget-text-editor\" data-id=\"58dba5f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループにおけるプライバシーの保護に関するご質問がありましたら、項番7．のお客様相談室（お客様個人情報の取り扱いに関する窓口）までお問い合わせください。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-13403aa elementor-widget elementor-widget-text-editor\" data-id=\"13403aa\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>制定日：2009年9月22日<br />改定日：2017年5月30日<br />改定日：2022年4月1日</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-7587ca6 elementor-widget elementor-widget-text-editor\" data-id=\"7587ca6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>ニコル・レーシング・ジャパン合同会社<br />職務執行社長　ミヒャエル・ヴィット</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t<div class=\"elementor-element elementor-element-cbb8b53 e-flex e-con-boxed e-con e-parent\" data-id=\"cbb8b53\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-812b9e5 elementor-widget elementor-widget-heading\" data-id=\"812b9e5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">当社グループウェブサイトにおける個人関連情報の取扱いについて</h2>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-77c2fd0 elementor-widget elementor-widget-text-editor\" data-id=\"77c2fd0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<div class=\"row justify-content-center\">\n<div class=\"col-md-10 mt-sm-0 mt-md-5 pt-2 pb-1 px-4\">\n<p class=\"fs-6 text-black text-start text-md-start\">当社グループは、当社グループが運営する以下のウェブサイトを総称して以下、「本ウェブサイト」といいます。</p>\n<ul class=\"disc1 fs-6 text-black text-start text-md-start\">\n<li>nicole.co.jp</li>\n<li>nicole.jp</li>\n<li>nicole-automobiles.com</li>\n<li>nicole-automobiles.shop</li>\n<li>nicole.bmw.jp</li>\n<li>mini-yokohama.com</li>\n<li>kohoku.mini.jp</li>\n<li>yokohama-tsuzuki.mini.jp</li>\n<li>shin-yurigaoka.mini.jp</li>\n<li>rolls-roycemotorcars.com/yokohama/ja_JP/showroom.html</li>\n<li>yokohama.ferraridealers.com/ja-JP</li>\n</ul>\n<p class=\"fs-6 text-black text-start text-md-start\">上記の本ウェブサイトでお客様個人情報を取得する場合の目的については、上記プライバシー・ステートメントの項番2．「お客様個人情報の利用目的について」をご参照ください。<br />また、お客様の個人関連情報の取扱いについては以下をご確認ください。</p>\n</div>\n</div>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-eaafc4a elementor-widget elementor-widget-text-editor\" data-id=\"eaafc4a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループは、個人情報の保護に関する法律及びその他の法令の規範を遵守の上、お客様の個人情報を適正に取扱います。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-6eeb2fc elementor-widget elementor-widget-heading\" data-id=\"6eeb2fc\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">1. クッキー（Cookie）について</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-44e0df8 elementor-widget elementor-widget-heading\" data-id=\"44e0df8\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">（1）クッキー（Cookie）について</h4>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b2f8fee elementor-widget elementor-widget-text-editor\" data-id=\"b2f8fee\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>本ウェブサイトでは、クッキーと呼ばれる技術を利用しています。クッキーとは、ウェブサーバがお客様のブラウザに送信する小規模なデータのことで、ハードディスクに保存されコンピュータの識別に利用されます。<br />クッキーは、お客様が再び本ウェブサイトをご利用になる際に、本ウェブサイトのコンテンツをより便利に利用していただく為のもので、お客様のプライバシーを侵害したり、お客様のコンピュータへ悪影響を及ぼしたりすることはありません。<br />ウェブブラウザの多くはクッキーを受け取ったことを認識し、ユーザーがクッキーの使用を許可するか禁止するかを設定できるようになっています。クッキーでは、お客様ご自身が本ウェブサイトで能動的に個人情報を入力しない限り、特定の個人を識別することは出来ません。<br />現在使用しているブラウザがこの機能を持っているかどうか不明な場合は、ソフトウェア製造元または、インターネット・サービス・プロバイダーにお問い合わせください。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-745db47 elementor-widget elementor-widget-heading\" data-id=\"745db47\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">（2）クッキーの使用目的</h4>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-85f9912 elementor-widget elementor-widget-text-editor\" data-id=\"85f9912\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<ol>\n<li>本ウェブサイトのサービスを改善するため</li>\n<li>本ウェブサイトの利用者数やトラフィックを統計調査するため（統計調査情報にはお客様を特定する個人情報（名前、住所、電話番号、メールアドレス、クレジットカード番号ほか）は含まれておりません）</li>\n<li>本ウェブサービスのサービスを改善するため</li>\n</ol>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-2fe971c elementor-widget elementor-widget-heading\" data-id=\"2fe971c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">2. アクセスログについて</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-dd595e2 elementor-widget elementor-widget-heading\" data-id=\"dd595e2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">（1）アクセスログについて</h4>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b8088aa elementor-widget elementor-widget-text-editor\" data-id=\"b8088aa\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>本ウェブサイトでは、アクセスされた方の情報をアクセスログとして記録しています。ただし、お客様が利用されているインターネット・サービス・プロバイダーのドメイン名、IPアドレス、使用ブラウザの名称とバージョン、使用OSの種類、ウェブサイトの閲覧履歴等であり、個人を特定できる情報を含むものではありません。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ac3102f elementor-widget elementor-widget-heading\" data-id=\"ac3102f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">（2）アクセスログの利用目的</h4>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-41db1ae elementor-widget elementor-widget-text-editor\" data-id=\"41db1ae\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>ウェブサイトの利用状況を統計的に計測し、今後の利便性の向上を図る為に使用します。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-7d9a271 elementor-widget elementor-widget-heading\" data-id=\"7d9a271\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h4 class=\"elementor-heading-title elementor-size-default\">（3）アクセスログのオプトアウト</h4>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9db1442 elementor-widget elementor-widget-text-editor\" data-id=\"9db1442\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>本ウェブサイトでは、Google Analytics を利用し訪問履歴を記録・分析しますが、個人を識別する情報は含まれません。分析された情報は Google 社のプライバシーポリシーに従い取り扱われます。</p>\n<p>オプトアウトをご希望の場合は、以下のブラウザアドオンをインストールすることで、トラッキングを拒否できます。</p>\n<p><a href=\"https://tools.google.com/dlpage/gaoptout?hl=jp\">https://tools.google.com/dlpage/gaoptout?hl=jp</a></p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-62b0c4b elementor-widget elementor-widget-heading\" data-id=\"62b0c4b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">3. 推奨OS及びウェブブラウザについて</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-000827b elementor-widget elementor-widget-text-editor\" data-id=\"000827b\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>本ウェブサイトは一般的な環境での閲覧を前提にデザインされています。推奨環境以外で発生した不具合については責任を負いかねます。</p><p>【推奨OS】<br />Windows 10 / 11<br />macOS 最新バージョン</p><p>【推奨ブラウザ】<br />Google Chrome（最新版）<br />Microsoft Edge（最新版）<br />Safari（最新版）</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b1d1590 elementor-widget elementor-widget-heading\" data-id=\"b1d1590\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">4. プラグイン、ヘルパーアプリケーションについて</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-9acde1f elementor-widget elementor-widget-text-editor\" data-id=\"9acde1f\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>本ウェブサイトでは下記のプラグインを利用しています。<br />ご使用の際には以下よりダウンロードしてください。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-be64237 elementor-widget elementor-widget-heading\" data-id=\"be64237\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">5.ご利用上のお願い</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-02fd5d9 elementor-widget elementor-widget-text-editor\" data-id=\"02fd5d9\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>本ウェブサイトでは、JavaScriptおよびスタイルシートを使用しています。ご覧になる際にはブラウザ設定で、JavaScriptおよびスタイルシートを有効にしてください。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-67e712c elementor-widget elementor-widget-heading\" data-id=\"67e712c\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">6.本ウェブサイト上の情報のご利用制限について</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-dca20d6 elementor-widget elementor-widget-text-editor\" data-id=\"dca20d6\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>本ウェブサイトに掲載される情報は、各国の著作権法、各種条約及びその他の法律で保護されています。 私的使用その他法律によって明示的に認められる範囲を超えて、これらの情報を使用（複製、改変、アップロード、掲示、送信、頒布、ライセンス、販売、出版等を含む）をすることは、事前に当社グループの文書による許諾がないかぎり、禁止します。<br />本ウェブサイトから提供されるソフトウエアは、当該ソフトウエアに関する権利者の著作物です。 それぞれのソフトウエアの提供に際して権利者から提示されるソフトウエア使用許諾契約書の規定及び著作権法、各種条約その他の法律に従ってご使用下さい。<br />本ウェブサイトのうち「alpina.co.jp」上で使用される商標またはその他の商品名は独国アルピナ社及び当社・オートモビルズ合同会社の商標又は登録商標です。その他の製品及び会社名は、各社の商号、登録商標又は商標です。<br />本ウェブサイトのうち「alpina.co.jp」上に掲載されている製品、サービス、技術に関するアルピナ・ロゴやマークなどは当社・グループに商標権または使用権が帰属しています。これらを無断で使用して、アルピナの製品・サービスと関係があるかのような誤解を招く恐れのあるサイトを作成するなどの行為を禁止しております。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ef42d82 elementor-widget elementor-widget-heading\" data-id=\"ef42d82\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">7.禁止事項について</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ed517d1 elementor-widget elementor-widget-text-editor\" data-id=\"ed517d1\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>本ウェブサイトのご利用に際し、次の行為をしてはならないものとします。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-6e99ae2 elementor-widget elementor-widget-text-editor\" data-id=\"6e99ae2\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<ol>\n<li>第三者もしくは当社グループの財産もしくはプライバシー等を侵害する行為、または侵害する恐れのある行為</li>\n<li>第三者もしくは当社グループに、不利益もしくは損害を与える行為、またはその恐れのある行為</li>\n<li>公序良俗に反する行為、またはその恐れのある行為</li>\n<li>犯罪行為もしくは犯罪行為に結びつく行為、またはその恐れのある行為</li>\n<li>他人の電子メールアドレスを登録する等、虚偽の申告、届出を行なう行為</li>\n<li>営業活動もしくは営利を目的とする行為、またはその準備を目的とする行為</li>\n<li>第三者もしくは当社グループの名誉もしくは信用を毀損する行為</li>\n<li>コンピュータウィルス等有害なプログラムを使用もしくは提供する行為、またはその恐れのある行為</li>\n<li>その他、法律、法令もしくは条例に違反する行為、またはその恐れのある行為</li>\n<li>その他、当社グループが不適切と判断する行為</li>\n</ol>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-3bdbca5 elementor-widget elementor-widget-heading\" data-id=\"3bdbca5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">8.リンクサイトについて</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-a18a7ee elementor-widget elementor-widget-text-editor\" data-id=\"a18a7ee\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>本ウェブサイトから、もしくはこのウェブサイトへリンクを張っている当社グループ以外の第三者のウエブサイト（以下「リンクサイト」といいます）の内容は、それぞれ各社の責任で管理されるものであり、当社グループの管理下にあるものではありません。リンクサイトは、それぞれのリンクサイトの掲げる使用条件に従ってご利用下さい。<br />当社グループはリンクサイトの内容について、また、それらをご利用になったことにより生じたいかなる損害についても責任を負いません。</p>\n<p>尚、本ウェブサイトへのリンクという事実は、当社グループが同リンクサイトの利用や、リンクサイトに掲載されている商品、サービス、会社等を推奨することを意味するものではなく、また、当社グループとリンクサイトとの間に提携などの特別な関係があるということを意味するものではありません。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-8236c8d elementor-widget elementor-widget-heading\" data-id=\"8236c8d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">9.免責事項</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-e95d1b3 elementor-widget elementor-widget-text-editor\" data-id=\"e95d1b3\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループは、本ウェブサイトに情報を掲載する際には、あらゆる面から細心の注意を払っております。<br />しかしながら、当社グループはこれらの情報の内容が正確であるかどうか、有用なものであるかどうか、確実なものであるかどうか、ご使用になる皆様の目的に合ったものかどうか、安全なものであるかどうか（機能が中断しないこと、エラーが発生しないこと、欠点を修正すること、本ウェブサイト及びサーバーにコンピュータウィルスその他の有害物がないこと、等）等につきましては、一切保証致しません。<br />また、当社グループは皆様がこれらの情報を使用されたこと、もしくはご使用になれなかったこと、また、本ウェブサイトをご利用になったことにより生じるいかなる損害についても責任を負うものではありません。<br />当社グループは予告なしにウェブサイト上の情報を変更することがあります。また、ウェブサイトの運営を中断又は中止させて頂くことがあります。あらかじめご了承下さい。尚、当社グループは理由の如何に関わらず、情報の変更及びこのウェブサイトの運用の中断または中止によって生じるいかなる損害についても責任を負うものではありません。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-705ac89 elementor-widget elementor-widget-heading\" data-id=\"705ac89\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">10.準拠法及び管轄裁判所</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-da27f99 elementor-widget elementor-widget-text-editor\" data-id=\"da27f99\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>本ウェブサイトの利用並びに本ご利用条件の解釈及び適用は、他に別段の定めのない限り、日本国法に準拠するものとします。また、本ウェブサイトの利用に関わる全ての紛争については、他に別段の定めのない限り、東京地方裁判所を第一審の専属管轄裁判所とするものとします。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-bb8b0d7 elementor-widget elementor-widget-heading\" data-id=\"bb8b0d7\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">11.プライバシー・ステートメントの変更</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-ad4b7ac elementor-widget elementor-widget-text-editor\" data-id=\"ad4b7ac\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループは、法令の変更ないしお客様のご要望等に対応する為に、このプライバシー・ステートメントを変更することがあります。変更のご案内については、当社グループウェブサイト等によって公表しますので、定期的にご確認いただきますようお願いいたします。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-992cca3 elementor-widget elementor-widget-heading\" data-id=\"992cca3\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h3 class=\"elementor-heading-title elementor-size-default\">12.お客様のご質問</h3>\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-331e5f5 elementor-widget elementor-widget-text-editor\" data-id=\"331e5f5\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループにおけるプライバシーの保護に関するご質問がありましたら、プライバシー・ステートメントのお客様相談室までお問い合わせください。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-55e09d0 elementor-widget elementor-widget-text-editor\" data-id=\"55e09d0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>&lt; Nicole Group of Companies &gt;</p>\n<p>ニコル・レーシング・ジャパン合同会社<br />ニコル・オートモビルズ合同会社<br />ニコル・カーズ合同会社<br />Nicole MotorCars合同会社<br />Nicole Competizione合同会社</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t<div class=\"elementor-element elementor-element-995a700 elementor-widget elementor-widget-text-editor\" data-id=\"995a700\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t\t\t\t\t\t<p>当社グループにおけるプライバシーの保護に関するご質問がありましたら、プライバシー・ステートメントのお客様相談室までお問い合わせください。</p>\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t\t</div>";
