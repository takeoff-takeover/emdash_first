          "title": "Tags"
        },
        {
          "type": "component",
          "componentId": "core:recent-posts",
          "title": "Recent Posts",
          "props": {
            "count": 5,
            "showDate": true
          }
        },
        {
          "type": "component",
          "componentId": "core:archives",
          "title": "Archives",
          "props": {
            "type": "monthly",
            "limit": 6
          }
        }
      ]
