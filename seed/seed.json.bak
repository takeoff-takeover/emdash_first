                  "blank": true
                }
              ]
            }
          ]
        }
      },
      {
        "id": "01M5Y39W9Q2KAXNJNEA6VTAMW7",
        "wpId": 2263,
        "slug": "contact",
        "status": "published",
        "published_at": "2026-02-04T04:24:17.000Z",
        "data": {
          "title": "問い合わせ",
          "content": [
            {
              "_type": "block",
              "_key": "key-2-wtp3e",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-1-bg5gp",
                  "text": "お問い合わせ"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-4-6gbtz",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-3-66bz3",
                  "text": "以下のフォームをご入力の上、プライバシー・ステートメントをご一読いただき、ご了承いただける場合には「同意する」を選択して次へお進みください。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-6-mtlvf",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-5-sr2i5",
                  "text": "※お問い合わせ内容によっては、ご回答までにお時間をいただく場合がございます。あらかじめご了承ください。また内容により、担当者よりお電話でご連絡させていただく場合がございます。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-8-ljzoy",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-7-d6e3g",
                  "text": "※お車の不調・故障・修理など、サービス・メンテナンスに関するご相談は、お近くのNicole Groupの各ショールームまたはサービス拠点へ直接ご連絡いただきますようお願いいたします。インターネットからのお問い合わせでは対応できない場合がございます。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-10-xarby",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-9-3qo2m",
                  "text": "※営業・ご提案などの内容につきましては、返信を差し控えさせていただく場合がございます。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-43-xuyyb",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-11-k4a1s",
                  "text": "  /*\n"
                },
                {
                  "_type": "span",
                  "_key": "key-12-t0fo0",
                  "text": "   * =========================================================\n"
                },
                {
                  "_type": "span",
                  "_key": "key-13-67sfl",
                  "text": "   * Nicole Group formrun埋め込み\n"
                },
                {
                  "_type": "span",
                  "_key": "key-14-mohci",
                  "text": "   * 本番 /contact/ 用\n"
                },
                {
                  "_type": "span",
                  "_key": "key-15-rb94b",
                  "text": "   *\n"
                },
                {
                  "_type": "span",
                  "_key": "key-16-kqxz7",
                  "text": "   * ・確認画面はiframe内で表示\n"
                },
                {
                  "_type": "span",
                  "_key": "key-17-sndda",
                  "text": "   * ・送信完了後はブラウザ全体で外部完了ページへ遷移\n"
                },
                {
                  "_type": "span",
                  "_key": "key-18-5el5q",
                  "text": "   * =========================================================\n"
                },
                {
                  "_type": "span",
                  "_key": "key-19-34sl9",
                  "text": "   */\n"
                },
                {
                  "_type": "span",
                  "_key": "key-20-onf4h",
                  "text": "  #formrun-wrapper {\n"
                },
                {
                  "_type": "span",
                  "_key": "key-21-yerpt",
                  "text": "    position: relative;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-22-aycv2",
                  "text": "    width: 100%;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-23-10rx3",
                  "text": "    scroll-margin-top: 120px;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-24-3ynye",
                  "text": "  }\n"
                },
                {
                  "_type": "span",
                  "_key": "key-25-gs1wu",
                  "text": "  #formrun-embed {\n"
                },
                {
                  "_type": "span",
                  "_key": "key-26-axdrn",
                  "text": "    width: 100%;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-27-pv8fx",
                  "text": "    min-height: 700px;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-28-g6eu8",
                  "text": "  }\n"
                },
                {
                  "_type": "span",
                  "_key": "key-29-wj5dq",
                  "text": "  #formrun-embed iframe {\n"
                },
                {
                  "_type": "span",
                  "_key": "key-30-z1e0a",
                  "text": "    display: block;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-31-aro5x",
                  "text": "    width: 100% !important;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-32-3cxew",
                  "text": "    max-width: 100% !important;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-33-v3jvl",
                  "text": "    border: 0 !important;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-34-xf5h4",
                  "text": "  }\n"
                },
                {
                  "_type": "span",
                  "_key": "key-35-bbnnk",
                  "text": "  @media screen and (max-width: 767px) {\n"
                },
                {
                  "_type": "span",
                  "_key": "key-36-kjovg",
                  "text": "    #formrun-wrapper {\n"
                },
                {
                  "_type": "span",
                  "_key": "key-37-zq0sv",
                  "text": "      scroll-margin-top: 24px;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-38-1doep",
                  "text": "    }\n"
                },
                {
                  "_type": "span",
                  "_key": "key-39-bvznx",
                  "text": "    #formrun-embed {\n"
                },
                {
                  "_type": "span",
                  "_key": "key-40-h416p",
                  "text": "      min-height: 600px;\n"
                },
                {
                  "_type": "span",
                  "_key": "key-41-r1z4o",
                  "text": "    }\n"
                },
                {
                  "_type": "span",
                  "_key": "key-42-przxh",
                  "text": "  }\n"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "01M5Y39W9QXVT0RGKK8FED24TS",
        "wpId": 2637,
        "slug": "esg_sdgs",
        "status": "published",
        "published_at": "2026-02-06T06:52:42.000Z",
        "data": {
          "title": "ESG_SDGs",
          "content": [
            {
              "_type": "block",
              "_key": "key-2-8gkoi",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-1-aogte",
                  "text": "持続可能な未来を共に"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-4-gqvqp",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-3-3cwcl",
                  "text": "ニコル・グループが推進するESG活動"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-6-gs7mi",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-5-nrpqd",
                  "text": "私たちは、長年培った経験と信頼を基盤に、ESGの観点から持続可能な社会の実現に取り組んでいます。 ステークホルダーの皆さまと共に、次世代に誇れる未来を築くことを使命としています。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-8-wakz8",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-7-o2ajr",
                  "text": "※ESGとは、環境（E: Environment）、社会（S: Social）、ガバナンス（G: Governance）の頭文字を合わせた言葉です。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-11-w74yl",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-9-i6smp",
                  "text": "ニコル・グループ\n"
                },
                {
                  "_type": "span",
                  "_key": "key-10-70906",
                  "text": "ステートメント"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-13-075p6",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-12-gnkeb",
                  "text": "私たちは最も信頼される高級自動車グループとして、以下のESGステートメントに基づき持続可能な未来づくりに取り組みます。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-15-qgzbg",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-14-thfxx",
                  "text": "Environment"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-17-3q5p3",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-16-c05i4",
                  "text": "私たちは、ステークホルダーと協力して、現在そして未来の世代のために持続可能な環境の実現に尽力します。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-19-8d25p",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-18-2s3wl",
                  "text": "E"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-21-6zexp",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-20-1w1v3",
                  "text": "Social"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-23-5l11a",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-22-4sc0x",
                  "text": "私たちは、地域社会に積極的に貢献します。パフォーマンスを重視し柔軟性があり安全で公平な職場環境を醸成し、優秀な人材を惹きつけ、育成し、成長できる場を提供します。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-25-m9ypu",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-24-brjpk",
                  "text": "S"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-27-7sb43",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-26-2xa1u",
                  "text": "Governance"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-29-r4a3b",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-28-n9dfp",
                  "text": "私たちは、意思決定と業務プロセスの透明性・説明責任・エクセレンスを追求することで、ステークホルダーの期待を超え、企業価値の最大化を図ります。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-31-byai2",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-30-3x2si",
                  "text": "G"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-33-jhs0s",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-32-0esav",
                  "text": "ESG・SDGsの取り組み"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-35-cwvrr",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-34-wji8p",
                  "text": "ニコル・グループでは、持続可能な開発目標（SDGs）の達成に貢献するため、環境への配慮、地域社会への貢献、そして健全なガバナンスの実現を目指し、さまざまな取り組みを積み重ねています。ここでは、これまでに実施してきた活動や、現在進行中のプロジェクトをご紹介します。"
                }
              ]
            }
          ]
        }
      },
      {
        "id": "01M5Y39W9TAX7E9H2B87F6RVDB",
        "wpId": 3435,
        "slug": "mini",
        "status": "published",
        "published_at": "2026-02-10T04:29:57.000Z",
        "data": {
          "title": "MINI",
          "content": [
            {
              "_type": "block",
              "_key": "key-2-53p9h",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-1-ocsb8",
                  "text": "実績も、遊び心も、トップクラス。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-4-79t08",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-3-tq3jn",
                  "text": "MINI最優秀ディーラー賞を通算3回獲得した確かな実績を持つNicole MINIが、日常をカラフルに彩るパートナー選びをお手伝いします。情熱と遊び心を胸に、あなたらしい一台と、笑顔あふれるMINIライフをご提案いたします。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-6-axsxa",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-5-7ezu1",
                  "text": "MINI MODEL LINE UP"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-8-len5v",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-7-tihls",
                  "text": "ボディタイプやパワートレインから、あなたに合うMINIを見つけてください。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-10-3ztqv",
              "style": "h2",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-9-pqb47",
                  "text": "Nicole GroupがMINI正規ディーラーである理由"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-13-z3dit",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-11-vxpd7",
                  "text": "Nicole GroupはMINI正規ディーラーとして、\n"
                },
                {
                  "_type": "span",
                  "_key": "key-12-lu7ew",
                  "text": "新車販売からアフターサービスまで一貫したサポート体制を整えています。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-16-lakie",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-14-trf9g",
                  "text": "専門知識を持つMINI認定スタッフが、\n"
                },
                {
                  "_type": "span",
                  "_key": "key-15-4lj5d",
                  "text": "お客様一人ひとりのライフスタイルに合わせたご提案を行います。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-20-uy30v",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-17-7pyje",
                  "text": "\t\t\t\t"
                },
                {
                  "_type": "span",
                  "_key": "key-18-5fszb",
                  "text": "\t\t\t\t\t ボディ・タイプ \n"
                },
                {
                  "_type": "span",
                  "_key": "key-19-529h9",
                  "text": "\t\t\t"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-127-6t17v",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
