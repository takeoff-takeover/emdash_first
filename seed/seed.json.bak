                    "key-23-wo53c"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "key-25-rq1l8",
                  "text": "\t\t\t\t\t",
                  "marks": [
                    "key-23-wo53c"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "key-26-r7tmm",
                  "text": "\t\t\t\t\t\t\t\t\t\t\t\t\t\t"
                },
                {
                  "_type": "span",
                  "_key": "key-28-smgky",
                  "text": "\t\t\t\t\t\t\t\t\tMINI ラインナップ\n",
