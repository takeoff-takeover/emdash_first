              },
              "alt": "",
              "alignment": "wide"
            }
          ]
        }
      },
      {
        "id": "01M5Y39W8QBDP97AK6T39GZM2K",
        "wpId": 13069,
        "slug": "ニコル・グループ-2026年-夏季休業のお知らせ",
        "status": "published",
        "published_at": "2026-07-31T01:00:00.000Z",
        "taxonomies": {
          "category": [
            "お知らせ"
          ],
          "tag": [
            "休業日"
          ]
        },
        "data": {
          "title": "ニコル・グループ 2026年 夏季休業のお知らせ",
          "excerpt": "平素は格別のご愛顧を賜り、厚く御礼申し上げます。 誠に勝手ながら、下記の期間を夏季休業とさせていただきます。 店舗・ブランドによって休業期間が異なりますので、ご来店の際はご確認くださいますようお願い申し上げます。",
          "featured_image": {
            "src": "https://www.nicole.co.jp/wp/wp-content/uploads/2026/02/1000_F_302538971_6gPUTzVat3sc8kl6M0UI948BNzGJSRxO.jpg",
            "alt": "ニコル・グループ 2026年 夏季休業のお知らせ"
          },
          "related_location": "",
          "content": [
            {
              "_type": "block",
              "_key": "key-2-q0r41",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-1-h9ntk",
                  "text": "平素は格別のご愛顧を賜り、厚く御礼申し上げます。"
                }
              ]
            },
            {
              "_type": "block",
              "_key": "key-5-h6i1g",
              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-3-tba8r",
                  "text": "誠に勝手ながら、下記の期間を夏季休業とさせていただきます。\n"
                },
                {
                  "_type": "span",
                  "_key": "key-4-9ylr7",
                  "text": "店舗・ブランドによって休業期間が異なりますので、ご来店の際はご確認くださいますようお願い申し上げます。"
                }
              ]
            },
            {
              "_type": "htmlBlock",
              "_key": "key-7-v7f3i",
              "html": "<style>\n  /*\n   * =========================================================\n   * Nicole Group 2026年 夏季休業一覧\n   * PC：2列表\n   * SP：カード表示\n   * =========================================================\n   */\n\n  .nicole-summer-holiday {\n    width: 100%;\n    max-width: 1140px;\n    margin: 0 auto;\n    color: #262626;\n    font-family: inherit;\n    line-height: 1.7;\n  }\n\n  .nicole-summer-holiday,\n  .nicole-summer-holiday * {\n    box-sizing: border-box;\n  }\n\n  .nicole-summer-holiday__lead {\n    margin: 0 0 32px;\n    font-size: 16px;\n  }\n\n  .nicole-summer-holiday__notice {\n    margin: 0 0 40px;\n    padding: 18px 22px;\n    border-left: 4px solid #262626;\n    background: #f5f5f5;\n    font-size: 15px;\n  }\n\n  .nicole-summer-holiday__section {\n    margin: 0 0 48px;\n  }\n\n  .nicole-summer-holiday__heading {\n    margin: 0 0 18px;\n    padding: 0 0 10px;\n    border-bottom: 2px solid #262626;\n    color: #262626;\n    font-size: clamp(22px, 2.5vw, 28px);\n    font-weight: 700;\n    line-height: 1.4;\n  }\n\n  .nicole-summer-holiday__subheading {\n    margin: 30px 0 12px;\n    font-size: 18px;\n    font-weight: 700;\n    line-height: 1.5;\n  }\n\n  .nicole-summer-holiday__table {\n    width: 100%;\n    margin: 0;\n    border-collapse: collapse;\n    border-spacing: 0;\n    table-layout: fixed;\n  }\n\n  .nicole-summer-holiday__table th,\n  .nicole-summer-holiday__table td {\n    padding: 16px 20px;\n    border: 1px solid #d7d7d7;\n    vertical-align: middle;\n  }\n\n  .nicole-summer-holiday__table th {\n    background: #262626;\n    color: #ffffff;\n    font-size: 15px;\n    font-weight: 700;\n    text-align: left;\n  }\n\n  .nicole-summer-holiday__table th:first-child {\n    width: 65%;\n  }\n\n  .nicole-summer-holiday__table th:last-child {\n    width: 35%;\n    text-align: center;\n  }\n\n  .nicole-summer-holiday__table td {\n    background: #ffffff;\n    font-size: 15px;\n  }\n\n  .nicole-summer-holiday__table tbody tr:nth-child(even) td {\n    background: #fafafa;\n  }\n\n  .nicole-summer-holiday__store {\n    font-weight: 600;\n  }\n\n  .nicole-summer-holiday__type {\n    display: inline-block;\n    margin-top: 5px;\n    color: #666666;\n    font-size: 13px;\n    font-weight: 400;\n  }\n\n  .nicole-summer-holiday__period {\n    color: #b42318;\n    font-size: 16px;\n    font-weight: 700;\n    text-align: center;\n    white-space: nowrap;\n  }\n\n  .nicole-summer-holiday__annotation {\n    margin: 14px 0 0;\n    color: #555555;\n    font-size: 13px;\n  }\n\n  .nicole-summer-holiday__footer-note {\n    margin: 48px 0 0;\n    padding: 22px;\n    background: #f5f5f5;\n    font-size: 14px;\n  }\n\n  .nicole-summer-holiday__footer-note p {\n    margin: 0;\n  }\n\n  .nicole-summer-holiday__footer-note p + p {\n    margin-top: 8px;\n  }\n\n  /*\n   * スマートフォン\n   */\n  @media screen and (max-width: 767px) {\n    .nicole-summer-holiday {\n      padding: 0;\n    }\n\n    .nicole-summer-holiday__lead {\n      margin-bottom: 24px;\n      font-size: 15px;\n    }\n\n    .nicole-summer-holiday__notice {\n      margin-bottom: 32px;\n      padding: 16px;\n      font-size: 14px;\n    }\n\n    .nicole-summer-holiday__section {\n      margin-bottom: 40px;\n    }\n\n    .nicole-summer-holiday__heading {\n      margin-bottom: 16px;\n      font-size: 22px;\n    }\n\n    .nicole-summer-holiday__subheading {\n      margin: 26px 0 12px;\n      font-size: 17px;\n    }\n\n    .nicole-summer-holiday__table,\n    .nicole-summer-holiday__table thead,\n    .nicole-summer-holiday__table tbody,\n    .nicole-summer-holiday__table tr,\n    .nicole-summer-holiday__table th,\n    .nicole-summer-holiday__table td {\n      display: block;\n      width: 100%;\n    }\n\n    .nicole-summer-holiday__table {\n      border: 0;\n    }\n\n    .nicole-summer-holiday__table thead {\n      position: absolute;\n      width: 1px;\n      height: 1px;\n      padding: 0;\n      margin: -1px;\n      overflow: hidden;\n      clip: rect(0, 0, 0, 0);\n      white-space: nowrap;\n      border: 0;\n    }\n\n    .nicole-summer-holiday__table tr {\n      margin: 0 0 14px;\n      overflow: hidden;\n      border: 1px solid #d7d7d7;\n      border-radius: 4px;\n      background: #ffffff;\n    }\n\n    .nicole-summer-holiday__table td,\n    .nicole-summer-holiday__table tbody tr:nth-child(even) td {\n      border: 0;\n      background: #ffffff;\n    }\n\n    .nicole-summer-holiday__table td:first-child {\n      padding: 16px 16px 12px;\n      border-bottom: 1px solid #eeeeee;\n      font-size: 15px;\n    }\n\n    .nicole-summer-holiday__table td:last-child {\n      position: relative;\n      padding: 12px 16px 16px;\n      text-align: left;\n      white-space: normal;\n    }\n\n    .nicole-summer-holiday__table td:last-child::before {\n      display: block;\n      margin-bottom: 2px;\n      color: #666666;\n      content: \"夏季休業\";\n      font-size: 12px;\n      font-weight: 400;\n    }\n\n    .nicole-summer-holiday__period {\n      font-size: 16px;\n    }\n\n    .nicole-summer-holiday__footer-note {\n      margin-top: 36px;\n      padding: 18px 16px;\n      font-size: 13px;\n    }\n  }\n</style>\n\n<div class=\"nicole-summer-holiday\">\n\n  <!-- Nicole BMW -->\n  <section class=\"nicole-summer-holiday__section\" aria-labelledby=\"holiday-bmw\">\n    <h2 id=\"holiday-bmw\" class=\"nicole-summer-holiday__heading\">\n      Nicole BMW\n    </h2>\n\n    <h3 class=\"nicole-summer-holiday__subheading\">\n      ショールーム・販売拠点\n    </h3>\n\n    <table class=\"nicole-summer-holiday__table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">店舗・拠点</th>\n          <th scope=\"col\">夏季休業期間</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            Nicole BMW 本社・横浜港北支店・青葉宮前支店\n            <span class=\"nicole-summer-holiday__type\">ショールーム</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月11日（火）～14日（金）\n          </td>\n        </tr>\n\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            Nicole BMW 新百合ヶ丘支店・大田支店\n            <span class=\"nicole-summer-holiday__type\">ショールーム</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月10日（月）～14日（金）\n          </td>\n        </tr>\n\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            BMW Premium Selection 横浜港北\n            <span class=\"nicole-summer-holiday__type\">認定中古車ショールーム</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月11日（火）～14日（金）\n          </td>\n        </tr>\n\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            BMW Premium Selection 新百合ヶ丘\n            <span class=\"nicole-summer-holiday__type\">認定中古車ショールーム</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月10日（月）～14日（金）\n          </td>\n        </tr>\n      </tbody>\n    </table>\n\n    <h3 class=\"nicole-summer-holiday__subheading\">\n      サービス拠点\n    </h3>\n\n    <table class=\"nicole-summer-holiday__table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">対象拠点</th>\n          <th scope=\"col\">夏季休業期間</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            Nicole BMW 各サービス拠点\n            <span class=\"nicole-summer-holiday__type\">サービス工場</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月11日（火）～14日（金）\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </section>\n\n  <!-- MINI -->\n  <section class=\"nicole-summer-holiday__section\" aria-labelledby=\"holiday-mini\">\n    <h2 id=\"holiday-mini\" class=\"nicole-summer-holiday__heading\">\n      MINI\n    </h2>\n\n    <h3 class=\"nicole-summer-holiday__subheading\">\n      ショールーム・販売拠点\n    </h3>\n\n    <table class=\"nicole-summer-holiday__table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">店舗・拠点</th>\n          <th scope=\"col\">夏季休業期間</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            MINI 港北・MINI 横浜都筑・MINI 新百合ヶ丘\n            <span class=\"nicole-summer-holiday__type\">ショールーム</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月10日（月）～14日（金）\n          </td>\n        </tr>\n\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            MINI NEXT 横浜港北\n            <span class=\"nicole-summer-holiday__type\">認定中古車ショールーム</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月11日（火）～14日（金）\n          </td>\n        </tr>\n\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            MINI NEXT 新百合ヶ丘\n            <span class=\"nicole-summer-holiday__type\">認定中古車ショールーム</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月10日（月）～14日（金）\n          </td>\n        </tr>\n      </tbody>\n    </table>\n\n    <h3 class=\"nicole-summer-holiday__subheading\">\n      サービス拠点\n    </h3>\n\n    <table class=\"nicole-summer-holiday__table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">対象拠点</th>\n          <th scope=\"col\">夏季休業期間</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            MINI 各サービス拠点\n            <span class=\"nicole-summer-holiday__type\">サービス工場</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月11日（火）～14日（金）\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </section>\n\n  <!-- ALPINA -->\n  <section class=\"nicole-summer-holiday__section\" aria-labelledby=\"holiday-alpina\">\n    <h2 id=\"holiday-alpina\" class=\"nicole-summer-holiday__heading\">\n      ニコル・エクスクルーシブ・ショールーム\n    </h2>\n\n    <table class=\"nicole-summer-holiday__table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">店舗・拠点</th>\n          <th scope=\"col\">夏季休業期間</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            ニコル 世田谷・ニコル 青山\n            <span class=\"nicole-summer-holiday__type\">ショールーム</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月10日（月）～16日（日）\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </section>\n\n  <!-- Rolls-Royce -->\n  <section class=\"nicole-summer-holiday__section\" aria-labelledby=\"holiday-rolls-royce\">\n    <h2 id=\"holiday-rolls-royce\" class=\"nicole-summer-holiday__heading\">\n      Rolls-Royce Motor Cars Yokohama\n    </h2>\n\n    <table class=\"nicole-summer-holiday__table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">店舗・拠点</th>\n          <th scope=\"col\">夏季休業期間</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            Rolls-Royce Motor Cars Yokohama\n            <span class=\"nicole-summer-holiday__type\">ショールーム</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月10日（月）～14日（金）\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </section>\n\n  <!-- Ferrari -->\n  <section class=\"nicole-summer-holiday__section\" aria-labelledby=\"holiday-ferrari\">\n    <h2 id=\"holiday-ferrari\" class=\"nicole-summer-holiday__heading\">\n      Nicole Competizione\n    </h2>\n\n    <table class=\"nicole-summer-holiday__table\">\n      <thead>\n        <tr>\n          <th scope=\"col\">店舗・拠点</th>\n          <th scope=\"col\">夏季休業期間</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"nicole-summer-holiday__store\">\n            Nicole Competizione\n            <span class=\"nicole-summer-holiday__type\">ショールーム・プレオウンドショールーム・サービスセンター</span>\n          </td>\n          <td class=\"nicole-summer-holiday__period\">\n            8月12日（水）～15日（土）\n          </td>\n        </tr>\n      </tbody>\n    </table>\n  </section>\n\n  <div class=\"nicole-summer-holiday__footer-note\">\n    <p>\n      ※休業期間中にいただいたお問い合わせは、各店舗の営業再開後、順次対応いたします。\n    </p>\n    <p>\n      ※臨時の変更などがある場合は、各ブランド・店舗の公式サイトにてお知らせいたします。\n    </p>\n  </div>\n\n</div>",
              "originalBlockName": "core/html"
            }
          ]
        }
      },
      {
        "id": "01M5Y39W8QADK08P2NFN272R5H",
        "wpId": 13126,
        "slug": "20260718_summerconference2026",
        "status": "published",
        "published_at": "2026-07-27T08:33:29.000Z",
        "taxonomies": {
