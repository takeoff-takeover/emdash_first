              "style": "normal",
              "children": [
                {
                  "_type": "span",
                  "_key": "key-87-pa1i1",
                  "text": "\t\t\t\t\t\t\t\t\t拠点一覧へ\n",
                  "marks": [
                    "key-86-vpn5g"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "key-88-zglcy",
                  "text": "\t\t\t\t\t",
