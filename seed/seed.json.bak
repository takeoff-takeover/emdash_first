{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "Blog Starter",
    "description": "A blog with posts and pages",
    "author": "EmDash"
  },
  "settings": {
    "title": "My Blog",
    "tagline": "Thoughts on building for the web"
  },
  "collections": [
    {
      "slug": "posts",
      "label": "Posts",
      "labelSingular": "Post",
      "urlPattern": "/posts/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "scheduling",
        "search",
        "seo"
      ],
      "commentsEnabled": true,
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "featured_image",
          "label": "Featured Image (PC用)",
          "type": "image"
        },
        {
          "slug": "featured_image_sp",
          "label": "Featured Image (スマホ用)",
          "type": "image"
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        },
        {
          "slug": "excerpt",
          "label": "Excerpt",
          "type": "text"
        },
        {
          "slug": "related_location",
          "label": "関連拠点 (Related Showroom)",
          "type": "select",
          "options": [
            {
              "label": "なし（設定しない）",
              "value": ""
            },
            {
              "label": "Nicole BMW 本社ショールーム（川崎）",
              "value": "nicole-bmw-kawasaki"
            },
            {
              "label": "Nicole BMW 大田支店",
              "value": "nicole-bmw-ota"
            },
            {
              "label": "Nicole BMW 青葉宮前支店",
              "value": "nicole-bmw-aobamiyamae"
            },
            {
              "label": "Nicole BMW 横浜港北支店",
              "value": "nicole-bmw-yokohama-kohoku"
            },
            {
              "label": "Nicole BMW 新百合ヶ丘支店",
              "value": "nicole-bmw-shin-yurigaoka"
            },
            {
              "label": "ロールス・ロイス・モーター・カーズ横浜",
              "value": "rolls-royce-yokohama"
            },
            {
              "label": "Nicole Competizione 青山（Ferrari）",
              "value": "ferrari-aoyama"
            },
            {
              "label": "ニコル世田谷ショールーム（ALPINA）",
              "value": "alpina-setagaya"
            }
          ]
        }
      ]
    },
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "urlPattern": "/pages/{slug}",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "search",
        "seo"
      ],
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true,
          "searchable": true
        },
        {
          "slug": "content",
          "label": "Content",
          "type": "portableText",
          "searchable": true
        }
      ]
    }
  ],
  "taxonomies": [
