                  "text": "\t\t\t\t"
                },
                {
                  "_type": "span",
                  "_key": "key-12-mipm6",
                  "text": "\t\t\t\tMINI\t\t\t\n"
                },
                {
                  "_type": "span",
                  "_key": "key-13-wd5vt",
                  "text": "\t\t"
                },
                {
                  "_type": "span",
                  "_key": "key-14-ppavb",
                  "text": "\t\t\t\t"
                },
                {
                  "_type": "span",
                  "_key": "key-15-6szus",
                  "text": "\t\t\t\tロールス・ロイス\t\t\t\n"
                },
                {
                  "_type": "span",
                  "_key": "key-16-i4kda",
                  "text": "\t\t"
                },
                {
                  "_type": "span",
                  "_key": "key-17-idt27",
                  "text": "\t\t\t\t"
                },
                {
                  "_type": "span",
                  "_key": "key-18-f984w",
