jQuery(document).ready(function($) {
    var lastScrollTop = 0;
    var header = $('#smart-header'); // ヘッダーのコンテナにつけたID
    
    $(window).scroll(function(event){
        var st = $(this).scrollTop();
        
        // スマホの時（幅767px以下）だけ動かす判定
        if ($(window).width() <= 767) {
            
            // 下にスクロール（かつ100px以上進んだら）→ 隠す
            if (st > lastScrollTop && st > 100){
                header.addClass('header-hidden');
            } 
            // 上にスクロール → 表示する
            else {
                header.removeClass('header-hidden');
            }
            lastScrollTop = st;
        }
    });
});
</script>

<style is:inline>
/* スマホ（幅767px以下）の時だけ有効にする設定 */
@media (max-width: 767px) {
    #smart-header {
        transition: transform 0.4s ease-in-out; /* ヌルっと動くアニメーション */
    }
    
    /* 隠れる時の状態 */
    #smart-header.header-hidden {
        transform: translateY(-100%); /* 自分の高さ分だけ上に移動して消える */
    }
}
</style>				</div>
				</div>
				</header>