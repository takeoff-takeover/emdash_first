---
// src/pages/magazine/index.astro
// Nicole Connect - Web Magazine（シネマティック＆ミニマル・エディトリアル一覧）
import { getEmDashCollection } from "emdash";
import NicoleLayout from "../../layouts/NicoleLayout.astro";

// CMS（postsコレクション）から記事を取得
const { entries: cmsPosts, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
	limit: 50,
});

if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);

// 静的アーカイブ記事データ（Nicole Connect公式マガジン記事マスタ）
