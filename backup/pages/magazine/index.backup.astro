					</div>
					<h3 class="no-articles-title">該当する記事が見つかりませんでした</h3>
					<p class="no-articles-desc">選択中のブランドまたは検索キーワードを変更してお試しください。</p>
					<button type="button" id="btn-reset-filters" class="btn-reset-filters">すべてのフィルターを解除</button>
				</div>
			</div>
		</section>
	</main>
</NicoleLayout>

<!-- インタラクティブ・フィルタリング制御スクリプト -->
<script is:inline>
	document.addEventListener('DOMContentLoaded', function() {
		let currentBrand = 'ALL';
		let currentTopic = 'ALL';
		let searchQuery = '';

		const brandPills = document.querySelectorAll('#brand-filters .filter-pill');
		const topicSelect = document.getElementById('topic-select');
		const searchInput = document.getElementById('article-search-input');
		const articles = document.querySelectorAll('.article-item');
		const countDisplay = document.getElementById('current-article-count');
		const noArticles = document.getElementById('no-articles');
		const resetBtn = document.getElementById('btn-reset-filters');
		const showcase = document.getElementById('featured-showcase');

		function applyFilters() {
			let visibleCount = 0;

			articles.forEach(article => {
				const brand = article.getAttribute('data-brand') || '';
				const topic = article.getAttribute('data-topic') || '';
				const title = article.getAttribute('data-title') || '';
				const lead = article.getAttribute('data-lead') || '';

				const matchesBrand = currentBrand === 'ALL' || brand === currentBrand || brand === 'ALL';
				const matchesTopic = currentTopic === 'ALL' || topic === currentTopic;
				const matchesSearch = !searchQuery || title.includes(searchQuery) || lead.includes(searchQuery);

				if (matchesBrand && matchesTopic && matchesSearch) {
					article.style.display = '';
					visibleCount++;
				} else {
					article.style.display = 'none';
				}
			});

			// カウント更新
			if (countDisplay) {
				countDisplay.textContent = String(visibleCount);
			}

			// 該当なし表示
			if (noArticles) {
				noArticles.style.display = visibleCount === 0 ? 'block' : 'none';
			}

			// ブランドや検索がアクティブな場合、フィーチャーショーケースを隠して一覧に集中
			if (showcase) {
				if (currentBrand !== 'ALL' || currentTopic !== 'ALL' || searchQuery.length > 0) {
					showcase.style.display = 'none';
				} else {
					showcase.style.display = '';
				}
			}
		}

		// 1. ブランドタブ切り替え
		brandPills.forEach(pill => {
			pill.addEventListener('click', () => {
				brandPills.forEach(p => p.classList.remove('is-active'));
				pill.classList.add('is-active');
				currentBrand = pill.getAttribute('data-value') || 'ALL';
				applyFilters();
			});
		});

		// 2. カテゴリーセレクト切り替え
		if (topicSelect) {
			topicSelect.addEventListener('change', (e) => {
				currentTopic = e.target.value;
				applyFilters();
			});
		}

		// 3. インクリメンタルキーワード検索
		if (searchInput) {
			searchInput.addEventListener('input', (e) => {
				searchQuery = e.target.value.toLowerCase().trim();
				applyFilters();
			});
		}

		// 4. リセットボタン
		if (resetBtn) {
			resetBtn.addEventListener('click', () => {
				currentBrand = 'ALL';
				currentTopic = 'ALL';
				searchQuery = '';

				brandPills.forEach(p => {
					if (p.getAttribute('data-value') === 'ALL') p.classList.add('is-active');
					else p.classList.remove('is-active');
				});

				if (topicSelect) topicSelect.value = 'ALL';
				if (searchInput) searchInput.value = '';

				applyFilters();
			});
		}
	});
</script>

